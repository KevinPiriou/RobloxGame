      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">AdminService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AdminConfig = require(Shared:WaitForChild("AdminConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local PerformanceBaselineConfig = require(Shared:WaitForChild("PerformanceBaselineConfig"))

local JumpBonusService = require(script.Parent:WaitForChild("JumpBonusService"))
local MonsterService = require(script.Parent:WaitForChild("MonsterService"))
local PerformanceBenchmarkService = require(script.Parent:WaitForChild("PerformanceBenchmarkService"))
local PhysicsAuditService = require(script.Parent:WaitForChild("PhysicsAuditService"))
local RunAnalyticsService = require(script.Parent:WaitForChild("RunAnalyticsService"))
local WeaponLoadoutService = require(script.Parent:WaitForChild("WeaponLoadoutService"))

local AdminService = {}

local ADMIN_ATTRIBUTE = "CanUseAdminTools"
local DEV_KIT_PREVIEW_ATTRIBUTE = "DevKitPreviewEnabled"
local isStarted = false

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local function getOrCreateRemoteFunction(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteFunction")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteFunction"), remoteName .. " doit etre un RemoteFunction.")

	return remote
end

local resetPowerUpsRemote = getOrCreateRemote("Admin_ResetPowerUps")
local spawnMonstersRemote = getOrCreateRemote("Admin_SpawnMonsters")
local killMonstersRemote = getOrCreateRemote("Admin_KillMonsters")
local adminMessageRemote = getOrCreateRemote("Admin_ShowMessage")
local setDebugLogSettingRemote = getOrCreateRemote("Admin_SetDebugLogSetting")
local debugLogStateRemote = getOrCreateRemote("Admin_DebugLogState")
local getDebugLogStateRemote = getOrCreateRemoteFunction("Admin_GetDebugLogState")
local toggleDevKitPreviewRemote = getOrCreateRemote("Admin_ToggleDevKitPreview")
local performanceBenchmarkRemote = getOrCreateRemote(PerformanceBaselineConfig.AdminRemoteName)
local physicsAuditRemote = getOrCreateRemote("Admin_RunPhysicsAudit")
local toggleLeydenNeedleRemote = getOrCreateRemote("Admin_ToggleLeydenNeedle")
local debugCategoryIds = {}

for _, category in ipairs(AdminConfig.DebugLogCategories) do
	debugCategoryIds[category.Id] = true
end

local function isConfiguredAdmin(player)
	for _, userId in ipairs(AdminConfig.AdminUserIds) do
		if userId == player.UserId then
			return true
		end
	end

	return false
end

local function isCreator(player)
	return game.CreatorId ~= 0 and player.UserId == game.CreatorId
end

local function canUseAdminTools(player)
	if AdminConfig.AllowStudioAdmin and RunService:IsStudio() then
		return true
	end

	return isCreator(player) or isConfiguredAdmin(player)
end

local function sendAdminMessage(player, success, message)
	adminMessageRemote:FireClient(player, {
		Success = success,
		Message = message,
	})
end

local function runAdminAction(player, refusedWarning, callback, shouldRecordAnalytics)
	if not canUseAdminTools(player) then
		DebugLog.Warn("Admin", refusedWarning .. " refuse", {
			Player = player.Name,
		})
		sendAdminMessage(player, false, "Acces admin refuse")
		return
	end

	if shouldRecordAnalytics ~= false then
		RunAnalyticsService.RecordAdminCommand(player)
	end

	local success, message = pcall(callback)

	if not success then
		DebugLog.Warn("Admin", refusedWarning .. " erreur", {
			Player = player.Name,
			Error = tostring(message),
		})
		sendAdminMessage(player, false, "Erreur admin")
		return
	end

	DebugLog.Info("Admin", refusedWarning .. " execute", {
		Player = player.Name,
		Message = message,
	})
	sendAdminMessage(player, true, message)
end

local function publishDebugLogState()
	local state = DebugLog.GetState()

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		debugLogStateRemote:FireClient(targetPlayer, state)
	end
end

function AdminService.SetupPlayer(player)
	player:SetAttribute(ADMIN_ATTRIBUTE, canUseAdminTools(player))
	player:SetAttribute(DEV_KIT_PREVIEW_ATTRIBUTE, false)
	DebugLog.Info("Admin", "Setup joueur admin", {
		Player = player.Name,
		CanUseAdminTools = player:GetAttribute(ADMIN_ATTRIBUTE),
	})
	debugLogStateRemote:FireClient(player, DebugLog.GetState())
end

function AdminService.RemovePlayer(player)
	player:SetAttribute(ADMIN_ATTRIBUTE, nil)
	player:SetAttribute(DEV_KIT_PREVIEW_ATTRIBUTE, nil)
end

function AdminService.Start()
	if isStarted then
		DebugLog.Info("Admin", "Start ignore, service deja demarre")
		return
	end

	isStarted = true
	DebugLog.Info("Admin", "AdminService demarre")

	getDebugLogStateRemote.OnServerInvoke = function(player)
		if not canUseAdminTools(player) then
			return nil
		end

		return DebugLog.GetState()
	end

	resetPowerUpsRemote.OnServerEvent:Connect(function(player)
		runAdminAction(player, "Reset admin", function()
			return JumpBonusService.ResetPowerUps(player)
		end)
	end)

	spawnMonstersRemote.OnServerEvent:Connect(function(player)
		runAdminAction(player, "Spawn admin", function()
			local queuedCount, pendingCount, isAlreadyQueued = MonsterService.QueueDebugSpawnMonstersNearPlayer(
				player,
				AdminConfig.DebugSpawnMonsterCount,
				AdminConfig.DebugSpawnMonsterBatchSize,
				AdminConfig.DebugSpawnMonsterBatchInterval
			)

			if isAlreadyQueued then
				return ("Spawn debug deja en cours : %d ennemis restants"):format(pendingCount)
			end

			if queuedCount <= 0 then
				return "Spawn debug impossible : joueur indisponible ou plafond atteint"
			end

			return ("Spawn debug file : %d ennemis, lots de %d"):format(
				queuedCount,
				AdminConfig.DebugSpawnMonsterBatchSize
			)
		end)
	end)

	killMonstersRemote.OnServerEvent:Connect(function(player)
		runAdminAction(player, "Kill admin", function()
			local killedCount = MonsterService.DebugKillAllMonsters()

			return ("Debug : %d ennemis supprimes"):format(killedCount)
		end)
	end)

	toggleDevKitPreviewRemote.OnServerEvent:Connect(function(player)
		runAdminAction(player, "Apercu kit UI", function()
			local isEnabled = player:GetAttribute(DEV_KIT_PREVIEW_ATTRIBUTE) ~= true
			player:SetAttribute(DEV_KIT_PREVIEW_ATTRIBUTE, isEnabled)

			return if isEnabled then "Apercu kit UI active" else "Apercu kit UI masque"
		end, false)
	end)

	physicsAuditRemote.OnServerEvent:Connect(function(player)
		runAdminAction(player, "Inventaire physique P1", function()
			return PhysicsAuditService.RunAudit()
		end, false)
	end)

	toggleLeydenNeedleRemote.OnServerEvent:Connect(function(player)
		runAdminAction(player, "Calibration Aiguille de Leyde", function()
			local enabled = not WeaponLoadoutService.HasWeapon(player, "leyden_needle")
			local success, message = WeaponLoadoutService.SetDevelopmentWeapon(player, "leyden_needle", enabled)
			if not success then error(message) end
			return message
		end)
	end)

	performanceBenchmarkRemote.OnServerEvent:Connect(function(player, payload)
		if not canUseAdminTools(player) then
			DebugLog.Warn("Admin", "Benchmark P0 refuse", {
				Player = player.Name,
			})
			sendAdminMessage(player, false, "Acces admin refuse")
			return
		end

		if typeof(payload) ~= "table" or typeof(payload.Action) ~= "string" then
			sendAdminMessage(player, false, "Commande P0 invalide")
			return
		end

		local success = false
		local message = "Commande P0 inconnue"

		if payload.Action == "Start" and typeof(payload.SelectionId) == "string" then
			success, message = PerformanceBenchmarkService.StartSelection(player, payload.SelectionId)
		elseif payload.Action == "Stop" then
			success, message = PerformanceBenchmarkService.StopScenario(player)
		end

		if success then
			RunAnalyticsService.RecordAdminCommand(player)
			DebugLog.Info("Perf", "Commande benchmark P0 executee", {
				Player = player.Name,
				Action = payload.Action,
				SelectionId = payload.SelectionId,
			})
		else
			DebugLog.Warn("Perf", "Commande benchmark P0 refusee", {
				Player = player.Name,
				Action = payload.Action,
				SelectionId = payload.SelectionId,
				Reason = message,
			})
		end

		sendAdminMessage(player, success, message)
	end)

	setDebugLogSettingRemote.OnServerEvent:Connect(function(player, payload)
		runAdminAction(player, "Reglage logs admin", function()
			if typeof(payload) ~= "table" or typeof(payload.Enabled) ~= "boolean" then
				error("Payload de logs invalide")
			end

			if payload.Scope == "Console" then
				DebugLog.SetConsoleEnabled(payload.Enabled)
				publishDebugLogState()
				return if payload.Enabled then "Console debug activee" else "Console debug desactivee"
			end

			if payload.Scope ~= "Category" or typeof(payload.Category) ~= "string"
				or debugCategoryIds[payload.Category] ~= true
			then
				error("Categorie de logs invalide")
			end

			DebugLog.SetCategoryEnabled(payload.Category, payload.Enabled)
			publishDebugLogState()

			return ("Logs %s : %s"):format(payload.Category, payload.Enabled and "actifs" or "coupes")
		end, false)
	end)
end

return AdminService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">ArcaneGemService</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local PickupFeedbackConfig = require(Shared:WaitForChild("PickupFeedbackConfig"))
local ProgressionConfig = require(Shared:WaitForChild("ProgressionConfig"))

local ArcaneGemService = {}

local progressionDataStore = DataStoreService:GetDataStore(ProgressionConfig.DataStoreName)
local profilesByUserId = {}

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local pickupFeedbackRemote = getOrCreateRemote(PickupFeedbackConfig.RemoteName)

local function sanitizeAmount(value)
	return math.max(0, math.floor(tonumber(value) or 0))
end

local function createDefaultData()
	return {
		Version = 1,
		ArcaneGems = ProgressionConfig.DefaultArcaneGems,
	}
end

local function normalizeData(rawData)
	local data = createDefaultData()

	if typeof(rawData) ~= "table" then
		return data
	end

	data.ArcaneGems = sanitizeAmount(rawData.ArcaneGems)

	return data
end

local function getDataStoreKey(player)
	return "Player_" .. player.UserId
end

local function getOrCreateProfile(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		profile = {
			Data = createDefaultData(),
			Loaded = false,
			SessionOnly = false,
			Dirty = false,
		}
		profilesByUserId[player.UserId] = profile
	end

	return profile
end

local function publishProfile(player, profile)
	player:SetAttribute(ProgressionConfig.ArcaneGemsAttributeName, profile.Data.ArcaneGems)
end

local function loadProfile(player)
	local profile = getOrCreateProfile(player)
	local success, rawData = pcall(function()
		return progressionDataStore:GetAsync(getDataStoreKey(player))
	end)

	if success then
		profile.Data = normalizeData(rawData)
		profile.Loaded = true
		profile.SessionOnly = false
	elseif RunService:IsStudio() then
		profile.Data = createDefaultData()
		profile.Loaded = true
		profile.SessionOnly = true
		DebugLog.Warn("Progression", "DataStore de progression indisponible dans Studio", {
			Player = player.Name,
			Error = tostring(rawData),
		})
	else
		profile.Loaded = false
		DebugLog.Warn("Progression", "Chargement des gemmes arcaniques impossible", {
			Player = player.Name,
			Error = tostring(rawData),
		})
	end

	publishProfile(player, profile)
end

function ArcaneGemService.GetArcaneGems(player)
	if player == nil then
		return 0
	end

	return getOrCreateProfile(player).Data.ArcaneGems
end

function ArcaneGemService.AwardArcaneGems(player, amount, source, showFeedback)
	if player == nil or player.Parent ~= Players then
		return false, "InvalidPlayer"
	end

	local profile = getOrCreateProfile(player)
	local sanitizedAmount = sanitizeAmount(amount)

	if not profile.Loaded then
		return false, "ProfileNotLoaded"
	end

	if sanitizedAmount <= 0 then
		return false, "InvalidAmount"
	end

	profile.Data.ArcaneGems += sanitizedAmount
	profile.Dirty = true
	publishProfile(player, profile)

	if showFeedback == true then
		pickupFeedbackRemote:FireClient(player, {
			Kind = "ArcaneGem",
			Amount = sanitizedAmount,
		})
	end

	DebugLog.Info("Progression", "Gemmes arcaniques attribuees", {
		Player = player.Name,
		Amount = sanitizedAmount,
		Total = profile.Data.ArcaneGems,
		Source = source or "Unknown",
	})

	return true
end

function ArcaneGemService.SavePlayer(player)
	if player == nil then
		return false
	end

	local profile = profilesByUserId[player.UserId]

	if profile == nil or not profile.Loaded or not profile.Dirty then
		return true
	end

	if profile.SessionOnly then
		profile.Dirty = false
		return true
	end

	local success, updatedData = pcall(function()
		return progressionDataStore:UpdateAsync(getDataStoreKey(player), function(rawData)
			local data = normalizeData(rawData)
			data.ArcaneGems = profile.Data.ArcaneGems
			return data
		end)
	end)

	if not success then
		DebugLog.Warn("Progression", "Sauvegarde des gemmes arcaniques impossible", {
			Player = player.Name,
			Error = tostring(updatedData),
		})
		return false
	end

	profile.Data = normalizeData(updatedData)
	profile.Dirty = false
	publishProfile(player, profile)

	return true
end

function ArcaneGemService.SetupPlayer(player)
	loadProfile(player)

	DebugLog.Info("Progression", "Profil de gemmes arcaniques initialise", {
		Player = player.Name,
		ArcaneGems = ArcaneGemService.GetArcaneGems(player),
	})
end

function ArcaneGemService.RemovePlayer(player)
	ArcaneGemService.SavePlayer(player)
	profilesByUserId[player.UserId] = nil
end

return ArcaneGemService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">AudioService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AudioConfig = require(Shared:WaitForChild("AudioConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local AudioService = {}

local isStarted = false
local soundGroupsByCategory = {}

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local audioRemote = getOrCreateRemote(AudioConfig.RemoteName)

local function getOrCreateSoundGroup(category)
	local groupName = AudioConfig.SoundGroupNames[category]
	assert(groupName ~= nil, "Categorie audio inconnue : " .. tostring(category))

	local soundGroup = SoundService:FindFirstChild(groupName)

	if soundGroup == nil then
		soundGroup = Instance.new("SoundGroup")
		soundGroup.Name = groupName
		soundGroup.Parent = SoundService
	end

	assert(soundGroup:IsA("SoundGroup"), groupName .. " doit etre un SoundGroup.")
	soundGroup.Volume = 1
	soundGroupsByCategory[category] = soundGroup

	return soundGroup
end

local function configureMusicPool()
	local musicPool = SoundService:FindFirstChild(AudioConfig.MusicPoolFolderName)

	if musicPool == nil then
		local legacyPool = Workspace:FindFirstChild(AudioConfig.MusicPoolFolderName)

		if legacyPool ~= nil then
			DebugLog.Warn("Audio", "MusicPool encore dans Workspace", {
				ExpectedParent = SoundService,
				Pool = legacyPool,
			})
		end

		return
	end

	local musicGroup = soundGroupsByCategory.Music

	for _, descendant in ipairs(musicPool:GetDescendants()) do
		if descendant:IsA("Sound") then
			descendant.Playing = false
			descendant.Looped = false
			descendant.SoundGroup = musicGroup
		end
	end
end

local function canPlayForPlayer(player, soundKey)
	if player == nil or player.Parent ~= Players then
		return nil
	end

	local definition = AudioConfig.SoundEffects[soundKey]

	if definition == nil then
		DebugLog.ThrottledWarn("Audio", "unknown_" .. tostring(soundKey), 10, "Effet audio inconnu", {
			SoundKey = soundKey,
		})
		return nil
	end

	if definition.SoundId == nil or definition.SoundId == "" then
		return nil
	end

	return definition
end

function AudioService.PlayForPlayer(player, soundKey)
	if canPlayForPlayer(player, soundKey) == nil then
		return false
	end

	audioRemote:FireClient(player, {
		Action = "Play",
		SoundKey = soundKey,
	})

	return true
end

function AudioService.StartLoopForPlayer(player, soundKey, loopId)
	local definition = canPlayForPlayer(player, soundKey)

	if definition == nil or definition.Looped ~= true or loopId == nil or loopId == "" then
		return false
	end

	audioRemote:FireClient(player, {
		Action = "StartLoop",
		SoundKey = soundKey,
		LoopId = tostring(loopId),
	})

	return true
end

function AudioService.StopLoopForPlayer(player, loopId)
	if player == nil or player.Parent ~= Players or loopId == nil or loopId == "" then
		return false
	end

	audioRemote:FireClient(player, {
		Action = "StopLoop",
		LoopId = tostring(loopId),
	})

	return true
end

function AudioService.Start()
	if isStarted then
		return
	end

	isStarted = true

	for category in pairs(AudioConfig.SoundGroupNames) do
		getOrCreateSoundGroup(category)
	end

	configureMusicPool()

	DebugLog.Info("Audio", "Regie audio demarree", {
		MusicPoolParent = SoundService,
		MusicPoolName = AudioConfig.MusicPoolFolderName,
		Groups = soundGroupsByCategory,
	})
end

return AudioService
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="61">
        <Properties>
          <string name="Name">AuraAuthoringGuard</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Retire la scene de calibration du monde runtime sans toucher a la scene d'edition.

local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

if not RunService:IsRunning() then
	return
end

local preview = Workspace:FindFirstChild("AuraAuthoringPreview")

if preview ~= nil and preview:GetAttribute("MegaRobloxAuraAuthoring") == true then
	preview.Parent = ServerStorage
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">BossAttackService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BossConfig = require(Shared:WaitForChild("BossConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local MonsterService = require(script.Parent:WaitForChild("MonsterService"))
local PerkService = require(script.Parent:WaitForChild("PerkService"))
local RunAnalyticsService = require(script.Parent:WaitForChild("RunAnalyticsService"))
local RunStateService = require(script.Parent:WaitForChild("RunStateService"))
local TemplateService = require(script.Parent:WaitForChild("TemplateService"))
local WorldSpawnService = require(script.Parent:WaitForChild("WorldSpawnService"))

local BossAttackService = {}

local rng = Random.new()
local activeAttacksByUserId = {}
local attackFolder = nil
local heartbeatConnection = nil

local function getAttackFolder()
	if attackFolder ~= nil and attackFolder.Parent ~= nil then
		return attackFolder
	end

	local combatRuntime = TemplateService.GetCombatRuntimeFolder()
	attackFolder = combatRuntime:FindFirstChild("BossAttacks")

	if attackFolder == nil then
		attackFolder = Instance.new("Folder")
		attackFolder.Name = "BossAttacks"
		attackFolder.Parent = combatRuntime
	end

	return attackFolder
end

local function findRoot(monster)
	if monster == nil then
		return nil
	end

	if monster:IsA("BasePart") then
		return monster
	end

	if monster:IsA("Model") and monster.PrimaryPart ~= nil then
		return monster.PrimaryPart
	end

	local root = monster:FindFirstChild("HumanoidRootPart", true)

	if root == nil then
		root = monster:FindFirstChild("RootPart", true)
	end

	if root == nil then
		root = monster:FindFirstChildWhichIsA("BasePart", true)
	end

	if root ~= nil and root:IsA("BasePart") and monster:IsA("Model") then
		monster.PrimaryPart = root
	end

	return if root ~= nil and root:IsA("BasePart") then root else nil
end

local function getPlayerRoot(player)
	local character = player.Character

	if character == nil then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function getPlayerHumanoid(player)
	local character = player.Character

	if character == nil then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function getForwardDirection(root, player)
	local forward = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)

	if forward.Magnitude > 0.1 then
		return forward.Unit
	end

	local playerRoot = getPlayerRoot(player)

	if playerRoot == nil then
		return Vector3.new(0, 0, 1)
	end

	local toPlayer = playerRoot.Position - root.Position
	local horizontal = Vector3.new(toPlayer.X, 0, toPlayer.Z)

	return if horizontal.Magnitude > 0.1 then horizontal.Unit else Vector3.new(0, 0, 1)
end

local function createBubble(position, verticalOffset)
	local radius = BossConfig.ConeAttackBubbleRadius
	local diameter = radius * 2
	local bubble = Instance.new("Part")
	bubble.Name = "BossConeBubble"
	bubble.Shape = Enum.PartType.Ball
	bubble.Size = Vector3.new(diameter, diameter, diameter)
	bubble.Position = position + Vector3.new(0, verticalOffset or (radius * 0.35), 0)
	bubble.Anchored = true
	bubble.CanCollide = false
	bubble.CanTouch = false
	bubble.CanQuery = false
	bubble.Material = Enum.Material.Neon
	bubble.Color = Color3.fromRGB(236, 52, 61)
	bubble.Transparency = 0.72
	bubble.Parent = getAttackFolder()

	TweenService:Create(bubble, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(diameter * 1.18, diameter * 1.18, diameter * 1.18),
		Transparency = 0.6,
	}):Play()

	return bubble
end

local function getGroundPosition(root, candidatePosition)
	return WorldSpawnService.FindSurfacePositionAtXZ(candidatePosition.X, candidatePosition.Z, {
		Center = root.Position,
		RaycastHeight = BossConfig.ConeAttackGroundRaycastHeight,
		RaycastDepth = BossConfig.ConeAttackGroundRaycastDepth,
		ExcludeInstances = { root.Parent, getAttackFolder() },
		RejectedSurfaceNameContains = {
			"MurInvisible",
		},
	})
end

local function clearTelegraph(telegraph)
	if telegraph == nil then
		return
	end

	local function clearBubbles(bubbles)
		for _, bubbleState in ipairs(bubbles) do
			if bubbleState.Part.Parent ~= nil then
				bubbleState.Part:Destroy()
			end
		end
	end

	if telegraph.Type == "SequentialCone" then
		for _, row in ipairs(telegraph.Rows) do
			clearBubbles(row.Bubbles)
		end
	else
		clearBubbles(telegraph.Bubbles)
	end
end

local function getConeAttackCooldown()
	local minimum = math.max(0.1, BossConfig.ConeAttackCooldownMin or 4)
	local maximum = math.max(minimum, BossConfig.ConeAttackCooldownMax or minimum)

	return rng:NextNumber(minimum, maximum)
end

local function getTargetedSeriesInterval()
	local minimum = math.max(0.05, BossConfig.TargetedSeriesIntervalMin or 0.2)
	local maximum = math.max(minimum, BossConfig.TargetedSeriesIntervalMax or minimum)

	return rng:NextNumber(minimum, maximum)
end

local function createConeRow(root, origin, forward, right, rowIndex)
	local rowDistance = BossConfig.ConeAttackStartDistance + ((rowIndex - 1) * BossConfig.ConeAttackRowDistance)

	if rowDistance > BossConfig.ConeAttackMaxDistance then
		return {}
	end

	local rowCenter = origin + (forward * rowDistance)
	local bubbles = {}

	for column = 1, rowIndex do
		local lateralOffset = (column - ((rowIndex + 1) * 0.5)) * BossConfig.ConeAttackBubbleSpacing
		local candidatePosition = rowCenter + (right * lateralOffset)
		local groundPosition = getGroundPosition(root, candidatePosition)

		if groundPosition ~= nil then
			table.insert(bubbles, {
				Part = createBubble(groundPosition),
				Position = groundPosition,
			})
		end
	end

	return bubbles
end

local function explodeBubbles(player, state, telegraph, bubbles)
	local playerRoot = getPlayerRoot(player)
	local humanoid = getPlayerHumanoid(player)

	for _, bubbleState in ipairs(bubbles) do
		local bubble = bubbleState.Part

		if bubble.Parent ~= nil then
			TweenService:Create(bubble, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = bubble.Size * 1.8,
				Transparency = 1,
			}):Play()
			task.delay(0.2, function()
				if bubble.Parent ~= nil then
					bubble:Destroy()
				end
			end)
		end

		if not telegraph.DidHitPlayer and playerRoot ~= nil and humanoid ~= nil and humanoid.Health > 0 then
			local offset = playerRoot.Position - bubbleState.Position
			local horizontalDistance = Vector2.new(offset.X, offset.Z).Magnitude

			if horizontalDistance <= BossConfig.ConeAttackHitRadius then
				local incomingDamage, shieldAbsorbed = PerkService.CalculateIncomingDamage(player, state.ConeDamage)

				if incomingDamage > 0 then
					humanoid:TakeDamage(incomingDamage)
				end

				RunAnalyticsService.RecordDamageTaken(player, incomingDamage, shieldAbsorbed)

				telegraph.DidHitPlayer = true
			end
		end
	end
end

local function startSimultaneousCone(player, state, now, root, origin, forward, right)
	local bubbles = {}

	for row = 1, BossConfig.ConeAttackRows do
		for _, bubbleState in ipairs(createConeRow(root, origin, forward, right, row)) do
			table.insert(bubbles, bubbleState)
		end
	end

	state.Telegraph = {
		Type = "SimultaneousCone",
		Bubbles = bubbles,
		DidHitPlayer = false,
		ExplodeAt = now + BossConfig.ConeAttackTelegraphDuration,
	}

	DebugLog.Info("Boss", "Pattern cone simultane prepare", {
		Player = player.Name,
		Boss = state.Boss,
		Bubbles = #bubbles,
	})
end

local function startSequentialCone(player, state, now, root, origin, forward, right)
	state.Telegraph = {
		Type = "SequentialCone",
		Rows = {},
		NextRowIndex = 1,
		NextRowAt = now,
		Root = root,
		Origin = origin,
		Forward = forward,
		Right = right,
		DidHitPlayer = false,
	}

	DebugLog.Info("Boss", "Pattern cone sequentiel prepare", {
		Player = player.Name,
		Boss = state.Boss,
		Rows = BossConfig.ConeAttackRows,
	})
end

local function startTargetedSeries(player, state, now, root)
	local minimum = math.max(1, math.floor(BossConfig.TargetedSeriesMinBubbles or 2))
	local maximum = math.max(minimum, math.floor(BossConfig.TargetedSeriesMaxBubbles or minimum))

	state.Telegraph = {
		Type = "TargetedSeries",
		Bubbles = {},
		NextBubbleIndex = 1,
		BubbleCount = rng:NextInteger(minimum, maximum),
		NextBubbleAt = now,
		Root = root,
		HitCount = 0,
	}

	DebugLog.Info("Boss", "Pattern serie ciblee prepare", {
		Player = player.Name,
		Boss = state.Boss,
		Count = state.Telegraph.BubbleCount,
	})
end

local function startNextPattern(player, state, now)
	local root = findRoot(state.Boss)

	if root == nil then
		return
	end

	local forward = getForwardDirection(root, player)
	local right = Vector3.new(-forward.Z, 0, forward.X)
	local origin = root.Position

	state.NextAttackAt = now + getConeAttackCooldown()

	local patternRoll = rng:NextInteger(1, 3)

	if patternRoll == 1 then
		startSimultaneousCone(player, state, now, root, origin, forward, right)
	elseif patternRoll == 2 then
		startSequentialCone(player, state, now, root, origin, forward, right)
	else
		startTargetedSeries(player, state, now, root)
	end
end

local function updateSimultaneousCone(player, state, now)
	local telegraph = state.Telegraph

	if now < telegraph.ExplodeAt then
		return
	end

	explodeBubbles(player, state, telegraph, telegraph.Bubbles)
	state.Telegraph = nil

	DebugLog.Info("Boss", "Pattern cone simultane explose", {
		Player = player.Name,
		Hit = telegraph.DidHitPlayer,
		Damage = state.ConeDamage,
	})
end

local function updateSequentialCone(player, state, now)
	local telegraph = state.Telegraph

	if telegraph.NextRowIndex <= BossConfig.ConeAttackRows and now >= telegraph.NextRowAt then
		local rowIndex = telegraph.NextRowIndex
		local bubbles = createConeRow(telegraph.Root, telegraph.Origin, telegraph.Forward, telegraph.Right, rowIndex)

		table.insert(telegraph.Rows, {
			Bubbles = bubbles,
			ExplodeAt = now + BossConfig.ConeAttackTelegraphDuration,
			Exploded = false,
		})

		telegraph.NextRowIndex += 1
		telegraph.NextRowAt = now + BossConfig.ConeAttackSequentialRowInterval
	end

	local allRowsExploded = telegraph.NextRowIndex > BossConfig.ConeAttackRows

	for _, row in ipairs(telegraph.Rows) do
		if not row.Exploded then
			allRowsExploded = false

			if now >= row.ExplodeAt then
				explodeBubbles(player, state, telegraph, row.Bubbles)
				row.Exploded = true
			end
		end
	end

	if allRowsExploded then
		state.Telegraph = nil
		DebugLog.Info("Boss", "Pattern cone sequentiel termine", {
			Player = player.Name,
			Hit = telegraph.DidHitPlayer,
			Damage = state.ConeDamage,
		})
	end
end

local function updateTargetedSeries(player, state, now)
	local telegraph = state.Telegraph

	if telegraph.NextBubbleIndex <= telegraph.BubbleCount and now >= telegraph.NextBubbleAt then
		local playerRoot = getPlayerRoot(player)

		if playerRoot ~= nil then
			local targetPosition = playerRoot.Position

			table.insert(telegraph.Bubbles, {
				Part = createBubble(targetPosition, 0),
				Position = targetPosition,
				ExplodeAt = now + BossConfig.ConeAttackTelegraphDuration,
				Exploded = false,
			})
		end

		telegraph.NextBubbleIndex += 1
		telegraph.NextBubbleAt = now + getTargetedSeriesInterval()
	end

	local allBubblesExploded = telegraph.NextBubbleIndex > telegraph.BubbleCount

	for _, bubbleState in ipairs(telegraph.Bubbles) do
		if not bubbleState.Exploded then
			allBubblesExploded = false

			if now >= bubbleState.ExplodeAt then
				local explosionState = {
					DidHitPlayer = false,
				}

				explodeBubbles(player, state, explosionState, { bubbleState })
				bubbleState.Exploded = true

				if explosionState.DidHitPlayer then
					telegraph.HitCount += 1
				end
			end
		end
	end

	if allBubblesExploded then
		state.Telegraph = nil
		DebugLog.Info("Boss", "Pattern serie ciblee termine", {
			Player = player.Name,
			Hits = telegraph.HitCount,
			Damage = state.ConeDamage,
		})
	end
end

local function updateAttacks()
	local now = CombatStateService.GetTime()

	for userId, state in pairs(activeAttacksByUserId) do
		local player = state.Player

		if player.Parent ~= Players or not RunStateService.IsRunActive(player) or not MonsterService.IsMonsterAlive(state.Boss) then
			clearTelegraph(state.Telegraph)
			activeAttacksByUserId[userId] = nil
			continue
		end

		if CombatStateService.IsPaused() then
			continue
		end

		if state.Telegraph ~= nil then
			if state.Telegraph.Type == "SequentialCone" then
				updateSequentialCone(player, state, now)
			elseif state.Telegraph.Type == "TargetedSeries" then
				updateTargetedSeries(player, state, now)
			else
				updateSimultaneousCone(player, state, now)
			end
		elseif now >= state.NextAttackAt then
			startNextPattern(player, state, now)
		end
	end
end

function BossAttackService.Activate(player, boss, contactDamage)
	BossAttackService.Deactivate(player)

	activeAttacksByUserId[player.UserId] = {
		Player = player,
		Boss = boss,
		ConeDamage = math.max(0, contactDamage * BossConfig.ConeAttackDamageMultiplier),
		NextAttackAt = CombatStateService.GetTime() + getConeAttackCooldown(),
		Telegraph = nil,
	}
end

function BossAttackService.Deactivate(player)
	if player == nil then
		return
	end

	local state = activeAttacksByUserId[player.UserId]

	if state ~= nil then
		clearTelegraph(state.Telegraph)
		activeAttacksByUserId[player.UserId] = nil
	end
end

function BossAttackService.Start()
	if heartbeatConnection ~= nil then
		return
	end

	heartbeatConnection = RunService.Heartbeat:Connect(updateAttacks)
end

return BossAttackService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">BossService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BossConfig = require(Shared:WaitForChild("BossConfig"))
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local AudioService = require(script.Parent:WaitForChild("AudioService"))
local BossAttackService = require(script.Parent:WaitForChild("BossAttackService"))
local HudMessageService = require(script.Parent:WaitForChild("HudMessageService"))
local MonsterService = require(script.Parent:WaitForChild("MonsterService"))
local RunEndService = require(script.Parent:WaitForChild("RunEndService"))
local RunStateService = require(script.Parent:WaitForChild("RunStateService"))
local TemplateService = require(script.Parent:WaitForChild("TemplateService"))

local BossService = {}

local statesByUserId = {}
local bossTemplate = nil
local bossTemplateName = nil
local isStarted = false

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local bossRemote = getOrCreateRemote(BossConfig.BossRemoteName)
local decisionRemote = getOrCreateRemote(BossConfig.DecisionRemoteName)

local function getDecisionPauseReason(player)
	return "BossDecision_" .. player.UserId
end

local function getPortalPosition(portal)
	if portal == nil then
		return nil
	end

	if portal:IsA("BasePart") then
		return portal.Position
	end

	if portal:IsA("Model") then
		return portal:GetPivot().Position
	end

	local part = portal:FindFirstChildWhichIsA("BasePart", true)

	return if part ~= nil then part.Position else nil
end

local function sendBossBar(player, monster, health, maxHealth)
	bossRemote:FireClient(player, {
		Action = "ShowBar",
		Name = BossConfig.DisplayName,
		CurrentHealth = math.max(0, math.floor(health + 0.5)),
		MaxHealth = math.max(1, math.floor(maxHealth + 0.5)),
		Boss = monster,
	})
end

local function hideBossUi(player)
	bossRemote:FireClient(player, {
		Action = "Hide",
	})
end

local function loadBossTemplate()
	if bossTemplate ~= nil then
		return bossTemplate, bossTemplateName
	end

	bossTemplate = TemplateService.GetTemplate(CombatConfig.TemplateFolderName, BossConfig.BossTemplateName)
	bossTemplateName = BossConfig.BossTemplateName

	if bossTemplate == nil then
		bossTemplate = TemplateService.GetTemplate(CombatConfig.TemplateFolderName, BossConfig.FallbackTemplateName)
		bossTemplateName = BossConfig.FallbackTemplateName
		DebugLog.Warn("Boss", "Template Boss1 absent, fallback utilise", {
			Fallback = bossTemplateName,
		})
	end

	return bossTemplate, bossTemplateName
end

local function clearPlayerState(player)
	local state = statesByUserId[player.UserId]

	if state == nil then
		return
	end

	BossAttackService.Deactivate(player)
	CombatStateService.Resume(getDecisionPauseReason(player))
	statesByUserId[player.UserId] = nil
	hideBossUi(player)
end

local function onBossDefeated(player, monster, killer)
	local state = statesByUserId[player.UserId]

	if state == nil or state.Boss ~= monster or state.Phase ~= "Active" then
		return
	end

	state.Boss = nil
	state.Phase = "Decision"
	BossAttackService.Deactivate(player)
	RunEndService.MarkLevelValidated(player)
	hideBossUi(player)
	HudMessageService.Show(player, "BossDefeated")
	CombatStateService.Pause(getDecisionPauseReason(player))

	bossRemote:FireClient(player, {
		Action = "ShowDecision",
		Name = BossConfig.DisplayName,
	})

	DebugLog.Info("Boss", "Boss vaincu", {
		Player = player.Name,
		Boss = monster,
		Killer = killer and killer.Name or "nil",
	})
end

local function spawnBossAfterAnnouncement(player, state)
	if statesByUserId[player.UserId] ~= state or state.Phase ~= "Announcing" then
		return
	end

	if not RunStateService.IsRunActive(player) then
		clearPlayerState(player)
		return
	end

	local origin = getPortalPosition(state.Portal)
	local template, templateName = loadBossTemplate()
	local attackDamage = CombatConfig.MonsterAttackDamage * BossConfig.DamageMultiplier

	local didSpawn, monster = MonsterService.SpawnBossNearPlayer(origin, player, {
		Template = template,
		TemplateName = templateName,
		MaxHealth = BossConfig.MaxHealth,
		AttackDamage = attackDamage,
		BossName = BossConfig.DisplayName,
		SafetyDistance = BossConfig.SpawnSafetyDistance,
		SpeedMultiplier = BossConfig.SpeedMultiplier,
		UseProceduralMotion = false,
		DropLoot = false,
		OnHealthChanged = function(changedMonster, health, maxHealth)
			local currentState = statesByUserId[player.UserId]

			if currentState ~= nil and currentState.Phase == "Active" and currentState.Boss == changedMonster then
				sendBossBar(player, changedMonster, health, maxHealth)
			end
		end,
		OnDefeated = function(defeatedMonster, killer)
			onBossDefeated(player, defeatedMonster, killer)
		end,
	})

	if not didSpawn or monster == nil then
		local onFailed = state.OnFailed

		if state.Portal ~= nil and state.Portal.Parent ~= nil then
			state.Portal:SetAttribute("BossPortalActivated", false)
		end

		clearPlayerState(player)

		if onFailed ~= nil then
			onFailed()
		end

		DebugLog.Warn("Boss", "Invocation boss echouee", {
			Player = player.Name,
			Portal = state.Portal,
		})
		return
	end

	state.Phase = "Active"
	state.Boss = monster
	AudioService.PlayForPlayer(player, "BossArrival")
	sendBossBar(player, monster, BossConfig.MaxHealth, BossConfig.MaxHealth)
	BossAttackService.Activate(player, monster, attackDamage)

	DebugLog.Info("Boss", "Combat boss commence", {
		Player = player.Name,
		Boss = monster,
		Health = BossConfig.MaxHealth,
		AttackDamage = attackDamage,
		Template = templateName,
	})
end

function BossService.TryStartBoss(player, portal, onFailed)
	if player == nil then
		return false, "PlayerMissing"
	end

	if portal == nil then
		return false, "PortalMissing"
	end

	if not RunStateService.IsRunActive(player) then
		return false, "RunInactive"
	end

	if CombatStateService.IsPaused() then
		return false, "CombatPaused"
	end

	if statesByUserId[player.UserId] ~= nil or portal:GetAttribute("BossPortalActivated") == true then
		return false, "BossAlreadyActive"
	end

	local position = getPortalPosition(portal)

	if position == nil then
		DebugLog.Warn("Boss", "Activation portail refusee, position absente", {
			Player = player.Name,
			Portal = portal,
		})
		return false, "PortalPositionMissing"
	end

	local state = {
		Phase = "Announcing",
		Portal = portal,
		Boss = nil,
		OnFailed = onFailed,
	}

	statesByUserId[player.UserId] = state
	portal:SetAttribute("BossPortalActivated", true)
	HudMessageService.Show(player, "BossArrival", {
		Duration = BossConfig.AnnouncementDuration,
	})

	task.delay(BossConfig.AnnouncementDuration + BossConfig.AnnouncementReleaseDelay, function()
		spawnBossAfterAnnouncement(player, state)
	end)

	DebugLog.Info("Boss", "Portail boss active", {
		Player = player.Name,
		Portal = portal,
		Position = position,
	})

	return true, "Ok"
end

function BossService.RemovePlayer(player)
	clearPlayerState(player)
end

function BossService.Start()
	if isStarted then
		return
	end

	isStarted = true
	loadBossTemplate()
	BossAttackService.Start()

	RunStateService.RunStarted:Connect(function(player)
		clearPlayerState(player)
	end)

	RunStateService.RunEnded:Connect(function(player)
		clearPlayerState(player)
	end)

	decisionRemote.OnServerEvent:Connect(function(player, action)
		local state = statesByUserId[player.UserId]

		if state == nil or state.Phase ~= "Decision" or not RunEndService.IsLevelValidated(player) then
			return
		end

		if action == "Continue" then
			state.Phase = "Surviving"
			CombatStateService.Resume(getDecisionPauseReason(player))
			bossRemote:FireClient(player, {
				Action = "HideDecision",
			})
			DebugLog.Info("Boss", "Victoire boss, survie continue", {
				Player = player.Name,
			})
			return
		end

		if action == "Exit" then
			CombatStateService.Resume(getDecisionPauseReason(player))
			RunStateService.EndRun(player, "VictoryExit")
		end
	end)

	DebugLog.Info("Boss", "BossService demarre", {
		Template = bossTemplate,
		TemplateName = bossTemplateName,
	})
end

return BossService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">ChapterProgressService</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChapterConfig = require(Shared:WaitForChild("ChapterConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local ChapterProgressService = {}

local chapterDataStore = DataStoreService:GetDataStore(ChapterConfig.DataStoreName)
local profilesByUserId = {}
local isStarted = false

local function getOrCreateRemote(remoteName, className)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new(className)
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote.ClassName == className, remoteName .. " doit etre un " .. className .. ".")
	return remote
end

local getStateRemote = getOrCreateRemote("Chapter_GetState", "RemoteFunction")
local selectRemote = getOrCreateRemote("Chapter_Select", "RemoteEvent")

local function createDefaultData()
	return {
		Version = ChapterConfig.DataVersion,
		HighestUnlockedChapter = ChapterConfig.DefaultUnlockedChapter,
		CompletedChapters = {},
	}
end

local function normalizeData(rawData)
	local data = createDefaultData()

	if typeof(rawData) ~= "table" then
		return data
	end

	local chapterCount = ChapterConfig.GetChapterCount()
	data.HighestUnlockedChapter = math.clamp(
		math.floor(tonumber(rawData.HighestUnlockedChapter) or ChapterConfig.DefaultUnlockedChapter),
		ChapterConfig.DefaultUnlockedChapter,
		chapterCount
	)

	if typeof(rawData.CompletedChapters) == "table" then
		for chapterId, isCompleted in pairs(rawData.CompletedChapters) do
			local numericChapterId = math.floor(tonumber(chapterId) or 0)

			if ChapterConfig.GetChapter(numericChapterId) ~= nil and isCompleted == true then
				data.CompletedChapters[tostring(numericChapterId)] = true
			end
		end
	end

	return data
end

local function getDataStoreKey(player)
	return "Player_" .. player.UserId
end

local function getOrCreateProfile(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		profile = {
			Data = createDefaultData(),
			Loaded = false,
			SessionOnly = false,
			Dirty = false,
		}
		profilesByUserId[player.UserId] = profile
	end

	return profile
end

local function countCompletedChapters(data)
	local count = 0

	for _, isCompleted in pairs(data.CompletedChapters) do
		if isCompleted == true then
			count += 1
		end
	end

	return count
end

local function publishProfile(player, profile)
	player:SetAttribute(ChapterConfig.HighestUnlockedChapterAttributeName, profile.Data.HighestUnlockedChapter)
	player:SetAttribute(ChapterConfig.CompletedChapterCountAttributeName, countCompletedChapters(profile.Data))

	local selectedChapter = math.floor(tonumber(player:GetAttribute(ChapterConfig.SelectedChapterAttributeName)) or 1)

	if selectedChapter > profile.Data.HighestUnlockedChapter or ChapterConfig.GetChapter(selectedChapter) == nil then
		selectedChapter = profile.Data.HighestUnlockedChapter
	end

	player:SetAttribute(ChapterConfig.SelectedChapterAttributeName, selectedChapter)
end

function ChapterProgressService.SetupPlayer(player)
	local profile = getOrCreateProfile(player)
	local success, rawData = pcall(function()
		return chapterDataStore:GetAsync(getDataStoreKey(player))
	end)

	if success then
		profile.Data = normalizeData(rawData)
		profile.Loaded = true
		profile.SessionOnly = false
	elseif RunService:IsStudio() then
		profile.Data = createDefaultData()
		profile.Loaded = true
		profile.SessionOnly = true
		DebugLog.Warn("Chapter", "DataStore des chapitres indisponible dans Studio", {
			Player = player.Name,
			Error = tostring(rawData),
		})
	else
		profile.Loaded = false
		DebugLog.Warn("Chapter", "Chargement de progression impossible", {
			Player = player.Name,
			Error = tostring(rawData),
		})
	end

	publishProfile(player, profile)

	DebugLog.Info("Chapter", "Progression chapitre chargee", {
		Player = player.Name,
		HighestUnlockedChapter = profile.Data.HighestUnlockedChapter,
		CompletedChapters = countCompletedChapters(profile.Data),
	})
end

function ChapterProgressService.IsChapterUnlocked(player, chapterId)
	local chapter = ChapterConfig.GetChapter(chapterId)
	local profile = player and profilesByUserId[player.UserId]

	return chapter ~= nil and profile ~= nil and profile.Loaded and chapter.Id <= profile.Data.HighestUnlockedChapter
end

function ChapterProgressService.GetSelectedChapter(player)
	local selectedChapter = math.floor(tonumber(player:GetAttribute(ChapterConfig.SelectedChapterAttributeName)) or 1)

	if ChapterProgressService.IsChapterUnlocked(player, selectedChapter) then
		return selectedChapter
	end

	return 1
end

function ChapterProgressService.SelectChapter(player, chapterId)
	local chapter = ChapterConfig.GetChapter(chapterId)

	if chapter == nil then
		return false, "UnknownChapter"
	end

	if not ChapterProgressService.IsChapterUnlocked(player, chapter.Id) then
		return false, "ChapterLocked"
	end

	player:SetAttribute(ChapterConfig.SelectedChapterAttributeName, chapter.Id)
	return true, "Ok"
end

function ChapterProgressService.MarkChapterCompleted(player, chapterId)
	local chapter = ChapterConfig.GetChapter(chapterId)
	local profile = player and profilesByUserId[player.UserId]

	if chapter == nil or profile == nil or not profile.Loaded then
		return false
	end

	local wasCompleted = profile.Data.CompletedChapters[tostring(chapter.Id)] == true
	local previousHighestUnlockedChapter = profile.Data.HighestUnlockedChapter
	profile.Data.CompletedChapters[tostring(chapter.Id)] = true
	profile.Data.HighestUnlockedChapter = math.max(
		profile.Data.HighestUnlockedChapter,
		math.min(ChapterConfig.GetChapterCount(), chapter.Id + 1)
	)
	local newlyUnlockedChapterId = nil

	if profile.Data.HighestUnlockedChapter > previousHighestUnlockedChapter then
		newlyUnlockedChapterId = profile.Data.HighestUnlockedChapter
	end
	profile.Dirty = true
	publishProfile(player, profile)

	DebugLog.Info("Chapter", "Chapitre valide", {
		Player = player.Name,
		ChapterId = chapter.Id,
		HighestUnlockedChapter = profile.Data.HighestUnlockedChapter,
	})

	return true, {
		WasAlreadyCompleted = wasCompleted,
		NewlyUnlockedChapterId = newlyUnlockedChapterId,
	}
end

function ChapterProgressService.SavePlayer(player)
	local profile = player and profilesByUserId[player.UserId]

	if profile == nil or not profile.Loaded or not profile.Dirty then
		return true
	end

	if profile.SessionOnly then
		profile.Dirty = false
		return true
	end

	local success, updatedData = pcall(function()
		return chapterDataStore:UpdateAsync(getDataStoreKey(player), function(rawData)
			local data = normalizeData(rawData)
			data.HighestUnlockedChapter = math.max(data.HighestUnlockedChapter, profile.Data.HighestUnlockedChapter)

			for chapterId, isCompleted in pairs(profile.Data.CompletedChapters) do
				if isCompleted == true then
					data.CompletedChapters[chapterId] = true
				end
			end

			return data
		end)
	end)

	if not success then
		DebugLog.Warn("Chapter", "Sauvegarde de progression impossible", {
			Player = player.Name,
			Error = tostring(updatedData),
		})
		return false
	end

	profile.Data = normalizeData(updatedData)
	profile.Dirty = false
	publishProfile(player, profile)
	return true
end

function ChapterProgressService.RemovePlayer(player)
	ChapterProgressService.SavePlayer(player)
	profilesByUserId[player.UserId] = nil
end

function ChapterProgressService.Start()
	if isStarted then
		return
	end

	isStarted = true

	getStateRemote.OnServerInvoke = function(player)
		local profile = profilesByUserId[player.UserId]
		local chapters = {}

		for chapterId = 1, ChapterConfig.GetChapterCount() do
			local chapter = ChapterConfig.GetChapter(chapterId)
			table.insert(chapters, {
				Id = chapter.Id,
				DisplayName = chapter.DisplayName,
				MapId = chapter.MapTemplateName,
				IsUnlocked = ChapterProgressService.IsChapterUnlocked(player, chapter.Id),
				IsCompleted = profile ~= nil and profile.Data.CompletedChapters[tostring(chapter.Id)] == true,
				IsSelected = ChapterProgressService.GetSelectedChapter(player) == chapter.Id,
			})
		end

		return chapters
	end

	selectRemote.OnServerEvent:Connect(function(player, chapterId)
		local selected, reason = ChapterProgressService.SelectChapter(player, chapterId)

		if not selected then
			DebugLog.Warn("Chapter", "Selection chapitre refusee", {
				Player = player.Name,
				ChapterId = chapterId,
				Reason = reason,
			})
		end
	end)

	DebugLog.Info("Chapter", "ChapterProgressService demarre")
end

return ChapterProgressService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">ChestService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChestConfig = require(Shared:WaitForChild("ChestConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local RunItemConfig = require(Shared:WaitForChild("RunItemConfig"))

local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local AudioService = require(script.Parent:WaitForChild("AudioService"))
local CoinService = require(script.Parent:WaitForChild("CoinService"))
local RunAnalyticsService = require(script.Parent:WaitForChild("RunAnalyticsService"))
local RunActionCreditService = require(script.Parent:WaitForChild("RunActionCreditService"))
local RunItemService = require(script.Parent:WaitForChild("RunItemService"))
local TemplateService = require(script.Parent:WaitForChild("TemplateService"))
local WorldSpawnService = require(script.Parent:WaitForChild("WorldSpawnService"))

local ChestService = {}

local rng = Random.new()
local profilesByUserId = {}
local trackedChests = {}
local isStarted = false
local runtimeFolder = nil
local chestTemplate = nil
local openChestTemplate = nil
local spawnedChestCount = 0
local rewardChestTouchConnections = {}

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local openRequestRemote = getOrCreateRemote("Chest_OpenRequest")
local openResultRemote = getOrCreateRemote("Chest_OpenResult")
local openFailedRemote = getOrCreateRemote("Chest_OpenFailed")
local choiceRequestRemote = getOrCreateRemote("Chest_ChoiceRequest")
local choiceResultRemote = getOrCreateRemote("Chest_ChoiceResult")
local priceUpdateRemote = getOrCreateRemote("Chest_PriceUpdate")

local onOpenRequested = nil

local function createFallbackChestTemplate(templateStorage)
	local model = Instance.new("Model")
	model.Name = ChestConfig.ChestName

	local base = Instance.new("Part")
	base.Name = "Base"
	base.Size = Vector3.new(4, 2.4, 3)
	base.Color = Color3.fromRGB(115, 74, 38)
	base.Material = Enum.Material.Wood
	base.Anchored = true
	base.Parent = model

	local lid = Instance.new("Part")
	lid.Name = "Lid"
	lid.Size = Vector3.new(4.2, 0.7, 3.2)
	lid.Position = Vector3.new(0, 1.55, 0)
	lid.Color = Color3.fromRGB(145, 96, 47)
	lid.Material = Enum.Material.WoodPlanks
	lid.Anchored = true
	lid.Parent = model

	local band = Instance.new("Part")
	band.Name = "Band"
	band.Size = Vector3.new(4.4, 0.25, 0.35)
	band.Position = Vector3.new(0, 0.45, -1.62)
	band.Color = Color3.fromRGB(235, 188, 82)
	band.Material = Enum.Material.Metal
	band.Anchored = true
	band.Parent = model

	model.PrimaryPart = base
	model.Parent = templateStorage

	DebugLog.Warn("Chest", "Template Chest introuvable, fallback cree")

	return model
end

local function getPauseReason(player)
	return "ChestOpening_" .. player.UserId
end

local function getOrCreateProfile(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		profile = {
			NextOpenCost = ChestConfig.BaseOpenCost,
			ActiveOpening = nil,
			NextOpeningId = 0,
			BannedItemIds = {},
		}
		profilesByUserId[player.UserId] = profile
	end

	return profile
end

local function sendPrice(player)
	local profile = getOrCreateProfile(player)

	priceUpdateRemote:FireClient(player, {
		NextOpenCost = profile.NextOpenCost,
		Coins = CoinService.GetCoins(player),
	})
end

local function getChestContainer(instance)
	local current = instance

	while current ~= nil and current ~= Workspace do
		if current.Name == ChestConfig.ChestName then
			return current
		end

		current = current.Parent
	end

	return nil
end

local function findChestRoot(chest)
	if chest:IsA("BasePart") then
		return chest
	end

	if chest:IsA("Model") and chest.PrimaryPart ~= nil then
		return chest.PrimaryPart
	end

	local root = chest:FindFirstChildWhichIsA("BasePart", true)

	if root ~= nil and chest:IsA("Model") then
		chest.PrimaryPart = root
	end

	return root
end

local function resolveChest(instance)
	if typeof(instance) ~= "Instance" then
		return nil
	end

	local chest = getChestContainer(instance)

	if chest == nil or findChestRoot(chest) == nil then
		return nil
	end

	return chest
end

local function getChestPosition(chest)
	if chest:IsA("Model") then
		local cframe = chest:GetBoundingBox()

		return cframe.Position
	end

	if chest:IsA("BasePart") then
		return chest.Position
	end

	local root = findChestRoot(chest)

	if root == nil then
		return nil
	end

	return root.Position
end

local function setupPrompt(chest)
	local root = findChestRoot(chest)

	if root == nil then
		return nil
	end

	local prompt = root:FindFirstChild(ChestConfig.PromptName)

	if prompt == nil then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = ChestConfig.PromptName
		prompt.Parent = root
	end

	assert(prompt:IsA("ProximityPrompt"), ChestConfig.PromptName .. " doit etre un ProximityPrompt.")

	prompt.ActionText = ChestConfig.PromptText
	prompt.ObjectText = ChestConfig.PromptObjectText
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = ChestConfig.PromptDistance
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.Enabled = chest:GetAttribute("ChestOpened") ~= true and chest:GetAttribute("ChestOpening") ~= true

	prompt.Triggered:Connect(function(player)
		if onOpenRequested ~= nil then
			onOpenRequested(player, chest)
		end
	end)

	return prompt
end

local function trackChest(instance)
	local chest = resolveChest(instance)

	if chest == nil then
		return
	end

	if trackedChests[chest] ~= nil then
		return
	end

	if chest:GetAttribute("ChestOpened") == nil then
		chest:SetAttribute("ChestOpened", false)
	end

	if chest:GetAttribute("ChestOpening") == nil then
		chest:SetAttribute("ChestOpening", false)
	end

	local prompt = setupPrompt(chest)

	trackedChests[chest] = {
		Opened = chest:GetAttribute("ChestOpened") == true,
		Prompt = prompt,
	}

	if prompt == nil then
		DebugLog.Warn("Chest", "Chest sans BasePart, interaction impossible", {
			Chest = chest,
		})
	end
end

local function scanExistingChests()
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		trackChest(descendant)
	end
end

local function pivotInstance(instance, cframe)
	if instance:IsA("Model") or instance:IsA("BasePart") then
		instance:PivotTo(cframe)
	end
end

local function prepareChestInstance(chest)
	for _, descendant in ipairs(chest:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end

	if chest:IsA("BasePart") then
		chest.Anchored = true
		chest.CanTouch = false
		chest.CanQuery = false
	end

	if chest:GetAttribute("ChestOpened") == nil then
		chest:SetAttribute("ChestOpened", false)
	end

	if chest:GetAttribute("ChestOpening") == nil then
		chest:SetAttribute("ChestOpening", false)
	end
end

local function getOccupiedSurfacePositions()
	local occupiedPositions = WorldSpawnService.GetPositionsFromFolder(runtimeFolder)

	for _, position in ipairs(WorldSpawnService.GetPositionsFromFolder(TemplateService.GetShrinesRuntimeFolder())) do
		table.insert(occupiedPositions, position)
	end

	for chest in pairs(trackedChests) do
		local position = WorldSpawnService.GetInstancePosition(chest)

		if position ~= nil then
			table.insert(occupiedPositions, position)
		end
	end

	return occupiedPositions
end

local function spawnChestAtSurface(surfacePosition)
	if chestTemplate == nil then
		return nil
	end

	local chest = chestTemplate:Clone()
	chest.Name = ChestConfig.ChestName
	chest.Parent = runtimeFolder
	prepareChestInstance(chest)

	local root = findChestRoot(chest)

	if root == nil then
		DebugLog.Warn("Chest", "Chest sans BasePart, generation annulee", {
			Chest = chest,
		})
		chest:Destroy()
		return nil
	end

	local pivotPosition = WorldSpawnService.GetSurfacePivotPosition(
		chest,
		surfacePosition,
		ChestConfig.SpawnSurfaceOffset
	)

	pivotInstance(chest, WorldSpawnService.GetPivotCFrameAtPosition(chest, pivotPosition, rng:NextNumber(0, math.pi * 2)))
	trackChest(chest)
	spawnedChestCount += 1

	DebugLog.Info("Chest", "Chest genere", {
		Chest = chest,
		SurfacePosition = surfacePosition,
		PivotPosition = pivotPosition,
		SpawnedCount = spawnedChestCount,
	})

	return chest
end

local function spawnInitialChests(generationOptions)
	if chestTemplate == nil then
		DebugLog.Warn("Chest", "Generation coffres impossible, template absent")
		return
	end

	local neededCount = math.max(0, ChestConfig.InitialSpawnCount - spawnedChestCount)

	if neededCount <= 0 then
		DebugLog.Info("Chest", "Generation coffres ignoree, limite deja atteinte", {
			SpawnedCount = spawnedChestCount,
			Limit = ChestConfig.InitialSpawnCount,
		})
		return
	end

	DebugLog.Info("Chest", "Generation coffres repartis demandee", {
		Requested = neededCount,
		MaxRadius = ChestConfig.SpawnWorldMaxRadius,
		MinDistance = ChestConfig.SpawnWorldMinObjectDistance,
	})

	local surfacePositions = WorldSpawnService.FindDistributedSurfacePositions({
		Count = neededCount,
		Center = ChestConfig.SpawnWorldCenter,
		MinRadius = ChestConfig.SpawnWorldMinRadius,
		MaxRadius = ChestConfig.SpawnWorldMaxRadius,
		MinDistance = ChestConfig.SpawnWorldMinObjectDistance,
		AttemptsPerPoint = ChestConfig.SpawnWorldAttemptsPerChest,
		JitterRadius = ChestConfig.SpawnWorldJitterRadius,
		UsePlayableBounds = true,
		EdgeInset = ChestConfig.SpawnWorldEdgeInset,
		RaycastHeight = ChestConfig.SpawnRaycastHeight,
		RaycastDepth = ChestConfig.SpawnRaycastDepth,
		RejectedSurfaceNameContains = ChestConfig.RejectedSurfaceNameContains,
		OccupiedPositions = getOccupiedSurfacePositions(),
		LogCategory = "Chest",
		LogLabel = "coffres",
	})
	local batchSize = math.max(1, math.floor(tonumber(generationOptions and generationOptions.BatchSize) or #surfacePositions))

	for index, surfacePosition in ipairs(surfacePositions) do
		if spawnedChestCount >= ChestConfig.InitialSpawnCount then
			break
		end

		spawnChestAtSurface(surfacePosition)

		if generationOptions ~= nil and index % batchSize == 0 and index < #surfacePositions then
			if generationOptions.OnBatch ~= nil then
				generationOptions.OnBatch(spawnedChestCount, ChestConfig.InitialSpawnCount)
			end
			task.wait()
		end
	end

	if generationOptions ~= nil and generationOptions.OnBatch ~= nil then
		generationOptions.OnBatch(spawnedChestCount, ChestConfig.InitialSpawnCount)
	end

	DebugLog.Info("Chest", "Generation coffres initiale terminee", {
		Requested = ChestConfig.InitialSpawnCount,
		SpawnedCount = spawnedChestCount,
	})
end

function ChestService.ClearRunContent()
	for chest, connections in pairs(rewardChestTouchConnections) do
		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end
		rewardChestTouchConnections[chest] = nil
	end

	if runtimeFolder ~= nil then
		for _, child in ipairs(runtimeFolder:GetChildren()) do
			child:Destroy()
		end
	end

	trackedChests = {}
	spawnedChestCount = 0
end

function ChestService.GenerateForRun(session, generationOptions)
	rng = Random.new((math.floor(tonumber(session and session.Seed) or 0) + 201) % 2147483647)
	ChestService.ClearRunContent()
	spawnInitialChests(generationOptions)
	return spawnedChestCount
end

local function getPlayerRoot(player)
	local character = player.Character

	if character == nil then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function getRewardOptions(player)
	local rewards = {}
	local profile = getOrCreateProfile(player)
	local itemIds = RunItemService.GetEligibleRewardItemIds(player, RunItemConfig.ChestRewardIds)

	for _, itemId in ipairs(itemIds) do
		local definition = RunItemConfig.Definitions[itemId]

		if definition ~= nil and profile.BannedItemIds[itemId] ~= true then
			table.insert(rewards, definition)
		end
	end

	return rewards
end

local function getRewardWeight(reward)
	local rarityWeights = RunItemConfig.ChestRarityWeights or {}
	return math.max(0, rarityWeights[reward.Rarity] or 1)
end

local function pickReward(player)
	local rewards = getRewardOptions(player)

	if #rewards == 0 then
		return nil
	end
	local totalWeight = 0

	for _, candidate in ipairs(rewards) do
		totalWeight += getRewardWeight(candidate)
	end

	local reward = nil

	if totalWeight > 0 then
		local roll = rng:NextNumber(0, totalWeight)

		for _, candidate in ipairs(rewards) do
			roll -= getRewardWeight(candidate)

			if roll <= 0 then
				reward = candidate
				break
			end
		end
	end

	if reward == nil then
		reward = rewards[rng:NextInteger(1, #rewards)]
	end

	return {
		Id = reward.Id,
		Name = reward.Name,
		Description = reward.Description,
		Icon = reward.Icon,
		Accent = reward.Accent,
		Rarity = reward.Rarity,
	}
end

local function createSpinItems(player, finalReward)
	local rewards = getRewardOptions(player)
	local spinItems = {}

	if #rewards == 0 then
		return { finalReward }
	end

	for index = 1, 18 do
		local reward = rewards[rng:NextInteger(1, #rewards)]

		spinItems[index] = {
			Id = reward.Id,
			Name = reward.Name,
			Icon = reward.Icon,
			Rarity = reward.Rarity,
		}
	end

	spinItems[#spinItems + 1] = finalReward

	return spinItems
end

local function sendOpenFailed(player, reason)
	local profile = getOrCreateProfile(player)

	DebugLog.Info("Chest", "Ouverture coffre refusee", {
		Player = player.Name,
		Reason = reason,
		NextOpenCost = profile.NextOpenCost,
		Coins = CoinService.GetCoins(player),
	})

	openFailedRemote:FireClient(player, {
		Reason = reason,
		NextOpenCost = profile.NextOpenCost,
		Coins = CoinService.GetCoins(player),
	})
end

local function applyReward(player, reward)
	if reward == nil then
		return nil
	end

	local added, result = RunItemService.AddItem(player, reward.Id)

	if not added then
		DebugLog.Warn("Chest", "Recompense coffre non appliquee", {
			Player = player.Name,
			Reward = reward.Name,
			Reason = result,
		})
		return nil
	end

	DebugLog.Info("Chest", "Recompense coffre validee", {
		Player = player.Name,
		Reward = reward.Name,
		Stacks = result.Stacks,
	})

	return result
end

local function disconnectRewardChestTouches(chest)
	local connections = rewardChestTouchConnections[chest]

	if connections == nil then
		return
	end

	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end

	rewardChestTouchConnections[chest] = nil
end

local function destroyChest(chest)
	if chest ~= nil then
		trackedChests[chest] = nil
		disconnectRewardChestTouches(chest)

		if chest.Parent ~= nil then
			chest:Destroy()
		end
	end
end

local function finishOpening(player, accepted)
	local profile = getOrCreateProfile(player)
	local activeOpening = profile.ActiveOpening

	if activeOpening == nil then
		return
	end

	profile.ActiveOpening = nil
	CombatStateService.Resume(getPauseReason(player))

	local itemResult = if accepted then applyReward(player, activeOpening.Reward) else nil
	local isNewItem = itemResult ~= nil and itemResult.Stacks == 1

	destroyChest(activeOpening.Chest)
	DebugLog.Info("Chest", "Ouverture coffre terminee", {
		Player = player.Name,
		Accepted = accepted,
		NextOpenCost = profile.NextOpenCost,
	})

	choiceResultRemote:FireClient(player, {
		Accepted = accepted,
		Reward = activeOpening.Reward,
		ItemCount = itemResult and itemResult.Stacks or nil,
		IsNewItem = isNewItem,
		NextOpenCost = profile.NextOpenCost,
	})
end

local function canOpenChest(player, chest, chestState)
	if CombatStateService.IsPaused() then
		return false
	end

	if chest == nil or chest.Parent == nil then
		return false
	end

	if chestState == nil or chestState.Opened or chest:GetAttribute("ChestOpened") == true then
		return false
	end

	local playerRoot = getPlayerRoot(player)
	local chestPosition = getChestPosition(chest)

	if playerRoot == nil or chestPosition == nil then
		return false
	end

	local distance = (playerRoot.Position - chestPosition).Magnitude

	return distance <= ChestConfig.OpenDistance
end

onOpenRequested = function(player, chest)
	local profile = getOrCreateProfile(player)

	if profile.ActiveOpening ~= nil then
		sendOpenFailed(player, "OpeningAlreadyActive")
		return
	end

	chest = resolveChest(chest)

	if chest == nil then
		sendOpenFailed(player, "ChestMissing")
		return
	end

	if trackedChests[chest] == nil then
		trackChest(chest)
	end

	local chestState = trackedChests[chest]

	if not canOpenChest(player, chest, chestState) then
		sendOpenFailed(player, "TooFarOrUnavailable")
		return
	end

	local reward = pickReward(player)
	if reward == nil then
		sendOpenFailed(player, "NoEligibleReward")
		return
	end

	local currentCost = profile.NextOpenCost
	local didSpend = CoinService.TrySpendCoins(player, currentCost)

	if not didSpend then
		sendOpenFailed(player, "NotEnoughCoins")
		return
	end

	chestState.Opened = true
	chest:SetAttribute("ChestOpening", true)
	chest:SetAttribute("ChestOpened", true)
	RunAnalyticsService.RecordChestOpened(player, false)
	RunItemService.OnChestOpened(player)

	if chestState.Prompt ~= nil then
		chestState.Prompt.Enabled = false
	end

	AudioService.PlayForPlayer(player, "ChestOpen")

	profile.NextOpeningId += 1
	profile.NextOpenCost += ChestConfig.OpenCostIncrease
	profile.ActiveOpening = {
		OpeningId = tostring(player.UserId) .. "_" .. tostring(profile.NextOpeningId),
		Chest = chest,
		Reward = reward,
	}

	CombatStateService.Pause(getPauseReason(player))
	sendPrice(player)

	DebugLog.Info("Chest", "Ouverture coffre demarree", {
		Player = player.Name,
		Chest = chest,
		Cost = currentCost,
		NextOpenCost = profile.NextOpenCost,
		Reward = reward.Name,
	})

	openResultRemote:FireClient(player, {
		OpeningId = profile.ActiveOpening.OpeningId,
		Chest = chest,
		Reward = reward,
		SpinItems = createSpinItems(player, reward),
		Duration = ChestConfig.SlotDuration,
		Cost = currentCost,
		NextOpenCost = profile.NextOpenCost,
	})
end

local function onChoiceRequested(player, openingId, action)
	local profile = getOrCreateProfile(player)
	local activeOpening = profile.ActiveOpening

	if activeOpening == nil or activeOpening.OpeningId ~= tostring(openingId) then
		return
	end

	if action == "Accept" then
		finishOpening(player, true)
	elseif action == "Skip" then
		finishOpening(player, false)
	elseif action == "Pass" then
		local consumed, reason = RunActionCreditService.TryConsume(player, "Pass")

		if not consumed then
			DebugLog.Warn("Chest", "Passer coffre refuse", {
				Player = player.Name,
				OpeningId = activeOpening.OpeningId,
				Reason = reason,
			})
			return
		end

		DebugLog.Info("Chest", "Recompense coffre passee", {
			Player = player.Name,
			OpeningId = activeOpening.OpeningId,
		})
		finishOpening(player, false)
	elseif action == "Ban" then
		local consumed, reason = RunActionCreditService.TryConsume(player, "Ban")

		if not consumed then
			DebugLog.Warn("Chest", "Bannissement objet refuse", {
				Player = player.Name,
				OpeningId = activeOpening.OpeningId,
				Reason = reason,
			})
			return
		end

		profile.BannedItemIds[activeOpening.Reward.Id] = true
		DebugLog.Info("Chest", "Objet banni pour la run", {
			Player = player.Name,
			OpeningId = activeOpening.OpeningId,
			ItemId = activeOpening.Reward.Id,
		})
		finishOpening(player, false)
	end
end

local function getOrLoadOpenChestTemplate()
	if openChestTemplate ~= nil then
		return openChestTemplate
	end

	openChestTemplate = TemplateService.GetTemplate(ChestConfig.TemplateFolderName, ChestConfig.OpenChestName)

	if openChestTemplate == nil then
		DebugLog.Warn("Chest", "Template ChestOpen introuvable", {
			Template = ChestConfig.OpenChestName,
			Folder = ChestConfig.TemplateFolderName,
		})
	end

	return openChestTemplate
end

local function getRewardChestSurfacePosition(position)
	local surfacePosition = WorldSpawnService.FindSurfacePositionAtXZ(position.X, position.Z, {
		Center = position,
		RaycastHeight = ChestConfig.SpawnRaycastHeight,
		RaycastDepth = ChestConfig.SpawnRaycastDepth,
		RejectedSurfaceNameContains = ChestConfig.RejectedSurfaceNameContains,
	})

	return surfacePosition or position
end

local function startRewardChestOpening(player, chest)
	local profile = getOrCreateProfile(player)

	if CombatStateService.IsPaused() or profile.ActiveOpening ~= nil then
		return
	end

	if chest == nil or chest.Parent == nil or chest:GetAttribute("ChestOpened") == true then
		return
	end

	local playerRoot = getPlayerRoot(player)
	local chestPosition = getChestPosition(chest)

	if playerRoot == nil or chestPosition == nil then
		return
	end

	if (playerRoot.Position - chestPosition).Magnitude > ChestConfig.OpenDistance then
		return
	end

	chest:SetAttribute("ChestOpening", true)
	chest:SetAttribute("ChestOpened", true)
	RunAnalyticsService.RecordChestOpened(player, true)
	RunItemService.OnChestOpened(player)

	local reward = pickReward(player)
	if reward == nil then
		return
	end

	profile.NextOpeningId += 1
	profile.ActiveOpening = {
		OpeningId = tostring(player.UserId) .. "_" .. tostring(profile.NextOpeningId),
		Chest = chest,
		Reward = reward,
		IsRewardChest = true,
	}

	CombatStateService.Pause(getPauseReason(player))

	DebugLog.Info("Chest", "Coffre reward elite ouvert", {
		Player = player.Name,
		Chest = chest,
		Reward = reward.Name,
	})

	openResultRemote:FireClient(player, {
		OpeningId = profile.ActiveOpening.OpeningId,
		Chest = chest,
		Reward = reward,
		SpinItems = createSpinItems(player, reward),
		Duration = ChestConfig.SlotDuration,
		Cost = 0,
		NextOpenCost = profile.NextOpenCost,
		IsRewardChest = true,
		Source = "EliteChallenge",
	})
end

local function connectRewardChestTouch(chest)
	local connections = {}
	local function onTouched(hit)
		local character = hit:FindFirstAncestorOfClass("Model")

		if character == nil then
			return
		end

		local player = Players:GetPlayerFromCharacter(character)

		if player ~= nil then
			startRewardChestOpening(player, chest)
		end
	end

	if chest:IsA("BasePart") then
		chest.CanTouch = true
		table.insert(connections, chest.Touched:Connect(onTouched))
	end

	for _, descendant in ipairs(chest:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.CanTouch = true
			table.insert(connections, descendant.Touched:Connect(onTouched))
		end
	end

	rewardChestTouchConnections[chest] = connections
end

function ChestService.SpawnRewardChestAtPosition(position, player)
	if position == nil then
		return nil
	end

	if runtimeFolder == nil then
		runtimeFolder = TemplateService.GetChestsRuntimeFolder()
	end

	local template = getOrLoadOpenChestTemplate()

	if template == nil then
		return nil
	end

	local surfacePosition = getRewardChestSurfacePosition(position)
	local chest = template:Clone()

	chest.Name = ChestConfig.OpenChestName
	chest.Parent = runtimeFolder
	chest:SetAttribute("RewardChest", true)
	chest:SetAttribute("ChestOpened", false)
	chest:SetAttribute("ChestOpening", false)
	prepareChestInstance(chest)

	local root = findChestRoot(chest)

	if root == nil then
		DebugLog.Warn("Chest", "ChestOpen sans BasePart, spawn annule", {
			Chest = chest,
		})
		chest:Destroy()
		return nil
	end

	local pivotPosition = WorldSpawnService.GetSurfacePivotPosition(
		chest,
		surfacePosition,
		ChestConfig.SpawnSurfaceOffset
	)

	pivotInstance(chest, WorldSpawnService.GetPivotCFrameAtPosition(chest, pivotPosition, rng:NextNumber(0, math.pi * 2)))
	connectRewardChestTouch(chest)
	AudioService.PlayForPlayer(player, "RewardChestSpawn")

	DebugLog.Info("Chest", "ChestOpen reward genere", {
		Chest = chest,
		SurfacePosition = surfacePosition,
		PivotPosition = pivotPosition,
	})

	return chest
end

function ChestService.SetupPlayer(player)
	DebugLog.Info("Chest", "Setup joueur coffre", {
		Player = player.Name,
	})
	getOrCreateProfile(player)
	sendPrice(player)
end

function ChestService.ResetRun(player)
	local profile = getOrCreateProfile(player)

	if profile.ActiveOpening ~= nil then
		finishOpening(player, false)
	end

	CombatStateService.Resume(getPauseReason(player))
	profile.NextOpenCost = ChestConfig.BaseOpenCost
	profile.NextOpeningId = 0
	profile.BannedItemIds = {}
	sendPrice(player)
end

function ChestService.RemovePlayer(player)
	local profile = profilesByUserId[player.UserId]

	if profile ~= nil and profile.ActiveOpening ~= nil then
		finishOpening(player, false)
	end

	CombatStateService.Resume(getPauseReason(player))
	profilesByUserId[player.UserId] = nil
end

function ChestService.Start()
	if isStarted then
		return
	end

	isStarted = true
	runtimeFolder = TemplateService.GetChestsRuntimeFolder()
	chestTemplate = TemplateService.GetTemplate(
		ChestConfig.TemplateFolderName,
		ChestConfig.ChestName,
		createFallbackChestTemplate
	)
	openChestTemplate = TemplateService.GetTemplate(ChestConfig.TemplateFolderName, ChestConfig.OpenChestName)
	scanExistingChests()
	DebugLog.Info("Chest", "ChestService demarre", {
		RuntimeFolder = runtimeFolder,
		Template = chestTemplate,
		OpenTemplate = openChestTemplate,
		TrackedChests = "scan et generation termines",
		SpawnedChestCount = spawnedChestCount,
		BaseOpenCost = ChestConfig.BaseOpenCost,
		OpenCostIncrease = ChestConfig.OpenCostIncrease,
	})

	Workspace.DescendantAdded:Connect(function(descendant)
		task.defer(function()
			trackChest(descendant)
		end)
	end)

	Workspace.DescendantRemoving:Connect(function(descendant)
		trackedChests[descendant] = nil
	end)

	openRequestRemote.OnServerEvent:Connect(onOpenRequested)
	choiceRequestRemote.OnServerEvent:Connect(onChoiceRequested)
end

return ChestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="66">
        <Properties>
          <string name="Name">CoinService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))

local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local PerkService = require(script.Parent:WaitForChild("PerkService"))
local RunAnalyticsService = require(script.Parent:WaitForChild("RunAnalyticsService"))
local TemplateService = require(script.Parent:WaitForChild("TemplateService"))
local PerformanceTelemetryService = require(script.Parent:WaitForChild("PerformanceTelemetryService"))

local CoinService = {}

local TEMPLATE_FOLDER_NAME = "CollectibleTemplates"
local COIN_TIER_NAMES = GameConfig.CoinTierNames or { "Coin" }
local COIN_TIER_VALUES = GameConfig.CoinTierValues or { GameConfig.CoinsPerPickup }

local profilesByUserId = {}
local trackedCoins = {}
local coinTemplatesByTier = {}
local coinPoolFolder = nil
local elapsedSinceScan = 0
local elapsedSinceMerge = 0
local elapsedSincePerfLog = 0
local maxScanMilliseconds = 0
local maxMergeMilliseconds = 0
local heartbeatConnection = nil

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local updateCoinsRemote = getOrCreateRemote("Coin_UpdateCount")
local collectCoinRemote = getOrCreateRemote("Coin_PlayCollect")
local pickupFeedbackRemote = getOrCreateRemote("PickupFeedback_Show")

local function getOrCreateFolder(parent, folderName)
	local folder = parent:FindFirstChild(folderName)

	if folder == nil then
		folder = Instance.new("Folder")
		folder.Name = folderName
		folder.Parent = parent
	end

	return folder
end

local function getRuntimeLootFolder()
	return TemplateService.GetCombatLootFolder()
end

local function getCoinPoolFolder()
	if coinPoolFolder == nil then
		coinPoolFolder = getOrCreateFolder(ServerStorage, "CoinPools")
	end

	return coinPoolFolder
end

local function getTierName(tier)
	return COIN_TIER_NAMES[tier] or COIN_TIER_NAMES[1] or "Coin"
end

local function getTierPoolFolder(tier)
	return getOrCreateFolder(getCoinPoolFolder(), getTierName(tier))
end

local function getTierValue(tier)
	return COIN_TIER_VALUES[tier] or COIN_TIER_VALUES[1] or GameConfig.CoinsPerPickup
end

local function getCoinTierByName(name)
	for tier, tierName in ipairs(COIN_TIER_NAMES) do
		if name == tierName then
			return tier
		end
	end

	return nil
end

local function sanitizeCoinCount(value)
	if typeof(value) ~= "number" then
		return 0
	end

	return math.max(0, math.floor(value))
end

local function getOrCreateProfile(player)
	local userId = player.UserId
	local profile = profilesByUserId[userId]

	if profile == nil then
		profile = {
			Coins = 0,
			Loaded = false,
			LastSaveSucceeded = false,
		}
		profilesByUserId[userId] = profile
	end

	return profile
end

local function waitForProfileLoaded(player)
	local profile = getOrCreateProfile(player)
	local startedAt = os.clock()

	while not profile.Loaded and player.Parent ~= nil and os.clock() - startedAt < 5 do
		task.wait(0.1)
	end

	return profile
end

local function sendCoinCount(player)
	local profile = getOrCreateProfile(player)

	updateCoinsRemote:FireClient(player, {
		Coins = profile.Coins,
		Loaded = profile.Loaded,
		LastSaveSucceeded = profile.LastSaveSucceeded,
	})
end

local function saveProfile(player, shouldNotify)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		return false
	end

	profile.Coins = sanitizeCoinCount(profile.Coins)
	profile.LastSaveSucceeded = true

	if shouldNotify then
		sendCoinCount(player)
	end

	return true
end

local function loadProfile(player)
	local profile = getOrCreateProfile(player)

	profile.Coins = 0
	profile.Loaded = true
	profile.LastSaveSucceeded = true
	sendCoinCount(player)
end

local function findCoinRoot(coin)
	if coin:IsA("BasePart") then
		return coin
	end

	if not coin:IsA("Model") then
		return nil
	end

	if coin.PrimaryPart ~= nil then
		return coin.PrimaryPart
	end

	local firstPart = coin:FindFirstChildWhichIsA("BasePart", true)

	if firstPart ~= nil then
		coin.PrimaryPart = firstPart
	end

	return firstPart
end

local function hasCoinModelAncestor(instance, coinName)
	local current = instance.Parent

	while current ~= nil do
		if current:IsA("Model") and current.Name == coinName then
			return true
		end

		current = current.Parent
	end

	return false
end

local function isCollectableCoin(instance)
	local tier = getCoinTierByName(instance.Name)

	if tier == nil then
		return false
	end

	if instance:IsA("Model") then
		return findCoinRoot(instance) ~= nil
	end

	if instance:IsA("BasePart") then
		return not hasCoinModelAncestor(instance, instance.Name)
	end

	return false
end

local function createFallbackCoinTemplate(templateStorage, tier)
	local part = Instance.new("Part")
	part.Name = getTierName(tier)
	part.Shape = Enum.PartType.Cylinder
	part.Size = Vector3.new(0.3, 1.4, 1.4) * (1 + ((tier - 1) * 0.25))
	part.Color = ({
		Color3.fromRGB(255, 205, 70),
		Color3.fromRGB(255, 235, 110),
		Color3.fromRGB(255, 175, 55),
	})[tier] or Color3.fromRGB(255, 205, 70)
	part.Material = Enum.Material.Metal
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Parent = templateStorage

	DebugLog.Warn("Coin", "Template coin introuvable, fallback cree", {
		Template = getTierName(tier),
		Tier = tier,
	})

	return part
end

local function findCoinTemplate(tier)
	local tierName = getTierName(tier)

	return TemplateService.GetTemplate(TEMPLATE_FOLDER_NAME, tierName, function(templateStorage)
		return createFallbackCoinTemplate(templateStorage, tier)
	end)
end

local function prepareCoin(coin)
	if coin:IsA("BasePart") then
		coin.Anchored = true
		coin.CanCollide = false
		coin.CanTouch = false
		coin.CanQuery = false
	end

	for _, descendant in ipairs(coin:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end
end

local function pivotCoin(coin, position)
	if coin:IsA("Model") or coin:IsA("BasePart") then
		coin:PivotTo(CFrame.new(position))
	end
end

local function acquireCoin(tier)
	local tierPoolFolder = getTierPoolFolder(tier)
	local coin = tierPoolFolder:FindFirstChild(getTierName(tier))

	if coin == nil then
		coin = tierPoolFolder:FindFirstChildWhichIsA("Model") or tierPoolFolder:FindFirstChildWhichIsA("BasePart")
	end

	if coin ~= nil then
		coin.Parent = getRuntimeLootFolder()
		return coin, true
	end

	coin = coinTemplatesByTier[tier]:Clone()
	coin.Parent = getRuntimeLootFolder()

	return coin, false
end

local function releaseCoin(coin, tier)
	if coin == nil or coin.Parent == nil then
		return
	end

	trackedCoins[coin] = nil
	coin.Name = getTierName(tier or getCoinTierByName(coin.Name) or 1)
	coin.Parent = getTierPoolFolder(tier or getCoinTierByName(coin.Name) or 1)
end

local function prewarmCoinPool(tier, count)
	local prewarmCount = math.max(0, math.floor(count or 0))

	if coinTemplatesByTier[tier] == nil or prewarmCount <= 0 then
		return
	end

	local tierPoolFolder = getTierPoolFolder(tier)

	for _ = 1, prewarmCount do
		local coin = coinTemplatesByTier[tier]:Clone()
		coin.Name = getTierName(tier)
		prepareCoin(coin)
		coin.Parent = tierPoolFolder
	end
end

local function getCoinPoolSize()
	local total = 0

	if coinPoolFolder == nil then
		return total
	end

	for _, folder in ipairs(coinPoolFolder:GetChildren()) do
		total += #folder:GetChildren()
	end

	return total
end

local function getTrackedCoinCount()
	local total = 0

	for _ in pairs(trackedCoins) do
		total += 1
	end

	return total
end

local function trackCoin(instance)
	if not isCollectableCoin(instance) then
		return
	end

	local tier = getCoinTierByName(instance.Name) or 1

	trackedCoins[instance] = {
		Collected = false,
		Tier = tier,
		CoinValue = getTierValue(tier),
	}
end

local function scanExistingCoins()
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		trackCoin(descendant)
	end
end

local function getPlayerRoot(player)
	local character = player.Character

	if character == nil then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function awardCoin(player, coinValue)
	local profile = waitForProfileLoaded(player)
	local finalCoinValue = PerkService.GetGoldAmount(player, coinValue or GameConfig.CoinsPerPickup)

	profile.Coins += finalCoinValue
	RunAnalyticsService.RecordCoinsEarned(player, finalCoinValue)
	sendCoinCount(player)
	DebugLog.ThrottledInfo("Coin", "coin_award_" .. player.UserId, 0.5, "Coin attribue", {
		Player = player.Name,
		Coins = profile.Coins,
		Value = finalCoinValue,
	})

	return finalCoinValue
end

local function finishCoinCollection(player, coin, coinState, attractDuration)
	if coinState.Cancelled or player.Parent ~= Players or coin.Parent == nil then
		if coin.Parent ~= nil then
			coinState.Collected = false
		end
		return
	end

	local arrivalTime = Workspace:GetServerTimeNow() + math.max(0, attractDuration)

	collectCoinRemote:FireAllClients(coin, player.UserId, attractDuration)
	DebugLog.ThrottledInfo("Coin", "coin_collect_" .. player.UserId, 0.5, "Coin collecte", {
		Player = player.Name,
		Coin = coin,
		Tier = coinState.Tier,
		CoinValue = coinState.CoinValue,
	})

	task.spawn(function()
		local finalCoinValue = awardCoin(player, coinState.CoinValue or GameConfig.CoinsPerPickup)

		pickupFeedbackRemote:FireClient(player, {
			Kind = "Coin",
			Amount = finalCoinValue,
			ArrivalTime = arrivalTime,
		})

		-- La persistance ne doit pas retarder le retour visuel de la collecte.
		saveProfile(player, true)
	end)

	task.delay(attractDuration + 0.1, function()
		if coin.Parent ~= nil then
			releaseCoin(coin, coinState.Tier)
		end
	end)
end

local function collectCoin(player, coin, coinState, attractDuration)
	if coinState.Collected then
		return false
	end

	coinState.Collected = true
	finishCoinCollection(player, coin, coinState, attractDuration or GameConfig.CoinAttractDuration)

	return true
end

local function scheduleCoinCollection(player, coin, coinState, attractDuration, delaySeconds)
	if coinState.Collected then
		return false
	end

	coinState.Collected = true

	task.delay(delaySeconds, function()
		finishCoinCollection(player, coin, coinState, attractDuration)
	end)

	return true
end

local function scanCoinProximity()
	for coin, coinState in pairs(trackedCoins) do
		if coin.Parent == nil then
			trackedCoins[coin] = nil
			continue
		end

		if coinState.Collected then
			continue
		end

		local coinRoot = findCoinRoot(coin)

		if coinRoot == nil then
			continue
		end

		for _, player in ipairs(Players:GetPlayers()) do
			local playerRoot = getPlayerRoot(player)

			if playerRoot ~= nil then
				local distance = (playerRoot.Position - coinRoot.Position).Magnitude

				if distance <= PerkService.GetCollectDistance(player, GameConfig.CoinCollectDistance) then
					collectCoin(player, coin, coinState)
					break
				end
			end
		end
	end
end

local function getMergeGridKey(cellX, cellZ)
	return tostring(cellX) .. ":" .. tostring(cellZ)
end

local function getCoinPosition(coin)
	local root = findCoinRoot(coin)

	if root == nil then
		return nil
	end

	return root.Position
end

local function buildMergeGrid(tier)
	local grid = {}
	local cellSize = GameConfig.CoinMergeRadius

	for coin, coinState in pairs(trackedCoins) do
		if coin.Parent == nil then
			trackedCoins[coin] = nil
			continue
		end

		if not coinState.Collected and coinState.Tier == tier then
			local position = getCoinPosition(coin)

			if position ~= nil then
				local cellX = math.floor(position.X / cellSize)
				local cellZ = math.floor(position.Z / cellSize)
				local key = getMergeGridKey(cellX, cellZ)

				if grid[key] == nil then
					grid[key] = {}
				end

				table.insert(grid[key], {
					Coin = coin,
					State = coinState,
					Position = position,
					CellX = cellX,
					CellZ = cellZ,
				})
			end
		end
	end

	return grid
end

local function findMergeGroup(seedEntry, grid, usedCoins)
	local group = {}
	local radius = GameConfig.CoinMergeRadius

	for offsetX = -1, 1 do
		for offsetZ = -1, 1 do
			local key = getMergeGridKey(seedEntry.CellX + offsetX, seedEntry.CellZ + offsetZ)
			local cell = grid[key]

			if cell ~= nil then
				for _, entry in ipairs(cell) do
					if not usedCoins[entry.Coin] and not entry.State.Collected then
						local distance = (entry.Position - seedEntry.Position).Magnitude

						if distance <= radius then
							table.insert(group, entry)

							if #group >= GameConfig.CoinMergeCount then
								return group
							end
						end
					end
				end
			end
		end
	end

	return group
end

local function mergeGroup(group, nextTier)
	local center = Vector3.zero

	for _, entry in ipairs(group) do
		center += entry.Position
		entry.State.Collected = true
		trackedCoins[entry.Coin] = nil

		if entry.Coin.Parent ~= nil then
			releaseCoin(entry.Coin, entry.State.Tier)
		end
	end

	center /= #group
	DebugLog.ThrottledInfo("Coin", "coin_merge", 1, "Fusion de coins", {
		Count = #group,
		NextTier = nextTier,
		Position = center,
	})
	CoinService.SpawnCoin(center, nextTier)
end

local function mergeNearbyCoins()
	local maxTier = #COIN_TIER_NAMES
	local mergedGroups = 0

	for tier = 1, maxTier - 1 do
		local grid = buildMergeGrid(tier)
		local usedCoins = {}

		for _, cell in pairs(grid) do
			for _, entry in ipairs(cell) do
				if mergedGroups >= GameConfig.CoinMergeMaxGroupsPerScan then
					return
				end

				if not usedCoins[entry.Coin] and not entry.State.Collected then
					local group = findMergeGroup(entry, grid, usedCoins)

					if #group >= GameConfig.CoinMergeCount then
						for _, groupEntry in ipairs(group) do
							usedCoins[groupEntry.Coin] = true
						end

						mergeGroup(group, tier + 1)
						mergedGroups += 1
					end
				end
			end
		end
	end
end

function CoinService.SetupPlayer(player)
	DebugLog.Info("Coin", "Setup joueur coins", {
		Player = player.Name,
	})
	getOrCreateProfile(player)
	loadProfile(player)
end

function CoinService.SavePlayer(player)
	saveProfile(player, false)
end

function CoinService.GetCoins(player)
	local profile = waitForProfileLoaded(player)

	return profile.Coins
end

function CoinService.TrySpendCoins(player, amount)
	local coinAmount = sanitizeCoinCount(amount)

	if coinAmount <= 0 then
		return true, CoinService.GetCoins(player)
	end

	local profile = waitForProfileLoaded(player)

	if profile.Coins < coinAmount then
		DebugLog.Info("Coin", "Depense coins refusee", {
			Player = player.Name,
			Requested = coinAmount,
			Coins = profile.Coins,
		})
		return false, profile.Coins
	end

	profile.Coins -= coinAmount
	RunAnalyticsService.RecordCoinsSpent(player, coinAmount)
	saveProfile(player, true)

	DebugLog.Info("Coin", "Depense coins validee", {
		Player = player.Name,
		Spent = coinAmount,
		Remaining = profile.Coins,
	})

	return true, profile.Coins
end

function CoinService.RemovePlayer(player)
	CoinService.SavePlayer(player)
	profilesByUserId[player.UserId] = nil
end

function CoinService.SpawnCoin(position, tier)
	local coinTier = math.clamp(tier or 1, 1, #COIN_TIER_NAMES)

	if coinTemplatesByTier[coinTier] == nil then
		coinTemplatesByTier[coinTier] = findCoinTemplate(coinTier)
	end

	local coin = acquireCoin(coinTier)
	coin.Name = getTierName(coinTier)

	prepareCoin(coin)
	pivotCoin(coin, position)
	trackCoin(coin)

	DebugLog.ThrottledInfo("Coin", "coin_spawn", 1, "Coin genere", {
		Coin = coin,
		Tier = coinTier,
		CoinValue = getTierValue(coinTier),
		Position = position,
	})

	return coin
end

function CoinService.CollectAllForPlayer(player, attractDuration, spreadDuration)
	local playerRoot = getPlayerRoot(player)

	if playerRoot == nil then
		return 0
	end

	local candidates = {}

	for coin, coinState in pairs(trackedCoins) do
		if coin.Parent == nil then
			trackedCoins[coin] = nil
			continue
		end

		if coinState.Collected then
			continue
		end

		local coinRoot = findCoinRoot(coin)

		if coinRoot ~= nil then
			table.insert(candidates, {
				Coin = coin,
				State = coinState,
				Distance = (playerRoot.Position - coinRoot.Position).Magnitude,
			})
		end
	end

	table.sort(candidates, function(left, right)
		return left.Distance < right.Distance
	end)

	local collectedCount = 0
	local duration = attractDuration or GameConfig.CoinAttractDuration
	local spread = spreadDuration or 0
	local delayStep = 0

	if #candidates > 1 then
		delayStep = spread / (#candidates - 1)
	end

	for index, candidate in ipairs(candidates) do
		local delaySeconds = math.min(spread, (index - 1) * delayStep)

		if scheduleCoinCollection(player, candidate.Coin, candidate.State, duration, delaySeconds) then
			collectedCount += 1
		end
	end

	DebugLog.Info("Coin", "Magnetisme global coins demande", {
		Player = player.Name,
		CollectedCount = collectedCount,
		Duration = duration,
		Spread = spread,
	})

	return collectedCount
end

function CoinService.ClearRunCoins()
	local coinsToRelease = {}

	for coin, coinState in pairs(trackedCoins) do
		table.insert(coinsToRelease, {
			Coin = coin,
			State = coinState,
		})
	end

	for _, entry in ipairs(coinsToRelease) do
		entry.State.Cancelled = true
		trackedCoins[entry.Coin] = nil

		if entry.Coin.Parent ~= nil then
			releaseCoin(entry.Coin, entry.State.Tier)
		end
	end
end

function CoinService.GetPerformanceSnapshot()
	return {
		Tracked = getTrackedCoinCount(),
		Pool = getCoinPoolSize(),
	}
end

function CoinService.ResetRun(player)
	local profile = getOrCreateProfile(player)

	profile.Coins = 0
	sendCoinCount(player)
end

function CoinService.Start()
	for tier = 1, #COIN_TIER_NAMES do
		coinTemplatesByTier[tier] = findCoinTemplate(tier)
		prewarmCoinPool(tier, (GameConfig.CoinPoolPrewarmPerTier or {})[tier])
	end

	DebugLog.Info("Coin", "CoinService demarre", {
		Tiers = COIN_TIER_NAMES,
		LootFolder = getRuntimeLootFolder(),
		CollectDistance = GameConfig.CoinCollectDistance,
		MergeRadius = GameConfig.CoinMergeRadius,
		Pool = getCoinPoolSize(),
	})
	scanExistingCoins()

	Workspace.DescendantAdded:Connect(function(descendant)
		task.defer(function()
			trackCoin(descendant)
		end)
	end)

	if heartbeatConnection ~= nil then
		return
	end

	heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
		if CombatStateService.IsPaused() then
			return
		end

		elapsedSinceScan += deltaTime
		elapsedSinceMerge += deltaTime
		elapsedSincePerfLog += deltaTime

		if elapsedSinceScan >= GameConfig.CoinScanInterval then
			elapsedSinceScan = 0
			local startedAt = os.clock()
			scanCoinProximity()
			local scanDuration = os.clock() - startedAt
			PerformanceTelemetryService.Record("Coin.ScanSeconds", scanDuration)
			maxScanMilliseconds = math.max(maxScanMilliseconds, scanDuration * 1000)
		end

		if elapsedSinceMerge >= GameConfig.CoinMergeScanInterval then
			elapsedSinceMerge = 0
			local startedAt = os.clock()
			mergeNearbyCoins()
			local mergeDuration = os.clock() - startedAt
			PerformanceTelemetryService.Record("Coin.MergeSeconds", mergeDuration)
			maxMergeMilliseconds = math.max(maxMergeMilliseconds, mergeDuration * 1000)
		end

		if elapsedSincePerfLog >= (CombatConfig.PerfLogInterval or 5) then
			DebugLog.Info("Perf", "Perf coins serveur", {
			Tracked = getTrackedCoinCount(),
			Pool = getCoinPoolSize(),
			MaxScanMs = maxScanMilliseconds,
			MaxMergeMs = maxMergeMilliseconds,
		})
			elapsedSincePerfLog = 0
			maxScanMilliseconds = 0
			maxMergeMilliseconds = 0
		end
	end)
end

return CoinService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="67">
        <Properties>
          <string name="Name">CombatStateService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local CombatStateService = {}

local pauseReasons = {}
local pauseStartedAt = nil
local totalPausedDuration = 0
local lockedHumanoids = {}
local playerCharacterConnections = {}
local isApplyingMovementLock = false
local userPausePrefix = "UserPause_"

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local togglePauseRemote = getOrCreateRemote("Combat_TogglePause")
local pauseStateRemote = getOrCreateRemote("Combat_PauseState")

local function getReasonCount()
	local count = 0

	for _ in pairs(pauseReasons) do
		count += 1
	end

	return count
end

local function getUserPauseReason(player)
	return userPausePrefix .. tostring(player.UserId)
end

local function getHumanoid(player)
	local character = player.Character

	if character == nil then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function getRootPartFromHumanoid(humanoid)
	local character = humanoid.Parent

	if character == nil then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function stopRootVelocity(humanoid)
	local root = getRootPartFromHumanoid(humanoid)

	if root == nil or not root:IsA("BasePart") then
		return
	end

	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end

local function forceHumanoidLocked(humanoid)
	isApplyingMovementLock = true
	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0
	humanoid.Jump = false
	humanoid.AutoRotate = false
	isApplyingMovementLock = false
	stopRootVelocity(humanoid)
end

local function disconnectLockConnections(lockState)
	for _, connection in ipairs(lockState.Connections) do
		connection:Disconnect()
	end

	table.clear(lockState.Connections)
end

local function watchLockedHumanoidProperty(humanoid, lockState, propertyName, lockedValue)
	local connection = humanoid:GetPropertyChangedSignal(propertyName):Connect(function()
		if isApplyingMovementLock or lockedHumanoids[humanoid] ~= lockState then
			return
		end

		local currentValue = humanoid[propertyName]

		if currentValue ~= lockedValue then
			lockState[propertyName] = currentValue
			forceHumanoidLocked(humanoid)
		end
	end)

	table.insert(lockState.Connections, connection)
end

local function lockHumanoidMovement(humanoid)
	local lockState = lockedHumanoids[humanoid]

	if lockState == nil then
		lockState = {
			WalkSpeed = humanoid.WalkSpeed,
			JumpPower = humanoid.JumpPower,
			JumpHeight = humanoid.JumpHeight,
			AutoRotate = humanoid.AutoRotate,
			Connections = {},
		}
		lockedHumanoids[humanoid] = lockState

		watchLockedHumanoidProperty(humanoid, lockState, "WalkSpeed", 0)
		watchLockedHumanoidProperty(humanoid, lockState, "JumpPower", 0)
		watchLockedHumanoidProperty(humanoid, lockState, "JumpHeight", 0)
		watchLockedHumanoidProperty(humanoid, lockState, "AutoRotate", false)

		table.insert(lockState.Connections, humanoid.AncestryChanged:Connect(function(_, parent)
			if parent == nil and lockedHumanoids[humanoid] == lockState then
				disconnectLockConnections(lockState)
				lockedHumanoids[humanoid] = nil
			end
		end))
	end

	forceHumanoidLocked(humanoid)
end

local function unlockHumanoidMovement(humanoid, lockState)
	if humanoid.Parent == nil then
		disconnectLockConnections(lockState)
		lockedHumanoids[humanoid] = nil
		return
	end

	disconnectLockConnections(lockState)
	lockedHumanoids[humanoid] = nil

	isApplyingMovementLock = true
	humanoid.WalkSpeed = lockState.WalkSpeed
	humanoid.JumpPower = lockState.JumpPower
	humanoid.JumpHeight = lockState.JumpHeight
	humanoid.AutoRotate = lockState.AutoRotate
	isApplyingMovementLock = false
end

local function lockAllPlayerMovement()
	for _, player in ipairs(Players:GetPlayers()) do
		local humanoid = getHumanoid(player)

		if humanoid ~= nil then
			lockHumanoidMovement(humanoid)
		end
	end
end

local function unlockAllPlayerMovement()
	local locksToRelease = {}

	for humanoid, lockState in pairs(lockedHumanoids) do
		table.insert(locksToRelease, {
			Humanoid = humanoid,
			LockState = lockState,
		})
	end

	for _, entry in ipairs(locksToRelease) do
		if lockedHumanoids[entry.Humanoid] == entry.LockState then
			unlockHumanoidMovement(entry.Humanoid, entry.LockState)
		end
	end
end

local function updateMovementLock()
	if getReasonCount() > 0 then
		lockAllPlayerMovement()
	else
		unlockAllPlayerMovement()
	end
end

local function hasBlockingPauseForPlayer(player)
	local userPauseReason = getUserPauseReason(player)

	for reason in pairs(pauseReasons) do
		if reason ~= userPauseReason then
			return true
		end
	end

	return false
end

local function sendPauseState(player)
	if player.Parent ~= Players then
		return
	end

	local isPaused = CombatStateService.IsPaused()
	player:SetAttribute("IsCombatPaused", isPaused)

	pauseStateRemote:FireClient(player, {
		IsPaused = isPaused,
		IsUserPaused = pauseReasons[getUserPauseReason(player)] == true,
		HasBlockingPause = hasBlockingPauseForPlayer(player),
		ReasonCount = getReasonCount(),
	})
end

local function sendPauseStateToAll()
	for _, player in ipairs(Players:GetPlayers()) do
		sendPauseState(player)
	end
end

function CombatStateService.Pause(reason)
	if pauseReasons[reason] then
		return
	end

	pauseReasons[reason] = true

	if getReasonCount() == 1 then
		pauseStartedAt = os.clock()
	end

	DebugLog.Info("Combat", "Combat pause", {
		Reason = reason,
		ReasonCount = getReasonCount(),
	})

	updateMovementLock()
	sendPauseStateToAll()
end

function CombatStateService.Resume(reason)
	if not pauseReasons[reason] then
		return
	end

	pauseReasons[reason] = nil

	if getReasonCount() == 0 and pauseStartedAt ~= nil then
		totalPausedDuration += os.clock() - pauseStartedAt
		pauseStartedAt = nil
	end

	DebugLog.Info("Combat", "Combat reprise", {
		Reason = reason,
		ReasonCount = getReasonCount(),
		TotalPausedDuration = totalPausedDuration,
	})

	updateMovementLock()
	sendPauseStateToAll()
end

function CombatStateService.IsPaused()
	return getReasonCount() > 0
end

function CombatStateService.IsPlayerPaused(player)
	return pauseReasons[getUserPauseReason(player)] == true
end

function CombatStateService.TogglePlayerPause(player)
	local userPauseReason = getUserPauseReason(player)

	if pauseReasons[userPauseReason] then
		CombatStateService.Resume(userPauseReason)
		return
	end

	if getReasonCount() > 0 then
		DebugLog.Info("Combat", "Pause joueur ignoree, autre pause active", {
			Player = player.Name,
			ReasonCount = getReasonCount(),
		})
		sendPauseState(player)
		return
	end

	CombatStateService.Pause(userPauseReason)
end

function CombatStateService.GetTime()
	local pausedNow = 0

	if pauseStartedAt ~= nil then
		pausedNow = os.clock() - pauseStartedAt
	end

	return os.clock() - totalPausedDuration - pausedNow
end

local function bindPlayer(player)
	if playerCharacterConnections[player.UserId] ~= nil then
		playerCharacterConnections[player.UserId]:Disconnect()
	end

	playerCharacterConnections[player.UserId] = player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid", 5)

		if humanoid ~= nil and CombatStateService.IsPaused() then
			lockHumanoidMovement(humanoid)
		end

		sendPauseState(player)
	end)

	if player.Character ~= nil and CombatStateService.IsPaused() then
		local humanoid = getHumanoid(player)

		if humanoid ~= nil then
			lockHumanoidMovement(humanoid)
		end
	end

	task.defer(function()
		sendPauseState(player)
	end)
end

Players.PlayerAdded:Connect(bindPlayer)

Players.PlayerRemoving:Connect(function(player)
	if playerCharacterConnections[player.UserId] ~= nil then
		playerCharacterConnections[player.UserId]:Disconnect()
		playerCharacterConnections[player.UserId] = nil
	end

	CombatStateService.Resume(getUserPauseReason(player))
end)

for _, player in ipairs(Players:GetPlayers()) do
	bindPlayer(player)
end

togglePauseRemote.OnServerEvent:Connect(function(player)
	CombatStateService.TogglePlayerPause(player)
end)

return CombatStateService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="68">
        <Properties>
          <string name="Name">CommerceService</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CommerceConfig = require(Shared:WaitForChild("CommerceConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local CommerceService = {}

local purchaseDataStore = DataStoreService:GetDataStore(CommerceConfig.DataStoreName)
local profilesByUserId = {}
local lastPurchaseRequestAtByUserId = {}
local isStarted = false

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local purchaseRequestRemote = getOrCreateRemote("Commerce_RequestPurchase")
local promptPurchaseRemote = getOrCreateRemote("Commerce_PromptPurchase")

local function createDefaultData()
	return {
		Version = 1,
		PerkRerollCredits = 0,
		ItemRerollCredits = 0,
		ProcessedReceipts = {},
	}
end

local function normalizeData(rawData)
	local data = createDefaultData()

	if typeof(rawData) ~= "table" then
		return data
	end

	data.PerkRerollCredits = math.max(0, math.floor(tonumber(rawData.PerkRerollCredits) or 0))
	data.ItemRerollCredits = math.max(0, math.floor(tonumber(rawData.ItemRerollCredits) or 0))

	if typeof(rawData.ProcessedReceipts) == "table" then
		for receiptId, timestamp in pairs(rawData.ProcessedReceipts) do
			if typeof(receiptId) == "string" and typeof(timestamp) == "number" then
				data.ProcessedReceipts[receiptId] = timestamp
			end
		end
	end

	return data
end

local function trimReceiptHistory(data)
	local receipts = {}

	for receiptId, timestamp in pairs(data.ProcessedReceipts) do
		table.insert(receipts, {
			Id = receiptId,
			Timestamp = timestamp,
		})
	end

	table.sort(receipts, function(left, right)
		return left.Timestamp < right.Timestamp
	end)

	local removeCount = #receipts - CommerceConfig.ReceiptHistoryLimit

	for index = 1, math.max(0, removeCount) do
		data.ProcessedReceipts[receipts[index].Id] = nil
	end
end

local function getDataStoreKey(player)
	return "Player_" .. player.UserId
end

local function getOrCreateProfile(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		profile = {
			Data = createDefaultData(),
			Loaded = false,
			SessionOnly = false,
			HasFounderPass = false,
		}
		profilesByUserId[player.UserId] = profile
	end

	return profile
end

local function publishProfile(player, profile)
	if player.Parent ~= Players then
		return
	end

	player:SetAttribute("PerkRerollCredits", profile.Data.PerkRerollCredits)
	player:SetAttribute("ItemRerollCredits", profile.Data.ItemRerollCredits)
	player:SetAttribute("HasFounderPass", profile.HasFounderPass == true)
end

local function refreshFounderPass(player, profile)
	local offer = CommerceConfig.GetOffer("FounderPass")

	if offer == nil or typeof(offer.ProductId) ~= "number" or offer.ProductId <= 0 then
		profile.HasFounderPass = false
		publishProfile(player, profile)
		return
	end

	local success, ownsPass = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, offer.ProductId)
	end)

	if success then
		profile.HasFounderPass = ownsPass == true
	else
		DebugLog.Warn("Commerce", "Verification du pass Fondateur impossible", {
			Player = player.Name,
			Error = tostring(ownsPass),
		})
	end

	publishProfile(player, profile)
end

local function loadProfile(player)
	local profile = getOrCreateProfile(player)
	local success, rawData = pcall(function()
		return purchaseDataStore:GetAsync(getDataStoreKey(player))
	end)

	if success then
		profile.Data = normalizeData(rawData)
		profile.Loaded = true
		profile.SessionOnly = false
	elseif RunService:IsStudio() then
		profile.Data = createDefaultData()
		profile.Loaded = true
		profile.SessionOnly = true
		DebugLog.Warn("Commerce", "DataStore indisponible dans Studio, profil de test en memoire", {
			Player = player.Name,
			Error = tostring(rawData),
		})
	else
		profile.Loaded = false
		DebugLog.Warn("Commerce", "Chargement commerce impossible", {
			Player = player.Name,
			Error = tostring(rawData),
		})
	end

	refreshFounderPass(player, profile)
end

local function applyDeveloperProductGrant(data, offer)
	data.PerkRerollCredits += math.max(0, math.floor(tonumber(offer.PerkRerollCredits) or 0))
	data.ItemRerollCredits += math.max(0, math.floor(tonumber(offer.ItemRerollCredits) or 0))
end

local function processReceipt(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)

	if player == nil then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local profile = getOrCreateProfile(player)

	if not profile.Loaded then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local offer = CommerceConfig.GetDeveloperProductOffer(receiptInfo.ProductId)

	if offer == nil then
		DebugLog.Warn("Commerce", "Receipt produit inconnu ou desactive", {
			Player = player.Name,
			ProductId = receiptInfo.ProductId,
			PurchaseId = receiptInfo.PurchaseId,
		})
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if profile.SessionOnly then
		if profile.Data.ProcessedReceipts[receiptInfo.PurchaseId] == nil then
			applyDeveloperProductGrant(profile.Data, offer)
			profile.Data.ProcessedReceipts[receiptInfo.PurchaseId] = os.time()
			trimReceiptHistory(profile.Data)
			publishProfile(player, profile)
		end

		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local success, updatedData = pcall(function()
		return purchaseDataStore:UpdateAsync(getDataStoreKey(player), function(rawData)
			local data = normalizeData(rawData)

			if data.ProcessedReceipts[receiptInfo.PurchaseId] ~= nil then
				return data
			end

			applyDeveloperProductGrant(data, offer)
			data.ProcessedReceipts[receiptInfo.PurchaseId] = os.time()
			trimReceiptHistory(data)
			return data
		end)
	end)

	if not success then
		DebugLog.Warn("Commerce", "Receipt non traite, ecriture DataStore impossible", {
			Player = player.Name,
			ProductId = receiptInfo.ProductId,
			PurchaseId = receiptInfo.PurchaseId,
			Error = tostring(updatedData),
		})
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	profile.Data = normalizeData(updatedData)
	publishProfile(player, profile)
	DebugLog.Info("Commerce", "Developer Product accorde", {
		Player = player.Name,
		Offer = offer.Id,
		ProductId = receiptInfo.ProductId,
		PurchaseId = receiptInfo.PurchaseId,
	})

	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function onPurchaseRequested(player, offerId)
	if typeof(offerId) ~= "string" then
		return
	end

	local now = os.clock()
	local lastRequestAt = lastPurchaseRequestAtByUserId[player.UserId] or 0

	if now - lastRequestAt < CommerceConfig.PurchaseRequestCooldown then
		return
	end

	lastPurchaseRequestAtByUserId[player.UserId] = now

	local offer = CommerceConfig.GetOffer(offerId)

	if not CommerceConfig.IsOfferConfigured(offer) then
		DebugLog.Warn("Commerce", "Demande achat refusee, offre non configuree", {
			Player = player.Name,
			Offer = offerId,
		})
		return
	end

	local profile = getOrCreateProfile(player)

	if not profile.Loaded then
		return
	end

	if offer.Kind == "GamePass" and profile.HasFounderPass then
		return
	end

	promptPurchaseRemote:FireClient(player, {
		OfferId = offer.Id,
		Kind = offer.Kind,
		ProductId = offer.ProductId,
	})
end

local function onGamePassPurchaseFinished(player, gamePassId, wasPurchased)
	local offer = CommerceConfig.GetOffer("FounderPass")

	if wasPurchased ~= true
		or offer == nil
		or offer.Kind ~= "GamePass"
		or offer.ProductId ~= gamePassId then
		return
	end

	local profile = getOrCreateProfile(player)
	profile.HasFounderPass = true
	publishProfile(player, profile)
	DebugLog.Info("Commerce", "Pass Fondateur confirme", {
		Player = player.Name,
		PassId = gamePassId,
	})
end

function CommerceService.TryConsumePerkReroll(player)
	local profile = getOrCreateProfile(player)

	if not profile.Loaded then
		return false, "ProfileNotLoaded"
	end

	if profile.Data.PerkRerollCredits <= 0 then
		return false, "NoCredits"
	end

	if profile.SessionOnly then
		profile.Data.PerkRerollCredits -= 1
		publishProfile(player, profile)
		return true
	end

	local consumed = false
	local success, updatedData = pcall(function()
		return purchaseDataStore:UpdateAsync(getDataStoreKey(player), function(rawData)
			local data = normalizeData(rawData)

			if data.PerkRerollCredits <= 0 then
				consumed = false
				return data
			end

			data.PerkRerollCredits -= 1
			consumed = true
			return data
		end)
	end)

	if not success then
		DebugLog.Warn("Commerce", "Consommation reroll perk impossible", {
			Player = player.Name,
			Error = tostring(updatedData),
		})
		return false, "SaveFailed"
	end

	profile.Data = normalizeData(updatedData)
	publishProfile(player, profile)

	if not consumed then
		return false, "NoCredits"
	end

	return true
end

function CommerceService.SetupPlayer(player)
	loadProfile(player)
end

function CommerceService.RemovePlayer(player)
	profilesByUserId[player.UserId] = nil
	lastPurchaseRequestAtByUserId[player.UserId] = nil
end

function CommerceService.Start()
	if isStarted then
		return
	end

	isStarted = true
	purchaseRequestRemote.OnServerEvent:Connect(onPurchaseRequested)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(onGamePassPurchaseFinished)

	MarketplaceService.ProcessReceipt = processReceipt
	DebugLog.Info("Commerce", "Service commerce demarre")
end

return CommerceService
]]></string>
        </Properties>
      </Item>
