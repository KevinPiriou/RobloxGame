local function formatTime(seconds)
	local total = math.max(0, math.floor(tonumber(seconds) or 0))
	return string.format("%02d:%02d", math.floor(total / 60), total % 60)
end

local function formatNumber(value)
	return string.format("%d", math.floor(tonumber(value) or 0))
end

local function findDefinition(definitions, id)
	for _, definition in ipairs(definitions) do
		if definition.Id == id then
			return definition
		end
	end

	return nil
end

local function formatProgression(payload)
	if payload.ProgressionEligible ~= true then
		return "Run de debug : statistiques, quetes et hauts faits non comptabilises."
	end

	local progression = payload.Progression or {}
	local lines = {}

	for _, unlock in ipairs(progression.NewUnlocks or {}) do
		if unlock.Type == "Chapter" then
			table.insert(lines, "Nouveau chapitre debloque : " .. tostring(unlock.Id))
		end
	end

	for _, questId in ipairs(progression.CompletedQuestIds or {}) do
		local definition = findDefinition(MetaProgressionConfig.Quests, questId)
			or findDefinition(MetaProgressionConfig.DailyQuests, questId)

		if definition ~= nil then
			table.insert(lines, "Quete terminee : " .. definition.Label)
		end
	end

	for _, achievementId in ipairs(progression.NewAchievementIds or {}) do
		local definition = findDefinition(MetaProgressionConfig.Achievements, achievementId)

		if definition ~= nil then
			table.insert(lines, "Haut fait : " .. definition.Label)
		end
	end

	for _, personalBest in ipairs(progression.PersonalBestChanges or {}) do
		table.insert(lines, "Nouveau record : " .. tostring(personalBest.StatId))
	end

	if #lines == 0 then
		if progression.Reason == "DataStoreFailure" or progression.Reason == "ProfileNotLoaded" then
			return "Progression non sauvegardee : nouvelle tentative necessaire."
		end

		return "Aucune nouvelle progression cette fois."
	end

	return table.concat(lines, "\n")
end

local function showSummary(payload)
	local reason = payload.Reason
	local validated = payload.LevelValidated == true

	if reason == "Death" then
		title.Text = "RUN TERMINEE"
		result.Text = if validated then "Niveau valide avant la chute" else "Tu pourras faire mieux a la prochaine run"
	else
		title.Text = "NIVEAU TERMINE"
		result.Text = if validated then "Boss vaincu - niveau valide" else "Sortie de run"
	end

	statRows["Temps"].Text = formatTime(payload.SurvivalSeconds)
	statRows["Kills"].Text = formatNumber(payload.Kills)
	statRows["Elites"].Text = formatNumber(payload.EliteKills)
	statRows["Boss"].Text = formatNumber(payload.BossKills)
	statRows["Or de run"].Text = formatNumber(payload.Coins)
	statRows["Niveau"].Text = formatNumber(payload.Level)
	statRows["XP gagnee"].Text = formatNumber(payload.TotalXp)
	statRows["Perks"].Text = formatNumber(payload.PerkCount)
	statRows["Coffres"].Text = formatNumber(payload.ChestsOpened)
	statRows["Jarres"].Text = formatNumber(payload.JarsBroken)
	progressionText.Text = formatProgression(payload)
	overlay.Visible = true
end

local returnToLobbyRemote = ReplicatedStorage:WaitForChild(BossConfig.ReturnToLobbyRemoteName)

returnButton.Activated:Connect(function()
	returnToLobbyRemote:FireServer()
end)

local summaryRemote = ReplicatedStorage:WaitForChild(BossConfig.ResultRemoteName)

summaryRemote.OnClientEvent:Connect(function(payload)
	payload = payload or {}

	if payload.Visible == false then
		overlay.Visible = false
		return
	end

	showSummary(payload)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="148">
          <Properties>
            <string name="Name">RunUtilityV2Adapter</string>
            <string name="Source"><![CDATA[--!strict

-- Adaptateur isole de la barre d'outils V2. Les vraies pages Parametres et
-- Support seront branchees plus tard : cette passe ne remplace aucun bouton
-- Audio, Video ou Admin deja utilise par le jeu.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local UiTemplateConfig = require(Shared:WaitForChild("UiTemplateConfig"))

local PRODUCTION_TEMPLATE_GUI_NAME = UiTemplateConfig.ProductionTemplateGuiName
local PRODUCTION_GUI_NAME = "RunUtilityGui"
local PRODUCTION_DOCK_NAME = "UtilityDockV2"

local existingGui = playerGui:FindFirstChild(PRODUCTION_GUI_NAME)

if existingGui then
	existingGui:Destroy()
end

local function getTemplate(): Frame?
	local templateGui = StarterGui:FindFirstChild(PRODUCTION_TEMPLATE_GUI_NAME)
	local runCanvas = templateGui and templateGui:FindFirstChild("RunCanvas")
	local dock = runCanvas and runCanvas:FindFirstChild("UtilityDock")

	if dock and dock:IsA("Frame") then
		return dock
	end

	DebugLog.Warn("UI", "Barre d'outils V2 non initialisee, template introuvable")
	return nil
end

local template = getTemplate()

if template == nil then
	return
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = PRODUCTION_GUI_NAME
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 26
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Enabled = true
screenGui.Parent = playerGui

local dock = template:Clone()
dock.Name = PRODUCTION_DOCK_NAME
dock.Visible = false
dock:SetAttribute("ProductionBound", true)
dock.Parent = screenGui

local surface = dock:FindFirstChild("Surface")
if surface and surface:IsA("Frame") then
	-- La texture reste celle de la Top Bar, mais la barre d'outils se place
	-- derriere le gameplay avec un verre un peu plus present.
	surface.BackgroundTransparency = 0.22

	local innerGlass = surface:FindFirstChild("InnerGlass")
	if innerGlass and innerGlass:IsA("Frame") then
		innerGlass.BackgroundTransparency = math.max(innerGlass.BackgroundTransparency, 0.68)
	end
end

local content = dock:FindFirstChild("Content")

if content and content:IsA("GuiObject") then
	for _, child in ipairs(content:GetChildren()) do
		if child:IsA("TextButton") then
			local accent = child:FindFirstChild("Accent")
			local label = child:FindFirstChild("Label")
			local baseTransparency = child.BackgroundTransparency

			child.AutoButtonColor = false
			child.MouseEnter:Connect(function()
				TweenService:Create(child, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					BackgroundTransparency = 0.52,
				}):Play()

				if accent and accent:IsA("Frame") then
					TweenService:Create(accent, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					BackgroundTransparency = 0.02,
					Size = UDim2.new(1, -10, 0, 2),
					}):Play()
				end

				if label and label:IsA("TextLabel") then
					TweenService:Create(label, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					TextColor3 = Color3.fromRGB(245, 246, 255),
					}):Play()
				end
			end)

			child.MouseLeave:Connect(function()
				TweenService:Create(child, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					BackgroundTransparency = baseTransparency,
				}):Play()

				if accent and accent:IsA("Frame") then
					TweenService:Create(accent, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					BackgroundTransparency = 0.34,
					Size = UDim2.new(1, -18, 0, 1),
					}):Play()
				end
			end)
		end
	end
end

local function refreshVisibility()
	dock.Visible = player:GetAttribute("IsRunActive") == true
end

player:GetAttributeChangedSignal("IsRunActive"):Connect(refreshVisibility)
refreshVisibility()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="149">
          <Properties>
            <string name="Name">UI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
