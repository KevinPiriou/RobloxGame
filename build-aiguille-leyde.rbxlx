local function getFeedbackTarget(targetId)
	if targetId == "Health" then
		return hpGroup, hpFill, COLORS.Health
	end

	if targetId == "Shield" then
		return shieldGroup, shieldFill, COLORS.Shield
	end

	if targetId == "Xp" then
		return xpPanel, xpFill, COLORS.Xp
	end

	if targetId == "ArcaneGem" then
		return arcaneSlot, nil, COLORS.Arcane
	end

	if targetId == "Kill" then
		return killsSlot, nil, COLORS.Kills
	end

	if targetId == "Coin" then
		return goldSlot, nil, COLORS.Gold
	end

	if targetId == "RunScore" then
		return runScoreSlot, nil, COLORS.RunScore
	end

	return nil, nil, nil
end

local pulseTokens = {}

local function playHudFeedbackPulse(targetId)
	local target, fill, accent = getFeedbackTarget(targetId)

	if target == nil then
		return
	end

	local token = (pulseTokens[targetId] or 0) + 1
	pulseTokens[targetId] = token

	local scale = target:FindFirstChild("FeedbackPulseScale")

	if scale == nil then
		scale = Instance.new("UIScale")
		scale.Name = "FeedbackPulseScale"
		scale.Parent = target
	end

	if not scale:IsA("UIScale") then
		return
	end

	scale.Scale = 1
	TweenService:Create(scale, TweenInfo.new(0.11, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Scale = 1.06,
	}):Play()

	if fill ~= nil then
		local originalColor = fill.BackgroundColor3
		fill.BackgroundColor3 = accent:Lerp(Color3.new(1, 1, 1), 0.22)
		task.delay(0.14, function()
			if pulseTokens[targetId] == token and fill.Parent ~= nil then
				TweenService:Create(fill, QUICK_TWEEN, {
					BackgroundColor3 = originalColor,
				}):Play()
			end
		end)
	end

	task.delay(0.13, function()
		if pulseTokens[targetId] == token and scale.Parent ~= nil then
			TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Scale = 1,
			}):Play()
		end
	end)
end

feedbackArrivalEvent.Event:Connect(playHudFeedbackPulse)

local function updateResponsiveLayout()
	local viewportSize = getViewportSize()
	local function getTopScale(targetScale)
		local availableWidth = math.max(1, viewportSize.X - 24)

		return math.min(targetScale, availableWidth / TOP_CLUSTER_WIDTH)
	end

	if viewportSize.X < 560 then
		topCluster.Position = UDim2.new(0.5, 0, 0, 2)
		topScale.Scale = getTopScale(0.72)
		eventMessageFrame.Position = UDim2.new(0.5, 0, 0, 78)
		eventMessageFrame.Size = UDim2.new(0.9, 0, 0, 50)
		eventMessageScale.Scale = 0.84
		xpPanel.Position = UDim2.new(0.5, 0, 1, -8)
		xpPanel.Size = UDim2.new(0.88, 0, 0, 80)
		xpScale.Scale = 0.8
	elseif viewportSize.X < 760 then
		topCluster.Position = UDim2.new(0.5, 0, 0, 2)
		topScale.Scale = getTopScale(0.84)
		eventMessageFrame.Position = UDim2.new(0.5, 0, 0, 82)
		eventMessageFrame.Size = UDim2.new(0.84, 0, 0, 52)
		eventMessageScale.Scale = 0.9
		xpPanel.Position = UDim2.new(0.5, 0, 1, -8)
		xpPanel.Size = UDim2.new(0.82, 0, 0, 80)
		xpScale.Scale = 0.86
	elseif viewportSize.X < 1250 then
		topCluster.Position = UDim2.new(0.5, 0, 0, 2)
		topScale.Scale = getTopScale(0.95)
		eventMessageFrame.Position = UDim2.new(0.5, 0, 0, 86)
		eventMessageFrame.Size = UDim2.new(0.58, 0, 0, 54)
		eventMessageScale.Scale = 0.96
		xpPanel.Position = UDim2.new(0.5, 0, 1, -12)
		xpPanel.Size = UDim2.new(0.62, 0, 0, 80)
		xpScale.Scale = 0.92
	else
		topCluster.Position = UDim2.new(0.5, 0, 0, 2)
		topScale.Scale = getTopScale(1)
		eventMessageFrame.Position = UDim2.new(0.5, 0, 0, 90)
		eventMessageFrame.Size = UDim2.fromOffset(620, 56)
		eventMessageScale.Scale = 1
		xpPanel.Position = UDim2.new(0.5, 0, 1, -16)
		xpPanel.Size = UDim2.new(0.52, 0, 0, 80)
		xpScale.Scale = 1
	end
end

local function refreshCombatStats()
	local healthProgress = state.Health / math.max(1, state.MaxHealth)
	local shieldProgress = 0

	if state.MaxShield > 0 then
		shieldProgress = state.Shield / state.MaxShield
	end

	hpText.Text = ("%s / %s"):format(formatNumber(state.Health), formatNumber(state.MaxHealth))
	shieldText.Text = ("%s / %s"):format(formatNumber(state.Shield), formatNumber(state.MaxShield))
	killsValue.Text = formatTopStatNumber(state.Kills)
	goldValue.Text = formatTopStatNumber(state.Coins)

	setBarProgress(hpFill, healthProgress)
	setBarProgress(shieldFill, shieldProgress)
end

local function refreshXp()
	local progress = state.Xp / math.max(1, state.XpRequired)

	levelValue.Text = ("LVL %s"):format(formatNumber(state.Level))
	topLevelValue.Text = ("LVL %s"):format(formatNumber(state.Level))
	xpText.Text = ("XP %s / %s"):format(formatNumber(state.Xp), formatNumber(state.XpRequired))
	setBarProgress(xpFill, progress)
end

local function refreshCoins()
	goldValue.Text = formatTopStatNumber(state.Coins)
end

local function refreshArcaneGems()
	arcaneValue.Text = formatTopStatNumber(state.ArcaneGems)
	lobbyArcaneValue.Text = formatTopStatNumber(state.ArcaneGems)
end

local function refreshChestCost()
	chestCostValue.Text = formatTopStatNumber(state.NextChestCost)
end

local function refreshRunScore()
	runScoreValue.Text = formatTopStatNumber(state.RunScore)
end

local function refreshTimer()
	timerLabel.Text = formatTimer(timerRemaining)
end

local function refreshRunVisibility()
	topCluster.Visible = state.IsRunActive
	xpPanel.Visible = state.IsRunActive
	lobbyArcaneChip.Visible = not state.IsRunActive

	if not state.IsRunActive then
		eventMessageFrame.Visible = false
	end
end

local function isTimerPaused()
	return not state.IsRunActive or state.IsUserPaused or state.HasBlockingPause
end

local function refreshPause()
	isPauseButtonBlocked = (not state.IsRunActive) or (state.HasBlockingPause and not state.IsUserPaused)
	pauseButton.Active = not isPauseButtonBlocked
	pauseButton.AutoButtonColor = not isPauseButtonBlocked
	pauseImage.Image = if state.IsUserPaused then ICON_IMAGES.Play else ICON_IMAGES.Pause
	pauseImage.ImageTransparency = if isPauseButtonBlocked then 0.45 else 0
end

local function showEventMessage(payload)
	payload = payload or {}

	local styleId = payload.StyleId or HudMessageConfig.DefaultStyleId
	local style = HudMessageConfig.Styles[styleId] or HudMessageConfig.Styles[HudMessageConfig.DefaultStyleId]

	if style == nil then
		return
	end

	eventMessageId += 1
	local currentId = eventMessageId
	local targetBackgroundTransparency = style.BackgroundTransparency or 0.18
	local targetStrokeTransparency = style.StrokeTransparency or 0.35
	local targetTextStrokeTransparency = style.TextStrokeTransparency or 0.28
	local duration = payload.Duration or style.Duration or HudMessageConfig.DefaultDuration

	if eventMessageTweenIn ~= nil then
		eventMessageTweenIn:Cancel()
		eventMessageTweenIn = nil
	end

	if eventMessageTweenOut ~= nil then
		eventMessageTweenOut:Cancel()
		eventMessageTweenOut = nil
	end

	eventMessageFrame.Visible = true
	eventMessageBackground.BackgroundColor3 = style.BackgroundColor or Color3.fromRGB(10, 12, 18)
	eventMessageBackground.BackgroundTransparency = 1
	eventMessageStroke.Color = style.StrokeColor or COLORS.Text
	eventMessageStroke.Transparency = 1
	eventMessageAccent.BackgroundColor3 = style.AccentColor or COLORS.Text
	eventMessageAccent.BackgroundTransparency = 1
	eventMessageLabel.Font = style.Font or UI_FONTS.Heavy
	eventMessageLabel.Text = tostring(payload.Message or style.Message or "Evenement")
	eventMessageLabel.TextColor3 = style.TextColor or COLORS.Text
	eventMessageLabel.TextStrokeColor3 = style.StrokeColor or COLORS.Shadow
	eventMessageLabel.TextTransparency = 1
	eventMessageLabel.TextStrokeTransparency = 1
	eventMessageTextConstraint.MaxTextSize = style.TextSize or 32
	eventMessageTextConstraint.MinTextSize = math.min(18, style.TextSize or 32)

	eventMessageTweenIn = TweenService:Create(eventMessageBackground, EVENT_IN_TWEEN, {
		BackgroundTransparency = targetBackgroundTransparency,
	})
	eventMessageTweenIn:Play()
	TweenService:Create(eventMessageStroke, EVENT_IN_TWEEN, {
		Transparency = targetStrokeTransparency,
	}):Play()
	TweenService:Create(eventMessageAccent, EVENT_IN_TWEEN, {
		BackgroundTransparency = 0,
	}):Play()
	TweenService:Create(eventMessageLabel, EVENT_IN_TWEEN, {
		TextTransparency = 0,
		TextStrokeTransparency = targetTextStrokeTransparency,
	}):Play()

	task.delay(duration, function()
		if currentId ~= eventMessageId then
			return
		end

		eventMessageTweenOut = TweenService:Create(eventMessageBackground, EVENT_OUT_TWEEN, {
			BackgroundTransparency = 1,
		})
		eventMessageTweenOut:Play()
		TweenService:Create(eventMessageStroke, EVENT_OUT_TWEEN, {
			Transparency = 1,
		}):Play()
		TweenService:Create(eventMessageAccent, EVENT_OUT_TWEEN, {
			BackgroundTransparency = 1,
		}):Play()
		TweenService:Create(eventMessageLabel, EVENT_OUT_TWEEN, {
			TextTransparency = 1,
			TextStrokeTransparency = 1,
		}):Play()

		task.delay(EVENT_OUT_TWEEN.Time, function()
			if currentId == eventMessageId then
				eventMessageFrame.Visible = false
			end
		end)
	end)
end

local function onHudMessagePayload(payload)
	showEventMessage(payload)
end

local function onStatsPayload(payload)
	payload = payload or {}

	local previousHealth = state.Health
	local previousShield = state.Shield

	state.Health = payload.Health or state.Health
	state.MaxHealth = math.max(1, payload.MaxHealth or state.MaxHealth)
	state.Shield = payload.Shield or state.Shield
	state.MaxShield = math.max(0, payload.MaxShield or state.MaxShield)
	state.AliveMonsters = payload.AliveMonsters or state.AliveMonsters
	state.MaxAliveMonsters = math.max(1, payload.MaxAliveMonsters or state.MaxAliveMonsters)
	state.Wave = payload.Wave or state.Wave
	state.Kills = payload.Kills or state.Kills
	state.WeaponName = payload.WeaponName or state.WeaponName

	if hasReceivedStatsSnapshot and (state.Health < previousHealth or state.Shield < previousShield) then
		playDamageFlash()
	end

	hasReceivedStatsSnapshot = true
	refreshCombatStats()
end

local function onXpPayload(payload)
	payload = payload or {}

	state.Xp = payload.Xp or state.Xp
	state.Level = payload.Level or state.Level
	state.XpRequired = math.max(1, payload.XpRequired or state.XpRequired)
	refreshXp()
end

local function onCoinsPayload(payload)
	payload = payload or {}

	state.Coins = payload.Coins or state.Coins
	refreshCoins()
end

local function onChestPricePayload(payload)
	payload = payload or {}

	if payload.Coins ~= nil then
		state.Coins = payload.Coins
		refreshCoins()
	end

	if payload.NextOpenCost ~= nil then
		state.NextChestCost = math.max(0, math.floor(tonumber(payload.NextOpenCost) or state.NextChestCost))
		refreshChestCost()
	end
end

local function onRunScorePayload(payload)
	payload = payload or {}
	state.RunScore = math.max(0, math.floor(tonumber(payload.Score) or state.RunScore))
	refreshRunScore()
end

local function onPerksPayload(payload)
	payload = payload or {}

	local previousShield = state.Shield

	if payload.CurrentShield ~= nil then
		state.Shield = payload.CurrentShield
	end

	if payload.MaxShield ~= nil then
		state.MaxShield = math.max(0, payload.MaxShield)
	end

	if hasReceivedStatsSnapshot and state.Shield < previousShield then
		playDamageFlash()
	end

	refreshCombatStats()
end

local function onPausePayload(payload)
	payload = payload or {}

	state.IsUserPaused = payload.IsUserPaused == true
	state.HasBlockingPause = payload.HasBlockingPause == true
	refreshPause()
end

local function onRunStatePayload(payload)
	payload = payload or {}

	local wasRunActive = state.IsRunActive

	state.IsRunActive = payload.IsRunActive == true

	if state.IsRunActive and not wasRunActive then
		timerRemaining = RUN_TIMER_SECONDS
		state.RunScore = 0
		refreshRunScore()
	elseif not state.IsRunActive then
		timerRemaining = RUN_TIMER_SECONDS
	end

	refreshTimer()
	refreshPause()
	refreshRunVisibility()
end

local function waitForRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = ReplicatedStorage:WaitForChild(remoteName, 20)
	end

	if remote == nil then
		DebugLog.Warn("UI", "Remote HUD introuvable", {
			Remote = remoteName,
		})
	end

	return remote
end

local function bindRemote(remoteName, callback)
	task.spawn(function()
		local remote = waitForRemote(remoteName)

		if remote == nil then
			return
		end

		remote.OnClientEvent:Connect(callback)
		DebugLog.Info("UI", "Remote HUD connecte", {
			Remote = remoteName,
		})
	end)
end

bindRemote("Combat_UpdateStats", onStatsPayload)
bindRemote("Xp_UpdateCount", onXpPayload)
bindRemote("Coin_UpdateCount", onCoinsPayload)
bindRemote("Chest_PriceUpdate", onChestPricePayload)
bindRemote("RunScore_Update", onRunScorePayload)
bindRemote("Perk_UpdateStats", onPerksPayload)
bindRemote("Combat_PauseState", onPausePayload)
bindRemote("Run_StateUpdate", onRunStatePayload)
bindRemote(HudMessageConfig.RemoteName, onHudMessagePayload)

player:GetAttributeChangedSignal("IsRunActive"):Connect(function()
	onRunStatePayload({
		IsRunActive = player:GetAttribute("IsRunActive") == true,
	})
end)

player:GetAttributeChangedSignal("ArcaneGems"):Connect(function()
	state.ArcaneGems = math.max(0, math.floor(tonumber(player:GetAttribute("ArcaneGems")) or 0))
	refreshArcaneGems()
end)

task.spawn(function()
	togglePauseRemote = waitForRemote("Combat_TogglePause")
end)

pauseButton.Activated:Connect(function()
	if isPauseButtonBlocked then
		return
	end

	if togglePauseRemote == nil then
		DebugLog.Warn("UI", "Pause ignoree, remote pas encore pret")
		return
	end

	togglePauseRemote:FireServer()
end)

RunService.RenderStepped:Connect(function(deltaTime)
	if timerRemaining <= 0 or isTimerPaused() then
		return
	end

	timerRemaining = math.max(0, timerRemaining - deltaTime)
	refreshTimer()
end)

if Workspace.CurrentCamera ~= nil then
	viewportConnection = Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateResponsiveLayout)
end

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	if viewportConnection ~= nil then
		viewportConnection:Disconnect()
		viewportConnection = nil
	end

	if Workspace.CurrentCamera ~= nil then
		viewportConnection = Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateResponsiveLayout)
	end

	updateResponsiveLayout()
end)

refreshCombatStats()
refreshXp()
refreshCoins()
refreshArcaneGems()
refreshChestCost()
refreshTimer()
refreshRunVisibility()
refreshPause()
updateResponsiveLayout()

DebugLog.Info("UI", "HUD combat epure initialise", {
	Player = player.Name,
})
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="122">
          <Properties>
            <string name="Name">CommerceClient</string>
            <string name="Source"><![CDATA[--!strict

-- Gere les achats sans bloquer la creation des panneaux du lobby.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local CommerceConfig = require(Shared:WaitForChild("CommerceConfig"))

local purchaseRequestRemote: RemoteEvent? = nil
local pendingPurchaseRequests: {[string]: boolean} = {}

local function getPurchaseText(valueText: string, isConfigured: boolean): string
	if isConfigured then
		return valueText .. " - ACHETER"
	end

	return valueText .. " - BIENTOT"
end

local function requestPurchase(offerId: string)
	if purchaseRequestRemote ~= nil then
		purchaseRequestRemote:FireServer(offerId)
		return
	end

	-- Le clic reste valide si le RemoteEvent est encore en cours de replication.
	pendingPurchaseRequests[offerId] = true
end

local function attachPurchaseButton(card: Frame)
	if card:GetAttribute("CommerceBound") == true then
		return
	end

	card:SetAttribute("CommerceBound", true)
	local offerId = card:GetAttribute("OfferId")

	if typeof(offerId) ~= "string" then
		return
	end

	local value = card:WaitForChild("Value", 5)

	if value == nil or not value:IsA("Frame") then
		return
	end

	local valueLabel = value:FindFirstChild("ValueLabel")

	if valueLabel == nil or not valueLabel:IsA("TextLabel") then
		return
	end

	local offer = CommerceConfig.GetOffer(offerId)
	local isConfigured = CommerceConfig.IsOfferConfigured(offer)
	local baseValueText = valueLabel:GetAttribute("CommerceBaseValue")

	if typeof(baseValueText) ~= "string" then
		baseValueText = valueLabel.Text
		valueLabel:SetAttribute("CommerceBaseValue", baseValueText)
	end

	valueLabel.Text = getPurchaseText(baseValueText, isConfigured)

	if not isConfigured or offer == nil or value:FindFirstChild("PurchaseButton") ~= nil then
		return
	end

	local button = Instance.new("TextButton")
	button.Name = "PurchaseButton"
	button.Size = UDim2.fromScale(1, 1)
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Text = ""
	button.ZIndex = valueLabel.ZIndex + 1
	button.Parent = value

	button.Activated:Connect(function()
		requestPurchase(offer.Id)
	end)
end

local function bindShopPanel(shopPanel: Frame)
	local function attachFromDescendant(descendant: Instance)
		if descendant:IsA("Frame") and descendant.Name == "GridCard" then
			task.spawn(attachPurchaseButton, descendant)
		end
	end

	for _, descendant in ipairs(shopPanel:GetDescendants()) do
		attachFromDescendant(descendant)
	end

	shopPanel.DescendantAdded:Connect(attachFromDescendant)
end

local function bindMenus()
	local menus = playerGui:WaitForChild("Menus", 30)

	if menus == nil or not menus:IsA("ScreenGui") then
		return
	end

	local shopPanel = menus:WaitForChild("ShopPanel", 30)

	if shopPanel and shopPanel:IsA("Frame") then
		bindShopPanel(shopPanel)
	end
end

local function onPromptPurchase(payload)
	if typeof(payload) ~= "table" then
		return
	end

	local offerId = payload.OfferId
	local offer = if typeof(offerId) == "string" then CommerceConfig.GetOffer(offerId) else nil

	if not CommerceConfig.IsOfferConfigured(offer) then
		return
	end

	if payload.ProductId ~= offer.ProductId or payload.Kind ~= offer.Kind then
		return
	end

	local success, errorMessage = pcall(function()
		if offer.Kind == "DeveloperProduct" then
			MarketplaceService:PromptProductPurchase(player, offer.ProductId)
		elseif offer.Kind == "GamePass" then
			MarketplaceService:PromptGamePassPurchase(player, offer.ProductId)
		end
	end)

	if not success then
		warn("[MegaRoblox][Commerce] Prompt achat impossible : " .. tostring(errorMessage))
	end
end

task.spawn(function()
	local remote = ReplicatedStorage:WaitForChild("Commerce_RequestPurchase", 30)

	if remote and remote:IsA("RemoteEvent") then
		purchaseRequestRemote = remote

		for offerId in pairs(pendingPurchaseRequests) do
			remote:FireServer(offerId)
		end

		table.clear(pendingPurchaseRequests)
	end
end)

task.spawn(function()
	local remote = ReplicatedStorage:WaitForChild("Commerce_PromptPurchase", 30)

	if remote and remote:IsA("RemoteEvent") then
		remote.OnClientEvent:Connect(onPromptPurchase)
	end
end)

task.spawn(bindMenus)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="123">
          <Properties>
            <string name="Name">DebugUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local FeatureFlags = require(Shared:WaitForChild("FeatureFlags"))

if not FeatureFlags.DebugUIEnabled then
	DebugLog.Info("UI", "Debug UI desactivee par FeatureFlags")
	return
end

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local UPDATE_INTERVAL = 0.5

local frameCount = 0
local elapsedSinceUpdate = 0

local existingGui = playerGui:FindFirstChild("DebugGui")

if existingGui ~= nil then
	existingGui:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DebugGui"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 20
screenGui.Parent = playerGui

local container = Instance.new("Frame")
container.Name = "Container"
container.AnchorPoint = Vector2.new(1, 0)
container.Position = UDim2.new(1, -14, 0, 14)
container.Size = UDim2.new(0, 210, 0, 134)
container.BackgroundColor3 = Color3.fromRGB(16, 18, 22)
container.BackgroundTransparency = 0.12
container.BorderSizePixel = 0
container.Parent = screenGui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = container

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(255, 255, 255)
stroke.Transparency = 0.82
stroke.Thickness = 1
stroke.Parent = container

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 6)
padding.PaddingRight = UDim.new(0, 10)
padding.PaddingBottom = UDim.new(0, 6)
padding.PaddingLeft = UDim.new(0, 10)
padding.Parent = container

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 2)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = container

local function createLabel(name, text, color)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.Size = UDim2.new(1, 0, 0, 13)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.Text = text
	label.TextColor3 = color or Color3.fromRGB(230, 235, 245)
	label.TextSize = 11
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Parent = container

	return label
end

local titleLabel = createLabel("TitleLabel", "Debug performances", Color3.fromRGB(255, 255, 255))
titleLabel.Font = Enum.Font.GothamBold

local fpsLabel = createLabel("FpsLabel", "FPS : --")
local memoryLabel = createLabel("MemoryLabel", "RAM : -- MB")
local cpuLabel = createLabel("CpuLabel", "CPU render : -- ms")
local gpuLabel = createLabel("GpuLabel", "GPU render : -- ms")
local physicsLabel = createLabel("PhysicsLabel", "Physics : -- ms")
local instancesLabel = createLabel("InstancesLabel", "Instances : --")
local drawLabel = createLabel("DrawLabel", "Draw/Tri : -- / --")

local function readNumber(valueReader)
	local success, value = pcall(valueReader)

	if not success or typeof(value) ~= "number" then
		return nil
	end

	return value
end

local function formatMs(seconds)
	if seconds == nil then
		return "-- ms"
	end

	return ("%.2f ms"):format(seconds * 1000)
end

local function formatWholeNumber(value)
	if value == nil then
		return "--"
	end

	return tostring(math.floor(value + 0.5))
end

local function updateDebugValues(fps)
	local memoryMb = readNumber(function()
		return Stats:GetTotalMemoryUsageMb()
	end)
	local renderCpu = readNumber(function()
		return Stats.RenderCPUFrameTime
	end)
	local renderGpu = readNumber(function()
		return Stats.RenderGPUFrameTime
	end)
	local physicsStep = readNumber(function()
		return Stats.PhysicsStepTime
	end)
	local instanceCount = readNumber(function()
		return Stats.InstanceCount
	end)
	local drawCalls = readNumber(function()
		return Stats.SceneDrawcallCount
	end)
	local triangles = readNumber(function()
		return Stats.SceneTriangleCount
	end)

	fpsLabel.Text = ("FPS : %d"):format(math.floor(fps + 0.5))

	if memoryMb == nil then
		memoryLabel.Text = "RAM : -- MB"
	else
		memoryLabel.Text = ("RAM : %.0f MB"):format(memoryMb)
	end

	cpuLabel.Text = "CPU render : " .. formatMs(renderCpu)
	gpuLabel.Text = "GPU render : " .. formatMs(renderGpu)
	physicsLabel.Text = "Physics : " .. formatMs(physicsStep)
	instancesLabel.Text = "Instances : " .. formatWholeNumber(instanceCount)
	drawLabel.Text = ("Draw/Tri : %s / %s"):format(formatWholeNumber(drawCalls), formatWholeNumber(triangles))
end

RunService.RenderStepped:Connect(function(deltaTime)
	frameCount += 1
	elapsedSinceUpdate += deltaTime

	if elapsedSinceUpdate < UPDATE_INTERVAL then
		return
	end

	local fps = frameCount / elapsedSinceUpdate

	frameCount = 0
	elapsedSinceUpdate = 0
	updateDebugValues(fps)
end)

DebugLog.Info("UI", "Debug UI initialisee", {
	Player = player.Name,
})
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="124">
          <Properties>
            <string name="Name">DevKitPreviewController</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local DRAFT_GUI_NAME = "MegaRobloxUIV_RunLayoutDraft"
local DEV_KIT_PREVIEW_ATTRIBUTE = "DevKitPreviewEnabled"

local draftGui = playerGui:WaitForChild(DRAFT_GUI_NAME, 30)

if draftGui == nil or not draftGui:IsA("ScreenGui") then
	warn("[MegaRoblox][UI] Apercu kit UI indisponible : brouillon introuvable")
	return
end

local originalDraftDisplayOrder = draftGui.DisplayOrder
local combatGui = playerGui:FindFirstChild("CombatGui")
local originalCombatGuiEnabled = true
local isApplying = false
local wasPreviewEnabled = false

if combatGui and combatGui:IsA("ScreenGui") then
	originalCombatGuiEnabled = combatGui.Enabled
else
	combatGui = nil
end

local function getCombatGui()
	if combatGui and combatGui.Parent == playerGui then
		return combatGui
	end

	local candidate = playerGui:FindFirstChild("CombatGui")

	if candidate and candidate:IsA("ScreenGui") then
		combatGui = candidate
		originalCombatGuiEnabled = candidate.Enabled
		return candidate
	end

	return nil
end

local function applyPreviewState()
	if isApplying then
		return
	end

	isApplying = true
	local isPreviewEnabled = player:GetAttribute(DEV_KIT_PREVIEW_ATTRIBUTE) == true
	local currentCombatGui = getCombatGui()

	if isPreviewEnabled then
		if currentCombatGui then
			if not wasPreviewEnabled then
				originalCombatGuiEnabled = currentCombatGui.Enabled
			end

			currentCombatGui.Enabled = false
		end

		-- Le brouillon reste sous l'admin et sous un vrai choix de perk afin que
	-- l'apercu ne masque jamais une interaction de gameplay active.
		draftGui.DisplayOrder = 6
		draftGui.Enabled = true
	else
		draftGui.Enabled = false
		draftGui.DisplayOrder = originalDraftDisplayOrder

		if currentCombatGui and wasPreviewEnabled then
			currentCombatGui.Enabled = originalCombatGuiEnabled
		end
	end

	wasPreviewEnabled = isPreviewEnabled
	isApplying = false
end

-- Le brouillon est masque par defaut en production. L'attribut serveur est
-- l'unique chemin normal qui autorise son affichage pour un administrateur.
draftGui.Enabled = false

draftGui:GetPropertyChangedSignal("Enabled"):Connect(function()
	if not isApplying and player:GetAttribute(DEV_KIT_PREVIEW_ATTRIBUTE) == true and not draftGui.Enabled then
		task.defer(applyPreviewState)
	end
end)

playerGui.ChildAdded:Connect(function(child)
	if child.Name == "CombatGui" and child:IsA("ScreenGui") then
		combatGui = child
		originalCombatGuiEnabled = child.Enabled
		applyPreviewState()
	end
end)

player:GetAttributeChangedSignal(DEV_KIT_PREVIEW_ATTRIBUTE):Connect(applyPreviewState)
applyPreviewState()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="125">
          <Properties>
            <string name="Name">EnvironmentController</string>
            <string name="Source"><![CDATA[-- Ambiance de run locale : elle ne modifie jamais la map ni le Lighting serveur.

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local EnvironmentConfig = require(Shared:WaitForChild("EnvironmentConfig"))

local VfxQualityController = require(script.Parent:WaitForChild("VfxQualityController"))

VfxQualityController.Start()

local isRunActive = player:GetAttribute("IsRunActive") == true
local runtimeFolder = nil
local atmosphere = nil
local correction = nil
local bloom = nil
local blur = nil
local depthOfField = nil
local sunRays = nil
local moteVolumesFolder = nil
local moteEmitters = {}
local leafEmitters = {}
local moteMap = nil
local moteCoverageArea = nil
local lastProfileId = nil
local lightingBaseline = nil
local windBaseline = nil

local function getOrCreateFolder(parent, name)
	local folder = parent:FindFirstChild(name)

	if folder == nil then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end

	return folder
end

local function getOrCreateEffect(className, name)
	local effect = Lighting:FindFirstChild(name)

	if effect == nil then
		effect = Instance.new(className)
		effect.Name = name
		effect.Parent = Lighting
	end

	return effect
end

local function captureLightingBaseline()
	if lightingBaseline ~= nil then
		return
	end

	lightingBaseline = {
		ClockTime = Lighting.ClockTime,
		Brightness = Lighting.Brightness,
		ExposureCompensation = Lighting.ExposureCompensation,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
		EnvironmentDiffuseScale = Lighting.EnvironmentDiffuseScale,
		EnvironmentSpecularScale = Lighting.EnvironmentSpecularScale,
		ShadowSoftness = Lighting.ShadowSoftness,
	}
	windBaseline = Workspace.GlobalWind
end

local function findSourceEffect(className, fallbackName)
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA(className) and child.Name ~= fallbackName then
			return child
		end
	end

	local fallback = Lighting:FindFirstChild(fallbackName)

	if fallback ~= nil and fallback:IsA(className) then
		return fallback
	end

	return nil
end

local function createFallbackEffect(className, name)
	local effect = Instance.new(className)
	effect.Name = name
	effect.Parent = Lighting
	return effect
end

local function replaceSourceEffect(currentEffect, className, fallbackName)
	local sourceEffect = findSourceEffect(className, fallbackName)

	if sourceEffect == nil then
		sourceEffect = createFallbackEffect(className, fallbackName)
	end

	local changed = currentEffect ~= sourceEffect

	if currentEffect ~= nil
		and currentEffect ~= sourceEffect
		and currentEffect.Name == fallbackName
		and currentEffect.Parent ~= nil then
		currentEffect:Destroy()
	end

	return sourceEffect, changed
end

local function ensureSourceEffects()
	local atmosphereChanged = false
	local correctionChanged = false
	local blurChanged = false
	local depthOfFieldChanged = false
	local sunRaysChanged = false

	atmosphere, atmosphereChanged = replaceSourceEffect(
		atmosphere,
		"Atmosphere",
		EnvironmentConfig.FallbackAtmosphereName
	)
	correction, correctionChanged = replaceSourceEffect(
		correction,
		"ColorCorrectionEffect",
		EnvironmentConfig.ColorCorrectionName
	)
	blur, blurChanged = replaceSourceEffect(
		blur,
		"BlurEffect",
		EnvironmentConfig.BlurName
	)
	depthOfField, depthOfFieldChanged = replaceSourceEffect(
		depthOfField,
		"DepthOfFieldEffect",
		EnvironmentConfig.DepthOfFieldName
	)
	sunRays, sunRaysChanged = replaceSourceEffect(
		sunRays,
		"SunRaysEffect",
		EnvironmentConfig.FallbackSunRaysName
	)

	local changed = atmosphereChanged
		or correctionChanged
		or blurChanged
		or depthOfFieldChanged
		or sunRaysChanged

	if changed then
		DebugLog.Info("Environment", "Sources Lighting capturees", {
			Atmosphere = atmosphere,
			ColorCorrection = correction,
			Blur = blur,
			DepthOfField = depthOfField,
			SunRays = sunRays,
		})
	end

	return changed
end

local function ensureRuntime()
	if runtimeFolder ~= nil and runtimeFolder.Parent ~= nil then
		ensureSourceEffects()
		return
	end

	runtimeFolder = getOrCreateFolder(Workspace, EnvironmentConfig.RuntimeFolderName)
	captureLightingBaseline()
	ensureSourceEffects()
	bloom = getOrCreateEffect("BloomEffect", EnvironmentConfig.BloomName)

	moteVolumesFolder = getOrCreateFolder(runtimeFolder, EnvironmentConfig.MoteVolumesFolderName)
end

local function getActiveRunMap()
	local mapRuntime = Workspace:FindFirstChild("MapRuntime")

	if mapRuntime == nil then
		return nil
	end

	for _, candidate in ipairs(mapRuntime:GetChildren()) do
		local runId = candidate:GetAttribute("RunId")

		if typeof(runId) == "string" and runId ~= "" then
			return candidate
		end
	end

	return nil
end

local function getActiveEnvironmentContext()
	local activeMap = getActiveRunMap()
	local runMapId = player:GetAttribute("RunMapId")
	local levelId = if typeof(runMapId) == "string" and runMapId ~= ""
		then runMapId
		else if activeMap ~= nil then activeMap.Name else EnvironmentConfig.DefaultLevelId

	local chapterId = if activeMap ~= nil then activeMap:GetAttribute("ChapterId") else nil

	if tonumber(chapterId) == nil then
		chapterId = player:GetAttribute("SelectedChapter")
	end

	return levelId, chapterId
end

local function isEnvironmentActive()
	-- La map runtime est le repere visuel fiable pendant le chargement et la run.
	return isRunActive or getActiveRunMap() ~= nil
end

local function tweenLighting(properties)
	TweenService:Create(
		Lighting,
		TweenInfo.new(EnvironmentConfig.TransitionSeconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		properties
	):Play()
end

local function applyAtmosphere(properties)
	if atmosphere == nil then
		return
	end

	atmosphere.Density = properties.Density
	atmosphere.Offset = properties.Offset
	atmosphere.Color = properties.Color
	atmosphere.Decay = properties.Decay
	atmosphere.Glare = properties.Glare
	atmosphere.Haze = properties.Haze
end

local function createMoteEmitter(parent)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "ForestMotes"
	emitter.Texture = EnvironmentConfig.MoteTexture
	emitter.Enabled = false
	emitter.LockedToPart = false
	emitter.LightInfluence = 0.15
	emitter.LightEmission = 0.55
	emitter.EmissionDirection = Enum.NormalId.Bottom
	emitter.SpreadAngle = Vector2.new(9, 9)
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	emitter.Lifetime = NumberRange.new(9.5, 12)
	emitter.Speed = NumberRange.new(0.25, 0.7)
	emitter.Acceleration = Vector3.new(0.3, -3, 0.2)
	emitter.Drag = 0.15
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-28, 28)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.6),
		NumberSequenceKeypoint.new(0.45, 1.1),
		NumberSequenceKeypoint.new(1, 0.45),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(0.7, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = parent
	return emitter
end

local function createLeafEmitter(parent, pattern)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = pattern.Name
	emitter.Texture = pattern.Texture
	emitter.Enabled = false
	emitter.LockedToPart = false
	emitter.LightInfluence = 0.65
	emitter.LightEmission = 0.05
	emitter.EmissionDirection = Enum.NormalId.Bottom
	emitter.SpreadAngle = Vector2.new(14, 14)
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	emitter.ShapeInOut = Enum.ParticleEmitterShapeInOut.Outward
	emitter.FlipbookLayout = Enum.ParticleFlipbookLayout.None
	emitter.Lifetime = NumberRange.new(10.5, 13.5)
	emitter.Speed = NumberRange.new(0.3, 0.8)
	emitter.Acceleration = Vector3.new(0, EnvironmentConfig.AtmosphereLeafFallAcceleration, 0)
	emitter.Drag = 0.12
	emitter.WindAffectsDrag = true
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-38, 38)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, pattern.SizeStart),
		NumberSequenceKeypoint.new(0.5, pattern.SizePeak),
		NumberSequenceKeypoint.new(1, pattern.SizeEnd),
	})
	emitter.Transparency = NumberSequence.new({
		-- Au sommet, les feuilles se fondent dans la brume puis gagnent doucement en presence.
		NumberSequenceKeypoint.new(0, 0.9),
		NumberSequenceKeypoint.new(0.3, 0.62),
		NumberSequenceKeypoint.new(0.64, 0.48),
		NumberSequenceKeypoint.new(0.9, 0.68),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = parent

	return {
		Emitter = emitter,
		Pattern = pattern,
	}
end

local function isAtmospherePlatform(part, map)
	if part.CanCollide ~= true or part.Transparency >= 0.95 then
		return false
	end

	local current = part

	while current ~= nil and current ~= map do
		local name = string.lower(current.Name)

		if string.find(name, "limit", 1, true)
			or string.find(name, "invisible", 1, true)
			or string.find(name, "boundary", 1, true)
			or string.find(name, "border", 1, true)
			or string.find(name, "leaves", 1, true)
			or string.find(name, "trunk", 1, true)
			or string.find(name, "tree", 1, true) then
			return false
		end

		current = current.Parent
	end

	return true
end

local function getPartTopY(part)
	local halfSize = part.Size * 0.5
	local cframe = part.CFrame

	return part.Position.Y
		+ (math.abs(cframe.RightVector.Y) * halfSize.X)
		+ (math.abs(cframe.UpVector.Y) * halfSize.Y)
		+ (math.abs(cframe.LookVector.Y) * halfSize.Z)
end

local function getHighestPlatformSurface(map, mapCenter, mapSize)
	local highest = nil

	local function consider(part)
		if not isAtmospherePlatform(part, map) then
			return
		end

		local topY = getPartTopY(part)
		highest = if highest == nil then topY else math.max(highest, topY)
	end

	if map:IsA("BasePart") then
		consider(map)
	end

	for _, descendant in ipairs(map:GetDescendants()) do
		if descendant:IsA("BasePart") then
			consider(descendant)
		end
	end

	return if highest ~= nil then highest else mapCenter.Y + (mapSize.Y * 0.5)
end

local function clearMoteVolumes()
	if moteVolumesFolder ~= nil then
		for _, child in ipairs(moteVolumesFolder:GetChildren()) do
			child:Destroy()
		end
	end

	table.clear(moteEmitters)
	table.clear(leafEmitters)
	moteMap = nil
	moteCoverageArea = nil
end

local function updateMoteVolumes()
	if moteVolumesFolder == nil then
		return nil, 0
	end

	local map = getActiveRunMap()

	if map == nil then
		clearMoteVolumes()
		return nil, 0
	end

	if moteMap == map and #moteEmitters > 0 and #leafEmitters > 0 then
		return moteCoverageArea, #moteEmitters
	end

	local mapCenter = nil
	local mapSize = nil

	if map:IsA("Model") then
		local boundingCFrame, size = map:GetBoundingBox()
		mapCenter = boundingCFrame.Position
		mapSize = size
	elseif map:IsA("BasePart") then
		mapCenter = map.Position
		mapSize = map.Size
	else
		return nil, 0
	end

	clearMoteVolumes()

	local width = math.max(mapSize.X, 1)
	local depth = math.max(mapSize.Z, 1)
	local columns = math.max(1, math.ceil(width / EnvironmentConfig.MoteTileMaximumSize))
	local rows = math.max(1, math.ceil(depth / EnvironmentConfig.MoteTileMaximumSize))
	local tileWidth = width / columns
	local tileDepth = depth / rows
	local emissionHeight = getHighestPlatformSurface(map, mapCenter, mapSize)
		+ EnvironmentConfig.AtmosphereSpawnMarginAbovePlatform
	local minimumX = mapCenter.X - (width * 0.5)
	local minimumZ = mapCenter.Z - (depth * 0.5)

	-- Les tuiles sont fixes dans le monde : aucune ne suit la position du joueur.
	for column = 1, columns do
		for row = 1, rows do
			local volume = Instance.new("Part")
			volume.Name = string.format("MoteTile_%d_%d", column, row)
			volume.Anchored = true
			volume.CanCollide = false
			volume.CanTouch = false
			volume.CanQuery = false
			volume.CastShadow = false
			volume.Transparency = 1
			volume.Size = Vector3.new(tileWidth, 0.2, tileDepth)
			volume.CFrame = CFrame.new(
				minimumX + (tileWidth * (column - 0.5)),
				emissionHeight,
				minimumZ + (tileDepth * (row - 0.5))
			)
			volume.Parent = moteVolumesFolder
			table.insert(moteEmitters, createMoteEmitter(volume))

			for _, pattern in ipairs(EnvironmentConfig.AtmosphereLeafPatterns) do
				table.insert(leafEmitters, createLeafEmitter(volume, pattern))
			end
		end
	end

	moteMap = map
	moteCoverageArea = width * depth

	return moteCoverageArea, #moteEmitters
end

local function applyLobbyLighting()
	if correction ~= nil then
		correction.Enabled = false
	end

	if bloom ~= nil then
		bloom.Enabled = false
	end

	if blur ~= nil then
		blur.Enabled = false
	end

	if depthOfField ~= nil then
		depthOfField.Enabled = false
	end

	applyAtmosphere(EnvironmentConfig.LobbyAtmosphere)

	if sunRays ~= nil then
		sunRays.Enabled = false
	end

	clearMoteVolumes()

	if windBaseline ~= nil then
		Workspace.GlobalWind = windBaseline
	end

	if lightingBaseline ~= nil then
		tweenLighting(lightingBaseline)
	end
	lastProfileId = nil
end

local function applyRunEnvironment()
	ensureRuntime()

	if not isEnvironmentActive() then
		applyLobbyLighting()
		return
	end

	local levelId, chapterId = getActiveEnvironmentContext()
	local profile = EnvironmentConfig.GetLevelProfile(levelId, chapterId)
	local qualitySettings = VfxQualityController.GetSettings()
	local qualityProfile = EnvironmentConfig.GetQualityProfile(qualitySettings.Quality)
	local intensity = math.clamp(qualitySettings.EffectsIntensity, 0, 1)
	local atmosphereDensity = profile.Atmosphere.Density
		* qualityProfile.AtmosphereDensityMultiplier
		* (0.65 + (intensity * 0.35))

	applyAtmosphere({
		Density = atmosphereDensity,
		Offset = profile.Atmosphere.Offset,
		Color = profile.Atmosphere.Color,
		Decay = profile.Atmosphere.Decay,
		Glare = profile.Atmosphere.Glare * intensity,
		Haze = profile.Atmosphere.Haze,
	})

	correction.TintColor = Color3.new(1, 1, 1):Lerp(profile.Correction.TintColor, 0.55 + (intensity * 0.45))
	correction.Brightness = profile.Correction.Brightness * intensity
	correction.Contrast = profile.Correction.Contrast * intensity
	correction.Saturation = profile.Correction.Saturation * intensity
	correction.Enabled = intensity >= 0.05

	bloom.Intensity = profile.Bloom.Intensity * intensity
	bloom.Size = profile.Bloom.Size
	bloom.Threshold = profile.Bloom.Threshold
	bloom.Enabled = qualityProfile.BloomEnabled and intensity >= 0.08

	blur.Size = profile.Blur.Size * qualityProfile.BlurSizeMultiplier * intensity
	blur.Enabled = qualityProfile.BlurEnabled and blur.Size >= 0.05

	depthOfField.FocusDistance = profile.DepthOfField.FocusDistance
	depthOfField.InFocusRadius = profile.DepthOfField.InFocusRadius
	depthOfField.NearIntensity = profile.DepthOfField.NearIntensity * qualityProfile.DepthOfFieldIntensityMultiplier * intensity
	depthOfField.FarIntensity = profile.DepthOfField.FarIntensity * qualityProfile.DepthOfFieldIntensityMultiplier * intensity
	depthOfField.Enabled = qualityProfile.DepthOfFieldEnabled and intensity >= 0.08

	sunRays.Intensity = profile.SunRays.Intensity * intensity
	sunRays.Spread = profile.SunRays.Spread
	sunRays.Enabled = qualityProfile.SunRaysEnabled and intensity >= 0.12

	Workspace.GlobalWind = profile.Wind * intensity

	local moteArea, moteEmitterCount = updateMoteVolumes()
	local coverageMultiplier = if moteArea ~= nil
		then math.clamp(
			moteArea / EnvironmentConfig.MoteAreaReference,
			1,
			EnvironmentConfig.MoteAreaMaxMultiplier
		)
		else 0
	local moteRate = profile.Motes.Rate
		* coverageMultiplier
		* qualityProfile.MoteRateMultiplier
		* intensity
		* EnvironmentConfig.MoteDebugRateMultiplier
	local moteRatePerEmitter = moteRate / math.max(1, moteEmitterCount)

	for _, emitter in ipairs(moteEmitters) do
		emitter.Color = ColorSequence.new(profile.Motes.Color)
		emitter.Rate = moteRatePerEmitter
		emitter.Enabled = moteRatePerEmitter >= 0.1
	end

	local leafRatePerEmitter = EnvironmentConfig.AtmosphereLeafRatePerTile
		* qualityProfile.LeafRateMultiplier
		* intensity
	local leafAcceleration = Vector3.new(
		profile.Wind.X * EnvironmentConfig.AtmosphereLeafWindAccelerationMultiplier,
		EnvironmentConfig.AtmosphereLeafFallAcceleration,
		profile.Wind.Z * EnvironmentConfig.AtmosphereLeafWindAccelerationMultiplier
	)

	for _, leafState in ipairs(leafEmitters) do
		local leafRate = leafRatePerEmitter * leafState.Pattern.RateMultiplier
		leafState.Emitter.Color = ColorSequence.new(profile.Motes.Color)
		leafState.Emitter.Acceleration = leafAcceleration
		leafState.Emitter.Rate = leafRate
		leafState.Emitter.Enabled = leafRate >= 0.1
	end

	tweenLighting({
		ClockTime = profile.ClockTime,
		Brightness = profile.Brightness,
		ExposureCompensation = profile.ExposureCompensation,
		Ambient = profile.Ambient,
		OutdoorAmbient = profile.OutdoorAmbient,
		EnvironmentDiffuseScale = profile.EnvironmentDiffuseScale,
		EnvironmentSpecularScale = profile.EnvironmentSpecularScale,
		ShadowSoftness = profile.ShadowSoftness,
	})

	if lastProfileId ~= profile.Id then
		lastProfileId = profile.Id
		DebugLog.Info("Environment", "Ambiance de niveau appliquee", {
			LevelId = levelId,
			ChapterId = chapterId,
			Profile = profile.Id,
			Quality = qualitySettings.Quality,
			Atmosphere = atmosphere,
			Density = atmosphereDensity,
			MoteEmitters = moteEmitterCount,
			MoteRate = moteRate,
			MoteRatePerEmitter = moteRatePerEmitter,
			LeafEmitters = #leafEmitters,
			LeafRatePerEmitter = leafRatePerEmitter,
		})
	end
end

local function bindMapRuntime(mapRuntime)
	if mapRuntime == nil then
		return
	end

	mapRuntime.ChildAdded:Connect(function()
		task.defer(applyRunEnvironment)
	end)

	mapRuntime.ChildRemoved:Connect(function()
		task.defer(applyRunEnvironment)
	end)
end

local function refreshRunState(payload)
	isRunActive = typeof(payload) == "table" and payload.IsRunActive == true
	task.defer(applyRunEnvironment)
end

Workspace.ChildAdded:Connect(function(child)
	if child.Name == "MapRuntime" then
		bindMapRuntime(child)
		task.defer(applyRunEnvironment)
	end
end)

bindMapRuntime(Workspace:FindFirstChild("MapRuntime"))

Lighting.ChildAdded:Connect(function(child)
	if not child:IsA("Atmosphere")
		and not child:IsA("ColorCorrectionEffect")
		and not child:IsA("BlurEffect")
		and not child:IsA("DepthOfFieldEffect")
		and not child:IsA("SunRaysEffect") then
		return
	end

	task.defer(function()
		if ensureSourceEffects() then
			applyRunEnvironment()
		end
	end)
end)

ReplicatedStorage:WaitForChild("Run_StateUpdate").OnClientEvent:Connect(refreshRunState)

player:GetAttributeChangedSignal("IsRunActive"):Connect(function()
	isRunActive = player:GetAttribute("IsRunActive") == true
	task.defer(applyRunEnvironment)
end)

player:GetAttributeChangedSignal("RunMapId"):Connect(function()
	if isEnvironmentActive() then
		task.defer(applyRunEnvironment)
	end
end)

VfxQualityController.Changed.Event:Connect(function()
	if isEnvironmentActive() then
		applyRunEnvironment()
	end
end)

task.defer(applyRunEnvironment)

DebugLog.Info("Environment", "Controleur d'ambiance initialise", {
	Player = player.Name,
})
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="126">
          <Properties>
            <string name="Name">GraphicsController</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local GraphicsConfig = require(Shared:WaitForChild("GraphicsConfig"))
local PlayerPreferencesConfig = require(Shared:WaitForChild("PlayerPreferencesConfig"))

local GraphicsController = {}

local isStarted = false
local changedEvent = Instance.new("BindableEvent")
local setGraphicsPreferencesRemote = nil
local preferenceSaveSerial = 0
local settings = table.clone(GraphicsConfig.DefaultSettings)

local function normalizeQuality(value)
	if typeof(value) == "string" and GraphicsConfig.QualityProfiles[value] ~= nil then
		return value
	end

	return GraphicsConfig.DefaultSettings.Quality
end

local function applyLocalWorldSettings()
	Lighting.GlobalShadows = settings.ShadowsEnabled == true
end

local function applyGraphicsPreferences(rawGraphics)
	if typeof(rawGraphics) ~= "table" then
		return
	end

	settings.Quality = normalizeQuality(rawGraphics.Quality)
	settings.EffectsIntensity = math.clamp(
		tonumber(rawGraphics.EffectsIntensity) or GraphicsConfig.DefaultSettings.EffectsIntensity,
		0,
		1
	)
	settings.ShadowsEnabled = rawGraphics.ShadowsEnabled ~= false
end

local function schedulePreferencesSave()
	if setGraphicsPreferencesRemote == nil then
		return
	end

	preferenceSaveSerial += 1
	local scheduledSerial = preferenceSaveSerial

	task.delay(PlayerPreferencesConfig.ClientGraphicsDebounceSeconds, function()
		if scheduledSerial ~= preferenceSaveSerial or setGraphicsPreferencesRemote == nil then
			return
		end

		setGraphicsPreferencesRemote:FireServer(GraphicsController.GetSettings())
	end)
end

local function notifyChanged(shouldSave)
	applyLocalWorldSettings()
	changedEvent:Fire(GraphicsController.GetSettings())

	if shouldSave then
		schedulePreferencesSave()
	end
end

local function connectPreferences()
	local updateRemote = ReplicatedStorage:WaitForChild(PlayerPreferencesConfig.UpdateRemoteName, 15)

	if updateRemote ~= nil and updateRemote:IsA("RemoteEvent") then
		updateRemote.OnClientEvent:Connect(function(payload)
			if typeof(payload) == "table" and typeof(payload.Graphics) == "table" then
				applyGraphicsPreferences(payload.Graphics)
				notifyChanged(false)
			end
		end)
	end

	local setRemote = ReplicatedStorage:WaitForChild(PlayerPreferencesConfig.SetGraphicsRemoteName, 15)

	if setRemote ~= nil and setRemote:IsA("RemoteEvent") then
		setGraphicsPreferencesRemote = setRemote
	end

	local getRemote = ReplicatedStorage:WaitForChild(PlayerPreferencesConfig.GetStateRemoteName, 15)

	if getRemote == nil or not getRemote:IsA("RemoteFunction") then
		DebugLog.Warn("Preferences", "Remote de lecture preferences graphiques introuvable")
		return
	end

	local success, payload = pcall(function()
		return getRemote:InvokeServer()
	end)

	if success and typeof(payload) == "table" and typeof(payload.Graphics) == "table" then
		applyGraphicsPreferences(payload.Graphics)
	elseif not success then
		DebugLog.Warn("Preferences", "Lecture preferences graphiques impossible", {
			Error = tostring(payload),
		})
	end
end

function GraphicsController.GetSettings()
	return table.clone(settings)
end

function GraphicsController.GetCollectibleSettings()
	local profile = GraphicsConfig.GetProfile(settings.Quality)

	return {
		CullInterval = profile.CollectibleCullInterval,
		CullViewportMargin = profile.CollectibleCullViewportMargin,
		CullMaxDistance = profile.CollectibleCullMaxDistance,
		IdleAnimationHz = profile.CollectibleIdleAnimationHz,
	}
end

function GraphicsController.SetQuality(qualityName)
	settings.Quality = normalizeQuality(qualityName)
	notifyChanged(true)
end

function GraphicsController.SetEffectsIntensity(value)
	settings.EffectsIntensity = math.clamp(tonumber(value) or 0, 0, 1)
	notifyChanged(true)
end

function GraphicsController.SetShadowsEnabled(isEnabled)
	settings.ShadowsEnabled = isEnabled == true
	notifyChanged(true)
end

function GraphicsController.Reset()
	settings = table.clone(GraphicsConfig.DefaultSettings)
	notifyChanged(true)
end

function GraphicsController.Start()
	if isStarted then
		return
	end

	isStarted = true
	connectPreferences()
	applyLocalWorldSettings()

	DebugLog.Info("Preferences", "Reglages graphiques client initialises", {
		Quality = settings.Quality,
	})
end

GraphicsController.Changed = changedEvent

return GraphicsController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="127">
          <Properties>
            <string name="Name">GraphicsSettingsUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GraphicsConfig = require(Shared:WaitForChild("GraphicsConfig"))
local UiTheme = require(Shared:WaitForChild("UiTheme"))
local GraphicsController = require(script.Parent:WaitForChild("GraphicsController"))

GraphicsController.Start()

local existingGui = playerGui:FindFirstChild("GraphicsSettingsGui")

if existingGui ~= nil then
	existingGui:Destroy()
end

local COLORS = UiTheme.Contexts.Audio
local addCorner = UiTheme.AddCorner
local addStroke = UiTheme.AddStroke

local function addGradient(instance, firstColor, secondColor)
	return UiTheme.AddGradient(instance, firstColor, secondColor, 90)
end

local function createLabel(parent, name, text, size, color, font)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Font = font or Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color
	label.TextSize = size
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 0.55
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = parent
	return label
end

local function getSettingsPanelEvent()
	local event = playerGui:FindFirstChild("SettingsPanelChanged")

	if event == nil then
		event = Instance.new("BindableEvent")
		event.Name = "SettingsPanelChanged"
		event.Parent = playerGui
	end

	assert(event:IsA("BindableEvent"), "SettingsPanelChanged doit etre un BindableEvent.")
	return event
end

local settingsPanelEvent = getSettingsPanelEvent()

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "GraphicsSettingsGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = false
screenGui.DisplayOrder = 10
screenGui.Parent = playerGui

local graphicsButton = Instance.new("TextButton")
graphicsButton.Name = "GraphicsButton"
graphicsButton.AnchorPoint = Vector2.new(1, 0)
graphicsButton.Position = UDim2.new(1, -166, 0, 16)
graphicsButton.Size = UDim2.fromOffset(66, 34)
graphicsButton.BackgroundColor3 = Color3.fromRGB(37, 51, 70)
graphicsButton.BackgroundTransparency = 0.16
graphicsButton.BorderSizePixel = 0
graphicsButton.AutoButtonColor = false
graphicsButton.Font = Enum.Font.GothamBlack
graphicsButton.Text = "VIDEO"
graphicsButton.TextColor3 = COLORS.Text
graphicsButton.TextSize = 10
graphicsButton.Parent = screenGui
addCorner(graphicsButton, 8)
addStroke(graphicsButton, COLORS.MetalLight, 0.28, 1)
addGradient(graphicsButton, Color3.fromRGB(65, 88, 118), COLORS.MetalDark)
UiTheme.AddSurfaceFinish(graphicsButton, {
	Accent = Color3.fromRGB(167, 123, 255),
	Intensity = 0.4,
})

local panel = Instance.new("Frame")
panel.Name = "GraphicsPanel"
panel.AnchorPoint = Vector2.new(1, 0)
panel.Position = UDim2.new(1, -18, 0, 58)
panel.Size = UDim2.fromOffset(350, 290)
panel.BackgroundColor3 = Color3.fromRGB(37, 51, 70)
panel.BackgroundTransparency = 0.16
panel.BorderSizePixel = 0
panel.Visible = false
panel.Parent = screenGui
addCorner(panel, 10)
addStroke(panel, COLORS.MetalLight, 0.24, 2)
addGradient(panel, Color3.fromRGB(65, 88, 118), COLORS.MetalDark)
UiTheme.AddSurfaceFinish(panel, {
	Accent = Color3.fromRGB(167, 123, 255),
	Intensity = 0.6,
})

local panelConstraint = Instance.new("UISizeConstraint")
panelConstraint.MinSize = Vector2.new(290, 252)
panelConstraint.MaxSize = Vector2.new(350, 290)
panelConstraint.Parent = panel

local inner = Instance.new("Frame")
inner.Name = "GlassInner"
inner.Position = UDim2.fromOffset(4, 4)
inner.Size = UDim2.new(1, -8, 1, -8)
inner.BackgroundColor3 = Color3.fromRGB(13, 22, 34)
inner.BackgroundTransparency = 0.2
inner.BorderSizePixel = 0
inner.Parent = panel
addCorner(inner, 7)
addStroke(inner, COLORS.GlassStroke, 0.68, 1)

local title = createLabel(inner, "Title", "VIDEO", 17, COLORS.Text, Enum.Font.GothamBlack)
title.Position = UDim2.fromOffset(16, 10)
title.Size = UDim2.new(1, -120, 0, 24)

local resetButton = Instance.new("TextButton")
resetButton.Name = "ResetButton"
resetButton.AnchorPoint = Vector2.new(1, 0)
resetButton.Position = UDim2.new(1, -14, 0, 10)
resetButton.Size = UDim2.fromOffset(80, 24)
resetButton.BackgroundColor3 = Color3.fromRGB(32, 48, 66)
resetButton.BackgroundTransparency = 0.12
resetButton.BorderSizePixel = 0
resetButton.AutoButtonColor = false
resetButton.Font = Enum.Font.GothamBold
resetButton.Text = "DEFAUT"
resetButton.TextColor3 = COLORS.Text
resetButton.TextSize = 10
resetButton.Parent = inner
addCorner(resetButton, 5)
addStroke(resetButton, COLORS.GlassStroke, 0.6, 1)

local divider = Instance.new("Frame")
divider.Position = UDim2.fromOffset(14, 42)
divider.Size = UDim2.new(1, -28, 0, 1)
divider.BackgroundColor3 = COLORS.GlassStroke
divider.BackgroundTransparency = 0.75
divider.BorderSizePixel = 0
divider.Parent = inner

local qualityLabel = createLabel(inner, "QualityLabel", "QUALITE", 11, COLORS.Muted, Enum.Font.GothamBold)
qualityLabel.Position = UDim2.fromOffset(16, 52)
qualityLabel.Size = UDim2.new(1, -32, 0, 16)

local qualityContainer = Instance.new("Frame")
qualityContainer.Name = "QualityContainer"
qualityContainer.Position = UDim2.fromOffset(16, 72)
qualityContainer.Size = UDim2.new(1, -32, 0, 45)
qualityContainer.BackgroundTransparency = 1
qualityContainer.BorderSizePixel = 0
qualityContainer.Parent = inner

local qualityLayout = Instance.new("UIListLayout")
qualityLayout.FillDirection = Enum.FillDirection.Horizontal
qualityLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
qualityLayout.VerticalAlignment = Enum.VerticalAlignment.Center
qualityLayout.SortOrder = Enum.SortOrder.LayoutOrder
qualityLayout.Padding = UDim.new(0, 5)
qualityLayout.Parent = qualityContainer

local qualityButtons = {}
local qualityOrder = { "Performance", "Balanced", "Quality" }

for index, qualityName in ipairs(qualityOrder) do
	local profile = GraphicsConfig.GetProfile(qualityName)
	local button = Instance.new("TextButton")
	button.Name = qualityName
	button.LayoutOrder = index
	button.Size = UDim2.new(1 / #qualityOrder, -4, 1, 0)
	button.BackgroundColor3 = Color3.fromRGB(18, 33, 48)
	button.BackgroundTransparency = 0.08
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Font = Enum.Font.GothamBold
	button.Text = profile.Label
	button.TextColor3 = COLORS.Muted
	button.TextSize = 10
	button.TextWrapped = true
	button.Parent = qualityContainer
	addCorner(button, 5)
	addStroke(button, COLORS.GlassStroke, 0.74, 1)
	qualityButtons[qualityName] = button

	button.Activated:Connect(function()
		GraphicsController.SetQuality(qualityName)
	end)
end

local function createSliderRow(parent, labelText, accent, yOffset)
	local row = Instance.new("Frame")
	row.Name = labelText .. "Row"
	row.Position = UDim2.fromOffset(16, yOffset)
	row.Size = UDim2.new(1, -32, 0, 42)
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	row.Parent = parent

	local label = createLabel(row, "Label", labelText, 11, COLORS.Muted, Enum.Font.GothamBold)
	label.Size = UDim2.new(0, 160, 0, 15)

	local value = createLabel(row, "Value", "100%", 11, accent, Enum.Font.GothamBlack)
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.new(1, 0, 0, 0)
	value.Size = UDim2.fromOffset(52, 15)
	value.TextXAlignment = Enum.TextXAlignment.Right

	local track = Instance.new("TextButton")
	track.Name = "Track"
	track.Position = UDim2.fromOffset(0, 21)
	track.Size = UDim2.new(1, 0, 0, 10)
	track.BackgroundColor3 = COLORS.Track
	track.BackgroundTransparency = 0.04
	track.BorderSizePixel = 0
	track.AutoButtonColor = false
	track.Text = ""
	track.ClipsDescendants = true
	track.Parent = row
	addCorner(track, 5)
	addStroke(track, COLORS.GlassStroke, 0.76, 1)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = accent
	fill.BorderSizePixel = 0
	fill.Parent = track
	addCorner(fill, 5)

	return {
		Track = track,
		Fill = fill,
		Value = value,
	}
end

local effectsRow = createSliderRow(inner, "EFFETS", Color3.fromRGB(190, 116, 255), 128)

local shadowsRow = Instance.new("Frame")
shadowsRow.Name = "ShadowsRow"
shadowsRow.Position = UDim2.fromOffset(16, 182)
shadowsRow.Size = UDim2.new(1, -32, 0, 36)
shadowsRow.BackgroundTransparency = 1
shadowsRow.BorderSizePixel = 0
shadowsRow.Parent = inner

local shadowsLabel = createLabel(shadowsRow, "Label", "OMBRES", 11, COLORS.Muted, Enum.Font.GothamBold)
shadowsLabel.Size = UDim2.new(0.6, 0, 1, 0)

local shadowsToggle = Instance.new("TextButton")
shadowsToggle.Name = "ShadowsToggle"
shadowsToggle.AnchorPoint = Vector2.new(1, 0.5)
shadowsToggle.Position = UDim2.new(1, 0, 0.5, 0)
shadowsToggle.Size = UDim2.fromOffset(64, 26)
shadowsToggle.BackgroundColor3 = Color3.fromRGB(18, 33, 48)
shadowsToggle.BorderSizePixel = 0
shadowsToggle.AutoButtonColor = false
shadowsToggle.Text = ""
shadowsToggle.Parent = shadowsRow
addCorner(shadowsToggle, 13)
addStroke(shadowsToggle, COLORS.GlassStroke, 0.62, 1)

local toggleKnob = Instance.new("Frame")
toggleKnob.Name = "Knob"
toggleKnob.AnchorPoint = Vector2.new(0, 0.5)
toggleKnob.Position = UDim2.new(0, 3, 0.5, 0)
toggleKnob.Size = UDim2.fromOffset(20, 20)
toggleKnob.BackgroundColor3 = COLORS.Text
toggleKnob.BorderSizePixel = 0
toggleKnob.Parent = shadowsToggle
addCorner(toggleKnob, 10)

local summary = createLabel(inner, "Summary", "", 10, COLORS.Muted, Enum.Font.GothamMedium)
summary.Position = UDim2.fromOffset(16, 226)
summary.Size = UDim2.new(1, -32, 0, 20)
summary.TextXAlignment = Enum.TextXAlignment.Center

local activeSlider = nil

local function setEffectsFromPosition(positionX)
	local width = math.max(1, effectsRow.Track.AbsoluteSize.X)
	local value = math.clamp((positionX - effectsRow.Track.AbsolutePosition.X) / width, 0, 1)
	GraphicsController.SetEffectsIntensity(value)
end

effectsRow.Track.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		activeSlider = effectsRow
		setEffectsFromPosition(input.Position.X)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if activeSlider == nil then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		setEffectsFromPosition(input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		activeSlider = nil
	end
end)

local function refresh(settings)
	for qualityName, button in pairs(qualityButtons) do
		local isSelected = settings.Quality == qualityName
		button.BackgroundColor3 = if isSelected then Color3.fromRGB(64, 50, 110) else Color3.fromRGB(18, 33, 48)
		button.TextColor3 = if isSelected then COLORS.Text else COLORS.Muted
	end

	local effects = math.clamp(settings.EffectsIntensity or 0, 0, 1)
	effectsRow.Fill.Size = UDim2.new(effects, 0, 1, 0)
	effectsRow.Value.Text = tostring(math.floor((effects * 100) + 0.5)) .. "%"

	local shadowsEnabled = settings.ShadowsEnabled == true
	shadowsToggle.BackgroundColor3 = if shadowsEnabled then Color3.fromRGB(66, 104, 83) else Color3.fromRGB(45, 53, 65)
	toggleKnob.Position = if shadowsEnabled
		then UDim2.new(1, -23, 0.5, 0)
		else UDim2.new(0, 3, 0.5, 0)
	toggleKnob.BackgroundColor3 = if shadowsEnabled then Color3.fromRGB(156, 255, 185) else COLORS.Muted

	local profile = GraphicsConfig.GetProfile(settings.Quality)
	summary.Text = ("Loot %d studs  |  VFX x%.2f"):format(
		profile.CollectibleCullMaxDistance,
		effects * profile.EffectsMultiplier
	)
end

graphicsButton.Activated:Connect(function()
	local nextVisible = not panel.Visible

	if nextVisible then
		settingsPanelEvent:Fire("Graphics")
	else
		settingsPanelEvent:Fire(nil)
	end

	panel.Visible = nextVisible
	TweenService:Create(graphicsButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = if panel.Visible then 0.02 else 0.16,
	}):Play()
end)

settingsPanelEvent.Event:Connect(function(openPanelName)
	if openPanelName == "Graphics" or not panel.Visible then
		return
	end

	panel.Visible = false
	TweenService:Create(graphicsButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0.16,
	}):Play()
end)

shadowsToggle.Activated:Connect(function()
	local settings = GraphicsController.GetSettings()
	GraphicsController.SetShadowsEnabled(settings.ShadowsEnabled ~= true)
end)

resetButton.Activated:Connect(function()
	GraphicsController.Reset()
end)

GraphicsController.Changed.Event:Connect(refresh)
refresh(GraphicsController.GetSettings())
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="128">
          <Properties>
            <string name="Name">InteractionPromptUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local UiTheme = require(Shared:WaitForChild("UiTheme"))

local existingGui = playerGui:FindFirstChild("InteractionPromptGui")

if existingGui ~= nil then
	existingGui:Destroy()
end

local COLORS = UiTheme.Contexts.Interaction

local viewsByPrompt = {}
local PROMPT_VISUAL_MAX_DISTANCE = 300

local addCorner = UiTheme.AddCorner
local addStroke = UiTheme.AddStroke

local function addGradient(instance, firstColor, secondColor)
	return UiTheme.AddGradient(instance, firstColor, secondColor, 90)
end

local function createLabel(parent, name, text, font, textSize, color)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Font = font
	label.Text = text
	label.TextColor3 = color
	label.TextSize = textSize
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 0.48
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = parent

	return label
end

local function getAdornee(prompt)
	local parent = prompt.Parent

	if parent ~= nil and (parent:IsA("BasePart") or parent:IsA("Attachment")) then
		return parent
	end

	if parent ~= nil and parent:IsA("Model") then
		return parent.PrimaryPart or parent:FindFirstChildWhichIsA("BasePart", true)
	end

	return nil
end

local function getInputText(prompt, inputType)
	if inputType == Enum.ProximityPromptInputType.Gamepad then
		return string.gsub(prompt.GamepadKeyCode.Name, "Button", "")
	end

	if inputType == Enum.ProximityPromptInputType.Touch then
		return "TAP"
	end

	return prompt.KeyboardKeyCode.Name
end

local function destroyView(prompt)
	local view = viewsByPrompt[prompt]

	if view == nil then
		return
	end

	if view.HoldTween ~= nil then
		view.HoldTween:Cancel()
	end

	viewsByPrompt[prompt] = nil

	if view.Billboard.Parent ~= nil then
		view.Billboard:Destroy()
	end
end

local function resetHoldProgress(view)
	if view.HoldTween ~= nil then
		view.HoldTween:Cancel()
		view.HoldTween = nil
	end

	view.ProgressFill.Size = UDim2.fromScale(0, 1)
end

local function createView(prompt, inputType)
	destroyView(prompt)

	local adornee = getAdornee(prompt)

	if adornee == nil then
		return nil
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "InteractionPrompt"
	billboard.Adornee = adornee
	billboard.AlwaysOnTop = true
	billboard.LightInfluence = 0
	-- La distance d'interaction reste geree par le ProximityPrompt cote serveur.
	-- Cette valeur concerne seulement le rendu lorsque la camera est reculee.
	billboard.MaxDistance = math.max(prompt.MaxActivationDistance + 5, PROMPT_VISUAL_MAX_DISTANCE)
	billboard.Size = UDim2.fromOffset(270, 76)
	billboard.StudsOffsetWorldSpace = Vector3.new(0, 2.15, 0)
	billboard.Parent = playerGui

	local scale = Instance.new("UIScale")
	scale.Scale = 0.92
	scale.Parent = billboard

	local outer = Instance.new("Frame")
	outer.Name = "MetalFrame"
	outer.Size = UDim2.fromScale(1, 1)
	outer.BackgroundColor3 = Color3.fromRGB(37, 51, 70)
	outer.BackgroundTransparency = 0.2
	outer.BorderSizePixel = 0
	outer.Parent = billboard
	addCorner(outer, 11)
	addStroke(outer, COLORS.MetalLight, 0.22, 2)
	addGradient(outer, Color3.fromRGB(65, 88, 118), COLORS.MetalDark)
	UiTheme.AddSurfaceFinish(outer, {
		Accent = COLORS.Accent,
		Intensity = 0.55,
	})

	local inner = Instance.new("Frame")
	inner.Name = "GlassInner"
	inner.Position = UDim2.fromOffset(4, 4)
	inner.Size = UDim2.new(1, -8, 1, -8)
	inner.BackgroundColor3 = Color3.fromRGB(13, 22, 34)
	inner.BackgroundTransparency = 0.28
	inner.BorderSizePixel = 0
	inner.Parent = outer
	addCorner(inner, 8)
	addStroke(inner, COLORS.GlassStroke, 0.7, 1)

	local accent = Instance.new("Frame")
	accent.Name = "Accent"
	accent.Position = UDim2.fromOffset(8, 10)
	accent.Size = UDim2.fromOffset(3, 48)
	accent.BackgroundColor3 = COLORS.Accent
	accent.BackgroundTransparency = 0.16
	accent.BorderSizePixel = 0
	accent.Parent = inner
	addCorner(accent, 2)

	local keyShell = Instance.new("Frame")
	keyShell.Name = "KeyShell"
	keyShell.Position = UDim2.fromOffset(18, 13)
	keyShell.Size = UDim2.fromOffset(48, 48)
	keyShell.BackgroundColor3 = Color3.fromRGB(47, 64, 86)
	keyShell.BackgroundTransparency = 0.04
	keyShell.BorderSizePixel = 0
	keyShell.Parent = inner
	addCorner(keyShell, 10)
	addStroke(keyShell, COLORS.GlassStroke, 0.28, 2)
	addGradient(keyShell, Color3.fromRGB(111, 136, 163), Color3.fromRGB(24, 34, 48))

	local keyButton = Instance.new("TextButton")
	keyButton.Name = "KeyButton"
	keyButton.Position = UDim2.fromOffset(4, 4)
	keyButton.Size = UDim2.new(1, -8, 1, -8)
	keyButton.BackgroundColor3 = Color3.fromRGB(18, 29, 42)
	keyButton.BackgroundTransparency = 0.2
	keyButton.BorderSizePixel = 0
	keyButton.AutoButtonColor = false
	keyButton.Font = Enum.Font.GothamBlack
	keyButton.Text = getInputText(prompt, inputType)
	keyButton.TextColor3 = COLORS.Text
	keyButton.TextSize = 20
	keyButton.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	keyButton.TextStrokeTransparency = 0.34
	keyButton.Parent = keyShell
	addCorner(keyButton, 7)

	local objectText = createLabel(inner, "ObjectText", prompt.ObjectText, Enum.Font.GothamMedium, 12, COLORS.Muted)
	objectText.Position = UDim2.fromOffset(78, 13)
	objectText.Size = UDim2.new(1, -92, 0, 20)

	local actionText = createLabel(inner, "ActionText", prompt.ActionText, Enum.Font.GothamBold, 18, COLORS.Text)
	actionText.Position = UDim2.fromOffset(78, 31)
	actionText.Size = UDim2.new(1, -92, 0, 25)

	local progressTrack = Instance.new("Frame")
	progressTrack.Name = "HoldProgressTrack"
	progressTrack.Position = UDim2.new(0, 78, 1, -9)
	progressTrack.Size = UDim2.new(1, -92, 0, 3)
	progressTrack.BackgroundColor3 = Color3.fromRGB(6, 12, 20)
	progressTrack.BackgroundTransparency = 0.12
	progressTrack.BorderSizePixel = 0
	progressTrack.Visible = prompt.HoldDuration > 0
	progressTrack.ClipsDescendants = true
	progressTrack.Parent = inner
	addCorner(progressTrack, 2)

	local progressFill = Instance.new("Frame")
	progressFill.Name = "Fill"
	progressFill.Size = UDim2.fromScale(0, 1)
	progressFill.BackgroundColor3 = COLORS.Progress
	progressFill.BorderSizePixel = 0
	progressFill.Parent = progressTrack
	addCorner(progressFill, 2)

	local view = {
		Billboard = billboard,
		Scale = scale,
		ProgressFill = progressFill,
		HoldTween = nil,
	}
	viewsByPrompt[prompt] = view
	DebugLog.ThrottledInfo("UI", "interaction_prompt_shown", 1, "Prompt custom affiche", {
		Action = prompt.ActionText,
		Object = prompt.ObjectText,
		Prompt = prompt,
	})

	keyButton.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			prompt:InputHoldBegin()
		end
	end)

	keyButton.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			prompt:InputHoldEnd()
		end
	end)

	TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Scale = 1,
	}):Play()

	return view
end

ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
	if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
		return
	end

	createView(prompt, inputType)
end)

ProximityPromptService.PromptHidden:Connect(destroyView)

ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
	local view = viewsByPrompt[prompt]

	if view == nil or prompt.HoldDuration <= 0 then
		return
	end

	resetHoldProgress(view)
	view.HoldTween = TweenService:Create(view.ProgressFill, TweenInfo.new(prompt.HoldDuration, Enum.EasingStyle.Linear), {
		Size = UDim2.fromScale(1, 1),
	})
	view.HoldTween:Play()
end)

ProximityPromptService.PromptButtonHoldEnded:Connect(function(prompt)
	local view = viewsByPrompt[prompt]

	if view ~= nil then
		resetHoldProgress(view)
	end
end)

ProximityPromptService.PromptTriggered:Connect(function(prompt, playerWhoTriggered)
	if playerWhoTriggered ~= player then
		return
	end

	local view = viewsByPrompt[prompt]

	if view ~= nil then
		TweenService:Create(view.Scale, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Scale = 0.96,
		}):Play()
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="129">
          <Properties>
            <string name="Name">ItemRevealV2Adapter</string>
            <string name="Source"><![CDATA[--!strict

-- Adapte le composant visuel V2 de coffre aux donnees deja decidees par le
-- serveur. Le client ne choisit ni la recompense ni la consommation de credits.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local UiTemplateConfig = require(Shared:WaitForChild("UiTemplateConfig"))

local openResultRemote = ReplicatedStorage:WaitForChild("Chest_OpenResult")
local openFailedRemote = ReplicatedStorage:WaitForChild("Chest_OpenFailed")
local choiceRequestRemote = ReplicatedStorage:WaitForChild("Chest_ChoiceRequest")
local choiceResultRemote = ReplicatedStorage:WaitForChild("Chest_ChoiceResult")

local V2_GUI_NAME = "ItemRevealV2"
local PRODUCTION_TEMPLATE_GUI_NAME = UiTemplateConfig.ProductionTemplateGuiName

local RARITY_COLORS = {
	Common = Color3.fromRGB(80, 220, 120),
	Rare = Color3.fromRGB(80, 155, 255),
	Epic = Color3.fromRGB(185, 95, 255),
	Legendary = Color3.fromRGB(255, 245, 99),
}

local ACTION_COLORS = {
	Continue = Color3.fromRGB(160, 71, 230),
	Pass = Color3.fromRGB(40, 223, 248),
	Ban = Color3.fromRGB(248, 60, 76),
}

local function asFrame(instance: Instance?): Frame?
	if instance and instance:IsA("Frame") then
		return instance
	end

	return nil
end

local function asTextLabel(instance: Instance?): TextLabel?
	if instance and instance:IsA("TextLabel") then
		return instance
	end

	return nil
end

local function asImageLabel(instance: Instance?): ImageLabel?
	if instance and instance:IsA("ImageLabel") then
		return instance
	end

	return nil
end

local function asButton(instance: Instance?): TextButton?
	if instance and instance:IsA("TextButton") then
		return instance
	end

	return nil
end

local function findPath(root: Instance?, names: { string }): Instance?
	local current = root

	for _, name in ipairs(names) do
		current = current and current:FindFirstChild(name)

		if current == nil then
			return nil
		end
	end

	return current
end

local function setText(instance: Instance?, value: unknown)
	local label = asTextLabel(instance)

	if label then
		label.Text = tostring(value or "")
	end
end

local function getRarityColor(rarity: unknown, fallback: unknown): Color3
	if typeof(rarity) == "string" and RARITY_COLORS[rarity] then
		return RARITY_COLORS[rarity]
	end

	if typeof(fallback) == "Color3" then
		return fallback
	end

	return RARITY_COLORS.Common
end

local function setStrokeColor(instance: Instance?, color: Color3)
	local stroke = instance and instance:FindFirstChild("RarityStroke")

	if stroke and stroke:IsA("UIStroke") then
		stroke.Color = color
	end
end

local function tween(instance: Instance?, duration: number, properties: { [string]: unknown })
	if instance == nil then
		return
	end

	TweenService:Create(instance, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), properties):Play()
end

type Reward = {
	Id: string?,
	Name: string?,
	Description: string?,
	Icon: string?,
	Rarity: string?,
	Accent: Color3?,
}

local function initialise()
	local templateGui = playerGui:WaitForChild(PRODUCTION_TEMPLATE_GUI_NAME, 30)

	if templateGui == nil or not templateGui:IsA("ScreenGui") then
		DebugLog.Warn("UI", "Item reveal V2 non active, template de production introuvable")
		return
	end

	local template = findPath(templateGui, { "RunCanvas", "ItemRevealDock" })

	if template == nil or not template:IsA("Frame") then
		DebugLog.Warn("UI", "Item reveal V2 non active, ItemRevealDock invalide")
		return
	end

	local previousGui = playerGui:FindFirstChild(V2_GUI_NAME)

	if previousGui then
		previousGui:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = V2_GUI_NAME
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 21
	screenGui.Enabled = false
	screenGui.Parent = playerGui

	local overlay = Instance.new("Frame")
	overlay.Name = "Overlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.fromRGB(2, 5, 11)
	overlay.BackgroundTransparency = 0.36
	overlay.BorderSizePixel = 0
	overlay.Parent = screenGui

	local dock = template:Clone()
	dock.Name = "ItemRevealDockV2"
	dock.Visible = true
	dock:SetAttribute("ProductionBound", true)
	dock.Parent = overlay

	templateGui.Enabled = false

	local panel = asFrame(dock:FindFirstChild("ItemRevealPanel"))
	local content = panel and asFrame(panel:FindFirstChild("Content"))
	local reelStage = content and asFrame(content:FindFirstChild("ReelStage"))
	local reelSlots = content and asFrame(findPath(content, { "ReelStage", "ReelViewport", "ReelSlots" }))
	local revealCard = content and asFrame(content:FindFirstChild("RevealCard"))
	local titleLabel = content and asTextLabel(content:FindFirstChild("Title"))
	local subtitleLabel = content and asTextLabel(content:FindFirstChild("Subtitle"))
	local actionRow = content and asFrame(content:FindFirstChild("ActionRow"))
	local continueButton = content and asButton(findPath(content, { "ActionRow", "ButtonRow", "Continue" }))
	local passButton = content and asButton(findPath(content, { "ActionRow", "ButtonRow", "Pass" }))
	local banButton = content and asButton(findPath(content, { "ActionRow", "ButtonRow", "Ban" }))

	if
		panel == nil
		or content == nil
		or reelStage == nil
		or reelSlots == nil
		or revealCard == nil
		or titleLabel == nil
		or subtitleLabel == nil
		or actionRow == nil
		or continueButton == nil
		or passButton == nil
		or banButton == nil
	then
		DebugLog.Warn("UI", "Item reveal V2 non active, hierarchie du kit incomplete")
		screenGui:Destroy()
		return
	end

	local reelSlotFrames = {}

	for index = 1, 5 do
		local slot = asFrame(reelSlots:FindFirstChild("Slot" .. tostring(index)))

		if slot then
			reelSlotFrames[index] = slot
		end
	end

	local cardIcon = asImageLabel(findPath(revealCard, { "IconFrame", "Icon" }))
	local cardRarity = asTextLabel(findPath(revealCard, { "ResultContent", "Rarity" }))
	local cardItemName = asTextLabel(findPath(revealCard, { "ResultContent", "ItemName" }))
	local cardDescription = asTextLabel(findPath(revealCard, { "ResultContent", "Description" }))
	local cardStack = asTextLabel(findPath(revealCard, { "ResultContent", "StackText" }))
	local selectionMarker = asFrame(findPath(content, { "ReelStage", "ReelViewport", "SelectionMarker" }))

	local activeOpeningId: string? = nil
	local isChoiceSubmitting = false

	if selectionMarker then
		selectionMarker.BackgroundTransparency = 1
		local markerStroke = selectionMarker:FindFirstChild("GlowStroke")
		if markerStroke and markerStroke:IsA("UIStroke") then
			markerStroke.Color = Color3.fromRGB(245, 246, 255)
		end

		for _, capName in ipairs({ "TopCap", "BottomCap" }) do
			local cap = asFrame(selectionMarker:FindFirstChild(capName))
			if cap then
				cap.BackgroundColor3 = Color3.fromRGB(245, 246, 255)
			end
		end
	end

	local function getCreditCount(attributeName: string): number
		return math.max(0, math.floor(tonumber(player:GetAttribute(attributeName)) or 0))
	end

	local function getCreditMaximum(attributeName: string): number
		return math.max(0, math.floor(tonumber(player:GetAttribute(attributeName)) or 0))
	end

	local function setActionState(
		button: TextButton,
		state: "Available" | "Consumed" | "Disabled",
		color: Color3,
		label: string,
		charges: number
	)
		button.Text = label
		button.Active = state == "Available"
		button.AutoButtonColor = state == "Available"
		button.TextColor3 = if state == "Disabled" then Color3.fromRGB(96, 99, 118) else Color3.fromRGB(245, 246, 255)
		button.BackgroundTransparency = if state == "Available" then 0.08 else 0.38
		button:SetAttribute("ActionState", state)
		button:SetAttribute("Charges", charges)

		local stroke = button:FindFirstChild("ActionStroke")
		if stroke and stroke:IsA("UIStroke") then
			stroke.Color = color
			stroke.Transparency = if state == "Available" then 0.12 else 0.58
		end

		local glow = asFrame(button:FindFirstChild("AccentGlow"))
		if glow then
			glow.BackgroundColor3 = color
			glow.BackgroundTransparency = if state == "Available" then 0.7 else 0.9
		end

		local pips = asFrame(button:FindFirstChild("ChargePips"))
		if pips then
			local pipIndex = 0
			for _, pip in ipairs(pips:GetChildren()) do
				if pip:IsA("Frame") then
					pipIndex += 1
					pip.BackgroundColor3 = color
					pip.BackgroundTransparency = if state == "Available" and pipIndex <= charges then 0.04 else 0.82
				end
			end
		end
	end

	local function refreshActions()
		local passCredits = getCreditCount("RunPassCredits")
		local passMaximum = getCreditMaximum("RunPassCreditsMax")
		local banCredits = getCreditCount("RunBanCredits")
		local banMaximum = getCreditMaximum("RunBanCreditsMax")

		setActionState(continueButton, "Available", ACTION_COLORS.Continue, "CONTINUER", 0)
		setActionState(
			passButton,
			if passCredits > 0 then "Available" else "Consumed",
			ACTION_COLORS.Pass,
			("PASSER (%d/%d)"):format(passCredits, passMaximum),
			passCredits
		)
		setActionState(
			banButton,
			if banCredits > 0 then "Available" else "Consumed",
			ACTION_COLORS.Ban,
			("BANNIR (%d/%d)"):format(banCredits, banMaximum),
			banCredits
		)
	end

	local function setSlotItem(slot: Frame, item: Reward, isSelected: boolean)
		local rarityColor = getRarityColor(item.Rarity, item.Accent)
		local icon = asImageLabel(slot:FindFirstChild("Icon"))
		local rarity = asTextLabel(slot:FindFirstChild("Rarity"))

		if icon then
			icon.Image = tostring(item.Icon or "")
		end

		if rarity then
			rarity.Text = string.upper(tostring(item.Rarity or "COMMUN"))
			rarity.TextColor3 = rarityColor
		end

		setStrokeColor(slot, rarityColor)
		local materialLayer = asFrame(slot:FindFirstChild("MaterialLayer"))
		if materialLayer then
			materialLayer.BackgroundColor3 = rarityColor
			materialLayer.BackgroundTransparency = if isSelected then 0.88 else 0.94
		end
	end

	local function setReelItems(items: { Reward }, selectedIndex: number)
		if #items == 0 then
			return
		end

		for index, slot in ipairs(reelSlotFrames) do
			local itemIndex = ((selectedIndex + index - 3 - 1) % #items) + 1
			setSlotItem(slot, items[itemIndex], index == 3)
		end
	end

	local function showRevealCard(reward: Reward, isNewItem: boolean, itemCount: number?)
		local rarityColor = getRarityColor(reward.Rarity, reward.Accent)

		if cardIcon then
			cardIcon.Image = tostring(reward.Icon or "")
		end

		setText(cardRarity, string.upper(tostring(reward.Rarity or "COMMUN")))
		setText(cardItemName, reward.Name or "Objet mystere")
		setText(cardDescription, reward.Description or "Objet permanent pour cette run")

		if cardRarity then
			cardRarity.TextColor3 = rarityColor
		end

		if cardStack then
			if isNewItem then
				cardStack.Text = "NOUVEL OBJET  x1"
			else
				cardStack.Text = "OBJET CUMULE  x" .. tostring(math.max(1, math.floor(tonumber(itemCount) or 1)))
			end
			cardStack.TextColor3 = rarityColor
		end

		setStrokeColor(revealCard, rarityColor)
		local iconFrame = asFrame(revealCard:FindFirstChild("IconFrame"))
		setStrokeColor(iconFrame, rarityColor)

		local materialLayer = asFrame(revealCard:FindFirstChild("MaterialLayer"))
		if materialLayer then
			materialLayer.BackgroundColor3 = rarityColor
			materialLayer.BackgroundTransparency = 0.93
		end

		revealCard.Visible = true
		actionRow.Visible = true
		-- Le rouleau appartient exclusivement a la phase de tirage. Une fois
		-- l'objet revele, il disparait pour ne laisser que la recompense lisible.
		reelStage.Visible = false
		revealCard.BackgroundTransparency = 1
		tween(revealCard, 0.18, { BackgroundTransparency = 0.12 })
	end

	local function resetPresentation()
		revealCard.Visible = false
		actionRow.Visible = false
		reelStage.Visible = true
		titleLabel.Text = "OBJET TROUVE"
		subtitleLabel.Text = "Le coffre revele un objet permanent pour cette run"
		refreshActions()
	end

	local function closePresentation()
		activeOpeningId = nil
		isChoiceSubmitting = false
		screenGui.Enabled = false
		revealCard.Visible = false
		actionRow.Visible = false
	end

	local function playReel(payload)
		local reward = (payload.Reward or {}) :: Reward
		local rawSpinItems = payload.SpinItems
		local spinItems: { Reward } = {}

		if typeof(rawSpinItems) == "table" then
			for _, item in ipairs(rawSpinItems) do
				if typeof(item) == "table" then
					table.insert(spinItems, item :: Reward)
				end
			end
		end

		if #spinItems == 0 then
			spinItems = { reward }
		end

		activeOpeningId = tostring(payload.OpeningId or "")
		isChoiceSubmitting = false
		screenGui.Enabled = true
		resetPresentation()
		titleLabel.Text = if payload.IsRewardChest then "RECOMPENSE ELITE" else "COFFRE OUVERT"
		subtitleLabel.Text = "Les reliques tournent..."

		local duration = math.max(0.5, tonumber(payload.Duration) or 2.4)
		local startedAt = os.clock()
		local nextStepAt = startedAt
		local selectedIndex = 1

		while os.clock() - startedAt < duration do
			local elapsed = os.clock() - startedAt
			local progress = math.clamp(elapsed / duration, 0, 1)
			local interval = 0.025 + (progress ^ 3.2) * 0.18

			if os.clock() >= nextStepAt then
				selectedIndex = (selectedIndex % #spinItems) + 1
				setReelItems(spinItems, selectedIndex)
				nextStepAt = os.clock() + interval
			end

			task.wait()
		end

		-- La bobine conserve son historique visuel. Seule la case centrale
		-- s'immobilise sur la recompense avant l'affichage du resultat.
		local selectedSlot = reelSlotFrames[3]
		if selectedSlot then
			setSlotItem(selectedSlot, reward, true)
		end
		subtitleLabel.Text = "Objet revele"
		task.wait(0.35)
		showRevealCard(reward, false, nil)
	end

	local function submitChoice(action: string)
		if activeOpeningId == nil or activeOpeningId == "" or isChoiceSubmitting then
			return
		end

		isChoiceSubmitting = true
		setActionState(continueButton, "Disabled", ACTION_COLORS.Continue, "CONTINUER", 0)
		setActionState(passButton, "Disabled", ACTION_COLORS.Pass, passButton.Text, getCreditCount("RunPassCredits"))
		setActionState(banButton, "Disabled", ACTION_COLORS.Ban, banButton.Text, getCreditCount("RunBanCredits"))
		choiceRequestRemote:FireServer(activeOpeningId, action)
	end

	continueButton.Activated:Connect(function()
		submitChoice("Accept")
	end)

	passButton.Activated:Connect(function()
		submitChoice("Pass")
	end)

	banButton.Activated:Connect(function()
		submitChoice("Ban")
	end)

	openResultRemote.OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end

		task.spawn(function()
			playReel(payload)
		end)
	end)

	openFailedRemote.OnClientEvent:Connect(function(payload)
		if typeof(payload) == "table" and payload.Reason == "OpeningAlreadyActive" then
			return
		end

		closePresentation()
	end)

	choiceResultRemote.OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end

		if activeOpeningId == nil then
			return
		end

		local reward = (payload.Reward or {}) :: Reward
		showRevealCard(reward, payload.IsNewItem == true, payload.ItemCount)
		subtitleLabel.Text = if payload.Accepted then "Objet ajoute a votre run" else "Choix confirme"
		isChoiceSubmitting = false

		-- La confirmation serveur apporte le vrai statut « nouveau » ou « cumule ».
		-- On le laisse visible assez longtemps pour que ce retour ait une valeur.
		task.delay(0.75, function()
			closePresentation()
		end)
	end)

	player:GetAttributeChangedSignal("RunPassCredits"):Connect(refreshActions)
	player:GetAttributeChangedSignal("RunPassCreditsMax"):Connect(refreshActions)
	player:GetAttributeChangedSignal("RunBanCredits"):Connect(refreshActions)
	player:GetAttributeChangedSignal("RunBanCreditsMax"):Connect(refreshActions)

	refreshActions()
	playerGui:SetAttribute("ItemRevealV2Ready", true)

	DebugLog.Info("UI", "Item reveal V2 initialise", {
		Player = player.Name,
		Template = PRODUCTION_TEMPLATE_GUI_NAME,
	})
end

initialise()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="130">
          <Properties>
            <string name="Name">LobbyPanels</string>
            <string name="Source"><![CDATA[--!strict

-- Cree les panneaux du lobby relies aux raccourcis lateraux.

