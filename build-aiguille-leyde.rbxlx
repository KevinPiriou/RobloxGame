local function writeReportValue(name, value)
	local reportValue = reportFolder:FindFirstChild(name)

	if reportValue == nil then
		reportValue = Instance.new("StringValue")
		reportValue.Name = name
		reportValue.Parent = reportFolder
	end

	assert(reportValue:IsA("StringValue"), name .. " doit etre un StringValue.")
	reportValue.Value = value
end

local finishCampaign
local startCampaignNextScenario

local function finishBenchmark(benchmark, reason)
	if activeBenchmark ~= benchmark then
		return
	end

	benchmark.Phase = "Cleanup"
	-- Le contexte P0 reste actif jusqu'au rapport final. Sans cela, les
	-- vagues ordinaires faussent immediatement la mesure de memoire residuelle.
	cleanupBenchmark(benchmark, true)
	benchmark.ServerMemoryAfterCleanupMb = readNumber(function()
		return Stats:GetTotalMemoryUsageMb()
	end)
	publishStatus(benchmark, "Cleanup", { Reason = reason })

	task.delay(PerformanceBaselineConfig.CleanupSeconds, function()
		if activeBenchmark ~= benchmark then
			return
		end

		benchmark.Phase = "IdleObservation"
		publishStatus(benchmark, "IdleObservation", { Reason = reason })

		task.delay(PerformanceBaselineConfig.IdleObservationSeconds, function()
			if activeBenchmark ~= benchmark then
				return
			end

			benchmark.ServerMemoryAfterIdleMb = readNumber(function()
				return Stats:GetTotalMemoryUsageMb()
			end)

			local telemetry = PerformanceTelemetryService.Finish()
			local report = {
				Version = "P0.4",
				FinishedAtUnix = os.time(),
				Reason = reason,
				Scenario = table.clone(benchmark.Scenario),
				Campaign = if benchmark.Campaign ~= nil
					then {
						Id = benchmark.Campaign.Id,
						Label = benchmark.Campaign.Config.Label,
						Index = benchmark.CampaignIndex,
						Total = #benchmark.Campaign.Config.ScenarioIds,
					}
					else nil,
				RunId = benchmark.Session.RunId,
				-- Le seed de benchmark pilote la population, les positions et les tirs
				-- synthetiques. Le seed de run reste trace separatement pour retrouver
				-- la session Roblox qui a porte la campagne.
				Seed = PerformanceBaselineConfig.Seed,
				RunSeed = benchmark.Session.Seed,
				Environment = if RunService:IsStudio() then "Studio" else "Published",
				Server = telemetry,
				Client = {
					Metrics = getClientMetricsSummary(),
					Summary = clientSummary,
				},
		Network = {
			RealtimeKbpsAvailable = true,
			RequiredAttributionCapture = "MicroProfiler network or Developer Console",
				},
				Memory = {
					ServerBeforeMb = benchmark.ServerMemoryBeforeMb,
					ServerPeakMb = getMetricValue(telemetry, "Server.Memory.TotalMb", "Max"),
					ServerAfterCleanupMb = benchmark.ServerMemoryAfterCleanupMb,
					ServerAfterIdleMb = benchmark.ServerMemoryAfterIdleMb,
				},
				BenchmarkPolicy = {
					AdaptiveVfxLocked = PerformanceBaselineConfig.LockAdaptiveVfx == true,
					IdleObservationSeconds = PerformanceBaselineConfig.IdleObservationSeconds,
				},
			}

			local comparable, validationReason = getReportReproducibility(report)
			report.Reproducibility = {
				Comparable = comparable,
				ValidationReason = validationReason,
			}

			local export = buildScenarioExport(report)
			writeReportValue("LatestScenario", export)
			writeReportValue("Scenario_" .. benchmark.Scenario.Id, export)
			print("[MegaRoblox][P0_EXPORT] " .. export:gsub("\n", " | "))

			local monsterSimulationExport = buildMonsterSimulationExport(report)
			if monsterSimulationExport ~= nil then
				print("[MegaRoblox][P2_SIMULATION] " .. monsterSimulationExport:gsub("\n", " | "))
			end

			local projectileP3Export = buildProjectileP3Export(report)
			if projectileP3Export ~= nil then
				print("[MegaRoblox][P3_PROJECTILES] " .. projectileP3Export:gsub("\n", " | "))
			end

			latestReport = report
			activeBenchmark = nil
			clientSamplesByMetric = {}
			clientSummary = nil

			DebugLog.Info("Perf", "Rapport P0 serveur", {
				Scenario = benchmark.Scenario.Id,
				Reason = reason,
				Comparable = comparable,
				Validation = validationReason,
				HeartbeatP95Ms = secondsToMilliseconds(getMetricValue(telemetry, "Server.HeartbeatSeconds", "P95")),
				MonsterP95Ms = secondsToMilliseconds(getMetricValue(telemetry, "Monster.TickSeconds", "P95")),
				WeaponP95Ms = secondsToMilliseconds(getMetricValue(telemetry, "Weapon.TickSeconds", "P95")),
				RaycastP95Ms = secondsToMilliseconds(getMetricValue(telemetry, "WorldSpawn.RaycastSeconds", "P95")),
				Raycasts = getCounterValue(telemetry, "WorldSpawn.RaycastCount"),
				MonsterRaycastP95Ms = secondsToMilliseconds(getMetricValue(telemetry, "Monster.RaycastSeconds", "P95")),
				MonsterRaycasts = getCounterValue(telemetry, "Monster.RaycastCount"),
				XpMergeP95Ms = secondsToMilliseconds(getMetricValue(telemetry, "Xp.MergeSeconds", "P95")),
				CoinMergeP95Ms = secondsToMilliseconds(getMetricValue(telemetry, "Coin.MergeSeconds", "P95")),
			})
			DebugLog.Info("Perf", "Rapport P0 client", {
				Scenario = benchmark.Scenario.Id,
				FrameP50Ms = secondsToMilliseconds(report.Client.Summary and report.Client.Summary.FrameP50Seconds),
				FrameP95Ms = secondsToMilliseconds(report.Client.Summary and report.Client.Summary.FrameP95Seconds),
				FrameP99Ms = secondsToMilliseconds(report.Client.Summary and report.Client.Summary.FrameP99Seconds),
				FrameSpikes = report.Client.Summary and report.Client.Summary.FrameSpikeCount or 0,
				PhysicsP95Ms = secondsToMilliseconds(getClientMetric(report, "Client.PhysicsSeconds", "P95")),
				DrawCallsAverage = getClientMetric(report, "Client.DrawCalls", "Average"),
				TrianglesAverage = getClientMetric(report, "Client.Triangles", "Average"),
				InstancesP95 = getClientMetric(report, "Client.Instances", "P95"),
				RenderCpuP95Ms = secondsToMilliseconds(getClientMetric(report, "Client.RenderCpuSeconds", "P95")),
				RenderGpuP95Ms = secondsToMilliseconds(getClientMetric(report, "Client.RenderGpuSeconds", "P95")),
				VfxParticlesP95 = getClientMetric(report, "Client.Vfx.ParticleEmitters", "P95"),
				VfxLightsP95 = getClientMetric(report, "Client.Vfx.Lights", "P95"),
			})
			DebugLog.Info("Perf", "Rapport P0 memoire", {
				Scenario = benchmark.Scenario.Id,
				ServerBeforeMb = report.Memory.ServerBeforeMb,
				ServerPeakMb = report.Memory.ServerPeakMb,
				ServerAfterCleanupMb = report.Memory.ServerAfterCleanupMb,
				ServerAfterIdleMb = report.Memory.ServerAfterIdleMb,
				ClientBeforeMb = report.Client.Summary and report.Client.Summary.MemoryBeforeMb,
				ClientPeakMb = report.Client.Summary and report.Client.Summary.MemoryPeakMb,
				ClientAfterCleanupMb = report.Client.Summary and report.Client.Summary.MemoryAfterCleanupMb,
				ClientAfterIdleMb = report.Client.Summary and report.Client.Summary.MemoryAfterIdleMb,
				Network = "Capture MicroProfiler requise",
			})

			local campaign = benchmark.Campaign
			if campaign ~= nil and activeCampaign == campaign then
				table.insert(campaign.Reports, report)
				campaign.LastBenchmark = benchmark

				if campaign.StopRequested then
					finishCampaign(campaign, reason, benchmark)
				else
					publishStatus(benchmark, "CampaignTransition", {
						Reason = reason,
						ReportReady = true,
					})

					task.delay(PerformanceBaselineConfig.InterScenarioSeconds, function()
						startCampaignNextScenario(campaign)
					end)
				end
			else
				cleanupBenchmark(benchmark, false)
				publishStatus(benchmark, "Completed", {
					Reason = reason,
					ReportReady = true,
				})
			end
		end)
	end)
end

local function startProjectileCadence(benchmark)
	local burstCount = math.max(0, math.floor(benchmark.Scenario.ProjectileBurst or 0))
	local intervalSeconds = tonumber(benchmark.Scenario.ProjectileBurstIntervalSeconds)

	if burstCount <= 0 then
		return
	end

	local function fireBurst()
		if activeBenchmark ~= benchmark or benchmark.Phase ~= "Measuring" then
			return false
		end

		local targetPositions = benchmark.ProjectileTargetPositions

		if targetPositions ~= nil and #targetPositions > 0 then
			WeaponService.DebugFireballBurstAtPositions(
				benchmark.Owner,
				targetPositions,
				burstCount,
				benchmark.Scenario.ProjectilePresentationMode
			)
		else
			WeaponService.DebugFireballBurst(benchmark.Owner, burstCount)
		end

		return true
	end

	if not fireBurst() or intervalSeconds == nil or intervalSeconds <= 0 then
		return
	end

	task.spawn(function()
		while activeBenchmark == benchmark and benchmark.Phase == "Measuring" do
			task.wait(intervalSeconds)

			if not fireBurst() then
				return
			end
		end
	end)
end

local function beginMeasurement(benchmark)
	if activeBenchmark ~= benchmark then
		return
	end

	benchmark.Phase = "Measuring"
	PerformanceTelemetryService.Reset()
	clientSamplesByMetric = {}
	clientSummary = nil
	serverSampleElapsed = 0
	publishStatus(benchmark, "Measuring")

	startProjectileCadence(benchmark)

	task.delay(PerformanceBaselineConfig.MeasurementSeconds, function()
		finishBenchmark(benchmark, "Completed")
	end)
end

local function startBenchmark(player, scenarioId, campaign)
	if activeBenchmark ~= nil then
		return false, "Un benchmark P0 est deja en cours"
	end

	if campaign == nil and activeCampaign ~= nil then
		return false, "Une campagne P0 est deja en cours"
	end

	if campaign ~= nil and activeCampaign ~= campaign then
		return false, "Campagne P0 invalide"
	end

	if #Players:GetPlayers() ~= 1 then
		return false, "P0 exige une session solo pour conserver une baseline comparable"
	end

	if not RunStateService.IsRunActive(player) then
		return false, "Lance d'abord une run avant le benchmark P0"
	end

	local scenario = PerformanceBaselineConfig.GetScenario(scenarioId)
	local session = RunSessionService.GetCurrentSession(player)
	local benchmarkRoot, arena, playerStart, simulationCenter = getBenchmarkInstances()
	local root = getCharacterRoot(player)
	local remoteEvents, remoteFunctions = countRemoteTopology()

	if scenario == nil or session == nil or benchmarkRoot == nil or root == nil then
		return false, "Configuration P0 incomplete"
	end

	local originalMap = if campaign ~= nil and campaign.OriginalMap ~= nil then campaign.OriginalMap else RunMapService.GetActiveMap()
	local originalCharacterCFrame = if campaign ~= nil and campaign.OriginalCharacterCFrame ~= nil
		then campaign.OriginalCharacterCFrame
		else root.CFrame
	local benchmark = {
		Id = ("P0-%d-%d"):format(player.UserId, math.floor(os.clock() * 1000)),
		Owner = player,
		Scenario = scenario,
		Campaign = campaign,
		CampaignIndex = if campaign ~= nil then campaign.NextScenarioIndex else nil,
		Session = session,
		BenchmarkRoot = benchmarkRoot,
		Arena = arena,
		SimulationCenter = simulationCenter,
		OriginalMap = originalMap,
		OriginalCharacterCFrame = originalCharacterCFrame,
		ServerMemoryBeforeMb = readNumber(function()
			return Stats:GetTotalMemoryUsageMb()
		end),
		RemoteEvents = remoteEvents,
		RemoteFunctions = remoteFunctions,
		LastClientSampleAt = 0,
		StartedAt = os.clock(),
		Phase = "Warmup",
	}

	benchmark.ArenaSurfaceState = if campaign ~= nil then campaign.ArenaSurfaceState else nil
	if benchmark.ArenaSurfaceState == nil then
		benchmark.ArenaSurfaceState = applyArenaSurfaceState(benchmarkRoot, arena, true)
	end
	if benchmark.ArenaSurfaceState == nil then
		return false, "Sol P0 introuvable"
	end

	if campaign ~= nil then
		campaign.ArenaSurfaceState = benchmark.ArenaSurfaceState
		campaign.OriginalMap = originalMap
		campaign.OriginalCharacterCFrame = originalCharacterCFrame
		campaign.LastBenchmark = benchmark
	end

	MonsterService.ClearAllMonsters("PerformanceBaselinePreparation")
	WeaponService.ClearProjectilesForBenchmark()
	XpService.ClearRunGems()
	CoinService.ClearRunCoins()
	MonsterService.SetBenchmarkMode(true)
	MonsterService.SetBenchmarkSeed(PerformanceBaselineConfig.Seed)
	WorldSpawnService.SetRunContext(arena, PerformanceBaselineConfig.Seed, simulationCenter.Position)
	root:PivotTo(playerStart.CFrame + Vector3.new(0, 3, 0))
	spawnProjectileTargets(benchmark, root)

	local spawnedCount = 0
	if (scenario.MonsterCount or 0) > 0 then
		spawnedCount = select(1, MonsterService.DebugSpawnMonstersNearPlayer(player, scenario.MonsterCount))
	end

	spawnCollectibles(benchmark)
	activeBenchmark = benchmark
	PerformanceTelemetryService.Begin(benchmark.Id)
	publishStatus(benchmark, "Warmup", {
		RequestedMonsters = scenario.MonsterCount or 0,
		SpawnedMonsters = spawnedCount,
	})

	DebugLog.Info("Perf", "Benchmark P0 demarre", {
		Scenario = scenario.Id,
		RequestedMonsters = scenario.MonsterCount or 0,
		SpawnedMonsters = spawnedCount,
		ProjectileBurst = scenario.ProjectileBurst or 0,
		ProjectileBurstIntervalSeconds = scenario.ProjectileBurstIntervalSeconds,
		ProjectileTargets = scenario.ProjectileTargetCount or 0,
		XpGems = scenario.XpGemCount or 0,
		Coins = scenario.CoinCount or 0,
		Seed = PerformanceBaselineConfig.Seed,
		CampaignId = if campaign ~= nil then campaign.Id else nil,
		CampaignIndex = if campaign ~= nil then benchmark.CampaignIndex else nil,
		CampaignTotal = if campaign ~= nil then #campaign.Config.ScenarioIds else nil,
	})

	task.delay(PerformanceBaselineConfig.WarmupSeconds, function()
		beginMeasurement(benchmark)
	end)

	return true, ("P0 %s : chauffe %ds, mesure %ds"):format(
		scenario.Label,
		PerformanceBaselineConfig.WarmupSeconds,
		PerformanceBaselineConfig.MeasurementSeconds
	)
end

function PerformanceBenchmarkService.StartScenario(player, scenarioId)
	return startBenchmark(player, scenarioId)
end

finishCampaign = function(campaign, reason, benchmark)
	if activeCampaign ~= campaign then
		return
	end

	local cleanupSource = benchmark or campaign.LastBenchmark
	if cleanupSource ~= nil then
		cleanupBenchmark(cleanupSource, false)
	end

	campaign.FinishedAt = os.clock()
	campaign.ServerMemoryAfterCampaignMb = readNumber(function()
		return Stats:GetTotalMemoryUsageMb()
	end)
	latestCampaignReport = {
		Version = "P0.4",
		CampaignId = campaign.Id,
		CampaignLabel = campaign.Config.Label,
		RunId = campaign.Session and campaign.Session.RunId or nil,
		Seed = PerformanceBaselineConfig.Seed,
		Environment = if RunService:IsStudio() then "Studio" else "Published",
		Reason = reason,
		StartedAtUnix = campaign.StartedAtUnix,
		FinishedAtUnix = os.time(),
		ScenarioCount = #campaign.Config.ScenarioIds,
		CompletedScenarioCount = #campaign.Reports,
		DurationSeconds = campaign.FinishedAt - campaign.StartedAt,
		Memory = {
			ServerBeforeCampaignMb = campaign.ServerMemoryBeforeCampaignMb,
			ServerAfterCampaignMb = campaign.ServerMemoryAfterCampaignMb,
		},
		Reports = table.clone(campaign.Reports),
	}
	activeCampaign = nil

	local campaignLines = {
		"P0_CAMPAGNE",
		"id=" .. campaign.Id,
		"raison=" .. reason,
		"scenarios=" .. tostring(#campaign.Reports) .. "/" .. tostring(#campaign.Config.ScenarioIds),
		"duree_s=" .. formatNumber(latestCampaignReport.DurationSeconds),
		"memoire_serveur_avant_mb=" .. formatNumber(campaign.ServerMemoryBeforeCampaignMb),
		"memoire_serveur_apres_mb=" .. formatNumber(campaign.ServerMemoryAfterCampaignMb),
	}

	for _, report in ipairs(campaign.Reports) do
		local comparable, validationReason = getReportReproducibility(report)
		table.insert(campaignLines, table.concat({
			"scenario=" .. report.Scenario.Id,
			"comparable=" .. tostring(comparable),
			"validation=" .. validationReason,
			"frame_p95_ms=" .. formatNumber(secondsToMilliseconds(report.Client.Summary and report.Client.Summary.FrameP95Seconds)),
			"monstre_p95_ms=" .. formatNumber(secondsToMilliseconds(getMetricValue(report.Server, "Monster.TickSeconds", "P95"))),
		}, " "))
	end

	local campaignExport = table.concat(campaignLines, "\n")
	writeReportValue("LatestCampaign", campaignExport)
	writeReportValue("Campaign_" .. campaign.Id, campaignExport)
	print("[MegaRoblox][P0_EXPORT] " .. campaignExport:gsub("\n", " | "))

	if cleanupSource ~= nil then
		publishStatus(cleanupSource, "Completed", {
			Reason = reason,
			ReportReady = true,
			CampaignCompleted = true,
			CampaignCompletedScenarios = #campaign.Reports,
		})
	end

	DebugLog.Info("Perf", "Rapport campagne P0", {
		Campaign = campaign.Id,
		Reason = reason,
		CompletedScenarios = #campaign.Reports,
		RequestedScenarios = #campaign.Config.ScenarioIds,
		DurationSeconds = latestCampaignReport.DurationSeconds,
		ServerBeforeMb = campaign.ServerMemoryBeforeCampaignMb,
		ServerAfterMb = campaign.ServerMemoryAfterCampaignMb,
		ExplorerReport = PerformanceBaselineConfig.ReportFolderName .. "/LatestCampaign",
	})
end

startCampaignNextScenario = function(campaign)
	if activeCampaign ~= campaign or campaign.StopRequested then
		return
	end

	if campaign.NextScenarioIndex > #campaign.Config.ScenarioIds then
		finishCampaign(campaign, "Completed", campaign.LastBenchmark)
		return
	end

	local scenarioId = campaign.Config.ScenarioIds[campaign.NextScenarioIndex]
	local success, message = startBenchmark(campaign.Owner, scenarioId, campaign)

	if not success then
		campaign.StopRequested = true
		DebugLog.Warn("Perf", "Campagne P0 interrompue", {
			Campaign = campaign.Id,
			ScenarioId = scenarioId,
			Reason = message,
		})
		finishCampaign(campaign, "ScenarioStartFailed", campaign.LastBenchmark)
		return
	end

	campaign.NextScenarioIndex += 1
end

function PerformanceBenchmarkService.StartCampaign(player, campaignId)
	if activeBenchmark ~= nil or activeCampaign ~= nil then
		return false, "Un benchmark P0 est deja en cours"
	end

	local campaignConfig = PerformanceBaselineConfig.GetCampaign(campaignId)
	if campaignConfig == nil or #campaignConfig.ScenarioIds == 0 then
		return false, "Campagne P0 inconnue ou vide"
	end

	for _, scenarioId in ipairs(campaignConfig.ScenarioIds) do
		if PerformanceBaselineConfig.GetScenario(scenarioId) == nil then
			return false, "Campagne P0 invalide : scenario absent " .. scenarioId
		end
	end

	local session = RunSessionService.GetCurrentSession(player)
	if session == nil or not RunStateService.IsRunActive(player) then
		return false, "Lance d'abord une run avant la campagne P0"
	end

	activeCampaign = {
		Id = ("P0C-%d-%d"):format(player.UserId, math.floor(os.clock() * 1000)),
		Config = campaignConfig,
		Owner = player,
		Session = session,
		StartedAt = os.clock(),
		StartedAtUnix = os.time(),
		NextScenarioIndex = 1,
		Reports = {},
		ServerMemoryBeforeCampaignMb = readNumber(function()
			return Stats:GetTotalMemoryUsageMb()
		end),
		StopRequested = false,
	}

	startCampaignNextScenario(activeCampaign)

	if activeBenchmark == nil then
		return false, "Campagne P0 impossible a demarrer"
	end

	return true, ("%s : %d scenarios enchaines"):format(campaignConfig.Label, #campaignConfig.ScenarioIds)
end

function PerformanceBenchmarkService.StartSelection(player, selectionId)
	if PerformanceBaselineConfig.GetScenario(selectionId) ~= nil then
		return PerformanceBenchmarkService.StartScenario(player, selectionId)
	end

	if PerformanceBaselineConfig.GetCampaign(selectionId) ~= nil then
		return PerformanceBenchmarkService.StartCampaign(player, selectionId)
	end

	return false, "Selection P0 inconnue"
end

function PerformanceBenchmarkService.StopScenario(player)
	if activeBenchmark == nil and activeCampaign == nil then
		return false, "Aucun benchmark P0 actif"
	end

	local owner = if activeBenchmark ~= nil then activeBenchmark.Owner else activeCampaign.Owner
	if owner ~= player then
		return false, "Seul le lanceur peut arreter le benchmark P0"
	end

	if activeCampaign ~= nil then
		activeCampaign.StopRequested = true
	end

	if activeBenchmark ~= nil then
		finishBenchmark(activeBenchmark, "StoppedByAdmin")
	else
		finishCampaign(activeCampaign, "StoppedByAdmin", activeCampaign.LastBenchmark)
	end
	return true, "Arret P0 demande, nettoyage puis rapport"
end

function PerformanceBenchmarkService.GetLatestReport()
	return latestReport
end

function PerformanceBenchmarkService.GetLatestCampaignReport()
	return latestCampaignReport
end

function PerformanceBenchmarkService.Start()
	if isStarted then
		return
	end

	isStarted = true
	RunService.Heartbeat:Connect(function(deltaTime)
		if activeBenchmark == nil or activeBenchmark.Phase ~= "Measuring" then
			return
		end

		PerformanceTelemetryService.Record("Server.HeartbeatSeconds", deltaTime, PerformanceBaselineConfig.MaximumSamplesPerMetric)
		serverSampleElapsed += deltaTime

		if serverSampleElapsed >= PerformanceBaselineConfig.SampleInterval then
			serverSampleElapsed = 0
			recordServerSample()
		end
	end)

	clientSampleRemote.OnServerEvent:Connect(function(player, payload)
		local benchmark = activeBenchmark
		if benchmark == nil or benchmark.Owner ~= player or typeof(payload) ~= "table" then
			return
		end

		if payload.BenchmarkId ~= benchmark.Id then
			return
		end

		if payload.Kind == "Summary" and typeof(payload.Summary) == "table" then
			clientSummary = payload.Summary
			return
		end

		if benchmark.Phase ~= "Measuring" or payload.Kind ~= "Sample" or typeof(payload.Metrics) ~= "table" then
			return
		end

		local now = os.clock()
		if now - benchmark.LastClientSampleAt < PerformanceBaselineConfig.SampleInterval * 0.8 then
			return
		end
		benchmark.LastClientSampleAt = now

		for metricName, value in pairs(payload.Metrics) do
			if typeof(metricName) == "string" and typeof(value) == "number" and value == value
				and math.abs(value) < 100000000
			then
				local samples = clientSamplesByMetric[metricName]
				if samples == nil then
					samples = {}
					clientSamplesByMetric[metricName] = samples
				end

				if #samples < PerformanceBaselineConfig.MeasurementSeconds + 8 then
					table.insert(samples, value)
				end
			end
		end
	end)

	RunStateService.RunEnded:Connect(function(player)
		if activeCampaign ~= nil and activeCampaign.Owner == player then
			activeCampaign.StopRequested = true
		end

		if activeBenchmark ~= nil and activeBenchmark.Owner == player then
			finishBenchmark(activeBenchmark, "RunEnded")
		elseif activeCampaign ~= nil and activeCampaign.Owner == player then
			finishCampaign(activeCampaign, "RunEnded", activeCampaign.LastBenchmark)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		if activeBenchmark ~= nil and activeBenchmark.Owner == player then
			cleanupBenchmark(activeBenchmark, false)
			PerformanceTelemetryService.Finish()
			activeBenchmark = nil
			activeCampaign = nil
		elseif activeCampaign ~= nil and activeCampaign.Owner == player then
			activeCampaign = nil
		end
	end)

	DebugLog.Info("Perf", "PerformanceBenchmarkService demarre", {
		Scenarios = #PerformanceBaselineConfig.Scenarios,
		Campaigns = #PerformanceBaselineConfig.Campaigns,
		WarmupSeconds = PerformanceBaselineConfig.WarmupSeconds,
		MeasurementSeconds = PerformanceBaselineConfig.MeasurementSeconds,
		IdleObservationSeconds = PerformanceBaselineConfig.IdleObservationSeconds,
	})
end

return PerformanceBenchmarkService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="78">
        <Properties>
          <string name="Name">PerformanceTelemetryService</string>
          <string name="Source"><![CDATA[-- Collecteur volontairement petit et inactif hors campagne P0.

local PerformanceTelemetryService = {}

local isCapturing = false
local captureId = nil
local startedAt = nil
local samplesByMetric = {}
local countersByMetric = {}

local function getOrCreateSamples(metricName)
	local samples = samplesByMetric[metricName]

	if samples == nil then
		samples = {}
		samplesByMetric[metricName] = samples
	end

	return samples
end

local function percentile(sortedSamples, percentileValue)
	if #sortedSamples == 0 then
		return nil
	end

	local index = math.clamp(math.ceil(#sortedSamples * percentileValue), 1, #sortedSamples)
	return sortedSamples[index]
end

local function summarizeSamples(samples)
	if #samples == 0 then
		return nil
	end

	local sortedSamples = table.clone(samples)
	table.sort(sortedSamples)
	local total = 0

	for _, value in ipairs(sortedSamples) do
		total += value
	end

	return {
		Count = #sortedSamples,
		Min = sortedSamples[1],
		Average = total / #sortedSamples,
		Max = sortedSamples[#sortedSamples],
		P50 = percentile(sortedSamples, 0.5),
		P95 = percentile(sortedSamples, 0.95),
		P99 = percentile(sortedSamples, 0.99),
	}
end

function PerformanceTelemetryService.IsCapturing()
	return isCapturing
end

function PerformanceTelemetryService.Begin(nextCaptureId)
	isCapturing = true
	captureId = nextCaptureId
	startedAt = os.clock()
	samplesByMetric = {}
	countersByMetric = {}
end

function PerformanceTelemetryService.Reset()
	if not isCapturing then
		return
	end

	startedAt = os.clock()
	samplesByMetric = {}
	countersByMetric = {}
end

function PerformanceTelemetryService.Record(metricName, value, maximumSamples)
	if not isCapturing or typeof(metricName) ~= "string" or typeof(value) ~= "number" then
		return
	end

	if value ~= value or value == math.huge or value == -math.huge then
		return
	end

	local samples = getOrCreateSamples(metricName)

	if #samples < (maximumSamples or 7200) then
		table.insert(samples, value)
	end
end

function PerformanceTelemetryService.Increment(metricName, amount)
	if not isCapturing or typeof(metricName) ~= "string" then
		return
	end

	countersByMetric[metricName] = (countersByMetric[metricName] or 0) + (amount or 1)
end

function PerformanceTelemetryService.Finish()
	if not isCapturing then
		return nil
	end

	local metrics = {}

	for metricName, samples in pairs(samplesByMetric) do
		metrics[metricName] = summarizeSamples(samples)
	end

	local result = {
		CaptureId = captureId,
		DurationSeconds = if startedAt ~= nil then os.clock() - startedAt else 0,
		Metrics = metrics,
		Counters = table.clone(countersByMetric),
	}

	isCapturing = false
	captureId = nil
	startedAt = nil
	samplesByMetric = {}
	countersByMetric = {}

	return result
end

return PerformanceTelemetryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="79">
        <Properties>
          <string name="Name">PerkService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local PerkConfig = require(Shared:WaitForChild("PerkConfig"))
local Perks = require(Shared:WaitForChild("Perks"))

local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local CommerceService = require(script.Parent:WaitForChild("CommerceService"))
local GameplayFeedbackService = require(script.Parent:WaitForChild("GameplayFeedbackService"))
local JumpBonusService = require(script.Parent:WaitForChild("JumpBonusService"))
local RunAnalyticsService = require(script.Parent:WaitForChild("RunAnalyticsService"))
local RunActionCreditService = require(script.Parent:WaitForChild("RunActionCreditService"))

local PerkService = {}

local rng = Random.new()
local profilesByUserId = {}
local characterConnectionsByUserId = {}
local baseWalkSpeedByUserId = {}
local baseMaxHealthByUserId = {}
local isStarted = false

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local showChoicesRemote = getOrCreateRemote("Perk_ShowChoices")
local hideChoicesRemote = getOrCreateRemote("Perk_HideChoices")
local selectChoiceRemote = getOrCreateRemote("Perk_SelectChoice")
local rerollChoiceRemote = getOrCreateRemote("Perk_RerollRequest")
local passChoiceRemote = getOrCreateRemote("Perk_PassRequest")
local banChoiceRemote = getOrCreateRemote("Perk_BanRequest")
local updatePerksRemote = getOrCreateRemote("Perk_UpdateStats")

local function createEmptyStats()
	return {
		MoveSpeedPercent = 0,
		JumpPercent = 0,
		AttackSpeedPercent = 0,
		ProjectileCount = 0,
		CollectRadius = 0,
		DamagePercent = 0,
		ProjectileSpeedPercent = 0,
		EffectDurationPercent = 0,
		BounceCount = 0,
		CritChance = 0,
		CritMultiplierBonus = 0,
		LifeStealPercent = 0,
		HealthRegen = 0,
		MaxHealthBonus = 0,
		Shield = 0,
		XpGainPercent = 0,
		GoldGainPercent = 0,
		Luck = 0,
		ArmorPercent = 0,
		EnemyCountPercent = 0,
		FlatDamage = 0,
		EliteFlatDamage = 0,
	}
end

local function getPauseReason(player)
	return "PerkChoice_" .. player.UserId
end

local function getOrCreateProfile(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		profile = {
			Stats = createEmptyStats(),
			StacksByPerkId = {},
			PendingLevels = {},
			ActiveChoice = nil,
			NextChoiceId = 0,
			CurrentShield = 0,
			XpRemainder = 0,
			GoldRemainder = 0,
			RerollsUsedThisRun = 0,
			IsRerollPending = false,
			BannedPerkIds = {},
		}
		profilesByUserId[player.UserId] = profile
	end

	return profile
end

local function getRerollUsesThisRun(profile)
	return math.clamp(
		math.floor(tonumber(profile.RerollsUsedThisRun) or 0),
		0,
		PerkConfig.MaxRerollsPerRun
	)
end

local function publishRerollUsesThisRun(player, profile)
	if player.Parent ~= Players then
		return
	end

	player:SetAttribute("PerkRerollsUsedThisRun", getRerollUsesThisRun(profile))
	player:SetAttribute("PerkRerollsMaxUses", PerkConfig.MaxRerollsPerRun)
end

local function getHumanoid(player)
	local character = player.Character

	if character == nil then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function disableNativeHealthRegen(character)
	task.defer(function()
		local healthScript = character:FindFirstChild("Health")

		if healthScript == nil then
			healthScript = character:WaitForChild("Health", 2)
		end

		if healthScript ~= nil and (healthScript:IsA("Script") or healthScript:IsA("LocalScript")) then
			healthScript.Disabled = true
		end
	end)
end

local function applyMovementStats(player)
	local humanoid = getHumanoid(player)

	if humanoid == nil then
		return
	end

	if baseWalkSpeedByUserId[player.UserId] == nil then
		baseWalkSpeedByUserId[player.UserId] = CombatConfig.PlayerBaseWalkSpeed
	end

	local profile = getOrCreateProfile(player)
	local moveMultiplier = 1 + profile.Stats.MoveSpeedPercent
	local jumpMultiplier = 1 + profile.Stats.JumpPercent

	humanoid.WalkSpeed = baseWalkSpeedByUserId[player.UserId] * moveMultiplier
	JumpBonusService.SetExternalJumpMultiplier(player, jumpMultiplier)
end

local function applyMaxHealthStats(player)
	local humanoid = getHumanoid(player)

	if humanoid == nil then
		return
	end

	local profile = getOrCreateProfile(player)
	local baseMaxHealth = baseMaxHealthByUserId[player.UserId]

	if baseMaxHealth == nil then
		baseMaxHealth = math.max(1, humanoid.MaxHealth)
		baseMaxHealthByUserId[player.UserId] = baseMaxHealth
	end

	local targetMaxHealth = math.max(1, baseMaxHealth + (profile.Stats.MaxHealthBonus or 0))
	humanoid.MaxHealth = targetMaxHealth
	humanoid.Health = math.min(humanoid.Health, targetMaxHealth)
end

local function getDisplayStatsSnapshot(player, profile)
	local stats = profile.Stats
	local humanoid = getHumanoid(player)
	local damageMultiplier = 1 + (stats.DamagePercent or 0)
	local attackCooldown = math.max(
		0.08,
		CombatConfig.FireballCooldown / math.max(0.1, 1 + (stats.AttackSpeedPercent or 0))
	)
	local baseDamage = (CombatConfig.FireballDamage + (stats.FlatDamage or 0)) * damageMultiplier
	local eliteDamage = (CombatConfig.FireballDamage + (stats.FlatDamage or 0) + (stats.EliteFlatDamage or 0))
		* damageMultiplier

	return {
		MaxHealth = if humanoid ~= nil then humanoid.MaxHealth else 100,
		MoveSpeed = if humanoid ~= nil then humanoid.WalkSpeed else CombatConfig.PlayerBaseWalkSpeed,
		JumpMode = if humanoid == nil or humanoid.UseJumpPower then "Power" else "Height",
		JumpValue = if humanoid ~= nil
			then (if humanoid.UseJumpPower then humanoid.JumpPower else humanoid.JumpHeight)
			else CombatConfig.PlayerBaseJumpPower,
		CurrentShield = profile.CurrentShield,
		MaxShield = stats.Shield or 0,
		HealthRegen = stats.HealthRegen or 0,
		ArmorPercent = math.clamp(stats.ArmorPercent or 0, 0, 0.8),
		LifeStealPercent = stats.LifeStealPercent or 0,
		CritChance = math.clamp(stats.CritChance or 0, 0, 1),
		CritDamageMultiplier = 1.5 + (stats.CritMultiplierBonus or 0),
		BaseDamage = baseDamage,
		EliteDamage = eliteDamage,
		AttackRate = 1 / attackCooldown,
		ProjectileCount = math.clamp(1 + math.floor(stats.ProjectileCount or 0), 1, 24),
		BounceCount = math.max(0, math.floor(stats.BounceCount or 0)),
		ProjectileSpeed = CombatConfig.FireballSpeed * (1 + (stats.ProjectileSpeedPercent or 0)),
		ProjectileDuration = CombatConfig.FireballLifetime * (1 + (stats.EffectDurationPercent or 0)),
		CollectRadius = CombatConfig.XpCollectDistance + (stats.CollectRadius or 0),
		XpMultiplier = 1 + (stats.XpGainPercent or 0),
		GoldMultiplier = 1 + (stats.GoldGainPercent or 0),
		Luck = stats.Luck or 0,
		EnemyMultiplier = math.max(1, 1 + (stats.EnemyCountPercent or 0)),
	}
end

local function sendPerkStats(player)
	local profile = getOrCreateProfile(player)

	updatePerksRemote:FireClient(player, {
		Stats = profile.Stats,
		DisplayStats = getDisplayStatsSnapshot(player, profile),
		CurrentShield = profile.CurrentShield,
		MaxShield = profile.Stats.Shield,
		StacksByPerkId = profile.StacksByPerkId,
	})
end

local function applyHealing(player, amount, feedbackKind)
	local humanoid = getHumanoid(player)

	if humanoid == nil or humanoid.Health <= 0 then
		return 0
	end

	local previousHealth = humanoid.Health
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + math.max(0, amount))
	local healedAmount = humanoid.Health - previousHealth

	if healedAmount > 0 then
		RunAnalyticsService.RecordHealing(player, healedAmount)
		GameplayFeedbackService.Queue(player, feedbackKind, healedAmount)
	end

	return healedAmount
end

local function applyHealthRegen(player, deltaTime)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		return
	end

	local healthRegen = profile.Stats.HealthRegen or 0

	if healthRegen <= 0 then
		return
	end

	local humanoid = getHumanoid(player)

	if humanoid == nil or humanoid.Health <= 0 or humanoid.Health >= humanoid.MaxHealth then
		return
	end

	applyHealing(player, healthRegen * deltaTime, "HealRegen")
end

local function getDefinitionById(perkId)
	for _, definition in ipairs(Perks.Definitions) do
		if definition.Id == perkId then
			return definition
		end
	end

	return nil
end

local function addStats(targetStats, addedStats)
	for statName, value in pairs(addedStats) do
		targetStats[statName] = (targetStats[statName] or 0) + value
	end
end

local PREVIEW_RULES = {
	{ StatName = "MoveSpeedPercent", Label = "Bonus vitesse", Format = "Percent" },
	{ StatName = "JumpPercent", Label = "Puissance saut", Format = "Percent" },
	{ StatName = "AttackSpeedPercent", Label = "Vitesse attaque", Format = "AttackRate" },
	{ StatName = "ProjectileCount", Label = "Projectiles", Format = "ProjectileCount" },
	{ StatName = "CollectRadius", Label = "Rayon recolte", Format = "CollectRadius" },
	{ StatName = "DamagePercent", Label = "Degats", Format = "Damage" },
	{ StatName = "ProjectileSpeedPercent", Label = "Vitesse projectile", Format = "ProjectileSpeed" },
	{ StatName = "EffectDurationPercent", Label = "Duree projectile", Format = "EffectDuration" },
	{ StatName = "BounceCount", Label = "Rebonds", Format = "Integer" },
	{ StatName = "CritChance", Label = "Chance critique", Format = "CritChance" },
	{ StatName = "CritMultiplierBonus", Label = "Degats critiques", Format = "CritMultiplier" },
	{ StatName = "LifeStealPercent", Label = "Vol de vie", Format = "Percent" },
	{ StatName = "HealthRegen", Label = "Regen PV", Format = "Regen" },
	{ StatName = "MaxHealthBonus", Label = "PV maximum", Format = "Integer" },
	{ StatName = "Shield", Label = "Bouclier", Format = "Shield" },
	{ StatName = "XpGainPercent", Label = "Gain XP", Format = "Multiplier" },
	{ StatName = "GoldGainPercent", Label = "Gain or", Format = "Multiplier" },
	{ StatName = "Luck", Label = "Chance", Format = "Percent" },
	{ StatName = "ArmorPercent", Label = "Armure", Format = "Armor" },
	{ StatName = "EnemyCountPercent", Label = "Plus d'ennemis", Format = "Multiplier" },
	{ StatName = "FlatDamage", Label = "Degats bruts", Format = "Integer" },
	{ StatName = "EliteFlatDamage", Label = "Degats elites", Format = "Integer" },
}

local function formatPreviewDecimal(value, decimals)
	local text = string.format("%." .. tostring(decimals) .. "f", value)

	return string.gsub(text, "%.", ",")
end

local function getPreviewValue(rule, stats, currentShield)
	local value = stats[rule.StatName] or 0

	if rule.Format == "ProjectileCount" then
		return math.clamp(1 + math.floor(value), 1, 24)
	end

	if rule.Format == "CollectRadius" then
		return CombatConfig.XpCollectDistance + value
	end

	if rule.Format == "AttackRate" then
		local cooldown = math.max(0.08, CombatConfig.FireballCooldown / math.max(0.1, 1 + value))

		return 1 / cooldown
	end

	if rule.Format == "Damage" then
		return (CombatConfig.FireballDamage + (stats.FlatDamage or 0)) * (1 + value)
	end

	if rule.Format == "ProjectileSpeed" then
		return CombatConfig.FireballSpeed * (1 + value)
	end

	if rule.Format == "EffectDuration" then
		return CombatConfig.FireballLifetime * (1 + value)
	end

	if rule.Format == "CritChance" then
		return math.clamp(value, 0, 1)
	end

	if rule.Format == "CritMultiplier" then
		return 1.5 + value
	end

	if rule.Format == "Shield" then
		return currentShield
	end

	if rule.Format == "Multiplier" then
		return 1 + value
	end

	if rule.Format == "Armor" then
		return math.clamp(value, 0, 0.8)
	end

	return value
end

local function formatPreviewValue(rule, value)
	if rule.Format == "Percent" or rule.Format == "CritChance" or rule.Format == "Armor" then
		return tostring(math.floor((value * 100) + 0.5)) .. "%"
	end

	if rule.Format == "CritMultiplier" then
		return tostring(math.floor((value * 100) + 0.5)) .. "%"
	end

	if rule.Format == "Multiplier" then
		return "x" .. formatPreviewDecimal(value, 2)
	end

	if rule.Format == "Regen" then
		return formatPreviewDecimal(value, 1) .. "/s"
	end

	if rule.Format == "CollectRadius" then
		return formatPreviewDecimal(value, 1)
	end

	if rule.Format == "AttackRate" then
		return formatPreviewDecimal(value, 2) .. "/s"
	end

	if rule.Format == "Damage" then
		return formatPreviewDecimal(value, 1)
	end

	if rule.Format == "ProjectileSpeed" then
		return tostring(math.floor(value + 0.5))
	end

	if rule.Format == "EffectDuration" then
		return formatPreviewDecimal(value, 1) .. "s"
	end

	return tostring(math.floor(value + 0.5))
end

local function createChoicePreview(profile, addedStats)
	local nextStats = table.clone(profile.Stats)
	addStats(nextStats, addedStats)

	local currentShield = profile.CurrentShield
	local nextShield = currentShield + (addedStats.Shield or 0)
	local previewLines = {}

	for _, rule in ipairs(PREVIEW_RULES) do
		if addedStats[rule.StatName] ~= nil then
			local currentValue = getPreviewValue(rule, profile.Stats, currentShield)
			local nextValue = getPreviewValue(rule, nextStats, nextShield)

			table.insert(previewLines, {
				Label = rule.Label,
				Current = formatPreviewValue(rule, currentValue),
				Next = formatPreviewValue(rule, nextValue),
			})
		end
	end

	return previewLines
end

local function pickRarity(player)
	local profile = getOrCreateProfile(player)
	local luck = math.max(0, profile.Stats.Luck or 0)
	local weightedRarities = {}
	local totalWeight = 0

	for _, rarityId in ipairs(Perks.RarityOrder) do
		local rarity = Perks.Rarities[rarityId]
		local weight = rarity.Weight

		if rarityId == "Rare" then
			weight += luck * 80
		elseif rarityId == "Epic" then
			weight += luck * 45
		elseif rarityId == "Legendary" then
			weight += luck * 20
		end

		totalWeight += weight
		table.insert(weightedRarities, {
			Id = rarityId,
			Weight = weight,
		})
	end

	local roll = rng:NextNumber(0, totalWeight)
	local cursor = 0

	for _, entry in ipairs(weightedRarities) do
		cursor += entry.Weight

		if roll <= cursor then
			return entry.Id
		end
	end

	return "Common"
end

local function createChoiceOption(definition, rarityId, optionIndex, profile)
	local rarity = Perks.Rarities[rarityId]
	local variant = definition.Variants[rarityId]
	local currentStacks = profile.StacksByPerkId[definition.Id] or 0

	return {
		OptionId = tostring(optionIndex),
		PerkId = definition.Id,
		Name = definition.Name,
		Description = variant.Description,
		Rarity = rarityId,
		RarityName = rarity.DisplayName,
		RarityColor = rarity.Color,
		Stats = variant.Stats,
		PreviewLines = createChoicePreview(profile, variant.Stats),
		CurrentStacks = currentStacks,
		NextStacks = currentStacks + 1,
	}
end

local function createChoice(player, level, title)
	local choices = {}
	local choicesByOptionId = {}
	local profile = getOrCreateProfile(player)
	local availableDefinitions = {}

	for _, definition in ipairs(Perks.Definitions) do
		if profile.BannedPerkIds[definition.Id] ~= true then
			table.insert(availableDefinitions, definition)
		end
	end

	for optionIndex = 1, 3 do
		if #availableDefinitions <= 0 then
			break
		end

		local definitionIndex = rng:NextInteger(1, #availableDefinitions)
		local definition = table.remove(availableDefinitions, definitionIndex)
		local rarityId = pickRarity(player)
		local option = createChoiceOption(definition, rarityId, optionIndex, profile)

		table.insert(choices, option)
		choicesByOptionId[option.OptionId] = option
	end

	profile.NextChoiceId += 1

	return {
		ChoiceId = tostring(player.UserId) .. "_" .. tostring(profile.NextChoiceId),
		Level = level,
		Title = title,
		Choices = choices,
		ChoicesByOptionId = choicesByOptionId,
	}
end

local function showNextChoice(player)
	if player.Parent ~= Players then
		return
	end

	local profile = getOrCreateProfile(player)

	if profile.ActiveChoice ~= nil then
		return
	end

	local nextRequest = table.remove(profile.PendingLevels, 1)

	if nextRequest == nil then
		CombatStateService.Resume(getPauseReason(player))
		hideChoicesRemote:FireClient(player)
		return
	end

	local nextLevel = nextRequest
	local title = nil

	if typeof(nextRequest) == "table" then
		nextLevel = nextRequest.Level
		title = nextRequest.Title
	end

	local choice = createChoice(player, nextLevel, title)
	profile.ActiveChoice = choice

	CombatStateService.Pause(getPauseReason(player))
	DebugLog.Info("Perks", "Choix de perk affiche", {
		Player = player.Name,
		Level = choice.Level,
		Title = choice.Title,
		ChoiceId = choice.ChoiceId,
		Choices = #choice.Choices,
	})
	showChoicesRemote:FireClient(player, {
		ChoiceId = choice.ChoiceId,
		Level = choice.Level,
		Title = choice.Title,
		Choices = choice.Choices,
	})
end

local function applyChoice(player, option)
	local profile = getOrCreateProfile(player)
	local definition = getDefinitionById(option.PerkId)

	if definition == nil then
		return
	end

	addStats(profile.Stats, option.Stats)
	profile.StacksByPerkId[option.PerkId] = (profile.StacksByPerkId[option.PerkId] or 0) + 1
	RunAnalyticsService.RecordPerkSelected(player)
	DebugLog.Info("Perks", "Perk applique", {
		Player = player.Name,
		PerkId = option.PerkId,
		Name = option.Name,
		Rarity = option.Rarity,
		Stacks = profile.StacksByPerkId[option.PerkId],
	})

	if option.Stats.Shield ~= nil then
		local shieldGained = math.max(0, option.Stats.Shield)
		profile.CurrentShield += shieldGained

		if shieldGained > 0 then
			GameplayFeedbackService.Queue(player, "Shield", shieldGained)
		end
	end

	applyMovementStats(player)
	sendPerkStats(player)
end

local function resolveActiveChoiceWithoutSelection(player, profile)
	profile.ActiveChoice = nil

	if #profile.PendingLevels > 0 then
		task.defer(function()
			showNextChoice(player)
		end)
	else
		CombatStateService.Resume(getPauseReason(player))
		hideChoicesRemote:FireClient(player)
	end
end

local function onChoiceSelected(player, choiceId, optionId)
	local profile = getOrCreateProfile(player)
	local activeChoice = profile.ActiveChoice

	if activeChoice == nil or activeChoice.ChoiceId ~= choiceId then
		return
	end

	local option = activeChoice.ChoicesByOptionId[tostring(optionId)]

	if option == nil then
		DebugLog.Warn("Perks", "Choix perk refuse, option inconnue", {
			Player = player.Name,
			ChoiceId = choiceId,
			OptionId = optionId,
		})
		return
	end

	DebugLog.Info("Perks", "Choix perk selectionne", {
		Player = player.Name,
		ChoiceId = choiceId,
		OptionId = optionId,
		PerkId = option.PerkId,
	})

	applyChoice(player, option)
	resolveActiveChoiceWithoutSelection(player, profile)
end

local function onPassRequested(player, choiceId)
	if typeof(choiceId) ~= "string" then
		return
	end

	local profile = getOrCreateProfile(player)
	local activeChoice = profile.ActiveChoice

	if activeChoice == nil or activeChoice.ChoiceId ~= choiceId then
		return
	end

	local consumed, reason = RunActionCreditService.TryConsume(player, "Pass")

	if not consumed then
		DebugLog.Warn("Perks", "Passer perk refuse", {
			Player = player.Name,
			ChoiceId = choiceId,
			Reason = reason,
		})
		return
	end

	DebugLog.Info("Perks", "Choix de perk passe", {
		Player = player.Name,
		ChoiceId = choiceId,
	})
	resolveActiveChoiceWithoutSelection(player, profile)
end

local function onBanRequested(player, choiceId, optionId)
	if typeof(choiceId) ~= "string" then
		return
	end

	local profile = getOrCreateProfile(player)
	local activeChoice = profile.ActiveChoice

	if activeChoice == nil or activeChoice.ChoiceId ~= choiceId then
		return
	end

	local option = activeChoice.ChoicesByOptionId[tostring(optionId)]

	if option == nil then
		DebugLog.Warn("Perks", "Bannissement perk refuse, option inconnue", {
			Player = player.Name,
			ChoiceId = choiceId,
			OptionId = optionId,
		})
		return
	end

	local consumed, reason = RunActionCreditService.TryConsume(player, "Ban")

	if not consumed then
		DebugLog.Warn("Perks", "Bannissement perk refuse", {
			Player = player.Name,
			ChoiceId = choiceId,
			PerkId = option.PerkId,
			Reason = reason,
		})
		return
	end

	profile.BannedPerkIds[option.PerkId] = true
	local replacementChoice = createChoice(player, activeChoice.Level, activeChoice.Title)

	if #replacementChoice.Choices == 0 then
		DebugLog.Warn("Perks", "Bannissement perk termine sans offre de remplacement", {
			Player = player.Name,
			PerkId = option.PerkId,
		})
		resolveActiveChoiceWithoutSelection(player, profile)
		return
	end

	profile.ActiveChoice = replacementChoice
	DebugLog.Info("Perks", "Perk banni pour la run", {
		Player = player.Name,
		PerkId = option.PerkId,
		PreviousChoiceId = choiceId,
		ChoiceId = replacementChoice.ChoiceId,
	})
	showChoicesRemote:FireClient(player, {
		ChoiceId = replacementChoice.ChoiceId,
		Level = replacementChoice.Level,
		Title = replacementChoice.Title,
		Choices = replacementChoice.Choices,
	})
end

local function onRerollRequested(player, choiceId)
	if typeof(choiceId) ~= "string" then
		return
	end

	local profile = getOrCreateProfile(player)
	local activeChoice = profile.ActiveChoice

	if activeChoice == nil or activeChoice.ChoiceId ~= choiceId then
		DebugLog.Warn("Perks", "Reroll perk refuse, choix inactif", {
			Player = player.Name,
			ChoiceId = choiceId,
		})
		return
	end

	if profile.IsRerollPending then
		return
	end

	if getRerollUsesThisRun(profile) >= PerkConfig.MaxRerollsPerRun then
		DebugLog.Warn("Perks", "Reroll perk refuse, limite de run atteinte", {
			Player = player.Name,
			ChoiceId = choiceId,
			MaxUses = PerkConfig.MaxRerollsPerRun,
		})
		return
	end

	-- Le verrou est pose avant la lecture DataStore. Il empeche trois requetes
	-- rapides du meme choix de consommer plusieurs credits en parallele.
	profile.IsRerollPending = true

	local consumed, reason = CommerceService.TryConsumePerkReroll(player)
	profile.IsRerollPending = false

	if not consumed then
		DebugLog.Warn("Perks", "Reroll perk refuse", {
			Player = player.Name,
			ChoiceId = choiceId,
			Reason = reason,
		})
		return
	end

	profile.RerollsUsedThisRun = getRerollUsesThisRun(profile) + 1
	publishRerollUsesThisRun(player, profile)

	local rerolledChoice = createChoice(player, activeChoice.Level, activeChoice.Title)
	profile.ActiveChoice = rerolledChoice

	DebugLog.Info("Perks", "Offre de perk relancee", {
		Player = player.Name,
		PreviousChoiceId = choiceId,
		ChoiceId = rerolledChoice.ChoiceId,
		Level = rerolledChoice.Level,
	})
	showChoicesRemote:FireClient(player, {
		ChoiceId = rerolledChoice.ChoiceId,
		Level = rerolledChoice.Level,
		Title = rerolledChoice.Title,
		Choices = rerolledChoice.Choices,
	})
end

function PerkService.SetupPlayer(player)
	DebugLog.Info("Perks", "Setup joueur perks", {
		Player = player.Name,
	})
	local profile = getOrCreateProfile(player)
	publishRerollUsesThisRun(player, profile)

	if characterConnectionsByUserId[player.UserId] ~= nil then
		characterConnectionsByUserId[player.UserId]:Disconnect()
	end

	characterConnectionsByUserId[player.UserId] = player.CharacterAdded:Connect(function(character)
		baseWalkSpeedByUserId[player.UserId] = nil
		baseMaxHealthByUserId[player.UserId] = nil
		disableNativeHealthRegen(character)
		character:WaitForChild("Humanoid", 5)
		applyMovementStats(player)
		applyMaxHealthStats(player)
		sendPerkStats(player)
	end)

	if player.Character ~= nil then
		disableNativeHealthRegen(player.Character)
	end

	applyMovementStats(player)
	applyMaxHealthStats(player)
	sendPerkStats(player)
end

function PerkService.RemovePlayer(player)
	CombatStateService.Resume(getPauseReason(player))
	hideChoicesRemote:FireClient(player)
	JumpBonusService.SetExternalJumpMultiplier(player, 1)

	local connection = characterConnectionsByUserId[player.UserId]

	if connection ~= nil then
		connection:Disconnect()
	end

	characterConnectionsByUserId[player.UserId] = nil
	baseWalkSpeedByUserId[player.UserId] = nil
	baseMaxHealthByUserId[player.UserId] = nil
	profilesByUserId[player.UserId] = nil
end

function PerkService.ResetRun(player)
	local profile = getOrCreateProfile(player)

	CombatStateService.Resume(getPauseReason(player))
	profile.Stats = createEmptyStats()
	profile.StacksByPerkId = {}
	profile.PendingLevels = {}
	profile.ActiveChoice = nil
	profile.NextChoiceId = 0
	profile.CurrentShield = 0
	profile.XpRemainder = 0
	profile.GoldRemainder = 0
	profile.RerollsUsedThisRun = 0
	profile.IsRerollPending = false
	profile.BannedPerkIds = {}
	publishRerollUsesThisRun(player, profile)
	hideChoicesRemote:FireClient(player)
	applyMovementStats(player)
	applyMaxHealthStats(player)
	sendPerkStats(player)
end

function PerkService.QueueLevelUp(player, level)
	local profile = getOrCreateProfile(player)

	table.insert(profile.PendingLevels, level)
	DebugLog.Info("Perks", "Level-up ajoute a la file perks", {
		Player = player.Name,
		Level = level,
		PendingCount = #profile.PendingLevels,
	})
	showNextChoice(player)
end

function PerkService.QueueBonusChoice(player, title)
	local profile = getOrCreateProfile(player)

	table.insert(profile.PendingLevels, {
		Level = title or "Bonus",
		Title = title or "Choix de perk",
	})
	DebugLog.Info("Perks", "Choix bonus ajoute a la file perks", {
		Player = player.Name,
		Title = title,
		PendingCount = #profile.PendingLevels,
	})
	showNextChoice(player)
end

function PerkService.GetStats(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		return createEmptyStats()
	end

	return profile.Stats
end

function PerkService.GetRunPerkCount(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		return 0
	end

	local count = 0

	for _, stackCount in pairs(profile.StacksByPerkId) do
		count += math.max(0, math.floor(stackCount or 0))
	end

	return count
end

function PerkService.GetRunBuild(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		return {
			WeaponId = CombatConfig.FireballTemplateName,
			Perks = {},
			Stats = createEmptyStats(),
		}
	end

	local perks = {}

	for perkId, stacks in pairs(profile.StacksByPerkId) do
		table.insert(perks, {
			Id = tostring(perkId),
			Stacks = math.max(0, math.floor(stacks or 0)),
		})
	end

	table.sort(perks, function(left, right)
		return left.Id < right.Id
	end)

	return {
		WeaponId = CombatConfig.FireballTemplateName,
		Perks = perks,
		Stats = table.clone(profile.Stats),
	}
end

function PerkService.GetProjectileCount(player)
	local stats = PerkService.GetStats(player)

	return math.clamp(1 + math.floor(stats.ProjectileCount or 0), 1, 24)
end

function PerkService.GetAttackCooldown(player, baseCooldown)
	local stats = PerkService.GetStats(player)
	local attackSpeedMultiplier = math.max(0.1, 1 + (stats.AttackSpeedPercent or 0))

	return math.max(0.08, baseCooldown / attackSpeedMultiplier)
end

function PerkService.GetProjectileSpeed(player, baseSpeed)
	local stats = PerkService.GetStats(player)

	return baseSpeed * (1 + (stats.ProjectileSpeedPercent or 0))
end

function PerkService.GetAttackDuration(player, baseDuration)
	return PerkService.GetEffectDuration(player, baseDuration)
end

function PerkService.GetEffectDuration(player, baseDuration)
	local stats = PerkService.GetStats(player)

	return baseDuration * (1 + (stats.EffectDurationPercent or 0))
end

function PerkService.ApplyRunItemStats(player, addedStats)
	if player == nil or typeof(addedStats) ~= "table" then
		return
	end

	local profile = getOrCreateProfile(player)
	addStats(profile.Stats, addedStats)
	applyMovementStats(player)
	applyMaxHealthStats(player)
	sendPerkStats(player)
end

function PerkService.GetBounceCount(player)
	local stats = PerkService.GetStats(player)

	return math.max(0, math.floor(stats.BounceCount or 0))
end

function PerkService.GetCollectDistance(player, baseDistance)
	local stats = PerkService.GetStats(player)

	return baseDistance + (stats.CollectRadius or 0)
end

function PerkService.GetXpAmount(player, baseAmount)
	local profile = getOrCreateProfile(player)
	local stats = PerkService.GetStats(player)
	local exactAmount = (baseAmount * (1 + (stats.XpGainPercent or 0))) + profile.XpRemainder
	local amount = math.floor(exactAmount)

	profile.XpRemainder = exactAmount - amount

	return math.max(1, amount)
end

function PerkService.GetGoldAmount(player, baseAmount)
	local profile = getOrCreateProfile(player)
	local stats = PerkService.GetStats(player)
	local exactAmount = (baseAmount * (1 + (stats.GoldGainPercent or 0))) + profile.GoldRemainder
	local amount = math.floor(exactAmount)

	profile.GoldRemainder = exactAmount - amount

	return math.max(1, amount)
end

function PerkService.GetCoinDropChance(player, baseChance)
	local stats = PerkService.GetStats(player)

	return math.clamp(baseChance + (stats.Luck or 0), 0, 1)
end

function PerkService.GetEnemyCountMultiplier(player)
	local stats = PerkService.GetStats(player)

	return math.max(1, 1 + (stats.EnemyCountPercent or 0))
end

function PerkService.CalculateOutgoingDamage(player, baseDamage, monster)
	local stats = PerkService.GetStats(player)
	local damage = baseDamage + (stats.FlatDamage or 0)

	if monster ~= nil and monster:GetAttribute("IsElite") == true then
		damage += stats.EliteFlatDamage or 0
	end

	damage *= 1 + (stats.DamagePercent or 0)

	local critChance = math.clamp(stats.CritChance or 0, 0, 1)

	local isCritical = critChance > 0 and rng:NextNumber() <= critChance

	if isCritical then
		damage *= 1.5 + (stats.CritMultiplierBonus or 0)
	end

	return damage, isCritical
end

function PerkService.CalculateIncomingDamage(player, baseDamage)
	local profile = getOrCreateProfile(player)
	local armorPercent = math.clamp(profile.Stats.ArmorPercent or 0, 0, 0.8)
	local damage = baseDamage * (1 - armorPercent)
	local absorbed = 0

	if profile.CurrentShield > 0 then
		absorbed = math.min(profile.CurrentShield, damage)

		profile.CurrentShield -= absorbed
		damage -= absorbed
		sendPerkStats(player)
	end

	return math.max(0, damage), absorbed
end

function PerkService.ApplyInstantHeal(player, amount)
	return applyHealing(player, amount, "HealInstant")
end

function PerkService.GrantMaxHealth(player, amount)
	local addedAmount = math.max(0, amount)

	if player == nil or addedAmount <= 0 then
		return 0
	end

	local profile = getOrCreateProfile(player)
	profile.Stats.MaxHealthBonus = (profile.Stats.MaxHealthBonus or 0) + addedAmount
	applyMaxHealthStats(player)
	sendPerkStats(player)
	GameplayFeedbackService.Queue(player, "MaxHealth", addedAmount)

	return addedAmount
end

function PerkService.ApplyLifeSteal(player, damageDealt, source)
	local stats = PerkService.GetStats(player)
	local lifeStealPercent = stats.LifeStealPercent or 0

	if lifeStealPercent <= 0 or damageDealt <= 0 then
		return
	end

	local healAmount = damageDealt * lifeStealPercent
	return applyHealing(player, healAmount, if source == "Dot" then "LifeStealDot" else "LifeStealHit")
end

function PerkService.GetShieldState(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		return 0, 0
	end

	return profile.CurrentShield, profile.Stats.Shield or 0
end

function PerkService.Start()
	if isStarted then
		DebugLog.Info("Perks", "Start ignore, service deja demarre")
		return
	end

	isStarted = true
	DebugLog.Info("Perks", "PerkService demarre")
	selectChoiceRemote.OnServerEvent:Connect(onChoiceSelected)
	rerollChoiceRemote.OnServerEvent:Connect(onRerollRequested)
	passChoiceRemote.OnServerEvent:Connect(onPassRequested)
	banChoiceRemote.OnServerEvent:Connect(onBanRequested)

	RunService.Heartbeat:Connect(function(deltaTime)
		if CombatStateService.IsPaused() then
			return
		end

		for _, player in ipairs(Players:GetPlayers()) do
			applyHealthRegen(player, deltaTime)
		end
	end)
end

return PerkService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="80">
        <Properties>
          <string name="Name">PhysicsAuditService</string>
          <string name="Source"><![CDATA[local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Stats = game:GetService("Stats")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChapterConfig = require(Shared:WaitForChild("ChapterConfig"))
local ChestConfig = require(Shared:WaitForChild("ChestConfig"))
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local JarConfig = require(Shared:WaitForChild("JarConfig"))
local LobbyConfig = require(Shared:WaitForChild("LobbyConfig"))
local PortalConfig = require(Shared:WaitForChild("PortalConfig"))
local ShrineConfig = require(Shared:WaitForChild("ShrineConfig"))
local TotemConfig = require(Shared:WaitForChild("TotemConfig"))

local TemplateService = require(script.Parent:WaitForChild("TemplateService"))

local PhysicsAuditService = {}

local REPORT_FOLDER_NAME = "PerformanceAuditReports"
local PHYSICS_REPORT_FOLDER_NAME = "PhysicsLatest"
local MAX_FINDING_SAMPLES = 12

local templateScopes = {
	{ Id = "CombatTemplates", FolderName = CombatConfig.TemplateFolderName },
	{ Id = "CollectibleTemplates", FolderName = "CollectibleTemplates" },
	{ Id = "ShrineTemplates", FolderName = ShrineConfig.TemplateFolderName },
	{ Id = "ChestTemplates", FolderName = ChestConfig.TemplateFolderName },
	{ Id = "JarTemplates", FolderName = JarConfig.TemplateFolderName },
	{ Id = "TotemTemplates", FolderName = TotemConfig.TemplateFolderName },
	{ Id = "PortalTemplates", FolderName = PortalConfig.TemplateFolderName },
	{ Id = "MapTemplates", FolderName = ChapterConfig.TemplateFolderName },
	{ Id = "LobbyTemplates", FolderName = LobbyConfig.TemplateFolderName },
}

local runtimeScopes = {
	{ Id = "CombatMonsters", GetFolder = TemplateService.GetCombatMonsterFolder },
	{ Id = "CombatProjectiles", GetFolder = TemplateService.GetCombatProjectileFolder },
	{ Id = "CombatLoot", GetFolder = TemplateService.GetCombatLootFolder },
	{ Id = "ShrinesRuntime", GetFolder = TemplateService.GetShrinesRuntimeFolder },
	{ Id = "ChestsRuntime", GetFolder = TemplateService.GetChestsRuntimeFolder },
	{ Id = "JarsRuntime", GetFolder = TemplateService.GetJarsRuntimeFolder },
	{ Id = "TotemsRuntime", GetFolder = TemplateService.GetTotemsRuntimeFolder },
	{ Id = "PortalsRuntime", GetFolder = TemplateService.GetPortalsRuntimeFolder },
	{ Id = "MapRuntime", GetFolder = TemplateService.GetMapRuntimeFolder },
}

local latestReport = nil

local function getOrCreateFolder(parent, name)
	local child = parent:FindFirstChild(name)

	if child == nil then
		child = Instance.new("Folder")
		child.Name = name
		child.Parent = parent
	end

	assert(child:IsA("Folder"), name .. " doit etre un Folder.")
	return child
end

local function getInstancePath(instance)
	local parts = {}
	local current = instance

	while current ~= nil and current ~= game do
		table.insert(parts, 1, current.Name)
		current = current.Parent
	end

	return table.concat(parts, "/")
end

local function readNumber(reader)
	local success, value = pcall(reader)

	if success and typeof(value) == "number" then
		return value
	end

	return nil
end

local function readMemoryTag(tagName)
	return readNumber(function()
		local tag = Enum.DeveloperMemoryTag[tagName]

		if tag == nil then
			error("Tag memoire indisponible")
		end

		return Stats:GetMemoryUsageMbForTag(tag)
	end)
end

local function getMemorySnapshot()
	return {
		TotalMb = readNumber(function()
			return Stats:GetTotalMemoryUsageMb()
		end),
		InstancesMb = readMemoryTag("Instances"),
		PhysicsPartsMb = readMemoryTag("PhysicsParts"),
		PhysicsCollisionMb = readMemoryTag("PhysicsCollision"),
	}
end

local function increment(counter, key)
	counter[key] = (counter[key] or 0) + 1
end

local function addFinding(report, category, path)
	increment(report.FindingCounts, category)

	local samples = report.FindingSamples[category]

	if samples == nil then
		samples = {}
		report.FindingSamples[category] = samples
	end

	if #samples < MAX_FINDING_SAMPLES then
		table.insert(samples, path)
	end
end

local function getAuditInstances(root)
	local instances = { root }

	for _, descendant in ipairs(root:GetDescendants()) do
		table.insert(instances, descendant)
	end

	return instances
end

local function readAssemblyRootPath(part)
	local success, assemblyRoot = pcall(function()
		return part.AssemblyRootPart
	end)

	if success and assemblyRoot ~= nil then
		return getInstancePath(assemblyRoot)
	end

	return getInstancePath(part)
end

local function auditRoot(scopeId, kind, root)
	local report = {
		Scope = scopeId,
		Kind = kind,
		Path = getInstancePath(root),
		RootClass = root.ClassName,
		ClassCounts = {},
		BaseParts = 0,
		MeshParts = 0,
		AnchoredParts = 0,
		UnanchoredParts = 0,
		CollidableParts = 0,
		TouchEnabledParts = 0,
		QueryEnabledParts = 0,
		MasslessParts = 0,
		InvisiblePhysicalParts = 0,
		Constraints = 0,
		JointInstances = 0,
		Assemblies = 0,
		NonAnchoredAssemblies = 0,
		CollisionFidelity = {},
		FindingCounts = {},
		FindingSamples = {},
	}
	local assemblyPaths = {}
	local nonAnchoredAssemblyPaths = {}

	for _, instance in ipairs(getAuditInstances(root)) do
		increment(report.ClassCounts, instance.ClassName)

		if instance:IsA("Constraint") then
			report.Constraints += 1
		elseif instance:IsA("JointInstance") then
			report.JointInstances += 1
		end

		if not instance:IsA("BasePart") then
			continue
		end

		report.BaseParts += 1

		if instance:IsA("MeshPart") then
			report.MeshParts += 1
			local collisionFidelity = tostring(instance.CollisionFidelity)
			increment(report.CollisionFidelity, collisionFidelity)

			if string.find(collisionFidelity, "Precise", 1, true) ~= nil then
				addFinding(report, "PreciseCollision", getInstancePath(instance))
			end
		end

		local partPath = getInstancePath(instance)
		local assemblyPath = readAssemblyRootPath(instance)
		assemblyPaths[assemblyPath] = true

		if instance.Anchored then
			report.AnchoredParts += 1
		else
			report.UnanchoredParts += 1
			nonAnchoredAssemblyPaths[assemblyPath] = true
			addFinding(report, "UnanchoredPart", partPath)
		end

		if instance.CanCollide then
			report.CollidableParts += 1
		end

		if instance.CanTouch then
			report.TouchEnabledParts += 1
		end

		if instance.CanQuery then
			report.QueryEnabledParts += 1
		end

		if instance.Massless then
			report.MasslessParts += 1
		end

		if instance.Transparency >= 0.95 and (instance.CanCollide or instance.CanTouch or instance.CanQuery) then
			report.InvisiblePhysicalParts += 1
			addFinding(report, "InvisiblePhysicalPart", partPath)
		end
	end

	for _ in pairs(assemblyPaths) do
		report.Assemblies += 1
	end

	for _ in pairs(nonAnchoredAssemblyPaths) do
		report.NonAnchoredAssemblies += 1
	end

	if report.Constraints > 0 then
		addFinding(report, "ConstraintPresent", report.Path)
	end

	if report.JointInstances > 0 then
		addFinding(report, "JointPresent", report.Path)
	end

	return report
end

local function createSummary()
	return {
		Records = 0,
		BaseParts = 0,
		MeshParts = 0,
		UnanchoredParts = 0,
		CollidableParts = 0,
		TouchEnabledParts = 0,
		QueryEnabledParts = 0,
		InvisiblePhysicalParts = 0,
		Constraints = 0,
		JointInstances = 0,
		Assemblies = 0,
		NonAnchoredAssemblies = 0,
		FindingCounts = {},
	}
end

local function accumulateSummary(summary, report)
	summary.Records += 1
	summary.BaseParts += report.BaseParts
	summary.MeshParts += report.MeshParts
	summary.UnanchoredParts += report.UnanchoredParts
	summary.CollidableParts += report.CollidableParts
	summary.TouchEnabledParts += report.TouchEnabledParts
	summary.QueryEnabledParts += report.QueryEnabledParts
	summary.InvisiblePhysicalParts += report.InvisiblePhysicalParts
	summary.Constraints += report.Constraints
	summary.JointInstances += report.JointInstances
	summary.Assemblies += report.Assemblies
	summary.NonAnchoredAssemblies += report.NonAnchoredAssemblies

	for category, count in pairs(report.FindingCounts) do
		summary.FindingCounts[category] = (summary.FindingCounts[category] or 0) + count
	end
end

local function auditTemplateScope(scope)
	local folder = TemplateService.GetServerTemplateFolder(scope.FolderName)
	local reports = {}

	for _, child in ipairs(folder:GetChildren()) do
		table.insert(reports, auditRoot(scope.Id, "Template", child))
	end

	return reports
end

local function auditRuntimeScope(scope)
	local folder = scope.GetFolder()
	local reports = {
		auditRoot(scope.Id, "Runtime", folder),
	}

	if scope.Id ~= "MapRuntime" then
		return reports
	end

	for _, map in ipairs(folder:GetChildren()) do
		local mapChildren = map:GetChildren()

		if #mapChildren == 0 then
			local record = auditRoot(scope.Id, "RuntimeBreakdown", map)
			record.IsBreakdown = true
			table.insert(reports, record)
			continue
		end

		for _, child in ipairs(mapChildren) do
			local record = auditRoot(scope.Id, "RuntimeBreakdown", child)
			record.IsBreakdown = true
			table.insert(reports, record)
		end
	end

	return reports
end

local function summarizeFindings(summary)
	local parts = {}

	for category, count in pairs(summary.FindingCounts) do
		table.insert(parts, ("%s=%d"):format(category, count))
	end

	table.sort(parts)
	return table.concat(parts, ", ")
end

local function formatCountMap(counts)
	local parts = {}

	for key, count in pairs(counts) do
		table.insert(parts, ("%s=%d"):format(key, count))
	end

	table.sort(parts)
	return if #parts > 0 then table.concat(parts, ", ") else "aucun"
end

local function formatMemoryValue(value)
	if typeof(value) ~= "number" then
		return "indisponible"
	end

	return ("%.2f MB"):format(value)
end

local function buildReadableReport(report)
	local lines = {
		("P1 - Inventaire physique %s"):format(report.Id),
		("Memoire avant | total=%s | instances=%s | physicsParts=%s | physicsCollision=%s"):format(
			formatMemoryValue(report.MemoryBeforeMb.TotalMb),
			formatMemoryValue(report.MemoryBeforeMb.InstancesMb),
			formatMemoryValue(report.MemoryBeforeMb.PhysicsPartsMb),
			formatMemoryValue(report.MemoryBeforeMb.PhysicsCollisionMb)
		),
		("Memoire apres | total=%s | instances=%s | physicsParts=%s | physicsCollision=%s"):format(
			formatMemoryValue(report.MemoryAfterMb.TotalMb),
			formatMemoryValue(report.MemoryAfterMb.InstancesMb),
			formatMemoryValue(report.MemoryAfterMb.PhysicsPartsMb),
			formatMemoryValue(report.MemoryAfterMb.PhysicsCollisionMb)
		),
		report.SummaryText,
		(
			"Templates | records=%d parts=%d mesh=%d unanchored=%d collide=%d touch=%d query=%d constraints=%d joints=%d"
		):format(
			report.TemplateSummary.Records,
			report.TemplateSummary.BaseParts,
			report.TemplateSummary.MeshParts,
			report.TemplateSummary.UnanchoredParts,
			report.TemplateSummary.CollidableParts,
			report.TemplateSummary.TouchEnabledParts,
			report.TemplateSummary.QueryEnabledParts,
			report.TemplateSummary.Constraints,
			report.TemplateSummary.JointInstances
		),
		(
			"Runtime | records=%d parts=%d mesh=%d unanchored=%d collide=%d touch=%d query=%d constraints=%d joints=%d"
		):format(
			report.RuntimeSummary.Records,
			report.RuntimeSummary.BaseParts,
			report.RuntimeSummary.MeshParts,
			report.RuntimeSummary.UnanchoredParts,
			report.RuntimeSummary.CollidableParts,
			report.RuntimeSummary.TouchEnabledParts,
			report.RuntimeSummary.QueryEnabledParts,
			report.RuntimeSummary.Constraints,
			report.RuntimeSummary.JointInstances
		),
		"",
		"RECORDS",
	}

	for _, record in ipairs(report.Records) do
		table.insert(lines, ("[%s | %s] %s"):format(record.Scope, record.Kind, record.Path))
		table.insert(lines, (
			"  parts=%d mesh=%d anchored=%d unanchored=%d collide=%d touch=%d query=%d massless=%d"
		):format(
			record.BaseParts,
			record.MeshParts,
			record.AnchoredParts,
			record.UnanchoredParts,
			record.CollidableParts,
			record.TouchEnabledParts,
			record.QueryEnabledParts,
			record.MasslessParts
		))
		table.insert(lines, (
			"  assemblies=%d nonAnchoredAssemblies=%d constraints=%d joints=%d invisiblePhysical=%d"
		):format(
			record.Assemblies,
			record.NonAnchoredAssemblies,
			record.Constraints,
			record.JointInstances,
			record.InvisiblePhysicalParts
		))
		table.insert(lines, "  collisionFidelity=" .. formatCountMap(record.CollisionFidelity))

		if next(record.FindingCounts) ~= nil then
			table.insert(lines, "  findings=" .. formatCountMap(record.FindingCounts))
		end
	end

	return table.concat(lines, "\n")
end

local function writeLatestReport(report)
	local root = getOrCreateFolder(ReplicatedStorage, REPORT_FOLDER_NAME)
	local previous = root:FindFirstChild(PHYSICS_REPORT_FOLDER_NAME)

	if previous ~= nil then
		previous:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = PHYSICS_REPORT_FOLDER_NAME
	folder.Parent = root
	folder:SetAttribute("AuditId", report.Id)
	folder:SetAttribute("GeneratedAtUnix", report.GeneratedAtUnix)

	local summary = Instance.new("StringValue")
	summary.Name = "Summary"
	summary.Value = report.SummaryText
	summary.Parent = folder

	local inventory = Instance.new("StringValue")
	inventory.Name = "InventoryJson"
	inventory.Value = HttpService:JSONEncode(report)
	inventory.Parent = folder

	local readableReport = Instance.new("StringValue")
	readableReport.Name = "ReadableReport"
	readableReport.Value = buildReadableReport(report)
	readableReport.Parent = folder
end

function PhysicsAuditService.RunAudit()
	local report = {
		Id = ("P1-Physics-%d"):format(math.floor(os.clock() * 1000)),
		GeneratedAtUnix = os.time(),
		MemoryBeforeMb = getMemorySnapshot(),
		Records = {},
		Summary = createSummary(),
		TemplateSummary = createSummary(),
		RuntimeSummary = createSummary(),
	}

	for _, scope in ipairs(templateScopes) do
		for _, record in ipairs(auditTemplateScope(scope)) do
			table.insert(report.Records, record)
			accumulateSummary(report.Summary, record)
			accumulateSummary(report.TemplateSummary, record)
		end
	end

	for _, scope in ipairs(runtimeScopes) do
		for _, record in ipairs(auditRuntimeScope(scope)) do
			table.insert(report.Records, record)

			-- Les sous-ensembles de MapRuntime servent a attribuer les couts.
			-- Le total Runtime les couvre deja et reste le seul compte dans le resume.
			if record.IsBreakdown ~= true then
				accumulateSummary(report.Summary, record)
				accumulateSummary(report.RuntimeSummary, record)
			end
		end
	end

	report.MemoryAfterMb = getMemorySnapshot()
	report.SummaryText = (
		"P1 audit %s | records=%d parts=%d mesh=%d unanchored=%d invisiblePhysical=%d constraints=%d joints=%d | templatesParts=%d runtimeParts=%d | %s"
	):format(
		report.Id,
		report.Summary.Records,
		report.Summary.BaseParts,
		report.Summary.MeshParts,
		report.Summary.UnanchoredParts,
		report.Summary.InvisiblePhysicalParts,
		report.Summary.Constraints,
		report.Summary.JointInstances,
		report.TemplateSummary.BaseParts,
		report.RuntimeSummary.BaseParts,
		summarizeFindings(report.Summary)
	)

	writeLatestReport(report)
	latestReport = report

	DebugLog.Info("Perf", "Inventaire physique P1 termine", {
		AuditId = report.Id,
		Records = report.Summary.Records,
		BaseParts = report.Summary.BaseParts,
		MeshParts = report.Summary.MeshParts,
		Unanchored = report.Summary.UnanchoredParts,
		InvisiblePhysical = report.Summary.InvisiblePhysicalParts,
		Constraints = report.Summary.Constraints,
		Joints = report.Summary.JointInstances,
	})

	return (
		"P1 inventaire termine : %d records. Rapport dans ReplicatedStorage/%s/%s"
	):format(report.Summary.Records, REPORT_FOLDER_NAME, PHYSICS_REPORT_FOLDER_NAME)
end

function PhysicsAuditService.GetLatestReport()
	return latestReport
end

return PhysicsAuditService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="81">
        <Properties>
          <string name="Name">PlayerPreferencesService</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AudioConfig = require(Shared:WaitForChild("AudioConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local GraphicsConfig = require(Shared:WaitForChild("GraphicsConfig"))
local PlayerPreferencesConfig = require(Shared:WaitForChild("PlayerPreferencesConfig"))

local PlayerPreferencesService = {}

local preferencesDataStore = DataStoreService:GetDataStore(PlayerPreferencesConfig.DataStoreName)
local profilesByUserId = {}
local isStarted = false

local function getOrCreateRemote(remoteName, className)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new(className)
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote.ClassName == className, remoteName .. " doit etre un " .. className .. ".")
	return remote
end

local getStateRemote = getOrCreateRemote(PlayerPreferencesConfig.GetStateRemoteName, "RemoteFunction")
local setAudioRemote = getOrCreateRemote(PlayerPreferencesConfig.SetAudioRemoteName, "RemoteEvent")
local setGraphicsRemote = getOrCreateRemote(PlayerPreferencesConfig.SetGraphicsRemoteName, "RemoteEvent")
local updateRemote = getOrCreateRemote(PlayerPreferencesConfig.UpdateRemoteName, "RemoteEvent")

local function createDefaultAudio()
	local audio = {}

	for settingName, defaultValue in pairs(AudioConfig.DefaultVolumes) do
		audio[settingName] = defaultValue
	end

	return audio
end

local function createDefaultData()
	return {
		Version = PlayerPreferencesConfig.DataVersion,
		Audio = createDefaultAudio(),
		Graphics = table.clone(GraphicsConfig.DefaultSettings),
	}
end

local function normalizeGraphics(rawGraphics)
	local graphics = table.clone(GraphicsConfig.DefaultSettings)

	if typeof(rawGraphics) ~= "table" then
		return graphics
	end

	if typeof(rawGraphics.Quality) == "string" and GraphicsConfig.QualityProfiles[rawGraphics.Quality] ~= nil then
		graphics.Quality = rawGraphics.Quality
	end

	graphics.EffectsIntensity = math.clamp(
		tonumber(rawGraphics.EffectsIntensity) or graphics.EffectsIntensity,
		0,
		1
	)
	graphics.ShadowsEnabled = rawGraphics.ShadowsEnabled ~= false

	return graphics
end

local function normalizeAudio(rawAudio)
	local audio = createDefaultAudio()

	if typeof(rawAudio) ~= "table" then
		return audio
	end

	for settingName, defaultValue in pairs(AudioConfig.DefaultVolumes) do
		local value = tonumber(rawAudio[settingName])
		audio[settingName] = math.clamp(value or defaultValue, 0, 1)
	end

	return audio
end

local function normalizeData(rawData)
	local data = createDefaultData()

	if typeof(rawData) ~= "table" then
		return data
	end

	data.Audio = normalizeAudio(rawData.Audio)
	data.Graphics = normalizeGraphics(rawData.Graphics)
	return data
end

local function getDataStoreKey(player)
	return "Player_" .. player.UserId
end

local function getOrCreateProfile(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		profile = {
			Data = createDefaultData(),
			Loaded = false,
			SessionOnly = false,
			Dirty = false,
			Revision = 0,
			SaveScheduled = false,
		}
		profilesByUserId[player.UserId] = profile
	end

	return profile
end

local function buildPublicState(profile)
	return {
		Loaded = profile.Loaded,
		Audio = table.clone(profile.Data.Audio),
		Graphics = table.clone(profile.Data.Graphics),
	}
end

local function publishState(player, profile)
	if player.Parent == Players then
		updateRemote:FireClient(player, buildPublicState(profile))
	end
end

local function saveProfile(player, profile)
	if not profile.Loaded or profile.SessionOnly or not profile.Dirty then
		return true
	end

	local savedRevision = profile.Revision
	local audioSnapshot = table.clone(profile.Data.Audio)
	local graphicsSnapshot = table.clone(profile.Data.Graphics)
	local success, result = pcall(function()
		return preferencesDataStore:UpdateAsync(getDataStoreKey(player), function(rawData)
			local data = normalizeData(rawData)
			data.Version = PlayerPreferencesConfig.DataVersion
			data.Audio = audioSnapshot
			data.Graphics = graphicsSnapshot
			return data
		end)
	end)

	if not success then
		DebugLog.Warn("Preferences", "Sauvegarde preferences impossible", {
			Player = player.Name,
			Error = tostring(result),
		})
		return false
	end

	if profile.Revision == savedRevision then
		profile.Dirty = false
	end

	return true
end

local function scheduleSave(player, profile)
	if profile.SessionOnly or profile.SaveScheduled then
		return
	end

	profile.SaveScheduled = true
	task.delay(PlayerPreferencesConfig.SaveDebounceSeconds, function()
		profile.SaveScheduled = false

		if player.Parent == Players then
			saveProfile(player, profile)
		end
	end)
end

function PlayerPreferencesService.SetupPlayer(player)
	local profile = getOrCreateProfile(player)
	local success, rawData = pcall(function()
		return preferencesDataStore:GetAsync(getDataStoreKey(player))
	end)

	if success then
		profile.Data = normalizeData(rawData)
		profile.Loaded = true
		profile.SessionOnly = false
	elseif RunService:IsStudio() then
		profile.Data = createDefaultData()
		profile.Loaded = true
		profile.SessionOnly = true
		DebugLog.Warn("Preferences", "DataStore preferences indisponible dans Studio", {
			Player = player.Name,
			Error = tostring(rawData),
		})
	else
		profile.Loaded = false
		DebugLog.Warn("Preferences", "Chargement preferences impossible", {
			Player = player.Name,
			Error = tostring(rawData),
		})
	end

	publishState(player, profile)
end

function PlayerPreferencesService.GetPublicState(player)
	return buildPublicState(getOrCreateProfile(player))
end

function PlayerPreferencesService.SetAudio(player, rawAudio)
	if typeof(rawAudio) ~= "table" then
		return false
	end

	local profile = getOrCreateProfile(player)

	if not profile.Loaded then
		return false
	end

	local nextAudio = table.clone(profile.Data.Audio)
	local changed = false

	for settingName, defaultValue in pairs(AudioConfig.DefaultVolumes) do
		if rawAudio[settingName] ~= nil then
			local value = tonumber(rawAudio[settingName])
			local normalizedValue = math.clamp(value or defaultValue, 0, 1)

			if nextAudio[settingName] ~= normalizedValue then
				nextAudio[settingName] = normalizedValue
				changed = true
			end
		end
	end

	if not changed then
		return true
	end

	profile.Data.Audio = nextAudio
	profile.Dirty = true
	profile.Revision += 1

	publishState(player, profile)
	scheduleSave(player, profile)

	return true
end

function PlayerPreferencesService.SetGraphics(player, rawGraphics)
	if typeof(rawGraphics) ~= "table" then
		return false
	end

	local profile = getOrCreateProfile(player)

	if not profile.Loaded then
		return false
	end

	local nextGraphics = normalizeGraphics(rawGraphics)
	local currentGraphics = profile.Data.Graphics
	local changed = currentGraphics.Quality ~= nextGraphics.Quality
		or currentGraphics.EffectsIntensity ~= nextGraphics.EffectsIntensity
		or currentGraphics.ShadowsEnabled ~= nextGraphics.ShadowsEnabled

	if not changed then
		return true
	end

	profile.Data.Graphics = nextGraphics
	profile.Dirty = true
	profile.Revision += 1

	publishState(player, profile)
	scheduleSave(player, profile)

	return true
end

function PlayerPreferencesService.SavePlayer(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		return true
	end

	return saveProfile(player, profile)
end

function PlayerPreferencesService.RemovePlayer(player)
	profilesByUserId[player.UserId] = nil
end

function PlayerPreferencesService.Start()
	if isStarted then
		return
	end

	isStarted = true
	getStateRemote.OnServerInvoke = function(player)
		return PlayerPreferencesService.GetPublicState(player)
	end
	setAudioRemote.OnServerEvent:Connect(function(player, rawAudio)
		PlayerPreferencesService.SetAudio(player, rawAudio)
	end)
	setGraphicsRemote.OnServerEvent:Connect(function(player, rawGraphics)
		PlayerPreferencesService.SetGraphics(player, rawGraphics)
	end)

	DebugLog.Info("Preferences", "PlayerPreferencesService demarre", {
		DataStore = PlayerPreferencesConfig.DataStoreName,
	})
end

return PlayerPreferencesService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="82">
        <Properties>
          <string name="Name">PortalService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BossConfig = require(Shared:WaitForChild("BossConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local PortalConfig = require(Shared:WaitForChild("PortalConfig"))

local TemplateService = require(script.Parent:WaitForChild("TemplateService"))
local ProceduralMapService = require(script.Parent:WaitForChild("ProceduralMapService"))
local RunMapService = require(script.Parent:WaitForChild("RunMapService"))
local WorldSpawnService = require(script.Parent:WaitForChild("WorldSpawnService"))
local BossService = require(script.Parent:WaitForChild("BossService"))
local RunAnalyticsService = require(script.Parent:WaitForChild("RunAnalyticsService"))

local PortalService = {}

local runtimeFolder = nil
local portalTemplate = nil
local isStarted = false
local spawnedPortalCount = 0

local function createFallbackPortalTemplate(templateStorage)
	local model = Instance.new("Model")
	model.Name = PortalConfig.PortalTemplateName

	local base = Instance.new("Part")
	base.Name = "Base"
	base.Size = Vector3.new(7, 0.8, 7)
	base.Color = Color3.fromRGB(48, 36, 76)
	base.Material = Enum.Material.Slate
	base.Anchored = true
	base.Parent = model

	local ring = Instance.new("Part")
	ring.Name = "Portal"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.6, 8, 8)
	ring.Color = Color3.fromRGB(142, 76, 255)
	ring.Material = Enum.Material.Neon
	ring.Anchored = true
	ring.CanCollide = false
	ring.CFrame = CFrame.new(0, 4, 0) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = model

	model.PrimaryPart = base
	model.Parent = templateStorage

	DebugLog.Warn("Portal", "Template PortalBoss introuvable, fallback cree")

	return model
end

local function preparePortalInstance(portal)
	for _, descendant in ipairs(portal:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end

	if portal:IsA("BasePart") then
		portal.Anchored = true
		portal.CanTouch = false
		portal.CanQuery = false
	end

	portal:SetAttribute("PortalBossRuntime", true)
	portal:SetAttribute("BossPortalActivated", false)
end

local function findPortalRoot(portal)
	if portal:IsA("BasePart") then
		return portal
	end

	if portal:IsA("Model") and portal.PrimaryPart ~= nil then
		return portal.PrimaryPart
	end

	local root = portal:FindFirstChildWhichIsA("BasePart", true)

	if root ~= nil and portal:IsA("Model") then
		portal.PrimaryPart = root
	end

	return root
end

local function setupPortalPrompt(portal)
	local root = findPortalRoot(portal)

	if root == nil then
		DebugLog.Warn("Portal", "Portail sans BasePart, interaction impossible", {
			Portal = portal,
		})
		return
	end

	local prompt = root:FindFirstChild(BossConfig.PortalPromptName)

	if prompt == nil then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = BossConfig.PortalPromptName
		prompt.Parent = root
	end

	assert(prompt:IsA("ProximityPrompt"), BossConfig.PortalPromptName .. " doit etre un ProximityPrompt.")
	prompt.ActionText = BossConfig.PortalPromptText
	prompt.ObjectText = BossConfig.PortalPromptObjectText
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = BossConfig.PortalActivationDistance
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.Enabled = true

	prompt.Triggered:Connect(function(player)
		local started, reason = BossService.TryStartBoss(player, portal, function()
			if prompt.Parent ~= nil then
				prompt.Enabled = true
			end
		end)

		DebugLog.Info("Portal", "Activation portail demandee", {
			Player = player.Name,
			Portal = portal,
			Started = started,
			Reason = reason,
		})

		if started then
			RunAnalyticsService.RecordPortalActivated(player)
			prompt.Enabled = false
		end
	end)
end

local function pivotInstance(instance, cframe)
	if instance:IsA("Model") or instance:IsA("BasePart") then
		instance:PivotTo(cframe)
	end
end

local function clonePortalRuntimeModel()
	if portalTemplate == nil then
		return nil
	end

	local portal = portalTemplate:Clone()

	if portal:IsA("Folder") then
		-- Certains assets de portail arrivent comme Folder. Un Model est requis
		-- pour disposer d'un pivot et garantir une pose correcte sur la surface.
		local model = Instance.new("Model")

		for _, child in ipairs(portal:GetChildren()) do
			child.Parent = model
		end

		portal:Destroy()
		portal = model
	end

	return portal
end

local function getLowestWorldY(part)
	local halfSize = part.Size * 0.5
	local lowestY = math.huge

	for _, xSign in ipairs({ -1, 1 }) do
		for _, ySign in ipairs({ -1, 1 }) do
			for _, zSign in ipairs({ -1, 1 }) do
				local corner = part.CFrame:PointToWorldSpace(Vector3.new(
					halfSize.X * xSign,
					halfSize.Y * ySign,
					halfSize.Z * zSign
				))
				lowestY = math.min(lowestY, corner.Y)
			end
		end
	end

	return lowestY
end

local function correctPortalGrounding(portal, surfacePosition)
	if not portal:IsA("Model") then
		return 0
	end

	local lowestY = nil

	for _, descendant in ipairs(portal:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local partLowestY = getLowestWorldY(descendant)
			lowestY = if lowestY == nil then partLowestY else math.min(lowestY, partLowestY)
		end
	end

	if lowestY == nil then
		return 0
	end

	local correction = (surfacePosition.Y + PortalConfig.SpawnSurfaceOffset) - lowestY

	if math.abs(correction) > 0.001 then
		portal:PivotTo(portal:GetPivot() + Vector3.new(0, correction, 0))
	end

	return correction
end

local function spawnPortalAtSurface(surfacePosition)
	if portalTemplate == nil then
		return nil
	end

	local portal = clonePortalRuntimeModel()

	if portal == nil then
		return nil
	end

	portal.Name = PortalConfig.PortalTemplateName
	portal.Parent = runtimeFolder
	preparePortalInstance(portal)

	local pivotPosition = WorldSpawnService.GetSurfacePivotPosition(
		portal,
		surfacePosition,
		PortalConfig.SpawnSurfaceOffset
	)

	pivotInstance(portal, WorldSpawnService.GetPivotCFrameAtPosition(portal, pivotPosition))
	local groundingCorrection = correctPortalGrounding(portal, surfacePosition)
	setupPortalPrompt(portal)
	spawnedPortalCount += 1

	DebugLog.Info("Portal", "Portail boss genere", {
		Portal = portal,
		SurfacePosition = surfacePosition,
		PivotPosition = pivotPosition,
		GroundingCorrection = groundingCorrection,
		SpawnedCount = spawnedPortalCount,
	})

	return portal
end

local function spawnInitialPortal(generationOptions)
	if portalTemplate == nil then
		DebugLog.Warn("Portal", "Generation portail boss impossible, template absent")
		return
	end

	if spawnedPortalCount >= PortalConfig.InitialSpawnCount then
		return
	end

	DebugLog.Info("Portal", "Generation portail boss demandee", {
		Requested = PortalConfig.InitialSpawnCount,
		MaxRadius = PortalConfig.SpawnWorldMaxRadius,
	})

	local function findPortalSurface(clearance)
		return WorldSpawnService.FindSurfacePositionInPlayableBounds({
			MinRadius = PortalConfig.SpawnWorldMinRadius,
			MaxRadius = PortalConfig.SpawnWorldMaxRadius,
			EdgeInset = PortalConfig.SpawnWorldEdgeInset,
			Attempts = PortalConfig.SpawnWorldAttemptsPerPortal,
			RaycastHeight = PortalConfig.SpawnRaycastHeight,
			RaycastDepth = PortalConfig.SpawnRaycastDepth,
			RejectGeneratedTerrain = PortalConfig.RejectGeneratedTerrain,
			RejectedSurfaceNameContains = PortalConfig.RejectedSurfaceNameContains,
			PositionFilter = function(position, surfaceInstance)
				return ProceduralMapService.IsAreaClear(RunMapService.GetActiveMap(), position, clearance, {
					AllowSupportingTerrain = surfaceInstance ~= nil,
				})
			end,
		})
	end

	while spawnedPortalCount < PortalConfig.InitialSpawnCount do
		local surfacePosition = findPortalSurface(PortalConfig.GeneratedTerrainClearance)

		if surfacePosition == nil then
			surfacePosition = findPortalSurface(PortalConfig.GeneratedTerrainFallbackClearance)

			if surfacePosition ~= nil then
				DebugLog.Warn("Portal", "Portail place avec marge terrain reduite", {
					Clearance = PortalConfig.GeneratedTerrainFallbackClearance,
				})
			end
		end

		if surfacePosition == nil then
			DebugLog.Warn("Portal", "Aucune zone sure trouvee pour le portail", {
				Attempts = PortalConfig.SpawnWorldAttemptsPerPortal * 2,
				MinRadius = PortalConfig.SpawnWorldMinRadius,
				MaxRadius = PortalConfig.SpawnWorldMaxRadius,
			})
			break
		end

		spawnPortalAtSurface(surfacePosition)
	end

	if generationOptions ~= nil and generationOptions.OnBatch ~= nil then
		generationOptions.OnBatch(spawnedPortalCount, PortalConfig.InitialSpawnCount)
	end

	DebugLog.Info("Portal", "Generation portail boss terminee", {
		Requested = PortalConfig.InitialSpawnCount,
		SpawnedCount = spawnedPortalCount,
	})
end

function PortalService.ClearRunContent()
	if runtimeFolder ~= nil then
		for _, child in ipairs(runtimeFolder:GetChildren()) do
			child:Destroy()
		end
	end

	spawnedPortalCount = 0
end

function PortalService.GenerateForRun(_, generationOptions)
	PortalService.ClearRunContent()
	spawnInitialPortal(generationOptions)
	return spawnedPortalCount
end

function PortalService.Start()
	if isStarted then
		DebugLog.Info("Portal", "Start ignore, service deja demarre")
		return
	end

	isStarted = true
	runtimeFolder = TemplateService.GetPortalsRuntimeFolder()
	portalTemplate = TemplateService.GetTemplate(
		PortalConfig.TemplateFolderName,
		PortalConfig.PortalTemplateName,
		createFallbackPortalTemplate
	)

	DebugLog.Info("Portal", "PortalService demarre", {
		RuntimeFolder = runtimeFolder,
		Template = portalTemplate,
		InitialSpawnCount = PortalConfig.InitialSpawnCount,
	})

end

return PortalService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="83">
        <Properties>
          <string name="Name">ProceduralMapService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChapterConfig = require(Shared:WaitForChild("ChapterConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local ProceduralMapConfig = require(Shared:WaitForChild("ProceduralMapConfig"))

local TemplateService = require(script.Parent:WaitForChild("TemplateService"))
local WorldSpawnService = require(script.Parent:WaitForChild("WorldSpawnService"))

local ProceduralMapService = {}

local SIDE_DIRECTIONS = {
	North = Vector2.new(0, -1),
	South = Vector2.new(0, 1),
	East = Vector2.new(1, 0),
	West = Vector2.new(-1, 0),
}

local REJECTED_SURFACE_NAMES = {
	"LevelLimit",
	"Montain",
	"MurInvisible",
	ProceduralMapConfig.TerrainFolderName,
	ProceduralMapConfig.DecorationFolderName,
}

local function getOrCreateFolder(parent, name)
	local folder = parent:FindFirstChild(name)

	if folder == nil then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end

	assert(folder:IsA("Folder"), name .. " doit etre un Folder.")
	return folder
end

local function getKit()
	local mapTemplates = TemplateService.GetServerTemplateFolder(ProceduralMapConfig.TemplateFolderName)
	local kit = mapTemplates:FindFirstChild(ProceduralMapConfig.KitFolderName)

	if kit ~= nil then
		return kit
	end

	local legacyKit = Workspace:FindFirstChild(ProceduralMapConfig.LegacyWorkspaceKitName)

	if legacyKit ~= nil then
		legacyKit.Name = ProceduralMapConfig.KitFolderName
		legacyKit.Parent = mapTemplates
		DebugLog.Warn("MapGeneration", "Kit procedural migre depuis Workspace", {
			Target = legacyKit,
		})
		return legacyKit
	end

	DebugLog.Warn("MapGeneration", "Kit procedural introuvable", {
		Expected = "ServerStorage/MapTemplates/" .. ProceduralMapConfig.KitFolderName,
	})
	return nil
end

local function getTemplatePart(kit, name)
	local template = kit:FindFirstChild(name)

	if template == nil or not template:IsA("BasePart") then
		DebugLog.Warn("MapGeneration", "Piece du kit introuvable", {
			Kit = kit,
			Template = name,
		})
		return nil
	end

	return template
end

local function getUsableBounds(map)
	local activeBounds = WorldSpawnService.GetActivePlayableBounds()
	local mapCFrame, mapSize = map:GetBoundingBox()
	local inset = ProceduralMapConfig.PlayableInset
	local minimumX = if activeBounds ~= nil then activeBounds.MinX else mapCFrame.Position.X - (mapSize.X * 0.5)
	local maximumX = if activeBounds ~= nil then activeBounds.MaxX else mapCFrame.Position.X + (mapSize.X * 0.5)
	local minimumZ = if activeBounds ~= nil then activeBounds.MinZ else mapCFrame.Position.Z - (mapSize.Z * 0.5)
	local maximumZ = if activeBounds ~= nil then activeBounds.MaxZ else mapCFrame.Position.Z + (mapSize.Z * 0.5)

	return {
		MinX = minimumX + inset,
		MaxX = maximumX - inset,
		MinZ = minimumZ + inset,
		MaxZ = maximumZ - inset,
		Center = Vector3.new((minimumX + maximumX) * 0.5, mapCFrame.Position.Y, (minimumZ + maximumZ) * 0.5),
	}
end

local function getHorizontalDistance(a, b)
	return (Vector2.new(a.X, a.Z) - Vector2.new(b.X, b.Z)).Magnitude
end

local function getSurfacePosition(x, z, center)
	return WorldSpawnService.FindSurfacePositionAtXZ(x, z, {
		Center = center,
		RaycastHeight = 360,
		RaycastDepth = 720,
		RejectedSurfaceNameContains = REJECTED_SURFACE_NAMES,
	})
end

local function pickWeightedLayout(random, excludedIds)
	local totalWeight = 0

	for _, layout in ipairs(ProceduralMapConfig.Layouts) do
		if not excludedIds[layout.Id] then
			totalWeight += layout.Weight
		end
	end

	if totalWeight <= 0 then
		return nil
	end

	local cursor = random:NextNumber(0, totalWeight)

	for _, layout in ipairs(ProceduralMapConfig.Layouts) do
		if not excludedIds[layout.Id] then
			cursor -= layout.Weight

			if cursor <= 0 then
				return layout
			end
		end
	end

	return ProceduralMapConfig.Layouts[1]
end

local function getPlatformElevation(definition, elevationScale)
	return math.clamp(
		(definition.Elevation * (elevationScale or 1)) + ProceduralMapConfig.ElevationOffset,
		ProceduralMapConfig.MinimumElevation,
		ProceduralMapConfig.MaximumElevation
	)
end

local function getRampLength(elevation)
	return math.clamp(
		elevation * ProceduralMapConfig.Ramp.LengthPerElevation,
		ProceduralMapConfig.Ramp.MinimumLength,
		ProceduralMapConfig.Ramp.MaximumLength
	)
end

local function extendLocalBounds(bounds, minimumX, maximumX, minimumZ, maximumZ)
	bounds.MinX = math.min(bounds.MinX, minimumX)
	bounds.MaxX = math.max(bounds.MaxX, maximumX)
	bounds.MinZ = math.min(bounds.MinZ, minimumZ)
	bounds.MaxZ = math.max(bounds.MaxZ, maximumZ)
end

local function getLayoutLocalBounds(layout, elevationScale)
	local localBounds = {
		MinX = math.huge,
		MaxX = -math.huge,
		MinZ = math.huge,
		MaxZ = -math.huge,
	}

	for _, definition in ipairs(layout.Platforms) do
		local halfWidth = definition.Size.X * 0.5
		local halfDepth = definition.Size.Y * 0.5
		extendLocalBounds(
			localBounds,
			definition.Offset.X - halfWidth,
			definition.Offset.X + halfWidth,
			definition.Offset.Y - halfDepth,
			definition.Offset.Y + halfDepth
		)

		local rampLength = getRampLength(getPlatformElevation(definition, elevationScale))

		for _, side in ipairs(definition.Ramps or {}) do
			if side == "East" then
				extendLocalBounds(
					localBounds,
					definition.Offset.X + halfWidth,
					definition.Offset.X + halfWidth + rampLength,
					definition.Offset.Y - halfDepth,
					definition.Offset.Y + halfDepth
				)
			elseif side == "West" then
				extendLocalBounds(
					localBounds,
					definition.Offset.X - halfWidth - rampLength,
					definition.Offset.X - halfWidth,
					definition.Offset.Y - halfDepth,
					definition.Offset.Y + halfDepth
				)
			elseif side == "North" then
				extendLocalBounds(
					localBounds,
					definition.Offset.X - halfWidth,
					definition.Offset.X + halfWidth,
					definition.Offset.Y - halfDepth - rampLength,
					definition.Offset.Y - halfDepth
				)
			elseif side == "South" then
				extendLocalBounds(
					localBounds,
					definition.Offset.X - halfWidth,
					definition.Offset.X + halfWidth,
					definition.Offset.Y + halfDepth,
					definition.Offset.Y + halfDepth + rampLength
				)
			end
		end
	end

	return localBounds
end

local function getWorldLayoutBounds(anchorPosition, localBounds, layoutYaw)
	local rotation = CFrame.Angles(0, layoutYaw, 0)
	local worldBounds = {
		MinX = math.huge,
		MaxX = -math.huge,
		MinZ = math.huge,
		MaxZ = -math.huge,
	}

	for _, localX in ipairs({ localBounds.MinX, localBounds.MaxX }) do
		for _, localZ in ipairs({ localBounds.MinZ, localBounds.MaxZ }) do
			local offset = rotation:VectorToWorldSpace(Vector3.new(localX, 0, localZ))
			local position = anchorPosition + offset
			extendLocalBounds(worldBounds, position.X, position.X, position.Z, position.Z)
		end
	end

	return worldBounds
end

local function isLayoutWithinBounds(layoutBounds, bounds)
	return layoutBounds.MinX >= bounds.MinX
		and layoutBounds.MaxX <= bounds.MaxX
		and layoutBounds.MinZ >= bounds.MinZ
		and layoutBounds.MaxZ <= bounds.MaxZ
end

local function isLayoutFree(layoutBounds, occupiedAnchors)
	local spacing = ProceduralMapConfig.PlatformSpacing

	for _, occupied in ipairs(occupiedAnchors) do
		local occupiedBounds = occupied.Bounds

		if layoutBounds.MaxX + spacing >= occupiedBounds.MinX
			and layoutBounds.MinX - spacing <= occupiedBounds.MaxX
			and layoutBounds.MaxZ + spacing >= occupiedBounds.MinZ
			and layoutBounds.MinZ - spacing <= occupiedBounds.MaxZ
		then
			return false
		end
	end

	return true
end

local function isLayoutAwayFromArrival(layoutBounds, arrivalPosition)
	if arrivalPosition == nil then
		return true
	end

	local nearestX = math.clamp(arrivalPosition.X, layoutBounds.MinX, layoutBounds.MaxX)
	local nearestZ = math.clamp(arrivalPosition.Z, layoutBounds.MinZ, layoutBounds.MaxZ)
	local distance = (Vector2.new(arrivalPosition.X, arrivalPosition.Z) - Vector2.new(nearestX, nearestZ)).Magnitude

	return distance >= ProceduralMapConfig.ArrivalClearRadius
end

local function findLayoutAnchor(random, localBounds, layoutYaw, bounds, arrivalPosition, occupiedAnchors)

	for _ = 1, ProceduralMapConfig.AnchorAttempts do
		local candidate = Vector3.new(
			random:NextNumber(bounds.MinX, bounds.MaxX),
			bounds.Center.Y,
			random:NextNumber(bounds.MinZ, bounds.MaxZ)
		)

		local worldLayoutBounds = getWorldLayoutBounds(candidate, localBounds, layoutYaw)

		if isLayoutWithinBounds(worldLayoutBounds, bounds)
			and isLayoutFree(worldLayoutBounds, occupiedAnchors)
			and isLayoutAwayFromArrival(worldLayoutBounds, arrivalPosition)
		then
			local surfacePosition = getSurfacePosition(candidate.X, candidate.Z, bounds.Center)

			if surfacePosition ~= nil then
				return surfacePosition, worldLayoutBounds
			end
		end
	end

	return nil
end

local function getSourceRotation(part)
	return part.CFrame - part.Position
end

local function getWorldOffset(anchorCFrame, offset)
	return anchorCFrame:VectorToWorldSpace(Vector3.new(offset.X, 0, offset.Y))
end

local function getWorldDirection(anchorCFrame, side)
	local direction = SIDE_DIRECTIONS[side]

	assert(direction ~= nil, "Direction de rampe inconnue : " .. tostring(side))
	return anchorCFrame:VectorToWorldSpace(Vector3.new(direction.X, 0, direction.Y)).Unit
end

local function setGeneratedTerrainProperties(part, name, terrainKind)
	part.Name = name
	part.Anchored = true
	part.CanCollide = true
	-- Le relief est une surface de deplacement et de raycast, pas un declencheur tactile.
	part.CanTouch = false
	part.CanQuery = true
	part.Material = ProceduralMapConfig.GeneratedTerrainMaterial

	-- Les pieces du kit portent des surfaces Studs par defaut. Le relief runtime
	-- doit conserver ses couleurs de biome sans reprendre cet aspect de baseplate.
	part.TopSurface = ProceduralMapConfig.GeneratedTerrainSurface
	part.BottomSurface = ProceduralMapConfig.GeneratedTerrainSurface
	part:SetAttribute(ProceduralMapConfig.GeneratedTerrainAttributeName, true)
	part:SetAttribute(ProceduralMapConfig.TerrainKindAttributeName, terrainKind)
end

local function getTerrainTheme(session)
	local chapter = ChapterConfig.GetChapter(session.ChapterId)
	local themeId = chapter and chapter.TerrainThemeId or ProceduralMapConfig.DefaultTerrainThemeId
	local theme = ProceduralMapConfig.TerrainThemes[themeId]

	if theme == nil then
		themeId = ProceduralMapConfig.DefaultTerrainThemeId
		theme = ProceduralMapConfig.TerrainThemes[themeId]
	end

	assert(theme ~= nil, "Theme de terrain par defaut introuvable.")
	return theme, themeId
end

local function tintTerrainPart(part, colorFamily, paletteIndex, terrainTheme)
	local colors = terrainTheme[colorFamily]

	if colors == nil or #colors == 0 then
		return
	end

	local colorIndex = math.clamp(paletteIndex or 1, 1, #colors)
	part.Color = colors[colorIndex]
end

local function hasRejectedBaseName(instance)
	local current = instance

	while current ~= nil and current ~= Workspace do
		for _, nameFragment in ipairs(ProceduralMapConfig.Base.RejectedSurfaceNameContains) do
			if string.find(current.Name, nameFragment, 1, true) ~= nil then
				return true
			end
		end

		current = current.Parent
	end

	return false
end

local function getHighestWorldY(part)
	local halfSize = part.Size * 0.5
	local highestY = -math.huge

	for _, xSign in ipairs({ -1, 1 }) do
		for _, ySign in ipairs({ -1, 1 }) do
			for _, zSign in ipairs({ -1, 1 }) do
				local corner = part.CFrame:PointToWorldSpace(Vector3.new(
					halfSize.X * xSign,
					halfSize.Y * ySign,
					halfSize.Z * zSign
				))
				highestY = math.max(highestY, corner.Y)
			end
		end
	end

	return highestY
end

local function findBaseSourcePart(map)
	local sourcePart = nil
	local largestArea = ProceduralMapConfig.Base.MinimumSourceArea

	for _, descendant in ipairs(map:GetDescendants()) do
		if descendant:IsA("BasePart")
			and descendant.CFrame.UpVector.Y >= 0.98
			and descendant:GetAttribute(ProceduralMapConfig.GeneratedTerrainAttributeName) ~= true
			and not hasRejectedBaseName(descendant)
		then
			local horizontalArea = descendant.Size.X * descendant.Size.Z

			if horizontalArea > largestArea then
				largestArea = horizontalArea
				sourcePart = descendant
			end
		end
	end

	return sourcePart
end

local function createGeneratedBase(map, templates, terrainTheme, styleRandom)
	local sourcePart = findBaseSourcePart(map)

	if sourcePart == nil then
		DebugLog.Warn("MapGeneration", "Base source introuvable, sol original conserve", {
			Map = map,
			MinimumSourceArea = ProceduralMapConfig.Base.MinimumSourceArea,
		})
		return false
	end

	local baseFolder = getOrCreateFolder(map, ProceduralMapConfig.Base.FolderName)
	baseFolder:SetAttribute(ProceduralMapConfig.IgnoreAsSurfaceAttributeName, false)
	local sourceRotation = sourcePart.CFrame - sourcePart.Position
	local surfaceY = getHighestWorldY(sourcePart) + ProceduralMapConfig.Base.SurfaceOffset
	local paletteIndex = styleRandom:NextInteger(1, #terrainTheme.Grass)
	local top = templates.Top:Clone()
	top.Size = Vector3.new(sourcePart.Size.X, ProceduralMapConfig.TopThickness, sourcePart.Size.Z)
	setGeneratedTerrainProperties(top, "BaseTop", "BaseTop")
	tintTerrainPart(top, "Grass", paletteIndex, terrainTheme)
	top.CFrame = CFrame.new(
		sourcePart.Position.X,
		surfaceY - (ProceduralMapConfig.TopThickness * 0.5),
		sourcePart.Position.Z
	) * sourceRotation
	top.Parent = baseFolder

	local bottomDepth = math.max(
		ProceduralMapConfig.Base.MinimumBottomDepth,
		sourcePart.Size.Y - ProceduralMapConfig.TopThickness
	)
	local bottom = templates.Bottom:Clone()
	bottom.Size = Vector3.new(sourcePart.Size.X, bottomDepth, sourcePart.Size.Z)
	setGeneratedTerrainProperties(bottom, "BaseBottom", "BaseBottom")
	tintTerrainPart(bottom, "Dirt", paletteIndex, terrainTheme)
	bottom.CFrame = CFrame.new(
		sourcePart.Position.X,
		surfaceY - ProceduralMapConfig.TopThickness - (bottomDepth * 0.5),
		sourcePart.Position.Z
	) * sourceRotation
	bottom.Parent = baseFolder

	if ProceduralMapConfig.Base.DestroySourceSurface then
		-- La map est deja un clone runtime. Supprimer la plaque source elimine le
		-- risque de z-fighting et garantit que la base generee est le seul sol.
		sourcePart:Destroy()
	else
		-- Compatibilite temporaire pour un futur mode qui souhaiterait conserver
		-- le support source sans le rendre interactif ni visible.
		sourcePart.Transparency = 1
		sourcePart.CanCollide = false
		sourcePart.CanTouch = false
		sourcePart.CanQuery = false
		sourcePart:SetAttribute(ProceduralMapConfig.IgnoreAsSurfaceAttributeName, true)
	end

	DebugLog.Info("MapGeneration", "Base procedural generee", {
		Source = sourcePart,
		Size = sourcePart.Size,
		SurfaceY = surfaceY,
		PaletteIndex = paletteIndex,
	})

	return true
end

local function createRamp(terrainFolder, rampTemplate, center, platformSize, elevation, side, anchorCFrame, platformIndex, rampIndex, paletteIndex, terrainTheme)
	local direction = getWorldDirection(anchorCFrame, side)
	local followsLocalX = side == "East" or side == "West"
	local horizontalExtent = if followsLocalX then platformSize.X * 0.5 else platformSize.Z * 0.5
	local crossExtent = if followsLocalX then platformSize.Z else platformSize.X
	local rampLength = getRampLength(elevation)
	-- La rampe doit reprendre exactement la largeur du plateau qu'elle raccorde.
	local rampWidth = crossExtent
	local ramp = rampTemplate:Clone()

	-- Le template conserve son axe de pente configure dans Studio.
	ramp.Size = Vector3.new(rampWidth, rampLength, elevation)
	setGeneratedTerrainProperties(ramp, ("Ramp_%d_%d_%s"):format(platformIndex, rampIndex, side), "Ramp")
	tintTerrainPart(ramp, "Ramp", paletteIndex, terrainTheme)

	local rampCenter = center + (direction * (horizontalExtent + (rampLength * 0.5)))
	local rampYaw = math.atan2(direction.X, direction.Z) + ProceduralMapConfig.Ramp.YawCorrection
	ramp.CFrame = CFrame.new(rampCenter.X, center.Y - elevation + (elevation * 0.5), rampCenter.Z)
		* CFrame.Angles(0, rampYaw, 0)
		* getSourceRotation(rampTemplate)
	ramp.Parent = terrainFolder

	return ramp
end

local function createPlatform(terrainFolder, templates, anchorPosition, layoutYaw, definition, platformIndex, elevationScale, paletteIndex, terrainTheme)
	local elevation = getPlatformElevation(definition, elevationScale)
	local anchorCFrame = CFrame.new(anchorPosition) * CFrame.Angles(0, layoutYaw, 0)
	local offset = getWorldOffset(anchorCFrame, definition.Offset)
	local surfacePosition = getSurfacePosition(anchorPosition.X + offset.X, anchorPosition.Z + offset.Z, anchorPosition)

	if surfacePosition == nil then
		return nil
	end

	local platformSize = Vector3.new(definition.Size.X, ProceduralMapConfig.TopThickness, definition.Size.Y)
	local platformCenter = Vector3.new(surfacePosition.X, surfacePosition.Y + elevation - (ProceduralMapConfig.TopThickness * 0.5), surfacePosition.Z)
	local bottomHeight = elevation - ProceduralMapConfig.TopThickness
	local top = templates.Top:Clone()
	top.Size = platformSize
	setGeneratedTerrainProperties(top, "Top_" .. platformIndex, "Top")
	tintTerrainPart(top, "Grass", paletteIndex, terrainTheme)
	top.CFrame = CFrame.new(platformCenter) * CFrame.Angles(0, layoutYaw, 0)
	top.Parent = terrainFolder

	if bottomHeight > 0.1 then
		local bottom = templates.Bottom:Clone()
		bottom.Size = Vector3.new(definition.Size.X, bottomHeight, definition.Size.Y)
		setGeneratedTerrainProperties(bottom, "Bottom_" .. platformIndex, "Bottom")
		tintTerrainPart(bottom, "Dirt", paletteIndex, terrainTheme)
		bottom.CFrame = CFrame.new(surfacePosition.X, surfacePosition.Y + (bottomHeight * 0.5), surfacePosition.Z) * CFrame.Angles(0, layoutYaw, 0)
		bottom.Parent = terrainFolder
	end

	for rampIndex, side in ipairs(definition.Ramps) do
		createRamp(
			terrainFolder,
			templates.Ramp,
			Vector3.new(surfacePosition.X, surfacePosition.Y + elevation, surfacePosition.Z),
			platformSize,
			elevation,
			side,
			anchorCFrame,
			platformIndex,
			rampIndex,
			paletteIndex,
			terrainTheme
		)
	end

	return {
		Center = platformCenter,
		GroundPosition = surfacePosition,
		SurfaceY = surfacePosition.Y + elevation,
		Elevation = elevation,
		Size = definition.Size,
		Yaw = layoutYaw,
		Ramps = definition.Ramps,
	}
end

local function getLayoutSurfaceArea(layout)
	local area = 0

	for _, platform in ipairs(layout.Platforms) do
		area += platform.Size.X * platform.Size.Y
	end

	return area
end

local function getCardinalDirection(fromPosition, toPosition)
	local delta = toPosition - fromPosition

	if math.abs(delta.X) >= math.abs(delta.Z) then
		return if delta.X >= 0 then Vector3.new(1, 0, 0) else Vector3.new(-1, 0, 0)
	end

	return if delta.Z >= 0 then Vector3.new(0, 0, 1) else Vector3.new(0, 0, -1)
end

local function getPlatformEdgePosition(record, direction)
	local localDirection = CFrame.Angles(0, record.Yaw, 0):VectorToObjectSpace(direction)
	local horizontalExtent = if math.abs(localDirection.X) > math.abs(localDirection.Z)
		then record.Size.X * 0.5
		else record.Size.Y * 0.5

	return record.GroundPosition + (direction * (horizontalExtent + ProceduralMapConfig.Links.Clearance))
end

local function createLinkBlock(terrainFolder, templates, startPosition, endPosition, linkIndex, styleRandom, terrainTheme)
	local delta = Vector3.new(endPosition.X - startPosition.X, 0, endPosition.Z - startPosition.Z)
	local length = delta.Magnitude

	if length < ProceduralMapConfig.Links.MinimumLength then
		return 0
	end

	local direction = delta.Unit
	local isAlongX = math.abs(direction.X) > math.abs(direction.Z)
	local segmentCount = math.max(1, math.ceil(length / ProceduralMapConfig.Links.MaximumLength))
	local segmentLength = length / segmentCount
	local placedCount = 0

	for segment = 1, segmentCount do
		local paletteIndex = styleRandom:NextInteger(1, #terrainTheme.Grass)
		local segmentStart = startPosition + (direction * ((segment - 1) * segmentLength))
		local segmentEnd = startPosition + (direction * (segment * segmentLength))
		local midpoint = (segmentStart + segmentEnd) * 0.5
		local surfacePosition = getSurfacePosition(midpoint.X, midpoint.Z, midpoint)

		if surfacePosition ~= nil then
			local elevation = ProceduralMapConfig.Links.Elevation
			local topSize = if isAlongX
				then Vector3.new(segmentLength, ProceduralMapConfig.TopThickness, ProceduralMapConfig.Links.Width)
				else Vector3.new(ProceduralMapConfig.Links.Width, ProceduralMapConfig.TopThickness, segmentLength)
			local bottomHeight = math.max(1, elevation - ProceduralMapConfig.TopThickness)
			local top = templates.Top:Clone()
			top.Size = topSize
			setGeneratedTerrainProperties(top, ("LinkTop_%d_%d"):format(linkIndex, segment), "LinkTop")
			tintTerrainPart(top, "Grass", paletteIndex, terrainTheme)
			top.CFrame = CFrame.new(
				surfacePosition.X,
				surfacePosition.Y + elevation - (ProceduralMapConfig.TopThickness * 0.5),
				surfacePosition.Z
			)
			top.Parent = terrainFolder

			local bottom = templates.Bottom:Clone()
			bottom.Size = Vector3.new(topSize.X, bottomHeight, topSize.Z)
			setGeneratedTerrainProperties(bottom, ("LinkBottom_%d_%d"):format(linkIndex, segment), "LinkBottom")
			tintTerrainPart(bottom, "Dirt", paletteIndex, terrainTheme)
			bottom.CFrame = CFrame.new(
				surfacePosition.X,
				surfacePosition.Y + (bottomHeight * 0.5),
				surfacePosition.Z
			)
			bottom.Parent = terrainFolder
			placedCount += 1
		end
	end

	return placedCount
end

local function createLayoutConnection(terrainFolder, templates, fromRecord, toRecord, linkIndex, styleRandom, terrainTheme)
	local directDistance = getHorizontalDistance(fromRecord.GroundPosition, toRecord.GroundPosition)

	if directDistance > ProceduralMapConfig.Links.MaximumConnectionDistance then
		return 0
	end

	local firstDirection = getCardinalDirection(fromRecord.GroundPosition, toRecord.GroundPosition)
	local secondDirection = getCardinalDirection(toRecord.GroundPosition, fromRecord.GroundPosition)
	local startPosition = getPlatformEdgePosition(fromRecord, firstDirection)
	local endPosition = getPlatformEdgePosition(toRecord, secondDirection)
	local elbow = Vector3.new(endPosition.X, startPosition.Y, startPosition.Z)
	local created = createLinkBlock(terrainFolder, templates, startPosition, elbow, linkIndex, styleRandom, terrainTheme)

	return created + createLinkBlock(terrainFolder, templates, elbow, endPosition, linkIndex + 1, styleRandom, terrainTheme)
end

local function createLayoutLinks(terrainFolder, templates, selectedLayouts, styleRandom, terrainTheme)
	if not ProceduralMapConfig.Links.Enabled or #selectedLayouts < 2 then
		return 0
	end

	local linked = { [1] = true }
	local linkCount = 0
	local placedCount = 0

	while true do
		local nearestFromIndex = nil
		local nearestToIndex = nil
		local nearestDistance = math.huge

		for fromIndex, fromLayout in ipairs(selectedLayouts) do
			if linked[fromIndex] and fromLayout.PlatformRecords ~= nil and fromLayout.PlatformRecords[1] ~= nil then
				for toIndex, toLayout in ipairs(selectedLayouts) do
					if not linked[toIndex] and toLayout.PlatformRecords ~= nil and toLayout.PlatformRecords[1] ~= nil then
						local distance = getHorizontalDistance(
							fromLayout.PlatformRecords[1].GroundPosition,
							toLayout.PlatformRecords[1].GroundPosition
						)

						if distance < nearestDistance then
							nearestDistance = distance
							nearestFromIndex = fromIndex
							nearestToIndex = toIndex
						end
					end
				end
			end
		end

		if nearestFromIndex == nil or nearestToIndex == nil then
			break
		end

		linkCount += 2
		placedCount += createLayoutConnection(
			terrainFolder,
			templates,
			selectedLayouts[nearestFromIndex].PlatformRecords[1],
			selectedLayouts[nearestToIndex].PlatformRecords[1],
			linkCount,
			styleRandom,
			terrainTheme
		)
		linked[nearestToIndex] = true
	end

	return placedCount
end

local function getDecorationTemplateHeight(template)
	if template:IsA("BasePart") then
		return math.max(0.01, template.Size.Y)
	end

	local _, size = template:GetBoundingBox()
	return math.max(0.01, size.Y)
end

local function getDecorationPivotRotation(instance)
	local pivot = instance:GetPivot()
	return pivot - pivot.Position
end

local function getDecorationParts(decoration)
	local parts = {}

	if decoration:IsA("BasePart") then
		table.insert(parts, decoration)
	end

	for _, descendant in ipairs(decoration:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end

	return parts
end

local function shouldDecorationPartCollide(part, collisionMode, maximumHorizontalArea)
	if collisionMode == "All" then
		return true
	end

	if collisionMode == "TreeTrunk" then
		local horizontalArea = part.Size.X * part.Size.Z
		return part.Size.Y >= 8 and horizontalArea <= (maximumHorizontalArea or 0)
	end

	return false
end

local function prepareDecoration(decoration, collisionMode, maximumHorizontalArea)
	decoration:SetAttribute(ProceduralMapConfig.GeneratedDecorationAttributeName, true)
	decoration:SetAttribute(ProceduralMapConfig.IgnoreAsSurfaceAttributeName, true)

	for _, part in ipairs(getDecorationParts(decoration)) do
		part.Anchored = true
		part.CanCollide = shouldDecorationPartCollide(part, collisionMode, maximumHorizontalArea)
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		part:SetAttribute(ProceduralMapConfig.GeneratedDecorationAttributeName, true)
		part:SetAttribute(ProceduralMapConfig.IgnoreAsSurfaceAttributeName, true)
	end
end

local function getDecorationBounds(decoration)
	if decoration:IsA("BasePart") then
		return decoration.CFrame, decoration.Size
	end

	return decoration:GetBoundingBox()
end

local function createDecorationCollisionBounds(decoration, cframe, size)
	local collision = Instance.new("Part")
	collision.Name = "Collision"
	collision.Size = size
	collision.CFrame = cframe
	collision.Transparency = 1
	collision.CastShadow = false
	collision.Anchored = true
	collision.CanCollide = true
	collision.CanTouch = false
	collision.CanQuery = false
	collision.Massless = true
	collision:SetAttribute(ProceduralMapConfig.GeneratedDecorationAttributeName, true)
	collision:SetAttribute(ProceduralMapConfig.IgnoreAsSurfaceAttributeName, true)
	collision.Parent = decoration

	return collision
end

local function scaleDecoration(decoration, scale)
	if decoration:IsA("BasePart") then
		decoration.Size = decoration.Size * scale
		return
	end

	decoration:ScaleTo(scale)
end

local function buildDecorationCatalog(kit)
	local templateFolder = kit:FindFirstChild(ProceduralMapConfig.Decorations.TemplateFolderName)

	if templateFolder == nil or not templateFolder:IsA("Folder") then
		DebugLog.Warn("MapGeneration", "Dossier de decorations introuvable dans le kit procedural", {
			Kit = kit,
			Expected = ProceduralMapConfig.Decorations.TemplateFolderName,
		})
		return nil
	end

	local catalog = {}
	local hasAnyTemplate = false

	for familyName, family in pairs(ProceduralMapConfig.Decorations.Families) do
		local assets = {}

		for _, asset in ipairs(family.Assets) do
			local template = templateFolder:FindFirstChild(asset.Name)

			if template ~= nil and (template:IsA("Model") or template:IsA("BasePart")) then
				table.insert(assets, {
					Config = asset,
					Template = template,
					TemplateHeight = getDecorationTemplateHeight(template),
					CollisionMode = family.CollisionMode,
					CollisionMaximumHorizontalArea = family.CollisionMaximumHorizontalArea,
				})
				hasAnyTemplate = true
			else
				DebugLog.Warn("MapGeneration", "Asset de decor absent ou invalide", {
					Family = familyName,
					Asset = asset.Name,
				})
			end
		end

		catalog[familyName] = assets
	end

	if not hasAnyTemplate then
		DebugLog.Warn("MapGeneration", "Aucun asset de decor exploitable dans le kit procedural", {
			Folder = templateFolder,
		})
		return nil
	end

	return catalog
end

local function selectWeightedDecorationAsset(random, assets)
	local totalWeight = 0

	for _, asset in ipairs(assets) do
		totalWeight += asset.Config.Weight
	end

	if totalWeight <= 0 then
		return nil
	end

	local selection = random:NextNumber(0, totalWeight)

	for _, asset in ipairs(assets) do
		selection -= asset.Config.Weight

		if selection <= 0 then
			return asset
		end
	end

	return assets[#assets]
end

local function isDecorationRecordEligible(record, family)
	local area = record.Size.X * record.Size.Y

	return area >= family.MinimumPlatformArea
		and record.Elevation >= family.MinimumElevation
		and record.Elevation <= family.MaximumElevation
end

local function getDecorationTargetCount(random, record, family)
	local expectedCount = (record.Size.X * record.Size.Y / 1000) * family.DensityPerThousandStuds
	local count = math.floor(expectedCount)

	if random:NextNumber() < (expectedCount - count) then
		count += 1
	end

	return math.clamp(
		math.max(family.MinimumPerPlatform, count),
		family.MinimumPerPlatform,
		family.MaximumPerPlatform
	)
end

local function isDecorationPositionAvailable(position, radius, occupiedPositions, arrivalPosition)
	if arrivalPosition ~= nil and getHorizontalDistance(position, arrivalPosition) < ProceduralMapConfig.Decorations.ArrivalClearRadius then
		return false
	end

	for _, occupied in ipairs(occupiedPositions) do
		if getHorizontalDistance(position, occupied.Position) < radius + occupied.Radius then
			return false
		end
	end

	return true
end

local function getDecorationPosition(random, record, family, occupiedPositions, arrivalPosition)
	local maximumMargin = math.min(record.Size.X, record.Size.Y) * 0.35
	local margin = math.min(ProceduralMapConfig.Decorations.PlatformMargin, maximumMargin)
	local halfWidth = record.Size.X * 0.5
	local halfDepth = record.Size.Y * 0.5

	if halfWidth <= margin or halfDepth <= margin then
		return nil
	end

	local platformCFrame = CFrame.new(record.Center.X, record.SurfaceY, record.Center.Z) * CFrame.Angles(0, record.Yaw, 0)

	for _ = 1, ProceduralMapConfig.Decorations.PlacementAttemptsPerInstance do
		local localPosition = Vector3.new(
			random:NextNumber(-halfWidth + margin, halfWidth - margin),
			0,
			random:NextNumber(-halfDepth + margin, halfDepth - margin)
		)
		local worldPosition = platformCFrame:PointToWorldSpace(localPosition)
		local position = Vector3.new(worldPosition.X, record.SurfaceY, worldPosition.Z)

		if isDecorationPositionAvailable(position, family.FootprintRadius, occupiedPositions, arrivalPosition) then
			return position
		end
	end

	return nil
end

local function getGroundDecorationTargetCount(random, bounds, family)
	local groundConfig = ProceduralMapConfig.Decorations.Ground
	local usableWidth = (bounds.MaxX - bounds.MinX) - (groundConfig.EdgeInset * 2)
	local usableDepth = (bounds.MaxZ - bounds.MinZ) - (groundConfig.EdgeInset * 2)

	if usableWidth <= 0 or usableDepth <= 0 then
		return 0
	end

	local expectedCount = (usableWidth * usableDepth / 1000)
		* family.DensityPerThousandStuds
		* groundConfig.DensityMultiplier
	local count = math.floor(expectedCount)

	if random:NextNumber() < (expectedCount - count) then
		count += 1
	end

	return math.min(count, family.MaximumGroundInstances or math.huge)
end

local function getGroundDecorationPosition(random, map, bounds, family, occupiedPositions, arrivalPosition)
	local groundConfig = ProceduralMapConfig.Decorations.Ground
	local minimumX = bounds.MinX + groundConfig.EdgeInset
	local maximumX = bounds.MaxX - groundConfig.EdgeInset
	local minimumZ = bounds.MinZ + groundConfig.EdgeInset
	local maximumZ = bounds.MaxZ - groundConfig.EdgeInset

	if minimumX >= maximumX or minimumZ >= maximumZ then
		return nil
	end

	for _ = 1, ProceduralMapConfig.Decorations.PlacementAttemptsPerInstance do
		local surfacePosition = getSurfacePosition(
			random:NextNumber(minimumX, maximumX),
			random:NextNumber(minimumZ, maximumZ),
			bounds.Center
		)

		if surfacePosition ~= nil
			and ProceduralMapService.IsAreaClear(map, surfacePosition, groundConfig.TerrainClearance)
			and isDecorationPositionAvailable(surfacePosition, family.FootprintRadius, occupiedPositions, arrivalPosition)
		then
			return surfacePosition
		end
	end

	return nil
end

local function createFoliageDecoration(folder, random, asset, position, yaw, name)
	local decoration = asset.Template:Clone()
	local targetHeight = random:NextNumber(asset.Config.MinimumHeight, asset.Config.MaximumHeight)
	local scale = targetHeight / asset.TemplateHeight

	scaleDecoration(decoration, scale)
	prepareDecoration(decoration, asset.CollisionMode, asset.CollisionMaximumHorizontalArea)
	decoration.Name = name
	decoration.Parent = folder
	decoration:PivotTo(
		CFrame.new(position) * CFrame.Angles(0, yaw, 0) * getDecorationPivotRotation(asset.Template)
	)

	local boundsCFrame, boundsSize = getDecorationBounds(decoration)
	local bottomY = boundsCFrame.Position.Y - (boundsSize.Y * 0.5)
	decoration:PivotTo(decoration:GetPivot() + Vector3.new(0, position.Y + ProceduralMapConfig.Decorations.VerticalPadding - bottomY, 0))

	if asset.CollisionMode == "Bounds" then
		local collisionCFrame, collisionSize = getDecorationBounds(decoration)
		createDecorationCollisionBounds(decoration, collisionCFrame, collisionSize)
	end

	return decoration
end

local function generateFoliage(random, map, bounds, decorationFolder, catalog, platformRecords, arrivalPosition, onProgress)
	local placedCount = 0
	local attemptedCount = 0
	local byFamily = {}
	local occupiedPositions = {}

	for _, familyName in ipairs(ProceduralMapConfig.Decorations.FamilyOrder) do
		if placedCount >= ProceduralMapConfig.Decorations.MaximumInstances then
			break
		end

		local family = ProceduralMapConfig.Decorations.Families[familyName]
		local assets = catalog[familyName]
		local familyCount = 0
		local maximumFamilyInstances = if family ~= nil then family.MaximumInstancesPerMap or math.huge else 0

		if family ~= nil and assets ~= nil and #assets > 0 then
			local function tryPlaceDecoration(position)
				if position == nil then
					return
				end

				local asset = selectWeightedDecorationAsset(random, assets)

				if asset == nil then
					return
				end

				createFoliageDecoration(
					decorationFolder,
					random,
					asset,
					position,
					random:NextNumber(0, math.pi * 2),
					("%s_%d"):format(familyName, placedCount + 1)
				)
				table.insert(occupiedPositions, {
					Position = position,
					Radius = family.FootprintRadius,
				})
				placedCount += 1
				familyCount += 1
			end

			local function reportAttemptProgress()
				if attemptedCount % ProceduralMapConfig.DecorationBatchSize == 0 then
					if onProgress ~= nil then
						onProgress("Decorations", ("Foliage : %d / %d"):format(
							placedCount,
							ProceduralMapConfig.Decorations.MaximumInstances
						))
					end
					task.wait()
				end
			end

			for _, record in ipairs(platformRecords) do
				if placedCount >= ProceduralMapConfig.Decorations.MaximumInstances or familyCount >= maximumFamilyInstances then
					break
				end

				if isDecorationRecordEligible(record, family) then
					local targetCount = getDecorationTargetCount(random, record, family)

					for _ = 1, targetCount do
						if placedCount >= ProceduralMapConfig.Decorations.MaximumInstances or familyCount >= maximumFamilyInstances then
							break
						end

						attemptedCount += 1
						local position = getDecorationPosition(random, record, family, occupiedPositions, arrivalPosition)
						tryPlaceDecoration(position)
						reportAttemptProgress()
					end
				end
			end

			local groundTargetCount = getGroundDecorationTargetCount(random, bounds, family)

			for _ = 1, groundTargetCount do
				if placedCount >= ProceduralMapConfig.Decorations.MaximumInstances or familyCount >= maximumFamilyInstances then
					break
				end

				attemptedCount += 1
				local position = getGroundDecorationPosition(random, map, bounds, family, occupiedPositions, arrivalPosition)
				tryPlaceDecoration(position)
				reportAttemptProgress()
			end
		end

		byFamily[familyName] = familyCount
	end

	if onProgress ~= nil then
		onProgress("Decorations", ("Foliage : %d"):format(placedCount))
	end

	return placedCount, byFamily
end

function ProceduralMapService.Clear(map)
	if map == nil then
		return
	end

	for _, folderName in ipairs({
		ProceduralMapConfig.Base.FolderName,
		ProceduralMapConfig.TerrainFolderName,
		ProceduralMapConfig.DecorationFolderName,
	}) do
		local folder = map:FindFirstChild(folderName)

		if folder ~= nil then
			folder:Destroy()
		end
	end
end

function ProceduralMapService.IsAreaClear(map, position, clearance, options)
	if map == nil or position == nil then
		return true
	end

	local terrainFolder = map:FindFirstChild(ProceduralMapConfig.TerrainFolderName)

	if terrainFolder == nil then
		return true
	end

	local padding = math.max(0, clearance or 0)
	local allowSupportingTerrain = options ~= nil and options.AllowSupportingTerrain == true

	for _, descendant in ipairs(terrainFolder:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local localPosition = descendant.CFrame:PointToObjectSpace(position)
			local halfSize = descendant.Size * 0.5
			local isInsideFootprint = math.abs(localPosition.X) <= halfSize.X
				and math.abs(localPosition.Z) <= halfSize.Z
			local terrainKind = descendant:GetAttribute(ProceduralMapConfig.TerrainKindAttributeName)

			-- Une plateforme peut servir de sol au portail. Seuls ses volumes
			-- directement sous le point de pose sont ignores, pas les plateformes voisines.
			if allowSupportingTerrain
				and isInsideFootprint
				and (terrainKind == "Top" or terrainKind == "Bottom" or terrainKind == "LinkTop" or terrainKind == "LinkBottom")
			then
				continue
			end

			if math.abs(localPosition.X) <= halfSize.X + padding
				and math.abs(localPosition.Z) <= halfSize.Z + padding
			then
				return false
			end
		end
	end

	return true
end

function ProceduralMapService.Generate(session, map, arrival, onProgress)
	if not ProceduralMapConfig.Enabled then
		return true, {
			Layouts = 0,
			Platforms = 0,
			Foliage = 0,
			FoliageByFamily = {},
		}
	end

	if map == nil or map.Parent == nil then
		return false, "MapRuntimeMissing"
	end

	local kit = getKit()

	if kit == nil then
		return false, "ProceduralKitMissing"
	end

	local templates = {
		Top = getTemplatePart(kit, "TopBasePlateform"),
		Bottom = getTemplatePart(kit, "BotBasePlateform"),
		Ramp = getTemplatePart(kit, "RampBasePlateform"),
	}

	for name, template in pairs(templates) do
		if template == nil then
			return false, "TemplateMissing_" .. name
		end
	end

	local decorationCatalog = buildDecorationCatalog(kit)

	if decorationCatalog == nil then
		return false, "DecorationTemplatesMissing"
	end

	ProceduralMapService.Clear(map)
	local terrainFolder = getOrCreateFolder(map, ProceduralMapConfig.TerrainFolderName)
	local decorationFolder = getOrCreateFolder(map, ProceduralMapConfig.DecorationFolderName)
	decorationFolder:SetAttribute(ProceduralMapConfig.IgnoreAsSurfaceAttributeName, true)

	local seed = math.floor(tonumber(session.Seed) or 0)
	local random = Random.new(seed + 413)
	local styleRandom = Random.new(seed + 977)
	local terrainTheme, terrainThemeId = getTerrainTheme(session)
	local baseGenerated = createGeneratedBase(map, templates, terrainTheme, styleRandom)
	local bounds = getUsableBounds(map)
	local arrivalPosition = WorldSpawnService.GetInstancePosition(arrival)
	local selectedLayouts = {}
	local occupiedAnchors = {}
	local usableArea = math.max(1, (bounds.MaxX - bounds.MinX) * (bounds.MaxZ - bounds.MinZ))
	local targetSurfaceArea = usableArea * ProceduralMapConfig.TargetCoverageRatio
	local coveredSurfaceArea = 0
	local plannedPlatformCount = 0

	while #selectedLayouts < ProceduralMapConfig.MaximumLayoutCount
		and (#selectedLayouts < ProceduralMapConfig.MinimumLayoutCount or coveredSurfaceArea < targetSurfaceArea)
	do
		local attemptedIds = {}
		local selected = false

		for _ = 1, #ProceduralMapConfig.Layouts do
			local excludedIds = {}

			for id in pairs(attemptedIds) do
				excludedIds[id] = true
			end

			local layout = pickWeightedLayout(random, excludedIds)

			if layout == nil then
				break
			end

			if plannedPlatformCount + #layout.Platforms > ProceduralMapConfig.MaximumGeneratedPlatforms then
				attemptedIds[layout.Id] = true
				continue
			end

			local elevationScale = random:NextNumber(
				ProceduralMapConfig.ElevationScaleMinimum,
				ProceduralMapConfig.ElevationScaleMaximum
			)
			local layoutYaw = random:NextInteger(0, 3) * (math.pi * 0.5)
			local localBounds = getLayoutLocalBounds(layout, elevationScale)
			local anchor, worldLayoutBounds = findLayoutAnchor(
				random,
				localBounds,
				layoutYaw,
				bounds,
				arrivalPosition,
				occupiedAnchors
			)
			attemptedIds[layout.Id] = true

			if anchor ~= nil then
				table.insert(selectedLayouts, {
					Definition = layout,
					Anchor = anchor,
					Yaw = layoutYaw,
					ElevationScale = elevationScale,
					PlatformRecords = {},
				})
				table.insert(occupiedAnchors, {
					Bounds = worldLayoutBounds,
				})
				coveredSurfaceArea += getLayoutSurfaceArea(layout)
				plannedPlatformCount += #layout.Platforms
				selected = true
				break
			end
		end

		if not selected then
			DebugLog.Warn("MapGeneration", "Couverture relief plafonnee par la surface disponible", {
				RunId = session.RunId,
				Placed = #selectedLayouts,
				CoveredRatio = coveredSurfaceArea / usableArea,
				TargetRatio = ProceduralMapConfig.TargetCoverageRatio,
			})
			break
		end
	end

	if #selectedLayouts < ProceduralMapConfig.MinimumLayoutCount then
		ProceduralMapService.Clear(map)
		DebugLog.Warn("MapGeneration", "Generation relief insuffisante", {
			Minimum = ProceduralMapConfig.MinimumLayoutCount,
			Placed = #selectedLayouts,
			RunId = session.RunId,
		})
		return false, "TerrainPlacementInsufficient"
	end

	local totalPlatformCount = 0
	local totalRampCount = 0

	for _, selectedLayout in ipairs(selectedLayouts) do
		for _, platformDefinition in ipairs(selectedLayout.Definition.Platforms) do
			totalPlatformCount += 1
			totalRampCount += #(platformDefinition.Ramps or {})
		end
	end

	local platformRecords = {}
	local placedPlatforms = 0

	for _, selectedLayout in ipairs(selectedLayouts) do
		for _, platformDefinition in ipairs(selectedLayout.Definition.Platforms) do
			local paletteIndex = styleRandom:NextInteger(1, #terrainTheme.Grass)
			local record = createPlatform(
				terrainFolder,
				templates,
				selectedLayout.Anchor,
				selectedLayout.Yaw,
				platformDefinition,
				placedPlatforms + 1,
				selectedLayout.ElevationScale,
				paletteIndex,
				terrainTheme
			)

			if record ~= nil then
				table.insert(platformRecords, record)
				table.insert(selectedLayout.PlatformRecords, record)
				placedPlatforms += 1
			end

			if placedPlatforms % ProceduralMapConfig.TerrainBatchSize == 0 or placedPlatforms == totalPlatformCount then
				if onProgress ~= nil then
					onProgress("Terrain", ("Relief : %d / %d"):format(placedPlatforms, totalPlatformCount))
				end
				task.wait()
			end
		end
	end

	if placedPlatforms == 0 then
		ProceduralMapService.Clear(map)
		return false, "TerrainSurfaceMissing"
	end

	local linkCount = createLayoutLinks(terrainFolder, templates, selectedLayouts, styleRandom, terrainTheme)

	local foliageCount, foliageByFamily = generateFoliage(
		random,
		map,
		bounds,
		decorationFolder,
		decorationCatalog,
		platformRecords,
		arrivalPosition,
		onProgress
	)

	DebugLog.Info("MapGeneration", "Relief procedural genere", {
		RunId = session.RunId,
		Seed = session.Seed,
		Theme = terrainThemeId,
		BaseGenerated = baseGenerated,
		Layouts = #selectedLayouts,
		Platforms = placedPlatforms,
		Links = linkCount,
		CoveredRatio = coveredSurfaceArea / usableArea,
		TargetCoverageRatio = ProceduralMapConfig.TargetCoverageRatio,
		Foliage = foliageCount,
		FoliageByFamily = foliageByFamily,
	})

	return true, {
		Layouts = #selectedLayouts,
		Platforms = placedPlatforms,
		PlannedPlatforms = totalPlatformCount,
		PlannedRamps = totalRampCount,
		Links = linkCount,
		CoverageRatio = coveredSurfaceArea / usableArea,
		Foliage = foliageCount,
		FoliageByFamily = foliageByFamily,
		Theme = terrainThemeId,
		BaseGenerated = baseGenerated,
	}
end

return ProceduralMapService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="84">
        <Properties>
          <string name="Name">ProjectileVisualService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local VfxConfig = require(Shared:WaitForChild("VfxConfig"))
local WeaponSkinConfig = require(Shared:WaitForChild("WeaponSkinConfig"))

local ProjectileVisualService = {}

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")
	return remote
end

local impactRemote = getOrCreateRemote(VfxConfig.ImpactRemoteName)

local function findFireballSkin(skinId)
	local weapon = WeaponSkinConfig.Weapons.fireball
	local requestedId = skinId or weapon.DefaultSkinId

	for _, skin in ipairs(weapon.Skins) do
		if skin.Id == requestedId then
			return skin
		end
	end

	return weapon.Skins[1]
end

local function disableLegacyVisuals(projectile)
	for _, descendant in ipairs(projectile:GetDescendants()) do
		if descendant:IsA("ParticleEmitter")
			or descendant:IsA("Trail")
			or descendant:IsA("Fire")
			or descendant:IsA("Smoke")
			or descendant:IsA("Sparkles")
		then
			descendant.Enabled = false
		elseif descendant:IsA("PointLight") or descendant:IsA("SpotLight") or descendant:IsA("SurfaceLight") then
			descendant.Enabled = false
		end
	end
end

-- Le serveur ne garde que le noyau lisible et les attributs de presentation.
-- Les particules, trails et impacts sont exclusifs au client du proprietaire.
function ProjectileVisualService.PrepareFireball(projectile, root, player, skinId, visualSerial)
	if projectile == nil or root == nil or player == nil then
		return nil
	end

	local skin = findFireballSkin(skinId)
	local profileId = skin.VfxProfileId or skin.Id
	local profile = VfxConfig.GetProjectileProfile(profileId)

	disableLegacyVisuals(projectile)
	root.Material = Enum.Material.Neon
	root.Color = profile.CoreColor
	root.Transparency = profile.CoreTransparency

	projectile:SetAttribute("WeaponId", WeaponSkinConfig.Weapons.fireball.Id)
	projectile:SetAttribute("ProjectileVisualSerial", visualSerial)
	projectile:SetAttribute("VfxProfileId", profileId)
	projectile:SetAttribute("ProjectileSkinId", skin.Id)
	projectile:SetAttribute("ProjectileOwnerUserId", player.UserId)

	DebugLog.ThrottledInfo("Vfx", "fireball_prepare_" .. profileId, 3, "Noyau Fireball prepare", {
		Player = player.Name,
		ProfileId = profileId,
		Projectile = projectile,
	})

	return profileId
end

function ProjectileVisualService.PlayProjectileImpact(player, profileId, position, seed)
	if player == nil or player.Parent == nil or typeof(position) ~= "Vector3" then
		return
	end

	impactRemote:FireClient(player, {
		Type = "Impact",
		ProfileId = profileId,
		Position = position,
		Seed = math.max(0, math.floor(tonumber(seed) or 0)),
	})
end

function ProjectileVisualService.PlayClientProjectileSpawn(player, payload)
	if player == nil or player.Parent == nil or typeof(payload) ~= "table" then
		return
	end

	impactRemote:FireClient(player, payload)
end

function ProjectileVisualService.PlayClientProjectileDestroy(player, visualSerial)
	if player == nil or player.Parent == nil then
		return
	end

	impactRemote:FireClient(player, {
		Type = "ProjectileDestroy",
		VisualSerial = math.max(0, math.floor(tonumber(visualSerial) or 0)),
	})
end

-- Le rebond reste une decision serveur ; le client ne recoit qu'une correction visuelle fiable.
function ProjectileVisualService.PlayClientProjectileRetarget(player, payload)
	if player == nil or player.Parent == nil or typeof(payload) ~= "table" then
		return
	end

	impactRemote:FireClient(player, payload)
end

return ProjectileVisualService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="85">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")

local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Questions = require(Shared:WaitForChild("Questions"))
local JumpBonusService = require(script.Parent:WaitForChild("JumpBonusService"))
local ScoreService = require(script.Parent:WaitForChild("ScoreService"))

local RoundService = {}

local rng = Random.new()
local isRunning = false
local currentRoundId = 0
local currentQuestion = nil
local answersByUserId = {}

local remotes = {
	ShowQuestion = nil,
	SubmitAnswer = nil,
	ShowResult = nil,
	UpdateScore = nil,
}

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local function setupRemotes()
	remotes.ShowQuestion = getOrCreateRemote("Quiz_ShowQuestion")
	remotes.SubmitAnswer = getOrCreateRemote("Quiz_SubmitAnswer")
	remotes.ShowResult = getOrCreateRemote("Quiz_ShowResult")
	remotes.UpdateScore = getOrCreateRemote("Quiz_UpdateScore")
end

local function getPlayerCount()
	return #Players:GetPlayers()
end

local function hasEnoughPlayers()
	return getPlayerCount() >= GameConfig.MinPlayers
end

local function copyAnswers(answers)
	local copiedAnswers = {}

	for index, answer in ipairs(answers) do
		copiedAnswers[index] = answer
	end

	return copiedAnswers
end

local function chooseQuestion()
	assert(#Questions > 0, "Aucune question de quiz n'est configuree.")

	return Questions[rng:NextInteger(1, #Questions)]
end

local function sendStatus(message)
	remotes.ShowResult:FireAllClients({
		State = "Status",
		Message = message,
	})
end

local function waitForEnoughPlayers()
	while not hasEnoughPlayers() do
		sendStatus(("En attente de joueurs (%d/%d)."):format(getPlayerCount(), GameConfig.MinPlayers))
		task.wait(1)
	end
end

local function runLobby()
	for remaining = GameConfig.LobbyDuration, 1, -1 do
		if not hasEnoughPlayers() then
			return false
		end

		sendStatus(("Prochaine question dans %d s."):format(remaining))
		task.wait(1)
	end

	return true
end

local function sendQuestion(question)
	remotes.ShowQuestion:FireAllClients({
		RoundId = currentRoundId,
		Prompt = question.Prompt,
		Answers = copyAnswers(question.Answers),
		TimeLimit = GameConfig.QuestionDuration,
	})
end

local function sendPlayerResult(player, question, selectedAnswerIndex, wasCorrect, score, effectMessage)
	remotes.ShowResult:FireClient(player, {
		State = "Result",
		WasCorrect = wasCorrect,
		SelectedAnswerIndex = selectedAnswerIndex or 0,
		CorrectAnswerIndex = question.CorrectAnswerIndex,
		CorrectAnswerText = question.Answers[question.CorrectAnswerIndex],
		Score = score,
		EffectMessage = effectMessage,
	})

	remotes.UpdateScore:FireClient(player, score)
end

local function finishQuestion(participants, question)
	for _, player in ipairs(participants) do
		if player.Parent == Players then
			local selectedAnswerIndex = answersByUserId[player.UserId]
			local wasCorrect = selectedAnswerIndex == question.CorrectAnswerIndex
			local score = ScoreService.GetScore(player)
			local effectMessage = "Aucun effet."

			if wasCorrect then
				score = ScoreService.AddPoints(player, GameConfig.PointsPerCorrectAnswer)
				effectMessage = JumpBonusService.GrantDoubleJump(player)
			elseif selectedAnswerIndex ~= nil then
				effectMessage = JumpBonusService.ApplyJumpMalus(player)
			end

			sendPlayerResult(player, question, selectedAnswerIndex, wasCorrect, score, effectMessage)
		end
	end
end

local function runQuestion()
	local participants = Players:GetPlayers()

	currentRoundId += 1
	currentQuestion = chooseQuestion()
	answersByUserId = {}

	sendQuestion(currentQuestion)
	task.wait(GameConfig.QuestionDuration)

	finishQuestion(participants, currentQuestion)

	currentQuestion = nil
	answersByUserId = {}

	task.wait(GameConfig.ResultDuration)
end

local function onSubmitAnswer(player, roundId, answerIndex)
	if currentQuestion == nil then
		return
	end

	if typeof(roundId) ~= "number" or typeof(answerIndex) ~= "number" then
		return
	end

	if roundId ~= currentRoundId then
		return
	end

	if answerIndex ~= math.floor(answerIndex) then
		return
	end

	if answerIndex == 0 then
		answersByUserId[player.UserId] = nil
		return
	end

	if answerIndex < 1 or answerIndex > #currentQuestion.Answers then
		return
	end

	answersByUserId[player.UserId] = answerIndex
end

function RoundService.RemovePlayer(player)
	answersByUserId[player.UserId] = nil
end

function RoundService.Start()
	if isRunning then
		return
	end

	isRunning = true
	setupRemotes()
	remotes.SubmitAnswer.OnServerEvent:Connect(onSubmitAnswer)

	while true do
		waitForEnoughPlayers()

		if runLobby() then
			runQuestion()
		end
	end
end

return RoundService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="86">
        <Properties>
          <string name="Name">RunActionCreditService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local RunActionCreditConfig = require(Shared:WaitForChild("RunActionCreditConfig"))

local RunStateService = require(script.Parent:WaitForChild("RunStateService"))

local RunActionCreditService = {}

export type ActionId = "Pass" | "Ban"

type Profile = {
	PassCredits: number,
	BanCredits: number,
}

local profilesByUserId: { [number]: Profile } = {}
local isStarted = false

local function normalizeCredit(value: number?): number
	return math.max(0, math.floor(tonumber(value) or 0))
end

local function getOrCreateProfile(player: Player): Profile
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		profile = {
			PassCredits = 0,
			BanCredits = 0,
		}
		profilesByUserId[player.UserId] = profile
	end

	return profile
end

local function publish(player: Player, profile: Profile)
	if player.Parent ~= Players then
		return
	end

	player:SetAttribute("RunPassCredits", normalizeCredit(profile.PassCredits))
	player:SetAttribute("RunBanCredits", normalizeCredit(profile.BanCredits))
	player:SetAttribute("RunPassCreditsMax", RunActionCreditConfig.MaxPassCreditsPerRun)
	player:SetAttribute("RunBanCreditsMax", RunActionCreditConfig.MaxBanCreditsPerRun)
end

local function resetForRun(player: Player)
	local profile = getOrCreateProfile(player)
	profile.PassCredits = RunActionCreditConfig.MaxPassCreditsPerRun
	profile.BanCredits = RunActionCreditConfig.MaxBanCreditsPerRun
	publish(player, profile)

	DebugLog.Info("RunActions", "Credits de choix initialises pour la run", {
		Player = player.Name,
		PassCredits = profile.PassCredits,
		BanCredits = profile.BanCredits,
	})
end

local function clearForLobby(player: Player)
	local profile = getOrCreateProfile(player)
	profile.PassCredits = 0
	profile.BanCredits = 0
	publish(player, profile)
end

function RunActionCreditService.SetupPlayer(player: Player)
	publish(player, getOrCreateProfile(player))
end

function RunActionCreditService.RemovePlayer(player: Player)
	profilesByUserId[player.UserId] = nil
end

function RunActionCreditService.GetCredits(player: Player): (number, number)
	local profile = getOrCreateProfile(player)
	return normalizeCredit(profile.PassCredits), normalizeCredit(profile.BanCredits)
end

function RunActionCreditService.TryConsume(player: Player, action: ActionId): (boolean, string?)
	if not RunStateService.IsRunActive(player) then
		return false, "RunInactive"
	end

	local profile = getOrCreateProfile(player)

	if action == "Pass" then
		if profile.PassCredits <= 0 then
			return false, "NoPassCredits"
		end

		profile.PassCredits -= 1
	elseif action == "Ban" then
		if profile.BanCredits <= 0 then
			return false, "NoBanCredits"
		end

		profile.BanCredits -= 1
	else
		return false, "UnknownAction"
	end

	publish(player, profile)
	DebugLog.Info("RunActions", "Credit de choix consomme", {
		Player = player.Name,
		Action = action,
		PassCredits = profile.PassCredits,
		BanCredits = profile.BanCredits,
	})

	return true
end

function RunActionCreditService.Start()
	if isStarted then
		return
	end

	isStarted = true
	RunStateService.RunStarted:Connect(resetForRun)
	RunStateService.RunEnded:Connect(clearForLobby)
	DebugLog.Info("RunActions", "Service de credits de choix demarre")
end

return RunActionCreditService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="87">
        <Properties>
          <string name="Name">RunAnalyticsService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local MetaProgressionService = require(script.Parent:WaitForChild("MetaProgressionService"))
local RunScoreService = require(script.Parent:WaitForChild("RunScoreService"))
local RunStateService = require(script.Parent:WaitForChild("RunStateService"))

local RunAnalyticsService = {}

local runsByUserId = {}
local isStarted = false

local function copyDictionary(source)
	local copy = {}

	for key, value in pairs(source or {}) do
		copy[key] = value
	end

	return copy
end

local function createCounters()
	return {
		DamageDealt = 0,
		DamageTaken = 0,
		ShieldDamageAbsorbed = 0,
		HealingReceived = 0,
		Kills = 0,
		EliteKills = 0,
		BossKills = 0,
		KillsByEnemyId = {},
		DamageByWeaponId = {},
		RunItemsById = {},
		XpEarned = 0,
		CoinsEarned = 0,
		CoinsSpent = 0,
		PerksSelected = 0,
		MaxDifficultyPercent = 0,
		ChestsOpened = 0,
		RewardChestsOpened = 0,
		JarsBroken = 0,
		DifficultyTotemsActivated = 0,
		ShrinesActivated = {
			Perk = 0,
			EliteChallenge = 0,
			Magnet = 0,
		},
		EliteChallengesStarted = 0,
		PortalsActivated = 0,
		StartNewAchievementIds = {},
	}
end

local function getActiveRun(player)
	if player == nil then
		return nil
	end

	local run = runsByUserId[player.UserId]

	if run == nil or run.RunId == "" then
		return nil
	end

	return run
end

local function getOutcome(reason, levelValidated)
	if reason == "Death" then
		return "Defeat"
	end

	if levelValidated then
		return "Victory"
	end

	return "Abandoned"
end

local function beginRun(player)
	local runId = tostring(player:GetAttribute("RunId") or "")

	if runId == "" then
		DebugLog.Warn("RunAnalytics", "Run active sans RunId, capture ignoree", {
			Player = player.Name,
		})
		return
	end

	local _, startProgression = MetaProgressionService.RecordRunStarted(player, runId)

	runsByUserId[player.UserId] = {
		RunId = runId,
		Context = {
			ChapterId = math.floor(tonumber(player:GetAttribute("RunChapterId")) or 0),
			MapId = tostring(player:GetAttribute("RunMapId") or ""),
			Seed = math.floor(tonumber(player:GetAttribute("RunSeed")) or 0),
		},
		CreatedAt = math.floor(tonumber(player:GetAttribute("RunCreatedAt")) or os.time()),
		StartedAt = os.time(),
		StartedClock = os.clock(),
		StartedCombatTime = CombatStateService.GetTime(),
		AdminCommandsUsed = false,
		Counters = createCounters(),
	}

	if startProgression ~= nil and typeof(startProgression.NewAchievementIds) == "table" then
		for _, achievementId in ipairs(startProgression.NewAchievementIds) do
			table.insert(runsByUserId[player.UserId].Counters.StartNewAchievementIds, achievementId)
		end
	end

	DebugLog.Info("RunAnalytics", "Capture de run initialisee", {
		Player = player.Name,
		RunId = runId,
		ChapterId = player:GetAttribute("RunChapterId"),
	})
end

function RunAnalyticsService.RecordDamageDealt(player, amount, weaponId)
	local run = getActiveRun(player)
	local dealt = math.max(0, tonumber(amount) or 0)

	if run == nil or dealt <= 0 then
		return
	end

	run.Counters.DamageDealt += dealt
	local id = tostring(weaponId or "Unknown")
	run.Counters.DamageByWeaponId[id] = (run.Counters.DamageByWeaponId[id] or 0) + dealt
end

function RunAnalyticsService.RecordDamageTaken(player, amount, shieldAbsorbed)
	local run = getActiveRun(player)

	if run == nil then
		return
	end

	run.Counters.DamageTaken += math.max(0, tonumber(amount) or 0)
	run.Counters.ShieldDamageAbsorbed += math.max(0, tonumber(shieldAbsorbed) or 0)
end

function RunAnalyticsService.RecordHealing(player, amount)
	local run = getActiveRun(player)

	if run ~= nil then
		run.Counters.HealingReceived += math.max(0, tonumber(amount) or 0)
	end
end

function RunAnalyticsService.RecordMonsterKill(player, monster)
	local run = getActiveRun(player)

	if run == nil or monster == nil then
		return
	end

	run.Counters.Kills += 1

	if monster:GetAttribute("IsElite") == true then
		run.Counters.EliteKills += 1
	end

	if monster:GetAttribute("IsBoss") == true then
		run.Counters.BossKills += 1
	end

	local enemyId = tostring(monster:GetAttribute("EnemyId") or monster.Name)
	run.Counters.KillsByEnemyId[enemyId] = (run.Counters.KillsByEnemyId[enemyId] or 0) + 1
end

function RunAnalyticsService.RecordXpEarned(player, amount)
	local run = getActiveRun(player)

	if run ~= nil then
		run.Counters.XpEarned += math.max(0, math.floor(tonumber(amount) or 0))
	end
end

function RunAnalyticsService.RecordCoinsEarned(player, amount)
	local run = getActiveRun(player)

	if run ~= nil then
		run.Counters.CoinsEarned += math.max(0, math.floor(tonumber(amount) or 0))
	end
end

function RunAnalyticsService.RecordCoinsSpent(player, amount)
	local run = getActiveRun(player)

	if run ~= nil then
		run.Counters.CoinsSpent += math.max(0, math.floor(tonumber(amount) or 0))
	end
end

function RunAnalyticsService.RecordPerkSelected(player)
	local run = getActiveRun(player)

	if run ~= nil then
		run.Counters.PerksSelected += 1
	end
end

function RunAnalyticsService.RecordRunItemAdded(player, itemId, amount)
	local run = getActiveRun(player)

	if run == nil then
		return
	end

	local id = tostring(itemId or "Unknown")
	run.Counters.RunItemsById[id] = (run.Counters.RunItemsById[id] or 0)
		+ math.max(0, math.floor(tonumber(amount) or 0))
end

function RunAnalyticsService.RecordDifficultyPercent(player, percent)
	local run = getActiveRun(player)

	if run ~= nil then
		run.Counters.MaxDifficultyPercent = math.max(
			run.Counters.MaxDifficultyPercent,
			math.max(0, math.floor(tonumber(percent) or 0))
		)
	end
end

function RunAnalyticsService.RecordChestOpened(player, isRewardChest)
	local run = getActiveRun(player)

	if run == nil then
		return
	end

	run.Counters.ChestsOpened += 1

	if isRewardChest then
		run.Counters.RewardChestsOpened += 1
	end
end

function RunAnalyticsService.RecordJarBroken(player)
	local run = getActiveRun(player)

	if run ~= nil then
		run.Counters.JarsBroken += 1
	end
end

function RunAnalyticsService.RecordShrineActivated(player, shrineType)
	local run = getActiveRun(player)

	if run == nil then
		return
	end

	local normalizedType = tostring(shrineType or "")

	if run.Counters.ShrinesActivated[normalizedType] == nil then
		return
	end

	run.Counters.ShrinesActivated[normalizedType] += 1

	if normalizedType == "EliteChallenge" then
		run.Counters.EliteChallengesStarted += 1
	end
end

function RunAnalyticsService.RecordDifficultyTotemActivated(player)
	local run = getActiveRun(player)

	if run ~= nil then
		run.Counters.DifficultyTotemsActivated += 1
	end
end

function RunAnalyticsService.RecordPortalActivated(player)
	local run = getActiveRun(player)

	if run ~= nil then
		run.Counters.PortalsActivated += 1
	end
end

function RunAnalyticsService.RecordAdminCommand(player)
	local run = getActiveRun(player)

	if run ~= nil then
		run.AdminCommandsUsed = true
	end
end

function RunAnalyticsService.BuildRunResult(player, reason, snapshot)
	local run = getActiveRun(player)

	if run == nil then
		return nil
	end

	snapshot = snapshot or {}
	local now = os.time()
	local activeSeconds = math.max(0, CombatStateService.GetTime() - run.StartedCombatTime)
	local elapsedSeconds = math.max(0, os.clock() - run.StartedClock)
	local pausedSeconds = math.max(0, elapsedSeconds - activeSeconds)
	local counters = run.Counters
	local levelValidated = snapshot.LevelValidated == true

	return {
		Version = 1,
		RunId = run.RunId,
		UserId = player.UserId,
		Context = {
			ChapterId = run.Context.ChapterId,
			MapId = run.Context.MapId,
			Seed = run.Context.Seed,
		},
		Lifecycle = {
			Status = "Completed",
			Outcome = getOutcome(reason, levelValidated),
			EndReason = tostring(reason or "Unknown"),
			CreatedAt = run.CreatedAt,
			StartedAt = run.StartedAt,
			EndedAt = now,
			ActiveDurationSeconds = math.floor(activeSeconds),
			PausedDurationSeconds = math.floor(pausedSeconds),
		},
		ProgressionStats = {
			FinalLevel = math.max(1, math.floor(tonumber(snapshot.Level) or 1)),
			XpEarned = math.max(0, math.floor(tonumber(snapshot.TotalXp) or counters.XpEarned)),
			CoinsEarned = counters.CoinsEarned,
			CoinsSpent = counters.CoinsSpent,
			CoinsRemaining = math.max(0, math.floor(tonumber(snapshot.Coins) or 0)),
			PerksSelected = counters.PerksSelected,
			MaxDifficultyPercent = math.max(
				counters.MaxDifficultyPercent,
				math.max(0, math.floor(tonumber(snapshot.DifficultyPercent) or 0))
			),
			RunScore = RunScoreService.GetScore(player),
		},
		CombatStats = {
			Kills = counters.Kills,
			EliteKills = counters.EliteKills,
			BossKills = counters.BossKills,
			DamageDealt = math.floor(counters.DamageDealt + 0.5),
			DamageTaken = math.floor(counters.DamageTaken + 0.5),
			ShieldDamageAbsorbed = math.floor(counters.ShieldDamageAbsorbed + 0.5),
			HealingReceived = math.floor(counters.HealingReceived + 0.5),
			KillsByEnemyId = copyDictionary(counters.KillsByEnemyId),
			DamageByWeaponId = copyDictionary(counters.DamageByWeaponId),
		},
		InteractionStats = {
			ChestsOpened = counters.ChestsOpened,
			RewardChestsOpened = counters.RewardChestsOpened,
			JarsBroken = counters.JarsBroken,
			DifficultyTotemsActivated = counters.DifficultyTotemsActivated,
			ShrinesActivated = copyDictionary(counters.ShrinesActivated),
			EliteChallengesStarted = counters.EliteChallengesStarted,
			PortalsActivated = counters.PortalsActivated,
		},
		ItemStats = {
			RunItemsById = copyDictionary(counters.RunItemsById),
		},
		FinalBuild = snapshot.FinalBuild or {},
		ChapterValidated = levelValidated,
		NewlyUnlockedChapterId = math.floor(tonumber(snapshot.NewlyUnlockedChapterId) or 0),
		StartNewAchievementIds = copyDictionary(counters.StartNewAchievementIds),
		Eligibility = {
			ProgressionEligible = not run.AdminCommandsUsed,
			LeaderboardEligible = not run.AdminCommandsUsed,
			AdminCommandsUsed = run.AdminCommandsUsed,
		},
	}
end

function RunAnalyticsService.ClearRun(player)
	if player ~= nil then
		runsByUserId[player.UserId] = nil
	end
end

function RunAnalyticsService.RemovePlayer(player)
	RunAnalyticsService.ClearRun(player)
end

function RunAnalyticsService.Start()
	if isStarted then
		return
	end

	isStarted = true

	RunStateService.RunStarted:Connect(beginRun)

	DebugLog.Info("RunAnalytics", "RunAnalyticsService demarre")
end

return RunAnalyticsService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="88">
        <Properties>
          <string name="Name">RunEndService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BossConfig = require(Shared:WaitForChild("BossConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local ChestService = require(script.Parent:WaitForChild("ChestService"))
local CoinService = require(script.Parent:WaitForChild("CoinService"))
local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local MonsterService = require(script.Parent:WaitForChild("MonsterService"))
local PerkService = require(script.Parent:WaitForChild("PerkService"))
local MetaProgressionService = require(script.Parent:WaitForChild("MetaProgressionService"))
local RunAnalyticsService = require(script.Parent:WaitForChild("RunAnalyticsService"))
local RunSessionService = require(script.Parent:WaitForChild("RunSessionService"))
local RunStateService = require(script.Parent:WaitForChild("RunStateService"))
local RunTeleportService = require(script.Parent:WaitForChild("RunTeleportService"))
local RunItemService = require(script.Parent:WaitForChild("RunItemService"))
local XpService = require(script.Parent:WaitForChild("XpService"))

local RunEndService = {}

local statesByUserId = {}
local pendingSummariesByUserId = {}
local characterConnectionsByUserId = {}
local isStarted = false

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local summaryRemote = getOrCreateRemote(BossConfig.ResultRemoteName)
local returnToLobbyRemote = getOrCreateRemote(BossConfig.ReturnToLobbyRemoteName)

local function getOrCreateState(player)
	local state = statesByUserId[player.UserId]

	if state == nil then
		state = {
			StartedAt = nil,
			LevelValidated = false,
			RunId = nil,
			ChapterId = nil,
		}
		statesByUserId[player.UserId] = state
	end

	return state
end

local function resetRunState(player)
	XpService.ClearRunGems()
	CoinService.ClearRunCoins()
	XpService.ResetRun(player)
	CoinService.ResetRun(player)
	PerkService.ResetRun(player)
	RunItemService.ResetRun(player)
	ChestService.ResetRun(player)
	MonsterService.ResetRunStats(player)
end

local function buildSummary(player, reason)
	local state = getOrCreateState(player)
	local xpStats = XpService.GetRunStats(player)
	local session = RunSessionService.GetCurrentSession(player)
	local finalBuild = PerkService.GetRunBuild(player)
	finalBuild.RunItems = RunItemService.GetRunItems(player)
	local snapshot = {
		LevelValidated = state.LevelValidated == true,
		Level = xpStats.Level,
		TotalXp = xpStats.TotalXp,
		Coins = CoinService.GetCoins(player),
		FinalBuild = finalBuild,
		RunItems = RunItemService.GetRunItems(player),
		NewlyUnlockedChapterId = session and session.NewlyUnlockedChapterId or 0,
	}
	local runResult = RunAnalyticsService.BuildRunResult(player, reason, snapshot)
	local progressionResult = {
		Applied = false,
		Reason = "RunResultMissing",
		CompletedQuestIds = {},
		NewAchievementIds = {},
		NewUnlocks = {},
		PersonalBestChanges = {},
	}

	if runResult ~= nil then
		local applied, result = MetaProgressionService.ApplyRunResult(player, runResult)

		if applied then
			progressionResult = result
		else
			progressionResult.Reason = result and result.Reason or "ProgressionSaveFailed"
		end

		for _, achievementId in ipairs(runResult.StartNewAchievementIds or {}) do
			table.insert(progressionResult.NewAchievementIds, achievementId)
		end

		runResult.ProgressionResult = progressionResult
	end

	local combatStats = if runResult ~= nil then runResult.CombatStats else {}
	local interactionStats = if runResult ~= nil then runResult.InteractionStats else {}
	local progressionStats = if runResult ~= nil then runResult.ProgressionStats else {}
	local lifecycle = if runResult ~= nil then runResult.Lifecycle else {}

	return {
		Reason = reason,
		RunId = state.RunId,
		ChapterId = state.ChapterId,
		LevelValidated = state.LevelValidated == true,
		Kills = combatStats.Kills or MonsterService.GetKills(player),
		EliteKills = combatStats.EliteKills or 0,
		BossKills = combatStats.BossKills or 0,
		DamageDealt = combatStats.DamageDealt or 0,
		DamageTaken = combatStats.DamageTaken or 0,
		Coins = CoinService.GetCoins(player),
		CoinsEarned = progressionStats.CoinsEarned or 0,
		CoinsSpent = progressionStats.CoinsSpent or 0,
		RunScore = progressionStats.RunScore or 0,
		Level = xpStats.Level,
		TotalXp = xpStats.TotalXp,
		PerkCount = PerkService.GetRunPerkCount(player),
		RunItems = RunItemService.GetRunItems(player),
		ChestsOpened = interactionStats.ChestsOpened or 0,
		JarsBroken = interactionStats.JarsBroken or 0,
		SurvivalSeconds = lifecycle.ActiveDurationSeconds
			or math.max(0, CombatStateService.GetTime() - (state.StartedAt or CombatStateService.GetTime())),
		Progression = progressionResult,
		ProgressionEligible = runResult ~= nil and runResult.Eligibility.ProgressionEligible == true,
		Outcome = lifecycle.Outcome,
		NewlyUnlockedChapterId = runResult and runResult.NewlyUnlockedChapterId or 0,
		RunResult = runResult,
	}
end

local function showSummary(player, payload)
	if player.Parent ~= Players then
		return
	end

	summaryRemote:FireClient(player, payload)
	DebugLog.Info("RunEnd", "Resultat de run envoye", {
		Player = player.Name,
		Reason = payload.Reason,
		LevelValidated = payload.LevelValidated,
		Kills = payload.Kills,
		Coins = payload.Coins,
	})
end

function RunEndService.MarkLevelValidated(player)
	if player == nil then
		return
	end

	local state = getOrCreateState(player)
	state.LevelValidated = true
	player:SetAttribute("RunLevelValidated", true)
	RunStateService.NotifyLevelValidated(player)

	DebugLog.Info("RunEnd", "Niveau valide pour la run", {
		Player = player.Name,
	})
end

function RunEndService.IsLevelValidated(player)
	local state = statesByUserId[player.UserId]

	return state ~= nil and state.LevelValidated == true
end

function RunEndService.SetupPlayer(player)
	getOrCreateState(player)

	if characterConnectionsByUserId[player.UserId] ~= nil then
		characterConnectionsByUserId[player.UserId]:Disconnect()
	end

	characterConnectionsByUserId[player.UserId] = player.CharacterAdded:Connect(function()
		local payload = pendingSummariesByUserId[player.UserId]

		if payload == nil then
			return
		end

		task.delay(0.45, function()
			if pendingSummariesByUserId[player.UserId] == payload then
				pendingSummariesByUserId[player.UserId] = nil
				showSummary(player, payload)
			end
		end)
	end)
end

function RunEndService.RemovePlayer(player)
	pendingSummariesByUserId[player.UserId] = nil
	statesByUserId[player.UserId] = nil

	if characterConnectionsByUserId[player.UserId] ~= nil then
		characterConnectionsByUserId[player.UserId]:Disconnect()
		characterConnectionsByUserId[player.UserId] = nil
	end
end

function RunEndService.Start()
	if isStarted then
		return
	end

	isStarted = true

	RunStateService.RunStarted:Connect(function(player, reason)
		local state = getOrCreateState(player)
		state.StartedAt = CombatStateService.GetTime()
		state.LevelValidated = false
		state.RunId = player:GetAttribute("RunId")
		state.ChapterId = player:GetAttribute("RunChapterId")
		player:SetAttribute("RunLevelValidated", false)
		pendingSummariesByUserId[player.UserId] = nil
		resetRunState(player)

		DebugLog.Info("RunEnd", "Etat de run initialise", {
			Player = player.Name,
			Reason = reason,
		})
	end)

	RunStateService.RunEnded:Connect(function(player, reason)
		local summary = buildSummary(player, reason)
		local state = getOrCreateState(player)
		local sessionCompleted = RunSessionService.CompleteRun(player, reason, summary.RunResult)

		if not sessionCompleted then
			DebugLog.Warn("RunEnd", "Fin de run sans session active a finaliser", {
				Player = player.Name,
				Reason = reason,
			})
		end
		RunAnalyticsService.ClearRun(player)
		summary.RunResult = nil

		resetRunState(player)
		state.StartedAt = nil
		state.LevelValidated = false
		state.RunId = nil
		state.ChapterId = nil
		player:SetAttribute("RunLevelValidated", false)

		if RunTeleportService.ReturnToLobby(player, summary) then
			return
		end

		pendingSummariesByUserId[player.UserId] = summary
		player:LoadCharacter()

		DebugLog.Info("RunEnd", "Etat de run reinitialise", {
			Player = player.Name,
			Reason = reason,
			LevelValidated = summary.LevelValidated,
		})
	end)

	returnToLobbyRemote.OnServerEvent:Connect(function(player)
		if RunStateService.IsRunActive(player) then
			return
		end

		pendingSummariesByUserId[player.UserId] = nil
		summaryRemote:FireClient(player, {
			Visible = false,
		})
		if not RunTeleportService.ReturnToLobby(player) then
			player:LoadCharacter()
		end
	end)

	DebugLog.Info("RunEnd", "RunEndService demarre")
end

return RunEndService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="89">
        <Properties>
          <string name="Name">RunItemService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local RunItemConfig = require(Shared:WaitForChild("RunItemConfig"))

local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local GameplayFeedbackService = require(script.Parent:WaitForChild("GameplayFeedbackService"))
local PerkService = require(script.Parent:WaitForChild("PerkService"))
local RunAnalyticsService = require(script.Parent:WaitForChild("RunAnalyticsService"))
local RunStateService = require(script.Parent:WaitForChild("RunStateService"))

local RunItemService = {}

local profilesByUserId = {}
local poisonsByMonster = {}
local rng = Random.new()
local isStarted = false
local monsterService = nil

local function getMonsterService()
	if monsterService == nil then
		monsterService = require(script.Parent:WaitForChild("MonsterService"))
	end

	return monsterService
end

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")
	return remote
end

local updateRemote = getOrCreateRemote(RunItemConfig.UpdateRemoteName)

local function createProfile()
	return {
		StacksByItemId = {},
		ItemOrder = {},
		VampireKillsSinceLastBonus = 0,
	}
end

local function getOrCreateProfile(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		profile = createProfile()
		profilesByUserId[player.UserId] = profile
	end

	return profile
end

local function buildItemPayload(itemId, stacks)
	local definition = RunItemConfig.Definitions[itemId]

	if definition == nil then
		return nil
	end

	return {
		Id = definition.Id,
		Name = definition.Name,
		Description = definition.Description,
		Icon = definition.Icon,
		Accent = definition.Accent,
		Stacks = math.max(0, math.floor(stacks or 0)),
	}
end

local function getItemOrder(profile)
	if typeof(profile.ItemOrder) == "table" then
		return profile.ItemOrder
	end

	local itemOrder = {}
	for _, itemId in ipairs(RunItemConfig.ChestRewardIds) do
		local stacks = math.max(0, math.floor(profile.StacksByItemId[itemId] or 0))
		if stacks > 0 then
			table.insert(itemOrder, itemId)
		end
	end

	profile.ItemOrder = itemOrder
	return itemOrder
end

local function getMaxUniqueItems()
	return math.max(1, math.floor(RunItemConfig.MaxUniqueItems or 12))
end

local function getOwnedItemCount(profile)
	local count = 0

	for itemId, stacks in pairs(profile.StacksByItemId) do
		if RunItemConfig.Definitions[itemId] ~= nil and math.max(0, math.floor(stacks or 0)) > 0 then
			count += 1
		end
	end

	return count
end

local function buildItems(player)
	local profile = getOrCreateProfile(player)
	local items = {}
	local itemOrder = getItemOrder(profile)
	local includedItemIds = {}

	local function appendActiveItem(itemId)
		if includedItemIds[itemId] then
			return
		end

		local stacks = math.max(0, math.floor(profile.StacksByItemId[itemId] or 0))
		if stacks <= 0 then
			return
		end

		local item = buildItemPayload(itemId, stacks)
		if item == nil then
			return
		end

		includedItemIds[itemId] = true
		table.insert(items, item)
	end

	-- L'ordre est fixe au premier ramassage de chaque objet : les mises a jour
	-- suivantes ne peuvent donc jamais faire glisser les icones de la bottom bar.
	for _, itemId in ipairs(itemOrder) do
		appendActiveItem(itemId)
	end

	return items
end

local function ensureItemOrder(profile, itemId)
	local itemOrder = getItemOrder(profile)

	for _, existingItemId in ipairs(itemOrder) do
		if existingItemId == itemId then
			return
		end
	end

	table.insert(itemOrder, itemId)
end

local function sendState(player)
	updateRemote:FireClient(player, {
		Items = buildItems(player),
	})
end

local function getPoisonEffects(monster)
	local effects = poisonsByMonster[monster]

	if effects == nil then
		effects = {}
		poisonsByMonster[monster] = effects
	end

	return effects
end

local function updatePoisonStackAttribute(monster, effects)
	if monster == nil or monster.Parent == nil then
		return
	end

	monster:SetAttribute("PoisonStacks", #effects)
end

local function clearPoisonEffects(monster)
	poisonsByMonster[monster] = nil

	if monster ~= nil and monster.Parent ~= nil then
		monster:SetAttribute("PoisonStacks", 0)
	end
end

function RunItemService.SetupPlayer(player)
	getOrCreateProfile(player)
	sendState(player)
end

function RunItemService.RemovePlayer(player)
	RunItemService.RemovePlayerEffects(player)
	profilesByUserId[player.UserId] = nil
end

function RunItemService.ResetRun(player)
	local profile = getOrCreateProfile(player)
	profile.StacksByItemId = {}
	profile.ItemOrder = {}
	profile.VampireKillsSinceLastBonus = 0
	RunItemService.RemovePlayerEffects(player)
	sendState(player)
end

function RunItemService.RemovePlayerEffects(player)
	for monster, effects in pairs(poisonsByMonster) do
		local retained = {}

		for _, effect in ipairs(effects) do
			if effect.Player ~= player then
				table.insert(retained, effect)
			end
		end

		if #retained == 0 then
			clearPoisonEffects(monster)
		else
			poisonsByMonster[monster] = retained
			updatePoisonStackAttribute(monster, retained)
		end
	end
end

function RunItemService.GetItemCount(player, itemId)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		return 0
	end

	return math.max(0, math.floor(profile.StacksByItemId[itemId] or 0))
end

function RunItemService.GetRunItems(player)
	return buildItems(player)
end

function RunItemService.GetEligibleRewardItemIds(player, candidateItemIds)
	if player == nil or typeof(candidateItemIds) ~= "table" then
		return {}
	end

	local profile = getOrCreateProfile(player)
	local inventoryIsFull = getOwnedItemCount(profile) >= getMaxUniqueItems()
	local eligibleItemIds = {}
	local includedItemIds = {}

	for _, itemId in ipairs(candidateItemIds) do
		local stacks = math.max(0, math.floor(profile.StacksByItemId[itemId] or 0))

		if
			not includedItemIds[itemId]
			and RunItemConfig.Definitions[itemId] ~= nil
			and (not inventoryIsFull or stacks > 0)
		then
			includedItemIds[itemId] = true
			table.insert(eligibleItemIds, itemId)
		end
	end

	return eligibleItemIds
end

function RunItemService.AddItem(player, itemId)
	if not RunStateService.IsRunActive(player) then
		return false, "RunInactive"
	end

	local definition = RunItemConfig.Definitions[itemId]

	if definition == nil then
		return false, "ItemUnknown"
	end

	local profile = getOrCreateProfile(player)
	local currentStacks = math.max(0, math.floor(profile.StacksByItemId[itemId] or 0))

	if currentStacks <= 0 and getOwnedItemCount(profile) >= getMaxUniqueItems() then
		return false, "ItemSlotsFull"
	end

	if currentStacks <= 0 then
		ensureItemOrder(profile, itemId)
	end

	local nextStacks = currentStacks + 1
	profile.StacksByItemId[itemId] = nextStacks

	local statsPerStack = definition.StatsPerStack

	if
		statsPerStack == nil
		and (
			definition.MoveSpeedPercentPerStack ~= nil
			or definition.AttackSpeedPercentPerStack ~= nil
			or definition.ProjectileSpeedPercentPerStack ~= nil
		)
	then
		statsPerStack = {
			MoveSpeedPercent = definition.MoveSpeedPercentPerStack or 0,
			AttackSpeedPercent = definition.AttackSpeedPercentPerStack or 0,
			ProjectileSpeedPercent = definition.ProjectileSpeedPercentPerStack or 0,
		}
	end

	if statsPerStack ~= nil then
		PerkService.ApplyRunItemStats(player, statsPerStack)
	end

	RunAnalyticsService.RecordRunItemAdded(player, itemId, 1)
	sendState(player)

	local item = buildItemPayload(itemId, nextStacks)
	DebugLog.Info("RunItems", "Objet de run ajoute", {
		Player = player.Name,
		ItemId = itemId,
		Stacks = nextStacks,
	})

	return true, item
end

function RunItemService.OnChestOpened(player)
	if player == nil or not RunStateService.IsRunActive(player) then
		return
	end

	local profile = getOrCreateProfile(player)
	local addedStats = {}

	for itemId, stacks in pairs(profile.StacksByItemId) do
		local definition = RunItemConfig.Definitions[itemId]
		local statsPerChestOpened = definition and definition.StatsPerChestOpened

		if statsPerChestOpened ~= nil then
			for statName, value in pairs(statsPerChestOpened) do
				addedStats[statName] = (addedStats[statName] or 0) + (value * stacks)
			end
		end
	end

	if next(addedStats) ~= nil then
		PerkService.ApplyRunItemStats(player, addedStats)
	end
end

function RunItemService.OnMonsterKilled(player)
	if player == nil or not RunStateService.IsRunActive(player) then
		return
	end

	local definition = RunItemConfig.Definitions.vampire_tooth
	local stacks = RunItemService.GetItemCount(player, definition.Id)

	if stacks <= 0 then
		return
	end

	local profile = getOrCreateProfile(player)
	profile.VampireKillsSinceLastBonus += 1

	local baseThreshold = math.max(1, math.floor(definition.KillsPerMaxHealth or 50))
	local stackMultiplier = math.clamp(definition.KillThresholdStackMultiplier or 1, 0.1, 1)
	local threshold = math.max(1, math.ceil(baseThreshold * (stackMultiplier ^ math.max(0, stacks - 1))))
	local maxHealthPerThreshold = math.max(1, math.floor(definition.MaxHealthPerThreshold or 1))

	while profile.VampireKillsSinceLastBonus >= threshold do
		profile.VampireKillsSinceLastBonus -= threshold
		PerkService.GrantMaxHealth(player, maxHealthPerThreshold)
	end
end

function RunItemService.TryApplyOnWeaponHit(player, monster, weaponId)
	if player == nil or monster == nil or not RunStateService.IsRunActive(player) then
		return false
	end

	if not getMonsterService().IsMonsterAlive(monster) then
		return false
	end

	local camembert = RunItemConfig.Definitions.camembert
	local stacks = RunItemService.GetItemCount(player, camembert.Id)

	if stacks <= 0 then
		return false
	end

	local chance = math.clamp((camembert.PoisonChancePerStack or 0) * stacks, 0, 1)

	if rng:NextNumber() > chance then
		return false
	end

	local duration = PerkService.GetEffectDuration(player, camembert.PoisonBaseDuration)
	local effects = getPoisonEffects(monster)
	table.insert(effects, {
		Player = player,
		MonsterRuntimeId = monster:GetAttribute("RuntimeMonsterId"),
		RemainingSeconds = duration,
		TickAccumulator = 0,
		TickInterval = camembert.PoisonTickInterval,
		TickDamage = camembert.PoisonTickDamage,
		FlashColor = camembert.PoisonFlashColor,
		SourceWeaponId = weaponId,
	})
	updatePoisonStackAttribute(monster, effects)
	GameplayFeedbackService.Queue(player, "Poison", 1)

	DebugLog.ThrottledInfo("RunItems", "poison_applied_" .. player.UserId, 0.5, "Poison applique", {
		Player = player.Name,
		Monster = monster,
		Stacks = #effects,
		Chance = chance,
		Duration = duration,
	})

	return true
end

local function updatePoisonEffects(deltaTime)
	if CombatStateService.IsPaused() then
		return
	end

	for monster, effects in pairs(poisonsByMonster) do
		local retained = {}

		for _, effect in ipairs(effects) do
			local isSameRuntimeMonster = monster:GetAttribute("RuntimeMonsterId") == effect.MonsterRuntimeId
			local isValid = isSameRuntimeMonster and getMonsterService().IsMonsterAlive(monster)

			if isValid then
				effect.RemainingSeconds -= deltaTime
				effect.TickAccumulator += deltaTime

				while effect.TickAccumulator >= effect.TickInterval and effect.RemainingSeconds >= 0 do
					effect.TickAccumulator -= effect.TickInterval
					local didDamage, damageDealt = getMonsterService().DamageMonster(monster, effect.TickDamage, effect.Player, {
						FlashColor = effect.FlashColor,
					})

					if not didDamage then
						isValid = false
						break
					end

					PerkService.ApplyLifeSteal(effect.Player, damageDealt or 0, "Dot")
					RunAnalyticsService.RecordDamageDealt(effect.Player, damageDealt or 0, "CamembertPoison")
				end
			end

			if isValid and effect.RemainingSeconds > 0 and getMonsterService().IsMonsterAlive(monster) then
				table.insert(retained, effect)
			end
		end

		if #retained == 0 then
			clearPoisonEffects(monster)
		else
			poisonsByMonster[monster] = retained
			updatePoisonStackAttribute(monster, retained)
		end
	end
end

function RunItemService.Start()
	if isStarted then
		return
	end

	isStarted = true
	RunService.Heartbeat:Connect(updatePoisonEffects)
	DebugLog.Info("RunItems", "RunItemService demarre")
end

return RunItemService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="90">
        <Properties>
          <string name="Name">RunLoadingService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local RunLoadingConfig = require(Shared:WaitForChild("RunLoadingConfig"))

local RunLoadingService = {}

local statesByUserId = {}
local characterConnectionsByUserId = {}
local isStarted = false

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local loadingRemote = getOrCreateRemote(RunLoadingConfig.RemoteName)

local function getOrCreateState(player)
	local state = statesByUserId[player.UserId]

	if state == nil then
		state = {
			IsLoading = false,
			LockedCharacter = nil,
			SavedMovement = nil,
		}
		statesByUserId[player.UserId] = state
	end

	return state
end

local function getHumanoidAndRoot(character)
	if character == nil then
		return nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")

	return humanoid, root
end

local function lockCharacter(player, character)
	local state = getOrCreateState(player)

	if not state.IsLoading or character == nil or state.LockedCharacter == character then
		return
	end

	local humanoid, root = getHumanoidAndRoot(character)

	if humanoid == nil or root == nil then
		return
	end

	state.LockedCharacter = character
	state.SavedMovement = {
		Humanoid = humanoid,
		Root = root,
		WalkSpeed = humanoid.WalkSpeed,
		JumpPower = humanoid.JumpPower,
		JumpHeight = humanoid.JumpHeight,
		AutoRotate = humanoid.AutoRotate,
		RootAnchored = root.Anchored,
	}

	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0
	humanoid.AutoRotate = false
	root.Anchored = true
end

local function unlockCharacter(player)
	local state = getOrCreateState(player)
	local savedMovement = state.SavedMovement

	state.LockedCharacter = nil
	state.SavedMovement = nil

	if savedMovement == nil then
		return
	end

	local humanoid = savedMovement.Humanoid
	local root = savedMovement.Root

	if humanoid ~= nil and humanoid.Parent ~= nil then
		humanoid.WalkSpeed = savedMovement.WalkSpeed
		humanoid.JumpPower = savedMovement.JumpPower
		humanoid.JumpHeight = savedMovement.JumpHeight
		humanoid.AutoRotate = savedMovement.AutoRotate
	end

	if root ~= nil and root.Parent ~= nil then
		root.Anchored = savedMovement.RootAnchored
	end
end

local function sendState(player, payload)
	if player.Parent ~= Players then
		return
	end

	loadingRemote:FireClient(player, payload)
end

function RunLoadingService.Begin(player)
	if player == nil or player.Parent ~= Players then
		return false
	end

	local state = getOrCreateState(player)
	state.IsLoading = true
	player:SetAttribute(RunLoadingConfig.AttributeName, true)
	lockCharacter(player, player.Character)
	RunLoadingService.Update(player, "Preparing")

	return true
end

function RunLoadingService.Update(player, stageId, detail)
	if player == nil or player.Parent ~= Players then
		return
	end

	local stage = RunLoadingConfig.Stages[stageId] or RunLoadingConfig.Stages.Preparing

	sendState(player, {
		Visible = true,
		Stage = stageId,
		Progress = stage.Progress,
		Message = stage.Message,
		Detail = detail,
	})
end

function RunLoadingService.Complete(player)
	if player == nil or player.Parent ~= Players then
		return
	end

	local state = getOrCreateState(player)

	if not state.IsLoading then
		return
	end

	RunLoadingService.Update(player, "Ready")
	state.IsLoading = false
	player:SetAttribute(RunLoadingConfig.AttributeName, false)

	task.delay(RunLoadingConfig.ReleaseDelay, function()
		if player.Parent ~= Players or getOrCreateState(player).IsLoading then
			return
		end

		sendState(player, {
			Visible = false,
		})
		unlockCharacter(player)
	end)
end

function RunLoadingService.Cancel(player, reason)
	if player == nil then
		return
	end

	local state = getOrCreateState(player)
	state.IsLoading = false
	player:SetAttribute(RunLoadingConfig.AttributeName, false)
	sendState(player, {
		Visible = false,
		Reason = reason,
	})
	unlockCharacter(player)
end

function RunLoadingService.SetupPlayer(player)
	local state = getOrCreateState(player)
	state.IsLoading = false
	player:SetAttribute(RunLoadingConfig.AttributeName, false)

	if characterConnectionsByUserId[player.UserId] ~= nil then
		characterConnectionsByUserId[player.UserId]:Disconnect()
	end

	characterConnectionsByUserId[player.UserId] = player.CharacterAdded:Connect(function(character)
		task.defer(function()
			lockCharacter(player, character)
		end)
	end)
end

function RunLoadingService.RemovePlayer(player)
	if player == nil then
		return
	end

	unlockCharacter(player)
	statesByUserId[player.UserId] = nil

	if characterConnectionsByUserId[player.UserId] ~= nil then
		characterConnectionsByUserId[player.UserId]:Disconnect()
		characterConnectionsByUserId[player.UserId] = nil
	end
end

function RunLoadingService.Start()
	if isStarted then
		return
	end

	isStarted = true
	DebugLog.Info("RunLoading", "Service de chargement run demarre", {
		Remote = loadingRemote,
	})
end

return RunLoadingService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="91">
        <Properties>
          <string name="Name">RunMapService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChapterConfig = require(Shared:WaitForChild("ChapterConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local TemplateService = require(script.Parent:WaitForChild("TemplateService"))
local WorldSpawnService = require(script.Parent:WaitForChild("WorldSpawnService"))

local RunMapService = {}

local activeMap = nil
local activeRunId = nil
local activeArrival = nil
local isStarted = false

local function disableMapScripts(map)
	if not ChapterConfig.DisableMapScripts then
		return 0
	end

	local disabledCount = 0

	for _, descendant in ipairs(map:GetDescendants()) do
		if descendant:IsA("BaseScript") then
			descendant.Disabled = true
			disabledCount += 1
		end
	end

	return disabledCount
end

local function isArrivalCandidate(instance)
	return instance:IsA("BasePart") or instance:IsA("Model")
end

local function findArrival(map, preferredArrivalName)
	local arrivalName = preferredArrivalName or ChapterConfig.ArrivalPartName
	local arrival = map:FindFirstChild(arrivalName, true)

	if arrival ~= nil and isArrivalCandidate(arrival) then
		return arrival
	end

	local fallbackCandidates = {}

	for _, descendant in ipairs(map:GetDescendants()) do
		if string.sub(descendant.Name, 1, 12) == "TeleportPart" and isArrivalCandidate(descendant) then
			table.insert(fallbackCandidates, descendant)
		end
	end

	if #fallbackCandidates == 1 then
		DebugLog.Warn("RunMap", "Point d'arrivee deduit depuis le template", {
			Map = map,
			ExpectedName = arrivalName,
			FoundName = fallbackCandidates[1].Name,
		})
		return fallbackCandidates[1]
	end

	local spawnLocation = map:FindFirstChildWhichIsA("SpawnLocation", true)

	if spawnLocation ~= nil then
		return spawnLocation
	end

	return nil
end

local function clearRuntimeFolder()
	local runtimeFolder = TemplateService.GetMapRuntimeFolder()

	for _, child in ipairs(runtimeFolder:GetChildren()) do
		child:Destroy()
	end
end

local function getMapCenter(map)
	if map:IsA("Model") then
		local boundingCFrame = map:GetBoundingBox()
		return boundingCFrame.Position
	end

	if map:IsA("BasePart") then
		return map.Position
	end

	local minimum = nil
	local maximum = nil

	for _, descendant in ipairs(map:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local halfSize = descendant.Size * 0.5
			local partMinimum = descendant.Position - halfSize
			local partMaximum = descendant.Position + halfSize
			minimum = if minimum == nil then partMinimum else Vector3.new(
				math.min(minimum.X, partMinimum.X),
				math.min(minimum.Y, partMinimum.Y),
				math.min(minimum.Z, partMinimum.Z)
			)
			maximum = if maximum == nil then partMaximum else Vector3.new(
				math.max(maximum.X, partMaximum.X),
				math.max(maximum.Y, partMaximum.Y),
				math.max(maximum.Z, partMaximum.Z)
			)
		end
	end

	return if minimum ~= nil and maximum ~= nil then (minimum + maximum) * 0.5 else Vector3.zero
end

function RunMapService.Generate(session)
	local chapter = ChapterConfig.GetChapter(session.ChapterId)

	if chapter == nil then
		return false, "UnknownChapter"
	end

	local template = TemplateService.GetTemplate(ChapterConfig.TemplateFolderName, chapter.MapTemplateName)

	if template == nil then
		DebugLog.Warn("RunMap", "Generation impossible, template de map absent", {
			ChapterId = chapter.Id,
			Template = chapter.MapTemplateName,
			ExpectedFolder = "ServerStorage/" .. ChapterConfig.TemplateFolderName,
		})
		return false, "MapTemplateMissing"
	end

	RunMapService.Destroy(activeRunId)
	clearRuntimeFolder()

	local runtimeFolder = TemplateService.GetMapRuntimeFolder()
	local map = template:Clone()
	map.Name = chapter.MapTemplateName
	map:SetAttribute("RunId", session.RunId)
	map:SetAttribute("RunSeed", session.Seed)
	map:SetAttribute("ChapterId", chapter.Id)
	map.Parent = runtimeFolder

	local disabledScriptCount = disableMapScripts(map)
	local arrival = findArrival(map, chapter.ArrivalPartName)

	if arrival == nil then
		map:Destroy()
		DebugLog.Warn("RunMap", "Map sans point d'arrivee", {
			ChapterId = chapter.Id,
			Map = chapter.MapTemplateName,
			ExpectedName = chapter.ArrivalPartName or ChapterConfig.ArrivalPartName,
		})
		return false, "ArrivalMissing"
	end

	activeMap = map
	activeRunId = session.RunId
	activeArrival = arrival
	local mapCenter = getMapCenter(map)
	WorldSpawnService.SetRunContext(map, session.Seed, mapCenter)

	DebugLog.Info("RunMap", "Map de run generee", {
		RunId = session.RunId,
		Seed = session.Seed,
		ChapterId = chapter.Id,
		Map = map,
		Arrival = arrival,
		MapCenter = mapCenter,
		DisabledScripts = disabledScriptCount,
	})

	return true, arrival
end

function RunMapService.Start()
	if isStarted then
		return
	end

	isStarted = true
	RunMapService.Destroy(activeRunId)
	clearRuntimeFolder()
	WorldSpawnService.ClearRunContext()
	DebugLog.Info("RunMap", "RunMapService demarre, runtime vide")
end

function RunMapService.GetActiveMap()
	return activeMap
end

function RunMapService.GetArrival(runId)
	if activeMap == nil or activeMap.Parent == nil or (runId ~= nil and runId ~= activeRunId) then
		return nil
	end

	if activeArrival ~= nil and activeArrival.Parent ~= nil then
		return activeArrival
	end

	return findArrival(activeMap)
end

function RunMapService.Destroy(runId)
	if activeMap == nil then
		return false
	end

	if runId ~= nil and activeRunId ~= nil and runId ~= activeRunId then
		return false
	end

	local map = activeMap
	local destroyedRunId = activeRunId
	activeMap = nil
	activeRunId = nil
	activeArrival = nil
	WorldSpawnService.ClearRunContext(map)

	if map.Parent ~= nil then
		map:Destroy()
	end

	DebugLog.Info("RunMap", "Map de run detruite", {
		RunId = destroyedRunId,
	})

	return true
end

return RunMapService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="92">
        <Properties>
          <string name="Name">RunScoreService</string>
          <string name="Source"><![CDATA[--!strict

-- Score de pas autoritaire : seule la position repliquee au serveur est lue.
-- Les teleports et les phases de pause reinitialisent simplement l'echantillon.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local RunItemConfig = require(Shared:WaitForChild("RunItemConfig"))
local RunScoreConfig = require(Shared:WaitForChild("RunScoreConfig"))

local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local GameplayFeedbackService = require(script.Parent:WaitForChild("GameplayFeedbackService"))
local RunStateService = require(script.Parent:WaitForChild("RunStateService"))

local RunScoreService = {}

type ScoreState = {
	IsActive: boolean,
	LastPosition: Vector3?,
	PendingScore: number,
	Remainder: number,
	Score: number,
}

local statesByUserId: { [number]: ScoreState } = {}
local accumulator = 0
local publishAccumulator = 0
local isStarted = false
local runItemService: any = nil

local function getRunItemService(): any
	if runItemService == nil then
		runItemService = require(script.Parent:WaitForChild("RunItemService"))
	end

	return runItemService
end

local function getOrCreateRemote(remoteName: string): RemoteEvent
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")
	return remote
end

local updateRemote = getOrCreateRemote(RunScoreConfig.UpdateRemoteName)

local function getOrCreateState(player: Player): ScoreState
	local state = statesByUserId[player.UserId]

	if state == nil then
		state = {
			IsActive = false,
			LastPosition = nil,
			PendingScore = 0,
			Remainder = 0,
			Score = 0,
		}
		statesByUserId[player.UserId] = state
	end

	return state
end

local function getRootPosition(player: Player): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if root ~= nil and root:IsA("BasePart") then
		return root.Position
	end

	return nil
end

local function sendState(player: Player, delta: number?)
	if player.Parent ~= Players then
		return
	end

	local state = getOrCreateState(player)
	updateRemote:FireClient(player, {
		Score = state.Score,
		Delta = math.max(0, math.floor(delta or 0)),
	})
end

local function resetSampling(state: ScoreState, position: Vector3?)
	state.LastPosition = position
	state.Remainder = 0
end

function RunScoreService.GetStepScoreMultiplier(player: Player?): number
	if player == nil then
		return 1
	end

	local definition = RunItemConfig.Definitions.golden_sneakers

	if definition == nil then
		return 1
	end

	local stacks = getRunItemService().GetItemCount(player, definition.Id)
	local bonusPerStack = math.max(0, tonumber(definition.StepScorePercentPerStack) or 0)

	return math.max(1, 1 + (bonusPerStack * stacks))
end

local function updatePlayerScore(player: Player)
	local state = getOrCreateState(player)

	if not state.IsActive or not RunStateService.IsRunActive(player) then
		return
	end

	local position = getRootPosition(player)

	if position == nil then
		return
	end

	if CombatStateService.IsPaused() then
		resetSampling(state, position)
		return
	end

	local previousPosition = state.LastPosition
	state.LastPosition = position

	if previousPosition == nil then
		return
	end

	local horizontalDistance = Vector2.new(position.X - previousPosition.X, position.Z - previousPosition.Z).Magnitude
	local maximumSampleDistance = math.max(1, tonumber(RunScoreConfig.MaximumSampleDistance) or 28)

	if horizontalDistance > maximumSampleDistance then
		resetSampling(state, position)
		return
	end

	local pointsPerStud = math.max(0, tonumber(RunScoreConfig.PointsPerStud) or 1)
	state.Remainder += horizontalDistance * pointsPerStud * RunScoreService.GetStepScoreMultiplier(player)
	local gainedScore = math.floor(state.Remainder)

	if gainedScore <= 0 then
		return
	end

	state.Remainder -= gainedScore
	state.Score += gainedScore
	state.PendingScore += gainedScore
end

local function publishPendingScores()
	for _, player in ipairs(Players:GetPlayers()) do
		local state = statesByUserId[player.UserId]

		if state ~= nil and state.IsActive and state.PendingScore > 0 then
			local delta = state.PendingScore
			state.PendingScore = 0
			sendState(player, delta)
			GameplayFeedbackService.Queue(player, "Run", delta)
		end
	end
end

function RunScoreService.GetScore(player: Player?): number
	if player == nil then
		return 0
	end

	local state = statesByUserId[player.UserId]
	return if state == nil then 0 else state.Score
end

function RunScoreService.SetupPlayer(player: Player)
	getOrCreateState(player)
	sendState(player)
end

function RunScoreService.RemovePlayer(player: Player?)
	if player ~= nil then
		statesByUserId[player.UserId] = nil
	end
end

function RunScoreService.Start()
	if isStarted then
		return
	end

	isStarted = true

	RunStateService.RunStarted:Connect(function(player)
		local state = getOrCreateState(player)
		state.IsActive = true
		state.PendingScore = 0
		state.Remainder = 0
		state.Score = 0
		state.LastPosition = getRootPosition(player)
		sendState(player)
	end)

	RunStateService.RunEnded:Connect(function(player)
		local state = getOrCreateState(player)
		state.IsActive = false
		state.PendingScore = 0
		state.LastPosition = nil
	end)

	RunService.Heartbeat:Connect(function(deltaTime)
		accumulator += deltaTime
		local sampleInterval = math.max(0.05, tonumber(RunScoreConfig.SampleInterval) or 0.15)

		if accumulator < sampleInterval then
			return
		end

		accumulator %= sampleInterval
		publishAccumulator += sampleInterval

		for _, player in ipairs(Players:GetPlayers()) do
			updatePlayerScore(player)
		end

		local publishInterval = math.max(sampleInterval, tonumber(RunScoreConfig.PublishInterval) or 0.45)

		if publishAccumulator >= publishInterval then
			publishAccumulator %= publishInterval
			publishPendingScores()
		end
	end)
end

return RunScoreService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="93">
        <Properties>
          <string name="Name">RunSeedValidationService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ProceduralMapConfig = require(Shared:WaitForChild("ProceduralMapConfig"))
local RunGenerationConfig = require(Shared:WaitForChild("RunGenerationConfig"))

local WorldSpawnService = require(script.Parent:WaitForChild("WorldSpawnService"))

local RunSeedValidationService = {}

local BOUNDED_TERRAIN_KINDS = {
	Top = true,
	Bottom = true,
	Ramp = true,
	LinkTop = true,
	LinkBottom = true,
}
local MAX_REPORTED_ERRORS = 16

local function isFiniteNumber(value)
	return value == value and value > -math.huge and value < math.huge
end

local function isFiniteVector3(value)
	return isFiniteNumber(value.X) and isFiniteNumber(value.Y) and isFiniteNumber(value.Z)
end

local function getHorizontalExtents(part)
	local halfSize = part.Size * 0.5
	local cframe = part.CFrame
	local extentX = math.abs(cframe.RightVector.X) * halfSize.X
		+ math.abs(cframe.UpVector.X) * halfSize.Y
		+ math.abs(cframe.LookVector.X) * halfSize.Z
	local extentZ = math.abs(cframe.RightVector.Z) * halfSize.X
		+ math.abs(cframe.UpVector.Z) * halfSize.Y
		+ math.abs(cframe.LookVector.Z) * halfSize.Z

	return extentX, extentZ
end

local function isInsideBounds(part, bounds, tolerance)
	local extentX, extentZ = getHorizontalExtents(part)
	local position = part.Position

	return position.X - extentX >= bounds.MinX - tolerance
		and position.X + extentX <= bounds.MaxX + tolerance
		and position.Z - extentZ >= bounds.MinZ - tolerance
		and position.Z + extentZ <= bounds.MaxZ + tolerance
end

local function appendError(errors, code, detail)
	if #errors >= MAX_REPORTED_ERRORS then
		return
	end

	table.insert(errors, {
		Code = code,
		Detail = detail,
	})
end

function RunSeedValidationService.GetCandidateSeed(initialSeed, attemptNumber)
	local maximumSeed = RunGenerationConfig.MaximumSeed
	local normalizedSeed = math.clamp(math.floor(tonumber(initialSeed) or 1), 1, maximumSeed)
	local retryIndex = math.max(0, math.floor(tonumber(attemptNumber) or 1) - 1)

	return ((normalizedSeed - 1 + (retryIndex * RunGenerationConfig.RetrySeedStride)) % maximumSeed) + 1
end

function RunSeedValidationService.IsRetryableReason(reason)
	return RunGenerationConfig.RetryableReasons[tostring(reason)] == true
end

function RunSeedValidationService.ValidateTerrain(map, generationReport)
	if not RunGenerationConfig.SeedGuardEnabled or not ProceduralMapConfig.Enabled then
		return true, "Ok", {}
	end

	local errors = {}
	local terrainFolder = map and map:FindFirstChild(ProceduralMapConfig.TerrainFolderName)
	local bounds = WorldSpawnService.GetActivePlayableBounds()
	local countsByKind = {}
	local generatedPartCount = 0

	if terrainFolder == nil then
		appendError(errors, "TerrainFolderMissing")
	else
		for _, descendant in ipairs(terrainFolder:GetDescendants()) do
			if not descendant:IsA("BasePart") then
				continue
			end

			generatedPartCount += 1
			local terrainKind = tostring(descendant:GetAttribute(ProceduralMapConfig.TerrainKindAttributeName) or "Unknown")
			countsByKind[terrainKind] = (countsByKind[terrainKind] or 0) + 1

			if not isFiniteVector3(descendant.Position) or not isFiniteVector3(descendant.Size) then
				appendError(errors, "TerrainGeometryNonFinite", descendant:GetFullName())
			elseif descendant.Size.X <= 0 or descendant.Size.Y <= 0 or descendant.Size.Z <= 0 then
				appendError(errors, "TerrainGeometryEmpty", descendant:GetFullName())
			end

			if not descendant.Anchored
				or not descendant.CanCollide
				or descendant.CanTouch
				or not descendant.CanQuery
			then
				appendError(errors, "TerrainPhysicsUnexpected", descendant:GetFullName())
			end

			if bounds ~= nil
				and BOUNDED_TERRAIN_KINDS[terrainKind]
				and not isInsideBounds(descendant, bounds, RunGenerationConfig.HorizontalBoundsTolerance)
			then
				appendError(errors, "TerrainOutsidePlayableBounds", descendant:GetFullName())
			end
		end
	end

	if typeof(generationReport) ~= "table" then
		appendError(errors, "TerrainReportMissing")
	else
		local layouts = math.max(0, math.floor(tonumber(generationReport.Layouts) or 0))
		local platforms = math.max(0, math.floor(tonumber(generationReport.Platforms) or 0))
		local plannedPlatforms = math.max(0, math.floor(tonumber(generationReport.PlannedPlatforms) or platforms))
		local plannedRamps = math.max(0, math.floor(tonumber(generationReport.PlannedRamps) or 0))

		if layouts < ProceduralMapConfig.MinimumLayoutCount then
			appendError(errors, "LayoutCountBelowMinimum", layouts)
		end

		if platforms <= 0 or platforms ~= plannedPlatforms or (countsByKind.Top or 0) ~= platforms then
			appendError(errors, "PlatformPlanIncomplete", {
				Planned = plannedPlatforms,
				Reported = platforms,
				Actual = countsByKind.Top or 0,
			})
		end

		if (countsByKind.Ramp or 0) ~= plannedRamps then
			appendError(errors, "RampPlanIncomplete", {
				Planned = plannedRamps,
				Actual = countsByKind.Ramp or 0,
			})
		end
	end

	local validation = {
		Errors = errors,
		GeneratedParts = generatedPartCount,
		CountsByKind = countsByKind,
	}

	if #errors > 0 then
		return false, "SeedTerrainInvalid", validation
	end

	return true, "Ok", validation
end

function RunSeedValidationService.ValidateWorld(counts)
	if not RunGenerationConfig.SeedGuardEnabled then
		return true, "Ok", {}
	end

	local missing = {}

	for countKey, minimum in pairs(RunGenerationConfig.MinimumWorldCounts) do
		local actual = math.max(0, math.floor(tonumber(counts and counts[countKey]) or 0))

		if actual < minimum then
			table.insert(missing, {
				Type = countKey,
				Minimum = minimum,
				Actual = actual,
			})
		end
	end

	local validation = {
		Missing = missing,
		Counts = counts,
	}

	if #missing > 0 then
		return false, "SeedWorldInvalid", validation
	end

	return true, "Ok", validation
end

return RunSeedValidationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="94">
        <Properties>
          <string name="Name">RunSessionService</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChapterConfig = require(Shared:WaitForChild("ChapterConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local ChapterProgressService = require(script.Parent:WaitForChild("ChapterProgressService"))
local ProceduralMapService = require(script.Parent:WaitForChild("ProceduralMapService"))
local RunMapService = require(script.Parent:WaitForChild("RunMapService"))
local RunLoadingService = require(script.Parent:WaitForChild("RunLoadingService"))
local RunSeedValidationService = require(script.Parent:WaitForChild("RunSeedValidationService"))
local RunStateService = require(script.Parent:WaitForChild("RunStateService"))

local RunGenerationConfig = require(Shared:WaitForChild("RunGenerationConfig"))

local RunSessionService = {}

local runDataStore = DataStoreService:GetDataStore(ChapterConfig.RunDataStoreName)
local profilesByUserId = {}
local worldOwnerUserId = nil
local isStarted = false
local runWorldService = nil

local function createDefaultData()
	return {
		Version = ChapterConfig.DataVersion,
		CurrentRun = nil,
		History = {},
	}
end

local function copyCounterDictionary(rawDictionary)
	local copied = {}

	if typeof(rawDictionary) ~= "table" then
		return copied
	end

	for key, value in pairs(rawDictionary) do
		if typeof(key) == "string" then
			copied[key] = math.max(0, math.floor(tonumber(value) or 0))
		end
	end

	return copied
end

local function copyNumericDictionary(rawDictionary)
	local copied = {}

	if typeof(rawDictionary) ~= "table" then
		return copied
	end

	for key, value in pairs(rawDictionary) do
		local numberValue = tonumber(value)

		if typeof(key) == "string" and numberValue ~= nil and numberValue == numberValue then
			copied[key] = numberValue
		end
	end

	return copied
end

local function copyPerkStacks(rawPerks)
	local copied = {}

	if typeof(rawPerks) ~= "table" then
		return copied
	end

	for _, perk in ipairs(rawPerks) do
		if typeof(perk) == "table" then
			local perkId = tostring(perk.Id or "")

			if perkId ~= "" then
				table.insert(copied, {
					Id = perkId,
					Stacks = math.max(0, math.floor(tonumber(perk.Stacks) or 0)),
				})
			end
		end
	end

	return copied
end

-- Cette archive ne contient que des primitives DataStore. Le recapitulatif UI peut contenir Color3 et icones.
local function copyPersistentResultSummary(result)
	if typeof(result) ~= "table" then
		return nil
	end

	local context = if typeof(result.Context) == "table" then result.Context else {}
	local lifecycle = if typeof(result.Lifecycle) == "table" then result.Lifecycle else {}
	local progression = if typeof(result.ProgressionStats) == "table" then result.ProgressionStats else {}
	local combat = if typeof(result.CombatStats) == "table" then result.CombatStats else {}
	local interactions = if typeof(result.InteractionStats) == "table" then result.InteractionStats else {}
	local items = if typeof(result.ItemStats) == "table" then result.ItemStats else {}
	local build = if typeof(result.FinalBuild) == "table" then result.FinalBuild else {}
	local eligibility = if typeof(result.Eligibility) == "table" then result.Eligibility else {}

	return {
		Version = math.max(1, math.floor(tonumber(result.Version) or 1)),
		RunId = tostring(result.RunId or ""),
		UserId = math.max(0, math.floor(tonumber(result.UserId) or 0)),
		Context = {
			ChapterId = math.max(0, math.floor(tonumber(context.ChapterId) or 0)),
			MapId = tostring(context.MapId or ""),
			Seed = math.max(0, math.floor(tonumber(context.Seed) or 0)),
		},
		Lifecycle = {
			Status = tostring(lifecycle.Status or "Completed"),
			Outcome = tostring(lifecycle.Outcome or "Unknown"),
			EndReason = tostring(lifecycle.EndReason or "Unknown"),
			CreatedAt = math.max(0, math.floor(tonumber(lifecycle.CreatedAt) or 0)),
			StartedAt = math.max(0, math.floor(tonumber(lifecycle.StartedAt) or 0)),
			EndedAt = math.max(0, math.floor(tonumber(lifecycle.EndedAt) or 0)),
			ActiveDurationSeconds = math.max(0, math.floor(tonumber(lifecycle.ActiveDurationSeconds) or 0)),
			PausedDurationSeconds = math.max(0, math.floor(tonumber(lifecycle.PausedDurationSeconds) or 0)),
		},
		ProgressionStats = {
			FinalLevel = math.max(1, math.floor(tonumber(progression.FinalLevel) or 1)),
			XpEarned = math.max(0, math.floor(tonumber(progression.XpEarned) or 0)),
			CoinsEarned = math.max(0, math.floor(tonumber(progression.CoinsEarned) or 0)),
			CoinsSpent = math.max(0, math.floor(tonumber(progression.CoinsSpent) or 0)),
			CoinsRemaining = math.max(0, math.floor(tonumber(progression.CoinsRemaining) or 0)),
			PerksSelected = math.max(0, math.floor(tonumber(progression.PerksSelected) or 0)),
			MaxDifficultyPercent = math.max(0, math.floor(tonumber(progression.MaxDifficultyPercent) or 0)),
			RunScore = math.max(0, math.floor(tonumber(progression.RunScore) or 0)),
		},
		CombatStats = {
			Kills = math.max(0, math.floor(tonumber(combat.Kills) or 0)),
			EliteKills = math.max(0, math.floor(tonumber(combat.EliteKills) or 0)),
			BossKills = math.max(0, math.floor(tonumber(combat.BossKills) or 0)),
			DamageDealt = math.max(0, math.floor(tonumber(combat.DamageDealt) or 0)),
			DamageTaken = math.max(0, math.floor(tonumber(combat.DamageTaken) or 0)),
			ShieldDamageAbsorbed = math.max(0, math.floor(tonumber(combat.ShieldDamageAbsorbed) or 0)),
			HealingReceived = math.max(0, math.floor(tonumber(combat.HealingReceived) or 0)),
			KillsByEnemyId = copyCounterDictionary(combat.KillsByEnemyId),
			DamageByWeaponId = copyCounterDictionary(combat.DamageByWeaponId),
		},
		InteractionStats = {
			ChestsOpened = math.max(0, math.floor(tonumber(interactions.ChestsOpened) or 0)),
			RewardChestsOpened = math.max(0, math.floor(tonumber(interactions.RewardChestsOpened) or 0)),
			JarsBroken = math.max(0, math.floor(tonumber(interactions.JarsBroken) or 0)),
			DifficultyTotemsActivated = math.max(0, math.floor(tonumber(interactions.DifficultyTotemsActivated) or 0)),
			ShrinesActivated = copyCounterDictionary(interactions.ShrinesActivated),
			EliteChallengesStarted = math.max(0, math.floor(tonumber(interactions.EliteChallengesStarted) or 0)),
			PortalsActivated = math.max(0, math.floor(tonumber(interactions.PortalsActivated) or 0)),
		},
		ItemStats = {
			RunItemsById = copyCounterDictionary(items.RunItemsById),
		},
		FinalBuild = {
			WeaponId = tostring(build.WeaponId or ""),
			Perks = copyPerkStacks(build.Perks),
			Stats = copyNumericDictionary(build.Stats),
		},
		ChapterValidated = result.ChapterValidated == true,
		NewlyUnlockedChapterId = math.max(0, math.floor(tonumber(result.NewlyUnlockedChapterId) or 0)),
		Eligibility = {
			ProgressionEligible = eligibility.ProgressionEligible ~= false,
			LeaderboardEligible = eligibility.LeaderboardEligible ~= false,
			AdminCommandsUsed = eligibility.AdminCommandsUsed == true,
		},
	}
end

local function copySession(session)
	if typeof(session) ~= "table" then
		return nil
	end

	return {
		Version = ChapterConfig.DataVersion,
		RunId = tostring(session.RunId or ""),
		Seed = math.floor(tonumber(session.Seed) or 0),
		InitialSeed = math.floor(tonumber(session.InitialSeed) or tonumber(session.Seed) or 0),
		GenerationAttemptCount = math.max(0, math.floor(tonumber(session.GenerationAttemptCount) or 0)),
		RejectedSeedCount = math.max(0, math.floor(tonumber(session.RejectedSeedCount) or 0)),
		UserId = math.floor(tonumber(session.UserId) or 0),
		ChapterId = math.floor(tonumber(session.ChapterId) or 0),
		MapId = tostring(session.MapId or ""),
		LifecycleStatus = tostring(session.LifecycleStatus or "Unknown"),
		Outcome = session.Outcome and tostring(session.Outcome) or nil,
		EndReason = session.EndReason and tostring(session.EndReason) or nil,
		CreatedAt = math.floor(tonumber(session.CreatedAt) or 0),
		StartedAt = session.StartedAt and math.floor(tonumber(session.StartedAt) or 0) or nil,
		EndedAt = session.EndedAt and math.floor(tonumber(session.EndedAt) or 0) or nil,
		DestroyedAt = session.DestroyedAt and math.floor(tonumber(session.DestroyedAt) or 0) or nil,
		ChapterValidated = session.ChapterValidated == true,
		NewlyUnlockedChapterId = math.floor(tonumber(session.NewlyUnlockedChapterId) or 0),
		ResultSummary = copyPersistentResultSummary(session.ResultSummary),
	}
end

local function normalizeData(rawData)
	local data = createDefaultData()

	if typeof(rawData) ~= "table" then
		return data
	end

	data.CurrentRun = copySession(rawData.CurrentRun)

	if typeof(rawData.History) == "table" then
		local firstIndex = math.max(1, #rawData.History - ChapterConfig.MaxRunHistory + 1)

		for index = firstIndex, #rawData.History do
			local session = copySession(rawData.History[index])

			if session ~= nil and session.RunId ~= "" then
				table.insert(data.History, session)
			end
		end
	end

	return data
end

local function getDataStoreKey(player)
	return "Player_" .. player.UserId
end

local function getOrCreateProfile(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		profile = {
			Data = createDefaultData(),
			Loaded = false,
			SessionOnly = false,
			Dirty = false,
			Transferring = false,
		}
		profilesByUserId[player.UserId] = profile
	end

	return profile
end

local function publishSession(player, session)
	player:SetAttribute("RunId", session and session.RunId or nil)
	player:SetAttribute("RunSeed", session and session.Seed or nil)
	player:SetAttribute("RunInitialSeed", session and (session.InitialSeed or session.Seed) or nil)
	player:SetAttribute("RunGenerationAttemptCount", session and session.GenerationAttemptCount or nil)
	player:SetAttribute("RunRejectedSeedCount", session and session.RejectedSeedCount or nil)
	player:SetAttribute("RunChapterId", session and session.ChapterId or nil)
	player:SetAttribute("RunMapId", session and session.MapId or nil)
	player:SetAttribute("RunCreatedAt", session and session.CreatedAt or nil)
	player:SetAttribute("RunLifecycleStatus", session and session.LifecycleStatus or "Idle")
end

local function clearGenerationAttempt(session)
	if runWorldService ~= nil then
		local worldCleared, worldError = pcall(function()
			runWorldService.Clear()
		end)

		if not worldCleared then
			DebugLog.Warn("Perf", "Nettoyage monde apres rejet de seed en erreur", {
				RunId = session.RunId,
				Seed = session.Seed,
				Error = tostring(worldError),
			})
		end
	end

	RunMapService.Destroy(session.RunId)
end

local function generateRunAttempt(player, session)
	RunLoadingService.Update(player, "Map")
	local mapGenerated, arrivalOrReason = RunMapService.Generate(session)

	if not mapGenerated then
		return false, arrivalOrReason, nil, "Map"
	end

	local activeMap = RunMapService.GetActiveMap()
	local terrainGenerated, terrainReason = ProceduralMapService.Generate(
		session,
		activeMap,
		arrivalOrReason,
		function(stage, detail)
			RunLoadingService.Update(player, stage, detail)
		end
	)

	if not terrainGenerated then
		return false, terrainReason, nil, "Terrain"
	end

	local terrainValid, terrainValidationReason, terrainValidation = RunSeedValidationService.ValidateTerrain(
		activeMap,
		terrainReason
	)

	if not terrainValid then
		return false, terrainValidationReason, nil, "TerrainValidation", terrainValidation
	end

	local worldGenerated, worldReason = runWorldService.Generate(session, function(stage, detail)
		RunLoadingService.Update(player, stage, detail)
	end)

	if not worldGenerated then
		return false, worldReason, nil, "World"
	end

	local worldValid, worldValidationReason, worldValidation = RunSeedValidationService.ValidateWorld(worldReason)

	if not worldValid then
		return false, worldValidationReason, nil, "WorldValidation", worldValidation
	end

	return true, "Ok", arrivalOrReason, "Ready", {
		Terrain = terrainValidation,
		World = worldValidation,
	}
end

local function generateValidatedRun(player, session)
	local initialSeed = math.floor(tonumber(session.InitialSeed) or tonumber(session.Seed) or 1)
	local maximumAttempts = if RunGenerationConfig.SeedGuardEnabled
		then math.max(1, RunGenerationConfig.MaximumGenerationAttempts)
		else 1
	local lastReason = "UnknownGenerationFailure"

	for attemptNumber = 1, maximumAttempts do
		local candidateSeed = RunSeedValidationService.GetCandidateSeed(initialSeed, attemptNumber)
		session.Seed = candidateSeed
		session.GenerationAttemptCount = attemptNumber
		publishSession(player, session)

		if attemptNumber > 1 then
			RunLoadingService.Update(player, "Map", ("Nouvelle configuration %d / %d"):format(
				attemptNumber,
				maximumAttempts
			))
		end

		local callSucceeded, generated, reason, arrival, stage, validation = pcall(
			generateRunAttempt,
			player,
			session
		)

		if not callSucceeded then
			clearGenerationAttempt(session)
			DebugLog.Warn("Perf", "Exception pendant la validation d'une seed de run", {
				RunId = session.RunId,
				Seed = candidateSeed,
				Attempt = attemptNumber,
				Error = tostring(generated),
			})
			return false, "RunGenerationException", nil
		end

		if generated then
			DebugLog.Info("Perf", "Seed de run validee sur la generation Roblox reelle", {
				RunId = session.RunId,
				InitialSeed = initialSeed,
				AcceptedSeed = candidateSeed,
				Attempts = attemptNumber,
				RejectedSeeds = session.RejectedSeedCount or 0,
			})
			return true, "Ok", arrival
		end

		lastReason = tostring(reason)
		session.RejectedSeedCount = math.max(0, math.floor(tonumber(session.RejectedSeedCount) or 0)) + 1
		clearGenerationAttempt(session)

		local retryable = RunSeedValidationService.IsRetryableReason(lastReason)
		DebugLog.Warn("Perf", "Seed de run rejetee avant exposition du joueur", {
			RunId = session.RunId,
			Seed = candidateSeed,
			Attempt = attemptNumber,
			Stage = stage,
			Reason = lastReason,
			Retryable = retryable,
			Validation = validation,
		})

		if not retryable then
			return false, lastReason, nil
		end

		task.wait()
	end

	DebugLog.Warn("Perf", "Aucune seed de run valide dans le budget de tentatives", {
		RunId = session.RunId,
		InitialSeed = initialSeed,
		Attempts = maximumAttempts,
		LastReason = lastReason,
	})

	return false, "SeedValidationExhausted", nil
end

local function appendHistory(data, session)
	table.insert(data.History, copySession(session))

	while #data.History > ChapterConfig.MaxRunHistory do
		table.remove(data.History, 1)
	end
end

local function saveProfile(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil or not profile.Loaded or not profile.Dirty then
		return true
	end

	if profile.SessionOnly then
		profile.Dirty = false
		return true
	end

	local snapshot = normalizeData(profile.Data)
	local success, errorMessage = pcall(function()
		runDataStore:SetAsync(getDataStoreKey(player), snapshot)
	end)

	if not success then
		DebugLog.Warn("RunSession", "Sauvegarde de session impossible", {
			Player = player.Name,
			Error = tostring(errorMessage),
		})
		return false
	end

	profile.Dirty = false
	return true
end

local function transition(player, session, lifecycleStatus)
	session.LifecycleStatus = lifecycleStatus
	local profile = getOrCreateProfile(player)
	profile.Data.CurrentRun = session
	profile.Dirty = true
	publishSession(player, session)

	DebugLog.Info("RunSession", "Transition de run", {
		Player = player.Name,
		RunId = session.RunId,
		ChapterId = session.ChapterId,
		Status = lifecycleStatus,
	})
end

local function finalizeSession(player, outcome, resultSummary)
	local profile = profilesByUserId[player.UserId]
	local session = profile and profile.Data.CurrentRun

	if session == nil then
		return false
	end

	local cleanupFailures = {}

	-- La persistance d'une run ne doit jamais rester bloquee par le nettoyage d'un sous-systeme runtime.
	local function cleanupStep(name, callback)
		local success, errorMessage = pcall(callback)

		if not success then
			table.insert(cleanupFailures, {
				Step = name,
				Error = tostring(errorMessage),
			})
		end
	end

	cleanupStep("RunLoading", function()
		RunLoadingService.Cancel(player, outcome)
	end)

	session.Outcome = outcome or "Unknown"
	session.EndReason = outcome or "Unknown"
	session.ResultSummary = copyPersistentResultSummary(resultSummary)
	session.EndedAt = os.time()
	transition(player, session, "Saving")
	saveProfile(player)

	if worldOwnerUserId == player.UserId then
		cleanupStep("RunWorld", function()
			if runWorldService ~= nil then
				runWorldService.Clear()
			end
		end)

		cleanupStep("RunMap", function()
			RunMapService.Destroy(session.RunId)
		end)
		worldOwnerUserId = nil
	end

	session.DestroyedAt = os.time()
	session.LifecycleStatus = "Destroyed"
	appendHistory(profile.Data, session)
	profile.Data.CurrentRun = nil
	profile.Dirty = true
	publishSession(player, nil)
	saveProfile(player)

	DebugLog.Info("RunSession", "Cycle de run termine", {
		Player = player.Name,
		RunId = session.RunId,
		Outcome = session.Outcome,
		ChapterValidated = session.ChapterValidated,
		CleanupFailureCount = #cleanupFailures,
	})

	if #cleanupFailures > 0 then
		DebugLog.Warn("RunSession", "Nettoyage runtime partiellement en erreur, session liberee", {
			Player = player.Name,
			RunId = session.RunId,
			Failures = cleanupFailures,
		})
	end

	return true
end

function RunSessionService.SetupPlayer(player)
	local profile = getOrCreateProfile(player)
	local success, rawData = pcall(function()
		return runDataStore:GetAsync(getDataStoreKey(player))
	end)

	if success then
		profile.Data = normalizeData(rawData)
		profile.Loaded = true
		profile.SessionOnly = false
	elseif RunService:IsStudio() then
		profile.Data = createDefaultData()
		profile.Loaded = true
		profile.SessionOnly = true
		DebugLog.Warn("RunSession", "DataStore des runs indisponible dans Studio", {
			Player = player.Name,
			Error = tostring(rawData),
		})
	else
		profile.Loaded = false
		DebugLog.Warn("RunSession", "Chargement des runs impossible", {
			Player = player.Name,
			Error = tostring(rawData),
		})
	end

	publishSession(player, profile.Data.CurrentRun)
end

function RunSessionService.PrepareRun(player, chapterId)
	local profile = getOrCreateProfile(player)
	local chapter = ChapterConfig.GetChapter(chapterId)

	if not profile.Loaded then
		return false, "ProfileNotLoaded"
	end

	if chapter == nil then
		return false, "UnknownChapter"
	end

	if not ChapterProgressService.IsChapterUnlocked(player, chapter.Id) then
		return false, "ChapterLocked"
	end

	if profile.Data.CurrentRun ~= nil or RunStateService.IsRunActive(player) then
		return false, "RunAlreadyExists"
	end

	if worldOwnerUserId ~= nil and worldOwnerUserId ~= player.UserId then
		return false, "WorldAlreadyInUse"
	end

	local initialSeed = Random.new():NextInteger(1, RunGenerationConfig.MaximumSeed)
	local session = {
		Version = ChapterConfig.DataVersion,
		RunId = HttpService:GenerateGUID(false),
		Seed = initialSeed,
		InitialSeed = initialSeed,
		GenerationAttemptCount = 0,
		RejectedSeedCount = 0,
		UserId = player.UserId,
		ChapterId = chapter.Id,
		MapId = chapter.MapTemplateName,
		LifecycleStatus = "Creating",
		CreatedAt = os.time(),
		ChapterValidated = false,
	}

	transition(player, session, "Creating")
	saveProfile(player)

	return true, session
end

function RunSessionService.GetTeleportData(player)
	local profile = profilesByUserId[player.UserId]
	local session = profile and profile.Data.CurrentRun

	if session == nil then
		return nil
	end

	return {
		runId = session.RunId,
		runSeed = session.Seed,
		chapterId = session.ChapterId,
		mapId = session.MapId,
	}
end

function RunSessionService.MarkTeleporting(player)
	getOrCreateProfile(player).Transferring = true
end

function RunSessionService.ActivatePreparedRun(player, expectedRunId, reason)
	local profile = getOrCreateProfile(player)
	local session = profile.Data.CurrentRun

	if session == nil or (expectedRunId ~= nil and session.RunId ~= expectedRunId) then
		return false, "RunSessionMissing", nil
	end

	if worldOwnerUserId ~= nil and worldOwnerUserId ~= player.UserId then
		return false, "WorldAlreadyInUse", nil
	end

	worldOwnerUserId = player.UserId
	profile.Transferring = false
	transition(player, session, "Generating")
	saveProfile(player)
	RunLoadingService.Begin(player)

	if runWorldService == nil then
		finalizeSession(player, "WorldServiceMissing")
		return false, "WorldServiceMissing", nil
	end

	local generated, generationReason, generatedArrival = generateValidatedRun(player, session)

	if not generated then
		finalizeSession(player, tostring(generationReason))
		return false, generationReason, nil
	end

	transition(player, session, "Ready")
	saveProfile(player)

	return true, "Ok", generatedArrival
end

function RunSessionService.StartGeneratedRun(player, expectedRunId, reason)
	local profile = getOrCreateProfile(player)
	local session = profile.Data.CurrentRun

	if session == nil or (expectedRunId ~= nil and session.RunId ~= expectedRunId) then
		return false, "RunSessionMissing"
	end

	if session.LifecycleStatus ~= "Ready" then
		return false, "RunNotReady"
	end

	session.StartedAt = os.time()
	transition(player, session, "Active")
	saveProfile(player)

	if not RunStateService.StartRun(player, reason or "RunSessionActive") then
		finalizeSession(player, "RunStateRejected")
		return false, "RunStateRejected"
	end

	RunLoadingService.Complete(player)
	return true, "Ok"
end

function RunSessionService.ResolveArrival(player, teleportData)
	local profile = getOrCreateProfile(player)
	local currentRun = profile.Data.CurrentRun

	if typeof(teleportData) == "table" and typeof(teleportData.runId) == "string" then
		if currentRun == nil then
			local chapter = ChapterConfig.GetChapter(teleportData.chapterId)

			local teleportSeed = math.floor(tonumber(teleportData.runSeed) or 0)

			if chapter == nil
				or teleportData.mapId ~= chapter.MapTemplateName
				or teleportSeed <= 0
				or not ChapterProgressService.IsChapterUnlocked(player, chapter.Id)
			then
				return false, "InvalidTeleportData", nil
			end

			currentRun = {
				Version = ChapterConfig.DataVersion,
				RunId = teleportData.runId,
				Seed = teleportSeed,
				InitialSeed = teleportSeed,
				GenerationAttemptCount = 0,
				RejectedSeedCount = 0,
				UserId = player.UserId,
				ChapterId = chapter.Id,
				MapId = chapter.MapTemplateName,
				LifecycleStatus = "Creating",
				CreatedAt = os.time(),
				ChapterValidated = false,
			}
			profile.Data.CurrentRun = currentRun
			profile.Dirty = true
		end

		if currentRun.RunId ~= teleportData.runId or currentRun.UserId ~= player.UserId then
			return false, "RunIdentityMismatch", nil
		end

		return RunSessionService.ActivatePreparedRun(player, teleportData.runId, "TeleportArrival")
	end

	if currentRun ~= nil then
		finalizeSession(player, "Abandoned")
	end

	return false, "NoRunArrival", nil
end

function RunSessionService.CancelPreparedRun(player, reason)
	local profile = profilesByUserId[player.UserId]

	if profile ~= nil then
		profile.Transferring = false
	end

	return finalizeSession(player, reason or "Cancelled")
end

function RunSessionService.MarkChapterValidated(player)
	local profile = profilesByUserId[player.UserId]
	local session = profile and profile.Data.CurrentRun

	if session == nil or session.LifecycleStatus ~= "Active" then
		return false
	end

	session.ChapterValidated = true
	profile.Dirty = true
	publishSession(player, session)
	local marked, progression = ChapterProgressService.MarkChapterCompleted(player, session.ChapterId)

	if marked and progression ~= nil then
		session.NewlyUnlockedChapterId = progression.NewlyUnlockedChapterId
	end
	ChapterProgressService.SavePlayer(player)
	saveProfile(player)
	return true
end

function RunSessionService.GetCurrentSession(player)
	local profile = player and profilesByUserId[player.UserId]
	return profile and profile.Data.CurrentRun or nil
end

function RunSessionService.GetHistory(player)
	local profile = player and profilesByUserId[player.UserId]

	if profile == nil then
		return {}
	end

	local history = {}

	for _, session in ipairs(profile.Data.History) do
		table.insert(history, copySession(session))
	end

	return history
end

function RunSessionService.CompleteRun(player, endReason, resultSummary)
	return finalizeSession(player, endReason, resultSummary)
end

function RunSessionService.RemovePlayer(player)
	local profile = profilesByUserId[player.UserId]

	if profile ~= nil and not profile.Transferring and profile.Data.CurrentRun ~= nil then
		finalizeSession(player, "Abandoned")
	else
		saveProfile(player)
	end

	if worldOwnerUserId == player.UserId and (profile == nil or not profile.Transferring) then
		worldOwnerUserId = nil
	end

	profilesByUserId[player.UserId] = nil
end

function RunSessionService.SavePlayer(player)
	return saveProfile(player)
end

function RunSessionService.SetWorldService(service)
	runWorldService = service
end

function RunSessionService.Start()
	if isStarted then
		return
	end

	isStarted = true
	RunStateService.LevelValidated:Connect(function(player)
		RunSessionService.MarkChapterValidated(player)
	end)

	DebugLog.Info("RunSession", "RunSessionService demarre", {
		DataStore = ChapterConfig.RunDataStoreName,
		HistoryLimit = ChapterConfig.MaxRunHistory,
	})
end

return RunSessionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="95">
        <Properties>
          <string name="Name">RunStateService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local RunStateService = {}

local runStartedEvent = Instance.new("BindableEvent")
local runEndedEvent = Instance.new("BindableEvent")
local levelValidatedEvent = Instance.new("BindableEvent")

RunStateService.RunStarted = runStartedEvent.Event
RunStateService.RunEnded = runEndedEvent.Event
RunStateService.LevelValidated = levelValidatedEvent.Event

local statesByUserId = {}
local characterConnectionsByUserId = {}
local deathConnectionsByUserId = {}

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local stateRemote = getOrCreateRemote("Run_StateUpdate")

local function getState(player)
	local state = statesByUserId[player.UserId]

	if state == nil then
		state = {
			IsActive = false,
			StartedAt = nil,
			LastReason = "Initial",
		}
		statesByUserId[player.UserId] = state
	end

	return state
end

local function sendState(player)
	if player.Parent ~= Players then
		return
	end

	local state = getState(player)
	player:SetAttribute("IsRunActive", state.IsActive == true)

	stateRemote:FireClient(player, {
		IsRunActive = state.IsActive == true,
		StartedAt = state.StartedAt,
		Reason = state.LastReason,
	})
end

local function bindCharacter(player, character)
	local previousDeathConnection = deathConnectionsByUserId[player.UserId]

	if previousDeathConnection ~= nil then
		previousDeathConnection:Disconnect()
		deathConnectionsByUserId[player.UserId] = nil
	end

	local humanoid = character:WaitForChild("Humanoid", 8)

	if humanoid == nil then
		return
	end

	deathConnectionsByUserId[player.UserId] = humanoid.Died:Connect(function()
		if RunStateService.IsRunActive(player) then
			RunStateService.EndRun(player, "Death")
		else
			sendState(player)
		end
	end)
end

function RunStateService.SetRunActive(player, isActive, reason)
	if player == nil or player.Parent ~= Players then
		return false
	end

	local state = getState(player)
	local nextActive = isActive == true

	if state.IsActive == nextActive then
		state.LastReason = reason or state.LastReason
		sendState(player)
		return false
	end

	state.IsActive = nextActive

	if reason ~= nil then
		state.LastReason = reason
	elseif nextActive then
		state.LastReason = "RunStarted"
	else
		state.LastReason = "RunEnded"
	end

	state.StartedAt = if nextActive then os.clock() else nil

	sendState(player)

	if nextActive then
		runStartedEvent:Fire(player, state.LastReason)
		DebugLog.Info("RunState", "Run joueur activee", {
			Player = player.Name,
			Reason = state.LastReason,
		})
	else
		runEndedEvent:Fire(player, state.LastReason)
		DebugLog.Info("RunState", "Run joueur terminee", {
			Player = player.Name,
			Reason = state.LastReason,
		})
	end

	return true
end

function RunStateService.StartRun(player, reason)
	return RunStateService.SetRunActive(player, true, reason or "RunStarted")
end

function RunStateService.EndRun(player, reason)
	return RunStateService.SetRunActive(player, false, reason or "RunEnded")
end

function RunStateService.NotifyLevelValidated(player)
	if player == nil or not RunStateService.IsRunActive(player) then
		return false
	end

	levelValidatedEvent:Fire(player)
	return true
end

function RunStateService.IsRunActive(player)
	if player == nil then
		return false
	end

	local state = statesByUserId[player.UserId]

	return state ~= nil and state.IsActive == true
end

function RunStateService.SetupPlayer(player)
	getState(player)

	if characterConnectionsByUserId[player.UserId] ~= nil then
		characterConnectionsByUserId[player.UserId]:Disconnect()
	end

	characterConnectionsByUserId[player.UserId] = player.CharacterAdded:Connect(function(character)
		bindCharacter(player, character)
	end)

	if player.Character ~= nil then
		task.spawn(function()
			bindCharacter(player, player.Character)
		end)
	end

	sendState(player)
end

function RunStateService.RemovePlayer(player)
	statesByUserId[player.UserId] = nil

	if characterConnectionsByUserId[player.UserId] ~= nil then
		characterConnectionsByUserId[player.UserId]:Disconnect()
		characterConnectionsByUserId[player.UserId] = nil
	end

	if deathConnectionsByUserId[player.UserId] ~= nil then
		deathConnectionsByUserId[player.UserId]:Disconnect()
		deathConnectionsByUserId[player.UserId] = nil
	end
end

return RunStateService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="96">
        <Properties>
          <string name="Name">RunTeleportService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local RunTeleportConfig = require(Shared:WaitForChild("RunTeleportConfig"))

local ChapterProgressService = require(script.Parent:WaitForChild("ChapterProgressService"))
local RunSessionService = require(script.Parent:WaitForChild("RunSessionService"))
local RunStateService = require(script.Parent:WaitForChild("RunStateService"))

local RunTeleportService = {}

local isStarted = false
local trackedTriggers = {}
local cooldownsByUserId = {}
local teleportingByUserId = {}
local arrivalConnectionsByUserId = {}
local neutralizedContainers = {}
local pendingLobbySummariesByUserId = {}

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local function getOrCreateRemoteFunction(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteFunction")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteFunction"), remoteName .. " doit etre un RemoteFunction.")

	return remote
end

local runSummaryRemote = getOrCreateRemote("Run_ShowSummary")
local startRunRemote = getOrCreateRemoteFunction("Run_StartRequest")

local function getPlayerFromHit(hit)
	if hit == nil then
		return nil
	end

	local character = hit:FindFirstAncestorOfClass("Model")

	if character == nil then
		return nil
	end

	return Players:GetPlayerFromCharacter(character)
end

local function getContainerNamed(instance, containerName)
	local current = instance

	while current ~= nil and current ~= Workspace do
		if current.Name == containerName then
			return current
		end

		current = current.Parent
	end

	return nil
end

local function getTriggerContainer(instance)
	return getContainerNamed(instance, RunTeleportConfig.TriggerPartName)
end

local function neutralizeContainer(container, shouldDisableTouch)
	if container == nil or neutralizedContainers[container] then
		return
	end

	neutralizedContainers[container] = true

	local disabledScriptCount = 0
	local disabledTouchCount = 0

	for _, descendant in ipairs(container:GetDescendants()) do
		if descendant:IsA("BaseScript") then
			descendant.Disabled = true
			disabledScriptCount += 1
		elseif shouldDisableTouch and descendant:IsA("BasePart") then
			descendant.CanTouch = false
			disabledTouchCount += 1
		end
	end

	if container:IsA("BaseScript") then
		container.Disabled = true
		disabledScriptCount += 1
	elseif shouldDisableTouch and container:IsA("BasePart") then
		container.CanTouch = false
		disabledTouchCount += 1
	end

	if disabledScriptCount > 0 or disabledTouchCount > 0 then
		DebugLog.Warn("RunTeleport", "Teleport boutique neutralise", {
			Container = container,
			DisabledScripts = disabledScriptCount,
			DisabledTouchParts = disabledTouchCount,
		})
	end
end

local function neutralizeTeleportTemplateParts()
	if not RunTeleportConfig.DisableTemplateTeleportScripts then
		return
	end

	local seenContainers = {}

	for _, descendant in ipairs(Workspace:GetDescendants()) do
		local trigger = getContainerNamed(descendant, RunTeleportConfig.TriggerPartName)

		if trigger ~= nil and not seenContainers[trigger] then
			seenContainers[trigger] = true
			neutralizeContainer(trigger, false)
		end

		local arrival = getContainerNamed(descendant, RunTeleportConfig.ArrivalPartName)

		if arrival ~= nil and not seenContainers[arrival] then
			seenContainers[arrival] = true
			neutralizeContainer(arrival, RunTeleportConfig.DisableArrivalTouch == true)
		end
	end
end

local function getBaseParts(instance)
	local parts = {}

	if instance:IsA("BasePart") then
		table.insert(parts, instance)
		return parts
	end

	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
		end
	end

	return parts
end

local function findArrivalInstance(arrivalPartName)
	local arrival = Workspace:FindFirstChild(arrivalPartName, true)

	if arrival == nil then
		return nil
	end

	if arrival:IsA("BasePart") or arrival:IsA("Model") then
		return arrival
	end

	local parent = arrival:FindFirstAncestorOfClass("Model")

	if parent ~= nil then
		return parent
	end

	return nil
end

local function getInstancePivot(instance)
	if instance:IsA("Model") then
		return instance:GetPivot()
	end

	if instance:IsA("BasePart") then
		return instance.CFrame
	end

	return nil
end

local function destroyArrivalInstance(arrival)
	if not RunTeleportConfig.DestroyArrivalAfterUse then
		return false
	end

	if arrival == nil or arrival.Parent == nil then
		return false
	end

	local arrivalName = arrival.Name
	arrival:Destroy()

	DebugLog.Warn("RunTeleport", "Point d'arrivee run supprime apres usage", {
		ArrivalName = arrivalName,
	})

	return true
end

local function movePlayerToArrival(player, arrivalPartName, providedArrival)
	local character = player.Character

	if character == nil then
		return false, "CharacterMissing", nil
	end

	local root = character:FindFirstChild("HumanoidRootPart")

	if root == nil then
		root = character:WaitForChild("HumanoidRootPart", 8)
	end

	if root == nil then
		return false, "RootMissing", nil
	end

	local arrival = providedArrival or findArrivalInstance(arrivalPartName)

	if arrival == nil then
		return false, "ArrivalMissing", nil
	end

	local arrivalPivot = getInstancePivot(arrival)

	if arrivalPivot == nil then
		return false, "ArrivalPivotMissing", nil
	end

	character:PivotTo(arrivalPivot + Vector3.new(0, RunTeleportConfig.ArrivalHeightOffset, 0))

	return true, "Ok", arrival
end

local function copyTeleportData(player)
	local data = {}

	for key, value in pairs(RunTeleportConfig.TeleportData or {}) do
		data[key] = value
	end

	data.arrivalPartName = RunTeleportConfig.ArrivalPartName
	data.sourcePartName = RunTeleportConfig.TriggerPartName

	local sessionData = RunSessionService.GetTeleportData(player)

	if sessionData ~= nil then
		for key, value in pairs(sessionData) do
			data[key] = value
		end
	end

	return data
end

local function copyLobbyTeleportData(summary)
	return {
		runMode = "LobbyReturn",
		runSummary = summary,
	}
end

local function canStartTeleport(player)
	if not RunTeleportConfig.Enabled then
		return false, "Disabled"
	end

	if player == nil or player.Parent == nil then
		return false, "PlayerMissing"
	end

	if teleportingByUserId[player.UserId] then
		return false, "AlreadyTeleporting"
	end

	if RunStateService.IsRunActive(player) then
		return false, "RunAlreadyActive"
	end

	local now = os.clock()
	local lastTouchAt = cooldownsByUserId[player.UserId]

	if lastTouchAt ~= nil and now - lastTouchAt < RunTeleportConfig.TouchCooldownSeconds then
		return false, "Cooldown"
	end

	if RunTeleportConfig.RunPlaceId == nil or RunTeleportConfig.RunPlaceId <= 0 then
		return false, "InvalidPlaceId"
	end

	return true, "Ok"
end

function RunTeleportService.StartSoloRun(player, trigger, explicitChapterId)
	local canStart, reason = canStartTeleport(player)

	if not canStart then
		DebugLog.ThrottledInfo("RunTeleport", "teleport_refused_" .. tostring(player and player.UserId), 2, "Teleport run refuse", {
			Player = player and player.Name or "nil",
			Reason = reason,
			Trigger = trigger,
		})
		return false, reason
	end

	cooldownsByUserId[player.UserId] = os.clock()
	teleportingByUserId[player.UserId] = true

	local requestedChapter = math.floor(
		tonumber(explicitChapterId)
			or tonumber(trigger and trigger:GetAttribute("ChapterId"))
			or ChapterProgressService.GetSelectedChapter(player)
	)
	local prepared, sessionOrReason = RunSessionService.PrepareRun(player, requestedChapter)

	if not prepared then
		teleportingByUserId[player.UserId] = nil
		DebugLog.Warn("RunTeleport", "Preparation de run refusee", {
			Player = player.Name,
			ChapterId = requestedChapter,
			Reason = sessionOrReason,
		})
		return false, sessionOrReason
	end

	local teleportData = copyTeleportData(player)

	if RunService:IsStudio() and RunTeleportConfig.StudioSimulatesArrival then
		local activated, activateReason, generatedArrival = RunSessionService.ActivatePreparedRun(
			player,
			sessionOrReason.RunId,
			"StudioTeleport"
		)
		local moved, moveReason, arrival = false, activateReason, nil

		if activated then
			moved, moveReason, arrival = movePlayerToArrival(
				player,
				RunTeleportConfig.ArrivalPartName,
				generatedArrival
			)
		end
		local started = false

		if moved then
			started, moveReason = RunSessionService.StartGeneratedRun(
				player,
				sessionOrReason.RunId,
				"StudioTeleport"
			)
			moved = started
		end
		local arrivalDestroyed = false

		teleportingByUserId[player.UserId] = nil
		if moved then
			arrivalDestroyed = destroyArrivalInstance(arrival)
		elseif activated then
			RunSessionService.CancelPreparedRun(player, "ArrivalFailed")
		end
		DebugLog.Warn("RunTeleport", "Teleport reserve simule en Studio", {
			Player = player.Name,
			ArrivalPartName = RunTeleportConfig.ArrivalPartName,
			Moved = moved,
			Started = started,
			Reason = moveReason,
			ArrivalDestroyed = arrivalDestroyed,
		})
		return moved, moveReason
	end

	local teleportOptions = Instance.new("TeleportOptions")
	teleportOptions.ShouldReserveServer = RunTeleportConfig.ShouldReserveServer == true
	teleportOptions:SetTeleportData(teleportData)

	local success, result = pcall(function()
		return TeleportService:TeleportAsync(RunTeleportConfig.RunPlaceId, { player }, teleportOptions)
	end)

	if not success then
		teleportingByUserId[player.UserId] = nil
		RunSessionService.CancelPreparedRun(player, "TeleportFailed")
		DebugLog.Warn("RunTeleport", "Teleport run impossible", {
			Player = player.Name,
			PlaceId = RunTeleportConfig.RunPlaceId,
			Error = tostring(result),
		})
		return false, "TeleportFailed"
	end

	RunSessionService.MarkTeleporting(player)

	DebugLog.Info("RunTeleport", "Teleport run demande", {
		Player = player.Name,
		PlaceId = RunTeleportConfig.RunPlaceId,
		Reserved = RunTeleportConfig.ShouldReserveServer == true,
		Result = tostring(result),
	})

	return true, "TeleportRequested"
end

function RunTeleportService.ReturnToLobby(player, summary)
	if player == nil or player.Parent == nil then
		return false
	end

	if RunService:IsStudio() and RunTeleportConfig.StudioSimulatesLobbyReturn then
		player:LoadCharacter()

		if summary ~= nil then
			task.delay(0.7, function()
				if player.Parent ~= nil then
					runSummaryRemote:FireClient(player, summary)
				end
			end)
		end

		DebugLog.Warn("RunTeleport", "Retour lobby simule en Studio", {
			Player = player.Name,
		})
		return true
	end

	local lobbyPlaceId = RunTeleportConfig.LobbyPlaceId or game.PlaceId

	if lobbyPlaceId <= 0 then
		DebugLog.Warn("RunTeleport", "Retour lobby impossible, PlaceId invalide", {
			Player = player.Name,
			PlaceId = lobbyPlaceId,
		})
		return false
	end

	local teleportOptions = Instance.new("TeleportOptions")
	teleportOptions:SetTeleportData(copyLobbyTeleportData(summary))

	local success, result = pcall(function()
		return TeleportService:TeleportAsync(lobbyPlaceId, { player }, teleportOptions)
	end)

	if not success then
		DebugLog.Warn("RunTeleport", "Retour lobby impossible", {
			Player = player.Name,
			PlaceId = lobbyPlaceId,
			Error = tostring(result),
		})
		return false
	end

	if summary ~= nil then
		pendingLobbySummariesByUserId[player.UserId] = summary
	end

	DebugLog.Info("RunTeleport", "Retour lobby demande", {
		Player = player.Name,
		PlaceId = lobbyPlaceId,
	})
	return true
end

local function onTriggerTouched(trigger, hit)
	local player = getPlayerFromHit(hit)

	if player == nil then
		return
	end

	RunTeleportService.StartSoloRun(player, trigger)
end

local function trackTrigger(instance)
	local trigger = getTriggerContainer(instance)

	if trigger == nil or trackedTriggers[trigger] ~= nil then
		return
	end

	local parts = getBaseParts(trigger)

	if #parts <= 0 then
		DebugLog.Warn("RunTeleport", "Plaque de teleport sans BasePart", {
			Trigger = trigger,
		})
		return
	end

	local connections = {}

	for _, part in ipairs(parts) do
		part.CanTouch = true
		table.insert(connections, part.Touched:Connect(function(hit)
			onTriggerTouched(trigger, hit)
		end))
	end

	trackedTriggers[trigger] = connections

	DebugLog.Info("RunTeleport", "Plaque de lancement run trackee", {
		Trigger = trigger,
		PartCount = #parts,
		RunPlaceId = RunTeleportConfig.RunPlaceId,
		ArrivalPartName = RunTeleportConfig.ArrivalPartName,
	})
end

local function scanTriggers()
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		trackTrigger(descendant)
	end
end

local function getSoloTeleportData(player)
	local success, joinData = pcall(function()
		return player:GetJoinData()
	end)

	if not success or typeof(joinData) ~= "table" then
		return nil
	end

	local teleportData = joinData.TeleportData

	if typeof(teleportData) ~= "table" or teleportData.runMode ~= "Solo" then
		return nil
	end

	return teleportData
end

local function getLobbyReturnSummary(player)
	local success, joinData = pcall(function()
		return player:GetJoinData()
	end)

	if not success or typeof(joinData) ~= "table" then
		return nil
	end

	local teleportData = joinData.TeleportData

	if typeof(teleportData) ~= "table" or teleportData.runMode ~= "LobbyReturn" then
		return nil
	end

	if typeof(teleportData.runSummary) ~= "table" then
		return nil
	end

	return teleportData.runSummary
end

function RunTeleportService.SetupPlayer(player)
	local lobbySummary = getLobbyReturnSummary(player)

	if lobbySummary ~= nil then
		RunSessionService.ResolveArrival(player, nil)

		local function sendLobbySummary()
			local connection = arrivalConnectionsByUserId[player.UserId]

			if connection ~= nil then
				connection:Disconnect()
				arrivalConnectionsByUserId[player.UserId] = nil
			end

			task.delay(0.7, function()
				if player.Parent ~= nil then
					runSummaryRemote:FireClient(player, lobbySummary)
				end
			end)
		end

		if player.Character ~= nil then
			sendLobbySummary()
		else
			arrivalConnectionsByUserId[player.UserId] = player.CharacterAdded:Connect(sendLobbySummary)
		end

		return
	end

	local soloTeleportData = getSoloTeleportData(player)

	if soloTeleportData == nil then
		RunSessionService.ResolveArrival(player, nil)
		return
	end

	local arrivalPartName = if typeof(soloTeleportData.arrivalPartName) == "string"
		and soloTeleportData.arrivalPartName ~= ""
		then soloTeleportData.arrivalPartName
		else RunTeleportConfig.ArrivalPartName

	neutralizeTeleportTemplateParts()

	local function placeCharacter()
		local activated, activationReason, generatedArrival = RunSessionService.ResolveArrival(player, soloTeleportData)
		local moved, reason, arrival = false, activationReason, nil

		if activated then
			moved, reason, arrival = movePlayerToArrival(player, arrivalPartName, generatedArrival)
		end
		local started = false

		if moved then
			started, reason = RunSessionService.StartGeneratedRun(
				player,
				soloTeleportData.runId,
				"TeleportArrival"
			)
			moved = started
		end
		local arrivalDestroyed = false

		if moved then
			arrivalDestroyed = destroyArrivalInstance(arrival)
		elseif activated then
			RunSessionService.CancelPreparedRun(player, "ArrivalFailed")
		end

		DebugLog.Info("RunTeleport", "Placement joueur apres teleport", {
			Player = player.Name,
			ArrivalPartName = arrivalPartName,
			Moved = moved,
			Started = started,
			Reason = reason,
			ArrivalDestroyed = arrivalDestroyed,
		})

		local connection = arrivalConnectionsByUserId[player.UserId]

		if connection ~= nil then
			connection:Disconnect()
			arrivalConnectionsByUserId[player.UserId] = nil
		end
	end

	if player.Character ~= nil then
		task.defer(placeCharacter)
	else
		arrivalConnectionsByUserId[player.UserId] = player.CharacterAdded:Connect(function()
			task.defer(placeCharacter)
		end)
	end
end

function RunTeleportService.RemovePlayer(player)
	teleportingByUserId[player.UserId] = nil
	cooldownsByUserId[player.UserId] = nil
	pendingLobbySummariesByUserId[player.UserId] = nil

	local connection = arrivalConnectionsByUserId[player.UserId]

	if connection ~= nil then
		connection:Disconnect()
		arrivalConnectionsByUserId[player.UserId] = nil
	end
end

function RunTeleportService.Start()
	if isStarted then
		DebugLog.Info("RunTeleport", "Start ignore, service deja demarre")
		return
	end

	isStarted = true
	startRunRemote.OnServerInvoke = function(player, chapterId)
		local selected, selectionReason = ChapterProgressService.SelectChapter(player, chapterId)

		if not selected then
			DebugLog.Warn("RunTeleport", "Lancement GUI refuse", {
				Player = player.Name,
				ChapterId = chapterId,
				Reason = selectionReason,
			})
			return false, selectionReason
		end

		return RunTeleportService.StartSoloRun(player, nil, chapterId)
	end

	neutralizeTeleportTemplateParts()
	scanTriggers()

	Workspace.DescendantAdded:Connect(function(descendant)
		task.defer(function()
			local trigger = getContainerNamed(descendant, RunTeleportConfig.TriggerPartName)
			local arrival = getContainerNamed(descendant, RunTeleportConfig.ArrivalPartName)

			if trigger ~= nil then
				neutralizeContainer(trigger, false)
			end

			if arrival ~= nil then
				neutralizeContainer(arrival, RunTeleportConfig.DisableArrivalTouch == true)
			end

			trackTrigger(descendant)
		end)
	end)

	Workspace.DescendantRemoving:Connect(function(descendant)
		local connections = trackedTriggers[descendant]

		if connections == nil then
			return
		end

		for _, connection in ipairs(connections) do
			connection:Disconnect()
		end

		trackedTriggers[descendant] = nil
	end)

	TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage, placeId)
		teleportingByUserId[player.UserId] = nil
		RunSessionService.CancelPreparedRun(player, "TeleportInitFailed")
		local pendingSummary = pendingLobbySummariesByUserId[player.UserId]
		pendingLobbySummariesByUserId[player.UserId] = nil
		DebugLog.Warn("RunTeleport", "Initialisation teleport echouee", {
			Player = player.Name,
			Result = tostring(teleportResult),
			Error = tostring(errorMessage),
			PlaceId = placeId,
		})

		if pendingSummary ~= nil then
			player:LoadCharacter()
			task.delay(0.7, function()
				if player.Parent ~= nil then
					runSummaryRemote:FireClient(player, pendingSummary)
				end
			end)
		end
	end)

	DebugLog.Info("RunTeleport", "RunTeleportService demarre", {
		Enabled = RunTeleportConfig.Enabled,
		TriggerPartName = RunTeleportConfig.TriggerPartName,
		ArrivalPartName = RunTeleportConfig.ArrivalPartName,
		RunPlaceId = RunTeleportConfig.RunPlaceId,
	})
end

return RunTeleportService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="97">
        <Properties>
          <string name="Name">RunWorldService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local RunLoadingConfig = require(Shared:WaitForChild("RunLoadingConfig"))

local ChestService = require(script.Parent:WaitForChild("ChestService"))
local JarService = require(script.Parent:WaitForChild("JarService"))
local PortalService = require(script.Parent:WaitForChild("PortalService"))
local ShrineService = require(script.Parent:WaitForChild("ShrineService"))
local TotemService = require(script.Parent:WaitForChild("TotemService"))

local RunWorldService = {}

local isReady = false

function RunWorldService.Start()
	RunWorldService.Clear()
	isReady = true
	DebugLog.Info("RunWorld", "Generateurs de contenu runtime prets")
end

function RunWorldService.WaitUntilReady(timeoutSeconds)
	local deadline = os.clock() + (timeoutSeconds or 10)

	while not isReady and os.clock() < deadline do
		task.wait()
	end

	return isReady
end

local GENERATION_STEPS = {
	{
		CountKey = "Portals",
		Stage = "Portal",
		Label = "Portail boss",
		BatchSize = RunLoadingConfig.BatchSizes.Portal,
		Generate = function(session, options)
			return PortalService.GenerateForRun(session, options)
		end,
	},
	{
		CountKey = "Shrines",
		Stage = "Shrines",
		Label = "Autels",
		BatchSize = RunLoadingConfig.BatchSizes.Shrines,
		Generate = function(session, options)
			return ShrineService.GenerateForRun(session, options)
		end,
	},
	{
		CountKey = "Chests",
		Stage = "Chests",
		Label = "Coffres",
		BatchSize = RunLoadingConfig.BatchSizes.Chests,
		Generate = function(session, options)
			return ChestService.GenerateForRun(session, options)
		end,
	},
	{
		CountKey = "Totems",
		Stage = "Totems",
		Label = "Totems",
		BatchSize = RunLoadingConfig.BatchSizes.Totems,
		Generate = function(session, options)
			return TotemService.GenerateForRun(session, options)
		end,
	},
	{
		CountKey = "Jars",
		Stage = "Jars",
		Label = "Jarres",
		BatchSize = RunLoadingConfig.BatchSizes.Jars,
		Generate = function(session, options)
			return JarService.GenerateForRun(session, options)
		end,
	},
}

function RunWorldService.Generate(session, onProgress)
	if not RunWorldService.WaitUntilReady(10) then
		return false, "GeneratorsNotReady"
	end

	local counts = {}

	for _, step in ipairs(GENERATION_STEPS) do
		if onProgress ~= nil then
			onProgress(step.Stage, step.Label)
		end

		counts[step.CountKey] = step.Generate(session, {
			BatchSize = step.BatchSize,
			OnBatch = function(placed, requested, typeId)
				if onProgress == nil then
					return
				end

				local detailLabel = step.Label

				if typeId ~= nil then
					detailLabel ..= " " .. tostring(typeId)
				end

				onProgress(step.Stage, ("%s : %d / %d"):format(detailLabel, placed, requested))
			end,
		})

		-- Laisse au serveur et au client le temps de respirer entre deux familles lourdes.
		task.wait()
	end

	if counts.Portals < 1 then
		RunWorldService.Clear()
		DebugLog.Warn("RunWorld", "Generation refusee, portail boss absent", {
			RunId = session.RunId,
			ChapterId = session.ChapterId,
		})
		return false, "BossPortalMissing"
	end

	DebugLog.Info("RunWorld", "Contenu de run genere", {
		RunId = session.RunId,
		Seed = session.Seed,
		ChapterId = session.ChapterId,
		Portals = counts.Portals,
		Shrines = counts.Shrines,
		Chests = counts.Chests,
		Totems = counts.Totems,
		Jars = counts.Jars,
	})

	return true, counts
end

function RunWorldService.Clear()
	PortalService.ClearRunContent()
	ShrineService.ClearRunContent()
	ChestService.ClearRunContent()
	TotemService.ClearRunContent()
	JarService.ClearRunContent()
end

return RunWorldService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="98">
        <Properties>
          <string name="Name">ScoreService</string>
          <string name="Source"><![CDATA[local ScoreService = {}

local scoresByUserId = {}

local function getOrCreateScoreValue(player)
	local leaderstats = player:FindFirstChild("leaderstats")

	if leaderstats == nil then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local scoreValue = leaderstats:FindFirstChild("Score")

	if scoreValue == nil then
		scoreValue = Instance.new("IntValue")
		scoreValue.Name = "Score"
		scoreValue.Parent = leaderstats
	end

	return scoreValue
end

function ScoreService.SetupPlayer(player)
	if scoresByUserId[player.UserId] == nil then
		scoresByUserId[player.UserId] = 0
	end

	local scoreValue = getOrCreateScoreValue(player)
	scoreValue.Value = scoresByUserId[player.UserId]
end

function ScoreService.RemovePlayer(player)
	scoresByUserId[player.UserId] = nil
end

function ScoreService.GetScore(player)
	return scoresByUserId[player.UserId] or 0
end

function ScoreService.AddPoints(player, points)
	local currentScore = ScoreService.GetScore(player)
	local nextScore = currentScore + points

	scoresByUserId[player.UserId] = nextScore
	getOrCreateScoreValue(player).Value = nextScore

	return nextScore
end

return ScoreService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="99">
        <Properties>
          <string name="Name">ShrineService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local ShrineConfig = require(Shared:WaitForChild("ShrineConfig"))

local CoinService = require(script.Parent:WaitForChild("CoinService"))
local AudioService = require(script.Parent:WaitForChild("AudioService"))
local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local HudMessageService = require(script.Parent:WaitForChild("HudMessageService"))
local MonsterService = require(script.Parent:WaitForChild("MonsterService"))
local PerkService = require(script.Parent:WaitForChild("PerkService"))
local RunAnalyticsService = require(script.Parent:WaitForChild("RunAnalyticsService"))
local TemplateService = require(script.Parent:WaitForChild("TemplateService"))
local WorldSpawnService = require(script.Parent:WaitForChild("WorldSpawnService"))
local XpService = require(script.Parent:WaitForChild("XpService"))

local ShrineService = {}

local SHRINE_DEFINITIONS = {
	{
		TypeId = "Perk",
		TemplateName = ShrineConfig.PerkShrineTemplateName,
		InitialSpawnCount = ShrineConfig.InitialSpawnCount,
		PromptName = "PerkShrinePrompt",
		PromptText = ShrineConfig.PromptText,
		PromptObjectText = ShrineConfig.PromptObjectText,
		ChargeDuration = ShrineConfig.ChargeDuration,
		ChargeDistance = ShrineConfig.ChargeDistance,
		DischargeDuration = ShrineConfig.ChargeDuration,
		ActivationMode = "BubblePresence",
		BubbleVisibleWhenActive = true,
		SpawnMinRadius = ShrineConfig.SpawnWorldMinRadius,
		SpawnMaxRadius = ShrineConfig.SpawnWorldMaxRadius,
		SpawnMinDistance = ShrineConfig.SpawnWorldMinObjectDistance,
		LogLabel = "shrines perk",
		FallbackColor = Color3.fromRGB(72, 63, 100),
	},
	{
		TypeId = "EliteChallenge",
		TemplateName = ShrineConfig.EliteChallengeShrineTemplateName,
		InitialSpawnCount = ShrineConfig.EliteChallengeInitialSpawnCount,
		PromptName = "EliteChallengeShrinePrompt",
		PromptText = ShrineConfig.EliteChallengePromptText,
		PromptObjectText = ShrineConfig.EliteChallengePromptObjectText,
		ChargeDuration = ShrineConfig.ChargeDuration * 0.5,
		ChargeDistance = ShrineConfig.ChargeDistance,
		SpawnMinRadius = 36,
		SpawnMaxRadius = ShrineConfig.SpawnWorldMaxRadius,
		SpawnMinDistance = 32,
		LogLabel = "shrines elite",
		FallbackColor = Color3.fromRGB(135, 51, 51),
	},
	{
		TypeId = "Magnet",
		TemplateName = ShrineConfig.MagnetShrineTemplateName,
		InitialSpawnCount = ShrineConfig.MagnetInitialSpawnCount,
		PromptName = "MagnetShrinePrompt",
		PromptText = ShrineConfig.MagnetPromptText,
		PromptObjectText = ShrineConfig.MagnetPromptObjectText,
		ChargeDuration = ShrineConfig.ChargeDuration * 0.5,
		ChargeDistance = ShrineConfig.ChargeDistance,
		SpawnMinRadius = 20,
		SpawnMaxRadius = 215,
		SpawnMinDistance = 18,
		RelaxedSpawnMaxRadius = 235,
		RelaxedSpawnMinDistance = 10,
		RelaxedSpawnAttemptsMultiplier = 3,
		LogLabel = "shrines magnet",
		FallbackColor = Color3.fromRGB(63, 112, 120),
	},
}

local runtimeFolder = nil
local isStarted = false
local shrineTemplatesByType = {}
local spawnedCountsByType = {}
local nextAudioLoopId = 0
local shrinesByInstance = {}
local chargeHeartbeatConnection = nil

local function createFallbackShrineTemplate(templateStorage, definition)
	local model = Instance.new("Model")
	model.Name = definition.TemplateName

	local base = Instance.new("Part")
	base.Name = "Base"
	base.Size = Vector3.new(6, 1, 6)
	base.Color = definition.FallbackColor
	base.Material = Enum.Material.Slate
	base.Anchored = true
	base.Parent = model

	local chargePart = Instance.new("Part")
	chargePart.Name = ShrineConfig.ChargePartName
	chargePart.Size = Vector3.new(8, 5, 8)
	chargePart.Position = Vector3.new(0, 2.5, 0)
	chargePart.Transparency = 1
	chargePart.Anchored = true
	chargePart.CanCollide = false
	chargePart.CanTouch = false
	chargePart.CanQuery = false
	chargePart.Parent = model

	if definition.TypeId == "Perk" then
		local bubble = Instance.new("Part")
		bubble.Name = ShrineConfig.BubbleName
		bubble.Shape = Enum.PartType.Ball
		bubble.Size = Vector3.new(8, 8, 8)
		bubble.Position = Vector3.new(0, 3.2, 0)
		bubble.Color = Color3.fromRGB(135, 215, 255)
		bubble.Material = Enum.Material.ForceField
		bubble.Transparency = 0.45
		bubble.Anchored = true
		bubble.CanCollide = false
		bubble.CanTouch = false
		bubble.CanQuery = false
		bubble.Parent = model
	end

	model.PrimaryPart = base
	model.Parent = templateStorage

	DebugLog.Warn("Shrine", "Template shrine introuvable, fallback cree", {
		Template = definition.TemplateName,
		TypeId = definition.TypeId,
	})

	return model
end

local function hasAncestorNamed(instance, ancestorName)
	local current = instance.Parent

	while current ~= nil do
		if current.Name == ancestorName then
			return true
		end

		current = current.Parent
	end

	return false
end

local function isIgnoredForGrounding(part)
	return part.Name == ShrineConfig.ChargePartName
		or part.Name == ShrineConfig.BubbleName
		or hasAncestorNamed(part, ShrineConfig.BubbleName)
		or part.Name == ShrineConfig.ActivationMarkerName
end

local function findGroundingPart(instance)
	if instance:IsA("BasePart") then
		return instance
	end

	if not instance:IsA("Model") then
		return nil
	end

	if instance.PrimaryPart ~= nil and not isIgnoredForGrounding(instance.PrimaryPart) then
		return instance.PrimaryPart
	end

	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("BasePart") and not isIgnoredForGrounding(descendant) then
			instance.PrimaryPart = descendant
			return descendant
		end
	end

	return instance:FindFirstChildWhichIsA("BasePart", true)
end

local function findRoot(instance)
	if instance:IsA("BasePart") then
		return instance
	end

	if not instance:IsA("Model") then
		return nil
	end

	return findGroundingPart(instance)
end

local function getLowestWorldY(part)
	local halfSize = part.Size * 0.5
	local lowestY = math.huge

	for _, xSign in ipairs({ -1, 1 }) do
		for _, ySign in ipairs({ -1, 1 }) do
			for _, zSign in ipairs({ -1, 1 }) do
				local corner = part.CFrame:PointToWorldSpace(Vector3.new(
					halfSize.X * xSign,
					halfSize.Y * ySign,
					halfSize.Z * zSign
				))
				lowestY = math.min(lowestY, corner.Y)
			end
		end
	end

	return lowestY
end

local function correctShrineGrounding(shrine, surfacePosition)
	if not shrine:IsA("Model") then
		return false, 0, 0
	end

	local lowestY = nil
	local groundingPartCount = 0

	for _, descendant in ipairs(shrine:GetDescendants()) do
		if descendant:IsA("BasePart") and not isIgnoredForGrounding(descendant) then
			groundingPartCount += 1
			local partLowestY = getLowestWorldY(descendant)
			lowestY = if lowestY == nil then partLowestY else math.min(lowestY, partLowestY)
		end
	end

	if lowestY == nil then
		DebugLog.Warn("Shrine", "Shrine sans corps 3D exploitable hors Bubble", {
			Shrine = shrine,
			SurfacePosition = surfacePosition,
		})
		return false, 0, groundingPartCount
	end

	local verticalCorrection = (surfacePosition.Y + ShrineConfig.SpawnSurfaceOffset) - lowestY

	if math.abs(verticalCorrection) > 0.001 then
		shrine:PivotTo(shrine:GetPivot() + Vector3.new(0, verticalCorrection, 0))
	end

	return true, verticalCorrection, groundingPartCount
end

local function findPromptPart(shrine)
	local chargePart = shrine:FindFirstChild(ShrineConfig.ChargePartName, true)

	if chargePart ~= nil and chargePart:IsA("BasePart") then
		return chargePart
	end

	return findRoot(shrine)
end

local function findBubble(shrine)
	return shrine:FindFirstChild(ShrineConfig.BubbleName, true)
end

local function createRuntimeFallbackBubble(shrine, definition)
	if definition.TypeId ~= "Perk" or findBubble(shrine) ~= nil then
		return
	end

	local root = findRoot(shrine)

	if root == nil then
		return
	end

	local bubble = Instance.new("Part")
	bubble.Name = ShrineConfig.BubbleName
	bubble.Shape = Enum.PartType.Ball
	bubble.Size = ShrineConfig.FallbackBubbleSize
	bubble.CFrame = CFrame.new(root.Position + Vector3.new(0, ShrineConfig.FallbackBubbleHeightOffset, 0))
	bubble.Color = Color3.fromRGB(135, 215, 255)
	bubble.Material = Enum.Material.ForceField
	bubble.Transparency = 0.45
	bubble.Anchored = true
	bubble.CanCollide = false
	bubble.CanTouch = false
	bubble.CanQuery = false
	bubble.Parent = shrine

	DebugLog.Warn("Shrine", "Bubble PerkShrine absente, fallback runtime cree", {
		Shrine = shrine,
	})
end

local function setVisualVisible(instance, isVisible)
	if instance:IsA("BasePart") or instance:IsA("Decal") or instance:IsA("Texture") then
		if instance:GetAttribute("ShrineOriginalTransparency") == nil then
			instance:SetAttribute("ShrineOriginalTransparency", instance.Transparency)
		end

		if isVisible then
			instance.Transparency = instance:GetAttribute("ShrineOriginalTransparency")
		else
			instance.Transparency = 1
		end
	elseif instance:IsA("ParticleEmitter") or instance:IsA("Beam") or instance:IsA("Trail") or instance:IsA("BillboardGui") then
		instance.Enabled = isVisible
	end
end

local function setBubbleVisible(shrine, isVisible)
	local bubble = findBubble(shrine)

	if bubble == nil then
		return
	end

	setVisualVisible(bubble, isVisible)

	for _, descendant in ipairs(bubble:GetDescendants()) do
		setVisualVisible(descendant, isVisible)
	end
end

local function ensureBubbleIsInsideTemplate(template)
	if template == nil or findBubble(template) ~= nil then
		return
	end

	local looseBubble = Workspace:FindFirstChild(ShrineConfig.BubbleName, true)

	if looseBubble == nil or looseBubble:IsDescendantOf(runtimeFolder) then
		DebugLog.Warn("Shrine", "Bubble absente du template PerkShrine", {
			Template = template,
		})
		return
	end

	DebugLog.Warn("Shrine", "Bubble rattachee au template PerkShrine", {
		Bubble = looseBubble,
		Template = template,
	})
	looseBubble.Parent = template
end

local function getPlayerRoot(player)
	local character = player.Character

	if character == nil then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function getShrinePosition(shrine)
	if shrine:IsA("Model") then
		local cframe = shrine:GetBoundingBox()

		return cframe.Position
	end

	local root = findRoot(shrine)

	if root == nil then
		return nil
	end

	return root.Position
end

local function isPlayerCloseEnough(player, shrine, definition)
	local playerRoot = getPlayerRoot(player)
	local shrinePosition = getShrinePosition(shrine)

	if playerRoot == nil or shrinePosition == nil then
		return false
	end

	return (playerRoot.Position - shrinePosition).Magnitude <= definition.ChargeDistance + 1
end

local function getBubbleChargeZone(shrine, definition)
	local bubble = findBubble(shrine)

	if bubble ~= nil and bubble:IsA("BasePart") then
		return bubble.Position, math.max(bubble.Size.X, bubble.Size.Y, bubble.Size.Z) * 0.5
	end

	if bubble ~= nil and bubble:IsA("Model") then
		local cframe, size = bubble:GetBoundingBox()

		return cframe.Position, math.max(size.X, size.Y, size.Z) * 0.5
	end

	local chargePart = shrine:FindFirstChild(ShrineConfig.ChargePartName, true)

	if chargePart ~= nil and chargePart:IsA("BasePart") then
		return chargePart.Position, math.max(chargePart.Size.X, chargePart.Size.Y, chargePart.Size.Z) * 0.5
	end

	return getShrinePosition(shrine), definition.ChargeDistance
end

local function isPlayerInsideBubbleChargeZone(player, shrine, definition)
	local playerRoot = getPlayerRoot(player)
	local zonePosition, zoneRadius = getBubbleChargeZone(shrine, definition)

	if playerRoot == nil or zonePosition == nil then
		return false
	end

	return (playerRoot.Position - zonePosition).Magnitude <= zoneRadius + 1
end

local function findBubbleChargePlayer(shrine, definition)
	for _, player in ipairs(Players:GetPlayers()) do
		if isPlayerInsideBubbleChargeZone(player, shrine, definition) then
			return player
		end
	end

	return nil
end

local function setShrineChargeProgress(shrine, progress)
	shrine:SetAttribute("ShrineChargeProgress", math.clamp(progress, 0, 1))
end

local function playChargeSound(shrineState, player)
	local chargingPlayer = player or shrineState.ChargingPlayer

	if chargingPlayer ~= nil then
		AudioService.StartLoopForPlayer(chargingPlayer, "ShrineCharge", shrineState.AudioLoopId)
	end
end

local function stopChargeSound(shrineState)
	if shrineState.ChargingPlayer ~= nil then
		AudioService.StopLoopForPlayer(shrineState.ChargingPlayer, shrineState.AudioLoopId)
	end
end

local function playCompleteSound(shrineState, player)
	local soundKey = if shrineState.Definition.TypeId == "EliteChallenge" then "ShrineEliteComplete" else "ShrineComplete"
	AudioService.PlayForPlayer(player, soundKey)
end

local function getMarkerHeight(shrine)
	if shrine:IsA("Model") then
		local _, size = shrine:GetBoundingBox()

		return (size.Y * 0.5) + ShrineConfig.ActivationMarkerHeightOffset
	end

	if shrine:IsA("BasePart") then
		return (shrine.Size.Y * 0.5) + ShrineConfig.ActivationMarkerHeightOffset
	end

	return ShrineConfig.ActivationMarkerHeightOffset
end

local function setupActivationMarker(shrine)
	local root = findRoot(shrine)

	if root == nil then
		return nil
	end

	local marker = root:FindFirstChild(ShrineConfig.ActivationMarkerName)

	if marker == nil then
		marker = Instance.new("BillboardGui")
		marker.Name = ShrineConfig.ActivationMarkerName
		marker.Parent = root
	end

	assert(marker:IsA("BillboardGui"), ShrineConfig.ActivationMarkerName .. " doit etre un BillboardGui.")

	marker.Adornee = root
	marker.AlwaysOnTop = true
	marker.Enabled = true
	marker.LightInfluence = 0
	marker.MaxDistance = ShrineConfig.ActivationMarkerMaxDistance
	marker.Size = UDim2.fromOffset(42, 42)
	marker.StudsOffset = Vector3.new(0, getMarkerHeight(shrine), 0)

	local shell = marker:FindFirstChild("MetalShell")

	if shell == nil then
		shell = Instance.new("Frame")
		shell.Name = "MetalShell"
		shell.Parent = marker
	end

	assert(shell:IsA("Frame"), "MetalShell du marker shrine doit etre un Frame.")

	shell.Size = UDim2.fromScale(1, 1)
	shell.BackgroundColor3 = Color3.fromRGB(37, 51, 70)
	shell.BackgroundTransparency = 0.14
	shell.BorderSizePixel = 0
	shell.ZIndex = 1

	local shellCorner = shell:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
	shellCorner.CornerRadius = UDim.new(1, 0)
	shellCorner.Parent = shell

	local shellStroke = shell:FindFirstChild("MetalStroke")

	if shellStroke == nil then
		shellStroke = Instance.new("UIStroke")
		shellStroke.Name = "MetalStroke"
		shellStroke.Parent = shell
	end

	assert(shellStroke:IsA("UIStroke"), "MetalStroke du marker shrine doit etre un UIStroke.")
	shellStroke.Color = Color3.fromRGB(122, 199, 255)
	shellStroke.Transparency = 0.2
	shellStroke.Thickness = 2

	local shellGradient = shell:FindFirstChild("MetalGradient")

	if shellGradient == nil then
		shellGradient = Instance.new("UIGradient")
		shellGradient.Name = "MetalGradient"
		shellGradient.Parent = shell
	end

	assert(shellGradient:IsA("UIGradient"), "MetalGradient du marker shrine doit etre un UIGradient.")
	shellGradient.Rotation = 90
	shellGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(74, 98, 130)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(11, 19, 30)),
	})

	local inner = shell:FindFirstChild("GlassInner")

	if inner == nil then
		inner = Instance.new("Frame")
		inner.Name = "GlassInner"
		inner.Parent = shell
	end

	assert(inner:IsA("Frame"), "GlassInner du marker shrine doit etre un Frame.")

	inner.Position = UDim2.fromOffset(4, 4)
	inner.Size = UDim2.new(1, -8, 1, -8)
	inner.BackgroundColor3 = Color3.fromRGB(12, 21, 32)
	inner.BackgroundTransparency = 0.28
	inner.BorderSizePixel = 0
	inner.ZIndex = 2

	local innerCorner = inner:FindFirstChildOfClass("UICorner") or Instance.new("UICorner")
	innerCorner.CornerRadius = UDim.new(1, 0)
	innerCorner.Parent = inner

	local innerStroke = inner:FindFirstChild("GlassStroke")

	if innerStroke == nil then
		innerStroke = Instance.new("UIStroke")
		innerStroke.Name = "GlassStroke"
		innerStroke.Parent = inner
	end

	assert(innerStroke:IsA("UIStroke"), "GlassStroke du marker shrine doit etre un UIStroke.")
	innerStroke.Color = Color3.fromRGB(238, 247, 255)
	innerStroke.Transparency = 0.7
	innerStroke.Thickness = 1

	local label = marker:FindFirstChild("Label", true)

	if label == nil then
		label = Instance.new("TextLabel")
		label.Name = "Label"
	end

	assert(label:IsA("TextLabel"), "Label du marker shrine doit etre un TextLabel.")

	label.Parent = inner
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamBlack
	label.Text = ShrineConfig.ActivationMarkerText
	label.TextColor3 = Color3.fromRGB(255, 232, 92)
	label.TextScaled = true
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 0.2
	label.ZIndex = 3

	for _, child in ipairs(label:GetChildren()) do
		if child:IsA("UICorner") or child:IsA("UIStroke") then
			child:Destroy()
		end
	end

	return marker
end

local function setActivationMarkerVisible(shrine, isVisible)
	local shrineState = shrinesByInstance[shrine]

	if shrineState == nil or shrineState.Marker == nil then
		return
	end

	shrineState.Marker.Enabled = isVisible
end

local function setShrineInactive(shrine, prompt)
	local shrineState = shrinesByInstance[shrine]

	if shrineState ~= nil then
		stopChargeSound(shrineState)
		shrineState.ChargingPlayer = nil
		shrineState.ChargeProgress = 0
	end

	shrine:SetAttribute("ShrineActive", false)
	shrine:SetAttribute("ShrineCharging", false)
	setShrineChargeProgress(shrine, 0)
	setBubbleVisible(shrine, false)
	setActivationMarkerVisible(shrine, false)

	if prompt ~= nil then
		prompt.Enabled = false
	end
end

local function onChargeStarted(shrine, player)
	local shrineState = shrinesByInstance[shrine]

	if shrineState == nil
		or not shrineState.Active
		or CombatStateService.IsPaused()
		or not isPlayerCloseEnough(player, shrine, shrineState.Definition)
	then
		return
	end

	shrineState.ChargingPlayer = player
	shrine:SetAttribute("ShrineCharging", true)
	setBubbleVisible(shrine, true)
	playChargeSound(shrineState, player)
	DebugLog.Info("Shrine", "Charge shrine commencee", {
		Player = player.Name,
		Shrine = shrine,
		TypeId = shrineState.Definition.TypeId,
	})
end

local function onChargeEnded(shrine)
	local shrineState = shrinesByInstance[shrine]

	if shrineState == nil or not shrineState.Active then
		return
	end

	shrine:SetAttribute("ShrineCharging", false)
	setBubbleVisible(shrine, false)
	stopChargeSound(shrineState)
	shrineState.ChargingPlayer = nil
	DebugLog.Info("Shrine", "Charge shrine interrompue", {
		Shrine = shrine,
		TypeId = shrineState.Definition.TypeId,
	})
end

local function activateMagnetShrine(player)
	local xpCount = XpService.CollectAllForPlayer(
		player,
		ShrineConfig.MagnetCollectDuration,
		ShrineConfig.MagnetCollectSpreadDuration
	)
	local coinCount = CoinService.CollectAllForPlayer(
		player,
		ShrineConfig.MagnetCollectDuration,
		ShrineConfig.MagnetCollectSpreadDuration
	)

	DebugLog.Info("Shrine", "MagnetShrine activee", {
		Player = player.Name,
		XpCount = xpCount,
		CoinCount = coinCount,
	})
end

local function activateEliteChallengeShrine(player, shrine)
	local shrinePosition = getShrinePosition(shrine)
	local spawnedCount, requestedCount = MonsterService.SpawnElitePack(shrinePosition, player)

	if spawnedCount > 0 then
		HudMessageService.Show(player, "EliteChallenge", {
			Message = ("CHALLENGE ELITE : %d ENNEMIS APPROCHENT"):format(spawnedCount),
		})
	end

	DebugLog.Info("Shrine", "EliteChallengeShrine activee", {
		Player = player.Name,
		Shrine = shrine,
		Spawned = spawnedCount,
		Requested = requestedCount,
	})
end

local function activateShrineEffect(player, definition, shrine)
	if definition.TypeId == "Perk" then
		PerkService.QueueBonusChoice(player, ShrineConfig.PerkChoiceTitle)
	elseif definition.TypeId == "Magnet" then
		activateMagnetShrine(player)
	elseif definition.TypeId == "EliteChallenge" then
		activateEliteChallengeShrine(player, shrine)
	end
end

local function activateShrineFromPlayer(shrine, prompt, player)
	local shrineState = shrinesByInstance[shrine]

	if shrineState == nil
		or not shrineState.Active
		or CombatStateService.IsPaused()
		or not isPlayerCloseEnough(player, shrine, shrineState.Definition)
	then
		return false
	end

	shrineState.Active = false
	shrineState.ChargeProgress = 1
	stopChargeSound(shrineState)
	shrineState.ChargingPlayer = nil
	playCompleteSound(shrineState, player)
	setShrineInactive(shrine, prompt)
	activateShrineEffect(player, shrineState.Definition, shrine)
	RunAnalyticsService.RecordShrineActivated(player, shrineState.Definition.TypeId)
	DebugLog.Info("Shrine", "Shrine validee", {
		Player = player.Name,
		Shrine = shrine,
		TypeId = shrineState.Definition.TypeId,
	})

	return true
end

local function onShrineTriggered(shrine, prompt, player)
	activateShrineFromPlayer(shrine, prompt, player)
end

local function updateBubblePresenceShrine(shrine, shrineState, deltaTime)
	local definition = shrineState.Definition

	if definition.ActivationMode ~= "BubblePresence" or not shrineState.Active then
		return
	end

	if CombatStateService.IsPaused() then
		if shrineState.ChargingPlayer ~= nil then
			stopChargeSound(shrineState)
			shrineState.ChargingPlayer = nil
			shrine:SetAttribute("ShrineCharging", false)
		end

		return
	end

	local player = findBubbleChargePlayer(shrine, definition)

	if player ~= nil then
		if shrineState.ChargingPlayer ~= player then
			shrineState.ChargingPlayer = player
			shrine:SetAttribute("ShrineCharging", true)
			setBubbleVisible(shrine, true)
			playChargeSound(shrineState, player)
			DebugLog.Info("Shrine", "Charge shrine par presence commencee", {
				Player = player.Name,
				Shrine = shrine,
				TypeId = definition.TypeId,
			})
		end

		local chargeDuration = math.max(0.1, definition.ChargeDuration)
		shrineState.ChargeProgress = math.min(1, (shrineState.ChargeProgress or 0) + (deltaTime / chargeDuration))
		setShrineChargeProgress(shrine, shrineState.ChargeProgress)

		if shrineState.ChargeProgress >= 1 then
			activateShrineFromPlayer(shrine, shrineState.Prompt, player)
		end

		return
	end

	if shrineState.ChargingPlayer ~= nil then
		DebugLog.Info("Shrine", "Charge shrine par presence interrompue", {
			Shrine = shrine,
			TypeId = definition.TypeId,
		})
	end

	stopChargeSound(shrineState)
	shrineState.ChargingPlayer = nil
	shrine:SetAttribute("ShrineCharging", false)

	if (shrineState.ChargeProgress or 0) > 0 then
		local dischargeDuration = math.max(0.1, definition.DischargeDuration or definition.ChargeDuration)

		shrineState.ChargeProgress = math.max(0, shrineState.ChargeProgress - (deltaTime / dischargeDuration))
		setShrineChargeProgress(shrine, shrineState.ChargeProgress)
	end
end

local function updateBubblePresenceShrines(deltaTime)
	for shrine, shrineState in pairs(shrinesByInstance) do
		updateBubblePresenceShrine(shrine, shrineState, deltaTime)
	end
end

local function setupPrompt(shrine, definition)
	local promptPart = findPromptPart(shrine)

	if promptPart == nil then
		DebugLog.Warn("Shrine", "Aucune BasePart pour placer le ProximityPrompt", {
			Shrine = shrine,
			TypeId = definition.TypeId,
		})
		return nil, nil
	end

	local prompt = promptPart:FindFirstChild(definition.PromptName)

	if prompt == nil then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = definition.PromptName
		prompt.Parent = promptPart
	end

	assert(prompt:IsA("ProximityPrompt"), definition.PromptName .. " doit etre un ProximityPrompt.")

	prompt.ActionText = definition.PromptText
	prompt.ObjectText = definition.PromptObjectText
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = definition.ChargeDuration
	prompt.MaxActivationDistance = definition.ChargeDistance
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.Enabled = true

	DebugLog.Info("Shrine", "ProximityPrompt shrine pret", {
		Shrine = shrine,
		TypeId = definition.TypeId,
		PromptPart = promptPart,
		Distance = definition.ChargeDistance,
		HoldDuration = definition.ChargeDuration,
	})

	prompt.PromptButtonHoldBegan:Connect(function(player)
		onChargeStarted(shrine, player)
	end)

	prompt.PromptButtonHoldEnded:Connect(function()
		onChargeEnded(shrine)
	end)

	prompt.Triggered:Connect(function(player)
		onShrineTriggered(shrine, prompt, player)
	end)

	return prompt, promptPart
end

local function removePrompt(shrine, promptName)
	for _, descendant in ipairs(shrine:GetDescendants()) do
		if descendant:IsA("ProximityPrompt") and descendant.Name == promptName then
			descendant:Destroy()
		end
	end
end

local function prepareShrineInstance(shrine, definition)
	createRuntimeFallbackBubble(shrine, definition)

	local bubble = findBubble(shrine)
	local chargePart = shrine:FindFirstChild(ShrineConfig.ChargePartName, true)

	for _, descendant in ipairs(shrine:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanTouch = false
			descendant.CanQuery = false

			if descendant == chargePart or (bubble ~= nil and (descendant == bubble or descendant:IsDescendantOf(bubble))) then
				descendant.CanCollide = false
			end
		end
	end

	if shrine:IsA("BasePart") then
		shrine.Anchored = true
		shrine.CanTouch = false
		shrine.CanQuery = false
	end

	if chargePart ~= nil and chargePart:IsA("BasePart") then
		chargePart.Transparency = 1
	end

	shrine:SetAttribute("ShrineActive", true)
	shrine:SetAttribute("ShrineCharging", false)
	setShrineChargeProgress(shrine, 0)
	shrine:SetAttribute("ShrineType", definition.TypeId)

	local prompt = nil
	local promptPart = findPromptPart(shrine)

	if definition.ActivationMode == "BubblePresence" then
		removePrompt(shrine, definition.PromptName)
		setBubbleVisible(shrine, definition.BubbleVisibleWhenActive == true)
		DebugLog.Info("Shrine", "Charge shrine par presence prete", {
			Shrine = shrine,
			TypeId = definition.TypeId,
			ChargeDuration = definition.ChargeDuration,
			DischargeDuration = definition.DischargeDuration,
		})
	else
		setBubbleVisible(shrine, false)
		prompt, promptPart = setupPrompt(shrine, definition)
	end

	local marker = setupActivationMarker(shrine)

	return prompt, marker
end

local function pivotInstance(instance, cframe)
	if instance:IsA("Model") or instance:IsA("BasePart") then
		instance:PivotTo(cframe)
	end
end

local function spawnShrineAtSurface(definition, surfacePosition)
	local shrineTemplate = shrineTemplatesByType[definition.TypeId]

	if shrineTemplate == nil then
		return nil
	end

	local shrine = shrineTemplate:Clone()
	shrine.Name = definition.TemplateName
	shrine.Parent = runtimeFolder

	local root = findRoot(shrine)

	if root == nil then
		DebugLog.Warn("Shrine", "Shrine sans BasePart, generation annulee", {
			Shrine = shrine,
			TypeId = definition.TypeId,
		})
		shrine:Destroy()
		return nil
	end

	local prompt, marker = prepareShrineInstance(shrine, definition)
	local pivotPosition = WorldSpawnService.GetSurfacePivotPosition(
		shrine,
		surfacePosition,
		ShrineConfig.SpawnSurfaceOffset,
		isIgnoredForGrounding
	)

	pivotInstance(shrine, WorldSpawnService.GetPivotCFrameAtPosition(shrine, pivotPosition))
	local wasGrounded, verticalCorrection, groundingPartCount = correctShrineGrounding(shrine, surfacePosition)

	nextAudioLoopId += 1
	shrinesByInstance[shrine] = {
		Active = true,
		Definition = definition,
		Marker = marker,
		Prompt = prompt,
		ChargeProgress = 0,
		ChargingPlayer = nil,
		AudioLoopId = "ShrineCharge_" .. tostring(nextAudioLoopId),
	}

	shrine.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			local shrineState = shrinesByInstance[shrine]

			if shrineState ~= nil then
				stopChargeSound(shrineState)
			end

			shrinesByInstance[shrine] = nil
		end
	end)

	spawnedCountsByType[definition.TypeId] = (spawnedCountsByType[definition.TypeId] or 0) + 1

	DebugLog.Info("Shrine", "Shrine generee", {
		Shrine = shrine,
		TypeId = definition.TypeId,
		SurfacePosition = surfacePosition,
		PivotPosition = shrine:GetPivot().Position,
		Grounded = wasGrounded,
		GroundingCorrection = verticalCorrection,
		GroundingParts = groundingPartCount,
		SpawnedCount = spawnedCountsByType[definition.TypeId],
	})

	return shrine
end

local function getOccupiedSurfacePositions()
	local occupiedPositions = WorldSpawnService.GetPositionsFromFolder(runtimeFolder)

	for _, position in ipairs(WorldSpawnService.GetPositionsFromFolder(TemplateService.GetPortalsRuntimeFolder())) do
		table.insert(occupiedPositions, position)
	end

	for _, position in ipairs(WorldSpawnService.GetPositionsFromFolder(TemplateService.GetChestsRuntimeFolder())) do
		table.insert(occupiedPositions, position)
	end

	for _, position in ipairs(WorldSpawnService.GetPositionsFromFolder(TemplateService.GetJarsRuntimeFolder())) do
		table.insert(occupiedPositions, position)
	end

	return occupiedPositions
end

local function copyPositions(positions)
	local copiedPositions = {}

	for _, position in ipairs(positions) do
		table.insert(copiedPositions, position)
	end

	return copiedPositions
end

local function findSurfacePositionsForDefinition(definition, neededCount)
	local occupiedPositions = getOccupiedSurfacePositions()
	local surfacePositions = WorldSpawnService.FindDistributedSurfacePositions({
		Count = neededCount,
		Center = ShrineConfig.SpawnWorldCenter,
		MinRadius = definition.SpawnMinRadius,
		MaxRadius = definition.SpawnMaxRadius,
		MinDistance = definition.SpawnMinDistance,
		AttemptsPerPoint = ShrineConfig.SpawnWorldAttemptsPerShrine,
		JitterRadius = ShrineConfig.SpawnWorldJitterRadius,
		UsePlayableBounds = true,
		EdgeInset = ShrineConfig.SpawnWorldEdgeInset,
		RaycastHeight = ShrineConfig.SpawnRaycastHeight,
		RaycastDepth = ShrineConfig.SpawnRaycastDepth,
		RejectedSurfaceNameContains = ShrineConfig.RejectedSurfaceNameContains,
		OccupiedPositions = occupiedPositions,
		LogCategory = "Shrine",
		LogLabel = definition.LogLabel,
	})

	local missingCount = neededCount - #surfacePositions

	if missingCount <= 0 or definition.RelaxedSpawnMinDistance == nil then
		return surfacePositions
	end

	DebugLog.Warn("Shrine", "Retry placement shrine avec contraintes relachees", {
		TypeId = definition.TypeId,
		Missing = missingCount,
		MaxRadius = definition.RelaxedSpawnMaxRadius or definition.SpawnMaxRadius,
		MinDistance = definition.RelaxedSpawnMinDistance,
	})

	local relaxedOccupiedPositions = copyPositions(occupiedPositions)

	for _, surfacePosition in ipairs(surfacePositions) do
		table.insert(relaxedOccupiedPositions, surfacePosition)
	end

	local relaxedSurfacePositions = WorldSpawnService.FindDistributedSurfacePositions({
		Count = missingCount,
		Center = ShrineConfig.SpawnWorldCenter,
		MinRadius = definition.SpawnMinRadius,
		MaxRadius = definition.RelaxedSpawnMaxRadius or definition.SpawnMaxRadius,
		MinDistance = definition.RelaxedSpawnMinDistance,
		AttemptsPerPoint = ShrineConfig.SpawnWorldAttemptsPerShrine * (definition.RelaxedSpawnAttemptsMultiplier or 2),
		JitterRadius = ShrineConfig.SpawnWorldJitterRadius,
		UsePlayableBounds = true,
		EdgeInset = ShrineConfig.SpawnWorldEdgeInset,
		RaycastHeight = ShrineConfig.SpawnRaycastHeight,
		RaycastDepth = ShrineConfig.SpawnRaycastDepth,
		RejectedSurfaceNameContains = ShrineConfig.RejectedSurfaceNameContains,
		OccupiedPositions = relaxedOccupiedPositions,
		LogCategory = "Shrine",
		LogLabel = definition.LogLabel .. " retry",
	})

	for _, surfacePosition in ipairs(relaxedSurfacePositions) do
		table.insert(surfacePositions, surfacePosition)
	end

	return surfacePositions
end

local function spawnInitialShrinesForDefinition(definition, generationOptions)
	if shrineTemplatesByType[definition.TypeId] == nil then
		DebugLog.Warn("Shrine", "Generation shrine impossible, template absent", {
			TypeId = definition.TypeId,
			Template = definition.TemplateName,
		})
		return
	end

	local spawnedCount = spawnedCountsByType[definition.TypeId] or 0
	local neededCount = math.max(0, definition.InitialSpawnCount - spawnedCount)

	if neededCount <= 0 then
		DebugLog.Info("Shrine", "Generation shrine ignoree, limite deja atteinte", {
			TypeId = definition.TypeId,
			SpawnedCount = spawnedCount,
			Limit = definition.InitialSpawnCount,
		})
		return
	end

	DebugLog.Info("Shrine", "Generation shrine repartie demandee", {
		TypeId = definition.TypeId,
		Requested = neededCount,
		MaxRadius = definition.SpawnMaxRadius,
		MinDistance = definition.SpawnMinDistance,
	})

	local surfacePositions = findSurfacePositionsForDefinition(definition, neededCount)
	local batchSize = math.max(1, math.floor(tonumber(generationOptions and generationOptions.BatchSize) or #surfacePositions))

	for index, surfacePosition in ipairs(surfacePositions) do
		if (spawnedCountsByType[definition.TypeId] or 0) >= definition.InitialSpawnCount then
			break
		end

		spawnShrineAtSurface(definition, surfacePosition)

		if generationOptions ~= nil and index % batchSize == 0 and index < #surfacePositions then
			if generationOptions.OnBatch ~= nil then
				generationOptions.OnBatch(
					spawnedCountsByType[definition.TypeId] or 0,
					definition.InitialSpawnCount,
					definition.TypeId
				)
			end
			task.wait()
		end
	end

	if generationOptions ~= nil and generationOptions.OnBatch ~= nil then
		generationOptions.OnBatch(
			spawnedCountsByType[definition.TypeId] or 0,
			definition.InitialSpawnCount,
			definition.TypeId
		)
	end

	DebugLog.Info("Shrine", "Generation shrine initiale terminee", {
		TypeId = definition.TypeId,
		Requested = definition.InitialSpawnCount,
		SpawnedCount = spawnedCountsByType[definition.TypeId] or 0,
	})
end

local function loadTemplates()
	for _, definition in ipairs(SHRINE_DEFINITIONS) do
		shrineTemplatesByType[definition.TypeId] = TemplateService.GetTemplate(
			ShrineConfig.TemplateFolderName,
			definition.TemplateName,
			function(templateStorage)
				return createFallbackShrineTemplate(templateStorage, definition)
			end
		)

		if definition.TypeId == "Perk" then
			ensureBubbleIsInsideTemplate(shrineTemplatesByType[definition.TypeId])
		end
	end
end

local function spawnInitialShrines(generationOptions)
	for _, definition in ipairs(SHRINE_DEFINITIONS) do
		spawnInitialShrinesForDefinition(definition, generationOptions)
	end
end

function ShrineService.ClearRunContent()
	if runtimeFolder ~= nil then
		for _, child in ipairs(runtimeFolder:GetChildren()) do
			child:Destroy()
		end
	end

	shrinesByInstance = {}
	spawnedCountsByType = {}
end

function ShrineService.GenerateForRun(_, generationOptions)
	ShrineService.ClearRunContent()
	spawnInitialShrines(generationOptions)

	local total = 0
	for _, count in pairs(spawnedCountsByType) do
		total += count
	end

	return total
end

function ShrineService.SetupPlayer(player)
	DebugLog.Info("Shrine", "Setup joueur shrine", {
		Player = player.Name,
	})
end

function ShrineService.RemovePlayer(player)
	DebugLog.Info("Shrine", "Remove joueur shrine", {
		Player = player.Name,
	})
end

function ShrineService.Start()
	if isStarted then
		DebugLog.Info("Shrine", "Start ignore, service deja demarre")
		return
	end

	isStarted = true
	runtimeFolder = TemplateService.GetShrinesRuntimeFolder()
	loadTemplates()

	DebugLog.Info("Shrine", "ShrineService demarre", {
		RuntimeFolder = runtimeFolder,
		PerkTemplate = shrineTemplatesByType.Perk,
		EliteTemplate = shrineTemplatesByType.EliteChallenge,
		MagnetTemplate = shrineTemplatesByType.Magnet,
	})

	if chargeHeartbeatConnection == nil then
		chargeHeartbeatConnection = RunService.Heartbeat:Connect(updateBubblePresenceShrines)
	end

end

return ShrineService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="100">
        <Properties>
          <string name="Name">TemplateService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChapterConfig = require(Shared:WaitForChild("ChapterConfig"))
local ChestConfig = require(Shared:WaitForChild("ChestConfig"))
local BossConfig = require(Shared:WaitForChild("BossConfig"))
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local JarConfig = require(Shared:WaitForChild("JarConfig"))
local LobbyConfig = require(Shared:WaitForChild("LobbyConfig"))
local PortalConfig = require(Shared:WaitForChild("PortalConfig"))
local ShrineConfig = require(Shared:WaitForChild("ShrineConfig"))
local TotemConfig = require(Shared:WaitForChild("TotemConfig"))

local TemplateService = {}

local SERVER_TEMPLATE_FOLDERS = {
	CombatConfig.TemplateFolderName,
	"CollectibleTemplates",
	ShrineConfig.TemplateFolderName,
	PortalConfig.TemplateFolderName,
	JarConfig.TemplateFolderName,
	LobbyConfig.TemplateFolderName,
	ChapterConfig.TemplateFolderName,
	ChestConfig.TemplateFolderName,
	TotemConfig.TemplateFolderName,
}

local function getOrCreateFolder(parent, folderName)
	local folder = parent:FindFirstChild(folderName)

	if folder == nil then
		folder = Instance.new("Folder")
		folder.Name = folderName
		folder.Parent = parent
		DebugLog.Info("Templates", "Dossier cree", {
			Parent = parent,
			Folder = folderName,
		})
	end

	assert(folder:IsA("Folder"), folderName .. " doit etre un Folder.")

	return folder
end

local function isInsideFolderName(instance, folderName)
	local current = instance.Parent

	while current ~= nil do
		if current.Name == folderName then
			return true
		end

		current = current.Parent
	end

	return false
end

local function isWorkspaceRuntimeInstance(instance)
	if not instance:IsDescendantOf(Workspace) then
		return false
	end

	return isInsideFolderName(instance, CombatConfig.RuntimeFolderName)
		or isInsideFolderName(instance, ShrineConfig.RuntimeFolderName)
		or isInsideFolderName(instance, PortalConfig.RuntimeFolderName)
		or isInsideFolderName(instance, ChestConfig.RuntimeFolderName)
		or isInsideFolderName(instance, JarConfig.RuntimeFolderName)
		or isInsideFolderName(instance, TotemConfig.RuntimeFolderName)
		or isInsideFolderName(instance, "MapRuntime")
end

local function warnTemplateMoved(templateName, folderName, sourceName)
	DebugLog.Warn("Templates", "Template range dans ServerStorage", {
		Template = templateName,
		Source = sourceName,
		TargetFolder = "ServerStorage/" .. folderName,
	})
end

local function warnTemplateCloned(templateName, folderName, sourceName)
	DebugLog.Warn("Templates", "Template copie vers ServerStorage", {
		Template = templateName,
		Source = sourceName,
		TargetFolder = "ServerStorage/" .. folderName,
	})
end

function TemplateService.GetServerTemplateFolder(folderName)
	return getOrCreateFolder(ServerStorage, folderName)
end

function TemplateService.GetWorkspaceRuntimeFolder(folderName)
	return getOrCreateFolder(Workspace, folderName)
end

function TemplateService.GetCombatRuntimeFolder()
	return TemplateService.GetWorkspaceRuntimeFolder(CombatConfig.RuntimeFolderName)
end

function TemplateService.GetCombatMonsterFolder()
	return getOrCreateFolder(TemplateService.GetCombatRuntimeFolder(), CombatConfig.MonsterFolderName)
end

function TemplateService.GetCombatProjectileFolder()
	return getOrCreateFolder(TemplateService.GetCombatRuntimeFolder(), CombatConfig.ProjectileFolderName)
end

function TemplateService.GetCombatLootFolder()
	return getOrCreateFolder(TemplateService.GetCombatRuntimeFolder(), CombatConfig.LootFolderName)
end

function TemplateService.GetShrinesRuntimeFolder()
	return TemplateService.GetWorkspaceRuntimeFolder(ShrineConfig.RuntimeFolderName)
end

function TemplateService.GetPortalsRuntimeFolder()
	return TemplateService.GetWorkspaceRuntimeFolder(PortalConfig.RuntimeFolderName)
end

function TemplateService.GetChestsRuntimeFolder()
	return TemplateService.GetWorkspaceRuntimeFolder(ChestConfig.RuntimeFolderName)
end

function TemplateService.GetJarsRuntimeFolder()
	return TemplateService.GetWorkspaceRuntimeFolder(JarConfig.RuntimeFolderName)
end

function TemplateService.GetTotemsRuntimeFolder()
	return TemplateService.GetWorkspaceRuntimeFolder(TotemConfig.RuntimeFolderName)
end

function TemplateService.GetMapRuntimeFolder()
	return TemplateService.GetWorkspaceRuntimeFolder("MapRuntime")
end

function TemplateService.GetTemplate(folderName, templateName, fallbackFactory)
	local templateStorage = TemplateService.GetServerTemplateFolder(folderName)
	local storedTemplate = templateStorage:FindFirstChild(templateName)

	if storedTemplate ~= nil then
		DebugLog.Info("Templates", "Template trouve dans dossier cible", {
			Folder = "ServerStorage/" .. folderName,
			Template = templateName,
		})
		return storedTemplate
	end

	for _, root in ipairs({ ServerStorage, ReplicatedStorage, Workspace }) do
		local candidate = root:FindFirstChild(templateName, true)

		if candidate ~= nil and not candidate:IsDescendantOf(templateStorage) and not isWorkspaceRuntimeInstance(candidate) then
			if candidate:IsDescendantOf(ServerStorage) then
				warnTemplateMoved(templateName, folderName, "ServerStorage hors dossier cible")
				candidate.Parent = templateStorage
				return candidate
			end

			if candidate:IsDescendantOf(Workspace) then
				warnTemplateMoved(templateName, folderName, "Workspace")
				candidate.Parent = templateStorage
				return candidate
			end

			warnTemplateCloned(templateName, folderName, "ReplicatedStorage")

			local clone = candidate:Clone()
			clone.Parent = templateStorage
			return clone
		end
	end

	if fallbackFactory ~= nil then
		DebugLog.Warn("Templates", "Template introuvable, fallback demande", {
			Folder = "ServerStorage/" .. folderName,
			Template = templateName,
		})
		return fallbackFactory(templateStorage)
	end

	DebugLog.Warn("Templates", "Template introuvable sans fallback", {
		Folder = "ServerStorage/" .. folderName,
		Template = templateName,
	})

	return nil
end

local function migrateOptionalTemplate(folderName, templateName)
	local templateStorage = TemplateService.GetServerTemplateFolder(folderName)

	if templateStorage:FindFirstChild(templateName) ~= nil then
		return
	end

	for _, root in ipairs({ ServerStorage, ReplicatedStorage, Workspace }) do
		local candidate = root:FindFirstChild(templateName, true)

		if candidate ~= nil and not candidate:IsDescendantOf(templateStorage) and not isWorkspaceRuntimeInstance(candidate) then
			if candidate:IsDescendantOf(Workspace) or candidate:IsDescendantOf(ServerStorage) then
				warnTemplateMoved(templateName, folderName, candidate:IsDescendantOf(Workspace) and "Workspace" or "ServerStorage hors dossier cible")
				candidate.Parent = templateStorage
				return
			end

			warnTemplateCloned(templateName, folderName, "ReplicatedStorage")

			local clone = candidate:Clone()
			clone.Parent = templateStorage
			return
		end
	end
end

function TemplateService.Start()
	DebugLog.Info("Templates", "Initialisation arborescence templates/runtime")

	for _, folderName in ipairs(SERVER_TEMPLATE_FOLDERS) do
		TemplateService.GetServerTemplateFolder(folderName)
	end

	TemplateService.GetCombatMonsterFolder()
	TemplateService.GetCombatProjectileFolder()
	TemplateService.GetCombatLootFolder()
	TemplateService.GetPortalsRuntimeFolder()
	TemplateService.GetShrinesRuntimeFolder()
	TemplateService.GetChestsRuntimeFolder()
	TemplateService.GetJarsRuntimeFolder()
	TemplateService.GetTotemsRuntimeFolder()
	TemplateService.GetMapRuntimeFolder()

	migrateOptionalTemplate(CombatConfig.TemplateFolderName, CombatConfig.MonsterTemplateName)
	migrateOptionalTemplate(CombatConfig.TemplateFolderName, CombatConfig.EliteMonsterTemplateName)
	migrateOptionalTemplate(CombatConfig.TemplateFolderName, BossConfig.BossTemplateName)
	migrateOptionalTemplate(CombatConfig.TemplateFolderName, "Monster3")
	migrateOptionalTemplate(CombatConfig.TemplateFolderName, CombatConfig.FireballTemplateName)

	for _, tierName in ipairs(GameConfig.CoinTierNames or { "Coin" }) do
		migrateOptionalTemplate("CollectibleTemplates", tierName)
	end

	for _, tierName in ipairs(CombatConfig.XpGemTierNames) do
		migrateOptionalTemplate("CollectibleTemplates", tierName)
	end

	migrateOptionalTemplate(ShrineConfig.TemplateFolderName, ShrineConfig.PerkShrineTemplateName)
	migrateOptionalTemplate(ShrineConfig.TemplateFolderName, ShrineConfig.EliteChallengeShrineTemplateName)
	migrateOptionalTemplate(ShrineConfig.TemplateFolderName, ShrineConfig.MagnetShrineTemplateName)
	migrateOptionalTemplate(PortalConfig.TemplateFolderName, PortalConfig.PortalTemplateName)
	migrateOptionalTemplate(ChestConfig.TemplateFolderName, ChestConfig.ChestName)
	migrateOptionalTemplate(ChestConfig.TemplateFolderName, ChestConfig.OpenChestName)
	migrateOptionalTemplate(JarConfig.TemplateFolderName, JarConfig.JarName)
	migrateOptionalTemplate(TotemConfig.TemplateFolderName, TotemConfig.DifficultTotemName)

	for _, chapter in pairs(ChapterConfig.Chapters) do
		migrateOptionalTemplate(ChapterConfig.TemplateFolderName, chapter.MapTemplateName)
	end

	DebugLog.Info("Templates", "Arborescence templates/runtime prete", {
		CombatRuntime = TemplateService.GetCombatRuntimeFolder(),
		ChestsRuntime = TemplateService.GetChestsRuntimeFolder(),
		PortalsRuntime = TemplateService.GetPortalsRuntimeFolder(),
		ShrinesRuntime = TemplateService.GetShrinesRuntimeFolder(),
		JarsRuntime = TemplateService.GetJarsRuntimeFolder(),
		TotemsRuntime = TemplateService.GetTotemsRuntimeFolder(),
		MapRuntime = TemplateService.GetMapRuntimeFolder(),
	})
end

return TemplateService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="101">
        <Properties>
          <string name="Name">TotemService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local TotemConfig = require(Shared:WaitForChild("TotemConfig"))

local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local HudMessageService = require(script.Parent:WaitForChild("HudMessageService"))
local MonsterService = require(script.Parent:WaitForChild("MonsterService"))
local RunAnalyticsService = require(script.Parent:WaitForChild("RunAnalyticsService"))
local TemplateService = require(script.Parent:WaitForChild("TemplateService"))
local WorldSpawnService = require(script.Parent:WaitForChild("WorldSpawnService"))

local TotemService = {}

local rng = Random.new()
local runtimeFolder = nil
local totemTemplate = nil
local isStarted = false
local spawnedTotemCount = 0
local trackedTotems = {}

local function createFallbackTotemTemplate(templateStorage)
	local model = Instance.new("Model")
	model.Name = TotemConfig.DifficultTotemName

	local base = Instance.new("Part")
	base.Name = "Base"
	base.Size = Vector3.new(3.5, 0.8, 3.5)
	base.Color = Color3.fromRGB(68, 42, 34)
	base.Material = Enum.Material.Slate
	base.Anchored = true
	base.Parent = model

	local pillar = Instance.new("Part")
	pillar.Name = "Pillar"
	pillar.Size = Vector3.new(1.8, 4.8, 1.8)
	pillar.Position = Vector3.new(0, 2.8, 0)
	pillar.Color = Color3.fromRGB(126, 65, 52)
	pillar.Material = Enum.Material.Rock
	pillar.Anchored = true
	pillar.Parent = model

	local glow = Instance.new("Part")
	glow.Name = "DifficultyGlow"
	glow.Shape = Enum.PartType.Ball
	glow.Size = Vector3.new(1.2, 1.2, 1.2)
	glow.Position = Vector3.new(0, 5.6, 0)
	glow.Color = Color3.fromRGB(255, 86, 54)
	glow.Material = Enum.Material.Neon
	glow.Anchored = true
	glow.CanCollide = false
	glow.Parent = model

	model.PrimaryPart = base
	model.Parent = templateStorage

	DebugLog.Warn("Totem", "Template DifficultTotem introuvable, fallback cree")

	return model
end

local function getTotemContainer(instance)
	local current = instance

	while current ~= nil and current ~= Workspace do
		if current.Name == TotemConfig.DifficultTotemName then
			return current
		end

		current = current.Parent
	end

	return nil
end

local function findTotemRoot(totem)
	if totem:IsA("BasePart") then
		return totem
	end

	if totem:IsA("Model") and totem.PrimaryPart ~= nil then
		return totem.PrimaryPart
	end

	local root = totem:FindFirstChildWhichIsA("BasePart", true)

	if root ~= nil and totem:IsA("Model") then
		totem.PrimaryPart = root
	end

	return root
end

local function resolveTotem(instance)
	if typeof(instance) ~= "Instance" then
		return nil
	end

	local totem = getTotemContainer(instance)

	if totem == nil or findTotemRoot(totem) == nil then
		return nil
	end

	return totem
end

local function setTotemVisualActive(totem, isActive)
	for _, descendant in ipairs(totem:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Material == Enum.Material.Neon then
			descendant.Transparency = isActive and 0 or 0.6
		end
	end
end

local function activateTotem(player, totem, prompt)
	local totemState = trackedTotems[totem]

	if CombatStateService.IsPaused() then
		return
	end

	if totemState == nil or totemState.Activated or totem:GetAttribute("TotemActivated") == true then
		return
	end

	totemState.Activated = true
	totem:SetAttribute("TotemActivated", true)
	setTotemVisualActive(totem, false)

	if prompt ~= nil then
		prompt.Enabled = false
	end

	local totalDifficulty = MonsterService.AddDifficultyPercent(
		TotemConfig.DifficultyIncreasePercent,
		player,
		TotemConfig.DifficultTotemName
	)
	local addedPercent = math.floor((TotemConfig.DifficultyIncreasePercent * 100) + 0.5)

	HudMessageService.Show(player, "DifficultyTotem", {
		Message = ("LA DIFFICULTE AUGMENTE DE %d%%"):format(addedPercent),
	})
	RunAnalyticsService.RecordDifficultyTotemActivated(player)
	RunAnalyticsService.RecordDifficultyPercent(player, totalDifficulty * 100)

	DebugLog.Info("Totem", "DifficultTotem active", {
		Player = player.Name,
		Totem = totem,
		AddedPercent = addedPercent,
		TotalPercent = math.floor((totalDifficulty * 100) + 0.5),
	})
end

local function setupPrompt(totem)
	local root = findTotemRoot(totem)

	if root == nil then
		return nil
	end

	local prompt = root:FindFirstChild(TotemConfig.PromptName)

	if prompt == nil then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = TotemConfig.PromptName
		prompt.Parent = root
	end

	assert(prompt:IsA("ProximityPrompt"), TotemConfig.PromptName .. " doit etre un ProximityPrompt.")

	prompt.ActionText = TotemConfig.PromptText
	prompt.ObjectText = TotemConfig.PromptObjectText
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = TotemConfig.ActivationDistance
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Custom
	prompt.Enabled = totem:GetAttribute("TotemActivated") ~= true

	prompt.Triggered:Connect(function(player)
		activateTotem(player, totem, prompt)
	end)

	return prompt
end

local function trackTotem(instance)
	local totem = resolveTotem(instance)

	if totem == nil or trackedTotems[totem] ~= nil then
		return
	end

	local prompt = setupPrompt(totem)

	if prompt == nil then
		DebugLog.Warn("Totem", "DifficultTotem sans BasePart, interaction impossible", {
			Totem = totem,
		})
		return
	end

	if totem:GetAttribute("TotemActivated") == nil then
		totem:SetAttribute("TotemActivated", false)
	end

	setTotemVisualActive(totem, totem:GetAttribute("TotemActivated") ~= true)

	trackedTotems[totem] = {
		Activated = totem:GetAttribute("TotemActivated") == true,
		Prompt = prompt,
	}

	DebugLog.Info("Totem", "DifficultTotem tracke", {
		Totem = totem,
	})
end

local function scanExistingTotems()
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		trackTotem(descendant)
	end
end

local function pivotInstance(instance, cframe)
	if instance:IsA("Model") or instance:IsA("BasePart") then
		instance:PivotTo(cframe)
	end
end

local function prepareTotemInstance(totem)
	for _, descendant in ipairs(totem:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end

	if totem:IsA("BasePart") then
		totem.Anchored = true
		totem.CanTouch = false
		totem.CanQuery = false
	end

	if totem:GetAttribute("TotemActivated") == nil then
		totem:SetAttribute("TotemActivated", false)
	end
end

local function getOccupiedSurfacePositions()
	local occupiedPositions = WorldSpawnService.GetPositionsFromFolder(runtimeFolder)

	for _, folder in ipairs({
		TemplateService.GetShrinesRuntimeFolder(),
		TemplateService.GetChestsRuntimeFolder(),
		TemplateService.GetJarsRuntimeFolder(),
		TemplateService.GetPortalsRuntimeFolder(),
	}) do
		for _, position in ipairs(WorldSpawnService.GetPositionsFromFolder(folder)) do
			table.insert(occupiedPositions, position)
		end
	end

	for totem in pairs(trackedTotems) do
		local position = WorldSpawnService.GetInstancePosition(totem)

		if position ~= nil then
			table.insert(occupiedPositions, position)
		end
	end

	return occupiedPositions
end

local function spawnTotemAtSurface(surfacePosition)
	if totemTemplate == nil then
		return nil
	end

	local totem = totemTemplate:Clone()
	totem.Name = TotemConfig.DifficultTotemName
	totem.Parent = runtimeFolder
	prepareTotemInstance(totem)

	local root = findTotemRoot(totem)

	if root == nil then
		DebugLog.Warn("Totem", "DifficultTotem sans BasePart, generation annulee", {
			Totem = totem,
		})
		totem:Destroy()
		return nil
	end

	local pivotPosition = WorldSpawnService.GetSurfacePivotPosition(
		totem,
		surfacePosition,
		TotemConfig.SpawnSurfaceOffset
	)

	pivotInstance(totem, WorldSpawnService.GetPivotCFrameAtPosition(totem, pivotPosition, rng:NextNumber(0, math.pi * 2)))
	trackTotem(totem)
	spawnedTotemCount += 1

	DebugLog.Info("Totem", "DifficultTotem genere", {
		Totem = totem,
		SurfacePosition = surfacePosition,
		PivotPosition = pivotPosition,
		SpawnedCount = spawnedTotemCount,
	})

	return totem
end

local function spawnInitialTotems(generationOptions)
	if totemTemplate == nil then
		DebugLog.Warn("Totem", "Generation DifficultTotem impossible, template absent")
		return
	end

	local neededCount = math.max(0, TotemConfig.InitialSpawnCount - spawnedTotemCount)

	if neededCount <= 0 then
		DebugLog.Info("Totem", "Generation DifficultTotem ignoree, limite deja atteinte", {
			SpawnedCount = spawnedTotemCount,
			Limit = TotemConfig.InitialSpawnCount,
		})
		return
	end

	DebugLog.Info("Totem", "Generation DifficultTotem repartie demandee", {
		Requested = neededCount,
		MaxRadius = TotemConfig.SpawnWorldMaxRadius,
		MinDistance = TotemConfig.SpawnWorldMinObjectDistance,
	})

	local surfacePositions = WorldSpawnService.FindDistributedSurfacePositions({
		Count = neededCount,
		Center = TotemConfig.SpawnWorldCenter,
		MinRadius = TotemConfig.SpawnWorldMinRadius,
		MaxRadius = TotemConfig.SpawnWorldMaxRadius,
		MinDistance = TotemConfig.SpawnWorldMinObjectDistance,
		AttemptsPerPoint = TotemConfig.SpawnWorldAttemptsPerTotem,
		JitterRadius = TotemConfig.SpawnWorldJitterRadius,
		UsePlayableBounds = true,
		EdgeInset = TotemConfig.SpawnWorldEdgeInset,
		RaycastHeight = TotemConfig.SpawnRaycastHeight,
		RaycastDepth = TotemConfig.SpawnRaycastDepth,
		RejectedSurfaceNameContains = TotemConfig.RejectedSurfaceNameContains,
		OccupiedPositions = getOccupiedSurfacePositions(),
		LogCategory = "Totem",
		LogLabel = "DifficultTotem",
	})
	local batchSize = math.max(1, math.floor(tonumber(generationOptions and generationOptions.BatchSize) or #surfacePositions))

	for index, surfacePosition in ipairs(surfacePositions) do
		if spawnedTotemCount >= TotemConfig.InitialSpawnCount then
			break
		end

		spawnTotemAtSurface(surfacePosition)

		if generationOptions ~= nil and index % batchSize == 0 and index < #surfacePositions then
			if generationOptions.OnBatch ~= nil then
				generationOptions.OnBatch(spawnedTotemCount, TotemConfig.InitialSpawnCount)
			end
			task.wait()
		end
	end

	if generationOptions ~= nil and generationOptions.OnBatch ~= nil then
		generationOptions.OnBatch(spawnedTotemCount, TotemConfig.InitialSpawnCount)
	end

	DebugLog.Info("Totem", "Generation DifficultTotem initiale terminee", {
		Requested = TotemConfig.InitialSpawnCount,
		SpawnedCount = spawnedTotemCount,
	})
end

function TotemService.ClearRunContent()
	if runtimeFolder ~= nil then
		for _, child in ipairs(runtimeFolder:GetChildren()) do
			child:Destroy()
		end
	end

	trackedTotems = {}
	spawnedTotemCount = 0
end

function TotemService.GenerateForRun(session, generationOptions)
	rng = Random.new((math.floor(tonumber(session and session.Seed) or 0) + 301) % 2147483647)
	TotemService.ClearRunContent()
	spawnInitialTotems(generationOptions)
	return spawnedTotemCount
end

function TotemService.Start()
	if isStarted then
		DebugLog.Info("Totem", "Start ignore, service deja demarre")
		return
	end

	isStarted = true
	runtimeFolder = TemplateService.GetTotemsRuntimeFolder()
	totemTemplate = TemplateService.GetTemplate(
		TotemConfig.TemplateFolderName,
		TotemConfig.DifficultTotemName,
		createFallbackTotemTemplate
	)

	scanExistingTotems()

	DebugLog.Info("Totem", "TotemService demarre", {
		RuntimeFolder = runtimeFolder,
		Template = totemTemplate,
		SpawnedTotemCount = spawnedTotemCount,
		DifficultyIncreasePercent = math.floor((TotemConfig.DifficultyIncreasePercent * 100) + 0.5),
	})

	Workspace.DescendantAdded:Connect(function(descendant)
		task.defer(function()
			trackTotem(descendant)
		end)
	end)

	Workspace.DescendantRemoving:Connect(function(descendant)
		local totemState = trackedTotems[descendant]

		if totemState ~= nil and totemState.Prompt ~= nil then
			totemState.Prompt:Destroy()
		end

		trackedTotems[descendant] = nil
	end)
end

return TotemService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="102">
        <Properties>
          <string name="Name">WeaponHitService</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local GameplayFeedbackService = require(script.Parent:WaitForChild("GameplayFeedbackService"))
local MonsterService = require(script.Parent:WaitForChild("MonsterService"))
local PerkService = require(script.Parent:WaitForChild("PerkService"))
local RunAnalyticsService = require(script.Parent:WaitForChild("RunAnalyticsService"))
local RunItemService = require(script.Parent:WaitForChild("RunItemService"))

local WeaponHitService = {}

function WeaponHitService.Apply(player: Player, monster: Instance, weaponId: string, baseDamage: number, flashColor: Color3?)
	if player == nil or monster == nil or not MonsterService.IsMonsterAlive(monster) then
		return false, 0, false
	end

	local targetPath = monster:GetFullName()
	local damage, isCritical = PerkService.CalculateOutgoingDamage(player, baseDamage, monster)
	local didDamage, damageDealt = MonsterService.DamageMonster(monster, damage, player, {
		FlashColor = flashColor,
	})
	local dealt = math.max(0, tonumber(damageDealt) or 0)

	if not didDamage then
		return false, 0, isCritical
	end

	if isCritical then
		GameplayFeedbackService.Queue(player, "Critical", dealt)
	end

	PerkService.ApplyLifeSteal(player, dealt, "Hit")
	RunAnalyticsService.RecordDamageDealt(player, dealt, weaponId)
	RunItemService.TryApplyOnWeaponHit(player, monster, weaponId)
	DebugLog.ThrottledInfo("Weapon", "weapon_hit_" .. weaponId, 0.5, "Arme touche un monstre", {
		Player = player.Name,
		WeaponId = weaponId,
		Damage = damage,
		DamageDealt = dealt,
		Target = targetPath,
	})

	return true, dealt, isCritical
end

return WeaponHitService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="103">
        <Properties>
          <string name="Name">WeaponLoadoutService</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local WeaponConfig = require(Shared:WaitForChild("WeaponConfig"))
local WeaponDefinitionValidator = require(Shared:WaitForChild("WeaponDefinitionValidator"))

local WeaponLoadoutService = {}

local profilesByUserId = {}
local validDefinitions, validationErrors = WeaponDefinitionValidator.ValidateAll()
local updateRemote = ReplicatedStorage:FindFirstChild("Weapon_LoadoutUpdate")

if updateRemote == nil then
	updateRemote = Instance.new("RemoteEvent")
	updateRemote.Name = "Weapon_LoadoutUpdate"
	updateRemote.Parent = ReplicatedStorage
end

assert(updateRemote:IsA("RemoteEvent"), "Weapon_LoadoutUpdate doit etre un RemoteEvent")

local function getProfile(player: Player)
	local profile = profilesByUserId[player.UserId]
	if profile == nil then
		profile = {
			Weapons = { fireball = 1 },
			Order = { "fireball" },
		}
		profilesByUserId[player.UserId] = profile
	end
	return profile
end

local function buildSnapshot(player: Player)
	local profile = getProfile(player)
	local weapons = {}

	for _, weaponId in ipairs(profile.Order) do
		local definition = validDefinitions[weaponId]
		if definition ~= nil then
			table.insert(weapons, {
				Id = weaponId,
				Name = definition.Name,
				Category = definition.Category,
				Icon = definition.Icon,
				Level = profile.Weapons[weaponId],
				Lifecycle = definition.Lifecycle,
			})
		end
	end

	return { Weapons = weapons, MaxWeapons = 4 }
end

local function sendSnapshot(player: Player)
	updateRemote:FireClient(player, buildSnapshot(player))
end

function WeaponLoadoutService.SetupPlayer(player: Player)
	getProfile(player)
	sendSnapshot(player)
end

function WeaponLoadoutService.RemovePlayer(player: Player)
	profilesByUserId[player.UserId] = nil
end

function WeaponLoadoutService.HasWeapon(player: Player, weaponId: string)
	local profile = profilesByUserId[player.UserId]
	return profile ~= nil and profile.Weapons[weaponId] ~= nil
end

function WeaponLoadoutService.SetDevelopmentWeapon(player: Player, weaponId: string, enabled: boolean)
	local definition = validDefinitions[weaponId]
	if definition == nil or definition.Lifecycle ~= "Development" then
		return false, "Arme de developpement invalide"
	end

	local profile = getProfile(player)
	local isEquipped = profile.Weapons[weaponId] ~= nil
	if enabled and not isEquipped then
		if #profile.Order >= 4 then
			return false, "Les quatre emplacements d'arme sont occupes"
		end
		profile.Weapons[weaponId] = 1
		table.insert(profile.Order, weaponId)
	elseif not enabled and isEquipped then
		profile.Weapons[weaponId] = nil
		local index = table.find(profile.Order, weaponId)
		if index then
			table.remove(profile.Order, index)
		end
	end

	sendSnapshot(player)
	return true, if enabled then "Aiguille de Leyde equipee" else "Aiguille de Leyde retiree"
end

function WeaponLoadoutService.Start()
	for _, message in ipairs(validationErrors) do
		DebugLog.Warn("Weapon", "Definition d'arme exclue", { Error = message })
	end

	DebugLog.Info("Weapon", "Catalogue d'armes valide", {
		Definitions = (function()
			local count = 0
			for _ in pairs(validDefinitions) do count += 1 end
			return count
		end)(),
	})
end

return WeaponLoadoutService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="104">
        <Properties>
          <string name="Name">WeaponService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local AudioService = require(script.Parent:WaitForChild("AudioService"))
local MonsterService = require(script.Parent:WaitForChild("MonsterService"))
local PerkService = require(script.Parent:WaitForChild("PerkService"))
local RunStateService = require(script.Parent:WaitForChild("RunStateService"))
local TemplateService = require(script.Parent:WaitForChild("TemplateService"))
local ProjectileVisualService = require(script.Parent:WaitForChild("ProjectileVisualService"))
local WeaponSkinService = require(script.Parent:WaitForChild("WeaponSkinService"))
local WeaponHitService = require(script.Parent:WaitForChild("WeaponHitService"))
local PerformanceTelemetryService = require(script.Parent:WaitForChild("PerformanceTelemetryService"))

local WeaponService = {}

local runtimeFolder = nil
local projectileFolder = nil
local projectilePoolFolder = nil
local projectileSimulationFolder = nil
local fireballTemplate = nil
local heartbeatConnection = nil
local projectileAccumulator = 0
local projectileTickTimeTotal = 0
local projectileTickSampleCount = 0
local cooldownsByUserId = {}
local projectilesByInstance = {}
local pendingFireballVolleysByUserId = {}
local projectileSerial = 0
-- Les profils donnent des tirs lisibles mais jamais parfaitement rectilignes.
local FIREBALL_FLIGHT_PATTERNS = {
	{ SideMultiplier = 1, VerticalMultiplier = 0.62, FrequencyMultiplier = 0.9 },
	{ SideMultiplier = -0.86, VerticalMultiplier = 1, FrequencyMultiplier = 1.12 },
	{ SideMultiplier = 0.7, VerticalMultiplier = -0.55, FrequencyMultiplier = 1.28 },
	{ SideMultiplier = -1, VerticalMultiplier = 0.38, FrequencyMultiplier = 0.78 },
}

local function getOrCreateFolder(parent, folderName)
	local folder = parent:FindFirstChild(folderName)

	if folder == nil then
		folder = Instance.new("Folder")
		folder.Name = folderName
		folder.Parent = parent
	end

	return folder
end

local function setupFolders()
	runtimeFolder = TemplateService.GetCombatRuntimeFolder()
	projectileFolder = TemplateService.GetCombatProjectileFolder()
	projectilePoolFolder = getOrCreateFolder(ServerStorage, "ProjectilePools")
	projectileSimulationFolder = getOrCreateFolder(ServerStorage, "ProjectileSimulation")
end

local function createFallbackFireballTemplate(templateStorage)
	local part = Instance.new("Part")
	part.Name = CombatConfig.FireballTemplateName
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(1.4, 1.4, 1.4)
	part.Color = Color3.fromRGB(255, 105, 45)
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Parent = templateStorage

	DebugLog.Warn("Weapon", "Template Fireball introuvable, fallback cree", {
		Template = CombatConfig.FireballTemplateName,
	})

	return part
end

local function findTemplate(templateName)
	return TemplateService.GetTemplate(CombatConfig.TemplateFolderName, templateName, createFallbackFireballTemplate)
end

local function findRoot(instance)
	if instance:IsA("BasePart") then
		return instance
	end

	if not instance:IsA("Model") then
		return nil
	end

	if instance.PrimaryPart ~= nil then
		return instance.PrimaryPart
	end

	local firstPart = instance:FindFirstChildWhichIsA("BasePart", true)

	if firstPart ~= nil then
		instance.PrimaryPart = firstPart
	end

	return firstPart
end

local function pivotInstance(instance, cframe)
	if instance:IsA("Model") or instance:IsA("BasePart") then
		instance:PivotTo(cframe)
	end
end

local function prepareProjectile(projectile)
	if projectile:IsA("BasePart") then
		projectile.Anchored = true
		projectile.CanCollide = false
		projectile.CanTouch = false
		projectile.CanQuery = false
	end

	for _, descendant in ipairs(projectile:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end

	return findRoot(projectile)
end

local function getCharacterRoot(player)
	local character = player.Character

	if character == nil then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function getCharacterHumanoid(player)
	local character = player.Character

	if character == nil then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function isPlayerAlive(player)
	if not RunStateService.IsRunActive(player) then
		return false
	end

	local humanoid = getCharacterHumanoid(player)
	local root = getCharacterRoot(player)

	return humanoid ~= nil and root ~= nil and humanoid.Health > 0
end

local function getProjectilePoolSize()
	if projectilePoolFolder == nil then
		return 0
	end

	return #projectilePoolFolder:GetChildren()
end

local function acquireProjectileInstance(activeFolder)
	local projectile = projectilePoolFolder:FindFirstChild(CombatConfig.FireballTemplateName)

	if projectile == nil then
		projectile = projectilePoolFolder:FindFirstChildWhichIsA("Model")
			or projectilePoolFolder:FindFirstChildWhichIsA("BasePart")
	end

	if projectile ~= nil then
		projectile.Parent = activeFolder
		return projectile, true
	end

	projectile = fireballTemplate:Clone()
	projectile.Parent = activeFolder

	return projectile, false
end

local function releaseProjectileInstance(projectile)
	if projectile == nil or projectile.Parent == nil then
		return
	end

	if projectile:GetAttribute("BenchmarkProjectile") == true then
		PerformanceTelemetryService.Increment("Weapon.Projectiles.BenchmarkReleased")
	end

	projectile.Name = CombatConfig.FireballTemplateName
	projectile:SetAttribute("RuntimeProjectile", false)
	projectile:SetAttribute("BenchmarkProjectile", nil)
	projectile:SetAttribute("WeaponId", nil)
	projectile:SetAttribute("VfxProfileId", nil)
	projectile:SetAttribute("ProjectileSkinId", nil)
	projectile:SetAttribute("ProjectileOwnerUserId", nil)
	projectile:SetAttribute("ProjectileVisualSerial", nil)
	projectile.Parent = projectilePoolFolder
end

local function prewarmProjectilePool(count)
	local prewarmCount = math.max(0, math.floor(count or 0))

	if fireballTemplate == nil or prewarmCount <= 0 then
		return
	end

	for _ = 1, prewarmCount do
		local projectile = fireballTemplate:Clone()
		projectile.Name = CombatConfig.FireballTemplateName
		prepareProjectile(projectile)
		projectile.Parent = projectilePoolFolder
	end

	DebugLog.Info("Perf", "Pool projectiles prechauffe", {
		Template = CombatConfig.FireballTemplateName,
		Count = prewarmCount,
	})
end

local function destroyProjectile(projectile)
	local state = projectilesByInstance[projectile]

	if state ~= nil and state.ClientPresentationMode == "ClientPilot" then
		ProjectileVisualService.PlayClientProjectileDestroy(state.Owner, state.VisualSerial)
		PerformanceTelemetryService.Increment("Weapon.Projectiles.ClientPilotDestroys")
	end

	projectilesByInstance[projectile] = nil

	releaseProjectileInstance(projectile)
end

local function resolveProjectilePresentationMode(_player, requestedPresentationMode)
	if requestedPresentationMode == "ClientPilot" or requestedPresentationMode == "ReplicatedCore" then
		return requestedPresentationMode
	end

	return if CombatConfig.ProjectilePresentationMode == "ReplicatedCore" then "ReplicatedCore" else "ClientPilot"
end

local function createProjectile(
	player,
	spawnPosition,
	targetMonster,
	targetRoot,
	direction,
	pattern,
	phase,
	benchmarkTargetPosition,
	presentationMode
)
	local clientPresentationMode = resolveProjectilePresentationMode(player, presentationMode)
	local activeFolder = if clientPresentationMode == "ClientPilot" then projectileSimulationFolder else projectileFolder
	local projectile, reusedFromPool = acquireProjectileInstance(activeFolder)
	PerformanceTelemetryService.Increment("Weapon.Projectiles.Created")
	PerformanceTelemetryService.Increment(
		if reusedFromPool then "Weapon.Projectiles.ReusedFromPool" else "Weapon.Projectiles.Cloned"
	)

	projectile.Name = CombatConfig.FireballTemplateName
	projectile:SetAttribute("RuntimeProjectile", true)
	projectile:SetAttribute("BenchmarkProjectile", benchmarkTargetPosition ~= nil)

	local projectileRoot = prepareProjectile(projectile)

	if projectileRoot == nil then
		DebugLog.Warn("Weapon", "Projectile Fireball sans BasePart, tir annule", {
			Projectile = projectile,
		})
		releaseProjectileInstance(projectile)
		return false
	end

	local vfxProfileId = ProjectileVisualService.PrepareFireball(
		projectile,
		projectileRoot,
		player,
		WeaponSkinService.GetSelectedFireballSkin(player),
		projectileSerial
	)

	if vfxProfileId == nil then
		releaseProjectileInstance(projectile)
		return false
	end

	if clientPresentationMode == "ReplicatedCore" then
		pivotInstance(projectile, CFrame.lookAt(spawnPosition, spawnPosition + direction))
	end

	local projectileState = {
		Instance = projectile,
		Owner = player,
		TargetMonster = targetMonster,
		BenchmarkTargetPosition = benchmarkTargetPosition,
		Position = spawnPosition,
		Direction = direction.Unit,
		Age = 0,
		Speed = PerkService.GetProjectileSpeed(player, CombatConfig.FireballSpeed),
		Lifetime = PerkService.GetAttackDuration(player, CombatConfig.FireballLifetime),
		FlightPattern = pattern,
		FlightPhase = phase,
		HomingDelay = CombatConfig.FireballHomingDelay,
		BounceRemaining = PerkService.GetBounceCount(player),
		HitMonsters = {},
		ReusedFromPool = reusedFromPool,
		VfxProfileId = vfxProfileId,
		VisualSerial = projectileSerial,
		ClientPresentationMode = clientPresentationMode,
	}
	projectilesByInstance[projectile] = projectileState

	if clientPresentationMode == "ClientPilot" then
		local initialTargetPosition = benchmarkTargetPosition

		if initialTargetPosition == nil and targetRoot ~= nil then
			initialTargetPosition = targetRoot.Position
		end

		if initialTargetPosition == nil then
			DebugLog.Warn("Vfx", "Pilote projectile annule sans cible visuelle", {
				Player = player.Name,
				VisualSerial = projectileSerial,
			})
		else
			ProjectileVisualService.PlayClientProjectileSpawn(player, {
				Type = "ProjectileSpawn",
				VisualSerial = projectileSerial,
				ProfileId = vfxProfileId,
				Position = spawnPosition,
				Direction = direction,
				TargetPosition = initialTargetPosition,
				TargetRoot = targetRoot,
				Speed = projectileState.Speed,
				Lifetime = projectileState.Lifetime,
				HomingDelay = projectileState.HomingDelay,
				FlightPattern = pattern,
				FlightPhase = phase,
				CoreSize = projectileRoot.Size,
				ServerStartTime = Workspace:GetServerTimeNow(),
			})
			PerformanceTelemetryService.Increment("Weapon.Projectiles.ClientPilotSpawns")
		end
	end

	DebugLog.ThrottledInfo("Weapon", "fireball_created_" .. player.UserId, 1, "Projectile cree", {
		Player = player.Name,
		Position = spawnPosition,
		ProjectileCount = PerkService.GetProjectileCount(player),
		Target = targetMonster,
	})

	return true
end

local function rotateDirection(direction, radians)
	local rotation = CFrame.fromAxisAngle(Vector3.new(0, 1, 0), radians)

	return rotation:VectorToWorldSpace(direction).Unit
end

local function clampProjectileDirection(direction)
	local minimumVerticalDirection = CombatConfig.FireballMinimumVerticalDirection or -0.05

	if direction.Y >= minimumVerticalDirection then
		return direction.Unit
	end

	return Vector3.new(direction.X, minimumVerticalDirection, direction.Z).Unit
end

local function createInitialProjectileDirection(targetDirection, projectileIndex)
	projectileSerial += 1

	local seed = (projectileSerial * 7919) + (projectileIndex * 104729)
	local random = Random.new(seed)
	local launchAngle = random:NextNumber(
		-(CombatConfig.FireballLaunchAngleRadians or math.rad(90)),
		CombatConfig.FireballLaunchAngleRadians or math.rad(90)
	)
	local upwardKick = random:NextNumber(0.06, 0.24)
	local direction = rotateDirection(targetDirection.Unit, launchAngle) + Vector3.new(0, upwardKick, 0)
	local patternIndex = ((projectileSerial - 1) % #FIREBALL_FLIGHT_PATTERNS) + 1

	return clampProjectileDirection(direction), FIREBALL_FLIGHT_PATTERNS[patternIndex], random:NextNumber(0, math.pi * 2)
end

local function getTargetCandidates(position)
	local targets = MonsterService.GetMonstersNear(position, CombatConfig.FireballRange)

	table.sort(targets, function(first, second)
		return first.DistanceSquared < second.DistanceSquared
	end)

	return targets
end

local function getFireballSpawnPosition(player)
	local root = getCharacterRoot(player)

	if root == nil then
		return nil
	end

	return root.Position
		+ (root.CFrame.LookVector * CombatConfig.FireballSpawnForwardOffset)
		+ Vector3.new(0, CombatConfig.FireballSpawnHeightOffset, 0)
end

local function playFireballCast(player)
	if AudioService.PlayForPlayer(player, "FireballCast") then
		PerformanceTelemetryService.Increment("Weapon.Projectiles.CastAudioEvents")
	end
end

local function emitFireballVolleyShot(player, targetData, projectileIndex)
	if not isPlayerAlive(player) or targetData == nil then
		return false
	end

	local spawnPosition = getFireballSpawnPosition(player)
	local targetPosition = MonsterService.GetMonsterPosition(targetData.Monster)

	if spawnPosition == nil or targetPosition == nil then
		return false
	end

	local direction = targetPosition - spawnPosition

	if direction.Magnitude <= 0.1 then
		return false
	end

	local projectileDirection, pattern, phase = createInitialProjectileDirection(direction.Unit, projectileIndex)
	local didCreate = createProjectile(
		player,
		spawnPosition,
		targetData.Monster,
		targetData.Root,
		projectileDirection,
		pattern,
		phase
	)

	if didCreate then
		playFireballCast(player)
	end

	return didCreate
end

local function getFireballVolleyShotDelay(projectileCount, cooldown)
	if projectileCount <= 1 then
		return 0
	end

	local desiredInterval = math.max(0, CombatConfig.FireballVolleyProjectileInterval or 0)
	local endGuard = math.max(0, CombatConfig.FireballVolleyEndGuard or 0)
	local availableDuration = math.max(0, cooldown - endGuard)
	local maximumInterval = availableDuration / (projectileCount - 1)

	return math.min(desiredInterval, maximumInterval)
end

local function getPendingVolleyCounts()
	local activeVolleys = 0
	local pendingShots = 0

	for _, volley in pairs(pendingFireballVolleysByUserId) do
		activeVolleys += 1
		pendingShots += math.max(0, #volley.Targets - volley.NextShotIndex + 1)
	end

	return activeVolleys, pendingShots
end

local function updatePendingFireballVolleys(now)
	for userId, volley in pairs(pendingFireballVolleysByUserId) do
		if not isPlayerAlive(volley.Player) then
			pendingFireballVolleysByUserId[userId] = nil
			continue
		end

		if now < volley.NextShotAt then
			continue
		end

		local targetData = volley.Targets[volley.NextShotIndex]
		emitFireballVolleyShot(volley.Player, targetData, volley.NextShotIndex)
		volley.NextShotIndex += 1
		volley.NextShotAt += volley.Interval

		-- Une frame retardee ne transforme jamais les tirs dus en nouvelle rafale.
		-- Le reste de la salve reprend un projectile par frame apres le retard.
		if volley.NextShotIndex > #volley.Targets then
			pendingFireballVolleysByUserId[userId] = nil
		end
	end
end

local function fireAtClosestMonster(player, now, cooldown, emitAllImmediately)
	if fireballTemplate == nil or not isPlayerAlive(player) then
		return
	end

	local spawnPosition = getFireballSpawnPosition(player)

	if spawnPosition == nil then
		return
	end

	local targets = getTargetCandidates(spawnPosition)
	local firstTarget = targets[1]
	local targetMonster = if firstTarget ~= nil then firstTarget.Monster else nil
	local targetRoot = if firstTarget ~= nil then firstTarget.Root else nil

	if targetMonster == nil or targetRoot == nil then
		DebugLog.ThrottledInfo("Weapon", "no_target_" .. player.UserId, 3, "Aucune cible Fireball en portee", {
			Player = player.Name,
			Range = CombatConfig.FireballRange,
			Position = spawnPosition,
		})
		return
	end

	local projectileCount = PerkService.GetProjectileCount(player)
	local volleyTargets = {}

	for projectileIndex = 1, projectileCount do
		-- On couvre les cibles proches avant de repasser sur la premiere si les projectiles sont plus nombreux.
		volleyTargets[projectileIndex] = targets[((projectileIndex - 1) % #targets) + 1]
	end

	if not emitFireballVolleyShot(player, volleyTargets[1], 1) then
		return
	end

	if projectileCount > 1 then
		if emitAllImmediately then
			for projectileIndex = 2, projectileCount do
				emitFireballVolleyShot(player, volleyTargets[projectileIndex], projectileIndex)
			end
		else
			local volleyInterval = getFireballVolleyShotDelay(projectileCount, cooldown)
			pendingFireballVolleysByUserId[player.UserId] = {
				Player = player,
				Targets = volleyTargets,
				NextShotIndex = 2,
				NextShotAt = now + volleyInterval,
				Interval = volleyInterval,
			}
		end
	end

end

local function updatePlayerWeapons(now)
	updatePendingFireballVolleys(now)

	for _, player in ipairs(Players:GetPlayers()) do
		if not RunStateService.IsRunActive(player) then
			continue
		end

		if pendingFireballVolleysByUserId[player.UserId] ~= nil then
			continue
		end

		local lastFireAt = cooldownsByUserId[player.UserId] or 0
		local cooldown = PerkService.GetAttackCooldown(player, CombatConfig.FireballCooldown)

		if now - lastFireAt >= cooldown then
			cooldownsByUserId[player.UserId] = now
			fireAtClosestMonster(player, now, cooldown)
		end
	end
end

local function updateProjectile(projectileState, deltaTime)
	local projectile = projectileState.Instance

	if projectile.Parent == nil then
		projectilesByInstance[projectile] = nil
		return
	end

	projectileState.Age += deltaTime

	if projectileState.Age >= projectileState.Lifetime then
		if projectileState.BenchmarkTargetPosition ~= nil then
			PerformanceTelemetryService.Increment("Weapon.Projectiles.BenchmarkExpired")
		end
		destroyProjectile(projectile)
		return
	end

	local targetPosition = projectileState.BenchmarkTargetPosition

	if targetPosition == nil then
		targetPosition = MonsterService.GetMonsterPosition(projectileState.TargetMonster)
	end

	if targetPosition ~= nil then
		local desiredDirection = targetPosition - projectileState.Position

		if desiredDirection.Magnitude > 0.1 then
			local targetDirection = desiredDirection.Unit
			local sideDirection = Vector3.new(-targetDirection.Z, 0, targetDirection.X)

			if sideDirection.Magnitude <= 0.001 then
				sideDirection = Vector3.new(1, 0, 0)
			else
				sideDirection = sideDirection.Unit
			end

			local speedRatio = math.max(0.25, projectileState.Speed / math.max(1, CombatConfig.FireballSpeed))
			local curveDuration = math.max(0.08, (CombatConfig.FireballCurveDuration or 1) / speedRatio)
			local curveProgress = math.clamp((projectileState.Age - projectileState.HomingDelay) / curveDuration, 0, 1)
			local curveWeight = (1 - curveProgress) * (CombatConfig.FireballCurveStrength or 0)
			local pattern = projectileState.FlightPattern or FIREBALL_FLIGHT_PATTERNS[1]
			local oscillation = projectileState.FlightPhase
				+ (projectileState.Age * (CombatConfig.FireballCurveFrequency or 1) * pattern.FrequencyMultiplier)
			local lateralCurve = math.sin(oscillation) * curveWeight * pattern.SideMultiplier
			local verticalCurve = math.cos(oscillation * 0.82) * (CombatConfig.FireballVerticalCurveStrength or 0)
				* curveWeight
				* pattern.VerticalMultiplier
			local curvedDirection = clampProjectileDirection(
				targetDirection + (sideDirection * lateralCurve) + Vector3.new(0, verticalCurve, 0)
			)
			local steeringWeight = 0.2 + (0.8 * curveProgress)
			local homingAlpha = math.clamp(
				deltaTime * (CombatConfig.FireballHomingStrength or 1) * math.sqrt(speedRatio) * steeringWeight,
				0,
				1
			)

			projectileState.Direction = clampProjectileDirection(projectileState.Direction:Lerp(curvedDirection, homingAlpha))
		end
	end

	local nextPosition = projectileState.Position + (projectileState.Direction * projectileState.Speed * deltaTime)
	projectileState.Position = nextPosition

	PerformanceTelemetryService.Increment("Weapon.Projectiles.LogicalUpdates")

	if projectileState.ClientPresentationMode == "ReplicatedCore" then
		pivotInstance(projectile, CFrame.lookAt(nextPosition, nextPosition + projectileState.Direction))
		PerformanceTelemetryService.Increment("Weapon.Projectiles.TransformUpdates")
	end

	local didReachBenchmarkTarget = false
	local hitMonster = nil

	if projectileState.BenchmarkTargetPosition ~= nil then
		didReachBenchmarkTarget = (nextPosition - projectileState.BenchmarkTargetPosition).Magnitude
			<= CombatConfig.FireballHitRadius
	else
		hitMonster = MonsterService.GetClosestMonster(nextPosition, CombatConfig.FireballHitRadius, projectileState.HitMonsters)
	end

	if didReachBenchmarkTarget then
		ProjectileVisualService.PlayProjectileImpact(
			projectileState.Owner,
			projectileState.VfxProfileId,
			nextPosition,
			projectileState.VisualSerial
		)
		PerformanceTelemetryService.Increment("Weapon.Projectiles.BenchmarkImpacts")
		destroyProjectile(projectile)
		return
	end

	if hitMonster ~= nil then
		projectileState.HitMonsters[hitMonster] = true
		local impactPosition = MonsterService.GetMonsterPosition(hitMonster) or nextPosition
		ProjectileVisualService.PlayProjectileImpact(
			projectileState.Owner,
			projectileState.VfxProfileId,
			impactPosition,
			projectileState.VisualSerial
		)
		WeaponHitService.Apply(
			projectileState.Owner,
			hitMonster,
			CombatConfig.FireballTemplateName,
			CombatConfig.FireballDamage
		)

		if projectileState.BounceRemaining > 0 then
			local nextMonster, nextRoot = MonsterService.GetClosestMonster(
				nextPosition,
				CombatConfig.FireballRange,
				projectileState.HitMonsters
			)

			if nextMonster ~= nil and nextRoot ~= nil then
				local nextDirection = nextRoot.Position - nextPosition

				if nextDirection.Magnitude > 0.1 then
					projectileState.BounceRemaining -= 1
					projectileState.TargetMonster = nextMonster
					projectileState.Direction = nextDirection.Unit

					if projectileState.ClientPresentationMode == "ClientPilot" then
						ProjectileVisualService.PlayClientProjectileRetarget(projectileState.Owner, {
							Type = "ProjectileRetarget",
							VisualSerial = projectileState.VisualSerial,
							Position = nextPosition,
							Direction = projectileState.Direction,
							TargetPosition = nextRoot.Position,
							TargetRoot = nextRoot,
							ServerTime = Workspace:GetServerTimeNow(),
						})
						PerformanceTelemetryService.Increment("Weapon.Projectiles.ClientPilotRetargets")
					end

					return
				end
			end
		end

		destroyProjectile(projectile)
	end
end

local function updateProjectiles(deltaTime)
	for _, projectileState in pairs(projectilesByInstance) do
		updateProjectile(projectileState, deltaTime)
	end
end

local function getActiveProjectileCount()
	local count = 0

	for _ in pairs(projectilesByInstance) do
		count += 1
	end

	return count
end

local function updateWeaponStep(deltaTime)
	local startedAt = os.clock()
	local now = CombatStateService.GetTime()

	updatePlayerWeapons(now)
	updateProjectiles(deltaTime)

	local tickDuration = os.clock() - startedAt
	PerformanceTelemetryService.Record("Weapon.TickSeconds", tickDuration)
	projectileTickTimeTotal += tickDuration
	projectileTickSampleCount += 1

	local averageTickMs = 0

	if projectileTickSampleCount > 0 then
		averageTickMs = (projectileTickTimeTotal / projectileTickSampleCount) * 1000
	end

	local activeVolleys, pendingVolleyShots = getPendingVolleyCounts()

	DebugLog.ThrottledInfo("Perf", "projectile_tick", CombatConfig.PerfLogInterval or 5, "Perf projectiles serveur", {
		Active = getActiveProjectileCount(),
		Pool = getProjectilePoolSize(),
		SimulationHz = CombatConfig.ProjectileSimulationHz,
		AverageTickMs = averageTickMs,
		ActiveVolleys = activeVolleys,
		PendingVolleyShots = pendingVolleyShots,
	})
end

function WeaponService.RemovePlayer(player)
	cooldownsByUserId[player.UserId] = nil
	pendingFireballVolleysByUserId[player.UserId] = nil
end

local function clearProjectiles()
	for projectile in pairs(projectilesByInstance) do
		destroyProjectile(projectile)
	end
end

function WeaponService.GetPerformanceSnapshot()
	return {
		Active = getActiveProjectileCount(),
		Pool = getProjectilePoolSize(),
	}
end

function WeaponService.ClearProjectilesForBenchmark()
	clearProjectiles()
end

function WeaponService.DebugFireballBurst(player, requestedCount)
	local burstCount = math.clamp(math.floor(requestedCount or 0), 0, 96)
	local now = CombatStateService.GetTime()
	local cooldown = PerkService.GetAttackCooldown(player, CombatConfig.FireballCooldown)

	for _ = 1, burstCount do
		fireAtClosestMonster(player, now, cooldown, true)
	end

	return burstCount
end

function WeaponService.DebugFireballBurstAtPositions(player, targetPositions, requestedCount, presentationMode)
	if not isPlayerAlive(player) or typeof(targetPositions) ~= "table" then
		return 0
	end

	local burstCount = math.clamp(math.floor(requestedCount or 0), 0, 96)
	local availableTargets = {}

	for _, targetPosition in ipairs(targetPositions) do
		if typeof(targetPosition) == "Vector3" then
			table.insert(availableTargets, targetPosition)
		end
	end

	if burstCount <= 0 or #availableTargets <= 0 then
		return 0
	end

	local emittedCount = 0

	for projectileIndex = 1, burstCount do
		local spawnPosition = getFireballSpawnPosition(player)
		local targetPosition = availableTargets[((projectileIndex - 1) % #availableTargets) + 1]

		if spawnPosition == nil then
			break
		end

		local direction = targetPosition - spawnPosition

		if direction.Magnitude <= 0.1 then
			continue
		end

		local projectileDirection, pattern, phase = createInitialProjectileDirection(direction.Unit, projectileIndex)
		local didCreate = createProjectile(
			player,
			spawnPosition,
			nil,
			nil,
			projectileDirection,
			pattern,
			phase,
			targetPosition,
			presentationMode
		)

		if didCreate then
			playFireballCast(player)
			emittedCount += 1
		end
	end

	PerformanceTelemetryService.Increment("Weapon.Projectiles.BenchmarkShotsRequested", burstCount)
	PerformanceTelemetryService.Increment("Weapon.Projectiles.BenchmarkShotsEmitted", emittedCount)

	return emittedCount
end

function WeaponService.Start()
	setupFolders()
	fireballTemplate = findTemplate(CombatConfig.FireballTemplateName)
	prewarmProjectilePool(CombatConfig.ProjectilePoolPrewarm)

	DebugLog.Info("Weapon", "WeaponService demarre", {
		RuntimeFolder = runtimeFolder,
		ProjectileFolder = projectileFolder,
		Template = fireballTemplate,
		Cooldown = CombatConfig.FireballCooldown,
		Range = CombatConfig.FireballRange,
		SimulationHz = CombatConfig.ProjectileSimulationHz,
	})

	RunStateService.RunStarted:Connect(function(player)
		cooldownsByUserId[player.UserId] = CombatStateService.GetTime()
		pendingFireballVolleysByUserId[player.UserId] = nil
		projectileAccumulator = 0
		projectileTickTimeTotal = 0
		projectileTickSampleCount = 0
	end)

	RunStateService.RunEnded:Connect(function(player)
		cooldownsByUserId[player.UserId] = nil
		pendingFireballVolleysByUserId[player.UserId] = nil
		projectileAccumulator = 0
		clearProjectiles()
	end)

	if heartbeatConnection ~= nil then
		return
	end

	heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
		if CombatStateService.IsPaused() then
			return
		end

		local simulationHz = CombatConfig.ProjectileSimulationHz or 0

		if simulationHz <= 0 then
			updateWeaponStep(deltaTime)
			return
		end

		local fixedStep = 1 / simulationHz
		local maxStepsPerHeartbeat = 4
		local steps = 0

		projectileAccumulator += deltaTime

		while projectileAccumulator >= fixedStep and steps < maxStepsPerHeartbeat do
			projectileAccumulator -= fixedStep
			steps += 1
			updateWeaponStep(fixedStep)
		end

		if steps >= maxStepsPerHeartbeat and projectileAccumulator >= fixedStep then
			projectileAccumulator = fixedStep
		end
	end)
end

return WeaponService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="105">
        <Properties>
          <string name="Name">WeaponSkinService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local WeaponSkinConfig = require(Shared:WaitForChild("WeaponSkinConfig"))

local WeaponSkinService = {}

local isStarted = false

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local selectSkinRemote = getOrCreateRemote("WeaponSkin_Select")

local function getFireballSkin(skinId)
	for _, skin in ipairs(WeaponSkinConfig.Weapons.fireball.Skins) do
		if skin.Id == skinId then
			return skin
		end
	end

	return nil
end

function WeaponSkinService.GetSelectedFireballSkin(player)
	local requestedSkinId = player:GetAttribute("FireballSkinId")

	if typeof(requestedSkinId) == "string" and getFireballSkin(requestedSkinId) ~= nil then
		return requestedSkinId
	end

	return WeaponSkinConfig.Weapons.fireball.DefaultSkinId
end

function WeaponSkinService.SetupPlayer(player)
	player:SetAttribute("FireballSkinId", WeaponSkinService.GetSelectedFireballSkin(player))
end

function WeaponSkinService.RemovePlayer(_player)
	-- L'apparence est pour l'instant une selection de session : aucune donnee persistante a nettoyer.
end

local function canUseSkin(skin)
	-- Les skins achetables devront valider leur ownership serveur ici.
	return skin.UnlockType == "Starter"
end

local function selectFireballSkin(player, skinId)
	if typeof(skinId) ~= "string" then
		return
	end

	local skin = getFireballSkin(skinId)

	if skin == nil or not canUseSkin(skin) then
		DebugLog.Warn("Weapon", "Selection skin Fireball refusee", {
			Player = player.Name,
			SkinId = skinId,
		})
		return
	end

	player:SetAttribute("FireballSkinId", skin.Id)
	DebugLog.Info("Weapon", "Skin Fireball selectionne", {
		Player = player.Name,
		SkinId = skin.Id,
	})
end

function WeaponSkinService.Start()
	if isStarted then
		return
	end

	isStarted = true
	selectSkinRemote.OnServerEvent:Connect(selectFireballSkin)

	for _, player in ipairs(Players:GetPlayers()) do
		WeaponSkinService.SetupPlayer(player)
	end

	DebugLog.Info("Weapon", "WeaponSkinService demarre", {
		DefaultSkinId = WeaponSkinConfig.Weapons.fireball.DefaultSkinId,
	})
end

return WeaponSkinService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="106">
        <Properties>
          <string name="Name">WorldSpawnService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local PerformanceTelemetryService = require(script.Parent:WaitForChild("PerformanceTelemetryService"))

local WorldSpawnService = {}

local rng = Random.new()
local activeSurfaceRoot = nil
local activeSurfaceCenter = nil
local activeSurfaceBounds = nil
local GOLDEN_ANGLE = math.pi * (3 - math.sqrt(5))

local DEFAULT_RUNTIME_FOLDER_NAMES = {
	"CombatRuntime",
	"PortalsRuntime",
	"ShrinesRuntime",
	"ChestsRuntime",
	"JarsRuntime",
	"TotemsRuntime",
}

local function appendIfPresent(list, instance)
	if instance ~= nil then
		table.insert(list, instance)
	end
end

local function getDefaultExcludeInstances(extraExcludeInstances)
	local excludeInstances = {}

	for _, player in ipairs(Players:GetPlayers()) do
		appendIfPresent(excludeInstances, player.Character)
	end

	for _, folderName in ipairs(DEFAULT_RUNTIME_FOLDER_NAMES) do
		appendIfPresent(excludeInstances, Workspace:FindFirstChild(folderName))
	end

	for _, instance in ipairs(extraExcludeInstances or {}) do
		appendIfPresent(excludeInstances, instance)
	end

	return excludeInstances
end

-- Le tag est purement observatoire : il ne modifie jamais le rayon ni ses filtres.
local function recordRaycastTelemetry(options, duration)
	if not PerformanceTelemetryService.IsCapturing() then
		return
	end

	PerformanceTelemetryService.Record("WorldSpawn.RaycastSeconds", duration)
	PerformanceTelemetryService.Increment("WorldSpawn.RaycastCount")

	local telemetryTag = if options ~= nil then options.TelemetryTag else nil

	if typeof(telemetryTag) == "string" and telemetryTag ~= "" then
		PerformanceTelemetryService.Record(telemetryTag .. ".RaycastSeconds", duration)
		PerformanceTelemetryService.Increment(telemetryTag .. ".RaycastCount")
	end
end

local function isNameRejected(instance, rejectedNameContains)
	local current = instance

	while current ~= nil and current ~= Workspace do
		for _, nameFragment in ipairs(rejectedNameContains or {}) do
			if string.find(current.Name, nameFragment, 1, true) ~= nil then
				return true
			end
		end

		current = current.Parent
	end

	return false
end

local function getInheritedAttribute(instance, attributeName)
	local current = instance

	while current ~= nil and current ~= Workspace do
		local value = current:GetAttribute(attributeName)

		if value ~= nil then
			return value
		end

		current = current.Parent
	end

	return nil
end

local function hasIgnoredSurfaceAttribute(instance)
	return getInheritedAttribute(instance, "MegaRobloxIgnoreAsSpawnSurface") == true
end

local function isSurfaceAllowed(result, options)
	if result == nil then
		return false
	end

	local minSurfaceNormalY = options.MinSurfaceNormalY or 0.65

	if result.Normal.Y < minSurfaceNormalY then
		return false
	end

	if hasIgnoredSurfaceAttribute(result.Instance) then
		return false
	end

	local isGeneratedTerrain = getInheritedAttribute(result.Instance, "MegaRobloxGeneratedTerrain") == true
	local terrainKind = getInheritedAttribute(result.Instance, "MegaRobloxTerrainKind")

	if options.RejectGeneratedTerrain == true and isGeneratedTerrain then
		return false
	end

	-- Les volumes de terre ne sont jamais des sols de spawn. Les rampes restent
	-- praticables pour les monstres en mouvement, mais pas pour les objets fixes.
	if terrainKind == "Bottom" or terrainKind == "LinkBottom" or terrainKind == "BaseBottom" then
		return false
	end

	if terrainKind == "Ramp" and options.AllowGeneratedRampSurface ~= true then
		return false
	end

	if isNameRejected(result.Instance, options.RejectedSurfaceNameContains) then
		return false
	end

	if result.Instance:IsA("BasePart") and options.RequireCanCollide ~= false and not result.Instance.CanCollide then
		return false
	end

	return true
end

local function getHorizontalDistance(a, b)
	return (Vector2.new(a.X, a.Z) - Vector2.new(b.X, b.Z)).Magnitude
end

local function getBoundsForInstance(instance)
	if instance == nil then
		return nil
	end

	if instance:IsA("BasePart") then
		local halfSize = instance.Size * 0.5

		return {
			MinX = instance.Position.X - halfSize.X,
			MaxX = instance.Position.X + halfSize.X,
			MinZ = instance.Position.Z - halfSize.Z,
			MaxZ = instance.Position.Z + halfSize.Z,
		}
	end

	if instance:IsA("Model") then
		-- Une map contient souvent des murs ou limites plus grands que sa base
		-- jouable. La plus grande surface horizontale est donc la reference utile
		-- pour tous les placements runtime.
		local largestSurfacePart = nil
		local largestSurfaceArea = 0

		for _, descendant in ipairs(instance:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant.CFrame.UpVector.Y >= 0.98 then
				local horizontalArea = descendant.Size.X * descendant.Size.Z

				if horizontalArea > largestSurfaceArea then
					largestSurfaceArea = horizontalArea
					largestSurfacePart = descendant
				end
			end
		end

		if largestSurfacePart ~= nil then
			local halfSize = largestSurfacePart.Size * 0.5

			return {
				MinX = largestSurfacePart.Position.X - halfSize.X,
				MaxX = largestSurfacePart.Position.X + halfSize.X,
				MinZ = largestSurfacePart.Position.Z - halfSize.Z,
				MaxZ = largestSurfacePart.Position.Z + halfSize.Z,
			}
		end

		local boundingCFrame, size = instance:GetBoundingBox()
		local halfSize = size * 0.5

		return {
			MinX = boundingCFrame.Position.X - halfSize.X,
			MaxX = boundingCFrame.Position.X + halfSize.X,
			MinZ = boundingCFrame.Position.Z - halfSize.Z,
			MaxZ = boundingCFrame.Position.Z + halfSize.Z,
		}
	end

	local minimum = nil
	local maximum = nil

	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local halfSize = descendant.Size * 0.5
			local partMinimum = descendant.Position - halfSize
			local partMaximum = descendant.Position + halfSize
			minimum = if minimum == nil then partMinimum else Vector3.new(
				math.min(minimum.X, partMinimum.X),
				math.min(minimum.Y, partMinimum.Y),
				math.min(minimum.Z, partMinimum.Z)
			)
			maximum = if maximum == nil then partMaximum else Vector3.new(
				math.max(maximum.X, partMaximum.X),
				math.max(maximum.Y, partMaximum.Y),
				math.max(maximum.Z, partMaximum.Z)
			)
		end
	end

	if minimum == nil or maximum == nil then
		return nil
	end

	return {
		MinX = minimum.X,
		MaxX = maximum.X,
		MinZ = minimum.Z,
		MaxZ = maximum.Z,
	}
end

local function isFarEnough(position, positions, minDistance)
	for _, existingPosition in ipairs(positions) do
		if getHorizontalDistance(position, existingPosition) < minDistance then
			return false
		end
	end

	return true
end

local function findFirstBasePart(instance)
	if instance == nil then
		return nil
	end

	if instance:IsA("BasePart") then
		return instance
	end

	if not instance:IsA("Model") then
		return nil
	end

	if instance.PrimaryPart ~= nil then
		return instance.PrimaryPart
	end

	return instance:FindFirstChildWhichIsA("BasePart", true)
end

function WorldSpawnService.GetInstancePosition(instance)
	if instance == nil then
		return nil
	end

	if instance:IsA("BasePart") then
		return instance.Position
	end

	if instance:IsA("Model") then
		local root = findFirstBasePart(instance)

		if root == nil then
			return nil
		end

		local cframe = instance:GetBoundingBox()

		return cframe.Position
	end

	local root = findFirstBasePart(instance)

	if root == nil then
		return nil
	end

	return root.Position
end

function WorldSpawnService.GetPositionsFromFolder(folder)
	local positions = {}

	if folder == nil then
		return positions
	end

	for _, child in ipairs(folder:GetChildren()) do
		local position = WorldSpawnService.GetInstancePosition(child)

		if position ~= nil then
			table.insert(positions, position)
		end
	end

	return positions
end

function WorldSpawnService.FindSurfacePositionAtXZ(x, z, options)
	-- Les appels locaux, notamment autour du joueur, doivent dicter la hauteur du rayon.
	-- Le centre global de la map peut etre remonte par ses murs et ne touche alors plus le sol.
	local center = options.Center or activeSurfaceCenter or Vector3.new(0, 0, 0)
	local raycastHeight = options.RaycastHeight or 240
	local raycastDepth = options.RaycastDepth or 520
	local rayOrigin = Vector3.new(x, center.Y + raycastHeight, z)
	local rayDirection = Vector3.new(0, -raycastDepth, 0)
	local raycastParams = RaycastParams.new()

	local includeInstances = options.IncludeInstances

	if includeInstances == nil and activeSurfaceRoot ~= nil and activeSurfaceRoot.Parent ~= nil then
		-- Une map peut etre un modele clone alors que son sol est le Terrain global Roblox.
		-- Les deux restent des surfaces autorisees pendant une run, sans inclure les runtimes.
		includeInstances = { activeSurfaceRoot, Workspace.Terrain }
	end

	if includeInstances ~= nil and #includeInstances > 0 then
		raycastParams.FilterType = Enum.RaycastFilterType.Include
		raycastParams.FilterDescendantsInstances = includeInstances
	else
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = getDefaultExcludeInstances(options.ExcludeInstances)
	end

	local raycastStartedAt = os.clock()
	local result = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
	recordRaycastTelemetry(options, os.clock() - raycastStartedAt)

	if isSurfaceAllowed(result, options) then
		return result.Position, result.Instance
	end

	-- Certaines maps gardent volontairement leur sol dans Workspace. Ce repli est
	-- explicite afin de ne pas modifier le placement des autres interactables.
	if options.AllowWorkspaceSurfaceFallback == true and includeInstances ~= nil then
		raycastParams.FilterType = Enum.RaycastFilterType.Exclude
		raycastParams.FilterDescendantsInstances = getDefaultExcludeInstances(options.ExcludeInstances)
		local fallbackStartedAt = os.clock()
		local fallbackResult = Workspace:Raycast(rayOrigin, rayDirection, raycastParams)
		recordRaycastTelemetry(options, os.clock() - fallbackStartedAt)

		if isSurfaceAllowed(fallbackResult, options) then
			return fallbackResult.Position, fallbackResult.Instance
		end
	end

	return nil
end

function WorldSpawnService.IsInsideActivePlayableBounds(position, edgeInset)
	if activeSurfaceBounds == nil then
		return true
	end

	local inset = math.max(0, edgeInset or 0)
	local minimumX = activeSurfaceBounds.MinX + inset
	local maximumX = activeSurfaceBounds.MaxX - inset
	local minimumZ = activeSurfaceBounds.MinZ + inset
	local maximumZ = activeSurfaceBounds.MaxZ - inset

	if minimumX > maximumX or minimumZ > maximumZ then
		return true
	end

	return position.X >= minimumX
		and position.X <= maximumX
		and position.Z >= minimumZ
		and position.Z <= maximumZ
end

function WorldSpawnService.GetActivePlayableBounds()
	return activeSurfaceBounds
end

function WorldSpawnService.FindSurfacePositionInPlayableBounds(options)
	if activeSurfaceBounds == nil then
		return nil
	end

	local edgeInset = math.max(0, options.EdgeInset or 0)
	local minimumX = activeSurfaceBounds.MinX + edgeInset
	local maximumX = activeSurfaceBounds.MaxX - edgeInset
	local minimumZ = activeSurfaceBounds.MinZ + edgeInset
	local maximumZ = activeSurfaceBounds.MaxZ - edgeInset

	if minimumX >= maximumX or minimumZ >= maximumZ then
		return nil
	end

	local center = options.Center or activeSurfaceCenter or Vector3.new(0, 0, 0)
	local minRadius = math.max(0, options.MinRadius or 0)
	local maxRadius = math.max(minRadius, options.MaxRadius or math.huge)
	local attempts = math.max(1, options.Attempts or 48)

	for _ = 1, attempts do
		local sampleX = rng:NextNumber(minimumX, maximumX)
		local sampleZ = rng:NextNumber(minimumZ, maximumZ)
		local horizontalDistance = getHorizontalDistance(Vector3.new(sampleX, 0, sampleZ), center)

		if horizontalDistance < minRadius or horizontalDistance > maxRadius then
			continue
		end

		local surfacePosition, surfaceInstance = WorldSpawnService.FindSurfacePositionAtXZ(sampleX, sampleZ, options)

		if surfacePosition ~= nil and (options.PositionFilter == nil or options.PositionFilter(surfacePosition, surfaceInstance) == true) then
			return surfacePosition, surfaceInstance
		end
	end

	return nil
end

function WorldSpawnService.SetRunContext(surfaceRoot, seed, surfaceCenter)
	activeSurfaceRoot = surfaceRoot
	activeSurfaceCenter = surfaceCenter
	activeSurfaceBounds = getBoundsForInstance(surfaceRoot)
	rng = Random.new(math.floor(tonumber(seed) or 0))

	DebugLog.Info("WorldSpawn", "Contexte de generation active", {
		SurfaceRoot = surfaceRoot,
		Center = surfaceCenter,
		Bounds = activeSurfaceBounds,
		Seed = seed,
	})
end

function WorldSpawnService.ClearRunContext(surfaceRoot)
	if surfaceRoot == nil or activeSurfaceRoot == surfaceRoot then
		activeSurfaceRoot = nil
		activeSurfaceCenter = nil
		activeSurfaceBounds = nil
		rng = Random.new()
	end
end

function WorldSpawnService.FindDistributedSurfacePositions(options)
	local requestedCount = options.Count or 0
	local center = activeSurfaceCenter or options.Center or Vector3.new(0, 0, 0)
	local minRadius = options.MinRadius or 0
	local maxRadius = math.max(minRadius, options.MaxRadius or 160)
	local minDistance = options.MinDistance or 12
	local attemptsPerPoint = options.AttemptsPerPoint or 24
	local jitterRadius = options.JitterRadius or 14
	local logCategory = options.LogCategory or "Templates"
	local logLabel = options.LogLabel or "objets"
	local positions = {}
	local occupiedPositions = {}
	local usePlayableBounds = options.UsePlayableBounds == true and activeSurfaceBounds ~= nil
	local edgeInset = math.max(0, options.EdgeInset or 12)
	local minimumX = nil
	local maximumX = nil
	local minimumZ = nil
	local maximumZ = nil

	if usePlayableBounds then
		minimumX = activeSurfaceBounds.MinX + edgeInset
		maximumX = activeSurfaceBounds.MaxX - edgeInset
		minimumZ = activeSurfaceBounds.MinZ + edgeInset
		maximumZ = activeSurfaceBounds.MaxZ - edgeInset

		if minimumX >= maximumX or minimumZ >= maximumZ then
			DebugLog.Warn(logCategory, "Surface jouable trop etroite pour le placement", {
				Type = logLabel,
				EdgeInset = edgeInset,
			})
			return positions
		end
	end

	for _, position in ipairs(options.OccupiedPositions or {}) do
		table.insert(occupiedPositions, position)
	end

	for index = 1, requestedCount do
		local acceptedPosition = nil
		local progress = (index - 0.5) / math.max(1, requestedCount)
		local baseRadius = minRadius + (math.sqrt(progress) * (maxRadius - minRadius))
		local baseAngle = index * GOLDEN_ANGLE

		for _ = 1, attemptsPerPoint do
			local sampleX = nil
			local sampleZ = nil

			if usePlayableBounds then
				-- Les objets fixes couvrent la base rectangulaire, y compris ses coins.
				sampleX = rng:NextNumber(minimumX, maximumX)
				sampleZ = rng:NextNumber(minimumZ, maximumZ)
			else
				local jitterAngle = rng:NextNumber(0, math.pi * 2)
				local jitterDistance = rng:NextNumber(0, jitterRadius)
				local angle = baseAngle + rng:NextNumber(-0.22, 0.22)
				sampleX = center.X + (math.cos(angle) * baseRadius) + (math.cos(jitterAngle) * jitterDistance)
				sampleZ = center.Z + (math.sin(angle) * baseRadius) + (math.sin(jitterAngle) * jitterDistance)
			end

			if usePlayableBounds
				and getHorizontalDistance(Vector3.new(sampleX, 0, sampleZ), center) < minRadius
			then
				continue
			end
			local surfacePosition = WorldSpawnService.FindSurfacePositionAtXZ(sampleX, sampleZ, options)

			if surfacePosition ~= nil
				and isFarEnough(surfacePosition, occupiedPositions, minDistance)
				and isFarEnough(surfacePosition, positions, minDistance)
				and (options.PositionFilter == nil or options.PositionFilter(surfacePosition) == true)
			then
				acceptedPosition = surfacePosition
				break
			end
		end

		if acceptedPosition ~= nil then
			table.insert(positions, acceptedPosition)
		end
	end

	if #positions < requestedCount then
		DebugLog.Warn(logCategory, "Placement surface incomplet", {
			Type = logLabel,
			Requested = requestedCount,
			Placed = #positions,
			MinDistance = minDistance,
			MaxRadius = maxRadius,
			UsePlayableBounds = usePlayableBounds,
			EdgeInset = if usePlayableBounds then edgeInset else nil,
		})
	else
		DebugLog.Info(logCategory, "Placement surface pret", {
			Type = logLabel,
			Placed = #positions,
			MinDistance = minDistance,
			MaxRadius = maxRadius,
		})
	end

	return positions
end

function WorldSpawnService.FindGeneratedTerrainBarrier(origin, direction, distance, options)
	if activeSurfaceRoot == nil or activeSurfaceRoot.Parent == nil then
		return nil
	end

	local horizontalDirection = Vector3.new(direction.X, 0, direction.Z)

	if horizontalDirection.Magnitude <= 0.001 or distance <= 0 then
		return nil
	end

	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Include
	raycastParams.FilterDescendantsInstances = { activeSurfaceRoot }

	local rayHeight = if options ~= nil and options.Height ~= nil then options.Height else 2
	local rayOrigin = origin + Vector3.new(0, rayHeight, 0)
	local raycastStartedAt = os.clock()
	local result = Workspace:Raycast(rayOrigin, horizontalDirection.Unit * distance, raycastParams)
	recordRaycastTelemetry(options, os.clock() - raycastStartedAt)

	if result == nil then
		return nil
	end

	local terrainKind = getInheritedAttribute(result.Instance, "MegaRobloxTerrainKind")

	if terrainKind == "Bottom" or terrainKind == "LinkBottom" or terrainKind == "BaseBottom" then
		return result
	end

	return nil
end

function WorldSpawnService.GetSurfacePivotPosition(instance, surfacePosition, surfaceOffset, shouldIgnorePart)
	surfaceOffset = surfaceOffset or 0

	if instance:IsA("BasePart") then
		return surfacePosition + Vector3.new(0, (instance.Size.Y * 0.5) + surfaceOffset, 0)
	end

	if not instance:IsA("Model") then
		return surfacePosition + Vector3.new(0, surfaceOffset, 0)
	end

	local pivot = instance:GetPivot()
	local bottomY = nil

	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("BasePart") and (shouldIgnorePart == nil or not shouldIgnorePart(descendant)) then
			local partBottomY = descendant.Position.Y - (descendant.Size.Y * 0.5)

			if bottomY == nil or partBottomY < bottomY then
				bottomY = partBottomY
			end
		end
	end

	if bottomY == nil then
		local boundingCFrame, size = instance:GetBoundingBox()

		bottomY = boundingCFrame.Position.Y - (size.Y * 0.5)
	end

	local pivotToBottomOffset = pivot.Position.Y - bottomY

	return Vector3.new(
		surfacePosition.X,
		surfacePosition.Y + pivotToBottomOffset + surfaceOffset,
		surfacePosition.Z
	)
end

function WorldSpawnService.GetPivotRotation(instance)
	if instance:IsA("Model") or instance:IsA("BasePart") then
		local pivot = instance:GetPivot()

		return pivot - pivot.Position
	end

	return CFrame.new()
end

function WorldSpawnService.GetPivotCFrameAtPosition(instance, pivotPosition, yawRadians)
	local yawCFrame = CFrame.Angles(0, yawRadians or 0, 0)

	return CFrame.new(pivotPosition) * yawCFrame * WorldSpawnService.GetPivotRotation(instance)
end

return WorldSpawnService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="107">
        <Properties>
          <string name="Name">XpService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local PerkService = require(script.Parent:WaitForChild("PerkService"))
local RunAnalyticsService = require(script.Parent:WaitForChild("RunAnalyticsService"))
local TemplateService = require(script.Parent:WaitForChild("TemplateService"))
local PerformanceTelemetryService = require(script.Parent:WaitForChild("PerformanceTelemetryService"))

local XpService = {}

local TEMPLATE_FOLDER_NAME = "CollectibleTemplates"
local profilesByUserId = {}
local trackedGems = {}
local xpGemTemplatesByTier = {}
local xpGemPoolFolder = nil
local elapsedSinceScan = 0
local elapsedSinceMerge = 0
local elapsedSincePerfLog = 0
local maxScanMilliseconds = 0
local maxMergeMilliseconds = 0
local heartbeatConnection = nil

local function getOrCreateRemote(remoteName)
	local remote = ReplicatedStorage:FindFirstChild(remoteName)

	if remote == nil then
		remote = Instance.new("RemoteEvent")
		remote.Name = remoteName
		remote.Parent = ReplicatedStorage
	end

	assert(remote:IsA("RemoteEvent"), remoteName .. " doit etre un RemoteEvent.")

	return remote
end

local updateXpRemote = getOrCreateRemote("Xp_UpdateCount")
local collectXpRemote = getOrCreateRemote("Xp_PlayCollect")
local pickupFeedbackRemote = getOrCreateRemote("PickupFeedback_Show")

local function getOrCreateFolder(parent, folderName)
	local folder = parent:FindFirstChild(folderName)

	if folder == nil then
		folder = Instance.new("Folder")
		folder.Name = folderName
		folder.Parent = parent
	end

	return folder
end

local function getRuntimeLootFolder()
	return TemplateService.GetCombatLootFolder()
end

local function getXpGemPoolFolder()
	if xpGemPoolFolder == nil then
		xpGemPoolFolder = getOrCreateFolder(ServerStorage, "XpGemPools")
	end

	return xpGemPoolFolder
end

local function getTierName(tier)
	return CombatConfig.XpGemTierNames[tier] or CombatConfig.XpGemTemplateName
end

local function getTierPoolFolder(tier)
	return getOrCreateFolder(getXpGemPoolFolder(), getTierName(tier))
end

local function getTierValue(tier)
	return CombatConfig.XpGemTierValues[tier] or CombatConfig.XpPerGem
end

local function getGemTierByName(name)
	for tier, tierName in ipairs(CombatConfig.XpGemTierNames) do
		if name == tierName then
			return tier
		end
	end

	return nil
end

local function getOrCreateXpValue(player)
	local leaderstats = player:FindFirstChild("leaderstats")

	if leaderstats == nil then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local xpValue = leaderstats:FindFirstChild("XP")

	if xpValue == nil then
		xpValue = Instance.new("IntValue")
		xpValue.Name = "XP"
		xpValue.Parent = leaderstats
	end

	return xpValue
end

local function getOrCreateLevelValue(player)
	local leaderstats = player:FindFirstChild("leaderstats")

	if leaderstats == nil then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local levelValue = leaderstats:FindFirstChild("Level")

	if levelValue == nil then
		levelValue = Instance.new("IntValue")
		levelValue.Name = "Level"
		levelValue.Parent = leaderstats
	end

	return levelValue
end

local function getRequiredXpForLevel(level)
	return CombatConfig.LevelBaseXp + ((math.max(1, level) - 1) * CombatConfig.LevelXpIncrease)
end

local function getOrCreateProfile(player)
	local profile = profilesByUserId[player.UserId]

	if profile == nil then
		profile = {
			Xp = 0,
			TotalXp = 0,
			Level = 1,
		}
		profilesByUserId[player.UserId] = profile
	end

	profile.Xp = profile.Xp or 0
	profile.TotalXp = profile.TotalXp or 0
	profile.Level = profile.Level or 1

	return profile
end

local function sendXpCount(player)
	local profile = getOrCreateProfile(player)

	updateXpRemote:FireClient(player, {
		Xp = profile.Xp,
		TotalXp = profile.TotalXp,
		Level = profile.Level,
		XpRequired = getRequiredXpForLevel(profile.Level),
	})
end

local function findGemRoot(gem)
	if gem:IsA("BasePart") then
		return gem
	end

	if not gem:IsA("Model") then
		return nil
	end

	if gem.PrimaryPart ~= nil then
		return gem.PrimaryPart
	end

	local firstPart = gem:FindFirstChildWhichIsA("BasePart", true)

	if firstPart ~= nil then
		gem.PrimaryPart = firstPart
	end

	return firstPart
end

local function hasGemModelAncestor(instance, gemName)
	local current = instance.Parent

	while current ~= nil do
		if current:IsA("Model") and current.Name == gemName then
			return true
		end

		current = current.Parent
	end

	return false
end

local function isCollectableGem(instance)
	local tier = getGemTierByName(instance.Name)

	if tier == nil then
		return false
	end

	if instance:IsA("Model") then
		return findGemRoot(instance) ~= nil
	end

	if instance:IsA("BasePart") then
		return not hasGemModelAncestor(instance, instance.Name)
	end

	return false
end

local function createFallbackGemTemplate(templateStorage, tier)
	local part = Instance.new("Part")
	part.Name = getTierName(tier)
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.new(1, 1, 1) * (1 + ((tier - 1) * 0.35))
	part.Color = ({
		Color3.fromRGB(80, 210, 255),
		Color3.fromRGB(120, 255, 150),
		Color3.fromRGB(190, 120, 255),
	})[tier] or Color3.fromRGB(80, 210, 255)
	part.Material = Enum.Material.Neon
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Parent = templateStorage

	DebugLog.Warn("Xp", "Template gemme XP introuvable, fallback cree", {
		Template = getTierName(tier),
		Tier = tier,
	})

	return part
end

local function findGemTemplate(tier)
	local tierName = getTierName(tier)

	return TemplateService.GetTemplate(TEMPLATE_FOLDER_NAME, tierName, function(templateStorage)
		return createFallbackGemTemplate(templateStorage, tier)
	end)
end

local function pivotCollectible(instance, position)
	if instance:IsA("Model") or instance:IsA("BasePart") then
		instance:PivotTo(CFrame.new(position))
	end
end

local function prepareCollectible(instance)
	if instance:IsA("BasePart") then
		instance.Anchored = true
		instance.CanCollide = false
		instance.CanTouch = false
		instance.CanQuery = false
	end

	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
		end
	end
end

local function acquireGem(tier)
	local tierPoolFolder = getTierPoolFolder(tier)
	local gem = tierPoolFolder:FindFirstChild(getTierName(tier))

	if gem == nil then
		gem = tierPoolFolder:FindFirstChildWhichIsA("Model") or tierPoolFolder:FindFirstChildWhichIsA("BasePart")
	end

	if gem ~= nil then
		gem.Parent = getRuntimeLootFolder()
		return gem, true
	end

	gem = xpGemTemplatesByTier[tier]:Clone()
	gem.Parent = getRuntimeLootFolder()

	return gem, false
end

local function releaseGem(gem, tier)
	if gem == nil or gem.Parent == nil then
		return
	end

	trackedGems[gem] = nil
	gem.Name = getTierName(tier or getGemTierByName(gem.Name) or 1)
	gem.Parent = getTierPoolFolder(tier or getGemTierByName(gem.Name) or 1)
end

local function prewarmGemPool(tier, count)
	local prewarmCount = math.max(0, math.floor(count or 0))

	if xpGemTemplatesByTier[tier] == nil or prewarmCount <= 0 then
		return
	end

	local tierPoolFolder = getTierPoolFolder(tier)

	for _ = 1, prewarmCount do
		local gem = xpGemTemplatesByTier[tier]:Clone()
		gem.Name = getTierName(tier)
		prepareCollectible(gem)
		gem.Parent = tierPoolFolder
	end
end

local function getGemPoolSize()
	local total = 0

	if xpGemPoolFolder == nil then
		return total
	end

	for _, folder in ipairs(xpGemPoolFolder:GetChildren()) do
		total += #folder:GetChildren()
	end

	return total
end

local function getTrackedGemCount()
	local total = 0

	for _ in pairs(trackedGems) do
		total += 1
	end

	return total
end

local function trackGem(instance)
	if not isCollectableGem(instance) then
		return
	end

	local tier = getGemTierByName(instance.Name) or 1

	trackedGems[instance] = {
		Collected = false,
		Tier = tier,
		XpValue = getTierValue(tier),
	}
end

local function scanExistingGems()
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		trackGem(descendant)
	end
end

local function getPlayerRoot(player)
	local character = player.Character

	if character == nil then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function awardXp(player, xpValue)
	local profile = getOrCreateProfile(player)
	local finalXpValue = PerkService.GetXpAmount(player, xpValue)

	profile.Xp += finalXpValue
	profile.TotalXp += finalXpValue
	RunAnalyticsService.RecordXpEarned(player, finalXpValue)

	local requiredXp = getRequiredXpForLevel(profile.Level)

	while profile.Xp >= requiredXp do
		profile.Xp -= requiredXp
		profile.Level += 1
		DebugLog.Info("Xp", "Level up joueur", {
			Player = player.Name,
			Level = profile.Level,
			RemainingXp = profile.Xp,
			NextRequiredXp = getRequiredXpForLevel(profile.Level),
		})
		PerkService.QueueLevelUp(player, profile.Level)
		requiredXp = getRequiredXpForLevel(profile.Level)
	end

	getOrCreateXpValue(player).Value = profile.TotalXp
	getOrCreateLevelValue(player).Value = profile.Level
	sendXpCount(player)

	return finalXpValue
end

local function finishGemCollection(player, gem, gemState, attractDuration)
	if gemState.Cancelled or player.Parent ~= Players or gem.Parent == nil then
		if gem.Parent ~= nil then
			gemState.Collected = false
		end
		return
	end

	local arrivalTime = Workspace:GetServerTimeNow() + math.max(0, attractDuration)

	collectXpRemote:FireAllClients(gem, player.UserId, attractDuration)
	DebugLog.ThrottledInfo("Xp", "xp_collect_" .. player.UserId, 0.5, "Gemme XP collectee", {
		Player = player.Name,
		Gem = gem,
		Tier = gemState.Tier,
		XpValue = gemState.XpValue,
	})
	local finalXpValue = awardXp(player, gemState.XpValue or CombatConfig.XpPerGem)
	pickupFeedbackRemote:FireClient(player, {
		Kind = "Xp",
		Amount = finalXpValue,
		ArrivalTime = arrivalTime,
	})

	task.delay(attractDuration + 0.1, function()
		if gem.Parent ~= nil then
			releaseGem(gem, gemState.Tier)
		end
	end)
end

local function collectGem(player, gem, gemState, attractDuration)
	if gemState.Collected then
		return false
	end

	gemState.Collected = true
	finishGemCollection(player, gem, gemState, attractDuration or CombatConfig.XpAttractDuration)

	return true
end

local function scheduleGemCollection(player, gem, gemState, attractDuration, delaySeconds)
	if gemState.Collected then
		return false
	end

	gemState.Collected = true

	task.delay(delaySeconds, function()
		finishGemCollection(player, gem, gemState, attractDuration)
	end)

	return true
end

local function scanGemProximity()
	for gem, gemState in pairs(trackedGems) do
		if gem.Parent == nil then
			trackedGems[gem] = nil
			continue
		end

		if gemState.Collected then
			continue
		end

		local gemRoot = findGemRoot(gem)

		if gemRoot == nil then
			continue
		end

		for _, player in ipairs(Players:GetPlayers()) do
			local playerRoot = getPlayerRoot(player)

			if playerRoot ~= nil then
				local distance = (playerRoot.Position - gemRoot.Position).Magnitude

				if distance <= PerkService.GetCollectDistance(player, CombatConfig.XpCollectDistance) then
					collectGem(player, gem, gemState)
					break
				end
			end
		end
	end
end

local function getMergeGridKey(cellX, cellZ)
	return tostring(cellX) .. ":" .. tostring(cellZ)
end

local function getGemPosition(gem)
	local root = findGemRoot(gem)

	if root == nil then
		return nil
	end

	return root.Position
end

local function buildMergeGrid(tier)
	local grid = {}
	local cellSize = CombatConfig.XpMergeRadius

	for gem, gemState in pairs(trackedGems) do
		if gem.Parent == nil then
			trackedGems[gem] = nil
			continue
		end

		if not gemState.Collected and gemState.Tier == tier then
			local position = getGemPosition(gem)

			if position ~= nil then
				local cellX = math.floor(position.X / cellSize)
				local cellZ = math.floor(position.Z / cellSize)
				local key = getMergeGridKey(cellX, cellZ)

				if grid[key] == nil then
					grid[key] = {}
				end

				table.insert(grid[key], {
					Gem = gem,
					State = gemState,
					Position = position,
					CellX = cellX,
					CellZ = cellZ,
				})
			end
		end
	end

	return grid
end

local function findMergeGroup(seedEntry, grid, usedGems)
	local group = {}
	local radius = CombatConfig.XpMergeRadius

	for offsetX = -1, 1 do
		for offsetZ = -1, 1 do
			local key = getMergeGridKey(seedEntry.CellX + offsetX, seedEntry.CellZ + offsetZ)
			local cell = grid[key]

			if cell ~= nil then
				for _, entry in ipairs(cell) do
					if not usedGems[entry.Gem] and not entry.State.Collected then
						local distance = (entry.Position - seedEntry.Position).Magnitude

						if distance <= radius then
							table.insert(group, entry)

							if #group >= CombatConfig.XpMergeCount then
								return group
							end
						end
					end
				end
			end
		end
	end

	return group
end

local function mergeGroup(group, nextTier)
	local center = Vector3.zero

	for _, entry in ipairs(group) do
		center += entry.Position
		entry.State.Collected = true
		trackedGems[entry.Gem] = nil

		if entry.Gem.Parent ~= nil then
			releaseGem(entry.Gem, entry.State.Tier)
		end
	end

	center /= #group
	DebugLog.ThrottledInfo("Xp", "xp_merge", 1, "Fusion de gemmes XP", {
		Count = #group,
		NextTier = nextTier,
		Position = center,
	})
	XpService.SpawnXpGem(center, nextTier)
end

local function mergeNearbyGems()
	local maxTier = #CombatConfig.XpGemTierNames
	local mergedGroups = 0

	for tier = 1, maxTier - 1 do
		local grid = buildMergeGrid(tier)
		local usedGems = {}

		for _, cell in pairs(grid) do
			for _, entry in ipairs(cell) do
				if mergedGroups >= CombatConfig.XpMergeMaxGroupsPerScan then
					return
				end

				if not usedGems[entry.Gem] and not entry.State.Collected then
					local group = findMergeGroup(entry, grid, usedGems)

					if #group >= CombatConfig.XpMergeCount then
						for _, groupEntry in ipairs(group) do
							usedGems[groupEntry.Gem] = true
						end

						mergeGroup(group, tier + 1)
						mergedGroups += 1
					end
				end
			end
		end
	end
end

function XpService.SetupPlayer(player)
	local profile = getOrCreateProfile(player)
	DebugLog.Info("Xp", "Setup joueur XP", {
		Player = player.Name,
		Level = profile.Level,
		TotalXp = profile.TotalXp,
	})
	getOrCreateXpValue(player).Value = profile.TotalXp
	getOrCreateLevelValue(player).Value = profile.Level
	sendXpCount(player)
end

function XpService.RemovePlayer(player)
	profilesByUserId[player.UserId] = nil
end

function XpService.SpawnXpGem(position, tier)
	local gemTier = math.clamp(tier or 1, 1, #CombatConfig.XpGemTierNames)

	if xpGemTemplatesByTier[gemTier] == nil then
		xpGemTemplatesByTier[gemTier] = findGemTemplate(gemTier)
	end

	local gem = acquireGem(gemTier)
	gem.Name = getTierName(gemTier)

	prepareCollectible(gem)
	pivotCollectible(gem, position)
	trackGem(gem)

	DebugLog.ThrottledInfo("Xp", "xp_spawn", 1, "Gemme XP generee", {
		Gem = gem,
		Tier = gemTier,
		Position = position,
	})

	return gem
end

function XpService.CollectAllForPlayer(player, attractDuration, spreadDuration)
	local playerRoot = getPlayerRoot(player)

	if playerRoot == nil then
		return 0
	end

	local candidates = {}

	for gem, gemState in pairs(trackedGems) do
		if gem.Parent == nil then
			trackedGems[gem] = nil
			continue
		end

		if gemState.Collected then
			continue
		end

		local gemRoot = findGemRoot(gem)

		if gemRoot ~= nil then
			table.insert(candidates, {
				Gem = gem,
				State = gemState,
				Distance = (playerRoot.Position - gemRoot.Position).Magnitude,
			})
		end
	end

	table.sort(candidates, function(left, right)
		return left.Distance < right.Distance
	end)

	local collectedCount = 0
	local duration = attractDuration or CombatConfig.XpAttractDuration
	local spread = spreadDuration or 0
	local delayStep = 0

	if #candidates > 1 then
		delayStep = spread / (#candidates - 1)
	end

	for index, candidate in ipairs(candidates) do
		local delaySeconds = math.min(spread, (index - 1) * delayStep)

		if scheduleGemCollection(player, candidate.Gem, candidate.State, duration, delaySeconds) then
			collectedCount += 1
		end
	end

	DebugLog.Info("Xp", "Magnetisme global XP demande", {
		Player = player.Name,
		CollectedCount = collectedCount,
		Duration = duration,
		Spread = spread,
	})

	return collectedCount
end

function XpService.ClearRunGems()
	local gemsToRelease = {}

	for gem, gemState in pairs(trackedGems) do
		table.insert(gemsToRelease, {
			Gem = gem,
			State = gemState,
		})
	end

	for _, entry in ipairs(gemsToRelease) do
		entry.State.Cancelled = true
		trackedGems[entry.Gem] = nil

		if entry.Gem.Parent ~= nil then
			releaseGem(entry.Gem, entry.State.Tier)
		end
	end
end

function XpService.GetPerformanceSnapshot()
	return {
		Tracked = getTrackedGemCount(),
		Pool = getGemPoolSize(),
	}
end

function XpService.GetRunStats(player)
	local profile = getOrCreateProfile(player)

	return {
		Xp = profile.Xp,
		TotalXp = profile.TotalXp,
		Level = profile.Level,
		XpRequired = getRequiredXpForLevel(profile.Level),
	}
end

function XpService.ResetRun(player)
	local profile = getOrCreateProfile(player)

	profile.Xp = 0
	profile.TotalXp = 0
	profile.Level = 1
	getOrCreateXpValue(player).Value = profile.TotalXp
	getOrCreateLevelValue(player).Value = profile.Level
	sendXpCount(player)
end

function XpService.Start()
	DebugLog.Info("Xp", "XpService demarre", {
		LootFolder = getRuntimeLootFolder(),
		Tiers = CombatConfig.XpGemTierNames,
		MergeRadius = CombatConfig.XpMergeRadius,
	})

	for tier = 1, #CombatConfig.XpGemTierNames do
		xpGemTemplatesByTier[tier] = findGemTemplate(tier)
		prewarmGemPool(tier, (CombatConfig.XpGemPoolPrewarmPerTier or {})[tier])
	end

	DebugLog.Info("Perf", "Pool XP prechauffe", {
		Pool = getGemPoolSize(),
	})

	scanExistingGems()

	Workspace.DescendantAdded:Connect(function(descendant)
		task.defer(function()
			trackGem(descendant)
		end)
	end)

	if heartbeatConnection ~= nil then
		return
	end

	heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
		if CombatStateService.IsPaused() then
			return
		end

		elapsedSinceScan += deltaTime
		elapsedSinceMerge += deltaTime
		elapsedSincePerfLog += deltaTime

		if elapsedSinceScan >= 0.15 then
			elapsedSinceScan = 0
			local startedAt = os.clock()
			scanGemProximity()
			local scanDuration = os.clock() - startedAt
			PerformanceTelemetryService.Record("Xp.ScanSeconds", scanDuration)
			maxScanMilliseconds = math.max(maxScanMilliseconds, scanDuration * 1000)
		end

		if elapsedSinceMerge >= CombatConfig.XpMergeScanInterval then
			elapsedSinceMerge = 0
			local startedAt = os.clock()
			mergeNearbyGems()
			local mergeDuration = os.clock() - startedAt
			PerformanceTelemetryService.Record("Xp.MergeSeconds", mergeDuration)
			maxMergeMilliseconds = math.max(maxMergeMilliseconds, mergeDuration * 1000)
		end

		if elapsedSincePerfLog >= (CombatConfig.PerfLogInterval or 5) then
			DebugLog.Info("Perf", "Perf XP serveur", {
			Tracked = getTrackedGemCount(),
			Pool = getGemPoolSize(),
			MaxScanMs = maxScanMilliseconds,
			MaxMergeMs = maxMergeMilliseconds,
		})
			elapsedSincePerfLog = 0
			maxScanMilliseconds = 0
			maxMergeMilliseconds = 0
		end
	end)
end

return XpService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="108">
        <Properties>
          <string name="Name">ZoneWeaponService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local WeaponConfig = require(Shared:WaitForChild("WeaponConfig"))

local CombatStateService = require(script.Parent:WaitForChild("CombatStateService"))
local MonsterService = require(script.Parent:WaitForChild("MonsterService"))
local PerkService = require(script.Parent:WaitForChild("PerkService"))
local RunStateService = require(script.Parent:WaitForChild("RunStateService"))
local WeaponHitService = require(script.Parent:WaitForChild("WeaponHitService"))
local WeaponLoadoutService = require(script.Parent:WaitForChild("WeaponLoadoutService"))

local ZoneWeaponService = {}

local WEAPON_ID = "leyden_needle"
local definition = WeaponConfig.GetDefinition(WEAPON_ID)
local cooldownsByUserId = {}
local pendingCastsByUserId = {}
local heartbeatConnection = nil
local castSerial = 0

local vfxRemote = ReplicatedStorage:FindFirstChild("Weapon_ZoneVfx")
if vfxRemote == nil then
	vfxRemote = Instance.new("RemoteEvent")
	vfxRemote.Name = "Weapon_ZoneVfx"
	vfxRemote.Parent = ReplicatedStorage
end
assert(vfxRemote:IsA("RemoteEvent"), "Weapon_ZoneVfx doit etre un RemoteEvent")

local function getCharacterRoot(player: Player)
	local character = player.Character
	return if character then character:FindFirstChild("HumanoidRootPart") else nil
end

local function isPlayerAvailable(player: Player)
	if not RunStateService.IsRunActive(player) then
		return false
	end
	local character = player.Character
	local humanoid = if character then character:FindFirstChildOfClass("Humanoid") else nil
	return humanoid ~= nil and humanoid.Health > 0 and getCharacterRoot(player) ~= nil
end

local function projectToGround(player: Player, position: Vector3)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local excluded = {}
	if player.Character then table.insert(excluded, player.Character) end
	local combatRuntime = Workspace:FindFirstChild("CombatRuntime")
	if combatRuntime then table.insert(excluded, combatRuntime) end
	params.FilterDescendantsInstances = excluded
	params.IgnoreWater = false

	local result = Workspace:Raycast(position + Vector3.new(0, 48, 0), Vector3.new(0, -120, 0), params)
	return if result then result.Position + Vector3.new(0, 0.08, 0) else position
end

local function sortByDistanceFrom(position: Vector3, candidates)
	table.sort(candidates, function(left, right)
		local leftPosition = MonsterService.GetMonsterPosition(left.Monster) or position
		local rightPosition = MonsterService.GetMonsterPosition(right.Monster) or position
		return (leftPosition - position).Magnitude < (rightPosition - position).Magnitude
	end)
end

local function findNextBounce(origin: Vector3, ignored)
	local candidates = MonsterService.GetMonstersNear(origin, definition.Base.BounceRange, ignored)
	if #candidates == 0 then return nil end
	sortByDistanceFrom(origin, candidates)
	return candidates[1].Monster
end

local function resolveImpact(cast)
	local impacted = {}
	local ignored = {}
	local candidates = MonsterService.GetMonstersNear(cast.Center, definition.Base.ZoneRadius)
	sortByDistanceFrom(cast.Center, candidates)

	for _, candidate in ipairs(candidates) do
		local monster = candidate.Monster
		ignored[monster] = true
		table.insert(impacted, monster)
		WeaponHitService.Apply(cast.Player, monster, WEAPON_ID, definition.Base.Damage, Color3.fromRGB(110, 225, 255))
	end

	local arcs = {}
	local bounceRemaining = math.min(
		PerkService.GetBounceCount(cast.Player),
		definition.Caps.BounceCount
	)
	local currentMonster = impacted[1]
	local currentPosition = if currentMonster then MonsterService.GetMonsterPosition(currentMonster) else cast.Center

	while bounceRemaining > 0 and currentPosition ~= nil do
		local nextMonster = findNextBounce(currentPosition, ignored)
		if nextMonster == nil then break end
		local nextPosition = MonsterService.GetMonsterPosition(nextMonster)
		if nextPosition == nil then break end

		ignored[nextMonster] = true
		table.insert(arcs, { From = currentPosition, To = nextPosition })
		WeaponHitService.Apply(cast.Player, nextMonster, WEAPON_ID, definition.Base.Damage, Color3.fromRGB(150, 240, 255))
		currentPosition = nextPosition
		bounceRemaining -= 1
	end

	vfxRemote:FireClient(cast.Player, {
		Type = "Impact",
		WeaponId = WEAPON_ID,
		CastId = cast.CastId,
		Center = cast.Center,
		Radius = definition.Base.ZoneRadius,
		StrikeCount = definition.Base.StrikeCount,
		Arcs = arcs,
		Seed = cast.Seed,
	})

	DebugLog.ThrottledInfo("Weapon", "leyden_impact_" .. cast.Player.UserId, 0.5, "Aiguille de Leyde impacte", {
		Player = cast.Player.Name,
		Targets = #impacted,
		Bounces = #arcs,
		Center = cast.Center,
	})
end

local function beginCast(player: Player, now: number)
	local root = getCharacterRoot(player)
	if root == nil then return false end
	local target = MonsterService.GetClosestMonster(root.Position, definition.Base.Range)
	if target == nil then return false end
	local targetPosition = MonsterService.GetMonsterPosition(target)
	if targetPosition == nil then return false end

	castSerial += 1
	local center = projectToGround(player, targetPosition)
	local seed = (player.UserId * 4099) + castSerial
	pendingCastsByUserId[player.UserId] = {
		Player = player,
		CastId = castSerial,
		Center = center,
		ImpactAt = now + definition.Base.ChargeDuration,
		Seed = seed,
	}
	vfxRemote:FireClient(player, {
		Type = "Charge",
		WeaponId = WEAPON_ID,
		CastId = castSerial,
		Center = center,
		Radius = definition.Base.ZoneRadius,
		ChargeDuration = definition.Base.ChargeDuration,
		StrikeCount = definition.Base.StrikeCount,
		Seed = seed,
		ServerStartTime = Workspace:GetServerTimeNow(),
	})
	return true
end

local function update()
	if CombatStateService.IsPaused() then return end
	local now = CombatStateService.GetTime()

	for userId, cast in pairs(pendingCastsByUserId) do
		if not isPlayerAvailable(cast.Player) then
			pendingCastsByUserId[userId] = nil
		elseif now >= cast.ImpactAt then
			pendingCastsByUserId[userId] = nil
			resolveImpact(cast)
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		if
			isPlayerAvailable(player)
			and WeaponLoadoutService.HasWeapon(player, WEAPON_ID)
			and pendingCastsByUserId[player.UserId] == nil
		then
			local readyAt = cooldownsByUserId[player.UserId] or now
			if now >= readyAt then
				local cooldown = PerkService.GetAttackCooldown(player, definition.Base.Cooldown)
				cooldown = math.max(definition.Caps.MinimumCooldown, cooldown)
				if beginCast(player, now) then
					cooldownsByUserId[player.UserId] = now + cooldown
				end
			end
		end
	end
end

function ZoneWeaponService.RemovePlayer(player: Player)
	cooldownsByUserId[player.UserId] = nil
	pendingCastsByUserId[player.UserId] = nil
end

function ZoneWeaponService.Start()
	if heartbeatConnection then return end
	heartbeatConnection = RunService.Heartbeat:Connect(update)

	RunStateService.RunStarted:Connect(function(player)
		cooldownsByUserId[player.UserId] = CombatStateService.GetTime() + 1
		pendingCastsByUserId[player.UserId] = nil
	end)
	RunStateService.RunEnded:Connect(ZoneWeaponService.RemovePlayer)
	DebugLog.Info("Weapon", "Executeur d'armes de zone demarre", { WeaponId = WEAPON_ID })
end

return ZoneWeaponService
]]></string>
        </Properties>
      </Item>
    </Item>
