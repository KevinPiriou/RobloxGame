        <Properties>
          <string name="Name">WeaponConfig</string>
          <string name="Source"><![CDATA[--!strict

local CombatConfig = require(script.Parent:WaitForChild("CombatConfig"))

local WeaponConfig = {}

WeaponConfig.Categories = {
	Projectile = true,
	Melee = true,
	Zone = true,
	Orbital = true,
}

WeaponConfig.Definitions = {
	fireball = {
		Id = "fireball",
		Name = "Boule de feu",
		Category = "Projectile",
		Lifecycle = "Production",
		Icon = "rbxassetid://91848234123005",
		Base = {
			Damage = CombatConfig.FireballDamage,
			Cooldown = CombatConfig.FireballCooldown,
			Range = CombatConfig.FireballRange,
		},
		Caps = {
			ProjectileCount = 24,
			BounceCount = 12,
		},
	},
	leyden_needle = {
		Id = "leyden_needle",
		Name = "Aiguille de Leyde",
		Category = "Zone",
		Lifecycle = "Development",
		Icon = "",
		VfxProfileId = "LeydenNeedleZone",
		Base = {
			Damage = 32,
			Cooldown = 4.5,
			Range = 72,
			ZoneRadius = 14,
			ChargeDuration = 1.15,
			StrikeCount = 5,
			BounceRange = 20,
		},
		Caps = {
			ZoneRadius = 26,
			BounceCount = 8,
			MinimumCooldown = 0.7,
		},
		Rules = {
			UsesProjectileCount = false,
			UsesBounceCount = true,
			UsesEffectDuration = false,
			SnapshotTargetPosition = true,
		},
	},
}

function WeaponConfig.GetDefinition(weaponId: string)
	return WeaponConfig.Definitions[weaponId]
end

return WeaponConfig
]]></string>
