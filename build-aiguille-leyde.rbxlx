	local weaponName = createLabel(weaponCard, "Name", "FIREBALL", Enum.Font.GothamBlack, 20, COLORS.Text)
	weaponName.Position = UDim2.fromOffset(106, 24)
	weaponName.Size = UDim2.new(1, -120, 0, 26)

	local weaponDescription = createLabel(
		weaponCard,
		"Description",
		FIREBALL.Description,
		Enum.Font.Gotham,
		12,
		COLORS.Muted
	)
	weaponDescription.Position = UDim2.fromOffset(106, 53)
	weaponDescription.Size = UDim2.new(1, -122, 0, 32)
	weaponDescription.TextWrapped = true

	local weaponState = createLabel(weaponCard, "State", "EQUIPEE", Enum.Font.GothamBold, 11, Color3.fromRGB(104, 239, 145))
	weaponState.Position = UDim2.fromOffset(16, 110)
	weaponState.Size = UDim2.new(1, -32, 0, 18)

	local skinsPanel = Instance.new("Frame")
	skinsPanel.Name = "SkinsPanel"
	skinsPanel.AnchorPoint = Vector2.new(1, 0)
	skinsPanel.Position = UDim2.new(1, 0, 0, 0)
	skinsPanel.Size = UDim2.new(0.42, -6, 1, 0)
	skinsPanel.BackgroundColor3 = COLORS.Card
	skinsPanel.BackgroundTransparency = 0.14
	skinsPanel.BorderSizePixel = 0
	skinsPanel.Parent = split
	addCorner(skinsPanel, 8)
	addStroke(skinsPanel, Color3.fromRGB(180, 91, 255), 0.28, 2)
	UiTheme.AddSurfaceFinish(skinsPanel, {
		Accent = Color3.fromRGB(180, 91, 255),
		Intensity = 0.4,
	})

	local skinsTitle = createLabel(skinsPanel, "Title", "SKINS DE PROJECTILE", Enum.Font.GothamBlack, 12, COLORS.Text)
	skinsTitle.Position = UDim2.fromOffset(12, 12)
	skinsTitle.Size = UDim2.new(1, -24, 0, 18)

	local selectedLabel = createLabel(skinsPanel, "Selected", "", Enum.Font.GothamBold, 10, Color3.fromRGB(224, 171, 255))
	selectedLabel.Position = UDim2.fromOffset(12, 31)
	selectedLabel.Size = UDim2.new(1, -24, 0, 16)
	selectedLabel.TextTruncate = Enum.TextTruncate.AtEnd

	local skinsList = Instance.new("Frame")
	skinsList.Name = "SkinsList"
	skinsList.Position = UDim2.fromOffset(12, 54)
	skinsList.Size = UDim2.new(1, -24, 1, -66)
	skinsList.BackgroundTransparency = 1
	skinsList.BorderSizePixel = 0
	skinsList.Parent = skinsPanel

	local skinsLayout = Instance.new("UIListLayout")
	skinsLayout.Padding = UDim.new(0, 7)
	skinsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	skinsLayout.Parent = skinsList

	local skinButtons: {[string]: TextButton} = {}

	local function refreshSelection()
		for _, skin in ipairs(FIREBALL_SKINS) do
			local button = skinButtons[skin.Id]

			if button ~= nil then
				local isSelected = skin.Id == selectedFireballSkinId
				button.BackgroundColor3 = if isSelected then Color3.fromRGB(55, 42, 76) else COLORS.Dark
				button.BackgroundTransparency = if isSelected then 0.04 else 0.2
			end
		end

		for _, skin in ipairs(FIREBALL_SKINS) do
			if skin.Id == selectedFireballSkinId then
				selectedLabel.Text = "ACTIF : " .. string.upper(skin.Name)
				return
			end
		end
	end

	for index, skin in ipairs(FIREBALL_SKINS) do
		local button = Instance.new("TextButton")
		button.Name = skin.Id
		button.LayoutOrder = index
		button.Size = UDim2.new(1, 0, 0, 67)
		button.BackgroundColor3 = COLORS.Dark
		button.BackgroundTransparency = 0.2
		button.BorderSizePixel = 0
		button.AutoButtonColor = false
		button.Text = ""
		button.Parent = skinsList
		addCorner(button, 6)
		addStroke(button, Color3.fromRGB(180, 91, 255), 0.48, 1)

		local icon = Instance.new("ImageLabel")
		icon.Name = "Icon"
		icon.Position = UDim2.fromOffset(8, 8)
		icon.Size = UDim2.fromOffset(50, 50)
		icon.BackgroundTransparency = 1
		icon.Image = skin.Image
		icon.ScaleType = Enum.ScaleType.Fit
		icon.Parent = button

		local name = createLabel(button, "Name", string.upper(skin.Name), Enum.Font.GothamBold, 11, COLORS.Text)
		name.Position = UDim2.fromOffset(65, 10)
		name.Size = UDim2.new(1, -74, 0, 16)
		name.TextTruncate = Enum.TextTruncate.AtEnd

		local description = createLabel(button, "Description", skin.Description, Enum.Font.Gotham, 9, COLORS.Muted)
		description.Position = UDim2.fromOffset(65, 27)
		description.Size = UDim2.new(1, -74, 0, 27)
		description.TextWrapped = true
		description.TextYAlignment = Enum.TextYAlignment.Top

		button.Activated:Connect(function()
			selectedFireballSkinId = skin.Id
			refreshSelection()

			local remote = selectFireballSkinRemote

			if remote ~= nil then
				remote:FireServer(skin.Id)
			end
		end)
		skinButtons[skin.Id] = button
	end

	content.CanvasSize = UDim2.fromOffset(0, 220)
	refreshSelection()
end

local function renderTab(
	content: ScrollingFrame,
	tab: TabData,
	accent: Color3
): UIGridLayout?
	content:ClearAllChildren()
	content.CanvasPosition = Vector2.zero

	if tab.Id == "Weapons" then
		createWeaponTab(content, accent)
		return nil
	end

	if tab.Layout == "Grid" then
		local layout = Instance.new("UIGridLayout")
		layout.Name = "GridLayout"
		layout.CellPadding = UDim2.fromOffset(12, 12)
		layout.CellSize = UDim2.fromOffset(156, 156)
		layout.FillDirectionMaxCells = 3
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = content

		for index, entry in tab.Entries do
			createGridCard(content, entry, accent, index)
		end

		bindCanvasSize(content, layout)
		return layout
	elseif tab.Layout == "List" then
		local layout = Instance.new("UIListLayout")
		layout.Name = "ListLayout"
		layout.Padding = UDim.new(0, 10)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = content

		for index, entry in tab.Entries do
			createListCard(content, entry, accent, index)
		end

		bindCanvasSize(content, layout)
		return nil
	else
		createProfileCard(content, tab.Entries, accent)
		content.CanvasSize = UDim2.fromOffset(0, 264)
		return nil
	end
end

local function createPanel(definition: PanelData)
	local previousPanel = menus:FindFirstChild(definition.Name)

	if previousPanel then
		previousPanel:Destroy()
	end

	local panel = Instance.new("Frame")
	panel.Name = definition.Name
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(0.62, 0, 0.7, 0)
	panel.BackgroundColor3 = COLORS.Panel
	panel.BackgroundTransparency = 0.2
	panel.BorderSizePixel = 0
	panel.ClipsDescendants = false
	panel.Visible = false
	panel.Parent = menus
	addCorner(panel, 10)
	addStroke(panel, COLORS.Dark, 0.04, 5)
	addStroke(panel, definition.Accent, 0.38, 1)

	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, COLORS.PanelTop),
		ColorSequenceKeypoint.new(0.3, COLORS.Panel),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(10, 17, 26)),
	})
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 0.34),
	})
	gradient.Parent = panel
	UiTheme.AddSurfaceFinish(panel, {
		Accent = definition.Accent,
		Intensity = 0.7,
	})

	local sizeConstraint = Instance.new("UISizeConstraint")
	sizeConstraint.MinSize = Vector2.new(320, 330)
	sizeConstraint.MaxSize = Vector2.new(980, 620)
	sizeConstraint.Parent = panel

	local titleGemOuter = Instance.new("Frame")
	titleGemOuter.Name = "TitleGemOuter"
	titleGemOuter.AnchorPoint = Vector2.new(0.5, 0.5)
	titleGemOuter.Position = UDim2.new(0.5, 0, 0, 0)
	titleGemOuter.Size = UDim2.fromOffset(34, 34)
	titleGemOuter.BackgroundColor3 = COLORS.Dark
	titleGemOuter.BorderSizePixel = 0
	titleGemOuter.Rotation = 45
	titleGemOuter.ZIndex = 5
	titleGemOuter.Parent = panel
	addCorner(titleGemOuter, 5)
	addStroke(titleGemOuter, definition.Accent, 0.12, 2)

	local titleGem = Instance.new("Frame")
	titleGem.Name = "TitleGem"
	titleGem.AnchorPoint = Vector2.new(0.5, 0.5)
	titleGem.Position = UDim2.fromScale(0.5, 0.5)
	titleGem.Size = UDim2.fromOffset(18, 18)
	titleGem.BackgroundColor3 = definition.Accent
	titleGem.BorderSizePixel = 0
	titleGem.Rotation = 45
	titleGem.ZIndex = 6
	titleGem.Parent = titleGemOuter
	addCorner(titleGem, 3)

	local header = Instance.new("Frame")
	header.Name = "Header"
	header.Size = UDim2.new(1, 0, 0, 84)
	header.BackgroundColor3 = COLORS.PanelTop
	header.BackgroundTransparency = 0.36
	header.BorderSizePixel = 0
	header.Parent = panel
	addCorner(header, 10)

	local title = createLabel(header, "Title", definition.Title, Enum.Font.GothamBlack, 27, COLORS.Text)
	title.Position = UDim2.new(0, 26, 0, 22)
	title.Size = UDim2.new(1, -96, 0, 28)
	title.TextXAlignment = Enum.TextXAlignment.Center

	local subtitle = createLabel(header, "Subtitle", definition.Subtitle, Enum.Font.GothamBold, 11, definition.Accent)
	subtitle.Position = UDim2.new(0, 26, 0, 52)
	subtitle.Size = UDim2.new(1, -96, 0, 18)
	subtitle.TextXAlignment = Enum.TextXAlignment.Center

	local closeButton = Instance.new("TextButton")
	closeButton.Name = "CloseButton"
	closeButton.AnchorPoint = Vector2.new(1, 0.5)
	closeButton.Position = UDim2.new(1, -18, 0.5, 0)
	closeButton.Size = UDim2.fromOffset(34, 34)
	closeButton.BackgroundColor3 = COLORS.Dark
	closeButton.BackgroundTransparency = 0.14
	closeButton.BorderSizePixel = 0
	closeButton.AutoButtonColor = true
	closeButton.Font = Enum.Font.GothamBold
	closeButton.Text = "X"
	closeButton.TextColor3 = COLORS.Text
	closeButton.TextSize = 17
	closeButton.Parent = header
	addCorner(closeButton, 5)
	addStroke(closeButton, definition.Accent, 0.42, 1)
	closeButton.Activated:Connect(requestClose)

	local divider = Instance.new("Frame")
	divider.Name = "Divider"
	divider.Position = UDim2.new(0, 22, 0, 92)
	divider.Size = UDim2.new(1, -44, 0, 1)
	divider.BackgroundColor3 = definition.Accent
	divider.BackgroundTransparency = 0.62
	divider.BorderSizePixel = 0
	divider.Parent = panel

	local tabsFrame = Instance.new("ScrollingFrame")
	tabsFrame.Name = "Tabs"
	tabsFrame.Position = UDim2.new(0, 22, 0, 105)
	tabsFrame.Size = UDim2.new(1, -44, 0, 34)
	tabsFrame.BackgroundTransparency = 1
	tabsFrame.BorderSizePixel = 0
	tabsFrame.CanvasSize = UDim2.fromOffset(0, 0)
	tabsFrame.ScrollBarThickness = 0
	tabsFrame.ScrollingDirection = Enum.ScrollingDirection.X
	tabsFrame.Parent = panel

	local tabsLayout = Instance.new("UIListLayout")
	tabsLayout.FillDirection = Enum.FillDirection.Horizontal
	tabsLayout.Padding = UDim.new(0, 8)
	tabsLayout.SortOrder = Enum.SortOrder.LayoutOrder
	tabsLayout.Parent = tabsFrame

	local content = Instance.new("ScrollingFrame")
	content.Name = "Content"
	content.Position = UDim2.new(0, 22, 0, 153)
	content.Size = UDim2.new(1, -44, 1, -194)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.CanvasSize = UDim2.fromOffset(0, 0)
	content.ScrollBarThickness = 4
	content.ScrollBarImageColor3 = definition.Accent
	content.ScrollBarImageTransparency = 0.3
	content.ScrollingDirection = Enum.ScrollingDirection.Y
	content.Parent = panel

	local footer = createLabel(panel, "Footer", "PLACEHOLDERS - CONTENU EN PREPARATION", Enum.Font.GothamBold, 10, COLORS.Muted)
	footer.AnchorPoint = Vector2.new(0.5, 1)
	footer.Position = UDim2.new(0.5, 0, 1, -10)
	footer.Size = UDim2.new(1, -44, 0, 15)
	footer.TextXAlignment = Enum.TextXAlignment.Center

	local currentTab = definition.Tabs[1]
	local tabButtons: {[string]: TextButton} = {}
	local activeGridLayout: UIGridLayout? = nil

	local function updateGridSize()
		if activeGridLayout == nil or activeGridLayout.Parent == nil then
			return
		end

		local width = content.AbsoluteSize.X

		if width <= 0 then
			return
		end

		local cellSize = math.floor(math.clamp((width - 24) / 3, 108, 196))
		activeGridLayout.CellSize = UDim2.fromOffset(cellSize, cellSize)
	end

	content:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateGridSize)

	local function refreshTabs()
		for _, tab in definition.Tabs do
			local button = tabButtons[tab.Id]

			if button then
				local isSelected = currentTab.Id == tab.Id
				button.BackgroundColor3 = if isSelected then definition.Accent else COLORS.Dark
				button.BackgroundTransparency = if isSelected then 0.72 else 0.32
				button.TextColor3 = if isSelected then COLORS.Text else COLORS.Muted
			end
		end
	end

	local function selectTab(tab: TabData)
		currentTab = tab
		activeGridLayout = renderTab(content, tab, definition.Accent)
		updateGridSize()
		refreshTabs()
	end

	for index, tab in definition.Tabs do
		local button = Instance.new("TextButton")
		button.Name = tab.Id .. "Tab"
		button.LayoutOrder = index
		button.Size = UDim2.fromOffset(math.max(112, #tab.Label * 8 + 26), 32)
		button.BackgroundColor3 = COLORS.Dark
		button.BackgroundTransparency = 0.32
		button.BorderSizePixel = 0
		button.AutoButtonColor = true
		button.Font = Enum.Font.GothamBold
		button.Text = tab.Label
		button.TextColor3 = COLORS.Muted
		button.TextSize = 11
		button.TextTruncate = Enum.TextTruncate.AtEnd
		button.Parent = tabsFrame
		addCorner(button, 5)
		addStroke(button, definition.Accent, 0.55, 1)
		button.Activated:Connect(function()
			selectTab(tab)
		end)
		tabButtons[tab.Id] = button
	end

	local function updateTabsCanvas()
		tabsFrame.CanvasSize = UDim2.fromOffset(tabsLayout.AbsoluteContentSize.X, 0)
	end

	tabsLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(updateTabsCanvas)
	updateTabsCanvas()
	selectTab(currentTab)
end

for _, definition in PANELS do
	createPanel(definition)
end

local function bindShortcutMenu()
	local shortcutMenu = playerGui:WaitForChild("LobbyShortcutMenu", 10)

	if shortcutMenu == nil then
		return
	end

	local menuSelected = shortcutMenu:FindFirstChild("MenuSelected")

	if menuSelected == nil or not menuSelected:IsA("BindableEvent") then
		return
	end

	menuSelected.Event:Connect(function(action: string, menuId: string)
		if action == "Opened" then
			for _, definition in PANELS do
				if definition.Id == menuId then
					setVisiblePanel(definition.Name)
					return
				end
			end
		else
			setVisiblePanel(nil)
		end
	end)
end

local cameraConnection: RBXScriptConnection? = nil

local function updateResponsivePanels()
	local camera = Workspace.CurrentCamera

	if camera == nil then
		return
	end

	local viewport = camera.ViewportSize
	local isCompact = viewport.X < 900 or viewport.Y < 620

	for _, definition in PANELS do
		local panel = menus:FindFirstChild(definition.Name)

		if panel and panel:IsA("Frame") then
			if isCompact then
				panel.AnchorPoint = Vector2.new(0.5, 0.5)
				panel.Position = UDim2.fromScale(0.5, 0.5)
				panel.Size = UDim2.new(0.88, 0, 0.74, 0)
			else
				panel.AnchorPoint = Vector2.new(0.5, 0.5)
				panel.Position = UDim2.fromScale(0.5, 0.5)
				panel.Size = UDim2.new(0.62, 0, 0.7, 0)
			end
		end
	end
end

local function bindCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end

	local camera = Workspace.CurrentCamera

	if camera == nil then
		return
	end

	updateResponsivePanels()
	cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(
		updateResponsivePanels
	)
end

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)

task.spawn(bindShortcutMenu)
bindCamera()
setVisiblePanel(nil)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="131">
          <Properties>
            <string name="Name">LobbyShortcutMenu</string>
            <string name="Source"><![CDATA[--!strict

-- StarterPlayer/StarterPlayerScripts/LobbyShortcutMenu.client.lua

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local UiTheme = require(Shared:WaitForChild("UiTheme"))

--==================================================
-- CONFIGURATION
--==================================================

type ButtonData = {
	Id: string,
	Label: string,
	PanelName: string,
	Image: string,
	Accent: Color3,
	KeyCode: Enum.KeyCode,
}

local BUTTONS: {ButtonData} = {
	{
		Id = "Shop",
		Label = "BOUTIQUE",
		PanelName = "ShopPanel",

		-- Remplace 0 par l'ID de ton icône PNG transparente.
		Image = "rbxassetid://105785484806067",

		Accent = Color3.fromRGB(255, 196, 54),
		KeyCode = Enum.KeyCode.One,
	},

	{
		Id = "Quests",
		Label = "QUETES",
		PanelName = "QuestsPanel",

		Image = "rbxassetid://103279732475381",

		Accent = Color3.fromRGB(68, 210, 255),
		KeyCode = Enum.KeyCode.Two,
	},

	{
		Id = "Unlocks",
		Label = "DEBLOCAGES",
		PanelName = "UnlocksPanel",

		Image = "rbxassetid://116965784565243",

		Accent = Color3.fromRGB(184, 90, 255),
		KeyCode = Enum.KeyCode.Three,
	},

	{
		Id = "Housing",
		Label = "REFUGE",
		PanelName = "HousingPanel",

		Image = "rbxassetid://131445292729637",

		Accent = Color3.fromRGB(76, 239, 137),
		KeyCode = Enum.KeyCode.Four,
	},
}

local BUTTON_WIDTH = 150
local BUTTON_HEIGHT = 112
local ICON_SIZE = 84
local BUTTON_SPACING = 4

local NORMAL_SCALE = 1
local HOVER_SCALE = 1.12
local SELECTED_SCALE = 1.08

-- Police proche de celle de ta DA actuelle.
local BUTTON_FONT = Font.fromEnum(UiTheme.Fonts.Bold)

local TWEEN_FAST = TweenInfo.new(
	0.12,
	Enum.EasingStyle.Quad,
	Enum.EasingDirection.Out
)

local TWEEN_NORMAL = TweenInfo.new(
	0.18,
	Enum.EasingStyle.Back,
	Enum.EasingDirection.Out
)

--==================================================
-- NETTOYAGE
--==================================================

local oldGui = playerGui:FindFirstChild("LobbyShortcutMenu")

if oldGui then
	oldGui:Destroy()
end

--==================================================
-- INTERFACE PRINCIPALE
--==================================================

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "LobbyShortcutMenu"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = false
screenGui.DisplayOrder = 40
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

-- Permet à d'autres LocalScripts d'écouter les sélections.
local menuSelectedEvent = Instance.new("BindableEvent")
menuSelectedEvent.Name = "MenuSelected"
menuSelectedEvent.Parent = screenGui

local closeRequestedEvent = Instance.new("BindableEvent")
closeRequestedEvent.Name = "CloseRequested"
closeRequestedEvent.Parent = screenGui

local container = Instance.new("Frame")
container.Name = "ShortcutContainer"
container.AnchorPoint = Vector2.new(0, 0.5)
container.Position = UDim2.new(0, 26, 0.5, 0)
container.Size = UDim2.fromOffset(
	BUTTON_WIDTH,
	(#BUTTONS * BUTTON_HEIGHT)
		+ ((#BUTTONS - 1) * BUTTON_SPACING)
)
container.BackgroundTransparency = 1
container.BorderSizePixel = 0
container.ClipsDescendants = false
container.Parent = screenGui

local responsiveScale = Instance.new("UIScale")
responsiveScale.Name = "ResponsiveScale"
responsiveScale.Scale = 1
responsiveScale.Parent = container

local listLayout = Instance.new("UIListLayout")
listLayout.FillDirection = Enum.FillDirection.Vertical
listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
listLayout.VerticalAlignment = Enum.VerticalAlignment.Center
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Padding = UDim.new(0, BUTTON_SPACING)
listLayout.Parent = container

--==================================================
-- TYPES ET ÉTAT
--==================================================

type ButtonReference = {
	Data: ButtonData,
	Button: ImageButton,
	Scale: UIScale,
	IconGroup: Frame,
	Icon: ImageLabel,
	Shadow: ImageLabel,
	Glow: ImageLabel,
	Label: TextLabel,
	Marker: Frame,
	Hovered: boolean,
}

local references: {[string]: ButtonReference} = {}
local keyBindings: {[Enum.KeyCode]: string} = {}

local selectedId: string? = nil
local isRunActive = player:GetAttribute("IsRunActive") == true

--==================================================
-- OUTILS
--==================================================

local function tween(
	instance: Instance,
	tweenInfo: TweenInfo,
	properties: {[string]: any}
)
	TweenService:Create(
		instance,
		tweenInfo,
		properties
	):Play()
end

local createCorner = UiTheme.AddCorner

local function getMenusGui(): ScreenGui?
	local menus = playerGui:FindFirstChild("Menus")

	if menus and menus:IsA("ScreenGui") then
		return menus
	end

	return nil
end

local function findPanel(
	panelName: string
): GuiObject?

	local menus = getMenusGui()

	if not menus then
		return nil
	end

	local panel = menus:FindFirstChild(
		panelName,
		true
	)

	if panel and panel:IsA("GuiObject") then
		return panel
	end

	return nil
end

local function updatePanels(
	targetId: string?
)
	local menus = getMenusGui()

	if not menus then
		return
	end

	for _, data in BUTTONS do
		local panel = findPanel(data.PanelName)

		if panel then
			panel.Visible = targetId == data.Id
		end
	end
end

--==================================================
-- ÉTATS VISUELS
--==================================================

local function updateVisual(
	menuId: string
)
	local reference = references[menuId]

	if not reference then
		return
	end

	local isSelected = selectedId == menuId

	if isSelected then
		tween(
			reference.Scale,
			TWEEN_NORMAL,
			{
				Scale = SELECTED_SCALE,
			}
		)

		tween(
			reference.IconGroup,
			TWEEN_NORMAL,
			{
				Rotation = -2,
			}
		)

		tween(
			reference.Glow,
			TWEEN_FAST,
			{
				ImageTransparency = 0.42,
				Size = UDim2.fromOffset(
					ICON_SIZE + 18,
					ICON_SIZE + 18
				),
			}
		)

		tween(
			reference.Shadow,
			TWEEN_FAST,
			{
				ImageTransparency = 0.08,
			}
		)

		tween(
			reference.Label,
			TWEEN_FAST,
			{
				TextColor3 = reference.Data.Accent,
			}
		)

		tween(
			reference.Marker,
			TWEEN_FAST,
			{
				BackgroundTransparency = 0,
				Size = UDim2.fromOffset(4, 42),
			}
		)

	elseif reference.Hovered then
		tween(
			reference.Scale,
			TWEEN_NORMAL,
			{
				Scale = HOVER_SCALE,
			}
		)

		tween(
			reference.IconGroup,
			TWEEN_NORMAL,
			{
				Rotation = 3,
			}
		)

		tween(
			reference.Glow,
			TWEEN_FAST,
			{
				ImageTransparency = 0.58,
				Size = UDim2.fromOffset(
					ICON_SIZE + 12,
					ICON_SIZE + 12
				),
			}
		)

		tween(
			reference.Shadow,
			TWEEN_FAST,
			{
				ImageTransparency = 0.12,
			}
		)

		tween(
			reference.Label,
			TWEEN_FAST,
			{
				TextColor3 = Color3.fromRGB(
					255,
					255,
					255
				),
			}
		)

		tween(
			reference.Marker,
			TWEEN_FAST,
			{
				BackgroundTransparency = 0.45,
				Size = UDim2.fromOffset(3, 28),
			}
		)

	else
		tween(
			reference.Scale,
			TWEEN_FAST,
			{
				Scale = NORMAL_SCALE,
			}
		)

		tween(
			reference.IconGroup,
			TWEEN_FAST,
			{
				Rotation = 0,
			}
		)

		tween(
			reference.Glow,
			TWEEN_FAST,
			{
				ImageTransparency = 1,
				Size = UDim2.fromOffset(
					ICON_SIZE,
					ICON_SIZE
				),
			}
		)

		tween(
			reference.Shadow,
			TWEEN_FAST,
			{
				ImageTransparency = 0.2,
			}
		)

		tween(
			reference.Label,
			TWEEN_FAST,
			{
				TextColor3 = Color3.fromRGB(
					245,
					245,
					249
				),
			}
		)

		tween(
			reference.Marker,
			TWEEN_FAST,
			{
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(3, 16),
			}
		)
	end
end

local function refreshAllVisuals()
	for menuId in references do
		updateVisual(menuId)
	end
end

--==================================================
-- SÉLECTION
--==================================================

local function selectMenu(
	menuId: string
)
	if isRunActive then
		return
	end

	local reference = references[menuId]

	if not reference then
		return
	end

	if selectedId == menuId then
		selectedId = nil

		updatePanels(nil)
		refreshAllVisuals()

		menuSelectedEvent:Fire(
			"Closed",
			menuId
		)

		return
	end

	selectedId = menuId

	updatePanels(menuId)
	refreshAllVisuals()

	-- Petit effet d'appui.
	reference.Scale.Scale = 0.94

	tween(
		reference.Scale,
		TWEEN_NORMAL,
		{
			Scale = SELECTED_SCALE,
		}
	)

	menuSelectedEvent:Fire(
		"Opened",
		menuId
	)
end

--==================================================
-- CRÉATION D'UN RACCOURCI
--==================================================

local function createShortcut(
	data: ButtonData,
	layoutOrder: number
)
	-- L'ImageButton est invisible :
	-- il sert seulement de zone cliquable.
	local button = Instance.new("ImageButton")
	button.Name = data.Id .. "Button"
	button.LayoutOrder = layoutOrder
	button.Size = UDim2.fromOffset(
		BUTTON_WIDTH,
		BUTTON_HEIGHT
	)
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.Image = ""
	button.AutoButtonColor = false
	button.ClipsDescendants = false
	button.Selectable = true
	button.Parent = container

	local buttonScale = Instance.new("UIScale")
	buttonScale.Name = "HoverScale"
	buttonScale.Scale = NORMAL_SCALE
	buttonScale.Parent = button

	-- Petit marqueur latéral de la DA actuelle.
	-- Ce n'est pas un fond de bouton.
	local marker = Instance.new("Frame")
	marker.Name = "SelectionMarker"
	marker.AnchorPoint = Vector2.new(0, 0.5)
	marker.Position = UDim2.new(0, 1, 0.5, -4)
	marker.Size = UDim2.fromOffset(3, 16)
	marker.BackgroundColor3 = data.Accent
	marker.BackgroundTransparency = 1
	marker.BorderSizePixel = 0
	marker.ZIndex = 8
	marker.Parent = button

	createCorner(marker, 4)

	-- Groupe qui contient uniquement l'icône.
	local iconGroup = Instance.new("Frame")
	iconGroup.Name = "IconGroup"
	iconGroup.AnchorPoint = Vector2.new(0.5, 0)
	iconGroup.Position = UDim2.new(0.5, 0, 0, 0)
	iconGroup.Size = UDim2.fromOffset(
	ICON_SIZE + 24,
	ICON_SIZE + 12
	)
	iconGroup.BackgroundTransparency = 1
	iconGroup.BorderSizePixel = 0
	iconGroup.ClipsDescendants = false
	iconGroup.ZIndex = 2
	iconGroup.Parent = button

	-- Lueur qui reprend exactement la silhouette du PNG.
	local glow = Instance.new("ImageLabel")
	glow.Name = "Glow"
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Position = UDim2.fromScale(0.5, 0.5)
	glow.Size = UDim2.fromOffset(
		ICON_SIZE,
		ICON_SIZE
	)
	glow.BackgroundTransparency = 1
	glow.BorderSizePixel = 0
	glow.Image = data.Image
	glow.ImageColor3 = data.Accent
	glow.ImageTransparency = 1
	glow.ScaleType = Enum.ScaleType.Fit
	glow.ZIndex = 1
	glow.Parent = iconGroup

	-- Ombre détourée sous l'icône.
	local shadow = Instance.new("ImageLabel")
	shadow.Name = "Shadow"
	shadow.AnchorPoint = Vector2.new(0.5, 0.5)
	shadow.Position = UDim2.new(
		0.5,
		3,
		0.5,
		4
	)
	shadow.Size = UDim2.fromOffset(
		ICON_SIZE,
		ICON_SIZE
	)
	shadow.BackgroundTransparency = 1
	shadow.BorderSizePixel = 0
	shadow.Image = data.Image
	shadow.ImageColor3 = Color3.fromRGB(0, 0, 0)
	shadow.ImageTransparency = 0.2
	shadow.ScaleType = Enum.ScaleType.Fit
	shadow.ZIndex = 2
	shadow.Parent = iconGroup

	-- Icône principale.
	local icon = Instance.new("ImageLabel")
	icon.Name = "Icon"
	icon.AnchorPoint = Vector2.new(0.5, 0.5)
	icon.Position = UDim2.fromScale(0.5, 0.5)
	icon.Size = UDim2.fromOffset(
		ICON_SIZE,
		ICON_SIZE
	)
	icon.BackgroundTransparency = 1
	icon.BorderSizePixel = 0
	icon.Image = data.Image
	icon.ImageColor3 = Color3.fromRGB(
		255,
		255,
		255
	)
	icon.ImageTransparency = 0
	icon.ScaleType = Enum.ScaleType.Fit
	icon.ZIndex = 3
	icon.Parent = iconGroup

	-- Nom sous l'icône.
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.AnchorPoint = Vector2.new(0.5, 1)
	label.Position = UDim2.new(0.5, 0, 1, 0)
	label.Size = UDim2.new(1, 0, 0, 27)
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Text = data.Label
	label.TextColor3 = Color3.fromRGB(
		245,
		245,
		249
	)
	label.TextSize = 16
	label.FontFace = BUTTON_FONT
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.TextWrapped = false
	label.TextTruncate = Enum.TextTruncate.None

	-- Contour noir semblable aux boutons Roblox de référence.
	label.TextStrokeColor3 = Color3.fromRGB(
		6,
		7,
		10
	)
	label.TextStrokeTransparency = 0
	label.ZIndex = 5
	label.Parent = button

	local textConstraint = Instance.new(
		"UITextSizeConstraint"
	)
	textConstraint.MinTextSize = 12
	textConstraint.MaxTextSize = 17
	textConstraint.Parent = label

	local reference: ButtonReference = {
		Data = data,
		Button = button,
		Scale = buttonScale,
		IconGroup = iconGroup,
		Icon = icon,
		Shadow = shadow,
		Glow = glow,
		Label = label,
		Marker = marker,
		Hovered = false,
	}

	references[data.Id] = reference
	keyBindings[data.KeyCode] = data.Id

	button.MouseEnter:Connect(function()
		reference.Hovered = true
		updateVisual(data.Id)
	end)

	button.MouseLeave:Connect(function()
		reference.Hovered = false
		updateVisual(data.Id)
	end)

	button.SelectionGained:Connect(function()
		reference.Hovered = true
		updateVisual(data.Id)
	end)

	button.SelectionLost:Connect(function()
		reference.Hovered = false
		updateVisual(data.Id)
	end)

	button.Activated:Connect(function()
		selectMenu(data.Id)
	end)
end

--==================================================
-- CRÉATION DES QUATRE BOUTONS
--==================================================

for index, data in BUTTONS do
	createShortcut(data, index)
end

--==================================================
-- RACCOURCIS CLAVIER 1 À 4
--==================================================

UserInputService.InputBegan:Connect(function(
	input: InputObject,
	gameProcessed: boolean
)
	if gameProcessed then
		return
	end

	if isRunActive then
		return
	end

	if UserInputService:GetFocusedTextBox() then
		return
	end

	if input.KeyCode == Enum.KeyCode.Escape and selectedId ~= nil then
		selectMenu(selectedId)
		return
	end

	local menuId = keyBindings[input.KeyCode]

	if menuId then
		selectMenu(menuId)
	end
end)

--==================================================
-- ADAPTATION À LA RÉSOLUTION
--==================================================

local cameraConnection: RBXScriptConnection? = nil

local function updateResponsiveScale()
	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	local viewport = camera.ViewportSize

	local widthRatio = viewport.X / 1280
	local heightRatio = viewport.Y / 720

	responsiveScale.Scale = math.clamp(
		math.min(widthRatio, heightRatio),
		0.48,
		1.08
	)
end

local function bindCamera()
	if cameraConnection then
		cameraConnection:Disconnect()
		cameraConnection = nil
	end

	local camera = workspace.CurrentCamera

	if not camera then
		return
	end

	updateResponsiveScale()

	cameraConnection =
		camera:GetPropertyChangedSignal(
			"ViewportSize"
		):Connect(updateResponsiveScale)
end

bindCamera()

workspace:GetPropertyChangedSignal(
	"CurrentCamera"
):Connect(bindCamera)

local function setRunActive(nextIsRunActive: boolean)
	isRunActive = nextIsRunActive
	screenGui.Enabled = not isRunActive

	if isRunActive and selectedId ~= nil then
		selectedId = nil
		updatePanels(nil)
		refreshAllVisuals()
	end
end

local function bindRunStateRemote()
	local remote = ReplicatedStorage:WaitForChild("Run_StateUpdate", 20)

	if remote == nil or not remote:IsA("RemoteEvent") then
		return
	end

	remote.OnClientEvent:Connect(function(payload)
		payload = payload or {}
		setRunActive(payload.IsRunActive == true)
	end)
end

player:GetAttributeChangedSignal("IsRunActive"):Connect(function()
	setRunActive(player:GetAttribute("IsRunActive") == true)
end)

closeRequestedEvent.Event:Connect(function()
	if selectedId ~= nil then
		selectMenu(selectedId)
	end
end)

task.spawn(bindRunStateRemote)
setRunActive(isRunActive)
refreshAllVisuals()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="132">
          <Properties>
            <string name="Name">MetaProgressionUI</string>
            <string name="Source"><![CDATA[--!strict

-- Alimente les panneaux lobby existants avec les donnees serveur persistantes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local menus = playerGui:WaitForChild("Menus")
local getStateRemote = ReplicatedStorage:WaitForChild("MetaProgression_GetState") :: RemoteFunction
local updateStateRemote = ReplicatedStorage:WaitForChild("MetaProgression_Update") :: RemoteEvent

local latestState: {[string]: any}? = nil

local function formatNumber(value: any): string
	return string.format("%d", math.max(0, math.floor(tonumber(value) or 0)))
end

local function formatProgress(entry: {[string]: any}): string
	return string.format("%s / %s", formatNumber(entry.Progress), formatNumber(entry.Target))
end

local function updateValueForTitle(panelName: string, titleText: string, valueText: string)
	local panel = menus:FindFirstChild(panelName)

	if panel == nil then
		return
	end

	for _, descendant in ipairs(panel:GetDescendants()) do
		if descendant:IsA("Frame") then
			local title = descendant:FindFirstChild("Title")
			local value = descendant:FindFirstChild("Value")

			if title ~= nil
				and value ~= nil
				and title:IsA("TextLabel")
				and value:IsA("TextLabel")
				and title.Text == titleText
			then
				value.Text = valueText
			end
		end
	end
end

local function updateEntries(panelName: string, entries: {any})
	for _, entry in ipairs(entries) do
		local suffix = if entry.Completed == true then "TERMINE" else formatProgress(entry)
		updateValueForTitle(panelName, tostring(entry.Label), suffix)
	end
end

local function applyState(state: {[string]: any})
	latestState = state
	local stats = state.Stats or {}

	updateEntries("QuestsPanel", state.Quests or {})
	updateEntries("QuestsPanel", state.DailyQuests or {})
	updateEntries("HousingPanel", state.Achievements or {})
	updateValueForTitle("HousingPanel", "RUNS TERMINEES", formatNumber(stats.RunsCompleted))
	updateValueForTitle("HousingPanel", "MONSTRES ELIMINES", formatNumber(stats.TotalKills))
	updateValueForTitle("HousingPanel", "NIVEAUX VALIDES", formatNumber(stats.ChaptersValidated))
	updateValueForTitle("HousingPanel", "OR COLLECTE", formatNumber(stats.TotalCoinsEarned))
end

local function refreshFromServer(): boolean
	local success, state = pcall(function()
		return getStateRemote:InvokeServer()
	end)

	if success and typeof(state) == "table" then
		applyState(state)
		return true
	end

	return false
end

updateStateRemote.OnClientEvent:Connect(function(state)
	if typeof(state) == "table" then
		applyState(state)
	end
end)

menus.ChildAdded:Connect(function()
	if latestState ~= nil then
		task.defer(function()
			if latestState ~= nil then
				applyState(latestState)
			end
		end)
	end
end)

task.spawn(function()
	for _ = 1, 10 do
		if refreshFromServer() then
			return
		end

		task.wait(0.5)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="133">
          <Properties>
            <string name="Name">MiniMapUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local MiniMapConfig = require(Shared:WaitForChild("MiniMapConfig"))
local UiTemplateConfig = require(Shared:WaitForChild("UiTemplateConfig"))
local UiTheme = require(Shared:WaitForChild("UiTheme"))

local PRODUCTION_TEMPLATE_GUI_NAME = UiTemplateConfig.ProductionTemplateGuiName
local PRODUCTION_GUI_NAME = "MiniMapGui"
local PRODUCTION_DOCK_NAME = "MiniMapPanelV2"

type MarkerVisual = {
	Core: Frame,
	Glow: Frame,
}

local existingGui = playerGui:FindFirstChild(PRODUCTION_GUI_NAME)

if existingGui ~= nil then
	existingGui:Destroy()
end

local function addCorner(instance: GuiObject, radius: number)
	return UiTheme.AddCorner(instance, radius)
end

local function addStroke(instance: GuiObject, color: Color3, transparency: number, thickness: number)
	return UiTheme.AddStroke(instance, color, transparency, thickness)
end

local function getMiniMapTemplate(): Frame?
	local templateGui = StarterGui:FindFirstChild(PRODUCTION_TEMPLATE_GUI_NAME)
	local runCanvas = templateGui and templateGui:FindFirstChild("RunCanvas")
	local dock = runCanvas and runCanvas:FindFirstChild("MiniMapDock")

	if dock and dock:IsA("Frame") then
		return dock
	end

	DebugLog.Warn("UI", "Minimap V2 non initialisee, template introuvable", {
		ProductionTemplate = templateGui ~= nil,
		RunCanvas = runCanvas ~= nil,
		Template = dock ~= nil,
	})
	return nil
end

local template = getMiniMapTemplate()

if template == nil then
	return
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = PRODUCTION_GUI_NAME
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 26
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Enabled = true
screenGui.Parent = playerGui

local panel = template:Clone()
panel.Name = PRODUCTION_DOCK_NAME
panel.Visible = false
panel:SetAttribute("ProductionBound", true)
panel.Parent = screenGui

local content = panel:FindFirstChild("Content")
local mapArea = content and content:FindFirstChild("Radar")

if mapArea == nil or not mapArea:IsA("Frame") then
	DebugLog.Warn("UI", "Minimap V2 non initialisee, radar introuvable")
	screenGui:Destroy()
	return
end

-- Le template contient quelques points de demonstration. Ils ne doivent jamais
-- survivre dans une run : les seuls reperes visibles proviennent du runtime.
for _, markerName in ipairs({
	"PlayerGlow",
	"Player",
	"ShrineAGlow",
	"ShrineA",
	"ShrineBGlow",
	"ShrineB",
	"ChestAGlow",
	"ChestA",
	"ChestBGlow",
	"ChestB",
	"BossGlow",
	"Boss",
}) do
	local marker = mapArea:FindFirstChild(markerName)
	if marker then
		marker:Destroy()
	end
end

local markersFolder = Instance.new("Folder")
markersFolder.Name = "Markers"
markersFolder.Parent = mapArea

local markerByInstance: { [Instance]: MarkerVisual } = {}
local elapsedSinceUpdate = 0
local focusPosition: Vector3? = nil

-- La minimap reste orientee nord. Le joueur pivote au centre, mais ni la carte
-- ni les reperes ne tournent avec lui : c'est la convention la plus lisible ici.
local centralTargetRadiusRatio = 0.46

local function getInstancePosition(instance: Instance): Vector3?
	if instance:IsA("BasePart") then
		return instance.Position
	end

	if instance:IsA("Model") then
		return instance:GetPivot().Position
	end

	return nil
end

local function getMarkerStyle(runtimeFolderName: string, instance: Instance): Color3?
	if runtimeFolderName == "PortalsRuntime" then
		return MiniMapConfig.Colors.Portal
	end

	if runtimeFolderName == "ShrinesRuntime" then
		if instance:GetAttribute("ShrineActive") ~= true then
			return nil
		end

		local shrineType = instance:GetAttribute("ShrineType")

		if shrineType == "Magnet" then
			return MiniMapConfig.Colors.MagnetShrine
		end

		if shrineType == "EliteChallenge" then
			return MiniMapConfig.Colors.EliteShrine
		end

		return MiniMapConfig.Colors.PerkShrine
	end

	if runtimeFolderName == "ChestsRuntime" then
		return if instance:GetAttribute("ChestOpened") == true then nil else MiniMapConfig.Colors.Chest
	end

	if runtimeFolderName == "JarsRuntime" then
		return if instance:GetAttribute("JarBroken") == true then nil else MiniMapConfig.Colors.Jar
	end

	if runtimeFolderName == "TotemsRuntime" then
		return if instance:GetAttribute("TotemActivated") == true then nil else MiniMapConfig.Colors.Totem
	end

	return nil
end

local function createMarkerVisual(name: string, color: Color3, size: number, rotation: number): MarkerVisual
	local glow = Instance.new("Frame")
	glow.Name = name .. "Glow"
	glow.AnchorPoint = Vector2.new(0.5, 0.5)
	glow.Size = UDim2.fromOffset(size + 8, size + 8)
	glow.BackgroundColor3 = color
	glow.BackgroundTransparency = 0.84
	glow.BorderSizePixel = 0
	glow.Rotation = rotation
	glow.ZIndex = 16
	glow.Parent = markersFolder
	addCorner(glow, 999)

	local core = Instance.new("Frame")
	core.Name = name
	core.AnchorPoint = Vector2.new(0.5, 0.5)
	core.Size = UDim2.fromOffset(size, size)
	core.BackgroundColor3 = color
	core.BorderSizePixel = 0
	core.Rotation = rotation
	core.ZIndex = 17
	core.Parent = markersFolder
	addCorner(core, if rotation ~= 0 then 2 else 999)
	addStroke(core, Color3.fromRGB(245, 246, 255), 0.2, 1)

	return {
		Core = core,
		Glow = glow,
	}
end

local function setVisualVisible(visual: MarkerVisual, isVisible: boolean)
	visual.Core.Visible = isVisible
	visual.Glow.Visible = isVisible
end

local cardinalDirections = {
	N = Vector3.new(0, 0, -1),
	E = Vector3.new(1, 0, 0),
	S = Vector3.new(0, 0, 1),
	W = Vector3.new(-1, 0, 0),
}

local function updateCardinals()
	for labelName, worldDirection in pairs(cardinalDirections) do
		local label = mapArea:FindFirstChild(labelName)

		if label and label:IsA("TextLabel") then
			label.Visible = focusPosition ~= nil
			label.AnchorPoint = Vector2.new(0.5, 0.5)
			label.Position = UDim2.fromScale(
				0.5 + (worldDirection.X * 0.44),
				0.5 + (worldDirection.Z * 0.44)
			)
		end
	end
end

local function setMarkerPosition(visual: MarkerVisual, position: Vector3, isPlayer: boolean)
	if focusPosition == nil then
		setVisualVisible(visual, false)
		return
	end

	local x = 0.5
	local y = 0.5

	if not isPlayer then
		local deltaX = position.X - focusPosition.X
		local deltaZ = position.Z - focusPosition.Z
		local visibleRadius = math.max(1, MiniMapConfig.VisibleRadius)
		local targetRadius = visibleRadius * centralTargetRadiusRatio

		-- Les anneaux restent un repere de lecture. Seul le disque central affiche
		-- les cibles proches ; aucune icone n'est rabattue sur les anneaux externes.
		if (deltaX * deltaX) + (deltaZ * deltaZ) > targetRadius * targetRadius then
			setVisualVisible(visual, false)
			return
		end

		x += deltaX / (visibleRadius * 2)
		y += deltaZ / (visibleRadius * 2)
	end

	local horizontalPadding = math.min(0.44, MiniMapConfig.MarkerPadding / math.max(1, mapArea.AbsoluteSize.X))
	local verticalPadding = math.min(0.44, MiniMapConfig.MarkerPadding / math.max(1, mapArea.AbsoluteSize.Y))
	local markerPosition = UDim2.new(
		math.clamp(x, horizontalPadding, 1 - horizontalPadding),
		0,
		math.clamp(y, verticalPadding, 1 - verticalPadding),
		0
	)

	visual.Core.Position = markerPosition
	visual.Glow.Position = markerPosition
	setVisualVisible(visual, true)
end

local playerMarker = createMarkerVisual("Player", MiniMapConfig.Colors.Player, MiniMapConfig.PlayerMarkerSize, 45)
playerMarker.Core.BackgroundTransparency = 1

local playerStroke = playerMarker.Core:FindFirstChildOfClass("UIStroke")
if playerStroke then
	playerStroke:Destroy()
end

local playerPointer = Instance.new("TextLabel")
playerPointer.Name = "DirectionPointer"
playerPointer.AnchorPoint = Vector2.new(0.5, 0.5)
playerPointer.Position = UDim2.fromScale(0.5, 0.5)
playerPointer.Size = UDim2.fromOffset(MiniMapConfig.PlayerMarkerSize + 8, MiniMapConfig.PlayerMarkerSize + 8)
playerPointer.BackgroundTransparency = 1
playerPointer.Font = Enum.Font.GothamBlack
playerPointer.Text = utf8.char(0x25B2)
playerPointer.TextColor3 = MiniMapConfig.Colors.Player
playerPointer.TextStrokeColor3 = Color3.fromRGB(245, 246, 255)
playerPointer.TextStrokeTransparency = 0.32
playerPointer.TextSize = MiniMapConfig.PlayerMarkerSize + 8
playerPointer.ZIndex = playerMarker.Core.ZIndex + 1
playerPointer.Parent = playerMarker.Core

local function updatePlayerMarker()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if root == nil or not root:IsA("BasePart") then
		focusPosition = nil
		setVisualVisible(playerMarker, false)
		updateCardinals()
		return
	end

	local rawForward = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)

	if rawForward.Magnitude < 0.001 then
		focusPosition = nil
		setVisualVisible(playerMarker, false)
		updateCardinals()
		return
	end

	focusPosition = root.Position
	playerMarker.Core.Rotation = 0
	playerPointer.Rotation = math.deg(math.atan2(rawForward.X, -rawForward.Z))
	setMarkerPosition(playerMarker, root.Position, true)
	updateCardinals()
end

local function createMarker(instance: Instance, color: Color3): MarkerVisual
	local visual = createMarkerVisual("Marker", color, MiniMapConfig.MarkerSize, 0)
	markerByInstance[instance] = visual
	return visual
end

local function updateInteractableMarkers()
	local activeInstances: { [Instance]: boolean } = {}

	for _, runtimeFolderName in ipairs({ "PortalsRuntime", "ShrinesRuntime", "ChestsRuntime", "JarsRuntime", "TotemsRuntime" }) do
		local runtimeFolder = Workspace:FindFirstChild(runtimeFolderName)

		if runtimeFolder ~= nil then
			for _, instance in ipairs(runtimeFolder:GetChildren()) do
				local color = getMarkerStyle(runtimeFolderName, instance)
				local position = getInstancePosition(instance)

				if color ~= nil and position ~= nil then
					activeInstances[instance] = true
					local visual = markerByInstance[instance] or createMarker(instance, color)
					visual.Core.BackgroundColor3 = color
					visual.Glow.BackgroundColor3 = color
					setMarkerPosition(visual, position, false)
				end
			end
		end
	end

	for instance, visual in pairs(markerByInstance) do
		if not activeInstances[instance] then
			visual.Core:Destroy()
			visual.Glow:Destroy()
			markerByInstance[instance] = nil
		end
	end
end

local function refreshVisibility()
	panel.Visible = player:GetAttribute("IsRunActive") == true

	if not panel.Visible then
		focusPosition = nil
		setVisualVisible(playerMarker, false)
		updateCardinals()
	end
end

player:GetAttributeChangedSignal("IsRunActive"):Connect(refreshVisibility)

RunService.RenderStepped:Connect(function(deltaTime)
	if not panel.Visible then
		return
	end

	elapsedSinceUpdate += deltaTime

	if elapsedSinceUpdate < MiniMapConfig.UpdateInterval then
		return
	end

	elapsedSinceUpdate = 0
	updatePlayerMarker()
	updateInteractableMarkers()
end)

refreshVisibility()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="134">
          <Properties>
            <string name="Name">PerformanceBenchmarkClient</string>
            <string name="Source"><![CDATA[-- Echantillonnage client P0. Ce script ne modifie jamais le rendu ni le gameplay.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local PerformanceBaselineConfig = require(Shared:WaitForChild("PerformanceBaselineConfig"))
local VfxConfig = require(Shared:WaitForChild("VfxConfig"))

local GraphicsController = require(script.Parent:WaitForChild("GraphicsController"))
local VfxQualityController = require(script.Parent:WaitForChild("VfxQualityController"))

local sampleRemote = ReplicatedStorage:WaitForChild(PerformanceBaselineConfig.ClientSampleRemoteName)
local statusRemote = ReplicatedStorage:WaitForChild(PerformanceBaselineConfig.StatusRemoteName)

if not sampleRemote:IsA("RemoteEvent") or not statusRemote:IsA("RemoteEvent") then
	error("Remotes P0 invalides")
end

local activeBenchmarkId = nil
local activePhase = "Idle"
local elapsedSinceSample = 0
local frameSamples = {}
local frameSpikeCount = 0
local memoryBeforeMb = nil
local memoryPeakMb = nil
local memoryAfterCleanupMb = nil
local memoryAfterIdleMb = nil
local viewportBefore = nil
local viewportChanged = false
local focusLostCount = 0

local function readNumber(reader)
	local success, value = pcall(reader)

	if success and typeof(value) == "number" then
		return value
	end

	return nil
end

local function readMemoryTag(tagName)
	return readNumber(function()
		local tag = Enum.DeveloperMemoryTag[tagName]

		if tag == nil then
			error("Tag memoire indisponible")
		end

		return Stats:GetMemoryUsageMbForTag(tag)
	end)
end

local function countMegaRobloxVfx()
	local particles = 0
	local activeParticles = 0
	local lights = 0
	local activeLights = 0
	local trails = 0
	local activeTrails = 0

	for _, descendant in ipairs(CollectionService:GetTagged(VfxConfig.TelemetryTag)) do
		if not descendant:IsDescendantOf(Workspace) then
			continue
		end

		if descendant:IsA("ParticleEmitter") then
			particles += 1

			if descendant.Enabled then
				activeParticles += 1
			end
		elseif descendant:IsA("Trail") then
			trails += 1

			if descendant.Enabled then
				activeTrails += 1
			end
		elseif descendant:IsA("PointLight") or descendant:IsA("SpotLight") or descendant:IsA("SurfaceLight") then
			lights += 1

			if descendant.Enabled then
				activeLights += 1
			end
		end
	end

	return particles, activeParticles, lights, activeLights, trails, activeTrails
end

local function getPercentile(samples, percentage)
	if #samples == 0 then
		return nil
	end

	local sorted = table.clone(samples)
	table.sort(sorted)
	return sorted[math.clamp(math.ceil(#sorted * percentage), 1, #sorted)]
end

local function sendSummary()
	if activeBenchmarkId == nil then
		return
	end

	sampleRemote:FireServer({
		Kind = "Summary",
		BenchmarkId = activeBenchmarkId,
		Summary = {
			FrameP50Seconds = getPercentile(frameSamples, 0.5),
			FrameP95Seconds = getPercentile(frameSamples, 0.95),
			FrameP99Seconds = getPercentile(frameSamples, 0.99),
			FrameSpikeCount = frameSpikeCount,
			MemoryBeforeMb = memoryBeforeMb,
			MemoryPeakMb = memoryPeakMb,
			MemoryAfterCleanupMb = memoryAfterCleanupMb,
			MemoryAfterIdleMb = memoryAfterIdleMb,
			ViewportBefore = viewportBefore,
			ViewportAfter = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or nil,
			ViewportChanged = viewportChanged,
			FocusLostCount = focusLostCount,
			Graphics = GraphicsController.GetSettings(),
			Vfx = VfxQualityController.GetSettings(),
		},
	})
end

local function sendPeriodicSample()
	if activeBenchmarkId == nil or activePhase ~= "Measuring" then
		return
	end

	local particles, activeParticles, lights, activeLights, trails, activeTrails = countMegaRobloxVfx()
	local totalMemory = readNumber(function()
		return Stats:GetTotalMemoryUsageMb()
	end)

	if totalMemory ~= nil then
		memoryPeakMb = math.max(memoryPeakMb or totalMemory, totalMemory)
	end

	sampleRemote:FireServer({
		Kind = "Sample",
		BenchmarkId = activeBenchmarkId,
		Metrics = {
			["Client.RenderCpuSeconds"] = readNumber(function()
				return Stats.RenderCPUFrameTime
			end) or -1,
			["Client.RenderGpuSeconds"] = readNumber(function()
				return Stats.RenderGPUFrameTime
			end) or -1,
			["Client.PhysicsSeconds"] = readNumber(function()
				return Stats.PhysicsStepTime
			end) or -1,
			["Client.Network.DataSendKbps"] = readNumber(function()
				return Stats.DataSendKbps
			end) or -1,
			["Client.Network.DataReceiveKbps"] = readNumber(function()
				return Stats.DataReceiveKbps
			end) or -1,
			["Client.Network.PhysicsSendKbps"] = readNumber(function()
				return Stats.PhysicsSendKbps
			end) or -1,
			["Client.Network.PhysicsReceiveKbps"] = readNumber(function()
				return Stats.PhysicsReceiveKbps
			end) or -1,
			["Client.DrawCalls"] = readNumber(function()
				return Stats.SceneDrawcallCount
			end) or -1,
			["Client.Triangles"] = readNumber(function()
				return Stats.SceneTriangleCount
			end) or -1,
			["Client.Instances"] = readNumber(function()
				return Stats.InstanceCount
			end) or -1,
			["Client.Memory.TotalMb"] = totalMemory or -1,
			["Client.Memory.InstancesMb"] = readMemoryTag("Instances") or -1,
			["Client.Memory.LuaHeapMb"] = readMemoryTag("LuaHeap") or -1,
			["Client.Memory.GraphicsTextureMb"] = readMemoryTag("GraphicsTexture") or -1,
			["Client.Memory.SoundsMb"] = readMemoryTag("Sounds") or -1,
			["Client.Memory.PhysicsPartsMb"] = readMemoryTag("PhysicsParts") or -1,
			["Client.Memory.PhysicsCollisionMb"] = readMemoryTag("PhysicsCollision") or -1,
			["Client.Vfx.ParticleEmitters"] = particles,
			["Client.Vfx.ActiveParticleEmitters"] = activeParticles,
			["Client.Vfx.Lights"] = lights,
			["Client.Vfx.ActiveLights"] = activeLights,
			["Client.Vfx.Trails"] = trails,
			["Client.Vfx.ActiveTrails"] = activeTrails,
			["Client.FrameSpikes"] = frameSpikeCount,
		},
	})
end

statusRemote.OnClientEvent:Connect(function(payload)
	if typeof(payload) ~= "table" then
		return
	end

	local nextPhase = payload.Phase
	if payload.Active == true and typeof(payload.BenchmarkId) == "string" then
		if activeBenchmarkId ~= payload.BenchmarkId then
			activeBenchmarkId = payload.BenchmarkId
			frameSamples = {}
			frameSpikeCount = 0
			memoryBeforeMb = readNumber(function()
				return Stats:GetTotalMemoryUsageMb()
			end)
			memoryPeakMb = memoryBeforeMb
			memoryAfterCleanupMb = nil
			memoryAfterIdleMb = nil
			viewportBefore = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or nil
			viewportChanged = false
			focusLostCount = 0
			elapsedSinceSample = 0
		end
	end

	if typeof(payload.VfxBenchmarkLock) == "boolean" then
		VfxQualityController.SetBenchmarkLock(payload.VfxBenchmarkLock)
	end

	if nextPhase == "Cleanup" then
		memoryAfterCleanupMb = readNumber(function()
			return Stats:GetTotalMemoryUsageMb()
		end)
		sendSummary()
	elseif nextPhase == "IdleObservation" then
		memoryAfterIdleMb = readNumber(function()
			return Stats:GetTotalMemoryUsageMb()
		end)
		sendSummary()
	elseif nextPhase == "Completed" then
		activeBenchmarkId = nil
	end

	activePhase = if typeof(nextPhase) == "string" then nextPhase else activePhase
end)

UserInputService.WindowFocusReleased:Connect(function()
	if activeBenchmarkId ~= nil then
		focusLostCount += 1
	end
end)

RunService.RenderStepped:Connect(function(deltaTime)
	if activeBenchmarkId == nil then
		return
	end

	local currentCamera = Workspace.CurrentCamera
	if viewportBefore ~= nil and currentCamera ~= nil and currentCamera.ViewportSize ~= viewportBefore then
		viewportChanged = true
	end

	if activePhase == "Measuring" then
		if #frameSamples < PerformanceBaselineConfig.MaximumSamplesPerMetric then
			table.insert(frameSamples, deltaTime)
		end

		if deltaTime > (1 / 30) then
			frameSpikeCount += 1
		end

		elapsedSinceSample += deltaTime
		if elapsedSinceSample >= PerformanceBaselineConfig.SampleInterval then
			elapsedSinceSample = 0
			sendPeriodicSample()
		end
	end
end)

DebugLog.Info("Perf", "Collecteur client P0 initialise")
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="135">
          <Properties>
            <string name="Name">PerkChoiceV2Adapter</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local PerkConfig = require(Shared:WaitForChild("PerkConfig"))
local PerkIconConfig = require(Shared:WaitForChild("PerkIconConfig"))
local UiTemplateConfig = require(Shared:WaitForChild("UiTemplateConfig"))

local showChoicesRemote = ReplicatedStorage:WaitForChild("Perk_ShowChoices")
local hideChoicesRemote = ReplicatedStorage:WaitForChild("Perk_HideChoices")
local selectChoiceRemote = ReplicatedStorage:WaitForChild("Perk_SelectChoice")
local rerollChoiceRemote = ReplicatedStorage:WaitForChild("Perk_RerollRequest")
local passChoiceRemote = ReplicatedStorage:WaitForChild("Perk_PassRequest")
local banChoiceRemote = ReplicatedStorage:WaitForChild("Perk_BanRequest")

local PRODUCTION_TEMPLATE_GUI_NAME = UiTemplateConfig.ProductionTemplateGuiName
local V2_GUI_NAME = "PerkChoiceV2"

local HOVER_TWEEN = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local SELECT_TWEEN = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local REFRESH_ACTION_LABEL = "RAFRAICHIR"
local AURA_PARTICLES_BY_RARITY = {
	Common = 12,
	Rare = 16,
	Epic = 20,
	Legendary = 24,
}
local SHEEN_TRANSPARENCY_BY_RARITY = {
	Common = 0.46,
	Rare = 0.36,
	Epic = 0.26,
	Legendary = 0.18,
}
local MAX_AURA_PARTICLES = 24
local randomizer = Random.new()

-- Les cartes exposent une vue strictement visuelle des statistiques affectees.
-- Les valeurs viennent de l'option envoyee par le serveur ; elles ne pilotent
-- jamais le calcul ou l'application du perk.
local STAT_PREVIEW_ROWS_BY_STAT = {
	MaxHealthBonus = { "MaxHealth" },
	HealthRegen = { "HealthRegen" },
	Shield = { "Shield" },
	ArmorPercent = { "Armor" },
	LifeStealPercent = { "LifeSteal" },
	DamagePercent = { "BaseDamage", "EliteDamage" },
	FlatDamage = { "BaseDamage" },
	EliteFlatDamage = { "EliteDamage" },
	AttackSpeedPercent = { "AttackRate" },
	ProjectileCount = { "ProjectileCount" },
	BounceCount = { "BounceCount" },
	CritChance = { "CritChance" },
	CritMultiplierBonus = { "CritDamage" },
	ProjectileSpeedPercent = { "ProjectileSpeed" },
	EffectDurationPercent = { "ProjectileDuration" },
	MoveSpeedPercent = { "MoveSpeed" },
	JumpPercent = { "Jump" },
	CollectRadius = { "CollectRadius" },
	XpGainPercent = { "XpMultiplier" },
	GoldGainPercent = { "GoldMultiplier" },
	Luck = { "Luck" },
	EnemyCountPercent = { "EnemyMultiplier" },
}

local VISUAL_IMPACT_BY_STAT = {
	MaxHealthBonus = 20,
	HealthRegen = 0.2,
	Shield = 5,
	ArmorPercent = 0.05,
	LifeStealPercent = 0.05,
	DamagePercent = 0.1,
	FlatDamage = 1,
	EliteFlatDamage = 1,
	AttackSpeedPercent = 0.1,
	ProjectileCount = 1,
	BounceCount = 1,
	CritChance = 0.05,
	CritMultiplierBonus = 0.25,
	ProjectileSpeedPercent = 0.1,
	EffectDurationPercent = 0.1,
	MoveSpeedPercent = 0.05,
	JumpPercent = 0.1,
	CollectRadius = 4,
	XpGainPercent = 0.1,
	GoldGainPercent = 0.1,
	Luck = 0.05,
	EnemyCountPercent = 0.1,
}

local RARITY_IMPACT_FLOOR = {
	Common = 1,
	Rare = 2,
	Epic = 2,
	Legendary = 3,
}

local function findPath(root, names)
	local current = root

	for _, name in ipairs(names) do
		current = current:FindFirstChild(name)

		if current == nil then
			return nil
		end
	end

	return current
end

local function asTextLabel(instance)
	if instance and instance:IsA("TextLabel") then
		return instance
	end

	return nil
end

local function asFrame(instance)
	if instance and instance:IsA("Frame") then
		return instance
	end

	return nil
end

local function asButton(instance)
	if instance and instance:IsA("TextButton") then
		return instance
	end

	return nil
end

local function asImageLabel(instance)
	if instance and instance:IsA("ImageLabel") then
		return instance
	end

	return nil
end

local function setText(instance, value)
	local label = asTextLabel(instance)

	if label then
		label.Text = tostring(value or "")
	end
end

local function tween(instance, info, properties)
	if instance == nil then
		return
	end

	TweenService:Create(instance, info, properties):Play()
end

local function initialise()
	local templateGui = playerGui:WaitForChild(PRODUCTION_TEMPLATE_GUI_NAME, 30)
	local legacyGui = playerGui:WaitForChild("PerkChoiceGui", 30)

	if templateGui == nil or not templateGui:IsA("ScreenGui") or legacyGui == nil or not legacyGui:IsA("ScreenGui") then
		DebugLog.Warn("UI", "Choix de perk V2 non active, snapshot ou rail historique introuvable", {
			HasProductionTemplate = templateGui ~= nil,
			HasLegacyGui = legacyGui ~= nil,
		})
		return
	end

	local runCanvas = templateGui:FindFirstChild("RunCanvas")
	local template = runCanvas and runCanvas:FindFirstChild("PerkChoiceDock")

	if template == nil or not template:IsA("Frame") then
		DebugLog.Warn("UI", "Choix de perk V2 non active, PerkChoiceDock invalide")
		return
	end

	local previousGui = playerGui:FindFirstChild(V2_GUI_NAME)

	if previousGui then
		previousGui:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = V2_GUI_NAME
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 20
	screenGui.Enabled = false
	screenGui.Parent = playerGui

	local overlay = Instance.new("Frame")
	overlay.Name = "Overlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.fromRGB(2, 5, 11)
	overlay.BackgroundTransparency = 0.36
	overlay.BorderSizePixel = 0
	overlay.Parent = screenGui

	local dock = template:Clone()
	dock.Name = "PerkChoiceDockV2"
	dock.Visible = true
	dock:SetAttribute("ProductionBound", true)
	dock.Parent = overlay

	-- Le snapshot reste une source de composants. Les scripts actuels gardent
	-- leurs donnees et les remotes serveur, sans rendu historique duplique.
	templateGui.Enabled = false

	local panel = asFrame(dock:FindFirstChild("PerkChoicePanel"))
	local content = panel and asFrame(panel:FindFirstChild("Content"))
	local offersRoot = content and asFrame(content:FindFirstChild("Offers"))
	local buttonRow = content and asFrame(findPath(content, { "ActionRow", "ButtonRow" }))
	local titleLabel = content and asTextLabel(content:FindFirstChild("Title"))
	local subtitleLabel = content and asTextLabel(content:FindFirstChild("Subtitle"))
	local refreshButton = buttonRow and asButton(buttonRow:FindFirstChild("Refresh"))
	local passButton = buttonRow and asButton(buttonRow:FindFirstChild("Pass"))
	local banButton = buttonRow and asButton(buttonRow:FindFirstChild("Ban"))

	if
		panel == nil
		or content == nil
		or offersRoot == nil
		or refreshButton == nil
		or passButton == nil
		or banButton == nil
	then
		DebugLog.Warn("UI", "Choix de perk V2 non active, hierarchie du kit incomplete")
		screenGui:Destroy()
		return
	end

	-- L'ordre gameplay est Bannir, Passer, Rafraichir. Le layout reste porte
	-- par le UIGridLayout du kit : aucune position fixe n'est introduite.
	banButton.LayoutOrder = 1
	passButton.LayoutOrder = 2
	refreshButton.LayoutOrder = 3

	local cards = {}

	for index = 1, 3 do
		local card = asFrame(offersRoot:FindFirstChild("Offer" .. tostring(index)))

		if card == nil then
			DebugLog.Warn("UI", "Carte de perk V2 introuvable", {
				Index = index,
			})
			screenGui:Destroy()
			return
		end

		cards[index] = {
			Root = card,
			Content = asFrame(card:FindFirstChild("Content")),
			Stroke = card:FindFirstChild("RarityStroke"),
			Accent = asFrame(card:FindFirstChild("RarityAccent")),
			Aura = asFrame(card:FindFirstChild("RarityAura")),
			AuraStroke = card:FindFirstChild("IdleAuraStroke"),
			HoverScale = card:FindFirstChild("HoverScale"),
			HoverWash = asFrame(card:FindFirstChild("HoverWash")),
			HoverSheen = asFrame(card:FindFirstChild("HoverSheen")),
			Option = nil,
			Hovered = false,
			IdleTweens = {},
			AuraCycle = 0,
			AuraParticleTweens = {},
			SheenTransparency = 0.46,
			RarityColor = Color3.fromRGB(245, 246, 255),
		}
	end

	local function getCardContent(cardState, name)
		return cardState.Content and cardState.Content:FindFirstChild(name) or nil
	end

	local currentChoiceId = nil
	local isSubmitting = false
	local isRerollPending = false
	local isBanMode = false
	local legacySuppressionInProgress = false

	local function suppressLegacyGui()
		if legacySuppressionInProgress then
			return
		end

		legacySuppressionInProgress = true
		legacyGui.Enabled = false
		local legacyOverlay = legacyGui:FindFirstChild("Overlay")

		if legacyOverlay and legacyOverlay:IsA("GuiObject") then
			legacyOverlay.Visible = false
		end

		legacySuppressionInProgress = false
	end

	legacyGui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if legacyGui.Enabled then
			task.defer(suppressLegacyGui)
		end
	end)
	suppressLegacyGui()

	local function setActionState(button, state, charges)
		if button == nil then
			return
		end

		local active = state == "Active"
		button:SetAttribute("ActionState", state)
		button:SetAttribute("Charges", charges or 0)
		button.Active = active
		button.Selectable = active

		local actionStroke = button:FindFirstChild("ActionStroke")
		local stateMark = asFrame(button:FindFirstChild("StateMark"))
		local accentGlow = asFrame(button:FindFirstChild("AccentGlow"))
		local chargePips = button:FindFirstChild("ChargePips")
		local accent = button:GetAttribute("RoleBorderColor")

		if typeof(accent) ~= "Color3" then
			accent = button.TextColor3
		end

		if state == "Active" then
			button.TextTransparency = 0
			button.BackgroundTransparency = 0.12
		elseif state == "Consumed" then
			button.TextTransparency = 0.5
			button.BackgroundTransparency = 0.5
		else
			button.TextTransparency = 0.62
			button.BackgroundTransparency = 0.66
		end

		if actionStroke and actionStroke:IsA("UIStroke") then
			actionStroke.Color = accent
			actionStroke.Transparency = if state == "Active" then 0.15 elseif state == "Consumed" then 0.56 else 0.76
		end

		if stateMark then
			stateMark.BackgroundColor3 = accent
			stateMark.BackgroundTransparency = if state == "Active" then 0.06 else 0.72
		end

		if accentGlow then
			accentGlow.BackgroundColor3 = accent
			accentGlow.BackgroundTransparency = if state == "Active" then 0.72 else 0.94
		end

		if chargePips then
			local pipIndex = 0
			for _, pip in ipairs(chargePips:GetChildren()) do
				if pip:IsA("Frame") then
					pipIndex += 1
					pip.BackgroundColor3 = accent
					pip.BackgroundTransparency = if state == "Active" and pipIndex <= (charges or 0) then 0.04 else 0.82
				end
			end
		end
	end

	local function getRerollCredits()
		return math.max(0, math.floor(tonumber(player:GetAttribute("PerkRerollCredits")) or 0))
	end

	local function getRerollsRemainingThisRun()
		local used = math.max(0, math.floor(tonumber(player:GetAttribute("PerkRerollsUsedThisRun")) or 0))
		local maxUses = math.max(
			0,
			math.floor(tonumber(player:GetAttribute("PerkRerollsMaxUses")) or PerkConfig.MaxRerollsPerRun)
		)

		return math.max(0, math.min(getRerollCredits(), maxUses - used))
	end

	local function getRunActionCredits(attributeName)
		return math.max(0, math.floor(tonumber(player:GetAttribute(attributeName)) or 0))
	end

	local function getRunActionCreditMaximum(attributeName)
		return math.max(0, math.floor(tonumber(player:GetAttribute(attributeName)) or 0))
	end

	local function refreshActions()
		local credits = getRerollCredits()
		local rerollsRemaining = getRerollsRemainingThisRun()
		local refreshAvailable = screenGui.Enabled and currentChoiceId ~= nil and rerollsRemaining > 0 and not isSubmitting and not isRerollPending
		local passCredits = getRunActionCredits("RunPassCredits")
		local banCredits = getRunActionCredits("RunBanCredits")
		local passMaximum = getRunActionCreditMaximum("RunPassCreditsMax")
		local banMaximum = getRunActionCreditMaximum("RunBanCreditsMax")
		local canUseRunAction = screenGui.Enabled and currentChoiceId ~= nil and not isSubmitting and not isRerollPending

		refreshButton.Text = string.format("%s (%d/%d)", REFRESH_ACTION_LABEL, rerollsRemaining, credits)
		setActionState(refreshButton, if refreshAvailable then "Active" elseif rerollsRemaining <= 0 then "Consumed" else "Disabled", rerollsRemaining)

		passButton.Text = string.format("PASSER (%d/%d)", passCredits, passMaximum)
		banButton.Text = string.format("BANNIR (%d/%d)", banCredits, banMaximum)
		setActionState(passButton, if canUseRunAction and passCredits > 0 then "Active" elseif passCredits <= 0 then "Consumed" else "Disabled", passCredits)
		setActionState(banButton, if canUseRunAction and banCredits > 0 then "Active" elseif banCredits <= 0 then "Consumed" else "Disabled", banCredits)

		-- Le mode bannissement doit se lire sans modifier le contrat visuel du bouton.
		banButton:SetAttribute("BanModeActive", isBanMode)
		local accentGlow = asFrame(banButton:FindFirstChild("AccentGlow"))
		if accentGlow then
			accentGlow.BackgroundTransparency = if isBanMode then 0.48 else accentGlow.BackgroundTransparency
		end
	end

	local function setCardInteractive(cardState, interactive)
		cardState.Root.Active = interactive
		cardState.Root.Selectable = interactive

		if not interactive then
			tween(cardState.Root, SELECT_TWEEN, { BackgroundTransparency = 0.34 })
		else
			tween(cardState.Root, SELECT_TWEEN, { BackgroundTransparency = 0.1 })
		end
	end

	local function setCardsInteractive(interactive)
		for _, cardState in ipairs(cards) do
			setCardInteractive(cardState, interactive and cardState.Option ~= nil)
		end
	end

	local function startIdleAura(cardState)
		if #cardState.IdleTweens > 0 then
			return
		end

		local auraStroke = cardState.AuraStroke
		local auraGradient = auraStroke and auraStroke:FindFirstChild("AuraGradient")

		if not auraStroke or not auraStroke:IsA("UIStroke") or not auraGradient or not auraGradient:IsA("UIGradient") then
			return
		end

		auraStroke.Thickness = 2.8
		auraStroke.Transparency = 0.34
		auraGradient.Rotation = 0

		local rotation = TweenService:Create(
			auraGradient,
			TweenInfo.new(7.2, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1),
			{ Rotation = 360 }
		)
		local pulse = TweenService:Create(
			auraStroke,
			TweenInfo.new(2.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Transparency = 0.48 }
		)

		table.insert(cardState.IdleTweens, rotation)
		table.insert(cardState.IdleTweens, pulse)
		rotation:Play()
		pulse:Play()
	end

	local function getAuraParticles(aura)
		local particles = {}

		for _, particle in ipairs(aura:GetChildren()) do
			if particle:IsA("Frame") and string.match(particle.Name, "^Particle") then
				table.insert(particles, particle)
			end
		end

		return particles
	end

	local function prepareAuraParticles(cardState)
		local aura = cardState.Aura

		if aura == nil then
			return
		end

		local templateParticle = aura:FindFirstChild("Particle01")
		if templateParticle and templateParticle:IsA("Frame") then
			local particleCount = 0
			for _, child in ipairs(aura:GetChildren()) do
				if child:IsA("Frame") and string.match(child.Name, "^Particle") then
					particleCount += 1
				end
			end

			-- Une nappe dense de petites particules donne une aura continue. Les
			-- clones restent locaux a l'UI V2 et n'alourdissent pas le template.
			while particleCount < MAX_AURA_PARTICLES do
				particleCount += 1
				local particle = templateParticle:Clone()
				particle.Name = string.format("Particle%02d", particleCount)
				particle.BackgroundTransparency = 1
				particle.Parent = aura
			end
		end

		for _, particle in ipairs(getAuraParticles(aura)) do
			particle.Visible = false
			particle.BackgroundTransparency = 1
		end
	end

	local function stopAuraParticles(cardState)
		cardState.AuraCycle += 1

		for _, activeTween in pairs(cardState.AuraParticleTweens) do
			activeTween:Cancel()
		end
		table.clear(cardState.AuraParticleTweens)

		if cardState.Aura then
			for _, particle in ipairs(getAuraParticles(cardState.Aura)) do
				particle.Visible = false
				particle.BackgroundTransparency = 1
			end
		end
	end

	local function startAuraParticles(cardState)
		local aura = cardState.Aura

		if aura == nil then
			return
		end

		prepareAuraParticles(cardState)
		stopAuraParticles(cardState)

		local cycle = cardState.AuraCycle
		local rarityColor = aura:GetAttribute("RarityColor")

		if typeof(rarityColor) ~= "Color3" then
			return
		end

		for particleIndex, particle in ipairs(getAuraParticles(aura)) do
			local currentParticleIndex = particleIndex

			task.spawn(function()
				task.wait(currentParticleIndex * 0.09)

				while aura.Parent ~= nil and cycle == cardState.AuraCycle do
					if
						not screenGui.Enabled
						or cardState.Option == nil
						or currentParticleIndex > (cardState.AuraParticleLimit or 0)
					then
						particle.Visible = false
						task.wait(0.2)
						continue
					end

					local startX = 0.5 + randomizer:NextNumber(-0.12, 0.12)
					local endX = math.clamp(startX + randomizer:NextNumber(-0.16, 0.16), 0.18, 0.82)

					particle.BackgroundColor3 = rarityColor
					particle.Position = UDim2.fromScale(startX, 0.94)
					particle.Size = UDim2.fromOffset(randomizer:NextInteger(1, 3), randomizer:NextInteger(1, 3))
					particle.BackgroundTransparency = randomizer:NextNumber(0.52, 0.76)
					particle.Visible = true

					local corner = particle:FindFirstChildOfClass("UICorner")
					if corner == nil then
						corner = Instance.new("UICorner")
						corner.Parent = particle
					end
					corner.CornerRadius = UDim.new(1, 0)

					local glow = particle:FindFirstChild("Glow")
					if glow and glow:IsA("UIStroke") then
						glow.Color = rarityColor
						glow.Thickness = 0.45
						glow.Transparency = 0.74
					end

					local rise = TweenService:Create(
						particle,
						TweenInfo.new(randomizer:NextNumber(1.05, 1.55), Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
						{
							Position = UDim2.fromScale(endX, -0.06),
							BackgroundTransparency = 1,
						}
					)

					cardState.AuraParticleTweens[particle] = rise
					rise:Play()
					rise.Completed:Wait()

					if cycle ~= cardState.AuraCycle then
						return
					end

					if cardState.AuraParticleTweens[particle] == rise then
						cardState.AuraParticleTweens[particle] = nil
					end
					particle.Visible = false
					task.wait(randomizer:NextNumber(0.06, 0.18))
				end
			end)
		end
	end

	local function startPanelIdle()
		local surface = asFrame(panel:FindFirstChild("Surface"))
		local innerGlass = surface and asFrame(surface:FindFirstChild("InnerGlass"))
		local material = innerGlass and asFrame(innerGlass:FindFirstChild("PerkAscensionMaterial"))
		local rim = surface and asFrame(surface:FindFirstChild("PerkAscensionRim"))
		local flow = material and asFrame(material:FindFirstChild("FlowCanvas"))
		local pulse = material and asFrame(material:FindFirstChild("PowerPulse"))
		local veil = material and asFrame(material:FindFirstChild("AmbientVeil"))
		local veilGradient = veil and veil:FindFirstChild("AmbientGradient")
		local rimGradient = rim and rim:FindFirstChild("RimGradient")

		if flow then
			TweenService:Create(
				flow,
				TweenInfo.new(6.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ Position = UDim2.fromScale(0.5, 0.487) }
			):Play()
		end

		if pulse then
			TweenService:Create(
				pulse,
				TweenInfo.new(4.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{
					BackgroundTransparency = 0.935,
					Size = UDim2.fromScale(0.62, 0.48),
				}
			):Play()
		end

		if veilGradient and veilGradient:IsA("UIGradient") then
			TweenService:Create(
				veilGradient,
				TweenInfo.new(9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{
					Offset = Vector2.new(0.12, 0.04),
					Rotation = 12,
				}
			):Play()
		end

		if rimGradient and rimGradient:IsA("UIGradient") then
			TweenService:Create(
				rimGradient,
				TweenInfo.new(9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ Rotation = 18 }
			):Play()
		end
	end

	local function updateCardInspection(cardState, pointerPosition)
		local card = cardState.Root
		local size = card.AbsoluteSize

		if size.X <= 0 or size.Y <= 0 then
			return
		end

		local normalizedX = math.clamp(((pointerPosition.X - card.AbsolutePosition.X) / size.X - 0.5) * 2, -1, 1)
		local normalizedY = math.clamp(((pointerPosition.Y - card.AbsolutePosition.Y) / size.Y - 0.5) * 2, -1, 1)
		local tilt = tonumber(card:GetAttribute("TiltDegrees")) or 1
		local materialLayer = asFrame(card:FindFirstChild("MaterialLayer"))
		local patternCanvas = materialLayer and asFrame(materialLayer:FindFirstChild("PatternCanvas"))
		local materialGradient = materialLayer and materialLayer:FindFirstChild("MaterialGradient")
		local sheenGradient = cardState.HoverSheen and cardState.HoverSheen:FindFirstChild("SheenGradient")

		-- Ces proprietes suivent directement le pointeur. Des tweens recrees a
		-- chaque MouseMovement finissent leur course apres la souris et donnent
		-- l'impression que le reflet n'est pas accroche a la carte.
		card.Rotation = normalizedX * tilt + normalizedY * tilt * 0.22

		if patternCanvas then
			patternCanvas.Position = UDim2.fromScale(0.5 + normalizedX * 0.01, 0.5 + normalizedY * 0.006)
		end

		if materialGradient and materialGradient:IsA("UIGradient") then
			materialGradient.Offset = Vector2.new(normalizedX * 0.08, normalizedY * 0.04)
		end

		if sheenGradient and sheenGradient:IsA("UIGradient") then
			sheenGradient.Offset = Vector2.new(normalizedX * 0.48, normalizedY * 0.16)
		end
	end

	local function resetCardInspection(cardState)
		local card = cardState.Root
		local materialLayer = asFrame(card:FindFirstChild("MaterialLayer"))
		local patternCanvas = materialLayer and asFrame(materialLayer:FindFirstChild("PatternCanvas"))
		local materialGradient = materialLayer and materialLayer:FindFirstChild("MaterialGradient")
		local sheenGradient = cardState.HoverSheen and cardState.HoverSheen:FindFirstChild("SheenGradient")
		local returnTween = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

		tween(card, returnTween, { Rotation = 0 })
		if patternCanvas then
			tween(patternCanvas, returnTween, { Position = UDim2.fromScale(0.5, 0.5) })
		end
		if materialGradient and materialGradient:IsA("UIGradient") then
			tween(materialGradient, returnTween, { Offset = Vector2.new(0, 0) })
		end
		if sheenGradient and sheenGradient:IsA("UIGradient") then
			tween(sheenGradient, returnTween, { Offset = Vector2.new(0, 0) })
		end
	end

	local function setCardHover(cardState, hovered)
		if cardState.Option == nil or isSubmitting then
			return
		end

		if cardState.HoverScale and cardState.HoverScale:IsA("UIScale") then
			tween(cardState.HoverScale, HOVER_TWEEN, {
				Scale = if hovered then 1.025 else 1,
			})
		end

		local icon = asImageLabel(getCardContent(cardState, "Icon"))
		local iconScale = icon and icon:FindFirstChild("HoverScale")
		if iconScale and iconScale:IsA("UIScale") then
			tween(iconScale, HOVER_TWEEN, {
				Scale = if hovered then 1.05 else 1,
			})
		end

		if cardState.Stroke and cardState.Stroke:IsA("UIStroke") then
			tween(cardState.Stroke, HOVER_TWEEN, {
				Color = if isBanMode and hovered then Color3.fromRGB(248, 60, 76) else cardState.RarityColor,
				Transparency = if hovered then 0.02 else 0.12,
				Thickness = if hovered then 2.3 else 1.5,
			})
		end

		if cardState.HoverWash then
			tween(cardState.HoverWash, HOVER_TWEEN, {
				BackgroundTransparency = if hovered then 0.76 else 1,
			})
		end

		if cardState.HoverSheen then
			cardState.HoverSheen.Visible = hovered
			cardState.HoverSheen.Position = UDim2.fromScale(0, 0)
			cardState.HoverSheen.BackgroundTransparency = if hovered then cardState.SheenTransparency else 1
		end

		local materialLayer = asFrame(cardState.Root:FindFirstChild("MaterialLayer"))
		if materialLayer then
			tween(materialLayer, HOVER_TWEEN, {
				BackgroundTransparency = if hovered then 0.954 else 0.974,
			})
		end
	end

	local function applyRarityText(cardState, rarityColor)
		local nameLabel = asTextLabel(getCardContent(cardState, "Name"))
		local effectLabel = asTextLabel(getCardContent(cardState, "Effect"))

		if nameLabel then
			nameLabel.TextColor3 = Color3.fromRGB(245, 246, 255)
		end

		if effectLabel then
			effectLabel.TextColor3 = rarityColor
		end
	end

	local function setGradientColors(gradient, keypoints)
		gradient.Color = ColorSequence.new(keypoints)
	end

	local function applyRarityGradient(gradient, rarityColor)
		local dark = Color3.fromRGB(4, 8, 16)
		local white = Color3.fromRGB(245, 246, 255)

		if gradient.Name == "DA_CardGradient" then
			-- Fond de carte : une teinte profonde, sans ecraser le noir bleute.
			setGradientColors(gradient, {
				ColorSequenceKeypoint.new(0, dark:Lerp(rarityColor, 0.26)),
				ColorSequenceKeypoint.new(0.34, Color3.fromRGB(8, 13, 20)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(5, 9, 15)),
			})
		elseif gradient.Name == "MaterialGradient" then
			-- Matiere : reflets clairs, couleur pure, puis ombre coloree.
			setGradientColors(gradient, {
				ColorSequenceKeypoint.new(0, rarityColor:Lerp(white, 0.18)),
				ColorSequenceKeypoint.new(0.5, rarityColor),
				ColorSequenceKeypoint.new(1, rarityColor:Lerp(dark, 0.35)),
			})
		elseif gradient.Name == "GlassGradient" then
			-- Verre : le reflet reste lumineux comme dans le kit de demo.
			setGradientColors(gradient, {
				ColorSequenceKeypoint.new(0, white),
				ColorSequenceKeypoint.new(0.46, rarityColor:Lerp(white, 0.52)),
				ColorSequenceKeypoint.new(1, rarityColor),
			})
		elseif gradient.Name == "AuraGradient" then
			-- Bordure animee : conserver les cinq paliers de lumiere du kit.
			local shadow = rarityColor:Lerp(dark, 0.55)
			setGradientColors(gradient, {
				ColorSequenceKeypoint.new(0, shadow),
				ColorSequenceKeypoint.new(0.38, rarityColor:Lerp(dark, 0.25)),
				ColorSequenceKeypoint.new(0.5, rarityColor:Lerp(white, 0.35)),
				ColorSequenceKeypoint.new(0.62, rarityColor),
				ColorSequenceKeypoint.new(1, shadow),
			})
		elseif gradient.Name == "WashGradient" then
			setGradientColors(gradient, {
				ColorSequenceKeypoint.new(0, rarityColor:Lerp(white, 0.58)),
				ColorSequenceKeypoint.new(0.42, white),
				ColorSequenceKeypoint.new(1, rarityColor:Lerp(white, 0.35)),
			})
		elseif gradient.Name == "SheenGradient" then
			-- Le rayon de hover reste presque blanc pour garder son impact.
			setGradientColors(gradient, {
				ColorSequenceKeypoint.new(0, rarityColor:Lerp(white, 0.5)),
				ColorSequenceKeypoint.new(0.5, white),
				ColorSequenceKeypoint.new(1, rarityColor:Lerp(white, 0.65)),
			})
		end
	end

	local function applyRarityMaterial(cardState, rarityColor)
		local materialLayer = asFrame(cardState.Root:FindFirstChild("MaterialLayer"))
		local patternCanvas = materialLayer and asFrame(materialLayer:FindFirstChild("PatternCanvas"))
		local glassSurface = asFrame(cardState.Root:FindFirstChild("GlassSurface"))
		local hoverWash = cardState.HoverWash

		if materialLayer then
			materialLayer.BackgroundColor3 = rarityColor
		end

		if glassSurface then
			glassSurface.BackgroundColor3 = rarityColor
		end

		if hoverWash then
			hoverWash.BackgroundColor3 = rarityColor
		end

		if patternCanvas then
			patternCanvas.BackgroundColor3 = rarityColor
			for _, element in ipairs(patternCanvas:GetDescendants()) do
				if element:IsA("Frame") then
					element.BackgroundColor3 = rarityColor
				elseif element:IsA("ImageLabel") then
					element.ImageColor3 = rarityColor
				elseif element:IsA("UIStroke") then
					element.Color = rarityColor
				elseif element:IsA("UIGradient") then
					applyRarityGradient(element, rarityColor)
				end
			end
		end

		-- Le kit porte une teinte de demonstration par carte. En production,
		-- seules les couches de surface nommees suivent l'offre runtime.
		for _, gradient in ipairs(cardState.Root:GetDescendants()) do
			if gradient:IsA("UIGradient") and gradient.Name ~= "" then
				applyRarityGradient(gradient, rarityColor)
			end
		end
	end

	local function applyRarityAura(cardState, rarityColor)
		local aura = cardState.Aura

		if aura == nil then
			return
		end

		aura:SetAttribute("RarityColor", rarityColor)

		for _, element in ipairs(aura:GetDescendants()) do
			if element:IsA("Frame") then
				element.BackgroundColor3 = rarityColor
			elseif element:IsA("UIStroke") then
				element.Color = rarityColor
			elseif element:IsA("ImageLabel") then
				element.ImageColor3 = rarityColor
			end
		end
	end

	local function updateStatPreview(cardState, option)
		local preview = cardState.Root:FindFirstChild("StatPreview")

		if preview == nil then
			preview = Instance.new("Folder")
			preview.Name = "StatPreview"
			preview.Parent = cardState.Root
		end

		for _, child in ipairs(preview:GetChildren()) do
			child:Destroy()
		end

		local deltasByRow = {}
		local impactsByRow = {}
		local stats = if typeof(option.Stats) == "table" then option.Stats else {}
		local rarityFloor = RARITY_IMPACT_FLOOR[option.Rarity] or 1

		for statId, rawValue in pairs(stats) do
			if typeof(rawValue) == "number" and rawValue ~= 0 then
				local rowIds = STAT_PREVIEW_ROWS_BY_STAT[statId]

				if rowIds then
					local step = VISUAL_IMPACT_BY_STAT[statId] or 1
					local impact = math.clamp(math.max(rarityFloor, math.ceil(math.abs(rawValue) / step)), 1, 3)

					for _, rowId in ipairs(rowIds) do
						deltasByRow[rowId] = (deltasByRow[rowId] or 0) + rawValue
						impactsByRow[rowId] = math.max(impactsByRow[rowId] or 1, impact)
					end
				end
			end
		end

		for rowId, delta in pairs(deltasByRow) do
			local entry = Instance.new("NumberValue")
			entry.Name = rowId
			entry.Value = delta
			entry:SetAttribute("VisualImpact", impactsByRow[rowId] or 1)
			entry.Parent = preview
		end
	end

	local function updateCard(cardState, option)
		stopAuraParticles(cardState)
		cardState.Option = option
		cardState.AuraParticleLimit = 0
		cardState.Root.Visible = option ~= nil

		if option == nil then
			return
		end

		local rarityColor = if typeof(option.RarityColor) == "Color3" then option.RarityColor else Color3.fromRGB(245, 246, 255)
		cardState.RarityColor = rarityColor
		local rarityName = string.upper(tostring(option.RarityName or option.Rarity or "Commun"))
		cardState.AuraParticleLimit = AURA_PARTICLES_BY_RARITY[option.Rarity] or AURA_PARTICLES_BY_RARITY.Common
		cardState.SheenTransparency = SHEEN_TRANSPARENCY_BY_RARITY[option.Rarity] or SHEEN_TRANSPARENCY_BY_RARITY.Common
		local iconAssetId = (PerkIconConfig.AssetIds or {})[option.PerkId] or ""

		cardState.Root:SetAttribute("PerkId", option.PerkId or "")
		cardState.Root:SetAttribute("RarityId", option.Rarity or "Common")
		cardState.Root:SetAttribute("RarityColor", rarityColor)

		setText(getCardContent(cardState, "Rarity"), rarityName)
		setText(getCardContent(cardState, "Name"), option.Name or "Perk")
		setText(getCardContent(cardState, "Effect"), option.Description or "")

		local rarityLabel = asTextLabel(getCardContent(cardState, "Rarity"))
		if rarityLabel then
			rarityLabel.TextColor3 = rarityColor
		end

		applyRarityText(cardState, rarityColor)
		applyRarityMaterial(cardState, rarityColor)
		updateStatPreview(cardState, option)

		local icon = asImageLabel(getCardContent(cardState, "Icon"))
		if icon then
			icon.Image = iconAssetId
			icon.Visible = iconAssetId ~= ""
		end

		if cardState.Stroke and cardState.Stroke:IsA("UIStroke") then
			cardState.Stroke.Color = rarityColor
			cardState.Stroke.Transparency = 0.12
		end

		if cardState.Accent then
			cardState.Accent.BackgroundColor3 = rarityColor
		end

		applyRarityAura(cardState, rarityColor)

		if cardState.AuraStroke and cardState.AuraStroke:IsA("UIStroke") then
			cardState.AuraStroke.Color = rarityColor
		end

		startIdleAura(cardState)
		startAuraParticles(cardState)
		setCardInteractive(cardState, not isSubmitting)
	end

	local function getChoiceTitle(payload)
		if type(payload.Title) == "string" and payload.Title ~= "" then
			return string.upper(payload.Title)
		end

		return "CHOIX DE PERK"
	end

	local function showChoices(payload)
		payload = if typeof(payload) == "table" then payload else {}
		local choices = if typeof(payload.Choices) == "table" then payload.Choices else {}

		currentChoiceId = payload.ChoiceId
		isSubmitting = false
		isRerollPending = false
		isBanMode = false
		screenGui.Enabled = true

		setText(titleLabel, getChoiceTitle(payload))
		setText(subtitleLabel, "Choisis une amélioration permanente")

		for index, cardState in ipairs(cards) do
			updateCard(cardState, choices[index])
		end

		setCardsInteractive(true)
		refreshActions()
		suppressLegacyGui()

		DebugLog.Info("UI", "Choix de perk V2 affiche", {
			ChoiceId = currentChoiceId,
			Choices = #choices,
		})
	end

	local function hideChoices()
		currentChoiceId = nil
		isSubmitting = false
		isRerollPending = false
		isBanMode = false
		screenGui.Enabled = false
		for _, cardState in ipairs(cards) do
			stopAuraParticles(cardState)
		end
		refreshActions()
		suppressLegacyGui()
	end

	for _, cardState in ipairs(cards) do
		cardState.Root.MouseEnter:Connect(function()
			cardState.Hovered = true
			setCardHover(cardState, true)
			updateCardInspection(cardState, UserInputService:GetMouseLocation())
		end)

		cardState.Root.MouseLeave:Connect(function()
			cardState.Hovered = false
			setCardHover(cardState, false)
			resetCardInspection(cardState)
		end)

		cardState.Root.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
				return
			end

			if isSubmitting or currentChoiceId == nil or cardState.Option == nil then
				return
			end

			isSubmitting = true
			setCardsInteractive(false)
			refreshActions()

			if isBanMode then
				DebugLog.Info("Perks", "Bannissement perk V2 envoye", {
					ChoiceId = currentChoiceId,
					OptionId = cardState.Option.OptionId,
					PerkId = cardState.Option.PerkId,
				})
				banChoiceRemote:FireServer(currentChoiceId, cardState.Option.OptionId)
				return
			end

			DebugLog.Info("Perks", "Choix perk V2 envoye", {
				ChoiceId = currentChoiceId,
				OptionId = cardState.Option.OptionId,
				PerkId = cardState.Option.PerkId,
			})
			selectChoiceRemote:FireServer(currentChoiceId, cardState.Option.OptionId)
		end)
	end

	UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseMovement then
			return
		end

		local pointerPosition = Vector2.new(input.Position.X, input.Position.Y)
		for _, cardState in ipairs(cards) do
			if cardState.Hovered then
				updateCardInspection(cardState, pointerPosition)
			end
		end
	end)

	startPanelIdle()

	refreshButton.Activated:Connect(function()
		if currentChoiceId == nil or isSubmitting or isRerollPending or getRerollsRemainingThisRun() <= 0 then
			return
		end

		isRerollPending = true
		refreshActions()
		rerollChoiceRemote:FireServer(currentChoiceId)

		task.delay(2, function()
			if isRerollPending then
				isRerollPending = false
				refreshActions()
			end
		end)
	end)

	passButton.Activated:Connect(function()
		if currentChoiceId == nil or isSubmitting or isRerollPending or getRunActionCredits("RunPassCredits") <= 0 then
			return
		end

		isSubmitting = true
		isBanMode = false
		setCardsInteractive(false)
		refreshActions()
		passChoiceRemote:FireServer(currentChoiceId)
	end)

	banButton.Activated:Connect(function()
		if currentChoiceId == nil or isSubmitting or isRerollPending or getRunActionCredits("RunBanCredits") <= 0 then
			return
		end

		isBanMode = not isBanMode
		for _, cardState in ipairs(cards) do
			if cardState.Hovered then
				setCardHover(cardState, true)
			end
		end
		refreshActions()
	end)

	player:GetAttributeChangedSignal("PerkRerollCredits"):Connect(refreshActions)
	player:GetAttributeChangedSignal("PerkRerollsUsedThisRun"):Connect(refreshActions)
	player:GetAttributeChangedSignal("PerkRerollsMaxUses"):Connect(refreshActions)
	player:GetAttributeChangedSignal("RunPassCredits"):Connect(refreshActions)
	player:GetAttributeChangedSignal("RunPassCreditsMax"):Connect(refreshActions)
	player:GetAttributeChangedSignal("RunBanCredits"):Connect(refreshActions)
	player:GetAttributeChangedSignal("RunBanCreditsMax"):Connect(refreshActions)
	showChoicesRemote.OnClientEvent:Connect(showChoices)
	hideChoicesRemote.OnClientEvent:Connect(hideChoices)

	hideChoices()
	DebugLog.Info("UI", "Adaptateur choix de perk V2 active", {
		Source = PRODUCTION_TEMPLATE_GUI_NAME,
	})
end

task.spawn(function()
	local success, err = pcall(initialise)

	if not success then
		DebugLog.Warn("UI", "Initialisation choix de perk V2 impossible", {
			Error = tostring(err),
		})
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="136">
          <Properties>
            <string name="Name">PerkUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local PerkIconConfig = require(Shared:WaitForChild("PerkIconConfig"))
local UiTheme = require(Shared:WaitForChild("UiTheme"))

local showChoicesRemote = ReplicatedStorage:WaitForChild("Perk_ShowChoices")
local hideChoicesRemote = ReplicatedStorage:WaitForChild("Perk_HideChoices")
local selectChoiceRemote = ReplicatedStorage:WaitForChild("Perk_SelectChoice")
local rerollChoiceRemote = ReplicatedStorage:WaitForChild("Perk_RerollRequest")

local existingGui = playerGui:FindFirstChild("PerkChoiceGui")

if existingGui ~= nil then
	existingGui:Destroy()
end

local COLORS = UiTheme.Contexts.Perk

local TWEEN_FAST = TweenInfo.new(0.13, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TWEEN_HOVER = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local function createLabel(parent, name, text, font, textSize, color)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Font = font
	label.Text = text
	label.TextColor3 = color
	label.TextSize = textSize
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 0.58
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = parent

	return label
end

local addCorner = UiTheme.AddCorner
local addStroke = UiTheme.AddStroke

local function createGradient(parent)
	local gradient = Instance.new("UIGradient")
	gradient.Name = "RarityGradient"
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new(COLORS.Card, COLORS.Card)
	gradient.Parent = parent

	return gradient
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "PerkChoiceGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 20
screenGui.Enabled = false
screenGui.Parent = playerGui

local overlay = Instance.new("Frame")
overlay.Name = "Overlay"
overlay.Size = UDim2.fromScale(1, 1)
overlay.BackgroundColor3 = COLORS.Overlay
overlay.BackgroundTransparency = 0.42
overlay.BorderSizePixel = 0
overlay.Parent = screenGui

local panel = Instance.new("Frame")
panel.Name = "Panel"
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.new(0.5, 0, 0.5, 0)
panel.Size = UDim2.new(0.66, 0, 0, 446)
panel.BackgroundColor3 = COLORS.Panel
panel.BackgroundTransparency = 0.2
panel.BorderSizePixel = 0
panel.ClipsDescendants = false
panel.Parent = overlay
addCorner(panel, 10)
addStroke(panel, Color3.fromRGB(7, 12, 19), 0.16, 4)
addStroke(panel, COLORS.Purple, 0.3, 1)

local panelGradient = Instance.new("UIGradient")
panelGradient.Rotation = 90
panelGradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(42, 48, 65)),
	ColorSequenceKeypoint.new(0.19, COLORS.PanelTop),
	ColorSequenceKeypoint.new(0.42, COLORS.Panel),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(8, 11, 18)),
})
panelGradient.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.08),
	NumberSequenceKeypoint.new(1, 0.32),
})
panelGradient.Parent = panel
UiTheme.AddSurfaceFinish(panel, {
	Accent = COLORS.Purple,
	Intensity = 0.7,
})

local panelSizeConstraint = Instance.new("UISizeConstraint")
panelSizeConstraint.MinSize = Vector2.new(320, 340)
panelSizeConstraint.MaxSize = Vector2.new(960, 466)
panelSizeConstraint.Parent = panel

local titleGemOuter = Instance.new("Frame")
titleGemOuter.Name = "TitleGemOuter"
titleGemOuter.AnchorPoint = Vector2.new(0.5, 0.5)
titleGemOuter.Position = UDim2.new(0.5, 0, 0, 0)
titleGemOuter.Size = UDim2.fromOffset(42, 42)
titleGemOuter.BackgroundColor3 = Color3.fromRGB(9, 11, 18)
titleGemOuter.BorderSizePixel = 0
titleGemOuter.Rotation = 45
titleGemOuter.ZIndex = 5
titleGemOuter.Parent = panel
addCorner(titleGemOuter, 6)
addStroke(titleGemOuter, COLORS.Purple, 0.14, 2)

local titleGem = Instance.new("Frame")
titleGem.Name = "TitleGem"
titleGem.AnchorPoint = Vector2.new(0.5, 0.5)
titleGem.Position = UDim2.new(0.5, 0, 0.5, 0)
titleGem.Size = UDim2.fromOffset(24, 24)
titleGem.BackgroundColor3 = COLORS.Purple
titleGem.BorderSizePixel = 0
titleGem.Rotation = 45
titleGem.ZIndex = 6
titleGem.Parent = titleGemOuter
addCorner(titleGem, 4)
addStroke(titleGem, COLORS.PurpleLight, 0.12, 1)

local titleLabel = createLabel(panel, "TitleLabel", "NIVEAU 1", Enum.Font.GothamBlack, 28, COLORS.Text)
titleLabel.Position = UDim2.fromOffset(22, 24)
titleLabel.Size = UDim2.new(1, -44, 0, 30)
titleLabel.TextXAlignment = Enum.TextXAlignment.Center

local subtitleLabel = createLabel(panel, "SubtitleLabel", "CHOISIS UNE AMELIORATION PERMANENTE", Enum.Font.GothamBold, 12, COLORS.PurpleLight)
subtitleLabel.Position = UDim2.fromOffset(22, 57)
subtitleLabel.Size = UDim2.new(1, -44, 0, 20)
subtitleLabel.TextXAlignment = Enum.TextXAlignment.Center

local rerollButton = Instance.new("TextButton")
rerollButton.Name = "RerollButton"
rerollButton.AnchorPoint = Vector2.new(0.5, 0)
rerollButton.Position = UDim2.new(0.5, 0, 0, 78)
rerollButton.Size = UDim2.fromOffset(190, 20)
rerollButton.BackgroundColor3 = Color3.fromRGB(63, 37, 92)
rerollButton.BackgroundTransparency = 0.16
rerollButton.BorderSizePixel = 0
rerollButton.AutoButtonColor = false
rerollButton.Font = Enum.Font.GothamBold
rerollButton.Text = "RELANCER (0)"
rerollButton.TextColor3 = COLORS.Text
rerollButton.TextSize = 10
rerollButton.Visible = false
rerollButton.Parent = panel
addCorner(rerollButton, 5)
addStroke(rerollButton, COLORS.PurpleLight, 0.28, 1)

local divider = Instance.new("Frame")
divider.Name = "Divider"
divider.Position = UDim2.new(0, 22, 0, 104)
divider.Size = UDim2.new(1, -44, 0, 1)
divider.BackgroundColor3 = COLORS.PurpleLight
divider.BackgroundTransparency = 0.7
divider.BorderSizePixel = 0
divider.Parent = panel

local optionsFrame = Instance.new("ScrollingFrame")
optionsFrame.Name = "Options"
optionsFrame.Position = UDim2.fromOffset(18, 122)
optionsFrame.Size = UDim2.new(1, -36, 1, -140)
optionsFrame.BackgroundTransparency = 1
optionsFrame.BorderSizePixel = 0
optionsFrame.CanvasSize = UDim2.fromOffset(0, 0)
optionsFrame.ScrollBarThickness = 4
optionsFrame.ScrollBarImageTransparency = 0.35
optionsFrame.ScrollBarImageColor3 = Color3.fromRGB(255, 255, 255)
optionsFrame.ScrollingEnabled = false
optionsFrame.Parent = panel

local optionsLayout = Instance.new("UIListLayout")
optionsLayout.FillDirection = Enum.FillDirection.Horizontal
optionsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
optionsLayout.VerticalAlignment = Enum.VerticalAlignment.Center
optionsLayout.Padding = UDim.new(0, 10)
optionsLayout.SortOrder = Enum.SortOrder.LayoutOrder
optionsLayout.Parent = optionsFrame

local currentChoiceId = nil
local isSubmitting = false
local isRerollPending = false
local optionButtons = {}

local function getRerollCredits()
	return math.max(0, math.floor(tonumber(player:GetAttribute("PerkRerollCredits")) or 0))
end

local function refreshRerollButton()
	local credits = getRerollCredits()
	local canReroll = screenGui.Enabled
		and currentChoiceId ~= nil
		and credits > 0
		and not isSubmitting
		and not isRerollPending

	rerollButton.Visible = screenGui.Enabled and currentChoiceId ~= nil
	rerollButton.Active = canReroll
	rerollButton.Selectable = canReroll
	rerollButton.Text = "RELANCER (" .. tostring(credits) .. ")"
	rerollButton.TextTransparency = if canReroll then 0 else 0.48
	rerollButton.BackgroundTransparency = if canReroll then 0.16 else 0.55
end

local function setEntryHover(entry, isHovered)
	if entry.Option == nil or isSubmitting then
		return
	end

	TweenService:Create(entry.Button, TWEEN_HOVER, {
		BackgroundColor3 = if isHovered then COLORS.CardHover else COLORS.Card,
	}):Play()
	TweenService:Create(entry.Scale, TWEEN_HOVER, {
		Scale = if isHovered then 1.025 else 1,
	}):Play()
	TweenService:Create(entry.Stroke, TWEEN_HOVER, {
		Transparency = if isHovered then 0.05 else 0.22,
		Thickness = if isHovered then 2.5 else 2,
	}):Play()
end

local function createOptionButton(index)
	local button = Instance.new("TextButton")
	button.Name = "Option" .. tostring(index)
	button.Size = UDim2.new(0.333, -7, 1, 0)
	button.BackgroundColor3 = COLORS.Card
	button.BackgroundTransparency = 0.2
	button.BorderSizePixel = 0
	button.AutoButtonColor = false
	button.Font = Enum.Font.GothamBold
	button.Text = ""
	button.Modal = true
	button.LayoutOrder = index
	button.Parent = optionsFrame
	addCorner(button, 8)

	local scale = Instance.new("UIScale")
	scale.Parent = button

	local gradient = createGradient(button)
	local stroke = addStroke(button, Color3.fromRGB(255, 255, 255), 0.22, 2)
	UiTheme.AddSurfaceFinish(button, {
		Accent = COLORS.PurpleLight,
		Intensity = 0.28,
	})

	local accent = Instance.new("Frame")
	accent.Name = "Accent"
	accent.Size = UDim2.new(1, 0, 0, 5)
	accent.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	accent.BorderSizePixel = 0
	accent.Parent = button
	addCorner(accent, 7)

	local rarityChip = Instance.new("Frame")
	rarityChip.Name = "RarityChip"
	rarityChip.Position = UDim2.fromOffset(12, 14)
	rarityChip.Size = UDim2.fromOffset(88, 21)
	rarityChip.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	rarityChip.BackgroundTransparency = 0.78
	rarityChip.BorderSizePixel = 0
	rarityChip.Parent = button
	addCorner(rarityChip, 5)

	local rarityLabel = createLabel(rarityChip, "Rarity", "COMMUN", Enum.Font.GothamBold, 10, COLORS.Text)
	rarityLabel.Size = UDim2.fromScale(1, 1)
	rarityLabel.TextXAlignment = Enum.TextXAlignment.Center

	local stackLabel = createLabel(button, "Stack", "NIV. 0 -> 1", Enum.Font.GothamBold, 10, COLORS.Muted)
	stackLabel.AnchorPoint = Vector2.new(1, 0)
	stackLabel.Position = UDim2.new(1, -12, 0, 14)
	stackLabel.Size = UDim2.fromOffset(92, 21)
	stackLabel.TextXAlignment = Enum.TextXAlignment.Right

	local iconFrame = Instance.new("Frame")
	iconFrame.Name = "PerkIcon"
	iconFrame.AnchorPoint = Vector2.new(0.5, 0)
	iconFrame.Position = UDim2.new(0.5, 0, 0, 42)
	iconFrame.Size = UDim2.fromOffset(88, 88)
	iconFrame.BackgroundColor3 = Color3.fromRGB(6, 10, 16)
	iconFrame.BackgroundTransparency = 0.16
	iconFrame.BorderSizePixel = 0
	iconFrame.ClipsDescendants = true
	iconFrame.Parent = button
	addCorner(iconFrame, 44)
	local iconStroke = addStroke(iconFrame, Color3.fromRGB(255, 255, 255), 0.22, 2)

	local iconGlow = Instance.new("Frame")
	iconGlow.Name = "Glow"
	iconGlow.AnchorPoint = Vector2.new(0.5, 0.5)
	iconGlow.Position = UDim2.new(0.5, 0, 0.5, 0)
	iconGlow.Size = UDim2.fromScale(1.34, 1.34)
	iconGlow.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	iconGlow.BackgroundTransparency = 0.8
	iconGlow.BorderSizePixel = 0
	iconGlow.ZIndex = 0
	iconGlow.Parent = iconFrame
	addCorner(iconGlow, 60)

	local iconImage = Instance.new("ImageLabel")
	iconImage.Name = "Image"
	iconImage.AnchorPoint = Vector2.new(0.5, 0.5)
	iconImage.Position = UDim2.new(0.5, 0, 0.5, 0)
	iconImage.Size = UDim2.new(1, -6, 1, -6)
	iconImage.BackgroundTransparency = 1
	iconImage.Image = ""
	iconImage.ScaleType = Enum.ScaleType.Fit
	iconImage.ZIndex = 2
	iconImage.Parent = iconFrame

	local iconFallback = createLabel(iconFrame, "Fallback", "*", Enum.Font.GothamBlack, 40, COLORS.Text)
	iconFallback.Size = UDim2.fromScale(1, 1)
	iconFallback.TextXAlignment = Enum.TextXAlignment.Center
	iconFallback.ZIndex = 1

	local nameLabel = createLabel(button, "PerkName", "Perk", Enum.Font.GothamBold, 18, COLORS.Text)
	nameLabel.Position = UDim2.fromOffset(12, 138)
	nameLabel.Size = UDim2.new(1, -24, 0, 40)
	nameLabel.TextWrapped = true
	nameLabel.TextTruncate = Enum.TextTruncate.None
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.TextYAlignment = Enum.TextYAlignment.Center

	local descriptionLabel = createLabel(button, "Description", "Description", Enum.Font.GothamMedium, 12, COLORS.Muted)
	descriptionLabel.Position = UDim2.fromOffset(12, 181)
	descriptionLabel.Size = UDim2.new(1, -24, 0, 31)
	descriptionLabel.TextWrapped = true
	descriptionLabel.TextTruncate = Enum.TextTruncate.None
	descriptionLabel.TextXAlignment = Enum.TextXAlignment.Center
	descriptionLabel.TextYAlignment = Enum.TextYAlignment.Top

	local previewHeader = createLabel(button, "PreviewHeader", "ACTUEL   ->   APRES CHOIX", Enum.Font.GothamBold, 9, COLORS.Muted)
	previewHeader.Position = UDim2.fromOffset(12, 218)
	previewHeader.Size = UDim2.new(1, -24, 0, 14)
	previewHeader.TextXAlignment = Enum.TextXAlignment.Center

	local previewFrame = Instance.new("Frame")
	previewFrame.Name = "Preview"
	previewFrame.Position = UDim2.fromOffset(12, 234)
	previewFrame.Size = UDim2.new(1, -24, 0, 45)
	previewFrame.BackgroundTransparency = 1
	previewFrame.BorderSizePixel = 0
	previewFrame.Parent = button

	local previewLayout = Instance.new("UIListLayout")
	previewLayout.FillDirection = Enum.FillDirection.Vertical
	previewLayout.Padding = UDim.new(0, 3)
	previewLayout.SortOrder = Enum.SortOrder.LayoutOrder
	previewLayout.Parent = previewFrame

	local footer = Instance.new("Frame")
	footer.Name = "Footer"
	footer.AnchorPoint = Vector2.new(0, 1)
	footer.Position = UDim2.new(0, 12, 1, -12)
	footer.Size = UDim2.new(1, -24, 0, 32)
	footer.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	footer.BackgroundTransparency = 0.72
	footer.BorderSizePixel = 0
	footer.Parent = button
	addCorner(footer, 6)
	local footerStroke = addStroke(footer, Color3.fromRGB(255, 255, 255), 0.4, 1)

	local footerLabel = createLabel(footer, "FooterLabel", "CHOISIR", Enum.Font.GothamBold, 12, COLORS.Text)
	footerLabel.Size = UDim2.fromScale(1, 1)
	footerLabel.TextXAlignment = Enum.TextXAlignment.Center

	local footerArrow = createLabel(footer, "FooterArrow", ">", Enum.Font.GothamBlack, 16, COLORS.Text)
	footerArrow.AnchorPoint = Vector2.new(1, 0)
	footerArrow.Position = UDim2.new(1, -10, 0, 6)
	footerArrow.Size = UDim2.fromOffset(18, 20)
	footerArrow.TextXAlignment = Enum.TextXAlignment.Right

	local entry = {
		Button = button,
		Scale = scale,
		Stroke = stroke,
		Gradient = gradient,
		Accent = accent,
		RarityChip = rarityChip,
		RarityLabel = rarityLabel,
		StackLabel = stackLabel,
		IconFrame = iconFrame,
		IconGlow = iconGlow,
		IconStroke = iconStroke,
		IconImage = iconImage,
		IconFallback = iconFallback,
		NameLabel = nameLabel,
		DescriptionLabel = descriptionLabel,
		PreviewFrame = previewFrame,
		Footer = footer,
		FooterStroke = footerStroke,
		FooterLabel = footerLabel,
		FooterArrow = footerArrow,
		Option = nil,
	}

	button.MouseEnter:Connect(function()
		setEntryHover(entry, true)
	end)

	button.MouseLeave:Connect(function()
		setEntryHover(entry, false)
	end)

	optionButtons[index] = entry
end

for index = 1, 3 do
	createOptionButton(index)
end

local function clearPreviewLines(entry)
	for _, child in ipairs(entry.PreviewFrame:GetChildren()) do
		if child.Name == "PreviewLine" then
			child:Destroy()
		end
	end
end

local function addPreviewLine(entry, line, index, rarityColor)
	local lineFrame = Instance.new("Frame")
	lineFrame.Name = "PreviewLine"
	lineFrame.Size = UDim2.new(1, 0, 0, 22)
	lineFrame.BackgroundColor3 = rarityColor
	lineFrame.BackgroundTransparency = 0.88
	lineFrame.BorderSizePixel = 0
	lineFrame.LayoutOrder = index
	lineFrame.Parent = entry.PreviewFrame
	addCorner(lineFrame, 4)

	local nameLabel = createLabel(lineFrame, "Name", line.Label or "Stat", Enum.Font.GothamMedium, 10, COLORS.Preview)
	nameLabel.Position = UDim2.fromOffset(6, 0)
	nameLabel.Size = UDim2.new(0.42, -6, 1, 0)
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left

	local currentLabel = createLabel(lineFrame, "Current", line.Current or "-", Enum.Font.GothamBold, 10, COLORS.PreviewCurrent)
	currentLabel.Position = UDim2.new(0.42, 0, 0, 0)
	currentLabel.Size = UDim2.new(0.21, 0, 1, 0)
	currentLabel.TextXAlignment = Enum.TextXAlignment.Right

	local arrowLabel = createLabel(lineFrame, "Arrow", ">", Enum.Font.GothamBold, 11, rarityColor)
	arrowLabel.Position = UDim2.new(0.63, 0, 0, 0)
	arrowLabel.Size = UDim2.new(0.1, 0, 1, 0)
	arrowLabel.TextXAlignment = Enum.TextXAlignment.Center

	local nextLabel = createLabel(lineFrame, "Next", line.Next or "-", Enum.Font.GothamBold, 10, COLORS.Text)
	nextLabel.Position = UDim2.new(0.73, 0, 0, 0)
	nextLabel.Size = UDim2.new(0.27, -6, 1, 0)
	nextLabel.TextXAlignment = Enum.TextXAlignment.Right
end

local function setButtonsEnabled(isEnabled)
	for _, entry in ipairs(optionButtons) do
		entry.Button.Active = isEnabled
		entry.Button.Selectable = isEnabled

		if not isEnabled then
			TweenService:Create(entry.Button, TWEEN_FAST, {
				BackgroundTransparency = 0.34,
			}):Play()
		else
			TweenService:Create(entry.Button, TWEEN_FAST, {
				BackgroundTransparency = 0.2,
			}):Play()
		end
	end

	refreshRerollButton()
end

local function getViewportSize()
	local camera = Workspace.CurrentCamera

	if camera == nil then
		return Vector2.new(1280, 720)
	end

	return camera.ViewportSize
end

local function updateResponsiveLayout()
	local viewportSize = getViewportSize()
	local useVerticalCards = viewportSize.X < 900

	if useVerticalCards then
		panel.Position = UDim2.new(0.5, 0, 0.5, 0)
		panel.Size = UDim2.new(0.9, 0, 0.84, 0)
		optionsLayout.FillDirection = Enum.FillDirection.Vertical
		optionsLayout.Padding = UDim.new(0, 8)
		optionsFrame.ScrollingEnabled = true
		optionsFrame.ScrollingDirection = Enum.ScrollingDirection.Y
		optionsFrame.AutomaticCanvasSize = Enum.AutomaticSize.Y
		optionsFrame.CanvasSize = UDim2.fromOffset(0, 0)

		for _, entry in ipairs(optionButtons) do
			entry.Button.Size = UDim2.new(1, -6, 0, 310)
		end
	else
		panel.Position = UDim2.new(0.5, 0, 0.5, 0)
		panel.Size = UDim2.new(0.66, 0, 0, 446)
		optionsLayout.FillDirection = Enum.FillDirection.Horizontal
		optionsLayout.Padding = UDim.new(0, 10)
		optionsFrame.ScrollingEnabled = false
		optionsFrame.AutomaticCanvasSize = Enum.AutomaticSize.None
		optionsFrame.CanvasSize = UDim2.fromOffset(0, 0)

		for _, entry in ipairs(optionButtons) do
			entry.Button.Size = UDim2.new(0.333, -7, 1, 0)
		end
	end
end

local function getTitle(payload)
	if payload.Title ~= nil and payload.Title ~= "" then
		return string.upper(tostring(payload.Title))
	end

	return "NIVEAU " .. tostring(payload.Level or "?")
end

local function hideChoices()
	currentChoiceId = nil
	isSubmitting = false
	isRerollPending = false
	screenGui.Enabled = false
	setButtonsEnabled(true)
	DebugLog.Info("Perks", "UI choix perk cachee", {
		Player = player.Name,
	})
end

local function showChoices(payload)
	payload = payload or {}
	local choices = payload.Choices or {}

	currentChoiceId = payload.ChoiceId
	isSubmitting = false
	isRerollPending = false
	titleLabel.Text = getTitle(payload)
	subtitleLabel.Text = "CHOISIS UNE AMELIORATION PERMANENTE"
	screenGui.Enabled = true
	setButtonsEnabled(true)
	updateResponsiveLayout()

	DebugLog.Info("Perks", "UI choix perk affichee", {
		Player = player.Name,
		ChoiceId = payload.ChoiceId,
		Title = payload.Title,
		Level = payload.Level,
		Choices = #choices,
	})

	for index, entry in ipairs(optionButtons) do
		local option = choices[index]
		entry.Option = option

		if option == nil then
			entry.Button.Visible = false
		else
			local rarityColor = option.RarityColor or Color3.fromRGB(255, 255, 255)
			local rarityName = string.upper(option.RarityName or option.Rarity or "Commun")

			entry.Button.Visible = true
			entry.RarityLabel.Text = rarityName
			entry.RarityLabel.TextColor3 = rarityColor
			entry.StackLabel.Text = ("NIV. %s -> %s"):format(option.CurrentStacks or 0, option.NextStacks or 1)
			entry.NameLabel.Text = option.Name or "Perk"
			entry.DescriptionLabel.Text = option.Description or ""
			entry.Accent.BackgroundColor3 = rarityColor
			entry.RarityChip.BackgroundColor3 = rarityColor
			entry.Stroke.Color = rarityColor
			entry.IconGlow.BackgroundColor3 = rarityColor
			entry.IconStroke.Color = rarityColor
			entry.FooterLabel.TextColor3 = rarityColor
			entry.FooterArrow.TextColor3 = rarityColor
			entry.Footer.BackgroundColor3 = rarityColor
			entry.FooterStroke.Color = rarityColor

			local iconAssetId = (PerkIconConfig.AssetIds or {})[option.PerkId] or ""
			entry.IconImage.Image = iconAssetId
			entry.IconImage.Visible = iconAssetId ~= ""
			entry.IconFallback.Visible = iconAssetId == ""
			entry.IconFallback.Text = string.upper(string.sub(option.Name or "P", 1, 1))
			entry.IconFallback.TextColor3 = rarityColor
			entry.Gradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, rarityColor:Lerp(COLORS.Card, 0.8)),
				ColorSequenceKeypoint.new(0.62, COLORS.Card),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(10, 15, 24)),
			})

			clearPreviewLines(entry)

			local previewLines = option.PreviewLines or {}

			for previewIndex, line in ipairs(previewLines) do
				addPreviewLine(entry, line, previewIndex, rarityColor)
			end
		end
	end

	refreshRerollButton()
end

for _, entry in ipairs(optionButtons) do
	entry.Button.Activated:Connect(function()
		if isSubmitting or currentChoiceId == nil or entry.Option == nil then
			return
		end

		isSubmitting = true
		setButtonsEnabled(false)
		DebugLog.Info("Perks", "UI choix perk envoye", {
			Player = player.Name,
			ChoiceId = currentChoiceId,
			OptionId = entry.Option.OptionId,
			PerkId = entry.Option.PerkId,
		})
		selectChoiceRemote:FireServer(currentChoiceId, entry.Option.OptionId)
	end)
end

rerollButton.Activated:Connect(function()
	if currentChoiceId == nil or isSubmitting or isRerollPending or getRerollCredits() <= 0 then
		return
	end

	isRerollPending = true
	refreshRerollButton()
	DebugLog.Info("Perks", "UI reroll perk envoye", {
		Player = player.Name,
		ChoiceId = currentChoiceId,
	})
	rerollChoiceRemote:FireServer(currentChoiceId)

	task.delay(2, function()
		if isRerollPending then
			isRerollPending = false
			refreshRerollButton()
		end
	end)
end)

showChoicesRemote.OnClientEvent:Connect(showChoices)
hideChoicesRemote.OnClientEvent:Connect(hideChoices)
player:GetAttributeChangedSignal("PerkRerollCredits"):Connect(refreshRerollButton)

if Workspace.CurrentCamera ~= nil then
	Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateResponsiveLayout)
end

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	if Workspace.CurrentCamera ~= nil then
		Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateResponsiveLayout)
	end

	updateResponsiveLayout()
end)

hideChoices()
updateResponsiveLayout()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="137">
          <Properties>
            <string name="Name">PickupFeedbackUI</string>
            <string name="Source"><![CDATA[--!strict

-- Confirmation locale de gains et d'evenements deja valides par le serveur.
-- Ce script ne modifie jamais les PV, boucliers, degats, score ou ressources.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local PickupFeedbackConfig = require(Shared:WaitForChild("PickupFeedbackConfig"))
local UiTheme = require(Shared:WaitForChild("UiTheme"))

local player = Players.LocalPlayer
local pickupRemote = ReplicatedStorage:WaitForChild(PickupFeedbackConfig.RemoteName) :: RemoteEvent

type FeedbackKind =
	"Coin"
	| "Xp"
	| "Kill"
	| "ArcaneGem"
	| "Run"
	| "HealRegen"
	| "HealInstant"
	| "Shield"
	| "LifeStealHit"
	| "LifeStealDot"
	| "MaxHealth"
	| "Critical"
	| "Poison"

type PopupRoute = "Bottom" | "Top" | "Combat"

type PendingFeedback = {
	Amount: number,
	DueAt: number,
	Kind: FeedbackKind,
}

type PopupPresentation = {
	Accent: Color3,
	AmountPrefix: string?,
	AmountSuffix: string?,
	Glyph: string?,
	GlyphSize: number?,
	Icon: string?,
	IconWidth: number,
	Label: string?,
	Route: PopupRoute,
	TargetId: string?,
	UsesRunScoreIcon: boolean?,
}

type ActivePopup = {
	ArrivalSignaled: boolean,
	Frame: Frame,
	Kind: FeedbackKind,
	Lane: number,
	Presentation: PopupPresentation,
	StartedAt: number,
}

local pendingPickups: { PendingFeedback } = {}
local activePopups: { ActivePopup } = {}
local popupIndex = 0

local hudTargetNames: { [string]: string } = {
	Health = "HpGroup",
	Shield = "ShieldGroup",
	Xp = "XpPanel",
	ArcaneGem = "ArcaneSlot",
	Kill = "KillsSlot",
	Coin = "GoldSlot",
	RunScore = "RunScoreSlot",
}

local playerGui = player:WaitForChild("PlayerGui")
local gui = Instance.new("ScreenGui")
gui.Name = "PickupFeedbackUI"
gui.DisplayOrder = 70
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
gui.Parent = playerGui

local container = Instance.new("Frame")
container.Name = "PopupLayer"
container.BackgroundTransparency = 1
container.BorderSizePixel = 0
container.Size = UDim2.fromScale(1, 1)
container.Active = false
container.Parent = gui

local function addCorner(instance: Instance, radius: number)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius)
	corner.Parent = instance
end

local function formatAmount(amount: number): string
	local roundedAmount = math.max(0, math.floor(amount + 0.5))

	if roundedAmount >= 1_000_000 then
		return string.format("%.1fM", roundedAmount / 1_000_000)
	end

	if roundedAmount >= 1_000 then
		return string.format("%.1fK", roundedAmount / 1_000)
	end

	return tostring(roundedAmount)
end

local function getPlayerScreenPosition(): Vector2
	local camera = Workspace.CurrentCamera
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if camera ~= nil and root ~= nil and root:IsA("BasePart") then
		local projected, inFront = camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3.1, 0))

		if inFront then
			return Vector2.new(projected.X, projected.Y)
		end
	end

	if camera ~= nil then
		return camera.ViewportSize * 0.5
	end

	return Vector2.new(640, 360)
end

local function getViewportSize(): Vector2
	local camera = Workspace.CurrentCamera

	if camera ~= nil then
		return camera.ViewportSize
	end

	return Vector2.new(1280, 720)
end

local function setPopupTransparency(frame: Frame, transparency: number)
	frame.BackgroundTransparency = 1

	for _, descendant in ipairs(frame:GetDescendants()) do
		if descendant:IsA("TextLabel") then
			descendant.TextTransparency = transparency
			descendant.TextStrokeTransparency = math.min(1, 0.18 + (transparency * 0.82))
		elseif descendant:IsA("ImageLabel") then
			descendant.ImageTransparency = transparency
		end
	end
end

local function getPopupPresentation(kind: FeedbackKind): PopupPresentation
	if kind == "Coin" then
		return {
			Accent = UiTheme.Colors.Gold,
			Icon = UiTheme.Icons.Gold,
			IconWidth = 34,
			Route = "Top",
			TargetId = "Coin",
		}
	end

	if kind == "Kill" then
		return {
			Accent = UiTheme.Colors.Kills,
			Icon = UiTheme.Icons.Kills,
			IconWidth = 34,
			Route = "Top",
			TargetId = "Kill",
		}
	end

	if kind == "ArcaneGem" then
		return {
			Accent = UiTheme.Colors.Arcane,
			Icon = UiTheme.Icons.ArcaneGem,
			IconWidth = 34,
			Route = "Top",
			TargetId = "ArcaneGem",
		}
	end

	if kind == "Run" then
		return {
			Accent = UiTheme.Colors.RunScore,
			IconWidth = 34,
			Route = "Top",
			TargetId = "RunScore",
			UsesRunScoreIcon = true,
		}
	end

	if kind == "HealRegen" then
		return {
			Accent = UiTheme.Colors.Health,
			AmountSuffix = " PV",
			Icon = UiTheme.Icons.Health,
			IconWidth = 34,
			Route = "Bottom",
			TargetId = "Health",
		}
	end

	if kind == "HealInstant" then
		return {
			Accent = UiTheme.Colors.Health,
			AmountSuffix = " SOIN",
			Icon = UiTheme.Icons.Health,
			IconWidth = 34,
			Route = "Bottom",
			TargetId = "Health",
		}
	end

	if kind == "LifeStealHit" then
		return {
			Accent = UiTheme.Colors.Health,
			AmountSuffix = " VDV",
			Icon = UiTheme.Icons.Health,
			IconWidth = 34,
			Route = "Bottom",
			TargetId = "Health",
		}
	end

	if kind == "LifeStealDot" then
		return {
			Accent = UiTheme.Colors.Health,
			AmountSuffix = " VDV DOT",
			Icon = UiTheme.Icons.Health,
			IconWidth = 34,
			Route = "Bottom",
			TargetId = "Health",
		}
	end

	if kind == "MaxHealth" then
		return {
			Accent = UiTheme.Colors.Health,
			AmountPrefix = "PV MAX +",
			Icon = UiTheme.Icons.Health,
			IconWidth = 34,
			Route = "Bottom",
			TargetId = "Health",
		}
	end

	if kind == "Shield" then
		return {
			Accent = UiTheme.Colors.Shield,
			AmountSuffix = " BOUCLIER",
			Icon = UiTheme.Icons.Shield,
			IconWidth = 34,
			Route = "Bottom",
			TargetId = "Shield",
		}
	end

	if kind == "Critical" then
		return {
			Accent = UiTheme.Colors.Critical,
			AmountPrefix = "CRIT ",
			IconWidth = 0,
			Route = "Combat",
		}
	end

	if kind == "Poison" then
		return {
			Accent = UiTheme.Colors.Poison,
			IconWidth = 0,
			Label = "POISON",
			Route = "Combat",
		}
	end

	return {
		Accent = UiTheme.Colors.Xp,
		Glyph = "XP",
		GlyphSize = 17,
		IconWidth = 34,
		Route = "Bottom",
		TargetId = "Xp",
	}
end

local function createRunScoreIcon(parent: Instance, color: Color3)
	local holder = Instance.new("Frame")
	holder.Name = "RunScoreIcon"
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Size = UDim2.fromOffset(30, 30)
	holder.Position = UDim2.fromOffset(0, 4)
	holder.ZIndex = 5
	holder.Parent = parent

	local iconId = UiTheme.Icons.RunScore

	if iconId ~= nil and iconId ~= "" then
		local image = Instance.new("ImageLabel")
		image.BackgroundTransparency = 1
		image.Image = iconId
		image.ScaleType = Enum.ScaleType.Fit
		image.Size = UDim2.fromScale(1, 1)
		image.Parent = holder
		return holder
	end

	for index, definition in ipairs({
		{ Position = UDim2.fromScale(0.25, 0.28), Rotation = -22 },
		{ Position = UDim2.fromScale(0.66, 0.64), Rotation = 22 },
	}) do
		local footprint = Instance.new("Frame")
		footprint.Name = "Footprint" .. tostring(index)
		footprint.AnchorPoint = Vector2.new(0.5, 0.5)
		footprint.Position = definition.Position
		footprint.Size = UDim2.fromScale(0.3, 0.54)
		footprint.BackgroundColor3 = color
		footprint.BorderSizePixel = 0
		footprint.Rotation = definition.Rotation
		footprint.Parent = holder
		addCorner(footprint, 8)
	end

	return holder
end

local function getPopupText(presentation: PopupPresentation, amount: number): string
	if presentation.Label ~= nil then
		return presentation.Label
	end

	local prefix = presentation.AmountPrefix or "+"
	local suffix = presentation.AmountSuffix or ""
	return prefix .. formatAmount(amount) .. suffix
end

local function createPopup(kind: FeedbackKind, amount: number): ActivePopup
	popupIndex += 1

	local presentation = getPopupPresentation(kind)
	local frame = Instance.new("Frame")
	frame.Name = kind .. "Popup"
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Size = UDim2.fromOffset(PickupFeedbackConfig.PopupWidth, PickupFeedbackConfig.PopupHeight)
	frame.ZIndex = 4
	frame.Parent = container

	local scale = Instance.new("UIScale")
	scale.Name = "Scale"
	scale.Scale = 0.8
	scale.Parent = frame

	if presentation.UsesRunScoreIcon then
		createRunScoreIcon(frame, presentation.Accent)
	elseif presentation.Icon ~= nil and presentation.Icon ~= "" then
		local image = Instance.new("ImageLabel")
		image.Name = kind .. "Icon"
		image.BackgroundTransparency = 1
		image.Image = presentation.Icon
		image.Size = UDim2.fromOffset(30, 30)
		image.Position = UDim2.fromOffset(0, 4)
		image.ScaleType = Enum.ScaleType.Fit
		image.ZIndex = 5
		image.Parent = frame
	elseif presentation.Glyph ~= nil then
		local glyph = Instance.new("TextLabel")
		glyph.Name = kind .. "Glyph"
		glyph.BackgroundTransparency = 1
		glyph.Font = UiTheme.Fonts.Heavy
		glyph.Text = presentation.Glyph
		glyph.TextColor3 = presentation.Accent
		glyph.TextSize = presentation.GlyphSize or 17
		glyph.TextStrokeColor3 = UiTheme.Colors.Shadow
		glyph.TextStrokeTransparency = 0.18
		glyph.TextXAlignment = Enum.TextXAlignment.Center
		glyph.Size = UDim2.fromOffset(32, 30)
		glyph.Position = UDim2.fromOffset(0, 4)
		glyph.ZIndex = 5
		glyph.Parent = frame
	end

	local amountLabel = Instance.new("TextLabel")
	amountLabel.Name = "Amount"
	amountLabel.BackgroundTransparency = 1
	amountLabel.Font = UiTheme.Fonts.Heavy
	amountLabel.Text = getPopupText(presentation, amount)
	amountLabel.TextColor3 = presentation.Accent
	amountLabel.TextSize = if presentation.Route == "Combat" then 23 else 21
	amountLabel.TextStrokeColor3 = UiTheme.Colors.Shadow
	amountLabel.TextStrokeTransparency = 0.18
	amountLabel.TextXAlignment = Enum.TextXAlignment.Left
	amountLabel.Size = UDim2.new(1, -(presentation.IconWidth + 4), 1, 0)
	amountLabel.Position = UDim2.fromOffset(presentation.IconWidth + 4, 0)
	amountLabel.ZIndex = 5
	amountLabel.Parent = frame

	return {
		ArrivalSignaled = false,
		Frame = frame,
		Kind = kind,
		Lane = ((popupIndex - 1) % 5) - 2,
		Presentation = presentation,
		StartedAt = os.clock(),
	}
end

local function queuePickup(kind: FeedbackKind, amount: number, arrivalTime: number?)
	local now = Workspace:GetServerTimeNow()
	local dueAt = math.max(now, arrivalTime or now)

	for index = #pendingPickups, 1, -1 do
		local pending = pendingPickups[index]

		if pending.Kind == kind and math.abs(pending.DueAt - dueAt) <= PickupFeedbackConfig.CoalesceWindow then
			pending.Amount += amount
			pending.DueAt = math.max(pending.DueAt, dueAt)
			return
		end
	end

	table.insert(pendingPickups, {
		Amount = amount,
		DueAt = dueAt,
		Kind = kind,
	})
end

local function onPickup(payload: unknown)
	if typeof(payload) ~= "table" then
		return
	end

	local kind = payload.Kind
	local amount = payload.Amount

	if
		(kind ~= "Coin" and kind ~= "Xp" and kind ~= "Kill" and kind ~= "ArcaneGem" and kind ~= "Run"
			and kind ~= "HealRegen" and kind ~= "HealInstant" and kind ~= "Shield" and kind ~= "LifeStealHit"
			and kind ~= "LifeStealDot" and kind ~= "MaxHealth" and kind ~= "Critical" and kind ~= "Poison")
		or typeof(amount) ~= "number"
	then
		return
	end

	local sanitizedAmount = math.max(0, amount)

	if sanitizedAmount <= 0 then
		return
	end

	DebugLog.ThrottledInfo("UI", "pickup_feedback_" .. tostring(kind), 0.5, "Feedback popup recu", {
		Amount = sanitizedAmount,
		Kind = kind,
	})

	queuePickup(kind :: FeedbackKind, sanitizedAmount, typeof(payload.ArrivalTime) == "number" and payload.ArrivalTime or nil)
end

local function getTargetScreenPosition(targetId: string?, route: PopupRoute): Vector2
	if targetId ~= nil then
		local combatGui = playerGui:FindFirstChild("CombatGui")
		local targetName = hudTargetNames[targetId]

		if combatGui ~= nil and targetName ~= nil then
			local target = combatGui:FindFirstChild(targetName, true)

			if target ~= nil and target:IsA("GuiObject") and target.Visible then
				return target.AbsolutePosition + (target.AbsoluteSize * 0.5)
			end
		end
	end

	local viewport = getViewportSize()

	if route == "Top" then
		return Vector2.new(viewport.X * 0.5, 34)
	end

	return Vector2.new(viewport.X * 0.5, viewport.Y - 58)
end

local function signalHudArrival(targetId: string?)
	if targetId == nil then
		return
	end

	local combatGui = playerGui:FindFirstChild("CombatGui")
	local feedbackEvent = combatGui and combatGui:FindFirstChild("FeedbackArrived")

	if feedbackEvent ~= nil and feedbackEvent:IsA("BindableEvent") then
		feedbackEvent:Fire(targetId)
	end
end

local function smoothstep(value: number): number
	local clamped = math.clamp(value, 0, 1)
	return clamped * clamped * (3 - (2 * clamped))
end

pickupRemote.OnClientEvent:Connect(onPickup)

RunService.RenderStepped:Connect(function()
	local now = os.clock()
	local serverNow = Workspace:GetServerTimeNow()

	for index = #pendingPickups, 1, -1 do
		if #activePopups >= PickupFeedbackConfig.PopupMaxActive or pendingPickups[index].DueAt > serverNow then
			continue
		end

		local pending = table.remove(pendingPickups, index)
		local success, popupOrError = pcall(createPopup, pending.Kind, pending.Amount)

		if success then
			table.insert(activePopups, popupOrError :: ActivePopup)
		else
			DebugLog.ThrottledWarn("UI", "pickup_feedback_create_failed", 1, "Creation popup impossible", {
				Error = tostring(popupOrError),
				Kind = pending.Kind,
			})
		end
	end

	for index = #activePopups, 1, -1 do
		local popup = activePopups[index]
		local elapsed = now - popup.StartedAt
		local alpha = math.clamp(elapsed / PickupFeedbackConfig.PopupDuration, 0, 1)

		if alpha >= 1 then
			popup.Frame:Destroy()
			table.remove(activePopups, index)
			continue
		end

		local scale = popup.Frame:FindFirstChild("Scale")

		if scale ~= nil and scale:IsA("UIScale") then
			scale.Scale = 0.76 + (math.sin(math.min(alpha, 0.22) / 0.22 * math.pi * 0.5) * 0.24)
		end

		local presentation = popup.Presentation
		local anchor = getPlayerScreenPosition()
		local horizontalOffset = popup.Lane * 32
		local position: Vector2
		local fade: number

		if presentation.Route == "Combat" then
			local rise = PickupFeedbackConfig.PopupRisePixels * alpha
			position = Vector2.new(anchor.X + 72 + horizontalOffset, anchor.Y - 12 - rise)
			fade = math.clamp((alpha - 0.56) / 0.44, 0, 1)
		else
			local initialPosition: Vector2

			if presentation.Route == "Top" then
				initialPosition = Vector2.new(anchor.X - 68 + horizontalOffset, anchor.Y - 4)
			else
				initialPosition = Vector2.new(anchor.X + horizontalOffset, anchor.Y + 36)
			end

			local travelStart = math.clamp(tonumber(PickupFeedbackConfig.ResourceTravelStart) or 0.42, 0, 0.9)
			local travelProgress = smoothstep((alpha - travelStart) / math.max(0.01, 1 - travelStart))
			local targetPosition = getTargetScreenPosition(presentation.TargetId, presentation.Route)
			position = initialPosition:Lerp(targetPosition, travelProgress)
			fade = math.clamp((alpha - 0.78) / 0.22, 0, 1)

			local arrivalAt = math.clamp(tonumber(PickupFeedbackConfig.ResourceArrivalAt) or 0.9, travelStart, 0.99)

			if not popup.ArrivalSignaled and alpha >= arrivalAt then
				popup.ArrivalSignaled = true
				signalHudArrival(presentation.TargetId)
			end
		end

		setPopupTransparency(popup.Frame, fade)
		popup.Frame.Position = UDim2.fromOffset(position.X, position.Y)
	end
end)

DebugLog.Info("UI", "Controleur de popups initialise", {
	Remote = pickupRemote.Name,
})
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="138">
          <Properties>
            <string name="Name">PlayerController</string>
            <string name="Source"><![CDATA[-- Controle local du joueur.
-- Le serveur reste la source de verite pour les pauses, les perks et les mouvements autorises.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local RunLoadingConfig = require(Shared:WaitForChild("RunLoadingConfig"))

type ControlState = "Lobby" | "Loading" | "Run" | "Paused" | "Respawning"

local controls = nil
local currentHumanoid = nil
local currentState: ControlState? = nil
local isRunActive = player:GetAttribute("IsRunActive") == true
local isRunLoading = player:GetAttribute(RunLoadingConfig.AttributeName) == true
local isCombatPaused = player:GetAttribute("IsCombatPaused") == true
local humanoidDiedConnection = nil

local function getControls()
	if controls ~= nil then
		return controls
	end

	local playerScripts = player:WaitForChild("PlayerScripts")
	local playerModule = require(playerScripts:WaitForChild("PlayerModule"))
	controls = playerModule:GetControls()

	return controls
end

local function getControlState(): ControlState
	if currentHumanoid == nil or currentHumanoid.Parent == nil or currentHumanoid.Health <= 0 then
		return "Respawning"
	end

	if isRunLoading then
		return "Loading"
	end

	if isRunActive and isCombatPaused then
		return "Paused"
	end

	if isRunActive then
		return "Run"
	end

	return "Lobby"
end

local function restoreCameraSubject()
	local camera = Workspace.CurrentCamera

	if camera == nil or currentHumanoid == nil or currentHumanoid.Parent == nil then
		return
	end

	-- Ne touche pas a une camera de cinematique volontairement definie par un futur systeme.
	if camera.CameraType == Enum.CameraType.Custom
		and (camera.CameraSubject == nil or camera.CameraSubject.Parent == nil)
	then
		camera.CameraSubject = currentHumanoid
	end
end

local function refreshControls()
	local nextState = getControlState()
	local nextControlsEnabled = nextState == "Lobby" or nextState == "Run"

	getControls():Enable(nextControlsEnabled)
	restoreCameraSubject()

	if currentState ~= nextState then
		currentState = nextState
		DebugLog.Info("PlayerControl", "Etat de controle joueur mis a jour", {
			Player = player.Name,
			State = nextState,
			ControlsEnabled = nextControlsEnabled,
		})
	end
end

local function bindCharacter(character)
	if humanoidDiedConnection ~= nil then
		humanoidDiedConnection:Disconnect()
		humanoidDiedConnection = nil
	end

	local humanoid = character:WaitForChild("Humanoid", 8)

	if humanoid == nil or not humanoid:IsA("Humanoid") then
		currentHumanoid = nil
		refreshControls()
		return
	end

	currentHumanoid = humanoid
	humanoidDiedConnection = humanoid.Died:Connect(function()
		refreshControls()
	end)

	task.defer(function()
		restoreCameraSubject()
		refreshControls()
	end)
end

local function bindPauseState()
	local pauseRemote = ReplicatedStorage:WaitForChild("Combat_PauseState", 20)

	if pauseRemote == nil or not pauseRemote:IsA("RemoteEvent") then
		DebugLog.Warn("PlayerControl", "Remote de pause introuvable")
		return
	end

	pauseRemote.OnClientEvent:Connect(function(payload)
		payload = payload or {}
		isCombatPaused = payload.IsPaused == true
		refreshControls()
	end)
end

player.CharacterAdded:Connect(bindCharacter)

if player.Character ~= nil then
	task.defer(bindCharacter, player.Character)
end

player:GetAttributeChangedSignal("IsRunActive"):Connect(function()
	isRunActive = player:GetAttribute("IsRunActive") == true
	refreshControls()
end)

player:GetAttributeChangedSignal(RunLoadingConfig.AttributeName):Connect(function()
	isRunLoading = player:GetAttribute(RunLoadingConfig.AttributeName) == true
	refreshControls()
end)

player:GetAttributeChangedSignal("IsCombatPaused"):Connect(function()
	isCombatPaused = player:GetAttribute("IsCombatPaused") == true
	refreshControls()
end)

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(restoreCameraSubject)

task.spawn(bindPauseState)

DebugLog.Info("PlayerControl", "Controleur joueur initialise", {
	Player = player.Name,
})
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="139">
          <Properties>
            <string name="Name">ProjectileVfxController</string>
            <string name="Source"><![CDATA[-- Presentation locale des projectiles. Le serveur garde toute la logique de combat.

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local VfxConfig = require(Shared:WaitForChild("VfxConfig"))

local VfxQualityController = require(script.Parent:WaitForChild("VfxQualityController"))

VfxQualityController.Start()

local activeStates = {}
local observedConnections = {}
local packagePool = {}
local activeImpactStates = {}
local impactPool = {}
local pilotStatesBySerial = {}
local packageSerial = 0
local impactSerial = 0
local runtimeFolder = nil
local poolAnchor = nil
local impactPoolFolder = nil
local activeImpactFolder = nil

local function colorSequence(firstColor, secondColor)
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, firstColor),
		ColorSequenceKeypoint.new(1, secondColor),
	})
end

local function numberSequence(firstValue, secondValue)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, firstValue),
		NumberSequenceKeypoint.new(1, secondValue),
	})
end

local function getOrCreateFolder(parent, name)
	local folder = parent:FindFirstChild(name)

	if folder == nil then
		folder = Instance.new("Folder")
		folder.Name = name
		folder.Parent = parent
	end

	return folder
end

local function setupRuntime()
	if runtimeFolder ~= nil and runtimeFolder.Parent ~= nil then
		return
	end

	runtimeFolder = getOrCreateFolder(Workspace, VfxConfig.RuntimeFolderName)
	impactPoolFolder = getOrCreateFolder(runtimeFolder, "ImpactPool")
	activeImpactFolder = getOrCreateFolder(runtimeFolder, "Impacts")

	poolAnchor = runtimeFolder:FindFirstChild("PoolAnchor")

	if poolAnchor == nil then
		local anchor = Instance.new("Part")
		anchor.Name = "PoolAnchor"
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanTouch = false
		anchor.CanQuery = false
		anchor.CastShadow = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(0.1, 0.1, 0.1)
		anchor.CFrame = CFrame.new(0, -10000, 0)
		anchor.Parent = runtimeFolder
		poolAnchor = anchor
	end
end

local function findRoot(projectile)
	if projectile:IsA("BasePart") then
		return projectile
	end

	if not projectile:IsA("Model") then
		return nil
	end

	if projectile.PrimaryPart ~= nil then
		return projectile.PrimaryPart
	end

	return projectile:FindFirstChildWhichIsA("BasePart", true)
end

local function createAttachment(name, parent)
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.Parent = parent
	return attachment
end

local function createEmitter(name, parent, lockedToPart)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.LockedToPart = lockedToPart ~= false
	emitter.VelocityInheritance = 0
	emitter.LightInfluence = 0
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-70, 70)
	emitter.Parent = parent
	return emitter
end

local function createVisualPackage()
	setupRuntime()
	packageSerial += 1

	local front = createAttachment("ProjectileVfxFront", poolAnchor)
	local back = createAttachment("ProjectileVfxBack", poolAnchor)
	local trail = Instance.new("Trail")
	trail.Name = "ProjectileVfxTrail"
	trail.Attachment0 = front
	trail.Attachment1 = back
	trail.FaceCamera = true
	trail.LightEmission = 0.45
	trail.MinLength = 0.05
	trail.Enabled = false
	trail.Parent = poolAnchor

	local flameShell = createEmitter("ProjectileVfxFlameShell", front)
	local flameTail = createEmitter("ProjectileVfxFlameTail", back, false)
	local smoke = createEmitter("ProjectileVfxSmoke", back)
	local spark = createEmitter("ProjectileVfxSpark", front)
	flameShell.Enabled = false
	flameTail.Enabled = false
	smoke.Enabled = false
	spark.Enabled = false

	local light = Instance.new("PointLight")
	light.Name = "ProjectileVfxLight"
	light.Shadows = false
	light.Enabled = false
	light.Parent = poolAnchor

	CollectionService:AddTag(trail, VfxConfig.TelemetryTag)
	CollectionService:AddTag(flameShell, VfxConfig.TelemetryTag)
	CollectionService:AddTag(flameTail, VfxConfig.TelemetryTag)
	CollectionService:AddTag(smoke, VfxConfig.TelemetryTag)
	CollectionService:AddTag(spark, VfxConfig.TelemetryTag)
	CollectionService:AddTag(light, VfxConfig.TelemetryTag)

	return {
		Id = packageSerial,
		Front = front,
		Back = back,
		Trail = trail,
		FlameShell = flameShell,
		FlameTail = flameTail,
		Smoke = smoke,
		Spark = spark,
		Light = light,
	}
end

local function acquireVisualPackage()
	local package = table.remove(packagePool)

	if package ~= nil then
		return package
	end

	return createVisualPackage()
end

local function disableEmitter(emitter)
	emitter.Enabled = false
	emitter:Clear()
end

local function releaseVisualPackage(package)
	if package == nil then
		return
	end

	setupRuntime()
	disableEmitter(package.FlameShell)
	disableEmitter(package.FlameTail)
	disableEmitter(package.Smoke)
	disableEmitter(package.Spark)
	package.Trail.Enabled = false
	package.Light.Enabled = false
	package.Light.Parent = poolAnchor
	package.Trail.Parent = poolAnchor
	package.Front.Parent = poolAnchor
	package.Back.Parent = poolAnchor
	table.insert(packagePool, package)
end

local function configureFlameShell(emitter, profile, rateScale)
	emitter.Texture = profile.FlameTexture
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Orientation = Enum.ParticleOrientation.FacingCamera
	emitter.Color = colorSequence(profile.AccentColor, profile.TrailColor)
	emitter.LightEmission = 0.38
	emitter.Rate = profile.FlameShellRate * rateScale
	emitter.Lifetime = NumberRange.new(0.13, 0.22)
	emitter.Speed = NumberRange.new(0.01, 0.08)
	emitter.Size = numberSequence(profile.FlameShellStartSize, 0.22)
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.18),
		NumberSequenceKeypoint.new(0.42, 0.08),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Enabled = rateScale > 0
end

local function configureFlameTail(emitter, profile, rateScale)
	emitter.Texture = profile.FlameTexture
	emitter.EmissionDirection = Enum.NormalId.Back
	emitter.SpreadAngle = Vector2.new(28, 28)
	emitter.Orientation = Enum.ParticleOrientation.FacingCamera
	emitter.Color = colorSequence(profile.CoreColor, profile.TrailColor)
	emitter.LightEmission = 0.24
	emitter.VelocityInheritance = 0.06
	emitter.Rate = profile.FlameTailRate * rateScale
	emitter.Lifetime = NumberRange.new(0.2, 0.34)
	emitter.Speed = NumberRange.new(0.65, 1.35)
	emitter.Size = numberSequence(profile.FlameTailStartSize, 0.14)
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.3),
		NumberSequenceKeypoint.new(0.36, 0.12),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Enabled = rateScale > 0
end

local function configureSmoke(emitter, profile, rateScale)
	emitter.Texture = profile.SmokeTexture
	emitter.EmissionDirection = Enum.NormalId.Back
	emitter.SpreadAngle = Vector2.new(80, 80)
	emitter.Color = colorSequence(profile.CoreColor, profile.SmokeColor)
	emitter.LightEmission = 0.08
	emitter.Rate = profile.SmokeRate * rateScale
	emitter.Lifetime = NumberRange.new(0.28, 0.5)
	emitter.Speed = NumberRange.new(0.08, 0.32)
	emitter.Size = numberSequence(0.28, 0.78)
	emitter.Transparency = numberSequence(0.72, 1)
	emitter.Enabled = rateScale > 0
end

local function configureSpark(emitter, profile, rateScale)
	emitter.Texture = profile.SparkTexture
	emitter.EmissionDirection = Enum.NormalId.Back
	emitter.SpreadAngle = Vector2.new(110, 110)
	emitter.Color = colorSequence(profile.AccentColor, profile.CoreColor)
	emitter.LightEmission = 0.35
	emitter.Rate = profile.SparkleRate * rateScale
	emitter.Lifetime = NumberRange.new(0.1, 0.19)
	emitter.Speed = NumberRange.new(0.1, 0.55)
	emitter.Size = numberSequence(0.1, 0)
	emitter.Transparency = numberSequence(0.08, 1)
	emitter.Enabled = rateScale > 0
end

local function configurePackage(state, lod, settings)
	local package = state.Package
	local profile = state.Profile
	local root = state.Root

	if root == nil or root.Parent == nil then
		return
	end

	package.Front.Parent = root
	package.Back.Parent = root
	package.Trail.Parent = root
	package.Light.Parent = root
	package.Front.Position = Vector3.new(0, 0, 0.42)
	package.Back.Position = Vector3.new(0, 0, -0.72)

	local intensity = settings.EffectsIntensity
	local hasDecorativeEffects = intensity >= 0.08 and lod ~= "Minimal"
	local isFull = lod == "Full"
	local rateScale = if isFull then intensity else intensity * 0.35

	package.Trail.Color = colorSequence(profile.AccentColor, profile.TrailColor)
	package.Trail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.54),
		NumberSequenceKeypoint.new(0.45, 0.24),
		NumberSequenceKeypoint.new(1, 0),
	})
	package.Trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.26),
		NumberSequenceKeypoint.new(0.7, 0.62),
		NumberSequenceKeypoint.new(1, 1),
	})
	package.Trail.Lifetime = profile.TrailLifetime * if isFull then 1 else 0.55
	package.Trail.Enabled = hasDecorativeEffects

	if hasDecorativeEffects then
		configureFlameShell(package.FlameShell, profile, rateScale)
	else
		disableEmitter(package.FlameShell)
	end

	if isFull and hasDecorativeEffects then
		configureFlameTail(package.FlameTail, profile, rateScale)
	else
		disableEmitter(package.FlameTail)
	end

	if isFull and hasDecorativeEffects then
		configureSmoke(package.Smoke, profile, rateScale)
		configureSpark(package.Spark, profile, rateScale)
	else
		disableEmitter(package.Smoke)
		disableEmitter(package.Spark)
	end

	package.Light.Color = profile.AccentColor
	package.Light.Range = profile.LightRange
	package.Light.Brightness = profile.LightBrightness * intensity
	package.Light.Enabled = isFull and intensity >= 0.12
	state.Lod = lod
end

local function getSortedStates()
	local states = {}

	for _, state in pairs(activeStates) do
		if state.Projectile.Parent ~= nil then
			table.insert(states, state)
		end
	end

	table.sort(states, function(left, right)
		return left.VisualSerial < right.VisualSerial
	end)

	return states
end

local function refreshProjectileBudgets()
	local settings = VfxQualityController.GetSettings()
	local profile = settings.Profile
	local fullCount = 0
	local reducedCount = 0

	for _, state in ipairs(getSortedStates()) do
		local lod = "Minimal"

		if settings.EffectsIntensity >= 0.08 and fullCount < profile.FullProjectileLimit then
			lod = "Full"
			fullCount += 1
		elseif settings.EffectsIntensity >= 0.08 and reducedCount < profile.ReducedProjectileLimit then
			lod = "Reduced"
			reducedCount += 1
		end

		configurePackage(state, lod, settings)
	end

	DebugLog.ThrottledInfo("Vfx", "projectile_budget", 5, "Budget projectiles applique", {
		Quality = settings.Quality,
		Full = fullCount,
		Reduced = reducedCount,
		Minimal = math.max(0, #getSortedStates() - fullCount - reducedCount),
		Pool = #packagePool,
	})
end

local function disconnectObserved(projectile)
	local connections = observedConnections[projectile]

	if connections == nil then
		return
	end

	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end

	observedConnections[projectile] = nil
end

local function releaseProjectileState(projectile)
	local state = activeStates[projectile]

	if state == nil then
		return
	end

	activeStates[projectile] = nil
	releaseVisualPackage(state.Package)
	refreshProjectileBudgets()
end

local function isLocalRuntimeProjectile(projectile)
	return projectile:GetAttribute("RuntimeProjectile") == true
		and projectile:GetAttribute("ProjectileOwnerUserId") == player.UserId
		and typeof(projectile:GetAttribute("VfxProfileId")) == "string"
end

local function attachProjectile(projectile)
	if activeStates[projectile] ~= nil or not isLocalRuntimeProjectile(projectile) then
		return
	end

	local root = findRoot(projectile)

	if root == nil then
		return
	end

	local visualSerial = math.max(0, math.floor(tonumber(projectile:GetAttribute("ProjectileVisualSerial")) or 0))
	local profileId = projectile:GetAttribute("VfxProfileId")
	local state = {
		Projectile = projectile,
		Root = root,
		Profile = VfxConfig.GetProjectileProfile(profileId),
		VisualSerial = visualSerial,
		Package = acquireVisualPackage(),
		Lod = "Minimal",
	}

	activeStates[projectile] = state
	refreshProjectileBudgets()
end

local function observeProjectile(projectile)
	if observedConnections[projectile] ~= nil then
		attachProjectile(projectile)
		return
	end

	local function refresh()
		if isLocalRuntimeProjectile(projectile) then
			attachProjectile(projectile)
		else
			releaseProjectileState(projectile)
		end
	end

	observedConnections[projectile] = {
		projectile:GetAttributeChangedSignal("RuntimeProjectile"):Connect(refresh),
		projectile:GetAttributeChangedSignal("ProjectileOwnerUserId"):Connect(refresh),
		projectile:GetAttributeChangedSignal("VfxProfileId"):Connect(refresh),
		projectile.AncestryChanged:Connect(function()
			if projectile.Parent == nil then
				releaseProjectileState(projectile)
				disconnectObserved(projectile)
			end
		end),
	}

	task.defer(refresh)
end

local function clampPilotDirection(direction)
	local minimumVerticalDirection = CombatConfig.FireballMinimumVerticalDirection or -0.05

	if direction.Y >= minimumVerticalDirection then
		return direction.Unit
	end

	return Vector3.new(direction.X, minimumVerticalDirection, direction.Z).Unit
end

local function getPilotTargetPosition(state)
	local targetRoot = state.TargetRoot

	if typeof(targetRoot) == "Instance" and targetRoot.Parent ~= nil then
		local targetPart = findRoot(targetRoot)

		if targetPart ~= nil then
			return targetPart.Position
		end
	end

	return state.TargetPosition
end

local function releasePilotState(visualSerial)
	local state = pilotStatesBySerial[visualSerial]

	if state == nil then
		return
	end

	pilotStatesBySerial[visualSerial] = nil
	releaseProjectileState(state.Core)

	if state.Core.Parent ~= nil then
		state.Core:Destroy()
	end
end

local function advancePilotState(state, deltaTime)
	if deltaTime <= 0 then
		return
	end

	state.Age += deltaTime

	if state.Age >= state.Lifetime then
		releasePilotState(state.VisualSerial)
		return
	end

	local targetPosition = getPilotTargetPosition(state)
	local desiredDirection = targetPosition - state.Position

	if desiredDirection.Magnitude > 0.1 then
		local targetDirection = desiredDirection.Unit
		local sideDirection = Vector3.new(-targetDirection.Z, 0, targetDirection.X)

		if sideDirection.Magnitude <= 0.001 then
			sideDirection = Vector3.new(1, 0, 0)
		else
			sideDirection = sideDirection.Unit
		end

		local speedRatio = math.max(0.25, state.Speed / math.max(1, CombatConfig.FireballSpeed))
		local curveDuration = math.max(0.08, (CombatConfig.FireballCurveDuration or 1) / speedRatio)
		local curveProgress = math.clamp((state.Age - state.HomingDelay) / curveDuration, 0, 1)
		local curveWeight = (1 - curveProgress) * (CombatConfig.FireballCurveStrength or 0)
		local pattern = state.FlightPattern
		local oscillation = state.FlightPhase
			+ (state.Age * (CombatConfig.FireballCurveFrequency or 1) * pattern.FrequencyMultiplier)
		local lateralCurve = math.sin(oscillation) * curveWeight * pattern.SideMultiplier
		local verticalCurve = math.cos(oscillation * 0.82) * (CombatConfig.FireballVerticalCurveStrength or 0)
			* curveWeight
			* pattern.VerticalMultiplier
		local curvedDirection = clampPilotDirection(
			targetDirection + (sideDirection * lateralCurve) + Vector3.new(0, verticalCurve, 0)
		)
		local steeringWeight = 0.2 + (0.8 * curveProgress)
		local homingAlpha = math.clamp(
			deltaTime * (CombatConfig.FireballHomingStrength or 1) * math.sqrt(speedRatio) * steeringWeight,
			0,
			1
		)
		state.Direction = clampPilotDirection(state.Direction:Lerp(curvedDirection, homingAlpha))
	end

	state.Position += state.Direction * state.Speed * deltaTime

	if state.Core.Parent ~= nil then
		state.Core.CFrame = CFrame.lookAt(state.Position, state.Position + state.Direction)
	end
end

local function spawnPilotProjectile(payload)
	if typeof(payload) ~= "table"
		or typeof(payload.VisualSerial) ~= "number"
		or typeof(payload.Position) ~= "Vector3"
		or typeof(payload.Direction) ~= "Vector3"
		or typeof(payload.TargetPosition) ~= "Vector3"
	then
		return
	end

	local visualSerial = math.max(0, math.floor(payload.VisualSerial))
	releasePilotState(visualSerial)
	setupRuntime()

	local profile = VfxConfig.GetProjectileProfile(payload.ProfileId)
	local core = Instance.new("Part")
	core.Name = "ClientProjectileCore"
	core.Shape = Enum.PartType.Ball
	core.Size = if typeof(payload.CoreSize) == "Vector3" then payload.CoreSize else Vector3.new(1.4, 1.4, 1.4)
	core.Material = Enum.Material.Neon
	core.Color = profile.CoreColor
	core.Transparency = profile.CoreTransparency
	core.Anchored = true
	core.CanCollide = false
	core.CanTouch = false
	core.CanQuery = false
	core.CastShadow = false
	core.CFrame = CFrame.lookAt(payload.Position, payload.Position + payload.Direction)
	core:SetAttribute("RuntimeProjectile", true)
	core:SetAttribute("ProjectileOwnerUserId", player.UserId)
	core:SetAttribute("VfxProfileId", payload.ProfileId)
	core:SetAttribute("ProjectileVisualSerial", visualSerial)
	core.Parent = runtimeFolder

	local flightPattern = if typeof(payload.FlightPattern) == "table" then payload.FlightPattern else {}
	local state = {
		VisualSerial = visualSerial,
		Core = core,
		Position = payload.Position,
		Direction = clampPilotDirection(payload.Direction),
		TargetPosition = payload.TargetPosition,
		TargetRoot = payload.TargetRoot,
		Speed = math.max(1, tonumber(payload.Speed) or 58),
		Lifetime = math.max(0.1, tonumber(payload.Lifetime) or 3.8),
		HomingDelay = math.max(0, tonumber(payload.HomingDelay) or 0.22),
		FlightPattern = {
			SideMultiplier = tonumber(flightPattern.SideMultiplier) or 1,
			VerticalMultiplier = tonumber(flightPattern.VerticalMultiplier) or 1,
			FrequencyMultiplier = tonumber(flightPattern.FrequencyMultiplier) or 1,
		},
		FlightPhase = tonumber(payload.FlightPhase) or 0,
		Age = 0,
	}

	pilotStatesBySerial[visualSerial] = state
	attachProjectile(core)

	local serverStartTime = tonumber(payload.ServerStartTime)
	if serverStartTime ~= nil then
		local elapsed = math.clamp(Workspace:GetServerTimeNow() - serverStartTime, 0, 0.25)
		local remaining = elapsed

		while remaining > 0 and pilotStatesBySerial[visualSerial] == state do
			local step = math.min(remaining, 1 / 60)
			advancePilotState(state, step)
			remaining -= step
		end
	end
end

local function retargetPilotProjectile(payload)
	if typeof(payload) ~= "table"
		or typeof(payload.VisualSerial) ~= "number"
		or typeof(payload.Position) ~= "Vector3"
		or typeof(payload.Direction) ~= "Vector3"
		or typeof(payload.TargetPosition) ~= "Vector3"
	then
		return
	end

	local visualSerial = math.max(0, math.floor(payload.VisualSerial))
	local state = pilotStatesBySerial[visualSerial]

	if state == nil then
		return
	end

	state.Position = payload.Position
	state.Direction = clampPilotDirection(payload.Direction)
	state.TargetPosition = payload.TargetPosition
	state.TargetRoot = payload.TargetRoot

	if state.Core.Parent ~= nil then
		state.Core.CFrame = CFrame.lookAt(state.Position, state.Position + state.Direction)
	end
end

local function updatePilotProjectiles(deltaTime)
	for visualSerial, state in pairs(pilotStatesBySerial) do
		if state.Core.Parent == nil then
			pilotStatesBySerial[visualSerial] = nil
			releaseProjectileState(state.Core)
		else
			advancePilotState(state, math.min(deltaTime, 0.05))
		end
	end
end

local function createImpactPart()
	setupRuntime()
	local impact = Instance.new("Part")
	impact.Name = "ProjectileImpactVfx"
	impact.Shape = Enum.PartType.Ball
	impact.Material = Enum.Material.Neon
	impact.Anchored = true
	impact.CanCollide = false
	impact.CanTouch = false
	impact.CanQuery = false
	impact.CastShadow = false
	impact.Transparency = 1

	local light = Instance.new("PointLight")
	light.Name = "ImpactLight"
	light.Shadows = false
	light.Enabled = false
	light.Parent = impact
	CollectionService:AddTag(light, VfxConfig.TelemetryTag)

	impact.Parent = impactPoolFolder
	return impact
end

local function acquireImpact()
	local impact = table.remove(impactPool)

	if impact ~= nil then
		return impact
	end

	return createImpactPart()
end

local function releaseImpact(impact, serial)
	local state = activeImpactStates[impact]

	if state == nil or state.Serial ~= serial then
		return
	end

	activeImpactStates[impact] = nil
	impact.Transparency = 1
	impact.Parent = impactPoolFolder
	local light = impact:FindFirstChild("ImpactLight")

	if light ~= nil and light:IsA("PointLight") then
		light.Enabled = false
	end

	table.insert(impactPool, impact)
end

local function getImpactLod(settings)
	local fullCount = 0
	local reducedCount = 0
	local minimalCount = 0

	for _, state in pairs(activeImpactStates) do
		if state.Lod == "Full" then
			fullCount += 1
		elseif state.Lod == "Reduced" then
			reducedCount += 1
		elseif state.Lod == "Minimal" then
			minimalCount += 1
		end
	end

	if settings.EffectsIntensity < 0.08 then
		if minimalCount < settings.Profile.FullImpactLimit then
			return "Minimal"
		end

		return nil
	end

	if fullCount < settings.Profile.FullImpactLimit then
		return "Full"
	end

	if reducedCount < settings.Profile.ReducedImpactLimit then
		return "Reduced"
	end

	return nil
end

local function playImpact(payload)
	if typeof(payload) ~= "table" or payload.Type ~= "Impact" or typeof(payload.Position) ~= "Vector3" then
		return
	end

	local settings = VfxQualityController.GetSettings()
	local lod = getImpactLod(settings)

	if lod == nil then
		DebugLog.ThrottledInfo("Vfx", "impact_budget", 3, "Impact VFX ignore par budget", {
			Quality = settings.Quality,
		})
		return
	end

	local profile = VfxConfig.GetProjectileProfile(payload.ProfileId)
	local impact = acquireImpact()
	impactSerial += 1
	local serial = impactSerial
	local scale = if lod == "Full" then 1 elseif lod == "Reduced" then 0.72 else 0.48
	local duration = profile.ImpactLifetime

	impact.CFrame = CFrame.new(payload.Position)
	impact.Color = profile.AccentColor
	impact.Size = Vector3.new(profile.ImpactStartSize, profile.ImpactStartSize, profile.ImpactStartSize) * scale
	impact.Transparency = if lod == "Minimal" then 0.56 else 0.24
	impact.Parent = activeImpactFolder

	local light = impact:FindFirstChild("ImpactLight")

	if light ~= nil and light:IsA("PointLight") then
		light.Color = profile.AccentColor
		light.Range = profile.ImpactEndSize * 2 * scale
		light.Brightness = if lod == "Full" then 0.9 * settings.EffectsIntensity else 0
		light.Enabled = lod == "Full" and settings.EffectsIntensity >= 0.12
	end

	activeImpactStates[impact] = {
		Serial = serial,
		Lod = lod,
	}

	TweenService:Create(impact, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(profile.ImpactEndSize, profile.ImpactEndSize, profile.ImpactEndSize) * scale,
		Transparency = 1,
	}):Play()

	task.delay(duration, function()
		releaseImpact(impact, serial)
	end)
end

local function connectProjectileFolder()
	local runtime = Workspace:WaitForChild("CombatRuntime", 30)

	if runtime == nil then
		DebugLog.Warn("Vfx", "CombatRuntime introuvable pour les VFX projectile")
		return
	end

	local projectiles = runtime:WaitForChild("Projectiles", 30)

	if projectiles == nil then
		DebugLog.Warn("Vfx", "Dossier Projectiles introuvable pour les VFX projectile")
		return
	end

	for _, projectile in ipairs(projectiles:GetChildren()) do
		observeProjectile(projectile)
	end

	projectiles.ChildAdded:Connect(observeProjectile)
	projectiles.ChildRemoved:Connect(function(projectile)
		releaseProjectileState(projectile)
		disconnectObserved(projectile)
	end)
end

VfxQualityController.Changed.Event:Connect(refreshProjectileBudgets)
RunService.RenderStepped:Connect(updatePilotProjectiles)

local impactRemote = ReplicatedStorage:WaitForChild(VfxConfig.ImpactRemoteName, 30)

if impactRemote ~= nil and impactRemote:IsA("RemoteEvent") then
	impactRemote.OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end

		if payload.Type == "ProjectileSpawn" then
			spawnPilotProjectile(payload)
		elseif payload.Type == "ProjectileRetarget" then
			retargetPilotProjectile(payload)
		elseif payload.Type == "ProjectileDestroy" then
			releasePilotState(math.max(0, math.floor(tonumber(payload.VisualSerial) or 0)))
		else
			playImpact(payload)
		end
	end)
else
	DebugLog.Warn("Vfx", "Remote des impacts projectile introuvable", {
		Remote = VfxConfig.ImpactRemoteName,
	})
end

task.spawn(connectProjectileFolder)

DebugLog.Info("Vfx", "Controleur VFX projectile initialise", {
	Player = player.Name,
})
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="140">
          <Properties>
            <string name="Name">RunAnimationController</string>
            <string name="Source"><![CDATA[-- Course locale additive. Le serveur conserve integralement le mouvement et les etats du Humanoid.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))

type JointMap = {
	Root: Motor6D?,
	Waist: Motor6D?,
	Neck: Motor6D?,
	LeftShoulder: Motor6D?,
	RightShoulder: Motor6D?,
	LeftElbow: Motor6D?,
	RightElbow: Motor6D?,
	LeftHip: Motor6D?,
	RightHip: Motor6D?,
	LeftKnee: Motor6D?,
	RightKnee: Motor6D?,
	LeftAnkle: Motor6D?,
	RightAnkle: Motor6D?,
}

local RENDER_STEP_NAME = "MegaRobloxRunAnimation"
local currentCharacter: Model? = nil
local currentHumanoid: Humanoid? = nil
local joints: JointMap? = nil
local strideTime = 0
local currentState = "Unavailable"

local function setAnimationState(state: string)
	if currentState == state then
		return
	end

	currentState = state

	if currentCharacter ~= nil and currentCharacter.Parent ~= nil then
		-- Attribut local de diagnostic : il permet de verifier le cycle sans bruit console.
		currentCharacter:SetAttribute("MegaRobloxRunAnimationState", state)
	end
end

local function findJointByPart1(character: Model, names: { string }): Motor6D?
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("Motor6D") and descendant.Part1 ~= nil then
			for _, name in ipairs(names) do
				if descendant.Part1.Name == name then
					return descendant
				end
			end
		end
	end

	return nil
end

local function getJointMap(character: Model): JointMap
	return {
		Root = findJointByPart1(character, { "LowerTorso", "Torso" }),
		Waist = findJointByPart1(character, { "UpperTorso" }),
		Neck = findJointByPart1(character, { "Head" }),
		LeftShoulder = findJointByPart1(character, { "LeftUpperArm", "Left Arm" }),
		RightShoulder = findJointByPart1(character, { "RightUpperArm", "Right Arm" }),
		LeftElbow = findJointByPart1(character, { "LeftLowerArm" }),
		RightElbow = findJointByPart1(character, { "RightLowerArm" }),
		LeftHip = findJointByPart1(character, { "LeftUpperLeg", "Left Leg" }),
		RightHip = findJointByPart1(character, { "RightUpperLeg", "Right Leg" }),
		LeftKnee = findJointByPart1(character, { "LeftLowerLeg" }),
		RightKnee = findJointByPart1(character, { "RightLowerLeg" }),
		LeftAnkle = findJointByPart1(character, { "LeftFoot" }),
		RightAnkle = findJointByPart1(character, { "RightFoot" }),
	}
end

local function isGrounded(humanoid: Humanoid): boolean
	local state = humanoid:GetState()

	return humanoid.FloorMaterial ~= Enum.Material.Air
		and state ~= Enum.HumanoidStateType.Jumping
		and state ~= Enum.HumanoidStateType.Freefall
		and state ~= Enum.HumanoidStateType.Climbing
		and state ~= Enum.HumanoidStateType.Swimming
end

local function getMoveSpeed(humanoid: Humanoid, character: Model): number
	local root = character:FindFirstChild("HumanoidRootPart")

	if root ~= nil and root:IsA("BasePart") then
		local horizontalVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
		return horizontalVelocity.Magnitude
	end

	return humanoid.MoveDirection.Magnitude * humanoid.WalkSpeed
end

local function blendJoint(joint: Motor6D?, target: CFrame, alpha: number)
	if joint ~= nil and joint.Parent ~= nil then
		joint.Transform = joint.Transform:Lerp(target, alpha)
	end
end

local function resetPose(jointMap: JointMap, alpha: number)
	blendJoint(jointMap.Root, CFrame.new(), alpha)
	blendJoint(jointMap.Waist, CFrame.new(), alpha)
	blendJoint(jointMap.Neck, CFrame.new(), alpha)
	blendJoint(jointMap.LeftShoulder, CFrame.new(), alpha)
	blendJoint(jointMap.RightShoulder, CFrame.new(), alpha)
	blendJoint(jointMap.LeftElbow, CFrame.new(), alpha)
	blendJoint(jointMap.RightElbow, CFrame.new(), alpha)
	blendJoint(jointMap.LeftHip, CFrame.new(), alpha)
	blendJoint(jointMap.RightHip, CFrame.new(), alpha)
	blendJoint(jointMap.LeftKnee, CFrame.new(), alpha)
	blendJoint(jointMap.RightKnee, CFrame.new(), alpha)
	blendJoint(jointMap.LeftAnkle, CFrame.new(), alpha)
	blendJoint(jointMap.RightAnkle, CFrame.new(), alpha)
end

local function updateRunPose(deltaTime: number)
	local character = currentCharacter
	local humanoid = currentHumanoid
	local jointMap = joints

	if character == nil or humanoid == nil or jointMap == nil then
		setAnimationState("Unavailable")
		return
	end

	local speed = getMoveSpeed(humanoid, character)
	local minimumSpeed = math.max(0.1, CombatConfig.PlayerRunAnimationMinSpeed or 2.5)
	local blendAlpha = math.clamp(deltaTime * math.max(1, CombatConfig.PlayerRunAnimationBlendSpeed or 12), 0, 1)
	local isRunning = CombatConfig.PlayerRunAnimationEnabled == true
		and humanoid.MoveDirection.Magnitude > 0.05
		and speed >= minimumSpeed
		and isGrounded(humanoid)

	if not isRunning then
		resetPose(jointMap, blendAlpha)
		setAnimationState(CombatConfig.PlayerRunAnimationEnabled == true and "Idle" or "Disabled")
		return
	end

	setAnimationState("Running")

	local maxSpeed = math.max(minimumSpeed + 0.1, humanoid.WalkSpeed)
	local intensity = math.clamp((speed - minimumSpeed) / (maxSpeed - minimumSpeed), 0.38, 1)
	local strideHz = CombatConfig.PlayerRunAnimationBaseStrideHz
		+ ((CombatConfig.PlayerRunAnimationMaxStrideHz - CombatConfig.PlayerRunAnimationBaseStrideHz) * intensity)

	strideTime += deltaTime * strideHz * math.pi * 2

	local stride = math.sin(strideTime)
	local counterStride = -stride
	local lift = math.abs(math.cos(strideTime))
	local armDegrees = CombatConfig.PlayerRunAnimationArmDegrees * intensity
	local legDegrees = CombatConfig.PlayerRunAnimationLegDegrees * intensity
	local kneeDegrees = CombatConfig.PlayerRunAnimationKneeDegrees * intensity
	local torsoLeanRadians = math.rad(CombatConfig.PlayerRunAnimationTorsoLeanDegrees * intensity)
	local bob = (lift - 0.5) * 0.055 * intensity

	blendJoint(
		jointMap.Root,
		CFrame.new(0, bob, 0) * CFrame.Angles(torsoLeanRadians * 0.45, 0, math.rad(stride * 1.2 * intensity)),
		blendAlpha
	)
	blendJoint(
		jointMap.Waist,
		CFrame.Angles(-torsoLeanRadians, 0, math.rad(counterStride * 2.2 * intensity)),
		blendAlpha
	)
	blendJoint(jointMap.Neck, CFrame.Angles(math.rad(3 * intensity), 0, math.rad(stride * 1.4 * intensity)), blendAlpha)

	blendJoint(jointMap.LeftShoulder, CFrame.Angles(math.rad(counterStride * armDegrees), 0, math.rad(-8 * intensity)), blendAlpha)
	blendJoint(jointMap.RightShoulder, CFrame.Angles(math.rad(stride * armDegrees), 0, math.rad(8 * intensity)), blendAlpha)
	blendJoint(jointMap.LeftElbow, CFrame.Angles(math.rad(-12 - (math.max(0, counterStride) * 9)), 0, 0), blendAlpha)
	blendJoint(jointMap.RightElbow, CFrame.Angles(math.rad(-12 - (math.max(0, stride) * 9)), 0, 0), blendAlpha)

	blendJoint(jointMap.LeftHip, CFrame.Angles(math.rad(stride * legDegrees), 0, 0), blendAlpha)
	blendJoint(jointMap.RightHip, CFrame.Angles(math.rad(counterStride * legDegrees), 0, 0), blendAlpha)
	blendJoint(jointMap.LeftKnee, CFrame.Angles(math.rad(math.max(0, counterStride) * kneeDegrees), 0, 0), blendAlpha)
	blendJoint(jointMap.RightKnee, CFrame.Angles(math.rad(math.max(0, stride) * kneeDegrees), 0, 0), blendAlpha)
	blendJoint(jointMap.LeftAnkle, CFrame.Angles(math.rad(math.max(0, stride) * -8), 0, 0), blendAlpha)
	blendJoint(jointMap.RightAnkle, CFrame.Angles(math.rad(math.max(0, counterStride) * -8), 0, 0), blendAlpha)
end

local function bindCharacter(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 8)

	if humanoid == nil or not humanoid:IsA("Humanoid") then
		return
	end

	currentCharacter = character
	currentHumanoid = humanoid
	joints = getJointMap(character)
	strideTime = 0
	setAnimationState("Ready")
end

player.CharacterAdded:Connect(bindCharacter)

if player.Character ~= nil then
	task.defer(bindCharacter, player.Character)
end

RunService:BindToRenderStep(RENDER_STEP_NAME, Enum.RenderPriority.Character.Value + 1, updateRunPose)

script.Destroying:Connect(function()
	RunService:UnbindFromRenderStep(RENDER_STEP_NAME)
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="141">
          <Properties>
            <string name="Name">RunBarsV2Adapter</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local RunItemConfig = require(Shared:WaitForChild("RunItemConfig"))
local UiTheme = require(Shared:WaitForChild("UiTheme"))
local UiTemplateConfig = require(Shared:WaitForChild("UiTemplateConfig"))

local PRODUCTION_TEMPLATE_GUI_NAME = UiTemplateConfig.ProductionTemplateGuiName

local function findPath(root, names)
	local current = root

	for _, name in ipairs(names) do
		local directChild = current:FindFirstChild(name)
		current = directChild or current:FindFirstChild(name, true)

		if current == nil then
			return nil
		end
	end

	return current
end

local function getTextLabel(root, names)
	local instance = findPath(root, names)

	if instance and instance:IsA("TextLabel") then
		return instance
	end

	return nil
end

local function getGuiObject(root, names)
	local instance = findPath(root, names)

	if instance and instance:IsA("GuiObject") then
		return instance
	end

	return nil
end

local function getFrame(root, names)
	local instance = findPath(root, names)

	if instance and instance:IsA("Frame") then
		return instance
	end

	return nil
end

local function getItemRarityColor(definition)
	if definition and type(definition.Rarity) == "string" then
		return UiTheme.Rarities[definition.Rarity] or UiTheme.Colors.GlassTint
	end

	return UiTheme.Colors.GlassTint
end

local function bindText(source, target)
	if source == nil or target == nil then
		return
	end

	local function copyText()
		target.Text = source.Text
	end

	copyText()
	source:GetPropertyChangedSignal("Text"):Connect(copyText)
end

local function bindBar(sourceFill, targetFill)
	if sourceFill == nil or targetFill == nil then
		return
	end

	local function copyProgress()
		targetFill.Size = sourceFill.Size
	end

	copyProgress()
	sourceFill:GetPropertyChangedSignal("Size"):Connect(copyProgress)
end

local function getOrCreateScale(parent, name)
	local scale = parent:FindFirstChild(name)

	if scale and scale:IsA("UIScale") then
		return scale
	end

	local created = Instance.new("UIScale")
	created.Name = name
	created.Parent = parent
	return created
end

local function configureTopBarLayout(topDock, topContent)
	local timerSlot = topContent:FindFirstChild("TimerSlot")
	local leftCluster = topContent:FindFirstChild("LeftCluster")
	local rightCluster = topContent:FindFirstChild("RightCluster")
	local pauseControl = topDock:FindFirstChild("PauseControl")

	if
		not (timerSlot and timerSlot:IsA("Frame"))
		or not (leftCluster and leftCluster:IsA("Frame"))
		or not (rightCluster and rightCluster:IsA("Frame"))
	then
		return
	end

	local leftScale = getOrCreateScale(leftCluster, "ClusterScale")
	local rightScale = getOrCreateScale(rightCluster, "ClusterScale")
	local pauseButton = pauseControl and pauseControl:FindFirstChild("PauseButton")
	local hexCore = pauseControl and pauseControl:FindFirstChild("HexCore")

	local function updateLayout()
		local availableWidth = math.max(1, topContent.AbsoluteSize.X)
		local topHeight = math.max(1, topDock.AbsoluteSize.Y)
		local timerWidth = 136
		local middleGap = 18
		local groupWidth = math.max(1, (availableWidth - timerWidth - (middleGap * 2)) * 0.5)
		local leftFactor = math.clamp(groupWidth / 294, 0.42, 1)
		local rightFactor = math.clamp(groupWidth / 342, 0.42, 1)
		local pauseSize = math.clamp(math.floor(topHeight * 0.64 + 0.5), 34, 46)
		local pauseGap = math.clamp(math.floor(topHeight * 0.13 + 0.5), 5, 10)

		leftScale.Scale = leftFactor
		rightScale.Scale = rightFactor
		leftCluster.Position = UDim2.new(0, 0, 0.5, 0)
		rightCluster.Position = UDim2.new(1, -(342 * rightFactor), 0.5, 0)

		timerSlot.AnchorPoint = Vector2.new(0.5, 0.5)
		timerSlot.Position = UDim2.fromScale(0.5, 0.5)
		timerSlot.Size = UDim2.new(0, timerWidth, 1, 0)

		if pauseControl and pauseControl:IsA("Frame") then
			pauseControl.AnchorPoint = Vector2.new(0.5, 0)
			pauseControl.Position = UDim2.fromScale(0.5, 0)
			pauseControl.Size = UDim2.new(0, timerWidth, 0, topHeight + pauseGap + pauseSize)
		end

		if hexCore and hexCore:IsA("GuiObject") then
			hexCore.AnchorPoint = Vector2.new(0.5, 0)
			hexCore.Position = UDim2.fromScale(0.5, 0)
			hexCore.Size = UDim2.new(0, timerWidth, 0, topHeight)
		end

		if pauseButton and pauseButton:IsA("GuiObject") then
			pauseButton.AnchorPoint = Vector2.new(0.5, 0)
			pauseButton.Position = UDim2.new(0.5, 0, 0, topHeight + pauseGap)
			pauseButton.Size = UDim2.fromOffset(pauseSize, pauseSize)
		end
	end

	topContent:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLayout)
	topDock:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLayout)
	task.defer(updateLayout)
end

local function setSlotEmpty(slot)
	slot:SetAttribute("ObjectId", "")
	slot:SetAttribute("Count", 0)
	slot.BackgroundTransparency = 0.64

	local icon = slot:FindFirstChild("ItemIcon")
	if icon and icon:IsA("ImageLabel") then
		icon.Visible = false
		icon.Image = ""
	end

	local count = slot:FindFirstChild("Count")
	if count and count:IsA("TextLabel") then
		count.Visible = false
		count.Text = ""
	end

	local stroke = slot:FindFirstChild("SlotStroke")
	if stroke and stroke:IsA("UIStroke") then
		stroke.Color = Color3.fromRGB(55, 76, 104)
		stroke.Transparency = 0.72
	end
end

local function setSlotItem(slot, definition, stacks)
	local rarityColor = getItemRarityColor(definition)

	slot:SetAttribute("ObjectId", definition.Id)
	slot:SetAttribute("Count", stacks)
	slot.BackgroundTransparency = 0.08

	local icon = slot:FindFirstChild("ItemIcon")
	if icon and icon:IsA("ImageLabel") then
		icon.Image = definition.Icon
		icon.Visible = true
	end

	local count = slot:FindFirstChild("Count")
	if count and count:IsA("TextLabel") then
		count.Text = "x" .. tostring(stacks)
		count.Visible = true
	end

	local stroke = slot:FindFirstChild("SlotStroke")
	if stroke and stroke:IsA("UIStroke") then
		stroke.Color = rarityColor
		stroke.Transparency = 0.12
	end
end

local function initialise()
	local combatGui = playerGui:WaitForChild("CombatGui", 30)
	local templateGui = playerGui:WaitForChild(PRODUCTION_TEMPLATE_GUI_NAME, 30)

	if combatGui == nil or templateGui == nil or not templateGui:IsA("ScreenGui") then
		DebugLog.Warn("UI", "Barres V2 non activees, snapshot ou HUD introuvable", {
			HasCombatGui = combatGui ~= nil,
			HasProductionTemplate = templateGui ~= nil,
		})
		return
	end

	local templateCanvas = templateGui:FindFirstChild("RunCanvas")
	local topTemplate = templateCanvas and templateCanvas:FindFirstChild("TopDock")
	local bottomTemplate = templateCanvas and templateCanvas:FindFirstChild("BottomDock")

	if topTemplate == nil or bottomTemplate == nil or not topTemplate:IsA("Frame") or not bottomTemplate:IsA("Frame") then
		DebugLog.Warn("UI", "Barres V2 non activees, docks du kit invalides")
		return
	end

	local legacyTop = combatGui:WaitForChild("TopCluster", 30)
	local legacyBottom = combatGui:WaitForChild("XpPanel", 30)

	if legacyTop == nil or legacyBottom == nil or not legacyTop:IsA("Frame") or not legacyBottom:IsA("Frame") then
		DebugLog.Warn("UI", "Barres V2 non activees, sources HUD historiques invalides")
		return
	end

	local oldTop = combatGui:FindFirstChild("TopBarV2")
	if oldTop then
		oldTop:Destroy()
	end

	local oldBottom = combatGui:FindFirstChild("BottomBarV2")
	if oldBottom then
		oldBottom:Destroy()
	end

	local topDock = topTemplate:Clone()
	topDock.Name = "TopBarV2"
	topDock:SetAttribute("ProductionBound", true)
	topDock.Visible = false
	topDock.Parent = combatGui

	local bottomDock = bottomTemplate:Clone()
	bottomDock.Name = "BottomBarV2"
	bottomDock:SetAttribute("ProductionBound", true)
	bottomDock.Visible = false
	bottomDock.Parent = combatGui

	-- Le snapshot sert uniquement de source de clonage dans StarterGui.
	templateGui.Enabled = false

	local topContent = getFrame(topDock, { "Content" })
	local bottomBar = getFrame(bottomDock, { "BottomBar" })
	local bottomContent = bottomBar and getFrame(bottomBar, { "Content" })

	if topContent == nil or bottomContent == nil then
		DebugLog.Warn("UI", "Barres V2 non activees, hierarchie de composants incomplete")
		topDock:Destroy()
		bottomDock:Destroy()
		return
	end

	configureTopBarLayout(topDock, topContent)

	local kitHealth = getFrame(bottomContent, { "Stats", "Health" })
	local kitShield = getFrame(bottomContent, { "Stats", "Shield" })
	local kitExperience = getFrame(bottomContent, { "Stats", "Experience" })

	if kitHealth == nil or kitShield == nil or kitExperience == nil then
		DebugLog.Warn("UI", "Barres V2 non activees, pistes de statistiques absentes")
		topDock:Destroy()
		bottomDock:Destroy()
		return
	end

	-- Ces noms conservent le contrat des popups existants sans dupliquer leur logique.
	kitHealth.Name = "HpGroup"
	kitShield.Name = "ShieldGroup"
	kitExperience.Name = "XpPanel"

	local legacyHealth = legacyBottom:WaitForChild("HpGroup", 30)
	local legacyShield = legacyBottom:WaitForChild("ShieldGroup", 30)
	local legacyArcane = legacyTop:WaitForChild("ArcaneSlot", 30)
	local legacyKills = legacyTop:WaitForChild("KillsSlot", 30)
	local legacyGold = legacyTop:WaitForChild("GoldSlot", 30)
	local legacyChestCost = legacyTop:WaitForChild("ChestCostSlot", 30)
	local legacyRunScore = legacyTop:WaitForChild("RunScoreSlot", 30)
	local legacyLevel = legacyTop:WaitForChild("TopLevelValue", 30)
	local legacyTimer = legacyTop:WaitForChild("TimerSlot", 30)
	local legacyPauseButton = legacyTop:WaitForChild("PauseButton", 30)
	local legacyPauseImage = legacyPauseButton:FindFirstChild("PauseImage")

	if
		legacyHealth == nil
		or legacyShield == nil
		or legacyArcane == nil
		or legacyKills == nil
		or legacyGold == nil
		or legacyChestCost == nil
		or legacyRunScore == nil
		or legacyLevel == nil
		or legacyTimer == nil
		or legacyPauseButton == nil
		or not legacyHealth:IsA("Frame")
		or not legacyShield:IsA("Frame")
		or not legacyArcane:IsA("Frame")
		or not legacyKills:IsA("Frame")
		or not legacyGold:IsA("Frame")
		or not legacyChestCost:IsA("Frame")
		or not legacyRunScore:IsA("Frame")
		or not legacyLevel:IsA("TextLabel")
		or not legacyTimer:IsA("Frame")
		or not legacyPauseButton:IsA("TextButton")
		or (legacyPauseImage ~= nil and not legacyPauseImage:IsA("ImageLabel"))
	then
		DebugLog.Warn("UI", "Barres V2 non activees, donnees HUD historiques incompletes")
		topDock:Destroy()
		bottomDock:Destroy()
		return
	end

	local legacyHealthText = getTextLabel(legacyHealth, { "HpText" })
	local legacyShieldText = getTextLabel(legacyShield, { "ShieldHeader", "ShieldText" })
	local legacyXpText = getTextLabel(legacyBottom, { "XpText" })
	local legacyLevelText = getTextLabel(legacyBottom, { "LevelValue" })
	local legacyHealthFill = getFrame(legacyHealth, { "HealthTrack", "HealthFill" })
	local legacyShieldFill = getFrame(legacyShield, { "ShieldTrack", "ShieldFill" })
	local legacyXpFill = getFrame(legacyBottom, { "XpTrack", "XpFill" })
	local legacyTimerText = getTextLabel(legacyTimer, { "TimerLabel" })

	local kitArcaneValue = getTextLabel(topContent, { "ArcaneSlot", "Info", "Value" })
	local kitKillsValue = getTextLabel(topContent, { "KillsSlot", "Info", "Value" })
	local kitGoldValue = getTextLabel(topContent, { "GoldSlot", "Info", "Value" })
	local kitTimerValue = getTextLabel(topContent, { "TimerSlot", "Info", "Value" })
	local kitChestValue = getTextLabel(topContent, { "ChestCostSlot", "Info", "Value" })
	local kitRunScoreValue = getTextLabel(topContent, { "RunScoreSlot", "Info", "Value" })
	local kitLevelValue = getTextLabel(topContent, { "LevelSlot", "Info", "Value" })

	local kitHealthValue = getTextLabel(kitHealth, { "Header", "Value" })
	local kitShieldValue = getTextLabel(kitShield, { "Header", "Value" })
	local kitXpValue = getTextLabel(kitExperience, { "Header", "Value" })
	local kitXpLabel = getTextLabel(kitExperience, { "Header", "Label" })
	local kitHealthFill = getFrame(kitHealth, { "Track", "Fill" })
	local kitShieldFill = getFrame(kitShield, { "Track", "Fill" })
	local kitXpFill = getFrame(kitExperience, { "Track", "Fill" })

	bindText(getTextLabel(legacyArcane, { "ArcaneValue" }), kitArcaneValue)
	bindText(getTextLabel(legacyKills, { "KillsValue" }), kitKillsValue)
	bindText(getTextLabel(legacyGold, { "GoldValue" }), kitGoldValue)
	bindText(legacyTimerText, kitTimerValue)
	bindText(getTextLabel(legacyChestCost, { "ChestCostValue" }), kitChestValue)
	bindText(getTextLabel(legacyRunScore, { "RunScoreValue" }), kitRunScoreValue)
	bindText(legacyLevel, kitLevelValue)

	bindText(legacyHealthText, kitHealthValue)
	bindText(legacyShieldText, kitShieldValue)
	bindText(legacyXpText, kitXpValue)
	bindText(legacyLevelText, kitXpLabel)
	bindBar(legacyHealthFill, kitHealthFill)
	bindBar(legacyShieldFill, kitShieldFill)
	bindBar(legacyXpFill, kitXpFill)

	local kitPauseButton = getGuiObject(topDock, { "PauseControl", "PauseButton" })
	local kitPauseGlow = getFrame(topDock, { "PauseControl", "StateGlow" })
	local pauseToggleRemote = ReplicatedStorage:FindFirstChild("Combat_TogglePause")
		or ReplicatedStorage:WaitForChild("Combat_TogglePause", 10)

	if pauseToggleRemote ~= nil and not pauseToggleRemote:IsA("RemoteEvent") then
		DebugLog.Warn("UI", "Remote de pause invalide pour les barres V2", {
		ClassName = pauseToggleRemote.ClassName,
		Name = pauseToggleRemote.Name,
	})
		pauseToggleRemote = nil
	end

	if kitPauseButton and kitPauseButton:IsA("ImageButton") then
		local function refreshPauseButton()
			kitPauseButton.Active = legacyPauseButton.Active
			kitPauseButton.ImageTransparency = if legacyPauseButton.Active then 0 else 0.45

			if legacyPauseImage and legacyPauseImage:IsA("ImageLabel") then
				kitPauseButton.Image = legacyPauseImage.Image
			end

			if kitPauseGlow then
				kitPauseGlow.BackgroundTransparency = if legacyPauseButton.Active then 0.90 else 0.97
			end
		end

		refreshPauseButton()
		legacyPauseButton:GetPropertyChangedSignal("Active"):Connect(refreshPauseButton)

		if legacyPauseImage and legacyPauseImage:IsA("ImageLabel") then
			legacyPauseImage:GetPropertyChangedSignal("Image"):Connect(refreshPauseButton)
		end

		kitPauseButton.Activated:Connect(function()
			if not legacyPauseButton.Active then
				return
			end

			if pauseToggleRemote == nil then
				DebugLog.Warn("UI", "Pause V2 ignoree, remote indisponible")
				return
			end

			-- Le bouton V2 parle directement au serveur. Activer artificiellement
			-- le bouton historique masque peut lever une erreur et coupe la partie.
			pauseToggleRemote:FireServer()
		end)
	end

	local inventoryGrid = getFrame(bottomContent, { "Inventory", "Grid" })
	local inventorySlots = {}

	if inventoryGrid then
		for index = 1, 12 do
			local slot = inventoryGrid:FindFirstChild(string.format("Slot%02d", index))

			if slot and slot:IsA("Frame") then
				table.insert(inventorySlots, slot)
				setSlotEmpty(slot)
			end
		end
	end

	local function refreshRunItems(payload)
		for _, slot in ipairs(inventorySlots) do
			setSlotEmpty(slot)
		end

		local usedSlots = 0
		local displayedItemIds = {}

		if typeof(payload) == "table" and typeof(payload.Items) == "table" then
			for _, item in ipairs(payload.Items) do
				local itemId = if typeof(item) == "table" and item.Id ~= nil then tostring(item.Id) else ""
				local stacks = if typeof(item) == "table" then math.max(0, math.floor(tonumber(item.Stacks) or 0)) else 0
				local definition = RunItemConfig.Definitions[itemId]

				if stacks > 0 and definition ~= nil and not displayedItemIds[itemId] then
					usedSlots += 1
					local slot = inventorySlots[usedSlots]

					if slot == nil then
						break
					end

					displayedItemIds[itemId] = true
					setSlotItem(slot, definition, stacks)
				end
			end
		end
	end

	local feedbackEvent = combatGui:FindFirstChild("FeedbackArrived")
	local feedbackTargets = {
		Health = { Root = kitHealth, Track = getFrame(kitHealth, { "Track" }), Fill = kitHealthFill },
		Shield = { Root = kitShield, Track = getFrame(kitShield, { "Track" }), Fill = kitShieldFill },
		Xp = { Root = kitExperience, Track = getFrame(kitExperience, { "Track" }), Fill = kitXpFill },
		ArcaneGem = { Root = getFrame(topContent, { "ArcaneSlot" }), Accent = Color3.fromRGB(109, 220, 255) },
		Kill = { Root = getFrame(topContent, { "KillsSlot" }), Accent = Color3.fromRGB(248, 60, 76) },
		Coin = { Root = getFrame(topContent, { "GoldSlot" }), Accent = Color3.fromRGB(255, 211, 82) },
		RunScore = { Root = getFrame(topContent, { "RunScoreSlot" }), Accent = Color3.fromRGB(112, 228, 255) },
	}

	local feedbackTokens = {}

	local function playFeedback(targetId)
		local target = feedbackTargets[targetId]

		if target == nil or target.Root == nil then
			return
		end

		local token = (feedbackTokens[targetId] or 0) + 1
		feedbackTokens[targetId] = token


		-- Un UIScale sur un slot horizontal rend la top bar nerveuse : le slot
		-- grossit a l'ecran au milieu de ses voisins. Le retour est donc porte
		-- par un contour local, sans modifier aucune emprise de layout.
		local legacyScale = target.Root:FindFirstChild("FeedbackPulseScale")
		if legacyScale and legacyScale:IsA("UIScale") then
			legacyScale:Destroy()
		end

		local pulseStroke = target.Root:FindFirstChild("FeedbackPulseStroke")
		if pulseStroke == nil then
			pulseStroke = Instance.new("UIStroke")
			pulseStroke.Name = "FeedbackPulseStroke"
			pulseStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
			pulseStroke.Parent = target.Root
		end

		if pulseStroke:IsA("UIStroke") then
			local accent = target.Accent
			if typeof(accent) ~= "Color3" and target.Fill ~= nil then
				accent = target.Fill.BackgroundColor3
			end

			pulseStroke.Color = if typeof(accent) == "Color3" then accent else Color3.fromRGB(245, 246, 255)
			pulseStroke.Thickness = 1
			pulseStroke.Transparency = 0.9
			TweenService:Create(pulseStroke, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Thickness = 1.65,
				Transparency = 0.42,
			}):Play()

			task.delay(0.14, function()
				if feedbackTokens[targetId] == token and pulseStroke.Parent ~= nil then
					TweenService:Create(pulseStroke, TweenInfo.new(0.24, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
						Thickness = 1,
						Transparency = 1,
					}):Play()
				end
			end)
		end

		if target.Track then
			local sheen = target.Track:FindFirstChild("FeedbackSheen")
			if sheen and sheen:IsA("Frame") then
				sheen.Position = UDim2.fromScale(-0.4, 0.5)
				sheen.BackgroundTransparency = 0.38
				TweenService:Create(sheen, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
					Position = UDim2.fromScale(1.35, 0.5),
					BackgroundTransparency = 1,
				}):Play()
			end
		end
	end

	if feedbackEvent and feedbackEvent:IsA("BindableEvent") then
		feedbackEvent.Event:Connect(playFeedback)
	end

	-- Les anciens objets restent le temps de valider le rail de donnees, mais ne peuvent plus etre rendus.
	legacyHealth.Name = "LegacyHpGroup"
	legacyShield.Name = "LegacyShieldGroup"
	legacyBottom.Name = "LegacyXpPanel"
	legacyArcane.Name = "LegacyArcaneSlot"
	legacyKills.Name = "LegacyKillsSlot"
	legacyGold.Name = "LegacyGoldSlot"
	legacyRunScore.Name = "LegacyRunScoreSlot"

	local isSuppressingLegacy = false
	local function suppressLegacyBars()
		if isSuppressingLegacy then
			return
		end

		isSuppressingLegacy = true
		legacyTop.Visible = false
		legacyBottom.Visible = false
		isSuppressingLegacy = false
	end

	legacyTop:GetPropertyChangedSignal("Visible"):Connect(suppressLegacyBars)
	legacyBottom:GetPropertyChangedSignal("Visible"):Connect(suppressLegacyBars)
	suppressLegacyBars()

	local function setRunVisibility(isRunActive)
		topDock.Visible = isRunActive
		bottomDock.Visible = isRunActive
		suppressLegacyBars()
	end

	setRunVisibility(player:GetAttribute("IsRunActive") == true)
	player:GetAttributeChangedSignal("IsRunActive"):Connect(function()
		setRunVisibility(player:GetAttribute("IsRunActive") == true)
	end)

	task.spawn(function()
		local runStateRemote = ReplicatedStorage:WaitForChild("Run_StateUpdate", 30)
		if runStateRemote and runStateRemote:IsA("RemoteEvent") then
			runStateRemote.OnClientEvent:Connect(function(payload)
				if typeof(payload) == "table" then
					setRunVisibility(payload.IsRunActive == true)
				end
			end)
		end
	end)

	task.spawn(function()
		local runItemsRemote = ReplicatedStorage:WaitForChild(RunItemConfig.UpdateRemoteName, 30)
		if runItemsRemote and runItemsRemote:IsA("RemoteEvent") then
			runItemsRemote.OnClientEvent:Connect(refreshRunItems)
		end
	end)

	DebugLog.Info("UI", "Barres V2 du kit activees", {
		BottomSlots = #inventorySlots,
		Source = PRODUCTION_TEMPLATE_GUI_NAME,
	})
end

task.spawn(function()
	local success, err = pcall(initialise)

	if not success then
		DebugLog.Warn("UI", "Initialisation des barres V2 impossible", {
			Error = tostring(err),
		})
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="142">
          <Properties>
            <string name="Name">RunLauncher</string>
            <string name="Source"><![CDATA[--!strict

-- Lance une run depuis le lobby sans dependre d'une plaque presente dans Workspace.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local UiTheme = require(Shared:WaitForChild("UiTheme"))
local getChapterState = ReplicatedStorage:WaitForChild("Chapter_GetState") :: RemoteFunction
local startRunRequest = ReplicatedStorage:WaitForChild("Run_StartRequest") :: RemoteFunction

local oldGui = playerGui:FindFirstChild("RunLauncher")

if oldGui ~= nil then
	oldGui:Destroy()
end

local COLORS = UiTheme.Contexts.RunLauncher

local addCorner = UiTheme.AddCorner
local addStroke = UiTheme.AddStroke

local function createLabel(parent: Instance, name: string, text: string, size: number, color: Color3)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Font = UiTheme.Fonts.Bold
	label.Text = text
	label.TextColor3 = color
	label.TextSize = size
	label.TextWrapped = true
	label.Parent = parent
	return label
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "RunLauncher"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 45
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

local openButton = Instance.new("TextButton")
openButton.Name = "OpenRunLauncher"
openButton.AnchorPoint = Vector2.new(0.5, 1)
openButton.Position = UDim2.new(0.5, 0, 1, -28)
openButton.Size = UDim2.fromOffset(230, 48)
openButton.BackgroundColor3 = COLORS.Panel
openButton.BackgroundTransparency = 0.16
openButton.BorderSizePixel = 0
openButton.AutoButtonColor = true
openButton.Font = Enum.Font.GothamBold
openButton.Text = "LANCER UNE RUN"
openButton.TextColor3 = COLORS.Text
openButton.TextSize = 16
openButton.Parent = screenGui
addCorner(openButton, 7)
addStroke(openButton, COLORS.Cyan, 0.16, 2)
UiTheme.AddSurfaceFinish(openButton, {
	Accent = COLORS.Cyan,
	Intensity = 0.44,
})

local overlay = Instance.new("Frame")
overlay.Name = "Overlay"
overlay.Size = UDim2.fromScale(1, 1)
overlay.BackgroundColor3 = Color3.new(0, 0, 0)
overlay.BackgroundTransparency = 0.52
overlay.BorderSizePixel = 0
overlay.Visible = false
overlay.Parent = screenGui

local panel = Instance.new("Frame")
panel.Name = "ChapterPanel"
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.5)
panel.Size = UDim2.fromOffset(690, 390)
panel.BackgroundColor3 = COLORS.Panel
panel.BackgroundTransparency = 0.1
panel.BorderSizePixel = 0
panel.ClipsDescendants = true
panel.Parent = overlay
addCorner(panel, 8)
addStroke(panel, Color3.fromRGB(128, 151, 177), 0.2, 2)

local panelGradient = Instance.new("UIGradient")
panelGradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, COLORS.PanelLight),
	ColorSequenceKeypoint.new(1, COLORS.Panel),
})
panelGradient.Rotation = 90
panelGradient.Parent = panel
UiTheme.AddSurfaceFinish(panel, {
	Accent = COLORS.Cyan,
	Intensity = 0.66,
})

local panelScale = Instance.new("UIScale")
panelScale.Parent = panel

local title = createLabel(panel, "Title", "CHOISIR UN CHAPITRE", 24, COLORS.Text)
title.Position = UDim2.fromOffset(30, 22)
title.Size = UDim2.new(1, -60, 0, 34)
title.TextXAlignment = Enum.TextXAlignment.Center

local subtitle = createLabel(
	panel,
	"Subtitle",
	"Chaque chapitre utilise sa propre map et sa propre progression.",
	12,
	COLORS.Muted
)
subtitle.Position = UDim2.fromOffset(30, 57)
subtitle.Size = UDim2.new(1, -60, 0, 24)
subtitle.Font = Enum.Font.Gotham
subtitle.TextXAlignment = Enum.TextXAlignment.Center

local closeButton = Instance.new("TextButton")
closeButton.Name = "Close"
closeButton.AnchorPoint = Vector2.new(1, 0)
closeButton.Position = UDim2.new(1, -14, 0, 14)
closeButton.Size = UDim2.fromOffset(32, 32)
closeButton.BackgroundColor3 = COLORS.Card
closeButton.BackgroundTransparency = 0.15
closeButton.BorderSizePixel = 0
closeButton.Font = Enum.Font.GothamBold
closeButton.Text = "X"
closeButton.TextColor3 = COLORS.Text
closeButton.TextSize = 14
closeButton.Parent = panel
addCorner(closeButton, 6)

local cardsFrame = Instance.new("Frame")
cardsFrame.Name = "Chapters"
cardsFrame.Position = UDim2.fromOffset(24, 98)
cardsFrame.Size = UDim2.new(1, -48, 0, 190)
cardsFrame.BackgroundTransparency = 1
cardsFrame.Parent = panel

local cardsLayout = Instance.new("UIGridLayout")
cardsLayout.CellPadding = UDim2.fromOffset(12, 0)
cardsLayout.CellSize = UDim2.new(1 / 3, -8, 1, 0)
cardsLayout.FillDirectionMaxCells = 3
cardsLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
cardsLayout.SortOrder = Enum.SortOrder.LayoutOrder
cardsLayout.Parent = cardsFrame

local statusLabel = createLabel(panel, "Status", "", 12, COLORS.Muted)
statusLabel.Position = UDim2.new(0, 30, 1, -88)
statusLabel.Size = UDim2.new(1, -60, 0, 22)
statusLabel.Font = Enum.Font.Gotham
statusLabel.TextXAlignment = Enum.TextXAlignment.Center

local launchButton = Instance.new("TextButton")
launchButton.Name = "Launch"
launchButton.AnchorPoint = Vector2.new(0.5, 1)
launchButton.Position = UDim2.new(0.5, 0, 1, -24)
launchButton.Size = UDim2.fromOffset(250, 46)
launchButton.BackgroundColor3 = Color3.fromRGB(46, 126, 166)
launchButton.BorderSizePixel = 0
launchButton.AutoButtonColor = true
launchButton.Font = Enum.Font.GothamBold
launchButton.Text = "LANCER LE CHAPITRE"
launchButton.TextColor3 = COLORS.Text
launchButton.TextSize = 15
launchButton.Parent = panel
addCorner(launchButton, 6)
local launchStroke = addStroke(launchButton, COLORS.Cyan, 0.08, 2)

type ChapterPayload = {
	Id: number,
	DisplayName: string,
	MapId: string,
	IsUnlocked: boolean,
	IsCompleted: boolean,
	IsSelected: boolean,
}

type ChapterCard = {
	Data: ChapterPayload,
	Button: TextButton,
	Stroke: UIStroke,
}

local cards: {ChapterCard} = {}
local selectedChapterId: number? = nil
local isBusy = false
local wasRunActive = player:GetAttribute("IsRunActive") == true
local responsiveScale = 1

local function refreshCards()
	for _, card in ipairs(cards) do
		local isSelected = card.Data.Id == selectedChapterId
		card.Button.BackgroundColor3 = if isSelected then COLORS.CardSelected else COLORS.Card
		card.Stroke.Color = if not card.Data.IsUnlocked
			then COLORS.Locked
			elseif isSelected
			then COLORS.Cyan
			else COLORS.Purple
		card.Stroke.Transparency = if isSelected then 0.02 else 0.42
	end

	local canLaunch = selectedChapterId ~= nil and not isBusy
	launchButton.Active = canLaunch
	launchButton.AutoButtonColor = canLaunch
	launchButton.BackgroundTransparency = if canLaunch then 0 else 0.45
	launchStroke.Transparency = if canLaunch then 0.08 else 0.65
end

local function clearCards()
	for _, card in ipairs(cards) do
		card.Button:Destroy()
	end

	table.clear(cards)
	selectedChapterId = nil
end

local function createChapterCard(data: ChapterPayload, layoutOrder: number)
	local button = Instance.new("TextButton")
	button.Name = "Chapter" .. data.Id
	button.LayoutOrder = layoutOrder
	button.BackgroundColor3 = COLORS.Card
	button.BackgroundTransparency = 0.08
	button.BorderSizePixel = 0
	button.AutoButtonColor = data.IsUnlocked
	button.Text = ""
	button.Parent = cardsFrame
	addCorner(button, 6)
	local stroke = addStroke(button, if data.IsUnlocked then COLORS.Purple else COLORS.Locked, 0.42, 2)
	UiTheme.AddSurfaceFinish(button, {
		Accent = if data.IsUnlocked then COLORS.Purple else COLORS.Locked,
		Intensity = 0.26,
	})

	local chapterNumber = createLabel(button, "Number", string.format("%02d", data.Id), 35, if data.IsUnlocked then COLORS.Cyan else COLORS.Locked)
	chapterNumber.Position = UDim2.fromOffset(14, 16)
	chapterNumber.Size = UDim2.new(1, -28, 0, 48)
	chapterNumber.TextXAlignment = Enum.TextXAlignment.Left

	local chapterName = createLabel(button, "Name", string.upper(data.DisplayName), 16, COLORS.Text)
	chapterName.Position = UDim2.fromOffset(14, 70)
	chapterName.Size = UDim2.new(1, -28, 0, 28)
	chapterName.TextXAlignment = Enum.TextXAlignment.Left

	local mapName = createLabel(button, "Map", data.MapId, 11, COLORS.Muted)
	mapName.Position = UDim2.fromOffset(14, 101)
	mapName.Size = UDim2.new(1, -28, 0, 22)
	mapName.Font = Enum.Font.Gotham
	mapName.TextXAlignment = Enum.TextXAlignment.Left

	local stateText = if not data.IsUnlocked then "VERROUILLE" elseif data.IsCompleted then "TERMINE" else "DISPONIBLE"
	local stateColor = if not data.IsUnlocked then COLORS.Locked elseif data.IsCompleted then COLORS.Green else COLORS.Cyan
	local state = createLabel(button, "State", stateText, 11, stateColor)
	state.Position = UDim2.new(0, 14, 1, -39)
	state.Size = UDim2.new(1, -28, 0, 22)
	state.TextXAlignment = Enum.TextXAlignment.Left

	local card: ChapterCard = {
		Data = data,
		Button = button,
		Stroke = stroke,
	}
	table.insert(cards, card)

	if data.IsSelected and data.IsUnlocked then
		selectedChapterId = data.Id
	end

	button.Activated:Connect(function()
		if isBusy or not data.IsUnlocked then
			if not data.IsUnlocked then
				statusLabel.Text = "Termine le chapitre precedent pour le debloquer."
				statusLabel.TextColor3 = COLORS.Danger
			end
			return
		end

		selectedChapterId = data.Id
		statusLabel.Text = data.DisplayName .. " selectionne"
		statusLabel.TextColor3 = COLORS.Muted
		refreshCards()
	end)
end

local function loadChapters()
	clearCards()
	statusLabel.Text = "Chargement des chapitres..."
	statusLabel.TextColor3 = COLORS.Muted

	local success, result = pcall(function()
		return getChapterState:InvokeServer()
	end)

	if not success or typeof(result) ~= "table" then
		statusLabel.Text = "Progression indisponible. Reessaie dans un instant."
		statusLabel.TextColor3 = COLORS.Danger
		refreshCards()
		return
	end

	for index, chapterData in ipairs(result) do
		if typeof(chapterData) == "table" then
			createChapterCard(chapterData :: ChapterPayload, index)
		end
	end

	if selectedChapterId == nil then
		for _, card in ipairs(cards) do
			if card.Data.IsUnlocked then
				selectedChapterId = card.Data.Id
				break
			end
		end
	end

	statusLabel.Text = "Selectionne la map de ta prochaine run."
	statusLabel.TextColor3 = COLORS.Muted
	refreshCards()
end

local function closePanel()
	if isBusy then
		return
	end

	overlay.Visible = false
end

local function openPanel()
	if player:GetAttribute("IsRunActive") == true then
		return
	end

	overlay.Visible = true
	panelScale.Scale = responsiveScale * 0.96
	TweenService:Create(panelScale, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Scale = responsiveScale,
	}):Play()
	task.spawn(loadChapters)
end

openButton.Activated:Connect(openPanel)
closeButton.Activated:Connect(closePanel)

launchButton.Activated:Connect(function()
	if isBusy or selectedChapterId == nil then
		return
	end

	isBusy = true
	statusLabel.Text = "GENERATION DE LA RUN..."
	statusLabel.TextColor3 = COLORS.Cyan
	launchButton.Text = "LANCEMENT..."
	refreshCards()

	task.spawn(function()
		local requestSucceeded, started, reason = pcall(function()
			return startRunRequest:InvokeServer(selectedChapterId)
		end)

		if requestSucceeded and started == true then
			statusLabel.Text = "RUN PRETE"
			statusLabel.TextColor3 = COLORS.Green
			return
		end

		isBusy = false
		launchButton.Text = "LANCER LE CHAPITRE"
		statusLabel.Text = "Lancement impossible : " .. tostring(if requestSucceeded then reason else started)
		statusLabel.TextColor3 = COLORS.Danger
		refreshCards()
	end)
end)

local function refreshVisibility()
	local isRunActive = player:GetAttribute("IsRunActive") == true

	if wasRunActive and not isRunActive then
		-- Le LocalScript persiste apres le retour lobby : son verrou doit suivre le cycle de run.
		isBusy = false
		launchButton.Text = "LANCER LE CHAPITRE"
		statusLabel.Text = "Selectionne la map de ta prochaine run."
		statusLabel.TextColor3 = COLORS.Muted
		refreshCards()
	end

	wasRunActive = isRunActive
	openButton.Visible = not isRunActive

	if isRunActive then
		overlay.Visible = false
	end
end

player:GetAttributeChangedSignal("IsRunActive"):Connect(refreshVisibility)

local cameraConnection: RBXScriptConnection? = nil

local function updateScale()
	local camera = workspace.CurrentCamera

	if camera == nil then
		return
	end

	local viewport = camera.ViewportSize
	responsiveScale = math.clamp(math.min(viewport.X / 900, viewport.Y / 600), 0.68, 1)
	panelScale.Scale = responsiveScale
end

local function bindCamera()
	if cameraConnection ~= nil then
		cameraConnection:Disconnect()
	end

	local camera = workspace.CurrentCamera

	if camera ~= nil then
		cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end

	updateScale()
end

workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
bindCamera()
refreshVisibility()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="143">
          <Properties>
            <string name="Name">RunLayoutV2Controller</string>
            <string name="Source"><![CDATA[--!strict

-- Le layout V2 ne sait rien des donnees de combat. Il aligne uniquement les
-- composants clones du brouillon deja alimentes par leurs adaptateurs respectifs.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local RunHudLayout = require(Shared:WaitForChild("RunHudLayout"))
local layoutScheduled = false

local function asGuiObject(instance: Instance?): GuiObject?
	if instance and instance:IsA("GuiObject") then
		return instance
	end

	return nil
end

local function normalizeBarRoots(topDock: GuiObject?, bottomDock: GuiObject?)
	if topDock then
		local topContent = asGuiObject(topDock:FindFirstChild("Content"))
		local topSurface = asGuiObject(topDock:FindFirstChild("Surface"))

		if topContent then
			topContent.AnchorPoint = Vector2.new(0.5, 0.5)
			topContent.Position = UDim2.fromScale(0.5, 0.5)
			topContent.Size = UDim2.new(1, -32, 1, -10)
		end

		if topSurface then
			topSurface.Position = UDim2.fromScale(0, 0)
			topSurface.Size = UDim2.fromScale(1, 1)
		end
	end

	if bottomDock then
		local bottomBar = asGuiObject(bottomDock:FindFirstChild("BottomBar"))

		if bottomBar then
			bottomBar.Position = UDim2.fromScale(0, 0)
			bottomBar.Size = UDim2.fromScale(1, 1)

			local bottomSurface = asGuiObject(bottomBar:FindFirstChild("Surface"))
			local bottomContent = asGuiObject(bottomBar:FindFirstChild("Content"))

			if bottomSurface then
				bottomSurface.Position = UDim2.fromScale(0, 0)
				bottomSurface.Size = UDim2.fromScale(1, 1)
			end

			if bottomContent then
				bottomContent.AnchorPoint = Vector2.new(0.5, 0.5)
				bottomContent.Position = UDim2.fromScale(0.5, 0.5)
				bottomContent.Size = UDim2.new(1, -32, 1, -14)
			end
		end
	end
end

local function configureLoadoutDock(dock: GuiObject?, slotPattern: string, loadoutHeight: number, density: number)
	if dock == nil then
		return
	end

	local content = asGuiObject(dock:FindFirstChild("Content"))
	if content == nil then
		return
	end

	local slotSize = math.clamp(math.floor((loadoutHeight * 0.88) + 0.5), 38, 60)
	local slotsLayout = content:FindFirstChild("SlotsLayout")
	if slotsLayout and slotsLayout:IsA("UIListLayout") then
		slotsLayout.Padding = UDim.new(0, math.clamp(math.floor((10 * density) + 0.5), 6, 12))
	end

	for _, child in ipairs(content:GetChildren()) do
		if child:IsA("Frame") and child.Name:match(slotPattern) then
			child.Size = UDim2.fromOffset(slotSize, slotSize)
		end
	end
end

local function applyLayout()
	local camera = Workspace.CurrentCamera
	local metrics = RunHudLayout.Compute(if camera then camera.ViewportSize else Vector2.zero)

	if metrics == nil then
		return
	end

	local combatGui = playerGui:FindFirstChild("CombatGui")
	local perkChoiceGui = playerGui:FindFirstChild("PerkChoiceV2")
	local itemRevealGui = playerGui:FindFirstChild("ItemRevealV2")
	local weaponChoiceGui = playerGui:FindFirstChild("WeaponChoiceV2")
	local loadoutGui = playerGui:FindFirstChild("RunLoadoutV2")
	local runStatsGui = playerGui:FindFirstChild("RunStatsGui")
	local utilityGui = playerGui:FindFirstChild("RunUtilityGui")
	local miniMapGui = playerGui:FindFirstChild("MiniMapGui")
	local perkOverlay = perkChoiceGui and perkChoiceGui:FindFirstChild("Overlay")
	local itemRevealOverlay = itemRevealGui and itemRevealGui:FindFirstChild("Overlay")
	local weaponChoiceCanvas = weaponChoiceGui and weaponChoiceGui:FindFirstChild("RunCanvas")

	local topDock = combatGui and asGuiObject(combatGui:FindFirstChild("TopBarV2"))
	local bottomDock = combatGui and asGuiObject(combatGui:FindFirstChild("BottomBarV2"))
	local perkDock = perkOverlay and asGuiObject(perkOverlay:FindFirstChild("PerkChoiceDockV2"))
	local itemRevealDock = itemRevealOverlay and asGuiObject(itemRevealOverlay:FindFirstChild("ItemRevealDockV2"))
	local weaponChoiceDock = weaponChoiceCanvas and asGuiObject(weaponChoiceCanvas:FindFirstChild("WeaponChoiceDock"))
	local weaponDock = loadoutGui and asGuiObject(loadoutGui:FindFirstChild("WeaponDockV2"))
	local gemDock = loadoutGui and asGuiObject(loadoutGui:FindFirstChild("GemDockV2"))
	local ultimateDock = loadoutGui and asGuiObject(loadoutGui:FindFirstChild("UltimateDockV2"))
	local statsDock = runStatsGui and asGuiObject(runStatsGui:FindFirstChild("StatsPanel"))
	local utilityDock = utilityGui and asGuiObject(utilityGui:FindFirstChild("UtilityDockV2"))
	local miniMapDock = miniMapGui and asGuiObject(miniMapGui:FindFirstChild("MiniMapPanelV2"))

	normalizeBarRoots(topDock, bottomDock)

	if topDock then
		RunHudLayout.ApplyDock(
			topDock,
			Vector2.new(0.5, 0),
			Vector2.new(metrics.Viewport.X * 0.5, metrics.MarginY),
			Vector2.new(metrics.MainWidth, metrics.TopHeight),
			Vector2.new(330, 48),
			Vector2.new(980, 80)
		)
	end

	if bottomDock then
		RunHudLayout.ApplyDock(
			bottomDock,
			Vector2.new(0.5, 1),
			Vector2.new(metrics.Viewport.X * 0.5, metrics.Viewport.Y - metrics.MarginY),
			Vector2.new(metrics.MainWidth, metrics.BottomHeight),
			Vector2.new(330, 80),
			Vector2.new(980, 140)
		)
	end

	if perkDock then
		RunHudLayout.ApplyDock(
			perkDock,
			Vector2.new(0, 0),
			Vector2.new(metrics.MainLeft, metrics.MainTop),
			Vector2.new(metrics.MainWidth, metrics.MainHeight),
			Vector2.new(330, 220),
			Vector2.new(980, 900)
		)
	end

	if itemRevealDock then
		RunHudLayout.ApplyDock(
			itemRevealDock,
			Vector2.new(0, 0),
			Vector2.new(metrics.MainLeft, metrics.MainTop),
			Vector2.new(metrics.MainWidth, metrics.MainHeight),
			Vector2.new(330, 220),
			Vector2.new(980, 900)
		)
	end

	if weaponChoiceDock then
		RunHudLayout.ApplyDock(
			weaponChoiceDock,
			Vector2.new(0, 0),
			Vector2.new(metrics.MainLeft, metrics.MainTop),
			Vector2.new(metrics.MainWidth, metrics.MainHeight),
			Vector2.new(330, 220),
			Vector2.new(980, 900)
		)
	end

	for _, loadoutDock in ipairs({weaponDock, gemDock, ultimateDock}) do
		if loadoutDock then
			RunHudLayout.ApplyDock(
				loadoutDock,
				Vector2.new(0.5, 0),
				Vector2.new(metrics.Viewport.X * 0.5, metrics.LoadoutTop),
				Vector2.new(metrics.MainWidth, metrics.LoadoutHeight),
				Vector2.new(220, 40),
				Vector2.new(980, 72)
			)
			loadoutDock.Visible = metrics.LoadoutVisible
		end
	end

	configureLoadoutDock(weaponDock, "^WeaponSlot%d%d$", metrics.LoadoutHeight, metrics.Density)
	configureLoadoutDock(gemDock, "^GemSlot%d%d$", metrics.LoadoutHeight, metrics.Density)
	configureLoadoutDock(ultimateDock, "^UltimateSlot$", metrics.LoadoutHeight, metrics.Density)

	if statsDock then
		RunHudLayout.ApplyDock(
			statsDock,
			Vector2.new(0, 0),
			Vector2.new(metrics.MarginX, metrics.MainTop),
			Vector2.new(metrics.RailWidth, metrics.MainHeight),
			Vector2.new(140, 220),
			Vector2.new(320, 960)
		)
	end

	if utilityDock then
		local utilityHeight = math.max(46, metrics.TopHeight - math.max(4, math.floor(metrics.TopHeight * 0.1)))
		local utilityTop = metrics.MarginY + ((metrics.TopHeight - utilityHeight) * 0.5)

		RunHudLayout.ApplyDock(
			utilityDock,
			Vector2.new(1, 0),
			Vector2.new(metrics.Viewport.X - metrics.MarginX, utilityTop),
			Vector2.new(metrics.RailWidth, utilityHeight),
			Vector2.new(96, 46),
			Vector2.new(320, 80)
		)
	end

	if miniMapDock then
		local miniMapSize = math.min(metrics.RailWidth, math.max(88, metrics.BottomTop - metrics.MainTop - metrics.Gap))

		RunHudLayout.ApplyDock(
			miniMapDock,
			Vector2.new(1, 0),
			Vector2.new(metrics.Viewport.X - metrics.MarginX, metrics.MainTop),
			Vector2.new(miniMapSize, miniMapSize),
			Vector2.new(88, 88),
			Vector2.new(320, 320)
		)
	end
end

local function scheduleLayout()
	if layoutScheduled then
		return
	end

	layoutScheduled = true
	task.defer(function()
		layoutScheduled = false
		applyLayout()
	end)
end

local function bindCamera(camera: Camera)
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(scheduleLayout)
	scheduleLayout()
end

Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
	local camera = Workspace.CurrentCamera
	if camera then
		bindCamera(camera)
	end
end)

playerGui.ChildAdded:Connect(function()
	scheduleLayout()
end)

playerGui.DescendantAdded:Connect(function(descendant)
	if
		descendant.Name == "TopBarV2"
		or descendant.Name == "BottomBarV2"
		or descendant.Name == "PerkChoiceDockV2"
		or descendant.Name == "ItemRevealDockV2"
		or descendant.Name == "WeaponChoiceDock"
		or descendant.Name == "WeaponDockV2"
		or descendant.Name == "GemDockV2"
		or descendant.Name == "UltimateDockV2"
		or descendant.Name == "StatsPanel"
		or descendant.Name == "UtilityDockV2"
		or descendant.Name == "MiniMapPanelV2"
	then
		scheduleLayout()
	end
end)

player:GetAttributeChangedSignal("IsRunActive"):Connect(scheduleLayout)

local currentCamera = Workspace.CurrentCamera
if currentCamera then
	bindCamera(currentCamera)
end

scheduleLayout()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="144">
          <Properties>
            <string name="Name">RunLoadingUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local RunLoadingConfig = require(Shared:WaitForChild("RunLoadingConfig"))
local UiTheme = require(Shared:WaitForChild("UiTheme"))

local existingGui = playerGui:FindFirstChild(RunLoadingConfig.GuiName)

if existingGui ~= nil then
	existingGui:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = RunLoadingConfig.GuiName
screenGui.IgnoreGuiInset = true
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 120
screenGui.Enabled = false
screenGui.Parent = playerGui

local overlay = Instance.new("Frame")
overlay.Name = "Overlay"
overlay.Size = UDim2.fromScale(1, 1)
overlay.BackgroundColor3 = Color3.fromRGB(7, 12, 19)
overlay.BackgroundTransparency = 0.08
overlay.BorderSizePixel = 0
overlay.Parent = screenGui

local panel = Instance.new("Frame")
panel.Name = "LoadingPanel"
panel.AnchorPoint = Vector2.new(0.5, 0.5)
panel.Position = UDim2.fromScale(0.5, 0.5)
panel.Size = UDim2.fromOffset(520, 190)
panel.BackgroundColor3 = Color3.fromRGB(17, 27, 39)
panel.BackgroundTransparency = 0.12
panel.BorderSizePixel = 0
panel.Parent = overlay
UiTheme.AddCorner(panel, 10)
UiTheme.AddStroke(panel, Color3.fromRGB(6, 10, 17), 0.1, 3)
UiTheme.AddStroke(panel, Color3.fromRGB(122, 214, 255), 0.42, 1)
UiTheme.AddGradient(panel, Color3.fromRGB(47, 64, 86), Color3.fromRGB(12, 20, 31), 90)
UiTheme.AddSurfaceFinish(panel, {
	Accent = Color3.fromRGB(122, 214, 255),
	Intensity = 0.55,
})

local panelConstraint = Instance.new("UISizeConstraint")
panelConstraint.MinSize = Vector2.new(300, 160)
panelConstraint.MaxSize = Vector2.new(620, 210)
panelConstraint.Parent = panel

local diamond = Instance.new("Frame")
diamond.Name = "ArcaneDiamond"
diamond.AnchorPoint = Vector2.new(0.5, 0)
diamond.Position = UDim2.new(0.5, 0, 0, 23)
diamond.Size = UDim2.fromOffset(24, 24)
diamond.BackgroundColor3 = Color3.fromRGB(148, 91, 255)
diamond.BorderSizePixel = 0
diamond.Rotation = 45
diamond.Parent = panel
UiTheme.AddCorner(diamond, 3)
UiTheme.AddStroke(diamond, Color3.fromRGB(221, 209, 255), 0.18, 2)

local title = Instance.new("TextLabel")
title.Name = "Title"
title.AnchorPoint = Vector2.new(0.5, 0)
title.Position = UDim2.new(0.5, 0, 0, 58)
title.Size = UDim2.new(1, -48, 0, 28)
title.BackgroundTransparency = 1
title.Font = UiTheme.Fonts.Heavy
title.Text = "PREPARATION DE LA RUN"
title.TextColor3 = Color3.fromRGB(245, 246, 250)
title.TextSize = 21
title.TextStrokeColor3 = Color3.fromRGB(5, 8, 12)
title.TextStrokeTransparency = 0.35
title.TextXAlignment = Enum.TextXAlignment.Center
title.Parent = panel

local message = Instance.new("TextLabel")
message.Name = "Message"
message.AnchorPoint = Vector2.new(0.5, 0)
message.Position = UDim2.new(0.5, 0, 0, 94)
message.Size = UDim2.new(1, -64, 0, 22)
message.BackgroundTransparency = 1
message.Font = UiTheme.Fonts.Bold
message.Text = "Preparation de la run"
message.TextColor3 = Color3.fromRGB(183, 211, 235)
message.TextSize = 15
message.TextXAlignment = Enum.TextXAlignment.Center
message.Parent = panel

local detail = Instance.new("TextLabel")
detail.Name = "Detail"
detail.AnchorPoint = Vector2.new(0.5, 0)
detail.Position = UDim2.new(0.5, 0, 0, 116)
detail.Size = UDim2.new(1, -64, 0, 16)
detail.BackgroundTransparency = 1
detail.Font = UiTheme.Fonts.Regular
detail.Text = ""
detail.TextColor3 = Color3.fromRGB(133, 158, 182)
detail.TextSize = 12
detail.TextXAlignment = Enum.TextXAlignment.Center
detail.Parent = panel

local track = Instance.new("Frame")
track.Name = "ProgressTrack"
track.AnchorPoint = Vector2.new(0.5, 0)
track.Position = UDim2.new(0.5, 0, 0, 147)
track.Size = UDim2.new(1, -84, 0, 12)
track.BackgroundColor3 = Color3.fromRGB(7, 13, 22)
track.BorderSizePixel = 0
track.ClipsDescendants = true
track.Parent = panel
UiTheme.AddCorner(track, 6)
UiTheme.AddStroke(track, Color3.fromRGB(113, 137, 170), 0.6, 1)

local fill = Instance.new("Frame")
fill.Name = "ProgressFill"
fill.Size = UDim2.fromScale(0, 1)
fill.BackgroundColor3 = Color3.fromRGB(115, 79, 255)
fill.BorderSizePixel = 0
fill.Parent = track
UiTheme.AddCorner(fill, 6)
UiTheme.AddGradient(fill, Color3.fromRGB(92, 206, 255), Color3.fromRGB(152, 77, 255), 0)

local percent = Instance.new("TextLabel")
percent.Name = "Percent"
percent.AnchorPoint = Vector2.new(0.5, 0)
percent.Position = UDim2.new(0.5, 0, 0, 166)
percent.Size = UDim2.new(1, -84, 0, 16)
percent.BackgroundTransparency = 1
percent.Font = UiTheme.Fonts.Bold
percent.Text = "0%"
percent.TextColor3 = Color3.fromRGB(213, 197, 255)
percent.TextSize = 12
percent.TextXAlignment = Enum.TextXAlignment.Center
percent.Parent = panel

local panelScale = Instance.new("UIScale")
panelScale.Parent = panel

local function updateScale()
	local camera = workspace.CurrentCamera

	if camera == nil then
		return
	end

	local viewport = camera.ViewportSize
	panelScale.Scale = math.clamp(math.min(viewport.X / 760, viewport.Y / 420), 0.72, 1)
end

local function applyPayload(payload)
	payload = payload or {}

	if payload.Visible ~= true then
		screenGui.Enabled = false
		return
	end

	screenGui.Enabled = true
	message.Text = tostring(payload.Message or "Preparation de la run")
	detail.Text = tostring(payload.Detail or "")
	local progress = math.clamp(tonumber(payload.Progress) or 0, 0, 1)
	percent.Text = tostring(math.floor((progress * 100) + 0.5)) .. "%"
	TweenService:Create(fill, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = UDim2.fromScale(progress, 1),
	}):Play()
end

local loadingRemote = ReplicatedStorage:WaitForChild(RunLoadingConfig.RemoteName)
loadingRemote.OnClientEvent:Connect(applyPayload)

player:GetAttributeChangedSignal(RunLoadingConfig.AttributeName):Connect(function()
	if player:GetAttribute(RunLoadingConfig.AttributeName) == true then
		applyPayload({
			Visible = true,
			Stage = "Preparing",
			Progress = RunLoadingConfig.Stages.Preparing.Progress,
			Message = RunLoadingConfig.Stages.Preparing.Message,
		})
	else
		applyPayload({ Visible = false })
	end
end)

if workspace.CurrentCamera ~= nil then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
end

updateScale()

if player:GetAttribute(RunLoadingConfig.AttributeName) == true then
	applyPayload({
		Visible = true,
		Progress = RunLoadingConfig.Stages.Preparing.Progress,
		Message = RunLoadingConfig.Stages.Preparing.Message,
	})
end
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="145">
          <Properties>
            <string name="Name">RunLoadoutV2Adapter</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local UiTemplateConfig = require(Shared:WaitForChild("UiTemplateConfig"))

local PRODUCTION_GUI_NAME = "RunLoadoutV2"
local COMPONENTS = {
	{Template = "WeaponDock", Runtime = "WeaponDockV2"},
	{Template = "GemDock", Runtime = "GemDockV2"},
	{Template = "UltimateDock", Runtime = "UltimateDockV2"},
}

local pendingLoadout = nil

local function asFrame(instance: Instance?)
	return if instance and instance:IsA("Frame") then instance else nil
end

local function applyWeaponLoadout(screenGui: ScreenGui, payload)
	if typeof(payload) ~= "table" or typeof(payload.Weapons) ~= "table" then
		return
	end

	local weaponDock = asFrame(screenGui:FindFirstChild("WeaponDockV2"))
	local content = weaponDock and asFrame(weaponDock:FindFirstChild("Content"))
	local referenceSlot = content and asFrame(content:FindFirstChild("WeaponSlot01"))
	local referenceIcon = referenceSlot and referenceSlot:FindFirstChild("WeaponIcon")
	local referenceBadge = referenceSlot and asFrame(referenceSlot:FindFirstChild("LevelBadge"))

	if content == nil or referenceIcon == nil or not referenceIcon:IsA("ImageLabel") or referenceBadge == nil then
		DebugLog.Warn("UI", "Loadout armes non applique, recette de slot incomplete")
		return
	end

	for slotIndex = 1, math.max(4, tonumber(payload.MaxWeapons) or 4) do
		local slot = asFrame(content:FindFirstChild(("WeaponSlot%02d"):format(slotIndex)))
		if slot == nil then continue end
		local weapon = payload.Weapons[slotIndex]
		local icon = slot:FindFirstChild("WeaponIcon")
		local badge = asFrame(slot:FindFirstChild("LevelBadge"))
		local emptyGlyph = slot:FindFirstChild("EmptyGlyph")

		if icon == nil then
			icon = referenceIcon:Clone()
			icon.Parent = slot
		end
		if badge == nil then
			badge = referenceBadge:Clone()
			badge.Parent = slot
		end

		if icon:IsA("ImageLabel") then
			icon.Image = if weapon then tostring(weapon.Icon or "") else ""
			icon.Visible = weapon ~= nil and icon.Image ~= ""
		end
		badge.Visible = weapon ~= nil
		local level = badge:FindFirstChild("Level")
		if level and level:IsA("TextLabel") then
			level.Text = if weapon then tostring(math.max(1, math.floor(tonumber(weapon.Level) or 1))) else ""
		end
		if emptyGlyph and emptyGlyph:IsA("TextLabel") then
			emptyGlyph.Visible = weapon == nil or tostring(weapon.Icon or "") == ""
			emptyGlyph.Text = if weapon then string.sub(tostring(weapon.Name or "L"), 1, 1) else "+"
		end
		slot:SetAttribute("WeaponId", if weapon then weapon.Id else nil)
	end
end

local function initialise()
	local templateGui = playerGui:WaitForChild(UiTemplateConfig.ProductionTemplateGuiName, 30)
	if templateGui == nil or not templateGui:IsA("ScreenGui") then
		DebugLog.Warn("UI", "Loadout V2 non active, template de production introuvable")
		return
	end

	local templateCanvas = templateGui:FindFirstChild("RunCanvas")
	if templateCanvas == nil or not templateCanvas:IsA("Frame") then
		DebugLog.Warn("UI", "Loadout V2 non active, RunCanvas invalide")
		return
	end

	local previousGui = playerGui:FindFirstChild(PRODUCTION_GUI_NAME)
	if previousGui then
		previousGui:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = PRODUCTION_GUI_NAME
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 18
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Enabled = false
	screenGui.Parent = playerGui

	local mounted = 0
	for _, component in ipairs(COMPONENTS) do
		local source = templateCanvas:FindFirstChild(component.Template)
		if source == nil or not source:IsA("Frame") then
			DebugLog.Warn("UI", "Composant loadout absent du template", {
				Component = component.Template,
			})
			continue
		end

		local dock = source:Clone()
		dock.Name = component.Runtime
		dock.Visible = true
		dock:SetAttribute("ProductionBound", true)
		dock.Parent = screenGui
		mounted += 1
	end

	if mounted ~= #COMPONENTS then
		screenGui:Destroy()
		DebugLog.Warn("UI", "Loadout V2 refuse, composant incomplet", {
			Expected = #COMPONENTS,
			Mounted = mounted,
		})
		return
	end

	-- Le template reste une source figee : aucun de ses composants ne doit
	-- participer directement au rendu de production.
	templateGui.Enabled = false

	local function setRunVisibility(isRunActive: boolean)
		screenGui.Enabled = isRunActive
	end

	setRunVisibility(player:GetAttribute("IsRunActive") == true)
	player:GetAttributeChangedSignal("IsRunActive"):Connect(function()
		setRunVisibility(player:GetAttribute("IsRunActive") == true)
	end)

	task.spawn(function()
		local runStateRemote = ReplicatedStorage:WaitForChild("Run_StateUpdate", 30)
		if runStateRemote and runStateRemote:IsA("RemoteEvent") then
			runStateRemote.OnClientEvent:Connect(function(payload)
				if typeof(payload) == "table" then
					setRunVisibility(payload.IsRunActive == true)
				end
			end)
		end
	end)

	playerGui:SetAttribute("RunLoadoutV2Ready", true)
	DebugLog.Info("UI", "Loadout V2 initialise", {
		Components = mounted,
		Source = UiTemplateConfig.ProductionTemplateGuiName,
	})

	if pendingLoadout then
		applyWeaponLoadout(screenGui, pendingLoadout)
	end
end

task.spawn(function()
	local loadoutRemote = ReplicatedStorage:WaitForChild("Weapon_LoadoutUpdate", 30)
	if loadoutRemote and loadoutRemote:IsA("RemoteEvent") then
		loadoutRemote.OnClientEvent:Connect(function(payload)
			pendingLoadout = payload
			local productionGui = playerGui:FindFirstChild(PRODUCTION_GUI_NAME)
			if productionGui and productionGui:IsA("ScreenGui") then
				applyWeaponLoadout(productionGui, payload)
			end
		end)
	end
end)

task.spawn(function()
	local success, err = pcall(initialise)
	if not success then
		DebugLog.Warn("UI", "Initialisation loadout V2 impossible", {
			Error = tostring(err),
		})
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="146">
          <Properties>
            <string name="Name">RunStatsUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local UiTemplateConfig = require(Shared:WaitForChild("UiTemplateConfig"))

local PRODUCTION_TEMPLATE_GUI_NAME = UiTemplateConfig.ProductionTemplateGuiName
local STATS_TEMPLATE_NAME = "RunStatsDock"
local PRODUCTION_GUI_NAME = "RunStatsGui"

local POSITIVE_COLOR = Color3.fromRGB(66, 219, 107)
local NEGATIVE_COLOR = Color3.fromRGB(248, 60, 76)
local PREVIEW_TWEEN = TweenInfo.new(0.58, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)

local function getDefaultDisplayStats()
	return {
		MaxHealth = 100,
		MoveSpeed = 16,
		JumpMode = "Power",
		JumpValue = 50,
		CurrentShield = 0,
		MaxShield = 0,
		HealthRegen = 0,
		ArmorPercent = 0,
		LifeStealPercent = 0,
		CritChance = 0,
		CritDamageMultiplier = 1.5,
		BaseDamage = CombatConfig.FireballDamage,
		EliteDamage = CombatConfig.FireballDamage,
		AttackRate = 1 / CombatConfig.FireballCooldown,
		ProjectileCount = 1,
		BounceCount = 0,
		ProjectileSpeed = CombatConfig.FireballSpeed,
		ProjectileDuration = CombatConfig.FireballLifetime,
		CollectRadius = CombatConfig.XpCollectDistance,
		XpMultiplier = 1,
		GoldMultiplier = 1,
		Luck = 0,
		EnemyMultiplier = 1,
	}
end

local function getNumber(value, fallback)
	if typeof(value) == "number" then
		return value
	end

	return fallback or 0
end

local function formatInteger(value)
	return tostring(math.floor(getNumber(value) + 0.5))
end

local function formatDecimal(value, decimals)
	local text = string.format("%." .. tostring(decimals) .. "f", getNumber(value))

	return string.gsub(text, "\\.", ",")
end

local function formatPercent(value)
	return formatInteger(getNumber(value) * 100) .. "%"
end

local function formatMultiplier(value)
	return "x" .. formatDecimal(value, 2)
end

local state = {
	IsRunActive = false,
	IsPaused = false,
	MaxHealth = 100,
	CurrentShield = 0,
	MaxShield = 0,
	DisplayStats = getDefaultDisplayStats(),
}

local existingGui = playerGui:FindFirstChild(PRODUCTION_GUI_NAME)

if existingGui then
	existingGui:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = PRODUCTION_GUI_NAME
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 30
screenGui.Enabled = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = playerGui

local function getStatsTemplate()
	local templateGui = StarterGui:FindFirstChild(PRODUCTION_TEMPLATE_GUI_NAME)
	local runCanvas = templateGui and templateGui:FindFirstChild("RunCanvas")
	local template = runCanvas and runCanvas:FindFirstChild(STATS_TEMPLATE_NAME)

	if template and template:IsA("Frame") then
		return template
	end

	DebugLog.Warn("UI", "Panneau statistiques V2 non initialise, template introuvable", {
		ProductionTemplate = templateGui ~= nil,
		RunCanvas = runCanvas ~= nil,
		Template = template ~= nil,
	})
	return nil
end

local template = getStatsTemplate()

if template == nil then
	return
end

local panel = template:Clone()
panel.Name = "StatsPanel"
panel.Visible = true
panel:SetAttribute("ProductionBound", true)
panel.Parent = screenGui

local content = panel:FindFirstChild("Content")
local statList = content and content:FindFirstChild("StatList")

if statList == nil or not statList:IsA("ScrollingFrame") then
	DebugLog.Warn("UI", "Panneau statistiques V2 non initialise, StatList introuvable")
	screenGui:Destroy()
	return
end

local rows = {}

for _, child in ipairs(statList:GetChildren()) do
	if child:IsA("Frame") then
		local value = child:FindFirstChild("Value")
		local cue = child:FindFirstChild("PreviewCue")

		if value and value:IsA("TextLabel") then
			rows[child.Name] = {
				Root = child,
				Value = value,
				Cue = if cue and cue:IsA("TextLabel") then cue else nil,
			}
		end
	end
end

local activePreviewTweens = {}
local activePreviewRows = {}

local function clearPreviewRow(row)
	local previewTween = activePreviewTweens[row]

	if previewTween then
		previewTween:Cancel()
		activePreviewTweens[row] = nil
	end

	local cue = row.Cue

	if cue then
		cue.Visible = false
		cue.Text = ""
		cue.TextTransparency = 1
	end

	activePreviewRows[row] = nil
end

local function clearAllPreviews()
	local rowsToClear = {}

	for row in pairs(activePreviewRows) do
		table.insert(rowsToClear, row)
	end

	for _, row in ipairs(rowsToClear) do
		clearPreviewRow(row)
	end
end

local function showPreview(row, delta, impact)
	local cue = row.Cue

	if cue == nil then
		return
	end

	local positive = delta >= 0
	local startY = if positive then 0.62 else 0.38
	local endY = if positive then 0.36 else 0.64

	clearPreviewRow(row)

	cue.Text = string.rep(if positive then "▲" else "▼", math.clamp(impact, 1, 3))
	cue.TextColor3 = if positive then POSITIVE_COLOR else NEGATIVE_COLOR
	cue.Position = UDim2.fromScale(0.595, startY)
	cue.TextTransparency = 0.02
	cue.Visible = true

	local previewTween = TweenService:Create(cue, PREVIEW_TWEEN, {
		Position = UDim2.fromScale(0.595, endY),
		TextTransparency = 0.46,
	})
	activePreviewTweens[row] = previewTween
	activePreviewRows[row] = true
	previewTween:Play()
end

local function previewCard(card)
	clearAllPreviews()

	local preview = card:FindFirstChild("StatPreview")

	if preview == nil then
		return
	end

	for _, entry in ipairs(preview:GetChildren()) do
		if entry:IsA("NumberValue") and entry.Value ~= 0 then
			local row = rows[entry.Name]

			if row then
				local impact = math.clamp(math.floor(getNumber(entry:GetAttribute("VisualImpact"), 1)), 1, 3)
				showPreview(row, entry.Value, impact)
			end
		end
	end
end

local boundCards = {}

local function bindCard(card)
	if boundCards[card] or not card:IsA("GuiObject") then
		return
	end

	boundCards[card] = true
	card.MouseEnter:Connect(function()
		previewCard(card)
	end)
	card.MouseLeave:Connect(clearAllPreviews)
	card.SelectionGained:Connect(function()
		previewCard(card)
	end)
	card.SelectionLost:Connect(clearAllPreviews)
	card.Destroying:Connect(function()
		boundCards[card] = nil
		clearAllPreviews()
	end)
end

local observedPerkChoiceGuis = {}

local function bindPerkChoiceGui(perkChoiceGui)
	if observedPerkChoiceGuis[perkChoiceGui] or not perkChoiceGui:IsA("ScreenGui") then
		return
	end
	observedPerkChoiceGuis[perkChoiceGui] = true

	perkChoiceGui:GetPropertyChangedSignal("Enabled"):Connect(function()
		if not perkChoiceGui.Enabled then
			clearAllPreviews()
		end
	end)
	perkChoiceGui.Destroying:Connect(function()
		observedPerkChoiceGuis[perkChoiceGui] = nil
		clearAllPreviews()
	end)

	-- PerkChoiceV2 est construit apres son parent ScreenGui. Le raccordement
	-- attend donc sa hierarchie au lieu de dependre de l'ordre des LocalScripts.
	task.spawn(function()
		local overlay = perkChoiceGui:WaitForChild("Overlay", 5)
		local dock = overlay and overlay:WaitForChild("PerkChoiceDockV2", 5)
		local choicePanel = dock and dock:WaitForChild("PerkChoicePanel", 5)
		local choiceContent = choicePanel and choicePanel:WaitForChild("Content", 5)
		local offers = choiceContent and choiceContent:WaitForChild("Offers", 5)

		if offers == nil then
			DebugLog.Warn("UI", "Apercu statistiques V2 non raccorde, offres introuvables")
			return
		end

		for _, card in ipairs(offers:GetChildren()) do
			bindCard(card)
		end

		offers.ChildAdded:Connect(bindCard)
	end)
end

local currentPerkChoiceGui = playerGui:FindFirstChild("PerkChoiceV2")

if currentPerkChoiceGui then
	bindPerkChoiceGui(currentPerkChoiceGui)
end

playerGui.ChildAdded:Connect(function(child)
	if child.Name == "PerkChoiceV2" then
		bindPerkChoiceGui(child)
	end
end)

local function refreshRows()
	local stats = state.DisplayStats
	local maxHealth = state.MaxHealth

	if maxHealth <= 0 then
		maxHealth = getNumber(stats.MaxHealth, 100)
	end

	local currentShield = state.CurrentShield
	local maxShield = state.MaxShield

	if maxShield <= 0 then
		maxShield = getNumber(stats.MaxShield)
	end

	if currentShield <= 0 and getNumber(stats.CurrentShield) > 0 then
		currentShield = getNumber(stats.CurrentShield)
	end

	local values = {
		MaxHealth = formatInteger(maxHealth),
		HealthRegen = formatDecimal(stats.HealthRegen, 1) .. " /s",
		Shield = formatInteger(currentShield) .. " / " .. formatInteger(maxShield),
		Armor = "-" .. formatPercent(stats.ArmorPercent) .. " degats",
		LifeSteal = formatPercent(stats.LifeStealPercent),
		BaseDamage = formatDecimal(stats.BaseDamage, 1),
		EliteDamage = formatDecimal(stats.EliteDamage, 1),
		AttackRate = formatDecimal(stats.AttackRate, 2) .. " /s",
		ProjectileCount = formatInteger(stats.ProjectileCount),
		BounceCount = formatInteger(stats.BounceCount),
		CritChance = formatPercent(stats.CritChance),
		CritDamage = formatPercent(stats.CritDamageMultiplier),
		ProjectileSpeed = formatDecimal(stats.ProjectileSpeed, 0),
		ProjectileDuration = formatDecimal(stats.ProjectileDuration, 1) .. " s",
		MoveSpeed = formatDecimal(stats.MoveSpeed, 1),
		Jump = formatDecimal(stats.JumpValue, 1),
		CollectRadius = formatDecimal(stats.CollectRadius, 1),
		XpMultiplier = formatMultiplier(stats.XpMultiplier),
		GoldMultiplier = formatMultiplier(stats.GoldMultiplier),
		Luck = formatPercent(stats.Luck),
		EnemyMultiplier = formatMultiplier(stats.EnemyMultiplier),
	}

	for rowId, text in pairs(values) do
		local row = rows[rowId]

		if row then
			row.Value.Text = text
		end
	end
end

local function refreshVisibility()
	screenGui.Enabled = state.IsRunActive and state.IsPaused

	if not screenGui.Enabled then
		clearAllPreviews()
	end
end

local function onPerkStats(payload)
	payload = payload or {}

	if typeof(payload.DisplayStats) == "table" then
		state.DisplayStats = payload.DisplayStats
	end

	if payload.CurrentShield ~= nil then
		state.CurrentShield = getNumber(payload.CurrentShield)
	end

	if payload.MaxShield ~= nil then
		state.MaxShield = getNumber(payload.MaxShield)
	end

	refreshRows()
end

local function onCombatStats(payload)
	payload = payload or {}

	if payload.MaxHealth ~= nil then
		state.MaxHealth = math.max(1, getNumber(payload.MaxHealth, state.MaxHealth))
	end

	if payload.Shield ~= nil then
		state.CurrentShield = getNumber(payload.Shield)
	end

	if payload.MaxShield ~= nil then
		state.MaxShield = math.max(0, getNumber(payload.MaxShield))
	end

	refreshRows()
end

local function onPauseState(payload)
	payload = payload or {}
	state.IsPaused = payload.IsPaused == true
	refreshVisibility()
end

local function onRunState(payload)
	payload = payload or {}
	state.IsRunActive = payload.IsRunActive == true

	if not state.IsRunActive then
		state.IsPaused = false
	end

	refreshVisibility()
end

ReplicatedStorage:WaitForChild("Perk_UpdateStats").OnClientEvent:Connect(onPerkStats)
ReplicatedStorage:WaitForChild("Combat_UpdateStats").OnClientEvent:Connect(onCombatStats)
ReplicatedStorage:WaitForChild("Combat_PauseState").OnClientEvent:Connect(onPauseState)
ReplicatedStorage:WaitForChild("Run_StateUpdate").OnClientEvent:Connect(onRunState)
ReplicatedStorage:WaitForChild("Perk_HideChoices").OnClientEvent:Connect(clearAllPreviews)

refreshRows()
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="147">
          <Properties>
            <string name="Name">RunSummaryUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BossConfig = require(Shared:WaitForChild("BossConfig"))
local MetaProgressionConfig = require(Shared:WaitForChild("MetaProgressionConfig"))
local UiTheme = require(Shared:WaitForChild("UiTheme"))

local existingGui = playerGui:FindFirstChild("RunSummaryGui")

if existingGui ~= nil then
	existingGui:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "RunSummaryGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 180
screenGui.Parent = playerGui

local addCorner = UiTheme.AddCorner
local addStroke = UiTheme.AddStroke

local function addGradient(instance, firstColor, secondColor)
	return UiTheme.AddGradient(instance, firstColor, secondColor, 90)
end

local function createLabel(parent, name, text, size, color, font)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Font = font or UiTheme.Fonts.Bold
	label.Text = text
	label.TextColor3 = color
	label.TextSize = size
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 0.5
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = parent
	return label
end

