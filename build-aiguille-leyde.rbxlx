local function createProfileCard(
	parent: Instance,
	entries: {EntryData},
	accent: Color3
)
	local card = Instance.new("Frame")
	card.Name = "ProfileCard"
	card.Size = UDim2.new(1, 0, 0, 260)
	card.BackgroundColor3 = COLORS.Card
	card.BackgroundTransparency = 0.16
