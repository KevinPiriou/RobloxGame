addStroke(acceptButton, CHEST_UI_COLORS.AccentLight, 0.32, 1)

local function setDecisionButtonsEnabled(isEnabled)
	skipButton.Active = isEnabled
	skipButton.AutoButtonColor = isEnabled
	acceptButton.Active = isEnabled
	acceptButton.AutoButtonColor = isEnabled
end

local function closeSlotUi()
	if currentPromptChest ~= nil then
		setPromptVisible(currentPromptChest, false)
	end

	slotGui.Enabled = false
	buttonRow.Visible = false
	setDecisionButtonsEnabled(true)
	isSlotPlaying = false
	currentPromptChest = nil
	pendingChest = nil
	activeOpeningId = nil
end

local function setDisplayedReward(reward)
	if typeof(reward) == "table" then
		reelLabel.Text = tostring(reward.Name or "Objet mystere")
		rewardIcon.Image = tostring(reward.Icon or "")
		return
	end

	reelLabel.Text = tostring(reward or "Objet mystere")
	rewardIcon.Image = ""
end

local function playSlotAnimation(payload)
	payload = payload or {}

	local reward = payload.Reward or {
		Name = "Objet mystere",
		Description = "Objet a venir",
	}
	local spinItems = payload.SpinItems or { reward.Name }

	if #spinItems <= 0 then
		spinItems = { reward.Name }
	end

	local duration = payload.Duration or ChestConfig.SlotDuration
	local startedAt = os.clock()
	local nextTickAt = startedAt
	local currentIndex = 0

	activeOpeningId = payload.OpeningId
	isSlotPlaying = true
	slotGui.Enabled = true
	buttonRow.Visible = false
	setDecisionButtonsEnabled(false)
	slotTitle.Text = "Coffre ouvert"
	if payload.IsRewardChest then
		slotSubtitle.Text = "Recompense elite"
	else
		slotSubtitle.Text = ("Ouverture : %d coins"):format(payload.Cost or currentOpenCost)
	end

	while os.clock() - startedAt < duration do
		local elapsed = os.clock() - startedAt
		local progress = math.clamp(elapsed / duration, 0, 1)
		local interval = ChestConfig.SlotMinInterval
			+ ((ChestConfig.SlotMaxInterval - ChestConfig.SlotMinInterval) * progress)

		if os.clock() >= nextTickAt then
			currentIndex = (currentIndex % #spinItems) + 1
			setDisplayedReward(spinItems[currentIndex])
			nextTickAt = os.clock() + interval
		end

		RunService.RenderStepped:Wait()
	end

	setDisplayedReward(reward)
	slotSubtitle.Text = tostring(reward.Description or "Objet a venir")
	buttonRow.Visible = true
	setDecisionButtonsEnabled(true)
end

local function showOpenFailed(payload)
	payload = payload or {}

	if payload.NextOpenCost ~= nil then
		currentOpenCost = payload.NextOpenCost
	end

	for _, chestState in pairs(trackedChests) do
		updatePromptLabel(chestState)
	end

	isSlotPlaying = true
	slotGui.Enabled = true
	buttonRow.Visible = false
	slotTitle.Text = "Coffre"
	reelLabel.Text = "Ouverture impossible"

	if payload.Reason == "NotEnoughCoins" then
		slotSubtitle.Text = ("Il faut %d coins."):format(payload.NextOpenCost or currentOpenCost)
	elseif payload.Reason == "NoEligibleReward" then
		slotSubtitle.Text = "Aucune recompense disponible."
	else
		slotSubtitle.Text = "Rapproche-toi du coffre."
	end

	task.delay(1.2, function()
		if activeOpeningId == nil then
			closeSlotUi()
		end
	end)
end

local function submitChoice(action)
	if activeOpeningId == nil then
		return
	end

	setDecisionButtonsEnabled(false)
	slotSubtitle.Text = "Validation..."
	choiceRequestRemote:FireServer(activeOpeningId, action)
end

for _, descendant in ipairs(Workspace:GetDescendants()) do
	trackChest(descendant)
end

Workspace.DescendantAdded:Connect(function(descendant)
	task.defer(function()
		trackChest(descendant)
	end)
end)

Workspace.DescendantRemoving:Connect(function(descendant)
	local chestState = trackedChests[descendant]

	if chestState ~= nil and chestState.Prompt ~= nil then
		chestState.Prompt:Destroy()
	end

	trackedChests[descendant] = nil
end)

RunService.RenderStepped:Connect(function()
	if not CLIENT_CHEST_PROMPTS_ENABLED then
		return
	end

	local closestChest = getClosestPromptChest()

	if closestChest == currentPromptChest then
		return
	end

	if currentPromptChest ~= nil then
		setPromptVisible(currentPromptChest, false)
	end

	currentPromptChest = closestChest

	if currentPromptChest ~= nil then
		setPromptVisible(currentPromptChest, true)
	end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if not CLIENT_CHEST_PROMPTS_ENABLED then
		return
	end

	if gameProcessed or input.KeyCode ~= Enum.KeyCode.E then
		return
	end

	if currentPromptChest == nil or pendingChest ~= nil then
		return
	end

	pendingChest = currentPromptChest
	setPromptVisible(pendingChest, false)
	DebugLog.Info("UI", "Demande ouverture coffre envoyee", {
		Chest = pendingChest,
		Cost = currentOpenCost,
	})
	openRequestRemote:FireServer(pendingChest)

	local requestedChest = pendingChest

	task.delay(1.2, function()
		if pendingChest == requestedChest and not isSlotPlaying then
			pendingChest = nil
		end
	end)
end)

skipButton.Activated:Connect(function()
	submitChoice("Skip")
end)

acceptButton.Activated:Connect(function()
	submitChoice("Accept")
end)

openResultRemote.OnClientEvent:Connect(function(payload)
	payload = payload or {}
	DebugLog.Info("UI", "Ouverture coffre recue cote client", {
		OpeningId = payload.OpeningId,
		Cost = payload.Cost,
	})

	if payload.Chest ~= nil then
		setPromptVisible(payload.Chest, false)
	end

	if isV2PresentationReady() then
		activeOpeningId = payload.OpeningId
		isSlotPlaying = true
		return
	end

	task.spawn(function()
		playSlotAnimation(payload)
	end)
end)

openFailedRemote.OnClientEvent:Connect(function(payload)
	DebugLog.Info("UI", "Ouverture coffre refusee cote client", payload)

	if isV2PresentationReady() then
		isSlotPlaying = false
		activeOpeningId = nil
		return
	end

	showOpenFailed(payload)
end)

choiceResultRemote.OnClientEvent:Connect(function(payload)
	payload = payload or {}
	DebugLog.Info("UI", "Choix coffre termine cote client", payload)

	if payload.NextOpenCost ~= nil then
		currentOpenCost = payload.NextOpenCost
	end

	for _, chestState in pairs(trackedChests) do
		updatePromptLabel(chestState)
	end

	if isV2PresentationReady() then
		closeSlotUi()
		return
	end

	if payload.Accepted then
		local stacks = math.max(1, math.floor(tonumber(payload.ItemCount) or 1))
		slotSubtitle.Text = "Objet equipe - x" .. tostring(stacks)
	else
		slotSubtitle.Text = "Objet passe."
	end

	-- Laisse le joueur lire le stack obtenu avant la reprise de la run.
	task.delay(0.75, closeSlotUi)
end)

priceUpdateRemote.OnClientEvent:Connect(function(payload)
	payload = payload or {}

	if payload.NextOpenCost ~= nil then
		currentOpenCost = payload.NextOpenCost
	end

	for _, chestState in pairs(trackedChests) do
		updatePromptLabel(chestState)
	end
end)

DebugLog.Info("UI", "UI coffre initialisee", {
	Player = player.Name,
	BaseOpenCost = currentOpenCost,
})
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="120">
          <Properties>
            <string name="Name">CoinClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local CombatConfig = require(Shared:WaitForChild("CombatConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local GraphicsController = require(script.Parent:WaitForChild("GraphicsController"))

local player = Players.LocalPlayer
local collectCoinRemote = ReplicatedStorage:WaitForChild("Coin_PlayCollect")
local collectXpRemote = ReplicatedStorage:WaitForChild("Xp_PlayCollect")

local animatedCollectibles = {}
local hiddenCollectibles = {}
local activeCollectAnimations = {}
local elapsedSinceCull = 0
local elapsedSinceIdleAnimation = 0
local activeCollectAnimationCount = 0

GraphicsController.Start()

local function isCoinName(name)
	for _, coinName in ipairs(GameConfig.CoinTierNames or { "Coin" }) do
		if name == coinName then
			return true
		end
	end

	return false
end

local function isXpGemName(name)
	for _, gemName in ipairs(CombatConfig.XpGemTierNames) do
		if name == gemName then
			return true
		end
	end

	return false
end

local function findCoinRoot(coin)
	if coin:IsA("BasePart") then
		return coin
	end

	if not coin:IsA("Model") then
		return nil
	end

	if coin.PrimaryPart ~= nil then
		return coin.PrimaryPart
	end

	return coin:FindFirstChildWhichIsA("BasePart", true)
end

local function hasCollectibleModelAncestor(instance, collectibleName)
	local current = instance.Parent

	while current ~= nil do
		if current:IsA("Model") and current.Name == collectibleName then
			return true
		end

		current = current.Parent
	end

	return false
end

local function isCollectible(instance)
	if not isCoinName(instance.Name) and not isXpGemName(instance.Name) then
		return false
	end

	if instance:IsA("Model") then
		return findCoinRoot(instance) ~= nil
	end

	if instance:IsA("BasePart") then
		return not hasCollectibleModelAncestor(instance, instance.Name)
	end

	return false
end

local function setCoinCFrame(coin, cframe)
	if coin:IsA("Model") then
		coin:PivotTo(cframe)
	elseif coin:IsA("BasePart") then
		coin.CFrame = cframe
	end
end

local function getCoinCFrame(coin)
	if coin:IsA("Model") then
		return coin:GetPivot()
	end

	if coin:IsA("BasePart") then
		return coin.CFrame
	end

	return nil
end

local function isInstanceVisibleToCamera(instance)
	local currentCamera = Workspace.CurrentCamera

	if currentCamera == nil then
		return true
	end

	local cframe = getCoinCFrame(instance)

	if cframe == nil then
		return true
	end

	local viewportSize = currentCamera.ViewportSize
	local screenPosition, isInFront = currentCamera:WorldToViewportPoint(cframe.Position)

	if not isInFront then
		return false
	end

	local distance = (currentCamera.CFrame.Position - cframe.Position).Magnitude

	local collectibleSettings = GraphicsController.GetCollectibleSettings()

	if distance > collectibleSettings.CullMaxDistance then
		return false
	end

	local margin = collectibleSettings.CullViewportMargin

	return screenPosition.X >= -margin
		and screenPosition.X <= viewportSize.X + margin
		and screenPosition.Y >= -margin
		and screenPosition.Y <= viewportSize.Y + margin
end

local function setCoinTransparency(coin, transparency)
	if coin:IsA("BasePart") then
		coin.LocalTransparencyModifier = transparency
		return
	end

	for _, descendant in ipairs(coin:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.LocalTransparencyModifier = transparency
		end
	end
end

local function setCollectibleCulled(coin, isCulled)
	if hiddenCollectibles[coin] == isCulled then
		return
	end

	hiddenCollectibles[coin] = isCulled

	if isCulled then
		setCoinTransparency(coin, 1)
	else
		setCoinTransparency(coin, 0)
	end
end

local function trackCoin(instance)
	if not isCollectible(instance) then
		return
	end

	setCoinTransparency(instance, 0)
	hiddenCollectibles[instance] = nil
	animatedCollectibles[instance] = true
end

local function getPlayerTargetPosition(userId)
	local targetPlayer = Players:GetPlayerByUserId(userId)

	if targetPlayer == nil or targetPlayer.Character == nil then
		return nil
	end

	local root = targetPlayer.Character:FindFirstChild("HumanoidRootPart")

	if root == nil then
		return nil
	end

	return root.Position + Vector3.new(0, 2, 0)
end

for _, descendant in ipairs(Workspace:GetDescendants()) do
	trackCoin(descendant)
end

Workspace.DescendantAdded:Connect(function(descendant)
	task.defer(function()
		trackCoin(descendant)
	end)
end)

Workspace.DescendantRemoving:Connect(function(descendant)
	animatedCollectibles[descendant] = nil
	hiddenCollectibles[descendant] = nil

	if activeCollectAnimations[descendant] ~= nil then
		activeCollectAnimations[descendant] = nil
		activeCollectAnimationCount = math.max(0, activeCollectAnimationCount - 1)
	end
end)

local function updateCollectibleCulling()
	if not CombatConfig.CollectibleCullingEnabled then
		return
	end

	for coin in pairs(animatedCollectibles) do
		if coin.Parent == nil then
			animatedCollectibles[coin] = nil
			hiddenCollectibles[coin] = nil
			continue
		end

		setCollectibleCulled(coin, not isInstanceVisibleToCamera(coin))
	end
end

local function updateIdleCollectibleAnimation(deltaTime)
	for coin in pairs(animatedCollectibles) do
		if coin.Parent == nil then
			animatedCollectibles[coin] = nil
			hiddenCollectibles[coin] = nil
			continue
		end

		if hiddenCollectibles[coin] then
			continue
		end

		local currentCFrame = getCoinCFrame(coin)

		if currentCFrame ~= nil then
			local rotationSpeed = GameConfig.CoinRotationSpeed

			if isXpGemName(coin.Name) then
				rotationSpeed = CombatConfig.XpGemRotationSpeed
			end

			local rotation = CFrame.Angles(0, math.rad(rotationSpeed) * deltaTime, 0)
			setCoinCFrame(coin, currentCFrame * rotation)
		end
	end
end

local function updateCollectAnimations()
	for coin, animationState in pairs(activeCollectAnimations) do
		if coin.Parent == nil then
			activeCollectAnimations[coin] = nil
			activeCollectAnimationCount = math.max(0, activeCollectAnimationCount - 1)
			continue
		end

		local alpha = math.clamp((os.clock() - animationState.StartedAt) / animationState.Duration, 0, 1)
		local targetPosition = getPlayerTargetPosition(animationState.CollectorUserId)

		if targetPosition == nil then
			targetPosition = animationState.StartCFrame.Position + Vector3.new(0, 3, 0)
		end

		local easedAlpha = 1 - ((1 - alpha) * (1 - alpha))
		local currentPosition = animationState.StartCFrame.Position:Lerp(targetPosition, easedAlpha)
		local spin = CFrame.Angles(0, math.rad(720) * alpha, 0)

		setCoinCFrame(coin, CFrame.new(currentPosition) * spin)

		if animationState.LastTransparency == nil or alpha - animationState.LastTransparency >= 0.04 or alpha >= 1 then
			setCoinTransparency(coin, alpha)
			animationState.LastTransparency = alpha
		end

		if alpha >= 1 then
			if animationState.CollectorUserId == player.UserId then
				-- Petite confirmation locale: l'UI serveur mettra le compteur a jour juste apres.
				setCoinTransparency(coin, 1)
			end

			activeCollectAnimations[coin] = nil
			activeCollectAnimationCount = math.max(0, activeCollectAnimationCount - 1)
		end
	end
end

RunService.RenderStepped:Connect(function(deltaTime)
	if deltaTime >= (CombatConfig.ClientFrameSpikeLogThreshold or 0.12) then
		DebugLog.ThrottledWarn("Perf", "client_frame_spike", 2, "Pic de frame client detecte", {
			AttractAnimations = activeCollectAnimationCount,
			DeltaMilliseconds = math.floor((deltaTime * 1000) + 0.5),
		})
	end

	elapsedSinceCull += deltaTime
	elapsedSinceIdleAnimation += deltaTime

	local collectibleSettings = GraphicsController.GetCollectibleSettings()

	if elapsedSinceCull >= collectibleSettings.CullInterval then
		elapsedSinceCull = 0
		updateCollectibleCulling()
	end

	local idleAnimationHz = math.max(1, collectibleSettings.IdleAnimationHz)
	local idleAnimationStep = 1 / idleAnimationHz

	if elapsedSinceIdleAnimation >= idleAnimationStep then
		local animationDeltaTime = math.min(elapsedSinceIdleAnimation, idleAnimationStep * 2)
		elapsedSinceIdleAnimation = 0
		updateIdleCollectibleAnimation(animationDeltaTime)
	end

	updateCollectAnimations()

	DebugLog.ThrottledInfo("Perf", "collectible_visual", CombatConfig.PerfLogInterval or 5, "Perf collectibles client", {
		IdleHz = idleAnimationHz,
		AttractAnimations = activeCollectAnimationCount,
		AttractCap = CombatConfig.CollectibleMaxConcurrentAttractAnimations,
	})
end)

local function playCollectAnimation(coin, collectorUserId, duration)
	if coin == nil or coin.Parent == nil then
		return
	end

	DebugLog.ThrottledInfo("UI", "collectible_animation", 0.5, "Animation collectible recue", {
		Collectible = coin,
		CollectorUserId = collectorUserId,
		Duration = duration,
	})

	animatedCollectibles[coin] = nil
	hiddenCollectibles[coin] = nil

	local startCFrame = getCoinCFrame(coin)

	if startCFrame == nil then
		return
	end

	if activeCollectAnimations[coin] ~= nil then
		return
	end

	if activeCollectAnimationCount >= (CombatConfig.CollectibleMaxConcurrentAttractAnimations or 72) then
		setCoinTransparency(coin, 1)
		return
	end

	activeCollectAnimations[coin] = {
		CollectorUserId = collectorUserId,
		Duration = math.max(0.01, duration),
		LastTransparency = nil,
		StartCFrame = startCFrame,
		StartedAt = os.clock(),
	}
	activeCollectAnimationCount += 1
end

collectCoinRemote.OnClientEvent:Connect(playCollectAnimation)
collectXpRemote.OnClientEvent:Connect(playCollectAnimation)

DebugLog.Info("UI", "Animation collectibles initialisee", {
	Player = player.Name,
	CullingEnabled = CombatConfig.CollectibleCullingEnabled,
})
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="121">
          <Properties>
            <string name="Name">CombatUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChestConfig = require(Shared:WaitForChild("ChestConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local HudMessageConfig = require(Shared:WaitForChild("HudMessageConfig"))
local UiTheme = require(Shared:WaitForChild("UiTheme"))

local function setNativeHealthGuiEnabled(isEnabled)
	task.spawn(function()
		local lastError = nil

		for _ = 1, 5 do
			local success, err = pcall(function()
				StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, isEnabled)
			end)

			if success then
				return
			end

			lastError = err
			task.wait(0.5)
		end

		DebugLog.Warn("UI", "CoreGui Health impossible a modifier", {
			Enabled = isEnabled,
			Error = tostring(lastError),
		})
	end)
end

setNativeHealthGuiEnabled(false)

local existingGui = playerGui:FindFirstChild("CombatGui")

if existingGui ~= nil then
	existingGui:Destroy()
end

local COLORS = UiTheme.Contexts.Combat
local ICON_IMAGES = UiTheme.Icons
local UI_FONTS = UiTheme.Fonts

local RUN_TIMER_SECONDS = 12 * 60
local BAR_TWEEN = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local QUICK_TWEEN = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local EVENT_IN_TWEEN = TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
local EVENT_OUT_TWEEN = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)

local togglePauseRemote = nil
local isPauseButtonBlocked = false
local viewportConnection = nil
local timerRemaining = RUN_TIMER_SECONDS
local damageFlashTween = nil
local eventMessageTweenIn = nil
local eventMessageTweenOut = nil
local eventMessageId = 0
local hasReceivedStatsSnapshot = false

local state = {
	Health = 100,
	MaxHealth = 100,
	Shield = 0,
	MaxShield = 0,
	AliveMonsters = 0,
	MaxAliveMonsters = 1,
	Wave = 1,
	Kills = 0,
	WeaponName = "Fireball",
	Coins = 0,
	ArcaneGems = math.max(0, math.floor(tonumber(player:GetAttribute("ArcaneGems")) or 0)),
	NextChestCost = ChestConfig.BaseOpenCost,
	Level = 1,
	Xp = 0,
	XpRequired = 6,
	PerkCount = 0,
	RunScore = 0,
	IsRunActive = false,
	IsUserPaused = false,
	HasBlockingPause = false,
}

state.IsRunActive = player:GetAttribute("IsRunActive") == true

local addCorner = UiTheme.AddCorner
local addStroke = UiTheme.AddStroke
local addGradient = UiTheme.AddGradient

local function addTextSizeConstraint(textObject, minSize, maxSize)
	local constraint = Instance.new("UITextSizeConstraint")
	constraint.MinTextSize = minSize
	constraint.MaxTextSize = maxSize
	constraint.Parent = textObject

	return constraint
end

local function createLabel(parent, name, text, font, textSize, color)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.Font = font or UI_FONTS.Bold
	label.Text = text or ""
	label.TextColor3 = color or COLORS.Text
	label.TextSize = textSize or 14
	label.TextStrokeColor3 = COLORS.Shadow
	label.TextStrokeTransparency = 0.45
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = parent

	return label
end

local function createIcon(parent, name, imageId, fallbackText, color, preserveImageColors)
	local holder = Instance.new("Frame")
	holder.Name = name
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Parent = parent

	if imageId ~= nil and imageId ~= "" then
		local image = Instance.new("ImageLabel")
		image.Name = "Image"
		image.BackgroundTransparency = 1
		image.Image = imageId
		image.ImageColor3 = if preserveImageColors then Color3.new(1, 1, 1) else (color or COLORS.Text)
		image.ScaleType = Enum.ScaleType.Fit
		image.Size = UDim2.fromScale(1, 1)
		image.Parent = holder
	else
		local label = createLabel(holder, "Fallback", fallbackText, UI_FONTS.Heavy, 18, color or COLORS.Text)
		label.Size = UDim2.fromScale(1, 1)
		label.TextXAlignment = Enum.TextXAlignment.Center
		label.TextYAlignment = Enum.TextYAlignment.Center
		addTextSizeConstraint(label, 11, 18)
	end

	return holder
end

local function createRunScoreIcon(parent, name, color)
	local imageId = ICON_IMAGES.RunScore

	if imageId ~= nil and imageId ~= "" then
		return createIcon(parent, name, imageId, "", color, true)
	end

	local holder = Instance.new("Frame")
	holder.Name = name
	holder.BackgroundTransparency = 1
	holder.BorderSizePixel = 0
	holder.Parent = parent

	for index, definition in ipairs({
		{ Position = UDim2.fromScale(0.16, 0.16), Rotation = -22 },
		{ Position = UDim2.fromScale(0.48, 0.42), Rotation = 22 },
	}) do
		local footprint = Instance.new("Frame")
		footprint.Name = "Footprint" .. tostring(index)
		footprint.AnchorPoint = Vector2.new(0.5, 0.5)
		footprint.Position = definition.Position
		footprint.Size = UDim2.fromScale(0.32, 0.55)
		footprint.BackgroundColor3 = color
		footprint.BorderSizePixel = 0
		footprint.Rotation = definition.Rotation
		footprint.Parent = holder
		addCorner(footprint, 8)
	end

	return holder
end

local function createBar(parent, name, fillColor, _fillDarkColor)
	local track = Instance.new("Frame")
	track.Name = name .. "Track"
	track.BackgroundColor3 = COLORS.Track
	track.BackgroundTransparency = 0.12
	track.BorderSizePixel = 0
	track.ClipsDescendants = true
	track.Parent = parent
	addCorner(track, 7)
	addStroke(track, COLORS.GlassStroke, 0.76, 1)

	local fill = Instance.new("Frame")
	fill.Name = name .. "Fill"
	fill.BackgroundColor3 = fillColor
	fill.BorderSizePixel = 0
	fill.Size = UDim2.fromScale(0, 1)
	fill.Parent = track
	addCorner(fill, 7)

	return track, fill
end

local function addGlassBackground(parent, name, position, size, radius)
	local glass = Instance.new("Frame")
	glass.Name = name
	glass.Position = position
	glass.Size = size
	glass.BackgroundColor3 = COLORS.Glass
	glass.BackgroundTransparency = 0.74
	glass.BorderSizePixel = 0
	glass.ZIndex = 0
	glass.Parent = parent
	addCorner(glass, radius)
	addStroke(glass, COLORS.GlassStroke, 0.58, 1)
	addGradient(glass, COLORS.Glass, COLORS.GlassTint, 90)

	return glass
end

local function addRunGlassSurface(parent, name, position, size, radius, accent)
	local surface = Instance.new("Frame")
	surface.Name = name
	surface.Position = position
	surface.Size = size
	surface.BackgroundColor3 = Color3.fromRGB(17, 27, 39)
	surface.BackgroundTransparency = 0.24
	surface.BorderSizePixel = 0
	surface.ZIndex = 0
	surface.Parent = parent
	addCorner(surface, radius)
	addStroke(surface, Color3.fromRGB(7, 12, 19), 0.16, 3)
	addStroke(surface, accent, 0.56, 1)
	addGradient(surface, Color3.fromRGB(47, 64, 86), Color3.fromRGB(12, 20, 31), 90)
	UiTheme.AddSurfaceFinish(surface, {
		Accent = accent,
		Intensity = 0.5,
	})

	return surface
end

local function addTopBarGlassSurface(parent, name, position, size, radius)
	local surface = Instance.new("Frame")
	surface.Name = name
	surface.Position = position
	surface.Size = size
	surface.BackgroundColor3 = Color3.fromRGB(37, 51, 70)
	surface.BackgroundTransparency = 0.26
	surface.BorderSizePixel = 0
	surface.ZIndex = 0
	surface.Parent = parent
	addCorner(surface, radius)
	addStroke(surface, COLORS.GlassTint, 0.36, 2)
	addGradient(surface, Color3.fromRGB(61, 81, 108), Color3.fromRGB(17, 27, 39), 90)

	local inner = Instance.new("Frame")
	inner.Name = "Inner"
	inner.Position = UDim2.fromOffset(4, 4)
	inner.Size = UDim2.new(1, -8, 1, -8)
	inner.BackgroundColor3 = Color3.fromRGB(17, 27, 39)
	inner.BackgroundTransparency = 0.38
	inner.BorderSizePixel = 0
	inner.Parent = surface
	addCorner(inner, math.max(0, radius - 3))
	addStroke(inner, COLORS.GlassStroke, 0.66, 1)
	UiTheme.AddSurfaceFinish(surface, {
		Accent = COLORS.GlassTint,
		Intensity = 0.6,
	})

	return surface
end

local function setBarProgress(fill, progress)
	TweenService:Create(fill, BAR_TWEEN, {
		Size = UDim2.new(math.clamp(progress, 0, 1), 0, 1, 0),
	}):Play()
end

local function formatNumber(value)
	local number = math.floor(tonumber(value) or 0)
	local text = tostring(number)
	local left, middle, right = string.match(text, "^([^%d]*%d)(%d*)(.-)$")

	if left == nil then
		return text
	end

	return left .. (middle:reverse():gsub("(%d%d%d)", "%1,"):reverse()) .. right
end

local function formatTopStatNumber(value)
	local number = math.max(0, math.floor(tonumber(value) or 0))

	if number >= 1000000 then
		return "1M"
	end

	return formatNumber(number)
end

local function formatTimer(seconds)
	local safeSeconds = math.max(0, math.floor(seconds + 0.5))
	local minutes = math.floor(safeSeconds / 60)
	local remainingSeconds = safeSeconds % 60

	return ("%02d:%02d"):format(minutes, remainingSeconds)
end

local function getViewportSize()
	local currentCamera = Workspace.CurrentCamera

	if currentCamera == nil then
		return Vector2.new(1280, 720)
	end

	return currentCamera.ViewportSize
end

