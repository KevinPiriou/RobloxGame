      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">CombatConfig</string>
          <string name="Source"><![CDATA[return {
	MonsterTemplateName = "Monster1",
	EliteMonsterTemplateName = "Monster1_Elite",
	FireballTemplateName = "Fireball",
	RuntimeFolderName = "CombatRuntime",
	TemplateFolderName = "CombatTemplates",
	MonsterFolderName = "Monsters",
	ProjectileFolderName = "Projectiles",
	LootFolderName = "Loot",

	-- Socle de sensation joueur avant perks et objets de run.
	-- La hausse de saut compense la marche legerement ralentie pour conserver une portee de saut positive.
	PlayerBaseWalkSpeed = 15,
	PlayerBaseJumpPower = 55,
	PlayerBaseJumpHeight = 8,
	-- Course locale additive : elle complete les animations Roblox sans modifier
	-- les regles de mouvement, les sauts ni les etats serveur du personnage.
	PlayerRunAnimationEnabled = true,
	PlayerRunAnimationMinSpeed = 2.5,
	PlayerRunAnimationBaseStrideHz = 2.35,
	PlayerRunAnimationMaxStrideHz = 3.25,
	PlayerRunAnimationArmDegrees = 38,
	PlayerRunAnimationLegDegrees = 31,
	PlayerRunAnimationTorsoLeanDegrees = 9,
	PlayerRunAnimationKneeDegrees = 17,
	PlayerRunAnimationBlendSpeed = 15,

	-- Zero utilise le Heartbeat directement pour que le visuel reste aligne aux hitboxes serveur.
	MonsterSimulationHz = 0,
	-- Zero utilise le Heartbeat directement pour que le projectile replique reste fluide pour son proprietaire.
	ProjectileSimulationHz = 0,
	-- Chaque run est instanciee en solo : le noyau visuel est donc construit uniquement chez son proprietaire.
	-- Remettre ReplicatedCore constitue le rollback immediat si un mode cooperatif est introduit plus tard.
	ProjectilePresentationMode = "ClientPilot",
	MonsterSpatialCellSize = 8,
	MonsterPoolPrewarm = 0,
	ProjectilePoolPrewarm = 24,
	XpGemPoolPrewarmPerTier = {
		80,
		24,
		8,
	},
	PerfLogInterval = 5,

	MonsterRootPartName = "RootPart",
	MonsterAnimationName = "Walk",
	MonsterAnimationPriority = Enum.AnimationPriority.Action,
	MonsterServerAnimationsEnabled = false,
	MonsterPartsCanCollide = false,
	MonsterPartsCanTouch = false,
	MonsterPartsCanQuery = false,
	MonsterInitialSpawnDelay = 3.5,
	MonsterSpawnInterval = 2.6,
	MonsterSpawnIntervalMin = 0.75,
	MonsterSpawnIntervalDecreasePerWave = 0.22,
	MonsterSpawnGroundedDelay = 3,
	-- L'anneau reste dans la partie utile des maps de 500 studs, sans pop immediat.
	MonsterMinSpawnDistance = 42,
	-- Reste sous le rayon de despawn pour eviter les spawns immediatement recycles.
	MonsterMaxSpawnDistance = 76,
	MonsterSpawnMapEdgeInset = 24,
	MonsterSpawnSurfaceAttempts = 18,
	-- Repli uniquement lorsque le grand anneau sort de la surface jouable de la map.
	MonsterSpawnFallbackMinDistance = 26,
	MonsterSpawnFallbackMaxDistance = 50,
	MonsterSpawnFallbackAttempts = 10,
	MonsterSpawnForwardBias = 0.35,
