			OutdoorAmbient = Color3.fromRGB(150, 172, 130),
			EnvironmentDiffuseScale = 0.54,
			EnvironmentSpecularScale = 0.18,
			ShadowSoftness = 0.42,
			Wind = Vector3.new(1.8, 0, 0.7),
			Blur = {
				Size = 0.45,
			},
			DepthOfField = {
				FocusDistance = 34,
				InFocusRadius = 26,
				NearIntensity = 0,
				FarIntensity = 0.1,
			},
			Atmosphere = {
				Density = 0.25,
				Offset = 0.04,
				Color = Color3.fromRGB(205, 232, 194),
				Decay = Color3.fromRGB(112, 154, 92),
				Glare = 0.012,
				Haze = 1.15,
			},
			Correction = {
				TintColor = Color3.fromRGB(232, 246, 219),
				Brightness = 0.012,
				Contrast = 0.02,
				Saturation = 0.02,
			},
			Bloom = {
				Intensity = 0.035,
				Size = 10,
				Threshold = 1.9,
			},
			SunRays = {
				Intensity = 0.01,
				Spread = 0.65,
			},
			Motes = {
