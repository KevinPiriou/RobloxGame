			Common = variant("+8% vitesse d'attaque", { AttackSpeedPercent = 0.08 }),
			Rare = variant("+16% vitesse d'attaque", { AttackSpeedPercent = 0.16 }),
			Epic = variant("+28% vitesse d'attaque", { AttackSpeedPercent = 0.28 }),
