local answersLayout = Instance.new("UIGridLayout")
answersLayout.CellPadding = UDim2.new(0, 6, 0, 6)
answersLayout.CellSize = UDim2.new(0.5, -3, 0, 32)
answersLayout.FillDirection = Enum.FillDirection.Horizontal
answersLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
answersLayout.SortOrder = Enum.SortOrder.LayoutOrder
answersLayout.VerticalAlignment = Enum.VerticalAlignment.Top
answersLayout.Parent = answersFrame

local function clearAnswers()
	for _, button in ipairs(answerButtons) do
		button:Destroy()
	end

	answerButtons = {}
end

local function setButtonsEnabled(isEnabled)
	for _, button in ipairs(answerButtons) do
		button.Active = isEnabled
		button.AutoButtonColor = isEnabled
	end
end

local function setButtonColor(button, color)
	button.BackgroundColor3 = color
end

local function updateSelectionStyle()
	for index, button in ipairs(answerButtons) do
		if index == selectedAnswerIndex then
			setButtonColor(button, Color3.fromRGB(70, 95, 150))
		else
			setButtonColor(button, Color3.fromRGB(52, 58, 69))
		end
	end
end

local function markResult(selectedAnswerIndex, correctAnswerIndex)
	for index, button in ipairs(answerButtons) do
		if index == correctAnswerIndex then
			setButtonColor(button, Color3.fromRGB(46, 132, 82))
		elseif index == selectedAnswerIndex then
			setButtonColor(button, Color3.fromRGB(156, 64, 64))
		else
			setButtonColor(button, Color3.fromRGB(55, 61, 72))
		end
	end
end

local function submitAnswer(answerIndex)
	if activeRoundId == nil then
		return
	end

	if selectedAnswerIndex == answerIndex then
		selectedAnswerIndex = nil
		submitAnswerRemote:FireServer(activeRoundId, 0)
	else
		selectedAnswerIndex = answerIndex
		submitAnswerRemote:FireServer(activeRoundId, answerIndex)
	end

	updateSelectionStyle()
end

local function createAnswerButton(answerText, answerIndex)
	local button = Instance.new("TextButton")
	button.Name = "Answer" .. answerIndex
	button.BackgroundColor3 = Color3.fromRGB(52, 58, 69)
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamBold
	button.Text = answerText
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextScaled = true
	button.TextWrapped = true
	button.LayoutOrder = answerIndex
	button.Parent = answersFrame
	addTextSizeConstraint(button, 10, 14)

	local buttonCorner = Instance.new("UICorner")
	buttonCorner.CornerRadius = UDim.new(0, 5)
	buttonCorner.Parent = button

	local buttonPadding = Instance.new("UIPadding")
	buttonPadding.PaddingRight = UDim.new(0, 6)
	buttonPadding.PaddingLeft = UDim.new(0, 6)
	buttonPadding.Parent = button

	button.Activated:Connect(function()
		submitAnswer(answerIndex)
	end)

	answerButtons[answerIndex] = button
end

local function startTimer(duration)
	timerVersion += 1

	local localTimerVersion = timerVersion

	task.spawn(function()
		for remaining = duration, 0, -1 do
			if localTimerVersion ~= timerVersion or activeRoundId == nil then
				return
			end

			statusLabel.Text = ("%d s"):format(remaining)

			task.wait(1)
		end
	end)
end

local function showQuestion(payload)
	activeRoundId = payload.RoundId
	selectedAnswerIndex = nil

	clearAnswers()

	questionLabel.Text = payload.Prompt
	statusLabel.Text = ""

	for index, answerText in ipairs(payload.Answers) do
		createAnswerButton(answerText, index)
	end

	startTimer(payload.TimeLimit)
end

local function showStatus(payload)
	activeRoundId = nil
	selectedAnswerIndex = nil
	timerVersion += 1
	clearAnswers()

	questionLabel.Text = payload.Message or "En attente..."
	statusLabel.Text = ""
end

local function showResult(payload)
	activeRoundId = nil
	selectedAnswerIndex = nil
	timerVersion += 1
	setButtonsEnabled(false)
	markResult(payload.SelectedAnswerIndex, payload.CorrectAnswerIndex)

	if payload.WasCorrect then
		statusLabel.Text = "Bonus"
	elseif payload.SelectedAnswerIndex == 0 then
		statusLabel.Text = "Temps ecoule"
	else
		statusLabel.Text = "Malus"
	end

	scoreLabel.Text = "Score : " .. tostring(payload.Score)
	questionLabel.Text = payload.EffectMessage or ("Bonne reponse : " .. payload.CorrectAnswerText)
end

if isQuizEnabled then
	showQuestionRemote.OnClientEvent:Connect(showQuestion)

	showResultRemote.OnClientEvent:Connect(function(payload)
		if payload.State == "Result" then
			showResult(payload)
		else
			showStatus(payload)
		end
	end)

	updateScoreRemote.OnClientEvent:Connect(function(score)
		scoreLabel.Text = "Score : " .. tostring(score)
	end)

	updateEffectsRemote.OnClientEvent:Connect(function(payload)
		local stackCount = payload.JumpBonusStacks or 0
		local jumpMultiplier = payload.JumpMultiplier or 1
		local saveStatus = ""

		if payload.LastSaveSucceeded == false then
			saveStatus = " | non sauvegarde"
		end

		if stackCount <= 0 then
			effectsLabel.Text = "Bonus saut : aucun" .. saveStatus
		else
			effectsLabel.Text = ("Bonus saut : %d stacks | x%.1f%s"):format(stackCount, jumpMultiplier, saveStatus)
		end
	end)
end

updateCoinsRemote.OnClientEvent:Connect(function(payload)
	local coinCount = payload.Coins or 0
	local saveStatus = ""

	if payload.LastSaveSucceeded == false then
		saveStatus = " *"
	end

	coinsLabel.Text = "Golds : " .. tostring(coinCount) .. saveStatus
end)

DebugLog.Info("UI", "UI quiz initialisee", {
	Player = player.Name,
})

local function getViewportSize()
	local currentCamera = workspace.CurrentCamera

	if currentCamera == nil then
		return Vector2.new(1280, 720)
	end

	return currentCamera.ViewportSize
end

local function setContainerTopLeft(topLeft)
	local viewportSize = getViewportSize()
	local containerSize = container.AbsoluteSize
	local margin = 6

	local clampedTopLeft = Vector2.new(
		math.clamp(topLeft.X, margin, math.max(margin, viewportSize.X - containerSize.X - margin)),
		math.clamp(topLeft.Y, margin, math.max(margin, viewportSize.Y - containerSize.Y - margin))
	)

	container.Position = UDim2.fromOffset(
		clampedTopLeft.X + (containerSize.X * container.AnchorPoint.X),
		clampedTopLeft.Y + (containerSize.Y * container.AnchorPoint.Y)
	)
end

local function beginDrag(input)
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	dragging = true
	dragStartPosition = input.Position
	dragStartTopLeft = container.AbsolutePosition

	input.Changed:Connect(function()
		if input.UserInputState == Enum.UserInputState.End then
			dragging = false
		end
	end)
end

local function bindDragHandle(handle)
	handle.InputBegan:Connect(beginDrag)
end

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local delta = input.Position - dragStartPosition
	setContainerTopLeft(dragStartTopLeft + Vector2.new(delta.X, delta.Y))
end)

bindDragHandle(headerFrame)
bindDragHandle(quizLabel)
bindDragHandle(statusLabel)
bindDragHandle(scoreLabel)
bindDragHandle(questionLabel)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="150">
          <Properties>
            <string name="Name">VfxQualityController</string>
            <string name="Source"><![CDATA[-- Budget local des VFX. Il ajuste uniquement le rendu du joueur courant.

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local VfxConfig = require(Shared:WaitForChild("VfxConfig"))

local GraphicsController = require(script.Parent:WaitForChild("GraphicsController"))

local VfxQualityController = {}

local isStarted = false
local changedEvent = Instance.new("BindableEvent")
local manualQualityName = "Balanced"
local effectsIntensity = 1
local adaptivePenalty = 0
local benchmarkLockEnabled = false
local sampleElapsed = 0
local sampleFrameTime = 0
local sampleFrames = 0
local slowSamples = 0
local fastSamples = 0

local function getManualQualityIndex()
	return VfxConfig.GetQualityIndex(manualQualityName)
end

local function getEffectiveQualityName()
	local manualIndex = getManualQualityIndex()
	local effectiveIndex = math.max(1, manualIndex - adaptivePenalty)
	return VfxConfig.GetQualityName(effectiveIndex)
end

local function buildSettings()
	local qualityName = getEffectiveQualityName()

	return {
		ManualQuality = manualQualityName,
		Quality = qualityName,
		EffectsIntensity = effectsIntensity,
		AdaptivePenalty = adaptivePenalty,
		BenchmarkLockEnabled = benchmarkLockEnabled,
		Profile = VfxConfig.GetQualityProfile(qualityName),
	}
end

local function notifyChanged()
	changedEvent:Fire(buildSettings())
end

local function applyGraphicsSettings(settings)
	if typeof(settings) ~= "table" then
		return
	end

	manualQualityName = settings.Quality or manualQualityName
	effectsIntensity = math.clamp(tonumber(settings.EffectsIntensity) or effectsIntensity, 0, 1)
	adaptivePenalty = math.clamp(adaptivePenalty, 0, math.max(0, getManualQualityIndex() - 1))
	notifyChanged()
end

local function updateAdaptiveBudget(deltaTime)
	if benchmarkLockEnabled then
		sampleElapsed = 0
		sampleFrameTime = 0
		sampleFrames = 0
		slowSamples = 0
		fastSamples = 0
		return
	end

	if effectsIntensity <= 0 then
		sampleElapsed = 0
		sampleFrameTime = 0
		sampleFrames = 0
		slowSamples = 0
		fastSamples = 0
		return
	end

	sampleElapsed += deltaTime
	sampleFrameTime += deltaTime
	sampleFrames += 1

	if sampleElapsed < VfxConfig.AdaptiveBudget.SampleSeconds then
		return
	end

	local averageFrameTime = sampleFrameTime / math.max(1, sampleFrames)
	sampleElapsed = 0
	sampleFrameTime = 0
	sampleFrames = 0

	if averageFrameTime > VfxConfig.AdaptiveBudget.SlowFrameTime then
		slowSamples += 1
		fastSamples = 0
	elseif averageFrameTime < VfxConfig.AdaptiveBudget.RecoverFrameTime then
		fastSamples += 1
		slowSamples = 0
	else
		slowSamples = 0
		fastSamples = 0
	end

	local manualIndex = getManualQualityIndex()
	local maximumPenalty = math.max(0, manualIndex - 1)

	if slowSamples >= VfxConfig.AdaptiveBudget.SlowFrameSeconds and adaptivePenalty < maximumPenalty then
		adaptivePenalty += 1
		slowSamples = 0
		fastSamples = 0
		DebugLog.Info("Vfx", "Budget VFX reduit", buildSettings())
		notifyChanged()
	elseif fastSamples >= VfxConfig.AdaptiveBudget.RecoverFrameSeconds and adaptivePenalty > 0 then
		adaptivePenalty -= 1
		slowSamples = 0
		fastSamples = 0
		DebugLog.Info("Vfx", "Budget VFX restaure", buildSettings())
		notifyChanged()
	end
end

function VfxQualityController.GetSettings()
	return buildSettings()
end

function VfxQualityController.SetBenchmarkLock(isEnabled)
	local nextValue = isEnabled == true

	if benchmarkLockEnabled == nextValue then
		return
	end

	benchmarkLockEnabled = nextValue
	-- Une campagne repart de la qualite manuelle, pas d'une penalite issue
	-- d'une activite precedente du joueur.
	adaptivePenalty = 0
	sampleElapsed = 0
	sampleFrameTime = 0
	sampleFrames = 0
	slowSamples = 0
	fastSamples = 0
	notifyChanged()
end

function VfxQualityController.Start()
	if isStarted then
		return
	end

	isStarted = true
	GraphicsController.Start()
	applyGraphicsSettings(GraphicsController.GetSettings())

	GraphicsController.Changed.Event:Connect(function(settings)
		applyGraphicsSettings(settings)
	end)

	RunService.RenderStepped:Connect(updateAdaptiveBudget)

	DebugLog.Info("Vfx", "Budget VFX client initialise", buildSettings())
end

VfxQualityController.Changed = changedEvent

return VfxQualityController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="151">
          <Properties>
            <string name="Name">WeaponChoiceV2Adapter</string>
            <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local UiTemplateConfig = require(Shared:WaitForChild("UiTemplateConfig"))

local PRODUCTION_GUI_NAME = "WeaponChoiceV2"

local function initialise()
	local templateGui = playerGui:WaitForChild(UiTemplateConfig.ProductionTemplateGuiName, 30)
	if templateGui == nil or not templateGui:IsA("ScreenGui") then
		DebugLog.Warn("UI", "Choix d'arme V2 non actif, template de production introuvable")
		return
	end

	local templateCanvas = templateGui:FindFirstChild("RunCanvas")
	local templateDock = templateCanvas and templateCanvas:FindFirstChild("WeaponChoiceDock")
	local templateContract = templateGui:FindFirstChild("DesignContract")
	local templateController = templateGui:FindFirstChild("WeaponChoiceEffectsController")

	if
		templateCanvas == nil
		or templateDock == nil
		or not templateDock:IsA("Frame")
		or templateContract == nil
		or templateController == nil
		or not templateController:IsA("LocalScript")
	then
		DebugLog.Warn("UI", "Choix d'arme V2 non actif, recette de production incomplete")
		return
	end

	local previousGui = playerGui:FindFirstChild(PRODUCTION_GUI_NAME)
	if previousGui then
		previousGui:Destroy()
	end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = PRODUCTION_GUI_NAME
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.DisplayOrder = 22
	screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screenGui.Enabled = false
	screenGui.Parent = playerGui

	local overlay = Instance.new("Frame")
	overlay.Name = "Overlay"
	overlay.Size = UDim2.fromScale(1, 1)
	overlay.BackgroundColor3 = Color3.fromRGB(2, 5, 11)
	overlay.BackgroundTransparency = 0.36
	overlay.BorderSizePixel = 0
	overlay.Parent = screenGui

	local runCanvas = Instance.new("Frame")
	runCanvas.Name = "RunCanvas"
	runCanvas.Size = UDim2.fromScale(1, 1)
	runCanvas.BackgroundTransparency = 1
	runCanvas.BorderSizePixel = 0
	runCanvas.Parent = screenGui

	local dock = templateDock:Clone()
	dock.Name = "WeaponChoiceDock"
	dock.Visible = true
	dock:SetAttribute("ProductionBound", true)
	dock.Parent = runCanvas

	local contract = templateContract:Clone()
	contract.Parent = screenGui

	local effectsController = templateController:Clone()
	effectsController.Enabled = true
	effectsController.Parent = screenGui

	templateGui.Enabled = false
	playerGui:SetAttribute("WeaponChoiceV2Ready", true)

	-- Le rail est volontairement pret mais ferme. Il sera ouvert par le futur
	-- service autoritaire de progression d'armes, jamais par les offres de perks.
	DebugLog.Info("UI", "Choix d'arme V2 prepare", {
		Source = UiTemplateConfig.ProductionTemplateGuiName,
		GameplayBound = false,
	})
end

task.spawn(function()
	local success, err = pcall(initialise)
	if not success then
		DebugLog.Warn("UI", "Initialisation choix d'arme V2 impossible", {
			Error = tostring(err),
		})
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="152">
          <Properties>
            <string name="Name">ZoneWeaponVfxController</string>
            <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local visualTemplates = ReplicatedStorage:WaitForChild("VisualTemplates")
local vfxRemote = ReplicatedStorage:WaitForChild("Weapon_ZoneVfx")
local activeCasts = {}

local runtime = Workspace:FindFirstChild("ClientWeaponVfx")
if runtime == nil then
	runtime = Instance.new("Folder")
	runtime.Name = "ClientWeaponVfx"
	runtime.Parent = Workspace
end

local function configureVisual(instance: Instance)
	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.CastShadow = false
		elseif descendant:IsA("ParticleEmitter") then
			descendant.Enabled = false
		end
	end
end

local function emitDescendants(instance: Instance, multiplier: number?)
	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			local count = math.max(1, math.floor((descendant:GetAttribute("BurstCount") or descendant.Rate or 1) * (multiplier or 1)))
			descendant:Emit(math.min(count, 28))
		end
	end
end

local function setDecalTransparency(instance: Instance, transparency: number)
	for _, descendant in ipairs(instance:GetDescendants()) do
		if descendant:IsA("Decal") then
			descendant.Transparency = transparency
		end
	end
end

local function showCharge(payload)
	local weaponVfx = visualTemplates:FindFirstChild("WeaponVfx")
	local template = weaponVfx and weaponVfx:FindFirstChild("LeydenNeedleZone")
	if template == nil or not template:IsA("Model") then
		DebugLog.ThrottledWarn("Vfx", "leyden_template_missing", 5, "Template VFX Aiguille de Leyde introuvable")
		return
	end

	local previous = activeCasts[payload.CastId]
	if previous then previous:Destroy() end
	local visual = template:Clone()
	visual.Name = "LeydenCast_" .. tostring(payload.CastId)
	configureVisual(visual)
	visual:PivotTo(CFrame.new(payload.Center))
	visual.Parent = runtime
	activeCasts[payload.CastId] = visual

	local ring = visual:FindFirstChild("ChargeRing", true)
	if ring then
		setDecalTransparency(ring, 0.72)
		for _, descendant in ipairs(ring:GetDescendants()) do
			if descendant:IsA("Decal") then
				TweenService:Create(descendant, TweenInfo.new(payload.ChargeDuration, Enum.EasingStyle.Quad), {
					Transparency = 0.08,
				}):Play()
			end
		end
	end

	local chargeCore = visual:FindFirstChild("ChargeCore", true)
	if chargeCore then emitDescendants(chargeCore, 0.7) end
	local impact = visual:FindFirstChild("Impact", true)
	if impact then setDecalTransparency(impact, 1) end
end

local function placeArc(arcTemplate: BasePart, from: Vector3, to: Vector3, parent: Instance)
	local distance = (to - from).Magnitude
	if distance <= 0.1 then return end
	local arc = arcTemplate:Clone()
	arc.Name = "BounceArc"
	arc.Size = Vector3.new(math.max(2, distance), math.max(2, distance * 0.24), 0.08)
	arc.CFrame = CFrame.lookAt((from + to) * 0.5, to) * CFrame.Angles(0, math.rad(90), 0)
	arc.Parent = parent
	task.delay(0.16, function()
		if arc.Parent then arc:Destroy() end
	end)
end

local function showImpact(payload)
	local visual = activeCasts[payload.CastId]
	if visual == nil then return end
	activeCasts[payload.CastId] = nil

	local strikes = visual:FindFirstChild("Strikes")
	if strikes then
		local children = strikes:GetChildren()
		for index, strike in ipairs(children) do
			if index <= payload.StrikeCount then
				task.delay((index - 1) * 0.035, function()
					if strike.Parent then emitDescendants(strike, 1) end
				end)
			end
		end
	end

	local impact = visual:FindFirstChild("Impact", true)
	if impact then
		setDecalTransparency(impact, 0.12)
		emitDescendants(impact, 1)
	end
	local sound = visual:FindFirstChild("ImpactSound", true)
	if sound and sound:IsA("Sound") then sound:Play() end

	local arcTemplate = visual:FindFirstChild("ChainArcTemplate", true)
	if arcTemplate and arcTemplate:IsA("BasePart") then
		arcTemplate.Transparency = 1
		for _, arcData in ipairs(payload.Arcs or {}) do
			placeArc(arcTemplate, arcData.From, arcData.To, visual)
		end
	end

	task.delay(1.2, function()
		if visual.Parent then visual:Destroy() end
	end)
end

vfxRemote.OnClientEvent:Connect(function(payload)
	if typeof(payload) ~= "table" or payload.WeaponId ~= "leyden_needle" then return end
	if payload.Type == "Charge" then
		showCharge(payload)
	elseif payload.Type == "Impact" then
		showImpact(payload)
	end
end)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
