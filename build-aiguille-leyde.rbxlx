local activeButton = nil
local debugStateRequestInFlight = false
local benchmarkScenarioIndex = 1
local benchmarkIsActive = false
local benchmarkPhase = "Idle"
local benchmarkScenarioLabel = "P0"
local benchmarkElapsedAtStatus = 0
local benchmarkStatusReceivedAt = 0
local benchmarkCampaignLabel = nil
local benchmarkCampaignIndex = nil
local benchmarkCampaignTotal = nil
local benchmarkStatusRefreshElapsed = 0

local function getBenchmarkPhaseDuration(phase)
	if phase == "Warmup" then
		return PerformanceBaselineConfig.WarmupSeconds
	elseif phase == "Measuring" then
		return PerformanceBaselineConfig.MeasurementSeconds
	elseif phase == "Cleanup" then
		return PerformanceBaselineConfig.CleanupSeconds
	elseif phase == "IdleObservation" then
		return PerformanceBaselineConfig.IdleObservationSeconds
	end

	return 0
end

local function getBenchmarkPhaseElapsed(totalElapsed)
	if benchmarkPhase == "Measuring" then
		return math.max(0, totalElapsed - PerformanceBaselineConfig.WarmupSeconds)
	elseif benchmarkPhase == "Cleanup" then
		return math.max(0, totalElapsed - PerformanceBaselineConfig.WarmupSeconds - PerformanceBaselineConfig.MeasurementSeconds)
	elseif benchmarkPhase == "IdleObservation" then
		return math.max(
			0,
			totalElapsed
				- PerformanceBaselineConfig.WarmupSeconds
				- PerformanceBaselineConfig.MeasurementSeconds
				- PerformanceBaselineConfig.CleanupSeconds
		)
	end

	return totalElapsed
end

local function refreshBenchmarkStatusLabel()
	local elapsedSeconds = math.max(0, math.floor(benchmarkElapsedAtStatus + (os.clock() - benchmarkStatusReceivedAt)))
	local phaseElapsed = getBenchmarkPhaseElapsed(elapsedSeconds)
	local phaseDuration = getBenchmarkPhaseDuration(benchmarkPhase)
	local phaseLabel = if benchmarkPhase == "Warmup"
		then "chauffe"
		elseif benchmarkPhase == "Measuring"
			then "mesure"
			elseif benchmarkPhase == "Cleanup"
				then "nettoyage"
				elseif benchmarkPhase == "IdleObservation"
					then "repos mesure"
				elseif benchmarkPhase == "CampaignTransition"
					then "scenario suivant"
				else string.lower(benchmarkPhase)
	local benchmarkLabel = if benchmarkCampaignLabel ~= nil and benchmarkCampaignIndex ~= nil and benchmarkCampaignTotal ~= nil
		then ("%s %d/%d | %s"):format(
			benchmarkCampaignLabel,
			benchmarkCampaignIndex,
			benchmarkCampaignTotal,
			benchmarkScenarioLabel
		)
		else benchmarkScenarioLabel

	if benchmarkIsActive and phaseDuration > 0 then
		benchmarkStatusLabel.Text = ("%s | %s %ds / %ds"):format(
			benchmarkLabel,
			phaseLabel,
			math.min(phaseElapsed, phaseDuration),
			phaseDuration
		)
	elseif benchmarkIsActive then
		benchmarkStatusLabel.Text = ("%s | %s"):format(benchmarkLabel, phaseLabel)
	else
		benchmarkStatusLabel.Text = ("%s | %s"):format(
			benchmarkScenarioLabel,
			phaseLabel
		)
	end
end

local function getBenchmarkSelections()
	return PerformanceBaselineConfig.GetSelections()
end

local function selectDefaultBenchmark()
	for index, selection in ipairs(getBenchmarkSelections()) do
		if selection.Id == PerformanceBaselineConfig.DefaultSelectionId then
			benchmarkScenarioIndex = index
			return
		end
	end
end

local function getSelectedBenchmarkSelection()
	return getBenchmarkSelections()[benchmarkScenarioIndex]
end

local function refreshBenchmarkControls()
	local selection = getSelectedBenchmarkSelection()

	if selection == nil then
		benchmarkScenarioButton.Text = "P0 : aucune selection"
		benchmarkStartButton.Active = false
		benchmarkStopButton.Active = false
		return
	end

	benchmarkScenarioButton.Text = selection.Label
	benchmarkStartButton.Active = not benchmarkIsActive
	benchmarkStartButton.AutoButtonColor = not benchmarkIsActive
	benchmarkStartButton.Text = if benchmarkIsActive then "P0 : en cours" else "P0 : lancer"
	benchmarkStopButton.Active = benchmarkIsActive
	benchmarkStopButton.AutoButtonColor = benchmarkIsActive
	benchmarkStopButton.Text = "P0 : arreter"
end

local function refreshDevKitPreviewButton()
	local isPreviewEnabled = player:GetAttribute(DEV_KIT_PREVIEW_ATTRIBUTE) == true
	devKitPreviewButton.Text = if isPreviewEnabled then "Kit UI demo : actif" else "Kit UI demo : afficher"
	devKitPreviewButton.BackgroundColor3 = if isPreviewEnabled
		then Color3.fromRGB(48, 132, 93)
		else Color3.fromRGB(52, 101, 153)
end

local function getDraftRunCanvas()
	local draftGui = playerGui:FindFirstChild(DRAFT_GUI_NAME)
	if not draftGui or not draftGui:IsA("ScreenGui") then
		return nil
	end

	local runCanvas = draftGui:FindFirstChild("RunCanvas")
	if runCanvas and runCanvas:IsA("Frame") then
		return runCanvas
	end

	return nil
end

local function getPreviewCentralIndex(componentId)
	for index, entry in ipairs(PREVIEW_CENTRAL_COMPONENTS) do
		if entry.Id == componentId then
			return index
		end
	end

	return 1
end

local function refreshDevKitCentralButton()
	local runCanvas = getDraftRunCanvas()
	local componentId = if runCanvas then runCanvas:GetAttribute("PreviewCentralComponent") else nil
	local entry = PREVIEW_CENTRAL_COMPONENTS[getPreviewCentralIndex(componentId)]
	local canCycle = player:GetAttribute(DEV_KIT_PREVIEW_ATTRIBUTE) == true and runCanvas ~= nil

	devKitCentralButton.Text = "Ecran demo : " .. entry.Label
	devKitCentralButton.Active = canCycle
	devKitCentralButton.AutoButtonColor = canCycle
	devKitCentralButton.BackgroundColor3 = if canCycle
		then Color3.fromRGB(91, 65, 133)
		else Color3.fromRGB(48, 51, 65)
end

local function applyDebugLogState(payload)
	if typeof(payload) ~= "table" or typeof(payload.Categories) ~= "table" then
		return
	end

	debugLogState = {
		ConsoleEnabled = payload.ConsoleEnabled == true,
		Categories = payload.Categories,
	}
	DebugLog.ApplyState(debugLogState)
	setConsoleSelected(debugLogState.ConsoleEnabled)

	for categoryId, entry in pairs(debugCategoryRows) do
		entry.SetSelected(debugLogState.Categories[categoryId] == true)
	end
end

local function requestDebugLogState()
	if debugStateRequestInFlight
		or player:GetAttribute("CanUseAdminTools") ~= true
		or not getDebugLogStateRemote:IsA("RemoteFunction")
	then
		return
	end

	debugStateRequestInFlight = true

	task.spawn(function()
		local success, payload = pcall(function()
			return getDebugLogStateRemote:InvokeServer()
		end)

		debugStateRequestInFlight = false

		if success then
			applyDebugLogState(payload)
		else
			statusLabel.Text = "Etat des logs indisponible"
			statusLabel.TextColor3 = Color3.fromRGB(255, 145, 145)
		end
	end)
end

local function sendDebugLogSetting(scope, categoryId, isEnabled)
	if not setDebugLogSettingRemote:IsA("RemoteEvent") then
		return
	end

	statusLabel.Text = "Mise a jour des logs..."
	statusLabel.TextColor3 = Color3.fromRGB(220, 225, 235)
	setDebugLogSettingRemote:FireServer({
		Scope = scope,
		Category = categoryId,
		Enabled = isEnabled,
	})
end

local function updateVisibility()
	local canUseAdminTools = player:GetAttribute("CanUseAdminTools") == true
	screenGui.Enabled = canUseAdminTools

	if not canUseAdminTools then
		container.Visible = false
		return
	end

	requestDebugLogState()
end

local function resetActiveButton()
	if activeButton == nil then
		return
	end

	activeButton.Active = true
	activeButton.AutoButtonColor = true
	activeButton.Text = defaultButtonTexts[activeButton]
	activeButton = nil
end

local function fireAdminAction(button, remote, busyText)
	resetActiveButton()

	activeButton = button
	button.Active = false
	button.AutoButtonColor = false
	button.Text = busyText
	statusLabel.Text = "Demande envoyee"
	statusLabel.TextColor3 = Color3.fromRGB(220, 225, 235)
	DebugLog.Info("UI", "Action admin envoyee", {
		Action = button.Name,
	})
	remote:FireServer()
end

resetButton.Activated:Connect(function()
	fireAdminAction(resetButton, resetPowerUpsRemote, "Reset...")
end)

spawnButton.Activated:Connect(function()
	fireAdminAction(spawnButton, spawnMonstersRemote, "Spawn...")
end)

killButton.Activated:Connect(function()
	fireAdminAction(killButton, killMonstersRemote, "Suppression...")
end)

devKitPreviewButton.Activated:Connect(function()
	if not toggleDevKitPreviewRemote:IsA("RemoteEvent") then
		return
	end

	statusLabel.Text = "Mise a jour de l'apercu..."
	statusLabel.TextColor3 = Color3.fromRGB(220, 225, 235)
	toggleDevKitPreviewRemote:FireServer()
end)

devKitCentralButton.Activated:Connect(function()
	local runCanvas = getDraftRunCanvas()
	if player:GetAttribute(DEV_KIT_PREVIEW_ATTRIBUTE) ~= true or runCanvas == nil then
		statusLabel.Text = "Active d'abord le kit UI demo"
		statusLabel.TextColor3 = Color3.fromRGB(255, 205, 118)
		return
	end

	local currentIndex = getPreviewCentralIndex(runCanvas:GetAttribute("PreviewCentralComponent"))
	local nextIndex = (currentIndex % #PREVIEW_CENTRAL_COMPONENTS) + 1
	local nextEntry = PREVIEW_CENTRAL_COMPONENTS[nextIndex]

	runCanvas:SetAttribute("PreviewCentralComponent", nextEntry.Id)
	statusLabel.Text = "Ecran central : " .. nextEntry.Label
	statusLabel.TextColor3 = Color3.fromRGB(220, 225, 235)
	refreshDevKitCentralButton()
end)

benchmarkScenarioButton.Activated:Connect(function()
	if benchmarkIsActive then
		return
	end

	local selections = getBenchmarkSelections()
	benchmarkScenarioIndex = (benchmarkScenarioIndex % #selections) + 1
	refreshBenchmarkControls()
end)

benchmarkStartButton.Activated:Connect(function()
	local selection = getSelectedBenchmarkSelection()
	if selection == nil or benchmarkIsActive or not performanceBenchmarkRemote:IsA("RemoteEvent") then
		return
	end

	benchmarkStatusLabel.Text = "P0 : demande envoyee"
	benchmarkStatusLabel.TextColor3 = Color3.fromRGB(214, 230, 255)
	performanceBenchmarkRemote:FireServer({
		Action = "Start",
		SelectionId = selection.Id,
	})
end)

benchmarkStopButton.Activated:Connect(function()
	if not benchmarkIsActive or not performanceBenchmarkRemote:IsA("RemoteEvent") then
		return
	end

	benchmarkStatusLabel.Text = "P0 : nettoyage demande"
	benchmarkStatusLabel.TextColor3 = Color3.fromRGB(255, 221, 150)
	performanceBenchmarkRemote:FireServer({
		Action = "Stop",
	})
end)

physicsAuditButton.Activated:Connect(function()
	if not physicsAuditRemote:IsA("RemoteEvent") then
		return
	end

	fireAdminAction(physicsAuditButton, physicsAuditRemote, "Audit P1...")
end)

leydenNeedleButton.Activated:Connect(function()
	if not toggleLeydenNeedleRemote:IsA("RemoteEvent") then
		return
	end

	fireAdminAction(leydenNeedleButton, toggleLeydenNeedleRemote, "Equipement...")
end)

consoleToggle.Activated:Connect(function()
	sendDebugLogSetting("Console", nil, not debugLogState.ConsoleEnabled)
end)

for categoryId, entry in pairs(debugCategoryRows) do
	entry.Row.Activated:Connect(function()
		local isEnabled = debugLogState.Categories[categoryId] == true
		sendDebugLogSetting("Category", categoryId, not isEnabled)
	end)
end

adminButton.Activated:Connect(function()
	container.Visible = not container.Visible
	adminButton.BackgroundTransparency = if container.Visible then 0.02 else 0.16
end)

adminMessageRemote.OnClientEvent:Connect(function(payload)
	resetActiveButton()
	DebugLog.Info("UI", "Retour action admin recu", payload)
	statusLabel.Text = payload.Message or "Action terminee"

	if payload.Success then
		statusLabel.TextColor3 = Color3.fromRGB(145, 235, 170)
	else
		statusLabel.TextColor3 = Color3.fromRGB(255, 145, 145)
	end
end)

performanceBenchmarkStatusRemote.OnClientEvent:Connect(function(payload)
	if typeof(payload) ~= "table" then
		return
	end

	benchmarkIsActive = payload.Active == true
	benchmarkPhase = if typeof(payload.Phase) == "string" then payload.Phase else "Inconnu"
	benchmarkScenarioLabel = if typeof(payload.ScenarioLabel) == "string" then payload.ScenarioLabel else "P0"
	benchmarkElapsedAtStatus = math.max(0, tonumber(payload.ElapsedSeconds) or 0)
	benchmarkStatusReceivedAt = os.clock()
	benchmarkCampaignLabel = if typeof(payload.CampaignLabel) == "string" then payload.CampaignLabel else nil
	benchmarkCampaignIndex = if typeof(payload.CampaignIndex) == "number" then payload.CampaignIndex else nil
	benchmarkCampaignTotal = if typeof(payload.CampaignTotal) == "number" then payload.CampaignTotal else nil
	benchmarkStatusLabel.TextColor3 = if benchmarkPhase == "Completed"
		then Color3.fromRGB(145, 235, 170)
		elseif benchmarkPhase == "Cleanup"
			then Color3.fromRGB(255, 221, 150)
			else Color3.fromRGB(154, 212, 255)
	refreshBenchmarkStatusLabel()
	refreshBenchmarkControls()
end)

RunService.RenderStepped:Connect(function(deltaTime)
	if not benchmarkIsActive then
		benchmarkStatusRefreshElapsed = 0
		return
	end

	benchmarkStatusRefreshElapsed += deltaTime
	if benchmarkStatusRefreshElapsed >= 0.2 then
		benchmarkStatusRefreshElapsed = 0
		refreshBenchmarkStatusLabel()
	end
end)

debugLogStateRemote.OnClientEvent:Connect(function(payload)
	applyDebugLogState(payload)
end)

player:GetAttributeChangedSignal("CanUseAdminTools"):Connect(updateVisibility)
player:GetAttributeChangedSignal(DEV_KIT_PREVIEW_ATTRIBUTE):Connect(function()
	refreshDevKitPreviewButton()
	refreshDevKitCentralButton()
end)
updateVisibility()
refreshDevKitPreviewButton()
refreshDevKitCentralButton()
selectDefaultBenchmark()
refreshBenchmarkControls()

DebugLog.Info("UI", "UI admin initialisee", {
	Player = player.Name,
	Visible = screenGui.Enabled,
})
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="114">
          <Properties>
            <string name="Name">AudioClient</string>
            <string name="Source"><![CDATA[local AudioController = require(script.Parent:WaitForChild("AudioController"))

AudioController.Start()
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">AudioController</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local AudioConfig = require(Shared:WaitForChild("AudioConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local PlayerPreferencesConfig = require(Shared:WaitForChild("PlayerPreferencesConfig"))

local AudioController = {}

local isStarted = false
local remoteConnection = nil
local loopsById = {}
local activeMusic = nil
local lastMusicTemplate = nil
local settingsChanged = Instance.new("BindableEvent")
local settings = {}
local setAudioPreferencesRemote = nil
local preferenceSaveSerial = 0

for settingName, defaultValue in pairs(AudioConfig.DefaultVolumes) do
	settings[settingName] = defaultValue
end

local function getSoundGroup(category)
	local groupName = AudioConfig.SoundGroupNames[category]

	if groupName == nil then
		return nil
	end

	local soundGroup = SoundService:FindFirstChild(groupName)

	if soundGroup ~= nil and soundGroup:IsA("SoundGroup") then
		return soundGroup
	end

	return nil
end

local function applyMix()
	local masterVolume = settings.Master or 1

	for category in pairs(AudioConfig.SoundGroupNames) do
		local soundGroup = getSoundGroup(category)

		if soundGroup ~= nil then
			soundGroup.Volume = masterVolume * (settings[category] or 1)
		end
	end

	settingsChanged:Fire(AudioController.GetSettings())
end

local function applyAudioPreferences(rawAudio)
	if typeof(rawAudio) ~= "table" then
		return
	end

	for settingName, defaultValue in pairs(AudioConfig.DefaultVolumes) do
		local value = tonumber(rawAudio[settingName])
		settings[settingName] = math.clamp(value or defaultValue, 0, 1)
	end
end

local function schedulePreferencesSave()
	if setAudioPreferencesRemote == nil then
		return
	end

	preferenceSaveSerial += 1
	local scheduledSerial = preferenceSaveSerial

	task.delay(PlayerPreferencesConfig.ClientAudioDebounceSeconds, function()
		if scheduledSerial ~= preferenceSaveSerial or setAudioPreferencesRemote == nil then
			return
		end

		setAudioPreferencesRemote:FireServer(AudioController.GetSettings())
	end)
end

local function connectPreferences()
	local updateRemote = ReplicatedStorage:WaitForChild(PlayerPreferencesConfig.UpdateRemoteName, 15)

	if updateRemote ~= nil and updateRemote:IsA("RemoteEvent") then
		updateRemote.OnClientEvent:Connect(function(payload)
			if typeof(payload) == "table" and typeof(payload.Audio) == "table" then
				applyAudioPreferences(payload.Audio)
				applyMix()
			end
		end)
	end

	local setRemote = ReplicatedStorage:WaitForChild(PlayerPreferencesConfig.SetAudioRemoteName, 15)

	if setRemote ~= nil and setRemote:IsA("RemoteEvent") then
		setAudioPreferencesRemote = setRemote
	end

	local getRemote = ReplicatedStorage:WaitForChild(PlayerPreferencesConfig.GetStateRemoteName, 15)

	if getRemote == nil or not getRemote:IsA("RemoteFunction") then
		DebugLog.Warn("Preferences", "Remote de lecture preferences introuvable")
		return
	end

	local success, payload = pcall(function()
		return getRemote:InvokeServer()
	end)

	if success and typeof(payload) == "table" and typeof(payload.Audio) == "table" then
		applyAudioPreferences(payload.Audio)
	elseif not success then
		DebugLog.Warn("Preferences", "Lecture preferences client impossible", {
			Error = tostring(payload),
		})
	end
end

local function destroySound(sound)
	if sound ~= nil and sound.Parent ~= nil then
		sound:Destroy()
	end
end

local function createSound(soundKey, isLooped)
	local definition = AudioConfig.SoundEffects[soundKey]

	if definition == nil or definition.SoundId == nil or definition.SoundId == "" then
		return nil
	end

	local sound = Instance.new("Sound")
	sound.Name = "Local_" .. soundKey
	sound.SoundId = definition.SoundId
	sound.Volume = definition.Volume or 0.75
	sound.Looped = isLooped == true

	local soundGroup = getSoundGroup(definition.Category or "Effects")

	if soundGroup ~= nil then
		sound.SoundGroup = soundGroup
	end

	sound.Parent = SoundService

	return sound, definition
end

local function playOneShot(soundKey)
	local sound, definition = createSound(soundKey, false)

	if sound == nil then
		return
	end

	sound:Play()

	sound.Ended:Connect(function()
		destroySound(sound)
	end)

	task.delay(definition.Lifetime or 8, function()
		destroySound(sound)
	end)
end

local function startLoop(soundKey, loopId)
	local previousSound = loopsById[loopId]

	if previousSound ~= nil then
		previousSound:Stop()
		destroySound(previousSound)
	end

	local sound = createSound(soundKey, true)

	if sound == nil then
		return
	end

	loopsById[loopId] = sound
	sound:Play()
end

local function stopLoop(loopId)
	local sound = loopsById[loopId]

	if sound == nil then
		return
	end

	loopsById[loopId] = nil
	sound:Stop()
	destroySound(sound)
end

local function getMusicPool()
	local musicPool = SoundService:FindFirstChild(AudioConfig.MusicPoolFolderName)

	if musicPool ~= nil then
		return musicPool
	end

	local legacyPool = Workspace:FindFirstChild(AudioConfig.MusicPoolFolderName)

	if legacyPool ~= nil then
		DebugLog.ThrottledWarn("Audio", "music_pool_workspace", 30, "MusicPool doit etre deplace dans SoundService", {
			Pool = legacyPool,
		})
	end

	return legacyPool
end

local function getMusicTemplates()
	local musicPool = getMusicPool()

	if musicPool == nil then
		return {}
	end

	local templates = {}

	for _, descendant in ipairs(musicPool:GetDescendants()) do
		if descendant:IsA("Sound") and descendant.SoundId ~= "" then
			table.insert(templates, descendant)
		end
	end

	return templates
end

local function playNextMusic()
	local templates = getMusicTemplates()

	if #templates == 0 then
		return
	end

	if activeMusic ~= nil then
		activeMusic:Stop()
		destroySound(activeMusic)
		activeMusic = nil
	end

	local selectedTemplate = templates[math.random(1, #templates)]

	if #templates > 1 and selectedTemplate == lastMusicTemplate then
		selectedTemplate = templates[(table.find(templates, selectedTemplate) % #templates) + 1]
	end

	lastMusicTemplate = selectedTemplate

	local music = selectedTemplate:Clone()
	music.Name = "ActiveMusic"
	music.Looped = false
	music.Playing = false

	local musicGroup = getSoundGroup("Music")

	if musicGroup ~= nil then
		music.SoundGroup = musicGroup
	end

	music.Parent = SoundService
	activeMusic = music

	music.Ended:Connect(function()
		if activeMusic ~= music then
			return
		end

		activeMusic = nil
		destroySound(music)
		task.delay(0.4, playNextMusic)
	end)

	music:Play()
end

local function connectAudioRemote()
	local remote = ReplicatedStorage:WaitForChild(AudioConfig.RemoteName, 30)

	if remote == nil or not remote:IsA("RemoteEvent") then
		DebugLog.Warn("Audio", "Remote audio introuvable", {
			RemoteName = AudioConfig.RemoteName,
		})
		return
	end

	if remoteConnection ~= nil then
		remoteConnection:Disconnect()
	end

	remoteConnection = remote.OnClientEvent:Connect(function(payload)
		if typeof(payload) ~= "table" then
			return
		end

		if payload.Action == "Play" then
			playOneShot(payload.SoundKey)
		elseif payload.Action == "StartLoop" then
			startLoop(payload.SoundKey, payload.LoopId)
		elseif payload.Action == "StopLoop" then
			stopLoop(payload.LoopId)
		end
	end)
end

function AudioController.GetSettings()
	local copy = {}

	for settingName, value in pairs(settings) do
		copy[settingName] = value
	end

	return copy
end

function AudioController.SetVolume(settingName, value)
	if AudioConfig.DefaultVolumes[settingName] == nil then
		return
	end

	settings[settingName] = math.clamp(tonumber(value) or 0, 0, 1)
	applyMix()
	schedulePreferencesSave()
end

function AudioController.Start()
	if isStarted then
		return
	end

	isStarted = true
	connectPreferences()
	applyMix()

	task.spawn(connectAudioRemote)
	task.defer(playNextMusic)

	SoundService.ChildAdded:Connect(function(child)
		if child.Name == AudioConfig.MusicPoolFolderName or child:IsA("SoundGroup") then
			applyMix()
			playNextMusic()
		end
	end)

	Workspace.ChildAdded:Connect(function(child)
		if child.Name == AudioConfig.MusicPoolFolderName then
			playNextMusic()
		end
	end)
end

AudioController.Changed = settingsChanged

return AudioController
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="116">
          <Properties>
            <string name="Name">AudioSettingsUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local AudioController = require(script.Parent:WaitForChild("AudioController"))
local UiTheme = require(Shared:WaitForChild("UiTheme"))

AudioController.Start()

local existingGui = playerGui:FindFirstChild("AudioSettingsGui")

if existingGui ~= nil then
	existingGui:Destroy()
end

local COLORS = UiTheme.Contexts.Audio

local function getSettingsPanelEvent()
	local event = playerGui:FindFirstChild("SettingsPanelChanged")

	if event == nil then
		event = Instance.new("BindableEvent")
		event.Name = "SettingsPanelChanged"
		event.Parent = playerGui
	end

	assert(event:IsA("BindableEvent"), "SettingsPanelChanged doit etre un BindableEvent.")
	return event
end

local settingsPanelEvent = getSettingsPanelEvent()

local SETTINGS = {
	{ Id = "Master", Label = "GENERAL", Color = Color3.fromRGB(242, 246, 255) },
	{ Id = "Music", Label = "MUSIQUE", Color = Color3.fromRGB(190, 116, 255) },
	{ Id = "Effects", Label = "EFFETS", Color = Color3.fromRGB(255, 190, 75) },
	{ Id = "Environment", Label = "AMBIANCE", Color = Color3.fromRGB(86, 214, 172) },
	{ Id = "Interface", Label = "INTERFACE", Color = Color3.fromRGB(102, 191, 255) },
}

local addCorner = UiTheme.AddCorner
local addStroke = UiTheme.AddStroke

local function addGradient(instance, firstColor, secondColor)
	return UiTheme.AddGradient(instance, firstColor, secondColor, 90)
end

local function createLabel(parent, name, text, size, color, font)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Font = font or Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color
	label.TextSize = size
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 0.5
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = parent

	return label
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AudioSettingsGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = false
screenGui.DisplayOrder = 10
screenGui.Parent = playerGui

local audioButton = Instance.new("TextButton")
audioButton.Name = "AudioButton"
audioButton.AnchorPoint = Vector2.new(1, 0)
audioButton.Position = UDim2.new(1, -18, 0, 16)
audioButton.Size = UDim2.fromOffset(66, 34)
audioButton.BackgroundColor3 = Color3.fromRGB(37, 51, 70)
audioButton.BackgroundTransparency = 0.16
audioButton.BorderSizePixel = 0
audioButton.AutoButtonColor = false
audioButton.Font = Enum.Font.GothamBlack
audioButton.Text = "AUDIO"
audioButton.TextColor3 = COLORS.Text
audioButton.TextSize = 10
audioButton.Parent = screenGui
addCorner(audioButton, 8)
addStroke(audioButton, COLORS.MetalLight, 0.28, 1)
addGradient(audioButton, Color3.fromRGB(65, 88, 118), COLORS.MetalDark)
UiTheme.AddSurfaceFinish(audioButton, {
	Accent = COLORS.Accent,
	Intensity = 0.4,
})

local panel = Instance.new("Frame")
panel.Name = "AudioPanel"
panel.AnchorPoint = Vector2.new(1, 0)
panel.Position = UDim2.new(1, -18, 0, 58)
panel.Size = UDim2.fromOffset(310, 276)
panel.BackgroundColor3 = Color3.fromRGB(37, 51, 70)
panel.BackgroundTransparency = 0.16
panel.BorderSizePixel = 0
panel.Visible = false
panel.Parent = screenGui
addCorner(panel, 10)
addStroke(panel, COLORS.MetalLight, 0.24, 2)
addGradient(panel, Color3.fromRGB(65, 88, 118), COLORS.MetalDark)
UiTheme.AddSurfaceFinish(panel, {
	Accent = COLORS.Accent,
	Intensity = 0.6,
})

local inner = Instance.new("Frame")
inner.Name = "GlassInner"
inner.Position = UDim2.fromOffset(4, 4)
inner.Size = UDim2.new(1, -8, 1, -8)
inner.BackgroundColor3 = Color3.fromRGB(13, 22, 34)
inner.BackgroundTransparency = 0.2
inner.BorderSizePixel = 0
inner.Parent = panel
addCorner(inner, 7)
addStroke(inner, COLORS.GlassStroke, 0.68, 1)

local title = createLabel(inner, "Title", "AUDIO", 17, COLORS.Text, Enum.Font.GothamBlack)
title.Position = UDim2.fromOffset(16, 10)
title.Size = UDim2.new(1, -110, 0, 24)

local muteButton = Instance.new("TextButton")
muteButton.Name = "MuteButton"
muteButton.AnchorPoint = Vector2.new(1, 0)
muteButton.Position = UDim2.new(1, -14, 0, 10)
muteButton.Size = UDim2.fromOffset(72, 24)
muteButton.BackgroundColor3 = Color3.fromRGB(32, 48, 66)
muteButton.BackgroundTransparency = 0.12
muteButton.BorderSizePixel = 0
muteButton.AutoButtonColor = false
muteButton.Font = Enum.Font.GothamBold
muteButton.Text = "COUPER"
muteButton.TextColor3 = COLORS.Text
muteButton.TextSize = 10
muteButton.Parent = inner
addCorner(muteButton, 5)
addStroke(muteButton, COLORS.GlassStroke, 0.6, 1)

local divider = Instance.new("Frame")
divider.Position = UDim2.fromOffset(14, 42)
divider.Size = UDim2.new(1, -28, 0, 1)
divider.BackgroundColor3 = COLORS.GlassStroke
divider.BackgroundTransparency = 0.75
divider.BorderSizePixel = 0
divider.Parent = inner

local rowsById = {}
local activeRow = nil
local lastMasterVolume = 1

local function updateRow(row, settings)
	local value = math.clamp(settings[row.Id] or 0, 0, 1)
	row.Fill.Size = UDim2.new(value, 0, 1, 0)
	row.Value.Text = tostring(math.floor((value * 100) + 0.5)) .. "%"
end

local function refresh(settings)
	for _, row in pairs(rowsById) do
		updateRow(row, settings)
	end

	local masterVolume = settings.Master or 0
	muteButton.Text = if masterVolume <= 0 then "ACTIVER" else "COUPER"
	muteButton.TextColor3 = if masterVolume <= 0 then COLORS.Accent else COLORS.Text
end

local function setRowFromPosition(row, positionX)
	local width = math.max(1, row.Track.AbsoluteSize.X)
	local value = math.clamp((positionX - row.Track.AbsolutePosition.X) / width, 0, 1)
	AudioController.SetVolume(row.Id, value)
end

for index, setting in ipairs(SETTINGS) do
	local row = Instance.new("Frame")
	row.Name = setting.Id .. "Row"
	row.Position = UDim2.fromOffset(16, 50 + ((index - 1) * 42))
	row.Size = UDim2.new(1, -32, 0, 34)
	row.BackgroundTransparency = 1
	row.BorderSizePixel = 0
	row.Parent = inner

	local label = createLabel(row, "Label", setting.Label, 11, COLORS.Muted, Enum.Font.GothamBold)
	label.Size = UDim2.new(0, 104, 0, 15)

	local value = createLabel(row, "Value", "0%", 11, setting.Color, Enum.Font.GothamBlack)
	value.AnchorPoint = Vector2.new(1, 0)
	value.Position = UDim2.new(1, 0, 0, 0)
	value.Size = UDim2.fromOffset(42, 15)
	value.TextXAlignment = Enum.TextXAlignment.Right

	local track = Instance.new("TextButton")
	track.Name = "Track"
	track.Position = UDim2.fromOffset(0, 20)
	track.Size = UDim2.new(1, 0, 0, 9)
	track.BackgroundColor3 = COLORS.Track
	track.BackgroundTransparency = 0.04
	track.BorderSizePixel = 0
	track.AutoButtonColor = false
	track.Text = ""
	track.ClipsDescendants = true
	track.Parent = row
	addCorner(track, 4)
	addStroke(track, COLORS.GlassStroke, 0.76, 1)

	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = setting.Color
	fill.BorderSizePixel = 0
	fill.Parent = track
	addCorner(fill, 4)

	local rowReference = {
		Id = setting.Id,
		Track = track,
		Fill = fill,
		Value = value,
	}
	rowsById[setting.Id] = rowReference

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			activeRow = rowReference
			setRowFromPosition(rowReference, input.Position.X)
		end
	end)
end

UserInputService.InputChanged:Connect(function(input)
	if activeRow == nil then
		return
	end

	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		setRowFromPosition(activeRow, input.Position.X)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		activeRow = nil
	end
end)

audioButton.Activated:Connect(function()
	local nextVisible = not panel.Visible

	if nextVisible then
		settingsPanelEvent:Fire("Audio")
	else
		settingsPanelEvent:Fire(nil)
	end

	panel.Visible = nextVisible
	TweenService:Create(audioButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = if panel.Visible then 0.02 else 0.16,
	}):Play()
end)

settingsPanelEvent.Event:Connect(function(openPanelName)
	if openPanelName == "Audio" or not panel.Visible then
		return
	end

	panel.Visible = false
	TweenService:Create(audioButton, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		BackgroundTransparency = 0.16,
	}):Play()
end)

muteButton.Activated:Connect(function()
	local settings = AudioController.GetSettings()

	if (settings.Master or 0) > 0 then
		lastMasterVolume = settings.Master
		AudioController.SetVolume("Master", 0)
	else
		AudioController.SetVolume("Master", math.max(0.1, lastMasterVolume))
	end
end)

AudioController.Changed.Event:Connect(refresh)
refresh(AudioController.GetSettings())
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="117">
          <Properties>
            <string name="Name">AuraController</string>
            <string name="Source"><![CDATA[-- Auras locales de build. Elles lisent uniquement les statistiques deja validees par le serveur.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local AuraConfig = require(Shared:WaitForChild("AuraConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))

local VfxQualityController = require(script.Parent:WaitForChild("VfxQualityController"))

VfxQualityController.Start()

local isRunActive = player:GetAttribute("IsRunActive") == true
local latestStats = {}
local textureIds = {}
local effectTemplates = {}
local compositionTemplates = {}
local missingTextures = {}
local runtimeFolder = nil
local packagesByFamilyId = {}
local lastActiveSignature = ""

local function getTextureId(textureName, fallbackTextureName)
	if textureIds[textureName] ~= nil then
		return textureIds[textureName]
	end

	local visualTemplates = ReplicatedStorage:FindFirstChild(AuraConfig.VisualTemplatesFolderName)
	local auraTemplates = if visualTemplates ~= nil then visualTemplates:FindFirstChild(AuraConfig.AuraTemplatesFolderName) else nil
	-- Les nouvelles textures VFX vivent directement dans VisualTemplates. L'ancien
	-- dossier AuraTemplates reste lu pour ne pas casser les assets deja importes.
	local particleTextures = if visualTemplates ~= nil then visualTemplates:FindFirstChild(AuraConfig.ParticleTexturesFolderName) else nil

	if particleTextures == nil and auraTemplates ~= nil then
		particleTextures = auraTemplates:FindFirstChild(AuraConfig.ParticleTexturesFolderName)
	end
	local textureValue = if particleTextures ~= nil then particleTextures:FindFirstChild(textureName) else nil

	if textureValue ~= nil and textureValue:IsA("StringValue") and textureValue.Value ~= "" then
		textureIds[textureName] = textureValue.Value
		return textureValue.Value
	end

	local builtinTextureId = AuraConfig.BuiltinTextureIds[textureName]

	if builtinTextureId ~= nil and builtinTextureId ~= "" then
		textureIds[textureName] = builtinTextureId
		return builtinTextureId
	end

	if not missingTextures[textureName] then
		missingTextures[textureName] = true
		DebugLog.Warn("Aura", "Texture d'aura introuvable, fallback utilise", {
			Texture = textureName,
			Fallback = fallbackTextureName,
			ExpectedPath = "ReplicatedStorage/VisualTemplates/ParticleTextures",
		})
	end

	if fallbackTextureName ~= nil then
		return getTextureId(fallbackTextureName)
	end

	return nil
end

local function getEffectTemplate(templateName)
	if templateName == nil or templateName == "" then
		return nil
	end

	if effectTemplates[templateName] ~= nil then
		return effectTemplates[templateName]
	end

	local visualTemplates = ReplicatedStorage:FindFirstChild(AuraConfig.VisualTemplatesFolderName)
	local auraTemplates = if visualTemplates ~= nil
		then visualTemplates:FindFirstChild(AuraConfig.AuraTemplatesFolderName)
		else nil
	local templates = if auraTemplates ~= nil
		then auraTemplates:FindFirstChild(AuraConfig.EffectTemplatesFolderName)
		else nil
	local template = if templates ~= nil then templates:FindFirstChild(templateName) else nil

	if template ~= nil and template:IsA("ParticleEmitter") then
		effectTemplates[templateName] = template
		return template
	end

	effectTemplates[templateName] = false
	DebugLog.Warn("Aura", "Template d'effet d'aura introuvable, fallback utilise", {
		Template = templateName,
		ExpectedPath = "ReplicatedStorage/VisualTemplates/AuraTemplates/EffectTemplates",
	})
	return nil
end

local function getCompositionTemplate(templateName)
	if templateName == nil or templateName == "" then
		return nil
	end

	if compositionTemplates[templateName] ~= nil then
		return compositionTemplates[templateName]
	end

	local visualTemplates = ReplicatedStorage:FindFirstChild(AuraConfig.VisualTemplatesFolderName)
	local auraTemplates = if visualTemplates ~= nil
		then visualTemplates:FindFirstChild(AuraConfig.AuraTemplatesFolderName)
		else nil
	local templates = if auraTemplates ~= nil
		then auraTemplates:FindFirstChild(AuraConfig.CompositionTemplatesFolderName)
		else nil
	local template = if templates ~= nil then templates:FindFirstChild(templateName) else nil

	if template ~= nil and (template:IsA("Folder") or template:IsA("Model")) then
		compositionTemplates[templateName] = template
		return template
	end

	compositionTemplates[templateName] = false
	DebugLog.Warn("Aura", "Composition d'aura introuvable", {
		Template = templateName,
		ExpectedPath = "ReplicatedStorage/VisualTemplates/AuraTemplates/CompositionTemplates",
	})
	return nil
end

local function findFirstPart(character, names)
	for _, name in ipairs(names) do
		local candidate = character:FindFirstChild(name)

		if candidate ~= nil and candidate:IsA("BasePart") then
			return candidate
		end
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local COMPOSITION_TARGETS = {
	Root = { "HumanoidRootPart", "LowerTorso", "Torso" },
	UpperTorso = { "UpperTorso", "Torso", "HumanoidRootPart" },
	LowerTorso = { "LowerTorso", "Torso", "HumanoidRootPart" },
	Head = { "Head", "UpperTorso", "Torso" },
	LeftHand = { "LeftHand", "LeftLowerArm", "Left Arm" },
	RightHand = { "RightHand", "RightLowerArm", "Right Arm" },
	LeftArm = { "LeftUpperArm", "LeftLowerArm", "Left Arm" },
	RightArm = { "RightUpperArm", "RightLowerArm", "Right Arm" },
	LeftFoot = { "LeftFoot", "LeftLowerLeg", "Left Leg" },
	RightFoot = { "RightFoot", "RightLowerLeg", "Right Leg" },
	LeftLeg = { "LeftUpperLeg", "LeftLowerLeg", "Left Leg" },
	RightLeg = { "RightUpperLeg", "RightLowerLeg", "Right Leg" },
}

local function getCompositionTarget(character, targetSlot)
	local candidates = COMPOSITION_TARGETS[targetSlot]

	if candidates == nil then
		candidates = { targetSlot }
	end

	return findFirstPart(character, candidates)
end

local function getPartsForStyle(character, style)
	local function getBodyParts(names)
		local parts = {}
		local seen = {}

		for _, name in ipairs(names) do
			local part = findFirstPart(character, { name })

			if part ~= nil and not seen[part] then
				seen[part] = true
				table.insert(parts, part)
			end
		end

		return parts
	end

	if style == "Feet" then
		return {
			findFirstPart(character, { "LeftFoot", "LeftLowerLeg", "Left Leg" }),
			findFirstPart(character, { "RightFoot", "RightLowerLeg", "Right Leg" }),
		}
	elseif style == "Hands" or style == "AttackSpeed" then
		return {
			findFirstPart(character, { "LeftHand", "LeftLowerArm", "Left Arm" }),
			findFirstPart(character, { "RightHand", "RightLowerArm", "Right Arm" }),
		}
	elseif style == "Head" then
		return {
			findFirstPart(character, { "Head", "UpperTorso", "Torso" }),
		}
	elseif style == "Magnetism" or style == "Arsenal" then
		return {
			findFirstPart(character, { "HumanoidRootPart", "LowerTorso", "Torso" }),
		}
	elseif style == "Fortune" then
		return {
			findFirstPart(character, { "HumanoidRootPart", "LowerTorso", "Torso" }),
		}
	elseif style == "BodyFlame" then
		return getBodyParts({
			"UpperTorso",
			"LowerTorso",
			"LeftUpperArm",
			"RightUpperArm",
			"LeftUpperLeg",
			"RightUpperLeg",
		})
	elseif style == "Armor" or style == "Sustain" then
		return getBodyParts({
			"UpperTorso",
			"LeftUpperArm",
			"RightUpperArm",
		})
	end

	return {
		findFirstPart(character, { "UpperTorso", "Torso", "HumanoidRootPart" }),
	}
end

local function getContourOffsets(part)
	local halfWidth = math.max(0.18, part.Size.X * 0.42)
	local halfHeight = math.max(0.18, part.Size.Y * 0.38)
	local isTorso = part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Torso"

	if isTorso then
		return {
			Vector3.new(-halfWidth, 0, 0),
			Vector3.new(halfWidth, 0, 0),
			Vector3.new(0, halfHeight, 0),
		}
	end

	return {
		Vector3.new(-halfWidth, 0, 0),
		Vector3.new(halfWidth, 0, 0),
	}
end

local function numberSequence(startValue, endValue)
	return NumberSequence.new({
		NumberSequenceKeypoint.new(0, startValue),
		NumberSequenceKeypoint.new(1, endValue),
	})
end

local function scaleNumberSequence(sequence, scale)
	local keypoints = {}

	for _, keypoint in ipairs(sequence.Keypoints) do
		table.insert(keypoints, NumberSequenceKeypoint.new(
			keypoint.Time,
			keypoint.Value * scale,
			keypoint.Envelope * scale
		))
	end

	return NumberSequence.new(keypoints)
end

local function createAttachment(parent, name, position, package)
	local attachment = Instance.new("Attachment")
	attachment.Name = name
	attachment.Position = position or Vector3.zero
	attachment.Parent = parent

	if package ~= nil then
		table.insert(package.Attachments, attachment)
	end

	return attachment
end

local function captureEmitterBase(emitter)
	return {
		Texture = emitter.Texture,
		Color = emitter.Color,
		Rate = emitter.Rate,
		Lifetime = emitter.Lifetime,
		Speed = emitter.Speed,
		Size = emitter.Size,
		Transparency = emitter.Transparency,
		LightEmission = emitter.LightEmission,
		Acceleration = emitter.Acceleration,
		Drag = emitter.Drag,
	}
end

local function createEmitter(parent, name, templateName)
	local template = getEffectTemplate(templateName)
	local emitter = if template then template:Clone() else Instance.new("ParticleEmitter")
	emitter.Name = name
	emitter.LockedToPart = true
	emitter.VelocityInheritance = 0
	emitter.LightInfluence = 0
	emitter.Enabled = false
	emitter.Parent = parent

	if template then
		return emitter, captureEmitterBase(emitter)
	end

	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-18, 18)
	emitter.SpreadAngle = Vector2.new(18, 18)
	return emitter, nil
end

local function getScoreForFamily(family, stats)
	local score = 0

	for _, rule in ipairs(family.Stats) do
		local rawValue = math.max(0, tonumber(stats[rule.Name]) or 0)
		local normalizedValue = math.clamp(rawValue / rule.Saturation, 0, 1)
		score += normalizedValue * rule.Weight
	end

	return math.clamp(score, 0, 1)
end

local function getEffectColor(family, stats)
	if family.Style ~= "Sustain" or family.SecondaryColor == nil then
		return family.Color
	end

	local regenWeight = 0
	local lifeStealWeight = 0

	for _, rule in ipairs(family.Stats) do
		local normalizedValue = math.clamp((tonumber(stats[rule.Name]) or 0) / rule.Saturation, 0, 1)

		if rule.Name == "HealthRegen" then
			regenWeight = normalizedValue
		elseif rule.Name == "LifeStealPercent" then
			lifeStealWeight = normalizedValue
		end
	end

	if regenWeight + lifeStealWeight <= 0 then
		return family.Color
	end

	return family.Color:Lerp(family.SecondaryColor, lifeStealWeight / (regenWeight + lifeStealWeight))
end

local function getTier(score)
	local thresholds = AuraConfig.TierThresholds

	if score >= thresholds[3] then
		return 3
	elseif score >= thresholds[2] then
		return 2
	elseif score >= thresholds[1] then
		return 1
	end

	return 0
end

local function getDominantFamilies(maxFamilies)
	local families = {}

	for familyId, family in pairs(AuraConfig.Families) do
		local score = getScoreForFamily(family, latestStats)
		local tier = getTier(score)

		if tier > 0 then
			table.insert(families, {
				Id = familyId,
				Definition = family,
				Score = score,
				Tier = tier,
			})
		end
	end

	table.sort(families, function(left, right)
		if left.Score == right.Score then
			return left.Id < right.Id
		end

		return left.Score > right.Score
	end)

	while #families > maxFamilies do
		table.remove(families)
	end

	return families
end

local function getRuntimeFolder(character)
	if runtimeFolder ~= nil and runtimeFolder.Parent == character then
		return runtimeFolder
	end

	runtimeFolder = Instance.new("Folder")
	runtimeFolder.Name = AuraConfig.RuntimeFolderName
	runtimeFolder.Parent = character
	packagesByFamilyId = {}
	return runtimeFolder
end


local function addEmitterDescriptor(package, parent, name, textureId, configure, templateName, templateOverrides)
	if textureId == nil and templateName == nil then
		return
	end

	local emitter, templateBase = createEmitter(parent, name, templateName)
	table.insert(package.Descriptors, {
		Emitter = emitter,
		TextureId = textureId,
		Configure = configure,
		TemplateName = templateName,
		TemplateBase = templateBase,
		TemplateOverrides = templateOverrides,
	})
end

local function addContourDescriptors(package, part, familyId, partIndex, textureId, configure, templateName)
	for contourIndex, offset in ipairs(getContourOffsets(part)) do
		local attachment = createAttachment(
			part,
			"Aura_" .. familyId .. "_" .. tostring(partIndex) .. "_" .. tostring(contourIndex),
			offset,
			package
		)
		addEmitterDescriptor(package, attachment, "Contour", textureId, configure, templateName)
	end
end

local function addCompositionDescriptors(package, character, compositionName)
	local composition = getCompositionTemplate(compositionName)

	if composition == nil then
		return false
	end

	local emitterCount = 0

	for _, sourceAttachment in ipairs(composition:GetChildren()) do
		if not sourceAttachment:IsA("Attachment") then
			continue
		end

		local targetSlot = sourceAttachment:GetAttribute("TargetSlot")
		local targetPart = if type(targetSlot) == "string"
			then getCompositionTarget(character, targetSlot)
			else nil

		if targetPart == nil or not targetPart:IsA("BasePart") then
			DebugLog.Warn("Aura", "Point d'ancrage de composition introuvable", {
				Composition = compositionName,
				Socket = sourceAttachment.Name,
				TargetSlot = targetSlot,
			})
			continue
		end

		local attachment = sourceAttachment:Clone()
		attachment.Name = "Aura_" .. package.Id .. "_" .. sourceAttachment.Name
		attachment.Parent = targetPart
		table.insert(package.Attachments, attachment)

		for _, descendant in ipairs(attachment:GetDescendants()) do
			if not descendant:IsA("ParticleEmitter") then
				continue
			end

			descendant.Enabled = false
			descendant.LockedToPart = true
			descendant.VelocityInheritance = 0
			descendant.LightInfluence = 0

			local rateMultiplier = tonumber(descendant:GetAttribute("AuraRateMultiplier")) or 1
			local sizeMultiplier = tonumber(descendant:GetAttribute("AuraSizeMultiplier")) or 1
			local lifetimeMultiplier = tonumber(descendant:GetAttribute("AuraLifetimeMultiplier")) or 1
			local speedMultiplier = tonumber(descendant:GetAttribute("AuraSpeedMultiplier")) or 1

			table.insert(package.Descriptors, {
				Emitter = descendant,
				TextureId = descendant.Texture,
				Configure = function()
					return {
						RateMultiplier = rateMultiplier,
						SizeMultiplier = sizeMultiplier,
						LifetimeMultiplier = lifetimeMultiplier,
						SpeedMultiplier = speedMultiplier,
					}
				end,
				TemplateName = compositionName,
				TemplateBase = captureEmitterBase(descendant),
				TemplateOverrides = nil,
				PreserveColor = descendant:GetAttribute("AuraPreserveColor") ~= false,
			})
			emitterCount += 1
		end
	end

	if emitterCount == 0 then
		DebugLog.Warn("Aura", "Composition d'aura vide", {
			Composition = compositionName,
		})
	end

	return emitterCount > 0
end

local function createFamilyPackage(character, familyData)
	local familyId = familyData.Id
	local definition = familyData.Definition
	local folder = Instance.new("Folder")
	folder.Name = "AuraFamily_" .. familyId
	folder.Parent = getRuntimeFolder(character)

	local package = {
		Id = familyId,
		Definition = definition,
		Folder = folder,
		Descriptors = {},
		Attachments = {},
		Highlight = nil,
		Active = false,
	}

	if definition.CompositionTemplate ~= nil then
		addCompositionDescriptors(package, character, definition.CompositionTemplate)
		packagesByFamilyId[familyId] = package
		return package
	end

	local primaryTexture = getTextureId(definition.PrimaryTexture, definition.FallbackPrimaryTexture)
	local secondaryTexture = getTextureId(definition.SecondaryTexture, definition.FallbackSecondaryTexture)
	local templateSet = definition.EffectTemplates or {}
	local parts = getPartsForStyle(character, definition.Style)

	for index, part in ipairs(parts) do
		if part == nil or not part:IsA("BasePart") then
			continue
		end

		if definition.Style == "BodyFlame" then
			addContourDescriptors(package, part, familyId, index, primaryTexture, function(context)
				return {
					Rate = 0.8 + (2.2 * context.EffectScale),
					Lifetime = 0.62,
					Speed = 0.62,
					StartSize = 0.9 * context.SizeScale,
					EndSize = 0.08,
					Transparency = 0.44,
				}
			end, templateSet.Primary)
		elseif definition.Style == "Armor" then
			addContourDescriptors(package, part, familyId, index, primaryTexture, function(context)
				return {
					Rate = 0.55 + (1.65 * context.EffectScale),
					Lifetime = 0.7,
					Speed = 0.4,
					StartSize = 0.82 * context.SizeScale,
					EndSize = 0.08,
					Transparency = 0.58,
				}
			end, templateSet.Primary)
		elseif definition.Style == "Sustain" then
			addContourDescriptors(package, part, familyId, index, primaryTexture, function(context)
				return {
					Rate = 0.65 + (1.7 * context.EffectScale),
					Lifetime = 0.82,
					Speed = 0.35,
					StartSize = 0.9 * context.SizeScale,
					EndSize = 0.1,
					Transparency = 0.6,
				}
			end, templateSet.Primary)
		else
			local attachment = createAttachment(part, "Aura_" .. familyId .. "_" .. tostring(index), nil, package)

			if definition.Style == "Feet" then
				attachment.Position = Vector3.new(0, -0.35, 0)
				addEmitterDescriptor(package, attachment, "Wind", primaryTexture, function(context)
					return { Rate = 5 + (11 * context.EffectScale), Lifetime = 0.42, Speed = 2, StartSize = 0.72 * context.SizeScale, EndSize = 0.08, Transparency = 0.4 }
				end, templateSet.Primary)
				addEmitterDescriptor(package, attachment, "Glow", secondaryTexture, function(context)
					return { Rate = 1 + (3 * context.EffectScale), Lifetime = 0.54, Speed = 0.45, StartSize = 0.9 * context.SizeScale, EndSize = 0.06, Transparency = 0.62 }
				end, templateSet.Secondary)
			elseif definition.Style == "AttackSpeed" then
				-- Des flux courts sont ancrés aux poignets : la vitesse d'attaque
				-- doit lire comme une energie qui circule vers l'action, pas comme
				-- un anneau plat autour du personnage.
				local side = index == 1 and -1 or 1
				attachment.CFrame = CFrame.Angles(0, math.rad(52 * side), math.rad(18 * side))

				addEmitterDescriptor(package, attachment, "Flow", secondaryTexture, function(context)
					return {
						Rate = 2.4 + (1.4 * context.EffectScale),
						Lifetime = 0.42,
						Speed = 1.1,
						StartSize = 0.72 * context.SizeScale,
						EndSize = 0.08,
						Transparency = 0.46,
						RateMultiplier = 0.55,
						SizeMultiplier = 0.16,
					}
				end, templateSet.Flow)

				local chargeAttachment = createAttachment(
					part,
					"Aura_" .. familyId .. "_Charge_" .. tostring(index),
					Vector3.new(0.16 * side, 0.08, -0.12),
					package
				)
				chargeAttachment.CFrame = chargeAttachment.CFrame * CFrame.Angles(0, math.rad(28 * side), 0)
				addEmitterDescriptor(package, chargeAttachment, "Charge", primaryTexture, function(context)
					return {
						Rate = 1.8 + context.EffectScale,
						Lifetime = 0.34,
						Speed = 0.8,
						StartSize = 0.42 * context.SizeScale,
						EndSize = 0.08,
						Transparency = 0.44,
						RateMultiplier = 0.13,
						SizeMultiplier = 0.22,
					}
				end, templateSet.Charge, {
					Orientation = Enum.ParticleOrientation.VelocityPerpendicular,
					EmissionDirection = Enum.NormalId.Top,
				})

				addEmitterDescriptor(package, attachment, "Spark", primaryTexture, function(context)
					return {
						Rate = 1.1 + context.EffectScale,
						Lifetime = 0.25,
						Speed = 0.3,
						StartSize = 0.18 * context.SizeScale,
						EndSize = 0.03,
						Transparency = 0.38,
						RateMultiplier = 0.34,
						SizeMultiplier = 0.18,
					}
				end, templateSet.Spark)
			elseif definition.Style == "Hands" then
				addEmitterDescriptor(package, attachment, "Spark", primaryTexture, function(context)
					return { Rate = 2 + (6 * context.EffectScale), Lifetime = 0.38, Speed = 0.6, StartSize = 0.18 * context.SizeScale, EndSize = 0, Transparency = 0.48 }
				end, templateSet.Primary)
				addEmitterDescriptor(package, attachment, "Wind", secondaryTexture, function(context)
					return { Rate = 1 + (3 * context.EffectScale), Lifetime = 0.5, Speed = 0.55, StartSize = 0.58 * context.SizeScale, EndSize = 0.04, Transparency = 0.68 }
				end, templateSet.Secondary)
			elseif definition.Style == "Head" then
				attachment.Position = Vector3.new(0, 0.55, 0)
				addEmitterDescriptor(package, attachment, "Glyph", primaryTexture, function(context)
					return { Rate = 0.6 + (1.8 * context.EffectScale), Lifetime = 1.1, Speed = 0.35, StartSize = 0.7 * context.SizeScale, EndSize = 0.1, Transparency = 0.52 }
				end, templateSet.Primary)
				addEmitterDescriptor(package, attachment, "Spark", secondaryTexture, function(context)
					return { Rate = 2 + (6 * context.EffectScale), Lifetime = 0.75, Speed = 0.8, StartSize = 0.2 * context.SizeScale, EndSize = 0, Transparency = 0.48 }
				end, templateSet.Secondary)
			elseif definition.Style == "Arsenal" then
				-- Trois foyers independants remplacent l'orbite unique. Ils suggerent
				-- une reserve de projectiles sans dessiner un contour circulaire plat.
				local nodes = {
					Vector3.new(-0.92, 0.32, 0.22),
					Vector3.new(0.9, 0.82, -0.16),
					Vector3.new(0.06, 1.28, 0.46),
				}

				for nodeIndex, offset in ipairs(nodes) do
					local nodeAttachment = createAttachment(
						part,
						"Aura_" .. familyId .. "_Node_" .. tostring(nodeIndex),
						offset,
						package
					)
					nodeAttachment.CFrame = nodeAttachment.CFrame * CFrame.Angles(0, math.rad((nodeIndex - 2) * 36), 0)

					addEmitterDescriptor(package, nodeAttachment, "Energy", primaryTexture, function(context)
						return {
							Rate = 1.6 + context.EffectScale,
							Lifetime = 0.36,
							Speed = 0.6,
							StartSize = 0.42 * context.SizeScale,
							EndSize = 0.08,
							Transparency = 0.48,
							RateMultiplier = 0.28,
							SizeMultiplier = 0.27,
						}
					end, templateSet.Energy, {
							Orientation = Enum.ParticleOrientation.VelocityPerpendicular,
							EmissionDirection = Enum.NormalId.Top,
						})

					addEmitterDescriptor(package, nodeAttachment, "Bolt", secondaryTexture, function(context)
						return {
							Rate = 1 + context.EffectScale,
							Lifetime = 0.28,
							Speed = 0.2,
							StartSize = 0.18 * context.SizeScale,
							EndSize = 0.02,
							Transparency = 0.36,
							RateMultiplier = 0.85,
							SizeMultiplier = 0.2,
						}
					end, templateSet.Bolt)

					addEmitterDescriptor(package, nodeAttachment, "Core", primaryTexture, function(context)
						return {
							Rate = 1,
							Lifetime = 0.42,
							Speed = 0.01,
							StartSize = 0.24 * context.SizeScale,
							EndSize = 0.08,
							Transparency = 0.52,
							RateMultiplier = 0.12,
							SizeMultiplier = 0.55,
						}
					end, templateSet.Core)
				end
			elseif definition.Style == "Orbit" then
				addEmitterDescriptor(package, attachment, "Glyph", primaryTexture, function(context)
					return { Rate = 0.8 + (2.2 * context.EffectScale), Lifetime = 1.25, Speed = 1.2, StartSize = 0.75 * context.SizeScale, EndSize = 0.1, Transparency = 0.46 }
				end, templateSet.Primary)
				addEmitterDescriptor(package, attachment, "Spark", secondaryTexture, function(context)
					return { Rate = 2 + (6 * context.EffectScale), Lifetime = 0.85, Speed = 1.3, StartSize = 0.2 * context.SizeScale, EndSize = 0, Transparency = 0.46 }
				end, templateSet.Secondary)
			elseif definition.Style == "Magnetism" then
				-- Le noyau reste pose au niveau des pieds. Les trois flux exterieurs
				-- sont orientes vers lui, ce qui donne une lecture de collecte plutot
				-- qu'une orbite ou une explosion vers l'exterieur.
				attachment.Position = Vector3.new(0, -2.65, 0)
				addEmitterDescriptor(package, attachment, "GroundCore", secondaryTexture, function(context)
					return {
						Rate = 1.25 + (0.6 * context.EffectScale),
						Lifetime = 1.1,
						Speed = 0.01,
						StartSize = 1.1 * context.SizeScale,
						EndSize = 1.1 * context.SizeScale,
						Transparency = 0.56,
						RateMultiplier = 0.82,
						SizeMultiplier = 0.38,
						LifetimeMultiplier = 1.1,
					}
				end, templateSet.Secondary, {
					Orientation = Enum.ParticleOrientation.VelocityPerpendicular,
					EmissionDirection = Enum.NormalId.Top,
				})

				for pullIndex = 1, 3 do
					local angle = math.rad(30 + ((pullIndex - 1) * 120))
					local radialOffset = Vector3.new(math.cos(angle) * 3.1, -2.65, math.sin(angle) * 3.1)
					local pullAttachment = createAttachment(part, "Aura_" .. familyId .. "_Pull_" .. tostring(pullIndex), nil, package)
					pullAttachment.CFrame = CFrame.lookAt(radialOffset, Vector3.new(0, -2.65, 0), Vector3.yAxis)

					addEmitterDescriptor(package, pullAttachment, "InwardSpiral", primaryTexture, function(context)
						return {
							Rate = 3.5 + (2.5 * context.EffectScale),
							Lifetime = 1.15,
							Speed = 2.6,
							StartSize = 0.62 * context.SizeScale,
							EndSize = 0.18 * context.SizeScale,
							Transparency = 0.44,
							RateMultiplier = 0.9,
							SizeMultiplier = 0.3,
							LifetimeMultiplier = 1.15,
							SpeedMultiplier = 2600,
						}
					end, templateSet.Primary, {
						Orientation = Enum.ParticleOrientation.VelocityPerpendicular,
						EmissionDirection = Enum.NormalId.Front,
					})
				end
			elseif definition.Style == "Fortune" then
				-- La fortune se lit par un sceau au sol et trois eclats precieux.
				-- Chaque couche reste peu dense afin de ne pas concurrencer les auras
				-- de puissance ou de protection lorsqu'elles sont actives ensemble.
				attachment.Position = Vector3.new(0, -2.65, 0)

				local function addFortuneFloor(name, templateName, sizeMultiplier, rateMultiplier)
					addEmitterDescriptor(package, attachment, name, primaryTexture, function(context)
						return {
							Rate = 1.2,
							Lifetime = 1.05,
							Speed = 0.01,
							StartSize = 1,
							EndSize = 1,
							Transparency = 0.52,
							RateMultiplier = rateMultiplier,
							SizeMultiplier = sizeMultiplier,
							LifetimeMultiplier = 1.05,
						}
					end, templateName, {
						Orientation = Enum.ParticleOrientation.VelocityPerpendicular,
						EmissionDirection = Enum.NormalId.Top,
					})
				end

				addFortuneFloor("FloorInner", templateSet.FloorInner, 0.55, 2.3)
				addFortuneFloor("FloorCore", templateSet.FloorCore, 0.5, 2.3)
				addFortuneFloor("FloorOuter", templateSet.FloorOuter, 0.65, 2)

				local sparkleOffsets = {
					Vector3.new(-0.75, 0.3, 0.1),
					Vector3.new(0.72, 0.78, -0.08),
					Vector3.new(0.08, 1.25, 0.34),
				}

				for sparkleIndex, offset in ipairs(sparkleOffsets) do
					local sparkleAttachment = createAttachment(
						part,
						"Aura_" .. familyId .. "_Spark_" .. tostring(sparkleIndex),
						offset,
						package
					)

					addEmitterDescriptor(package, sparkleAttachment, "GildedSpark", secondaryTexture, function(context)
						return {
							Rate = 1.2 + (0.8 * context.EffectScale),
							Lifetime = 0.95,
							Speed = 0.01,
							StartSize = 0.42 * context.SizeScale,
							EndSize = 0.12 * context.SizeScale,
							Transparency = 0.42,
							RateMultiplier = 1.25,
							SizeMultiplier = 0.3,
						}
					end, templateSet.Spark)
				end
			end
		end
	end

	local primaryPart = parts[1]

	if primaryPart ~= nil and primaryPart:IsA("BasePart") then
		local attachment = createAttachment(primaryPart, "Aura_" .. familyId .. "_Special", nil, package)

		if definition.Style == "BodyFlame" then
			addEmitterDescriptor(package, attachment, "Spark", secondaryTexture, function(context)
				return { Rate = 1.5 + (4 * context.EffectScale), Lifetime = 0.52, Speed = 0.5, StartSize = 0.18 * context.SizeScale, EndSize = 0, Transparency = 0.46 }
			end, templateSet.Secondary)
		elseif definition.Style == "Armor" then
			addEmitterDescriptor(package, attachment, "Shield", secondaryTexture, function(context)
				return { Rate = 0.7 + (1.8 * context.EffectScale), Lifetime = 0.95, Speed = 0.2, StartSize = 1.15 * context.SizeScale, EndSize = 0.16, Transparency = 0.5 }
			end, templateSet.Secondary)
		elseif definition.Style == "Sustain" then
			attachment.Position = Vector3.new(0, 0.15, 0)
			addEmitterDescriptor(package, attachment, "Pulse", secondaryTexture, function(context)
				return { Rate = 0.7 + (2 * context.EffectScale), Lifetime = 0.86, Speed = 0.2, StartSize = 0.95 * context.SizeScale, EndSize = 0.12, Transparency = 0.58 }
			end, templateSet.Secondary)
		end
	end

	if definition.Style == "Armor" then
		local highlight = Instance.new("Highlight")
		highlight.Name = "ArmorHighlight"
		highlight.Adornee = character
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.Enabled = false
		highlight.Parent = folder
		package.Highlight = highlight
	end

	packagesByFamilyId[familyId] = package
	return package
end

local function setEmitterState(descriptor, context)
	local emitter = descriptor.Emitter
	local values = descriptor.Configure(context)
	local templateBase = descriptor.TemplateBase

	if descriptor.PreserveColor and templateBase ~= nil and templateBase.Color ~= nil then
		emitter.Color = templateBase.Color
	else
		emitter.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, context.BrightColor),
			ColorSequenceKeypoint.new(1, context.DeepColor),
		})
	end

	local rate

	if templateBase ~= nil then
		local effectFactor = 0.65 + (0.35 * context.EffectScale)
		local rateMultiplier = context.TemplateRateMultiplier * (values.RateMultiplier or 1) * effectFactor
		local sizeMultiplier = context.TemplateSizeMultiplier * (values.SizeMultiplier or 1) * (0.84 + (0.16 * context.EffectScale))
		local lifetimeMultiplier = values.LifetimeMultiplier or 1
		local speedMultiplier = values.SpeedMultiplier or 1
		local baseRate = math.max(0.4, templateBase.Rate)

		emitter.Texture = templateBase.Texture
		rate = baseRate * rateMultiplier * context.DecorativeScale
		emitter.LightEmission = math.clamp(templateBase.LightEmission, 0, 0.85)
		emitter.Rate = rate
		emitter.Lifetime = NumberRange.new(
			math.max(0.05, templateBase.Lifetime.Min * lifetimeMultiplier),
			math.max(0.06, templateBase.Lifetime.Max * lifetimeMultiplier)
		)
		emitter.Speed = NumberRange.new(
			math.max(0.001, templateBase.Speed.Min * speedMultiplier),
			math.max(0.002, templateBase.Speed.Max * speedMultiplier)
		)
		emitter.Acceleration = templateBase.Acceleration
		emitter.Drag = templateBase.Drag
		emitter.Size = scaleNumberSequence(templateBase.Size, sizeMultiplier)
		emitter.Transparency = templateBase.Transparency

	else
		rate = values.Rate * context.DecorativeScale
		emitter.Texture = descriptor.TextureId
		emitter.LightEmission = 0.42
		emitter.Rate = rate
		emitter.Lifetime = NumberRange.new(values.Lifetime * 0.8, values.Lifetime)
		emitter.Speed = NumberRange.new(math.max(0.03, values.Speed * 0.08), math.max(0.06, values.Speed * 0.14))
		emitter.Acceleration = Vector3.new(0, math.min(0.65, values.Speed * 0.14), 0)
		emitter.Drag = 3
		emitter.Size = numberSequence(values.StartSize, values.EndSize)
		emitter.Transparency = numberSequence(values.Transparency, 1)
	end

	local overrides = descriptor.TemplateOverrides

	if overrides ~= nil then
		if overrides.Orientation ~= nil then
			emitter.Orientation = overrides.Orientation
		end

		if overrides.EmissionDirection ~= nil then
			emitter.EmissionDirection = overrides.EmissionDirection
		end

		if overrides.ShapeInOut ~= nil then
			emitter.ShapeInOut = overrides.ShapeInOut
		end
	end

	emitter.Enabled = context.Active and rate > 0.01

	if not emitter.Enabled then
		emitter:Clear()
	end
end

local function applyPackage(package, familyData, settings)
	local definition = familyData.Definition
	local tierScale = AuraConfig.TierScales[familyData.Tier] or 1
	local intensity = math.clamp(familyData.Score, AuraConfig.MinimumScore, 1)
	local effectScale = tierScale * (0.55 + (0.45 * intensity))
	local effectColor = getEffectColor(definition, latestStats)
	local decorativeScale = settings.EffectsIntensity * settings.Profile.AuraLayerMultiplier
	local brightColor = effectColor:Lerp(Color3.new(1, 1, 1), 0.07)
	local deepColor = effectColor:Lerp(Color3.new(0, 0, 0), 0.06)

	if definition.Style == "Fortune" then
		-- Le blanc ecrase les dorures des textures de richesse. Cette famille
		-- garde donc une paire or ambre plus saturee et mieux identifiable.
		brightColor = Color3.fromRGB(255, 218, 80)
		deepColor = Color3.fromRGB(170, 96, 18)
	end

	local context = {
		Active = decorativeScale >= 0.08,
		DecorativeScale = decorativeScale,
		EffectScale = effectScale,
		SizeScale = effectScale * AuraConfig.NativeSizeMultiplier,
		TemplateRateMultiplier = definition.TemplateRateMultiplier or 0.2,
		TemplateSizeMultiplier = definition.TemplateSizeMultiplier or 1,
		BrightColor = brightColor,
		DeepColor = deepColor,
	}

	for _, descriptor in ipairs(package.Descriptors) do
		setEmitterState(descriptor, context)
	end

	if package.Highlight ~= nil then
		package.Highlight.Enabled = context.Active
		package.Highlight.FillColor = effectColor
		package.Highlight.FillTransparency = math.clamp(0.95 - (intensity * 0.16), 0.72, 0.93)
		package.Highlight.OutlineColor = Color3.fromRGB(222, 244, 255)
		package.Highlight.OutlineTransparency = 0.96
	end

	package.Active = true
	package.Tier = familyData.Tier
end

local function disablePackage(package)
	if package == nil or not package.Active then
		return
	end

	for _, descriptor in ipairs(package.Descriptors) do
		descriptor.Emitter.Enabled = false
		descriptor.Emitter:Clear()
	end

	if package.Highlight ~= nil then
		package.Highlight.Enabled = false
	end

	package.Active = false
end

local function clearRuntime()
	for _, package in pairs(packagesByFamilyId) do
		for _, attachment in ipairs(package.Attachments) do
			attachment:Destroy()
		end
	end

	if runtimeFolder ~= nil then
		runtimeFolder:Destroy()
	end

	runtimeFolder = nil
	packagesByFamilyId = {}
	lastActiveSignature = ""
end

local function refreshAuras()
	local character = player.Character

	if character == nil or not isRunActive then
		clearRuntime()
		return
	end

	local settings = VfxQualityController.GetSettings()
	local dominantFamilies = getDominantFamilies(settings.Profile.AuraFamilyLimit)
	local activeIds = {}
	local signatureParts = {}
	local packageCount = 0

	for _, familyData in ipairs(dominantFamilies) do
		activeIds[familyData.Id] = true
		local package = packagesByFamilyId[familyData.Id] or createFamilyPackage(character, familyData)
		applyPackage(package, familyData, settings)
		table.insert(signatureParts, familyData.Id .. ":" .. tostring(familyData.Tier))
	end

	for familyId, package in pairs(packagesByFamilyId) do
		packageCount += 1

		if not activeIds[familyId] then
			disablePackage(package)
		end
	end

	local signature = table.concat(signatureParts, "|")

	if signature ~= lastActiveSignature then
		lastActiveSignature = signature
		DebugLog.Info("Aura", "Auras visuelles appliquees", {
			Player = player.Name,
			Families = signature,
			Quality = settings.Quality,
		})
	end

	DebugLog.ThrottledInfo("Vfx", "aura_budget", 5, "Budget auras applique", {
		Active = #dominantFamilies,
		Families = settings.Profile.AuraFamilyLimit,
		Packages = packageCount,
		Quality = settings.Quality,
	})
end

ReplicatedStorage:WaitForChild("Perk_UpdateStats").OnClientEvent:Connect(function(payload)
	if typeof(payload) ~= "table" or typeof(payload.Stats) ~= "table" then
		return
	end

	latestStats = payload.Stats
	refreshAuras()
end)

ReplicatedStorage:WaitForChild("Run_StateUpdate").OnClientEvent:Connect(function(payload)
	isRunActive = typeof(payload) == "table" and payload.IsRunActive == true
	refreshAuras()
end)

player:GetAttributeChangedSignal("IsRunActive"):Connect(function()
	isRunActive = player:GetAttribute("IsRunActive") == true
	refreshAuras()
end)

player.CharacterAdded:Connect(function(character)
	clearRuntime()
	task.defer(function()
		character:WaitForChild("HumanoidRootPart", 5)
		refreshAuras()
	end)
end)

VfxQualityController.Changed.Event:Connect(refreshAuras)

DebugLog.Info("Aura", "AuraController client initialise", {
	Player = player.Name,
})
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="118">
          <Properties>
            <string name="Name">BossUI</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local BossConfig = require(Shared:WaitForChild("BossConfig"))
local UiTheme = require(Shared:WaitForChild("UiTheme"))

local existingGui = playerGui:FindFirstChild("BossGui")

if existingGui ~= nil then
	existingGui:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "BossGui"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 125
screenGui.Parent = playerGui

local addCorner = UiTheme.AddCorner
local addStroke = UiTheme.AddStroke

local function createLabel(parent, name, text, size, color, font)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Font = font or UiTheme.Fonts.Bold
	label.Text = text
	label.TextColor3 = color
	label.TextSize = size
	label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	label.TextStrokeTransparency = 0.45
	label.TextXAlignment = Enum.TextXAlignment.Center
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = parent
	return label
end

local bossBar = Instance.new("Frame")
bossBar.Name = "BossHealthBar"
bossBar.AnchorPoint = Vector2.new(0.5, 0)
bossBar.Position = UDim2.new(0.5, 0, 0, 104)
bossBar.Size = UDim2.new(0.48, 0, 0, 58)
bossBar.BackgroundColor3 = Color3.fromRGB(12, 14, 21)
bossBar.BackgroundTransparency = 0.12
bossBar.BorderSizePixel = 0
bossBar.Visible = false
bossBar.Parent = screenGui
addCorner(bossBar, 8)
addStroke(bossBar, Color3.fromRGB(255, 105, 80), 0.2, 1)
UiTheme.AddSurfaceFinish(bossBar, {
	Accent = Color3.fromRGB(255, 105, 80),
	Intensity = 0.45,
})

local bossBarSize = Instance.new("UISizeConstraint")
bossBarSize.MinSize = Vector2.new(280, 52)
bossBarSize.MaxSize = Vector2.new(620, 58)
bossBarSize.Parent = bossBar

local bossName = createLabel(bossBar, "BossName", BossConfig.DisplayName, 15, Color3.fromRGB(255, 229, 213), Enum.Font.GothamBlack)
bossName.Position = UDim2.fromOffset(14, 6)
bossName.Size = UDim2.new(0.64, 0, 0, 18)
bossName.TextXAlignment = Enum.TextXAlignment.Left

local bossHealthText = createLabel(bossBar, "Health", "1000 / 1000", 14, Color3.fromRGB(255, 236, 230), Enum.Font.GothamBold)
bossHealthText.Position = UDim2.new(0.64, 0, 0, 6)
bossHealthText.Size = UDim2.new(0.36, -14, 0, 18)
bossHealthText.TextXAlignment = Enum.TextXAlignment.Right

local healthTrack = Instance.new("Frame")
healthTrack.Name = "Track"
healthTrack.Position = UDim2.fromOffset(14, 32)
healthTrack.Size = UDim2.new(1, -28, 0, 16)
healthTrack.BackgroundColor3 = Color3.fromRGB(45, 12, 16)
healthTrack.BackgroundTransparency = 0.08
healthTrack.BorderSizePixel = 0
healthTrack.ClipsDescendants = true
healthTrack.Parent = bossBar
addCorner(healthTrack, 5)

local healthFill = Instance.new("Frame")
healthFill.Name = "Fill"
healthFill.Size = UDim2.fromScale(1, 1)
healthFill.BackgroundColor3 = Color3.fromRGB(229, 63, 54)
healthFill.BorderSizePixel = 0
healthFill.Parent = healthTrack
addCorner(healthFill, 5)

local decisionOverlay = Instance.new("Frame")
decisionOverlay.Name = "DecisionOverlay"
decisionOverlay.Size = UDim2.fromScale(1, 1)
decisionOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
decisionOverlay.BackgroundTransparency = 0.45
decisionOverlay.BorderSizePixel = 0
decisionOverlay.Visible = false
decisionOverlay.ZIndex = 150
decisionOverlay.Parent = screenGui

local decisionCard = Instance.new("Frame")
decisionCard.Name = "DecisionCard"
decisionCard.AnchorPoint = Vector2.new(0.5, 0.5)
decisionCard.Position = UDim2.fromScale(0.5, 0.5)
decisionCard.Size = UDim2.new(0.42, 0, 0, 184)
decisionCard.BackgroundColor3 = Color3.fromRGB(13, 16, 24)
decisionCard.BackgroundTransparency = 0.04
decisionCard.BorderSizePixel = 0
decisionCard.ZIndex = 151
decisionCard.Parent = decisionOverlay
addCorner(decisionCard, 8)
addStroke(decisionCard, Color3.fromRGB(255, 200, 74), 0.18, 1)
UiTheme.AddSurfaceFinish(decisionCard, {
	Accent = UiTheme.Colors.Gold,
	Intensity = 0.55,
})

local decisionSize = Instance.new("UISizeConstraint")
decisionSize.MinSize = Vector2.new(300, 184)
decisionSize.MaxSize = Vector2.new(520, 184)
decisionSize.Parent = decisionCard

local victoryTitle = createLabel(decisionCard, "Title", "NIVEAU VALIDE", 24, Color3.fromRGB(255, 225, 116), Enum.Font.GothamBlack)
victoryTitle.Position = UDim2.fromOffset(16, 20)
victoryTitle.Size = UDim2.new(1, -32, 0, 28)
victoryTitle.ZIndex = 152

local victoryDescription = createLabel(
	decisionCard,
	"Description",
	"Tu peux poursuivre la survie pour améliorer ton score ou quitter le niveau.",
	14,
	Color3.fromRGB(224, 229, 240),
	Enum.Font.Gotham
)
victoryDescription.Position = UDim2.fromOffset(22, 56)
victoryDescription.Size = UDim2.new(1, -44, 0, 42)
victoryDescription.TextWrapped = true
victoryDescription.ZIndex = 152

local function createDecisionButton(name, text, position, color)
	local button = Instance.new("TextButton")
	button.Name = name
	button.Position = position
	button.Size = UDim2.new(0.5, -26, 0, 40)
	button.BackgroundColor3 = color
	button.BackgroundTransparency = 0.1
	button.BorderSizePixel = 0
	button.Font = Enum.Font.GothamBold
	button.Text = text
	button.TextColor3 = Color3.fromRGB(255, 255, 255)
	button.TextSize = 14
	button.ZIndex = 152
	button.Parent = decisionCard
	addCorner(button, 5)
	addStroke(button, Color3.fromRGB(255, 255, 255), 0.65, 1)
	return button
end

local continueButton = createDecisionButton("Continue", "CONTINUER", UDim2.new(0, 16, 1, -56), Color3.fromRGB(38, 130, 75))
local exitButton = createDecisionButton("Exit", "QUITTER LE NIVEAU", UDim2.new(0.5, 10, 1, -56), Color3.fromRGB(135, 65, 60))

local decisionRemote = ReplicatedStorage:WaitForChild(BossConfig.DecisionRemoteName)

continueButton.Activated:Connect(function()
	decisionRemote:FireServer("Continue")
end)

exitButton.Activated:Connect(function()
	decisionRemote:FireServer("Exit")
end)

local function updateBossBar(payload)
	local currentHealth = math.max(0, tonumber(payload.CurrentHealth) or 0)
	local maxHealth = math.max(1, tonumber(payload.MaxHealth) or 1)

	bossName.Text = tostring(payload.Name or BossConfig.DisplayName)
	bossHealthText.Text = string.format("%d / %d", math.floor(currentHealth + 0.5), math.floor(maxHealth + 0.5))
	healthFill.Size = UDim2.fromScale(math.clamp(currentHealth / maxHealth, 0, 1), 1)
	bossBar.Visible = true
end

local bossRemote = ReplicatedStorage:WaitForChild(BossConfig.BossRemoteName)

bossRemote.OnClientEvent:Connect(function(payload)
	payload = payload or {}

	if payload.Action == "ShowBar" then
		updateBossBar(payload)
	elseif payload.Action == "Hide" then
		bossBar.Visible = false
	elseif payload.Action == "ShowDecision" then
		bossBar.Visible = false
		decisionOverlay.Visible = true
	elseif payload.Action == "HideDecision" then
		decisionOverlay.Visible = false
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="119">
          <Properties>
            <string name="Name">ChestClient</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local ChestConfig = require(Shared:WaitForChild("ChestConfig"))
local DebugLog = require(Shared:WaitForChild("DebugLog"))
local UiTheme = require(Shared:WaitForChild("UiTheme"))

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local openRequestRemote = ReplicatedStorage:WaitForChild("Chest_OpenRequest")
local openResultRemote = ReplicatedStorage:WaitForChild("Chest_OpenResult")
local openFailedRemote = ReplicatedStorage:WaitForChild("Chest_OpenFailed")
local choiceRequestRemote = ReplicatedStorage:WaitForChild("Chest_ChoiceRequest")
local choiceResultRemote = ReplicatedStorage:WaitForChild("Chest_ChoiceResult")
local priceUpdateRemote = ReplicatedStorage:WaitForChild("Chest_PriceUpdate")

local trackedChests = {}
local currentPromptChest = nil
local pendingChest = nil
local activeOpeningId = nil
local isSlotPlaying = false
local currentOpenCost = ChestConfig.BaseOpenCost
-- Les coffres normaux utilisent un ProximityPrompt serveur, comme les jarres.
-- Ce bloc client reste disponible comme fallback, mais il ne dessine plus de label.
local CLIENT_CHEST_PROMPTS_ENABLED = false

-- Le rendu V2 prend le relais quand son adaptateur a termine son initialisation.
-- Le rail historique reste volontairement disponible en secours de demarrage.
local function isV2PresentationReady()
	return playerGui:GetAttribute("ItemRevealV2Ready") == true
end

local CHEST_UI_COLORS = UiTheme.Contexts.Chest

local addCorner = UiTheme.AddCorner
local addStroke = UiTheme.AddStroke

local function getChestContainer(instance)
	local current = instance

	while current ~= nil and current ~= Workspace do
		if current.Name == ChestConfig.ChestName then
			return current
		end

		current = current.Parent
	end

	return nil
end

local function findChestRoot(chest)
	if chest:IsA("BasePart") then
		return chest
	end

	if chest:IsA("Model") and chest.PrimaryPart ~= nil then
		return chest.PrimaryPart
	end

	return chest:FindFirstChildWhichIsA("BasePart", true)
end

local function resolveChest(instance)
	if typeof(instance) ~= "Instance" then
		return nil
	end

	local chest = getChestContainer(instance)

	if chest == nil or findChestRoot(chest) == nil then
		return nil
	end

	return chest
end

local function getChestBounds(chest)
	if chest:IsA("Model") then
		return chest:GetBoundingBox()
	end

	if chest:IsA("BasePart") then
		return chest.CFrame, chest.Size
	end

	local root = findChestRoot(chest)

	if root == nil then
		return CFrame.new(), Vector3.new(1, 2, 1)
	end

	return root.CFrame, root.Size
end

local function getChestHeight(chest)
	local _, size = getChestBounds(chest)

	return size.Y
end

local function getChestPosition(chest)
	local cframe = getChestBounds(chest)

	return cframe.Position
end

local function createPrompt(chest)
	local root = findChestRoot(chest)

	if root == nil then
		return nil
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ChestPrompt"
	billboard.Adornee = root
	billboard.AlwaysOnTop = true
	billboard.Enabled = false
	billboard.LightInfluence = 0
	billboard.MaxDistance = ChestConfig.PromptMaxDistance
	billboard.Size = UDim2.fromOffset(154, 34)
	billboard.StudsOffset = Vector3.new(0, (getChestHeight(chest) * 0.5) + ChestConfig.PromptHeightOffset, 0)
	billboard.Parent = root

	local frame = Instance.new("Frame")
	frame.Name = "Background"
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(10, 12, 16)
	frame.BackgroundTransparency = 0.25
	frame.BorderSizePixel = 0
	frame.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = frame

	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 255, 255)
	stroke.Transparency = 0.76
	stroke.Thickness = 1
	stroke.Parent = frame

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.Text = "E pour ouvrir"
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.TextSize = 12
	label.TextWrapped = true
	label.Parent = frame

	return billboard, label
end

local function getPromptText()
	return ("E pour ouvrir - %d coins"):format(currentOpenCost)
end

local function updatePromptLabel(chestState)
	if chestState ~= nil and chestState.Label ~= nil then
		chestState.Label.Text = getPromptText()
	end
end

local function trackChest(instance)
	if not CLIENT_CHEST_PROMPTS_ENABLED then
		return
	end

	local chest = resolveChest(instance)

	if chest == nil then
		return
	end

	if trackedChests[chest] ~= nil then
		return
	end

	local prompt, label = createPrompt(chest)

	trackedChests[chest] = {
		Prompt = prompt,
		Label = label,
	}

	updatePromptLabel(trackedChests[chest])
	DebugLog.ThrottledInfo("UI", "chest_tracked", 2, "Coffre detecte cote client", {
		Chest = chest,
	})
end

local function getPlayerRoot()
	local character = player.Character

	if character == nil then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
end

local function isChestAvailable(chest)
	return chest.Parent ~= nil and chest:GetAttribute("ChestOpened") ~= true and chest:GetAttribute("ChestOpening") ~= true
end

local function setPromptVisible(chest, isVisible)
	local chestState = trackedChests[chest]

	if chestState == nil or chestState.Prompt == nil then
		return
	end

	chestState.Prompt.Enabled = isVisible
end

local function getClosestPromptChest()
	local playerRoot = getPlayerRoot()

	if playerRoot == nil or isSlotPlaying then
		return nil
	end

	local closestChest = nil
	local closestDistance = ChestConfig.PromptDistance

	for chest in pairs(trackedChests) do
		if chest.Parent == nil then
			trackedChests[chest] = nil
			continue
		end

		if isChestAvailable(chest) then
			local chestPosition = getChestPosition(chest)

			if chestPosition ~= nil then
				local distance = (playerRoot.Position - chestPosition).Magnitude

				if distance <= closestDistance then
					closestDistance = distance
					closestChest = chest
				end
			end
		end
	end

	return closestChest
end

local slotGui = Instance.new("ScreenGui")
slotGui.Name = "ChestSlotGui"
slotGui.ResetOnSpawn = false
slotGui.DisplayOrder = 18
slotGui.Enabled = false
slotGui.Parent = playerGui

local slotPanel = Instance.new("Frame")
slotPanel.Name = "Panel"
slotPanel.AnchorPoint = Vector2.new(0.5, 0.5)
slotPanel.Position = UDim2.fromScale(0.5, 0.38)
slotPanel.Size = UDim2.new(0.34, 0, 0, 174)
slotPanel.BackgroundColor3 = CHEST_UI_COLORS.Panel
slotPanel.BackgroundTransparency = 0.18
slotPanel.BorderSizePixel = 0
slotPanel.Parent = slotGui

local slotSizeConstraint = Instance.new("UISizeConstraint")
slotSizeConstraint.MinSize = Vector2.new(300, 174)
slotSizeConstraint.MaxSize = Vector2.new(480, 174)
slotSizeConstraint.Parent = slotPanel

local slotCorner = Instance.new("UICorner")
slotCorner.CornerRadius = UDim.new(0, 10)
slotCorner.Parent = slotPanel

local slotStroke = Instance.new("UIStroke")
slotStroke.Color = CHEST_UI_COLORS.Accent
slotStroke.Transparency = 0.3
slotStroke.Thickness = 1.5
slotStroke.Parent = slotPanel
addStroke(slotPanel, Color3.fromRGB(7, 12, 19), 0.16, 4)

local slotGradient = Instance.new("UIGradient")
slotGradient.Rotation = 90
slotGradient.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, CHEST_UI_COLORS.PanelTop),
	ColorSequenceKeypoint.new(1, CHEST_UI_COLORS.Panel),
})
slotGradient.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.12),
	NumberSequenceKeypoint.new(1, 0.34),
})
slotGradient.Parent = slotPanel
UiTheme.AddSurfaceFinish(slotPanel, {
	Accent = CHEST_UI_COLORS.Accent,
	Intensity = 0.68,
})

local slotPadding = Instance.new("UIPadding")
slotPadding.PaddingTop = UDim.new(0, 12)
slotPadding.PaddingRight = UDim.new(0, 14)
slotPadding.PaddingBottom = UDim.new(0, 12)
slotPadding.PaddingLeft = UDim.new(0, 14)
slotPadding.Parent = slotPanel

local slotTitle = Instance.new("TextLabel")
slotTitle.Name = "Title"
slotTitle.Size = UDim2.new(1, 0, 0, 18)
slotTitle.BackgroundTransparency = 1
slotTitle.Font = Enum.Font.GothamBlack
slotTitle.Text = "Coffre"
slotTitle.TextColor3 = CHEST_UI_COLORS.Text
slotTitle.TextSize = 16
slotTitle.TextXAlignment = Enum.TextXAlignment.Center
slotTitle.Parent = slotPanel

local reelFrame = Instance.new("Frame")
reelFrame.Name = "Reel"
reelFrame.Position = UDim2.new(0, 0, 0, 30)
reelFrame.Size = UDim2.new(1, 0, 0, 42)
reelFrame.BackgroundColor3 = CHEST_UI_COLORS.PanelTop
reelFrame.BackgroundTransparency = 0.22
reelFrame.BorderSizePixel = 0
reelFrame.Parent = slotPanel

local reelCorner = Instance.new("UICorner")
reelCorner.CornerRadius = UDim.new(0, 6)
reelCorner.Parent = reelFrame
addStroke(reelFrame, CHEST_UI_COLORS.Accent, 0.46, 1)

local rewardIcon = Instance.new("ImageLabel")
rewardIcon.Name = "RewardIcon"
rewardIcon.Position = UDim2.fromOffset(7, 5)
rewardIcon.Size = UDim2.fromOffset(32, 32)
rewardIcon.BackgroundTransparency = 1
rewardIcon.Image = ""
rewardIcon.ScaleType = Enum.ScaleType.Fit
rewardIcon.Parent = reelFrame

local reelLabel = Instance.new("TextLabel")
reelLabel.Name = "RewardName"
reelLabel.Position = UDim2.fromOffset(44, 0)
reelLabel.Size = UDim2.new(1, -51, 1, 0)
reelLabel.BackgroundTransparency = 1
reelLabel.Font = Enum.Font.GothamBold
reelLabel.Text = "..."
reelLabel.TextColor3 = CHEST_UI_COLORS.AccentLight
reelLabel.TextSize = 18
reelLabel.TextWrapped = true
reelLabel.TextXAlignment = Enum.TextXAlignment.Left
reelLabel.Parent = reelFrame

local slotSubtitle = Instance.new("TextLabel")
slotSubtitle.Name = "Subtitle"
slotSubtitle.Position = UDim2.new(0, 0, 0, 82)
slotSubtitle.Size = UDim2.new(1, 0, 0, 20)
slotSubtitle.BackgroundTransparency = 1
slotSubtitle.Font = Enum.Font.GothamMedium
slotSubtitle.Text = "Ouverture..."
slotSubtitle.TextColor3 = CHEST_UI_COLORS.Muted
slotSubtitle.TextSize = 12
slotSubtitle.TextXAlignment = Enum.TextXAlignment.Center
slotSubtitle.Parent = slotPanel

local buttonRow = Instance.new("Frame")
buttonRow.Name = "ButtonRow"
buttonRow.Position = UDim2.new(0, 0, 1, -38)
buttonRow.Size = UDim2.new(1, 0, 0, 32)
buttonRow.BackgroundTransparency = 1
buttonRow.Visible = false
buttonRow.Parent = slotPanel

local skipButton = Instance.new("TextButton")
skipButton.Name = "SkipButton"
skipButton.Position = UDim2.new(0, 0, 0, 0)
skipButton.Size = UDim2.new(0.5, -5, 1, 0)
