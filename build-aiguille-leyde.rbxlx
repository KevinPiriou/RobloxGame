	-- evitent que le sol runtime ressemble a une baseplate de prototype.
	GeneratedTerrainMaterial = Enum.Material.SmoothPlastic,
	GeneratedTerrainSurface = Enum.SurfaceType.Smooth,
	MinimumElevation = 4,
