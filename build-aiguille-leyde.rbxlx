			OutdoorAmbient = Color3.fromRGB(112, 140, 151),
			EnvironmentDiffuseScale = 0.43,
			EnvironmentSpecularScale = 0.18,
			ShadowSoftness = 0.4,
			Wind = Vector3.new(1.55, 0, 1.05),
			Blur = {
				Size = 0.4,
			},
			DepthOfField = {
				FocusDistance = 36,
				InFocusRadius = 28,
				NearIntensity = 0,
				FarIntensity = 0.085,
			},
			Atmosphere = {
